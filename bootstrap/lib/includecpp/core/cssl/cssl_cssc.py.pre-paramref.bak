"""
CSSC — CSSL Script Compact Engine v5.1

Lightweight CSSL variant for .cssc script files:
    - #REQUIRE["path"] varname;          — unified resource loading (auto-detect .dll/.ini/.csl/.cssl)
    - #include("cssc.module") varname;   — builtin CSSC modules
    - #VARIABLE[type] name;              — typed variable declarations
    - if/else, for (C-style)             — control flow
    - cssc::func()                       — 100+ namespace builtins
    - varname::func()                    — module namespace access
    - obj->method() / obj.method()       — resource method calls
    - expr result_var;                   — result capture syntax
    - &&, ||, !                          — logical operators
"""
from __future__ import annotations

import os
import sys
import re
import time
import math
import json
import random
import shutil
import hashlib
import platform
import subprocess
import configparser
import ctypes
from pathlib import Path
from typing import Any, Dict, List, Optional, Tuple, Callable
from includecpp.core.cssl.cssl_types import Vector as CsscVector, Map as CsscMap, Array as CsscArray
# Lazy import to avoid circular: cssl_method imports from cssl_cssc
CsscMethod = None
CsscMethodBinding = None
CsscMethodIntrospector = None

def _ensure_method_imports():
    global CsscMethod, CsscMethodBinding, CsscMethodIntrospector
    if CsscMethod is None:
        from includecpp.core.cssl.cssl_method import CsscMethod as _M, CsscMethodBinding as _B, CsscMethodIntrospector as _I
        CsscMethod = _M
        CsscMethodBinding = _B
        CsscMethodIntrospector = _I

# ---------------------------------------------------------------------------
# C++ Acceleration — loaded via IncludeCPP's compiled api module
# ---------------------------------------------------------------------------
_CSSC_ACCEL = False
_cssc_accel_mod = None

try:
    # Try loading from the bundled api.pyd in the package
    import importlib.util as _ilu
    _api_path = Path(__file__).parent / 'cpp' / 'build' / ('api.pyd' if sys.platform == 'win32' else 'api.so')
    if _api_path.exists():
        if sys.platform == 'win32' and hasattr(os, 'add_dll_directory'):
            os.add_dll_directory(str(_api_path.parent))
        _spec = _ilu.spec_from_file_location('api', str(_api_path))
        if _spec and _spec.loader:
            _api_mod = _ilu.module_from_spec(_spec)
            _spec.loader.exec_module(_api_mod)
            if hasattr(_api_mod, 'cssc_accel'):
                _cssc_accel_mod = _api_mod.cssc_accel
                _CSSC_ACCEL = True
except Exception:
    pass

# ---------------------------------------------------------------------------
# Error
# ---------------------------------------------------------------------------
class CsscError(Exception):
    """Structured error for CSSC operations."""

    def __init__(self, message: str = '', operation: str = '', detail: str = '',
                 hint: str = '', line: int = 0, column: int = 0, script: str = ''):
        self.operation = operation
        self.detail = detail
        self.hint = hint
        self.line = line
        self.column = column
        self.script = script
        if message:
            super().__init__(message)
        else:
            loc = f" line {line}" if line else ''
            src = f" in {script}" if script else ''
            hint_line = f"\n  Hint: {hint}" if hint else ''
            super().__init__(f"CSSC {operation} Error{src}{loc}: {detail}{hint_line}")


class _CsscBindPairView:
    """One pair of a `CsscBind`, exposed by `bind[row]` when the bind
    has `pair_width > 0` (structured `{a, b; c, d}` source).

    The view supports `view[col]` (column lookup) and integer-len so
    chained access `bind[row][col]` reads cell `row * pair_width + col`
    from the underlying bind. Returning a view instead of the raw tuple
    keeps `len(view) == pair_width` honest and lets the interpreter
    mirror the native runtime's pair_width-aware lookup exactly.
    """
    __slots__ = ('_pair',)

    def __init__(self, cells):
        self._pair = tuple(cells)

    def __getitem__(self, idx):
        if isinstance(idx, int):
            return self._pair[idx]
        return self._pair[idx]

    def __len__(self):
        return len(self._pair)

    def __iter__(self):
        return iter(self._pair)

    def __repr__(self):
        return f'_CsscBindPairView({self._pair!r})'

    def __eq__(self, other):
        if isinstance(other, _CsscBindPairView):
            return self._pair == other._pair
        if isinstance(other, (tuple, list)):
            return self._pair == tuple(other)
        return NotImplemented


class CsscBind(list):
    """Bind data type: heterogeneous record of cells.

    Internally stored as a list of cells-per-pair tuples so the source
    literal's shape round-trips losslessly. The cells-per-pair count
    is the bind's `pair_width`; literals authored as
    `array_literal({a, b, c})` carry `pair_width = 0` (flat, no
    structural intent), bind_literals `{k1, v1; k2, v2}` carry the
    structural width:

        flat = CsscBind([10, 20, 30], pair_width=0)
        flat[0]    # → 10   (cell 0; flat-array semantics)
        flat[2]    # → 30

        struct = CsscBind([(10, 'x'), (20, 'y'), (30, 'z')], pair_width=2)
        struct[0]      # → 10   (flat access: cell 0 = pair 0 col 0)
        struct[1]      # → 'x'  (flat: cell 1 = pair 0 col 1)
        struct[1][0]   # → 20   (structured: pair 1 col 0 = cell 2)
        struct[1][1]   # → 'y'  (structured: pair 1 col 1 = cell 3)
        struct[2][0]   # → 30
        len(struct)    # → 3 (pair count, matches `.size()`)

    Flat indexing and structured indexing agree on the same underlying
    data — `b[row][col] == b[row * pair_width + col]` — so existing
    code that uses `i[0]`, `i[1]`, … keeps working while new code can
    opt into the structured form for clarity.
    """
    def __init__(self, pairs, pair_width: int = 0):
        # Normalise the pair list. For the structured form (`pair_width
        # > 0`) every entry should be a tuple of `pair_width` cells; for
        # the flat form (`pair_width == 0`) each entry is a single cell.
        # Callers that already pass the right shape get a fast path.
        normalised: list = []
        if pair_width > 0:
            for p in pairs:
                if isinstance(p, (tuple, list)):
                    normalised.append(tuple(p))
                else:
                    # A single cell where a pair was expected — wrap
                    # so structural access still gives a tuple back.
                    normalised.append((p,))
        else:
            for p in pairs:
                normalised.append(p)
        list.__init__(self, normalised)
        self._pair_width = int(pair_width)

    @property
    def pair_width(self) -> int:
        return self._pair_width

    def _cell_count(self) -> int:
        if self._pair_width > 0:
            return list.__len__(self) * self._pair_width
        return list.__len__(self)

    def __getitem__(self, index):
        if isinstance(index, int):
            cells = self._cell_count()
            # Flat-cell access — match the native runtime's
            # `cssc_bind_entry_cell_val(ent, i)` semantics.
            if -cells <= index < cells:
                ix = index if index >= 0 else index + cells
                if self._pair_width > 0:
                    pair_idx, cell = divmod(ix, self._pair_width)
                    return list.__getitem__(self, pair_idx)[cell]
                return list.__getitem__(self, ix)
            # If pair_width > 0 AND index addresses a pair (not a cell),
            # return a pair-view so chained `[col]` works.
            if self._pair_width > 0:
                n_pairs = list.__len__(self)
                if -n_pairs <= index < n_pairs:
                    pix = index if index >= 0 else index + n_pairs
                    return _CsscBindPairView(list.__getitem__(self, pix))
            raise IndexError(
                f'bind cell index {index} out of range '
                f'(have {cells} cells, pair_width={self._pair_width})')
        return list.__getitem__(self, index)

    def pair(self, idx):
        """Return the raw (key, value) tuple at pair-index `idx`."""
        return list.__getitem__(self, idx)


class CsscIterator:
    """C++ STL-style iterator — a pointer into a container.
    Supports dereference (*it), increment (it++), comparison (it != end).
    Created by #iterator[type, source] name;"""
    __slots__ = ('_container', '_index', '_type')

    def __init__(self, container, index: int = 0, iter_type: str = 'auto'):
        self._container = container
        self._index = index
        self._type = iter_type

    def deref(self):
        """Dereference: *it — get the value at current position."""
        if self._index < 0 or self._index >= len(self._container):
            return None
        return self._container[self._index]

    def deref_set(self, value):
        """Dereference assign: *it = value — set value at current position."""
        if 0 <= self._index < len(self._container):
            self._container[self._index] = value

    def increment(self):
        """it++ — advance by one."""
        self._index += 1
        return self

    def decrement(self):
        """it-- — go back by one."""
        self._index -= 1
        return self

    def begin(self):
        """Return new iterator at position 0 of same container."""
        return CsscIterator(self._container, 0, self._type)

    def end(self):
        """Return new iterator at past-the-end of same container."""
        return CsscIterator(self._container, len(self._container), self._type)

    def __eq__(self, other):
        if isinstance(other, CsscIterator):
            return self._container is other._container and self._index == other._index
        if isinstance(other, int):
            return self._index == other
        return NotImplemented

    def __ne__(self, other):
        if isinstance(other, CsscIterator):
            return not (self._container is other._container and self._index == other._index)
        if isinstance(other, int):
            return self._index != other
        return NotImplemented

    def __lt__(self, other):
        if isinstance(other, CsscIterator):
            return self._index < other._index
        if isinstance(other, int):
            return self._index < other
        return NotImplemented

    def __gt__(self, other):
        if isinstance(other, CsscIterator):
            return self._index > other._index
        if isinstance(other, int):
            return self._index > other
        return NotImplemented

    def __repr__(self):
        return f'iterator@{self._index}'


class CsscMatrix:
    """2D pixel matrix — row-major 1D int32 array for framebuffer/graphics.
    Created by #matrix[width, height] var;
    Methods: .get(x,y), .set(x,y,color), .fill(color), .width(), .height(), .copy()"""
    __slots__ = ('_data', '_width', '_height')

    def __init__(self, width: int, height: int, fill: int = 0):
        self._width = int(width)
        self._height = int(height)
        self._data = (ctypes.c_int32 * (self._width * self._height))()
        if fill:
            for i in range(self._width * self._height):
                self._data[i] = fill

    def get(self, x, y=None):
        """Get pixel at (x,y) or raw index."""
        if y is None:
            return self._data[int(x)] if 0 <= int(x) < len(self._data) else 0
        ix = int(y) * self._width + int(x)
        return self._data[ix] if 0 <= ix < len(self._data) else 0

    def set(self, x, y, color):
        """Set pixel at (x,y)."""
        ix = int(y) * self._width + int(x)
        if 0 <= ix < len(self._data):
            self._data[ix] = int(color)

    def fill(self, color):
        """Fill entire matrix with color."""
        c = int(color)
        for i in range(len(self._data)):
            self._data[i] = c

    def width(self):
        return self._width

    def height(self):
        return self._height

    def size(self):
        return self._width * self._height

    def copy(self):
        """Deep copy."""
        m = CsscMatrix(self._width, self._height)
        ctypes.memmove(m._data, self._data, ctypes.sizeof(self._data))
        return m

    def data(self):
        """Return raw ctypes buffer pointer."""
        return self._data

    def __len__(self):
        return self._width * self._height

    def __getitem__(self, index):
        return self._data[int(index)] if 0 <= int(index) < len(self._data) else 0

    def __setitem__(self, index, value):
        if 0 <= int(index) < len(self._data):
            self._data[int(index)] = int(value)

    def __repr__(self):
        return f'Matrix({self._width}x{self._height})'

    def __deepcopy__(self, memo):
        return self.copy()


class CsscObject:
    """CSSC object — deferred code block with labeled instructions.

    Scope model:
      - _vars is the AUTHORITATIVE store for all object members.
      - During execution, _vars is directly used as the runtime's _variables
        (swapped in/out), so all reads and writes go through _vars.
      - Arrow assignments (Object->member = val) modify _vars directly.
      - After execution, the outer scope is restored.

    Created by: object Name { ... } free { ... }
    Executed by: Name() runs top-level code, Name.label() runs labeled section.
    Instantiated by: Name() varname; — returns self as instance.
    """
    __slots__ = ('_name', '_vars', '_instructions', '_top_level', '_free_body',
                 '_runtime', '_executed', '_freed', '_alloc_stores', '_outer_vars',
                 '_constructor_params', '_access_enabled', '_public_labels',
                 '_private_labels', '_public_members', '_private_members')

    def __init__(self, name, instructions, top_level, free_body, runtime):
        self._name = name
        self._vars = {}
        self._instructions = instructions
        self._top_level = top_level
        self._free_body = free_body
        self._runtime = runtime
        self._executed = False
        self._freed = False
        self._alloc_stores = {}
        self._outer_vars = None
        self._constructor_params = []  # typed params: [{type, name, is_ref}, ...]
        self._access_enabled = False   # set by method secure!: enables private:/public: enforcement
        self._public_labels = set()    # labels declared under public:
        self._private_labels = set()   # labels declared under private:
        self._public_members = set()   # member vars declared under public:
        self._private_members = set()  # member vars declared under private:

    def _resolve_label_overload(self, label_name, args):
        """Pick the matching overload for `label_name` given runtime args.
        Returns (params, body) tuple, or (None, None) if no match.

        Matching rules:
          - Filter overloads by REQUIRED param count (kind='param')
          - For each candidate, check type compatibility of required params
          - Score: exact type match=2, generic compat=1, mismatch=0
          - Pick highest-scoring overload (first one if tied)
        """
        if label_name not in self._instructions:
            return (None, None)
        ovl_key = label_name + '__overloads'
        overloads = self._instructions.get(ovl_key)
        if not overloads:
            # No overloads — single definition path
            return (
                self._instructions.get(label_name + '__params', []),
                self._instructions.get(label_name, []),
            )

        def _arg_type(v):
            if isinstance(v, bool):
                return 'bool'
            if isinstance(v, int):
                return 'int'
            if isinstance(v, float):
                return 'float'
            if isinstance(v, str):
                return 'string'
            if isinstance(v, list):
                return 'array'
            if isinstance(v, dict):
                return 'map'
            return 'auto'

        def _score(overload):
            params = overload.get('params', [])
            required = [p for p in params if p.get('kind') == 'param']
            if len(required) != len(args):
                return -1
            score = 0
            for i, p in enumerate(required):
                ptype = (p.get('type') or '').split('<')[0].strip()
                atype = _arg_type(args[i])
                if not ptype or ptype == 'auto':
                    score += 1  # auto matches anything
                elif ptype == atype:
                    score += 10  # exact match
                elif ptype in ('int', 'float') and atype in ('int', 'float'):
                    score += 5   # numeric compat
                else:
                    return -1   # type mismatch — disqualified
            return score

        best = None
        best_score = -1
        for ovl in overloads:
            s = _score(ovl)
            if s > best_score:
                best_score = s
                best = ovl
        if best is None:
            return (None, None)
        return (best.get('params', []), best.get('body', []))

    def __getattr__(self, name):
        # Dunder + Python-internal-looking probes (`__getstate__`, `__copy__`
        # etc.) must not resolve to user labels, else pickling/repr/etc.
        # spin forever. But labels like `_clock` are valid CSSC names —
        # they fall through to the instructions lookup.
        if name.startswith('__'):
            raise AttributeError(name)
        if name.startswith('_') and name not in self._instructions and name not in self._vars:
            raise AttributeError(name)
        if name in self._instructions:
            # Access enforcement: private labels return no-op when called externally
            if self._access_enabled and name in self._private_labels:
                # Check if we're being called from inside the object (via _building_sector)
                inside = (getattr(self._runtime, '_building_sector', None) == self._name)
                if not inside:
                    # External call to private label → silent no-op (return 0x0)
                    def _private_noop(*args, **kwargs):
                        return None
                    return _private_noop
            def _call_instruction(*args):
                if not hasattr(self._runtime, '_call_args_stack'):
                    self._runtime._call_args_stack = []
                self._runtime._call_args_stack.append((name, list(args)))
                # Resolve overload by argument types (or fall back to single def)
                resolved_params, resolved_body = self._resolve_label_overload(name, list(args))
                if resolved_body is None:
                    resolved_body = self._instructions.get(name, [])
                    resolved_params = self._instructions.get(name + '__params', [])
                # Build extra_vars: required params get values from args,
                # transfer params resolve from outer scope (_runtime._variables)
                param_vars = {}
                arg_idx = 0
                for p in (resolved_params or []):
                    if p.get('kind') == 'param':
                        if arg_idx < len(args):
                            param_vars[p['name']] = args[arg_idx]
                            arg_idx += 1
                    elif p.get('kind') == 'transfer':
                        # Pull from outer scope by name
                        sname = p['name']
                        if sname in self._runtime._variables:
                            param_vars[sname] = self._runtime._variables[sname]
                        elif hasattr(self._runtime, '_parent_scopes'):
                            for ps in reversed(self._runtime._parent_scopes):
                                if sname in ps:
                                    param_vars[sname] = ps[sname]
                                    break
                try:
                    return self._run_stmts(resolved_body, extra_vars=param_vars)
                except _DestructSignal:
                    # Object destructed from inside a label — return None (object is dead)
                    return None
                finally:
                    if self._runtime._call_args_stack:
                        self._runtime._call_args_stack.pop()
            return _call_instruction
        if name in self._vars:
            # Access enforcement for member variables
            if self._access_enabled and name in self._private_members:
                inside = (getattr(self._runtime, '_building_sector', None) == self._name)
                if not inside:
                    return None  # private member → 0x0
            return self._vars[name]
        return None

    def _run_stmts(self, stmts, extra_vars=None):
        """Execute statements in the object's scope.

        Strategy: swap _vars into the runtime as _variables. This means all
        variable reads/writes (including arrow assigns) go through _vars
        directly. No copy-back needed.
        """
        # Save outer scope
        outer_vars = self._runtime._variables
        outer_types = self._runtime._variable_types
        outer_building = getattr(self._runtime, '_building_sector', None)

        # Make object's _vars the active scope, with self-reference
        self._vars[self._name] = self
        self._runtime._variables = self._vars
        self._runtime._variable_types = {}
        self._runtime._building_sector = self._name

        # Push outer scope as parent so #req and other lookups can find outer vars
        if not hasattr(self._runtime, '_parent_scopes'):
            self._runtime._parent_scopes = []
        self._runtime._parent_scopes.append(outer_vars)

        # Inject label parameters as named variables
        if extra_vars:
            self._runtime._variables.update(extra_vars)

        # `mirror value;` in an object label — like in `#define`
        # bodies, mirror captures the value but lets the body keep
        # running so cleanup statements after the mirror still
        # execute. Per-stmt try/except: `mirror` raises which aborts
        # the current stmt path (e.g. inside an if-body) but the
        # FOR loop walks the remaining stmts. `return` / `destruct`
        # stay as hard short-circuits.
        result = None
        _UNSET = object()
        mirror_value = _UNSET
        try:
            for stmt in stmts:
                try:
                    self._runtime._exec_node(stmt)
                except _MirrorSignal as m:
                    if mirror_value is _UNSET:
                        mirror_value = m.value
                    # continue with the next stmt — cleanup runs
        except _DestructSignal:
            # `destruct;` inside the object — fire free{} block, mark dead.
            # Caller continues normally; destruct is end-of-object, not panic.
            self.run_free()
            self._vars.clear()
            self._executed = False
        except _ReturnSignal as r:
            mirror_value = r.value
        except _SysReturnSignal:
            raise
        finally:
            # Pop parent scope
            if self._runtime._parent_scopes:
                self._runtime._parent_scopes.pop()
        if mirror_value is not _UNSET:
            result = mirror_value

            # Capture alloc stores for #delete tracking
            for sv in ('_stack_vars', '_heap_vars', '_auto_vars'):
                store = getattr(self._runtime, sv, None)
                if store:
                    for vn in list(store.keys()):
                        if vn in self._vars and vn != self._name:
                            self._alloc_stores[vn] = (sv, store.pop(vn))

            # Restore outer scope — _vars already has all changes
            self._runtime._variables = outer_vars
            self._runtime._variable_types = outer_types
            self._runtime._building_sector = outer_building

        return result

    def execute(self, *args):
        """Execute the object's top-level code. Returns self as instance.
        If constructor_params exist, args are injected as typed variables."""
        self._executed = True
        # Inject constructor parameters from args
        if self._constructor_params and args:
            for i, cp in enumerate(self._constructor_params):
                if i < len(args):
                    self._vars[cp['name']] = args[i]
        self._run_stmts(self._top_level)
        return self

    def run_free(self):
        """Execute the free block. Only runs once."""
        if hasattr(self, '_freed') and self._freed:
            return
        self._freed = True
        if self._free_body:
            for vname, (sv, alloc) in self._alloc_stores.items():
                store = getattr(self._runtime, sv, None)
                if store is not None:
                    store[vname] = alloc
            try:
                self._run_stmts(self._free_body)
            except _DestructSignal:
                pass  # already destructing

    def __repr__(self):
        labels = [k for k in self._instructions.keys() if '__' not in k]
        return f'Object({self._name}, labels={labels})'


class CsscLoadedModule:
    """A loaded .cssc file as a module — behaves as a sector.

    Every #load/#include creates a module-sector: all global-scope members
    (variables, functions, objects, sectors) from the loaded file are bound
    into one sector accessible via the alias variable.

    Supports: mod::func(), mod->member, mod.label(), #free[mod]
    """
    __slots__ = ('_name', '_path', '_runtime', '_ast', '_started',
                 '_vars', '_public', '_private', '_freed', '_free_body',
                 '_alloc_stores', '_depend_origin')

    def __init__(self, name: str, path: str, runtime, ast):
        self._name = name
        self._path = path
        self._runtime = runtime  # child CsscRuntime with its own scope
        self._ast = ast
        self._started = False
        self._vars = {}          # populated after start()
        self._public = set()
        self._private = set()
        self._freed = False
        self._free_body = None
        self._alloc_stores = {}

    def start(self):
        """Execute the module from line 0 (global scope).
        After execution, all global variables become sector members."""
        if not self._started:
            self._runtime.execute(self._ast)
            self._started = True
            # Bind all global-scope variables as public sector members
            self._vars = dict(self._runtime._variables)
            self._public = set(self._vars.keys())
            # Also include registered modules (sectors, objects, etc.)
            for k, v in self._runtime._modules.items():
                if k not in self._vars:
                    self._vars[k] = v
                    self._public.add(k)

    def get_namespace(self):
        """Return public members as {name: value/callable} — sector interface."""
        if not self._started:
            self.start()
        return {n: self._vars[n] for n in self._public if n in self._vars}

    def get_docs(self):
        return {}

    def is_public(self, name):
        return name in self._public

    def get_member(self, name):
        if not self._started:
            self.start()
        return self._vars.get(name)

    def run_free(self):
        """Free the module — run child runtime's sectors' free blocks."""
        if self._freed:
            return
        self._freed = True
        if hasattr(self._runtime, '_sectors'):
            for s in self._runtime._sectors:
                try:
                    s.run_free()
                except Exception:
                    pass

    def __getattr__(self, name):
        if name.startswith('_'):
            raise AttributeError(name)
        if not self._started:
            self.start()
        val = self._vars.get(name)
        if val is not None:
            return val
        return None

    def __repr__(self):
        state = 'started' if self._started else 'loaded'
        return f'CsscModule({self._name}, {state})'


class CsscPointer:
    """Reference wrapper — holds a variable name and optional index.
    Created by *var or *var[index] syntax. Resolves LIVE at each access.
    When the source variable is #delete'd, references become null/0x0."""
    __slots__ = ('name', 'index')

    def __init__(self, name: str, index=None):
        self.name = name
        self.index = index

    def __repr__(self):
        if self.index is not None:
            return f'*{self.name}[{self.index}]'
        return f'*{self.name}'


class CsscFunction:
    """Wrapper for #define/#cdefine functions.
    Callable like a function; a #define'd slot is ALSO an index-based
    `map<int>` of exactly two cells — CSSC has no named-field / key-value
    access on it, only integer indices:
      func[0]  → last returned value (0x0 if never called)
      func[1]  → address (id) of the underlying callback
    `func[1] = other[1]` rebinds the callback (function-slot swap), and
    `typeof(func) == 'map'`.
    Using an #fvar without () is an error — #fvar is strict call-only."""
    __slots__ = ('_callback', '_last_return', '_name', '_is_fvar', '_max_bits', '_encode_fn',
                 '_body', '_params', '_call_count')

    # Address → callback registry so a function slot can be *rebound* by
    # address: `a[1] = b[1]` sets a's behaviour to the callback living at
    # b's address. Strong refs keep every callback resolvable for the
    # program's lifetime (so a saved `&x[1]` still resolves after x has
    # been reassigned) — this is how CSSC swaps function slots.
    _addr_registry = {}

    def __init__(self, callback, name='', is_fvar=False, max_bits=None, encode_fn=None):
        self._callback = callback
        self._last_return = None
        self._name = name
        self._is_fvar = is_fvar
        self._max_bits = max_bits  # capacity of the holding variable
        self._encode_fn = encode_fn  # reference to _encode_value for size checking
        self._body = None   # AST body (for #redefine support)
        self._params = []   # parameter names (for #cdefine)
        self._call_count = 0
        CsscFunction._addr_registry[id(callback)] = callback

    def __call__(self, *args, **kwargs):
        self._call_count += 1
        result = self._callback(*args, **kwargs)
        # Check if return value fits in the function variable's capacity
        # Skip check for callable/function returns (they're references, not data)
        if (result is not None and self._max_bits and self._encode_fn
                and not callable(result) and not isinstance(result, CsscFunction)):
            encoded = self._encode_fn(result)
            used_bits = len(encoded) * 8
            if used_bits > self._max_bits:
                raise CsscError(
                    operation='Runtime',
                    detail=f'Return value overflow: function \'{self._name}\' return uses {used_bits} bits but variable capacity is {self._max_bits} bits',
                    hint=f'Increase the variable size: #stack/heap[type, {used_bits}] {self._name};')
        self._last_return = result
        return result

    def __getitem__(self, key):
        # A `#define`d slot is an INDEX-based `map<int>` of exactly two
        # cells — CSSC has no named-field / key-value access on it:
        #   slot[0] → last-returned value   slot[1] → address (id)
        if self._is_fvar:
            raise CsscError(operation='Runtime',
                            detail=f'#fvar \'{self._name}\' is strict call-only — use {self._name}() to call it',
                            hint=f'#fvar variables cannot be indexed. Use {self._name}() to invoke.')
        if key == 0:
            return self._last_return
        if key == 1:
            return id(self._callback)
        raise CsscError(operation='Runtime',
                        detail=f'Function \'{self._name}\': index {key!r} out of range — a function slot is a map<int> with [0] (value) and [1] (address).',
                        hint='use [0] or [1]; CSSC function slots have no named "value"/"address" keys')

    def __setitem__(self, key, value):
        """Writable counterpart of `__getitem__` — index-based only,
        letting function slots be swapped by address:

            #stack[int, 48] cpy = &a[1];   // save a's address
            a[1] = b[1];                    // a now runs b's body
            b[1] = cpy;                     // b now runs a's old body

        `slot[0]` overwrites the cached last-return; `slot[1]` rebinds the
        underlying callback to the one living at the given address
        (obtained from another slot's `[1]`)."""
        if self._is_fvar:
            raise CsscError(operation='Runtime',
                            detail=f'#fvar \'{self._name}\' is strict call-only — use {self._name}() to call it',
                            hint=f'#fvar variables cannot be indexed. Use {self._name}() to invoke.')
        if key == 0:
            self._last_return = value
            return
        if key == 1:
            try:
                addr = int(value)
            except (TypeError, ValueError):
                raise CsscError(
                    operation='Runtime',
                    detail=(f'Function \'{self._name}\': `[1]` (address) '
                            f'assignment expects an integer address '
                            f'(from another function slot\'s [1]), got '
                            f'{type(value).__name__}'))
            target = CsscFunction._addr_registry.get(addr)
            if target is None:
                raise CsscError(
                    operation='Runtime',
                    detail=(f'Function \'{self._name}\': no function found '
                            f'at address {addr}'),
                    hint='use an address obtained from another function '
                         'slot\'s [1]')
            # Rebind this slot's behaviour to the target callback (the
            # function-slot swap). The address stays resolvable via the
            # registry for any previously-saved `&x[1]`.
            self._callback = target
            CsscFunction._addr_registry[id(target)] = target
            return
        raise CsscError(operation='Runtime',
                        detail=f'Function \'{self._name}\': index {key!r} out of range — use [0] (value) or [1] (address).')

    def __repr__(self):
        return f'<func:{self._name}>'

    def __str__(self):
        # Index-based `map<int>` display `{cell0, cell1}` — the same shape
        # `_format_value` gives an integer-keyed map — NOT a named
        # key/value struct (CSSC has no such thing on a function slot).
        lr = self._last_return
        if lr is self:
            cell0 = '<self>'
        elif lr is None:
            cell0 = '0x0'
        else:
            cell0 = str(lr)
        return f'{{{cell0}, {id(self._callback)}}}'

    def __eq__(self, other):
        if other is None:
            return False
        if isinstance(other, CsscFunction):
            return self._callback is other._callback
        return NotImplemented

    def __bool__(self):
        return True


# ---------------------------------------------------------------------------
# Token types
# ---------------------------------------------------------------------------
TK_DIRECTIVE = 'DIRECTIVE'
TK_INCLUDE = 'INCLUDE'
TK_IDENT = 'IDENT'
TK_NUMBER = 'NUMBER'
TK_STRING = 'STRING'
TK_NULL = 'NULL'
TK_TRUE = 'TRUE'
TK_FALSE = 'FALSE'
TK_IF = 'IF'
TK_ELSE = 'ELSE'
TK_FOR = 'FOR'
TK_WHILE = 'WHILE'
TK_BREAK = 'BREAK'
TK_CONTINUE = 'CONTINUE'
TK_RETURN = 'RETURN'
TK_JUMP = 'JUMP'
TK_SELECT = 'SELECT'
TK_LBRACE = 'LBRACE'
TK_RBRACE = 'RBRACE'
TK_LPAREN = 'LPAREN'
TK_RPAREN = 'RPAREN'
TK_LBRACKET = 'LBRACKET'
TK_RBRACKET = 'RBRACKET'
TK_SEMICOLON = 'SEMICOLON'
TK_COMMA = 'COMMA'
TK_DOT = 'DOT'
TK_ARROW = 'ARROW'
TK_DCOLON = 'DCOLON'
TK_ASSIGN = 'ASSIGN'
TK_PLUS_ASSIGN = 'PLUS_ASSIGN'
TK_MINUS_ASSIGN = 'MINUS_ASSIGN'
TK_EQ = 'EQ'
TK_NEQ = 'NEQ'
TK_LT = 'LT'
TK_GT = 'GT'
TK_LTE = 'LTE'
TK_GTE = 'GTE'
TK_PLUS = 'PLUS'
TK_MINUS = 'MINUS'
TK_STAR = 'STAR'
TK_SLASH = 'SLASH'
TK_PERCENT = 'PERCENT'
TK_AND = 'AND'
TK_OR = 'OR'
TK_NOT = 'NOT'
TK_PLUS_PLUS = 'PLUS_PLUS'
TK_MINUS_MINUS = 'MINUS_MINUS'
TK_HASH = 'HASH'
TK_SECTOR = 'SECTOR'
TK_OBJECT = 'OBJECT'
TK_FREE = 'FREE'
TK_DESTRUCT = 'DESTRUCT'
TK_MIRROR = 'MIRROR'
TK_CALL = 'CALL'
TK_METHOD = 'METHOD'
TK_DO = 'DO'
TK_PUBLIC = 'PUBLIC'
TK_PRIVATE = 'PRIVATE'
TK_COLON = 'COLON'
TK_AMP = 'AMP'
TK_QUESTION = 'QUESTION'
TK_EOF = 'EOF'

_KEYWORDS = {
    'if': TK_IF, 'else': TK_ELSE, 'for': TK_FOR, 'while': TK_WHILE,
    'break': TK_BREAK, 'continue': TK_CONTINUE, 'return': TK_RETURN, 'jump': TK_JUMP,
    'select': TK_SELECT,
    'null': TK_NULL, 'none': TK_NULL, 'true': TK_TRUE, 'false': TK_FALSE,
    'sector': TK_SECTOR, 'object': TK_OBJECT, 'free': TK_FREE,
    'destruct': TK_DESTRUCT, 'mirror': TK_MIRROR, 'call': TK_CALL,
    'method': TK_METHOD, 'do': TK_DO,
    'public': TK_PUBLIC, 'private': TK_PRIVATE,
}


class CsscToken:
    """CSSC lexer token."""
    __slots__ = ['type', 'value', 'line', 'column', 'is_hex']

    def __init__(self, type: str, value: Any = None, line: int = 0, column: int = 0,
                 is_hex: bool = False):
        self.type = type
        self.value = value
        self.line = line
        self.column = column
        # True iff this token came from a hex literal (0xNN). Used to
        # disambiguate `0xAA` as hex-keyed variable reference vs. int literal.
        self.is_hex = is_hex

    def __repr__(self) -> str:
        return f"Token({self.type}, {self.value!r}, L{self.line})"


# ---------------------------------------------------------------------------
# Lexer
# ---------------------------------------------------------------------------
class CsscLexer:
    """Tokenize CSSC source code."""

    def __init__(self, source: str, filename: str = '<script>'):
        self._source = source
        self._filename = filename
        self._pos = 0
        self._line = 1
        self._column = 1
        self._length = len(source)

    def _peek(self, offset: int = 0) -> str:
        idx = self._pos + offset
        return self._source[idx] if idx < self._length else '\0'

    def _advance(self) -> str:
        ch = self._source[self._pos] if self._pos < self._length else '\0'
        self._pos += 1
        if ch == '\n':
            self._line += 1
            self._column = 1
        else:
            self._column += 1
        return ch

    def _skip_whitespace(self):
        while self._pos < self._length and self._source[self._pos] in ' \t\r\n':
            self._advance()

    def _skip_line_comment(self):
        while self._pos < self._length and self._source[self._pos] != '\n':
            self._advance()

    def _skip_block_comment(self):
        self._advance()  # skip /
        self._advance()  # skip *
        while self._pos + 1 < self._length:
            if self._source[self._pos] == '*' and self._source[self._pos + 1] == '/':
                self._advance()
                self._advance()
                return
            self._advance()
        # Unterminated block comment — just consume rest
        while self._pos < self._length:
            self._advance()

    def _read_string(self, quote: str) -> str:
        self._advance()  # skip opening quote
        result = []
        while self._pos < self._length:
            ch = self._source[self._pos]
            if ch == '\\' and self._pos + 1 < self._length:
                self._advance()
                esc = self._advance()
                escape_map = {'n': '\n', 't': '\t', 'r': '\r', '\\': '\\',
                              '"': '"', "'": "'", '0': '\0'}
                result.append(escape_map.get(esc, '\\' + esc))
            elif ch == quote:
                self._advance()
                return ''.join(result)
            else:
                result.append(self._advance())
        raise CsscError(operation='Lexer', detail='Unterminated string', line=self._line)

    def _read_number(self) -> str:
        start = self._pos
        has_dot = False
        # hex
        if self._peek() == '0' and self._peek(1) in ('x', 'X'):
            self._advance()
            self._advance()
            while self._pos < self._length and self._source[self._pos] in '0123456789abcdefABCDEF':
                self._advance()
            return self._source[start:self._pos]
        while self._pos < self._length:
            ch = self._source[self._pos]
            if ch == '.' and not has_dot and self._peek(1).isdigit():
                has_dot = True
                self._advance()
            elif ch.isdigit():
                self._advance()
            else:
                break
        return self._source[start:self._pos]

    def _read_identifier(self) -> str:
        start = self._pos
        while self._pos < self._length and (self._source[self._pos].isalnum() or self._source[self._pos] == '_'):
            self._advance()
        return self._source[start:self._pos]

    def _read_directive(self) -> CsscToken:
        """Parse #REQUIRE["path"] varname; or #VARIABLE[type] varname; or #include("mod") varname;"""
        line, col = self._line, self._column
        self._advance()  # skip #

        # Peek for #include(
        if self._pos < self._length and self._source[self._pos:self._pos + 7] == 'include':
            saved = self._pos
            name = self._read_identifier()
            self._skip_whitespace()
            if self._pos < self._length and self._source[self._pos] == '(':
                self._advance()  # skip (
                self._skip_whitespace()
                # Read module name — quoted string
                mod_name = ''
                if self._pos < self._length and self._source[self._pos] in ('"', "'"):
                    mod_name = self._read_string(self._source[self._pos])
                self._skip_whitespace()
                if self._pos < self._length and self._source[self._pos] == ')':
                    self._advance()  # skip )
                self._skip_whitespace()
                varname = ''
                if self._pos < self._length and (self._source[self._pos].isalpha() or self._source[self._pos] == '_'):
                    varname = self._read_identifier()
                return CsscToken(TK_INCLUDE, {'module': mod_name, 'var': varname}, line, col)
            # Not #include(...), restore
            self._pos = saved

        # Regular directive: #NAME[arg] varname  OR  #NAME(arg) varname
        name = self._read_identifier()
        arg = ''
        self._skip_whitespace()
        if self._pos < self._length and self._source[self._pos] == '[':
            self._advance()  # skip [
            # Arg can contain nested function calls like cps::search_walk("x")
            depth = 1
            arg_chars = []
            while self._pos < self._length and depth > 0:
                ch = self._source[self._pos]
                if ch == '[':
                    depth += 1
                elif ch == ']':
                    depth -= 1
                    if depth == 0:
                        self._advance()
                        break
                if depth > 0:
                    arg_chars.append(ch)
                self._advance()
            arg = ''.join(arg_chars)
        elif self._pos < self._length and self._source[self._pos] == '(':
            # Parenthesized arg: #define(var), #cdefine(func, p1, p2), #fvar(type), #param(type), #qvar(type, expr)
            self._advance()  # skip (
            depth = 1
            arg_chars = []
            while self._pos < self._length and depth > 0:
                ch = self._source[self._pos]
                if ch == '(':
                    depth += 1
                elif ch == ')':
                    depth -= 1
                    if depth == 0:
                        self._advance()
                        break
                if depth > 0:
                    arg_chars.append(ch)
                self._advance()
            arg = ''.join(arg_chars)

        self._skip_whitespace()
        varname = ''
        # CSSC v5+ supports a `&` (explicit copy) or `*` (deprecated ref-marker)
        # prefix on the varname for directives that wire ownership semantics —
        # e.g. `#scanp(func, type, pos) &v;` for an explicit snapshot, or the
        # legacy `*v` form. We capture the prefix so the parser can route on it.
        var_prefix = ''
        if self._pos < self._length and self._source[self._pos] in ('&', '*'):
            var_prefix = self._source[self._pos]
            self._advance()
            self._skip_whitespace()
        # Hex-keyed var name: `#stack[int,32] 0x0AA = 1;` — preserve the 0x prefix so
        # downstream runtime/codegen can route to hex-var storage.
        if (self._pos + 1 < self._length
                and self._source[self._pos] == '0'
                and self._source[self._pos + 1] in ('x', 'X')):
            start = self._pos
            self._advance(); self._advance()  # skip 0x
            while self._pos < self._length and self._source[self._pos] in '0123456789abcdefABCDEF':
                self._advance()
            varname = self._source[start:self._pos]
        elif self._pos < self._length and (self._source[self._pos].isalpha() or self._source[self._pos] == '_'):
            varname = self._read_identifier()
            # Support Object->member syntax in directive var names
            if (self._pos + 1 < self._length and
                    self._source[self._pos] == '-' and self._source[self._pos + 1] == '>'):
                self._pos += 2  # consume ->
                member = self._read_identifier()
                varname = varname + '->' + member

        return CsscToken(TK_DIRECTIVE,
                         {'name': name, 'arg': arg, 'var': varname,
                          'var_prefix': var_prefix},
                         line, col)

    def tokenize(self) -> List[CsscToken]:
        tokens: List[CsscToken] = []
        while self._pos < self._length:
            self._skip_whitespace()
            if self._pos >= self._length:
                break

            ch = self._source[self._pos]
            two = self._source[self._pos:self._pos + 2] if self._pos + 1 < self._length else ch

            # Comments
            if two == '//':
                self._skip_line_comment()
                continue
            if two == '/*':
                self._skip_block_comment()
                continue

            line, col = self._line, self._column

            # Directive / include
            if ch == '#':
                tokens.append(self._read_directive())
                continue

            # String
            if ch in ('"', "'"):
                tokens.append(CsscToken(TK_STRING, self._read_string(ch), line, col))
                continue

            # Number
            if ch.isdigit():
                num_str = self._read_number()
                if num_str.startswith('0x') or num_str.startswith('0X'):
                    tokens.append(CsscToken(TK_NUMBER, int(num_str, 16), line, col, is_hex=True))
                elif '.' in num_str:
                    tokens.append(CsscToken(TK_NUMBER, float(num_str), line, col))
                else:
                    tokens.append(CsscToken(TK_NUMBER, int(num_str), line, col))
                continue

            # Identifier / keyword
            if ch.isalpha() or ch == '_':
                ident = self._read_identifier()
                kw = _KEYWORDS.get(ident)
                tokens.append(CsscToken(kw if kw else TK_IDENT, ident, line, col))
                continue

            # Multi-char operators (check longest first)
            if two == '::':
                self._advance(); self._advance()
                tokens.append(CsscToken(TK_DCOLON, '::', line, col))
                continue
            if two == '->':
                self._advance(); self._advance()
                tokens.append(CsscToken(TK_ARROW, '->', line, col))
                continue
            if two == '&&':
                self._advance(); self._advance()
                tokens.append(CsscToken(TK_AND, '&&', line, col))
                continue
            if two == '||':
                self._advance(); self._advance()
                tokens.append(CsscToken(TK_OR, '||', line, col))
                continue
            if two == '==':
                self._advance(); self._advance()
                tokens.append(CsscToken(TK_EQ, '==', line, col))
                continue
            if two == '!=':
                self._advance(); self._advance()
                tokens.append(CsscToken(TK_NEQ, '!=', line, col))
                continue
            if two == '<=':
                self._advance(); self._advance()
                tokens.append(CsscToken(TK_LTE, '<=', line, col))
                continue
            if two == '>=':
                self._advance(); self._advance()
                tokens.append(CsscToken(TK_GTE, '>=', line, col))
                continue
            if two == '++':
                self._advance(); self._advance()
                tokens.append(CsscToken(TK_PLUS_PLUS, '++', line, col))
                continue
            if two == '--':
                self._advance(); self._advance()
                tokens.append(CsscToken(TK_MINUS_MINUS, '--', line, col))
                continue
            if two == '+=':
                self._advance(); self._advance()
                tokens.append(CsscToken(TK_PLUS_ASSIGN, '+=', line, col))
                continue
            if two == '-=':
                self._advance(); self._advance()
                tokens.append(CsscToken(TK_MINUS_ASSIGN, '-=', line, col))
                continue

            # Single-char
            single_map = {
                '{': TK_LBRACE, '}': TK_RBRACE,
                '(': TK_LPAREN, ')': TK_RPAREN,
                '[': TK_LBRACKET, ']': TK_RBRACKET,
                ';': TK_SEMICOLON, ',': TK_COMMA, '.': TK_DOT,
                ':': TK_COLON,
                '=': TK_ASSIGN, '<': TK_LT, '>': TK_GT,
                '+': TK_PLUS, '-': TK_MINUS,
                '*': TK_STAR, '/': TK_SLASH, '%': TK_PERCENT,
                '!': TK_NOT, '&': TK_AMP, '?': TK_QUESTION,
            }
            if ch in single_map:
                self._advance()
                tokens.append(CsscToken(single_map[ch], ch, line, col))
                continue

            # Unknown — skip
            self._advance()

        tokens.append(CsscToken(TK_EOF, None, self._line, self._column))
        return tokens


# ---------------------------------------------------------------------------
# Parser
# ---------------------------------------------------------------------------
class CsscParser:
    """Recursive-descent parser producing AST dicts.

    New in v5.1:
      - for (init; cond; step) { body }
      - logical: &&, ||, !
      - namespace calls: cssc::func(), mod::func()
      - result capture: call_expr varname;
      - dot method calls: obj.method(args)
    """

    def __init__(self, tokens: List[CsscToken], filename: str = '<script>'):
        self._tokens = tokens
        self._pos = 0
        self._filename = filename
        self._in_define_body = False  # Track if inside #define/#cdefine body

    def _peek(self, offset: int = 0) -> CsscToken:
        idx = self._pos + offset
        return self._tokens[idx] if idx < len(self._tokens) else CsscToken(TK_EOF)

    def _advance(self) -> CsscToken:
        tok = self._tokens[self._pos] if self._pos < len(self._tokens) else CsscToken(TK_EOF)
        self._pos += 1
        return tok

    def _match(self, *types) -> Optional[CsscToken]:
        if self._peek().type in types:
            return self._advance()
        return None

    def _expect(self, token_type: str) -> CsscToken:
        tok = self._peek()
        if tok.type != token_type:
            raise CsscError(
                operation='Parser',
                detail=f"Expected {token_type}, got {tok.type} ({tok.value!r})",
                line=tok.line, column=tok.column,
            )
        return self._advance()

    def _expect_semicolon(self, line=0):
        """Strict semicolon check — CSSC requires ';' after every statement."""
        tok = self._peek()
        if tok.type != TK_SEMICOLON:
            raise CsscError(
                operation='Parser',
                detail=f'Missing semicolon ";" at end of statement',
                hint='CSSC requires a semicolon after every statement.',
                line=line or tok.line, column=tok.column,
            )
        self._advance()

    def _at_end(self) -> bool:
        return self._peek().type == TK_EOF

    def parse(self, strict_literals: bool = True) -> list:
        """Parse all tokens into a top-level AST list.

        `strict_literals` controls the v5 bare-literal-in-expression
        validation pass: when True (production / CLI use) the parse
        raises CsscError on any bare string/array/map literal that
        appears in a position where it would have no owning slot.
        When False (LSP partial-parse use) the validation is skipped
        — the LSP runs an equivalent walker as a soft diagnostic
        instead so red underlines appear without rejecting the parse
        mid-keystroke."""
        stmts = []
        while not self._at_end():
            stmt = self._parse_statement()
            if stmt:
                stmts.append(stmt)
        if strict_literals:
            self._validate_no_bare_literals(stmts)
        return stmts

    # -----------------------------------------------------------------------
    # v5 bare-literal validator
    # -----------------------------------------------------------------------
    # CSSC v5 reference-by-default ownership: every heap value must be
    # owned by a declared slot. A `"hello"` / `{1,2,3}` / `[1,2]` /
    # `{"k": v}` AST node appearing in an "escape position" — function
    # arg, container element, non-comparison binary operand, statement
    # expression — has no owner the compiler can attach it to. We
    # reject those at parse time, with a precise hint pointing the user
    # at `#stack[type, N] name = …;` as the fix.
    #
    # The validator is a top-down walker that carries a `ctx` flag set
    # for each AST node type it descends into: the flag tells the child
    # whether it's in a slot-adoption position (RHS of `=`, init of a
    # var_decl, return value, mirror, comparison operand) where bare
    # literals are fine. The whitelist is intentionally narrow.
    _COMPARISON_OPS = frozenset(['==', '!=', '<', '>', '<=', '>=', 'in'])
    _LITERAL_HEAP_NODE_TYPES = frozenset([
        'string',          # bare "..." or '...'
        'array',           # [1, 2, 3]
        'array_literal',   # {1, 2, 3}
        'map_literal',     # {"k": v}
        'bind_literal',    # {a, b; c, d}
    ])

    def _validate_no_bare_literals(self, ast: list) -> None:
        """Top-level entry: walks every statement, reports violations
        as `CsscError(operation='Parse', code='E020')`. First violation
        aborts the parse — matching the rest of the parser's behaviour.
        """
        for node in ast:
            self._walk_validate(node, in_safe_pos=False)

    def _walk_validate(self, node, in_safe_pos: bool) -> None:
        if not isinstance(node, dict):
            return
        ntype = node.get('type', '')

        # Heap-literal check at THIS node — fires only when we're in an
        # escape position (in_safe_pos=False). Skip immediately for
        # immediate types (int/float/bool/null already get type 'literal'
        # below) so the rest of the walker is purely structural.
        #
        # Param dicts coming out of `<kind: name>` declarations share
        # the `'type'` field with literal nodes (`type='string'` etc.)
        # but carry a `'kind'` discriminator instead of a `'value'` /
        # `'items'` / `'pairs'` payload. Recognising the literal-shape
        # explicitly stops the walker from confusing
        # `addframe<string: &displaytxt>` with a bare `"…"` literal in
        # arg position. We also bail when the node is missing both the
        # `'value'` / `'items'` / `'pairs'` payload AND a `'line'` —
        # that combination is a metadata blob, not a user-visible heap
        # value the v6 ownership rule cares about.
        if ntype in self._LITERAL_HEAP_NODE_TYPES and not in_safe_pos:
            looks_like_literal = (
                'value' in node or 'items' in node or
                'elements' in node or 'pairs' in node
            )
            # 'kind' is the param-decl discriminator. If present we
            # know this isn't a literal AST node at all.
            if 'kind' not in node and looks_like_literal:
                self._reject_bare_literal(node)

        # Per-node descent rules: which child fields are "safe" (slot-
        # adoption / consumed-by-op) and which are "escape" (untracked
        # heap value flowing out of an expression).
        if ntype == 'assign' or ntype == 'var_decl':
            # RHS adopts into the slot. Whether assigning a fresh slot
            # via #stack or rebinding an existing one — same rule.
            for child_key in ('value', 'init'):
                child = node.get(child_key)
                if child is not None:
                    self._walk_validate(child, in_safe_pos=True)
            return

        if ntype in ('arrow_assign', 'dot_assign', 'index_assign'):
            # obj->m = lit, obj.m = lit, arr[i] = lit — slot adopts.
            child = node.get('value')
            if child is not None:
                self._walk_validate(child, in_safe_pos=True)
            # Object expression on the LHS follows the usual rule.
            c = node.get('object')
            if c is not None:
                self._walk_validate(c, in_safe_pos=False)
            # Index key is consumed at the operation: the runtime
            # (cssc_map_*_set/get, cssc_vector_set/get, bind helpers) copies
            # the key bytes internally OR consumes them inline. A bare
            # string literal here is a v6 transient-temp — auto-cleaned
            # via the runtime scope_pop. Mark safe so `m["k"] = v`,
            # `arr["x"]`, etc. parse without forcing an interim slot for
            # the key. Doc §2.5 transient-temp rule.
            c = node.get('index')
            if c is not None:
                self._walk_validate(c, in_safe_pos=True)
            return

        if ntype in ('return', 'mirror'):
            child = node.get('value')
            if child is not None:
                self._walk_validate(child, in_safe_pos=True)
            return

        if ntype == 'binary':
            op = node.get('op', '')
            # Comparison operands are slot-adoption-safe — the literal
            # is consumed by the boolean result, can't escape.
            is_cmp = op in self._COMPARISON_OPS
            for k in ('left', 'right'):
                c = node.get(k)
                if c is not None:
                    self._walk_validate(c, in_safe_pos=is_cmp)
            return

        if ntype in ('call', 'method_call', 'dot_call', 'ns_call', 'member_ns_call'):
            # Call args — ALL heap-literal kinds (string / array /
            # map / bind) are treated as slot-adoption-safe under v6
            # auto-cleanup (spec §2.5 "Untyped Temps in Argument-
            # Positionen — Auto-Cleanup-Regel"):
            #
            #   `myfunc("hello");`     ← string IS transient + scoped
            #   `vec.push_back({a, b});` ← bind IS transient + scoped
            #
            # The v6-native runtime brackets every function body with
            # `cssc_scope_push` / `cssc_scope_pop`. Any heap value
            # allocated for the call's args (string literal slot,
            # bind/array materialisation, concat result) lives only
            # for that call frame and is bulk-freed at function
            # return. NO leak, NO escape — provided the callee
            # doesn't try to STASH the value somewhere outside its
            # own frame (e.g. assigning to an outer slot or a
            # long-lived container). That escape case is the LSP's
            # job to flag with a HINT (`TRANSIENT_LITERAL_ESCAPE`)
            # — not the parser's, because we can't reliably tell at
            # parse time whether the callee escapes its args.
            for arg in node.get('args', []) or []:
                # All literal types are now safe at call-arg position.
                self._walk_validate(arg, in_safe_pos=True)
            # The callee itself might be an expression (e.g. obj from
            # obj.method()); recurse into it too.
            for k in ('object', 'callee'):
                c = node.get(k)
                if c is not None:
                    self._walk_validate(c, in_safe_pos=False)
            return

        if ntype == 'unary':
            # Unary operands: `&literal` would be `&"x"` — disallow by
            # treating the operand as escape. `*literal` same.
            c = node.get('operand')
            if c is not None:
                self._walk_validate(c, in_safe_pos=False)
            return

        if ntype == 'copy_of':
            # &expr — operand is consumed by the deep-copy and the
            # result is the caller's owned copy, so technically OK.
            # But literals as operand to & are nonsense (`&"x"`) and
            # we'd rather the user just declare a slot. Reject same.
            c = node.get('operand')
            if c is not None:
                self._walk_validate(c, in_safe_pos=False)
            return

        # Container builder nodes — their items/pairs inherit the
        # safe-pos flag of the OUTER expression. When a container
        # literal lives in a slot-init position OR (post-relaxation)
        # in a call-arg position, its inner heap literals (strings,
        # nested bind/array/map) are guaranteed to be auto-cleaned
        # via the runtime's scope_pop, so they don't need their own
        # named slot.
        if ntype in ('array', 'array_literal'):
            for it in node.get('items', node.get('elements', [])) or []:
                self._walk_validate(it, in_safe_pos=in_safe_pos)
            return
        if ntype == 'map_literal':
            for pair in node.get('pairs', []) or []:
                if isinstance(pair, (list, tuple)) and len(pair) >= 2:
                    self._walk_validate(pair[1], in_safe_pos=in_safe_pos)
            return
        if ntype == 'bind_literal':
            # Walk every cell in every pair. Each pair contributes
            # `pair_width` cells (uniform per literal); a 2-cell pair
            # carries (key, val), a 3-cell pair carries (a, b, c), etc.
            # The CIR lowering enforces uniform width; here we just
            # iterate whatever the parser produced.
            for pair in node.get('pairs', []) or []:
                if isinstance(pair, (list, tuple)):
                    for cell in pair:
                        self._walk_validate(cell, in_safe_pos=in_safe_pos)
            return

        # Structural / control-flow nodes: descend into children as
        # statement contexts (NOT in slot-adoption pos for arbitrary
        # sub-expressions, but block-bodies and label-bodies are
        # statement lists, not expressions).
        for body_key in ('body', 'then', 'else', 'free_body', 'arms', 'statements'):
            child = node.get(body_key)
            if isinstance(child, list):
                for sub in child:
                    self._walk_validate(sub, in_safe_pos=False)

        # Conditions and iterables are expressions, but slot-adoption-
        # safe is False (they're consumed, but a bare literal as the
        # iterable of `for/while/select` is meaningless anyway — let
        # it fall through to the heap-check on this node which has
        # already passed since the outer node isn't a heap literal).
        for expr_key in ('cond', 'condition', 'iterable', 'expr', 'expression', 'capture'):
            child = node.get(expr_key)
            if isinstance(child, dict):
                self._walk_validate(child, in_safe_pos=False)

        # Labels inside objects/sectors have their own substructure —
        # 'labels' is a dict of name -> body. Recurse.
        labels = node.get('labels')
        if isinstance(labels, dict):
            for lbl_body in labels.values():
                if isinstance(lbl_body, list):
                    for sub in lbl_body:
                        self._walk_validate(sub, in_safe_pos=False)

        # Object/sector instructions dict (alt schema): same shape.
        instructions = node.get('instructions')
        if isinstance(instructions, dict):
            for instr_body in instructions.values():
                if isinstance(instr_body, list):
                    for sub in instr_body:
                        self._walk_validate(sub, in_safe_pos=False)

    def _reject_bare_literal(self, node: dict) -> None:
        ntype = node.get('type', '?')
        line = node.get('line', 0)
        type_hint = {
            'string': 'String',
            'array': 'Array',
            'array_literal': 'Array',
            'map_literal': 'Map',
            'bind_literal': 'Bind',
        }.get(ntype, 'Heap-Wert')
        raise CsscError(
            operation='Parse',
            detail=(f"E020: Bare-{type_hint}-Literal in Argument-/Operand-"
                    f"Position hat keinen besitzenden Slot. CSSC v5 fordert, "
                    f"dass jeder Heap-Wert in einem deklarierten Slot lebt."),
            hint=("Deklariere einen Slot zuerst: "
                  "'#stack[<type>, <bits>] name = <literal>;' und übergib "
                  "'name'. Siehe Doku §2.5."),
            line=line,
        )

    # -- Statements ---------------------------------------------------------

    def _parse_statement(self) -> Optional[dict]:
        tok = self._peek()
        if tok.type == TK_DIRECTIVE:
            return self._parse_directive()
        if tok.type == TK_INCLUDE:
            return self._parse_include_directive()
        if tok.type == TK_SECTOR:
            return self._parse_sector()
        if tok.type == TK_OBJECT:
            return self._parse_object()
        if tok.type == TK_METHOD:
            return self._parse_method()
        # Method application: methodName ! #directive[...] var = val;
        # Also handles ns::methodName ! ... (namespace-qualified method)
        def _is_method_apply():
            """Check if current position is a method apply: [ns::]name ! (directive|sector|object)"""
            p = self._pos
            # Skip optional namespace prefix: IDENT ::
            if (p + 2 < len(self._tokens) and
                    self._tokens[p].type == TK_IDENT and
                    self._tokens[p + 1].type == TK_DCOLON and
                    self._tokens[p + 2].type == TK_IDENT):
                p += 2  # now at method name after ::
            if p >= len(self._tokens) or self._tokens[p].type != TK_IDENT:
                return False
            if p + 1 >= len(self._tokens) or self._tokens[p + 1].type != TK_NOT:
                return False
            if p + 2 >= len(self._tokens):
                return False
            return self._tokens[p + 2].type in (TK_DIRECTIVE, TK_SECTOR, TK_OBJECT)

        if tok.type == TK_IDENT and _is_method_apply():
            # Consume optional namespace prefix
            method_name = ''
            if (self._pos + 2 < len(self._tokens) and
                    self._tokens[self._pos + 1].type == TK_DCOLON and
                    self._tokens[self._pos + 2].type == TK_IDENT):
                ns_tok = self._advance()   # consume namespace
                self._advance()            # consume ::
                name_tok = self._advance()  # consume method name
                method_name = ns_tok.value + '::' + name_tok.value
            else:
                name_tok = self._advance()
                method_name = name_tok.value
            self._advance()  # consume !
            # Parse the declaration
            if self._peek().type == TK_DIRECTIVE:
                decl = self._parse_directive()
            elif self._peek().type == TK_SECTOR:
                decl = self._parse_sector()
            else:
                decl = self._parse_object()
            return {
                'type': 'method_apply',
                'method_name': method_name,
                'declaration': decl,
                'line': name_tok.line,
            }
        if tok.type == TK_CALL:
            # goto labelname;                    — call label, no args
            # goto labelname(args) capture;      — call with () args
            # goto labelname<args> capture;      — call with <> args (consistent with label<params>:)
            self._advance()  # consume 'goto'
            label_tok = self._expect(TK_IDENT)
            args = []
            if self._peek().type == TK_LPAREN:
                args = self._parse_args()
            elif self._peek().type == TK_LT:
                # <args> syntax — parse simple values between < >
                # Can't use _parse_expression because > would be consumed as comparison
                self._advance()  # consume <
                while not self._at_end() and self._peek().type != TK_GT:
                    # Allow *name as explicit transfer override (zero-copy ref)
                    if self._peek().type == TK_STAR:
                        self._advance()  # consume *
                        ref_tok = self._expect(TK_IDENT)
                        args.append({
                            'type': 'transfer_ref',
                            'name': ref_tok.value,
                            'line': ref_tok.line,
                        })
                    else:
                        # Parse additive expressions only (no comparisons that use >)
                        args.append(self._parse_additive())
                    if not self._at_end() and self._peek().type == TK_COMMA:
                        self._advance()
                self._expect(TK_GT)
            # Optional: capture variable for mirror result
            capture_var = None
            if self._peek().type == TK_IDENT:
                capture_var = self._advance().value
            self._match(TK_SEMICOLON)
            return {
                'type': 'call_label',
                'label': label_tok.value,
                'args': args,
                'capture': capture_var,
                'line': tok.line,
            }
        if tok.type == TK_DESTRUCT:
            self._advance()  # consume 'destruct'
            self._match(TK_SEMICOLON)
            return {'type': 'destruct', 'line': tok.line}
        if tok.type == TK_MIRROR:
            # Per CSSC v6 ownership refactor (spec §2.5 + §7.5):
            #   `mirror value;`  → REFERENCE (default). If `value` is
            #                       a bare slot identifier, the
            #                       capture stays LIVE-linked to the
            #                       slot. If the body later deletes
            #                       the slot, the outer capture
            #                       becomes `0x0`. Expressions like
            #                       `mirror n+t;` fall back to
            #                       snapshot (no slot to ref).
            #   `mirror &value;` → explicit DEEP-COPY. Snapshot at
            #                       the mirror point; outer unaffected
            #                       by later body deletes.
            #   `mirror *value;` → DEPRECATED alias for default ref.
            #                       Silently accepted for v5 compat;
            #                       behaves identically to `mirror
            #                       value;`.
            self._advance()  # consume 'mirror'
            is_copy = False
            if self._peek().type == TK_STAR:
                self._advance()  # consume * (deprecated; ref is now default)
            elif self._peek().type == TK_AMP:
                self._advance()  # consume & (explicit deep-copy)
                is_copy = True
            expr = self._parse_expression()
            self._match(TK_SEMICOLON)
            # `is_ref` retained for downstream consumers that look at
            # the old field name; `is_copy` is the new authoritative
            # source-of-truth.
            return {'type': 'mirror', 'value': expr,
                    'is_copy': is_copy,
                    'is_ref': not is_copy,
                    'line': tok.line}
        if tok.type == TK_IF:
            return self._parse_if()
        if tok.type == TK_FOR:
            return self._parse_for()
        if tok.type == TK_WHILE:
            return self._parse_while()
        if tok.type == TK_BREAK:
            self._advance()
            self._match(TK_SEMICOLON)
            return {'type': 'break', 'line': tok.line}
        if tok.type == TK_CONTINUE:
            self._advance()
            self._match(TK_SEMICOLON)
            return {'type': 'continue', 'line': tok.line}
        if tok.type == TK_JUMP:
            self._advance()
            # Inside select { ... }: jump; jump++; — cursor advance
            if getattr(self, '_in_select', 0) > 0:
                delta = 1
                if self._peek().type == TK_PLUS_PLUS:
                    self._advance()
                    delta = 2
                self._match(TK_SEMICOLON)
                return {'type': 'select_jump', 'delta': delta, 'line': tok.line}
            target = None
            if self._peek().type == TK_LBRACKET:
                self._advance()  # consume [
                target = self._parse_expression()
                self._expect(TK_RBRACKET)
            self._match(TK_SEMICOLON)
            return {'type': 'jump', 'target': target, 'line': tok.line}
        # !jump; or !jump++; (cursor back) — only inside select
        if (tok.type == TK_NOT and getattr(self, '_in_select', 0) > 0
                and self._pos + 1 < len(self._tokens)
                and self._tokens[self._pos + 1].type == TK_JUMP):
            self._advance()  # consume !
            self._advance()  # consume jump
            delta = -1
            if self._peek().type == TK_PLUS_PLUS:
                self._advance()
                delta = -2
            self._match(TK_SEMICOLON)
            return {'type': 'select_jump', 'delta': delta, 'line': tok.line}
        if tok.type == TK_SELECT:
            return self._parse_select()
        if tok.type == TK_RETURN:
            self._advance()
            val = None
            copy_return = False
            if self._peek().type == TK_AMP:
                self._advance()  # consume &
                copy_return = True
            if not self._peek().type in (TK_SEMICOLON, TK_RBRACE, TK_EOF):
                val = self._parse_expression()
            if copy_return and val is not None:
                val = {'type': 'copy_of', 'operand': val, 'line': tok.line}
            self._match(TK_SEMICOLON)
            return {'type': 'return', 'value': val, 'line': tok.line}
        if tok.type == TK_SEMICOLON:
            self._advance()
            return None
        if tok.type == TK_LBRACE:
            # Bare `{ ... }` at statement level is a private scope — isolated
            # variable frame, no outer lookups by default (use #req to import).
            blk = self._parse_block()
            return {
                'type': 'private_scope',
                'body': blk.get('body', []),
                'line': blk.get('line', tok.line),
            }
        # Hex-addressed persistent scope: `0xAEFF { … }`
        if (tok.type == TK_NUMBER and getattr(tok, 'is_hex', False)
                and self._pos + 1 < len(self._tokens)
                and self._tokens[self._pos + 1].type == TK_LBRACE):
            hex_tok = self._advance()
            blk = self._parse_block()
            return {
                'type': 'hex_scope',
                'hex_id': int(hex_tok.value),
                'body': blk.get('body', []),
                'line': hex_tok.line,
            }
        return self._parse_expr_statement()

    def _parse_block(self) -> dict:
        tok = self._expect(TK_LBRACE)
        stmts = []
        while self._peek().type != TK_RBRACE and not self._at_end():
            s = self._parse_statement()
            if s:
                stmts.append(s)
        self._expect(TK_RBRACE)
        return {'type': 'block', 'body': stmts, 'line': tok.line}

    def _parse_block_or_stmt(self) -> list:
        if self._peek().type == TK_LBRACE:
            blk = self._parse_block()
            return blk.get('body', [])
        s = self._parse_statement()
        return [s] if s else []

    def _parse_directive(self) -> dict:
        tok = self._advance()
        info = tok.value
        dname = info['name']

        # #debug(message); — debug-only print; silent unless --debug is on.
        # Provided by `#include('devdebug')`.
        if dname == 'debug':
            arg_expr = info.get('arg', '')
            value_node = None
            if arg_expr:
                # Re-parse the parenthesised arg as a CSSC expression so the
                # message can be a string concat, variable, etc.
                try:
                    sub_lex = CsscLexer(arg_expr)
                    sub_toks = sub_lex.tokenize()
                    sub_parser = CsscParser(sub_toks)
                    value_node = sub_parser._parse_expression()
                except Exception:
                    value_node = {'type': 'string', 'value': arg_expr, 'line': tok.line}
            self._match(TK_SEMICOLON)
            return {
                'type': 'directive',
                'directive': 'debug',
                'arg': arg_expr,
                'var': info.get('var', ''),
                'value': value_node,
                'line': tok.line,
            }

        # #trace(funcName); — wrap the named function so each call logs args
        # and return value (only when --debug is on).
        if dname == 'trace':
            target = info.get('arg', '').strip() or info.get('var', '')
            self._match(TK_SEMICOLON)
            return {
                'type': 'directive',
                'directive': 'trace',
                'arg': target,
                'var': target,
                'value': None,
                'line': tok.line,
            }

        # #catch (executable) ?caller { body } — graceful runtime-error catch.
        # Provided by `#include('stdgrace')`.
        if dname == 'catch':
            # The arg already came in via the (...) directive header.
            executable_str = info.get('arg', '').strip()
            # Re-parse the parenthesised arg as a CSSC expression so the
            # caller can pass arbitrary callables — `myfn`, `i()`, or chain
            # expressions like `obj.method(arg)`. Falls back to a bare
            # identifier node if parsing fails (legacy single-name catch).
            value_node = None
            if executable_str:
                try:
                    sub_lex = CsscLexer(executable_str)
                    sub_toks = sub_lex.tokenize()
                    sub_parser = CsscParser(sub_toks)
                    value_node = sub_parser._parse_expression()
                except Exception:
                    value_node = {'type': 'identifier', 'name': executable_str, 'line': tok.line}
            # Optional `?caller` binding.
            caller_name = None
            if not self._at_end() and self._peek().type == TK_QUESTION:
                self._advance()  # consume ?
                if not self._at_end() and self._peek().type == TK_IDENT:
                    caller_name = self._advance().value
            body = self._parse_block_or_stmt()
            return {
                'type': 'directive',
                'directive': 'catch',
                'arg': executable_str,
                'value': value_node,
                'var': caller_name or '',
                'caller': caller_name,
                'body': body,
                'line': tok.line,
            }

        # #DEFINE name [ <expr> ] ;
        # Three forms in one directive:
        #
        #   1. `#DEFINE name;` — transpiler hint: declare `name` as a foreign
        #      API namespace whose `name::X` accesses are passed through
        #      verbatim by transpilers (CSSC → Luau, …). No-op for the
        #      interpreter and native compiler.
        #
        #   2. `#DEFINE __main__ '__main__';` — entry-point opt-in: tells the
        #      compiler that the variable named `__main__` (typically an
        #      `object __main__ { ... }` definition somewhere in the source)
        #      should be auto-invoked at program start.
        #
        #   3. `#DEFINE name <expr>;` — compile-time constant. The expression
        #      is evaluated AT COMPILE TIME and its value is bound to `name`
        #      as a constant; every later reference to `name` substitutes
        #      the baked value. Example:
        #          #DEFINE build_ts cssc::time();
        #          cssc::outln(build_ts);
        #      The `cssc::time()` call runs in the compiler, the produced
        #      i64 timestamp ends up as an immediate in the IR — zero
        #      runtime cost. `#delete[name]` removes the binding.
        #
        # Distinct from `#define(...)` (lowercase) which defines a callback.
        if dname == 'DEFINE':
            ns_name = info.get('var') or info.get('arg', '').strip()
            value_str = None      # backwards-compat: literal-string form
            value_expr = None     # new: compile-time expression AST
            if not self._at_end() and self._peek().type == TK_STRING \
                    and self._peek(1).type == TK_SEMICOLON:
                # Form 2: `#DEFINE name 'literal';` — keep the legacy slot.
                value_str = self._advance().value
            elif not self._at_end() and self._peek().type != TK_SEMICOLON:
                # Form 3: any other expression goes through the normal
                # parser. Captured as AST so the lowering pass can
                # statically evaluate it.
                value_expr = self._parse_expression()
            self._match(TK_SEMICOLON)
            return {
                'type': 'directive',
                'directive': 'DEFINE',
                'arg': ns_name,
                'var': ns_name,
                'value': value_str,
                'value_expr': value_expr,
                'line': tok.line,
            }

        # #define(varName) { ... } — callback definition (no params)
        if dname == 'define':
            old_in_define = self._in_define_body
            self._in_define_body = True
            body = self._parse_block_or_stmt()
            self._in_define_body = old_in_define
            return {
                'type': 'define',
                'target': info['arg'],  # the variable name to bind the callback to
                'body': body,
                'line': tok.line,
            }

        # #interrupt(name) { ... } — CCOS hardware ISR handler. Native (ccos)
        # only: lowered with the LLVM `x86_intrcc` calling convention (iretq).
        # The interpreter registers it like a #define but never auto-invokes
        # it (an ISR has no host-runtime meaning).
        if dname == 'interrupt':
            old_in_define = self._in_define_body
            self._in_define_body = True
            body = self._parse_block_or_stmt()
            self._in_define_body = old_in_define
            return {
                'type': 'interrupt',
                'target': info['arg'],
                'body': body,
                'line': tok.line,
            }

        # #cdefine(func, p1, p2) { ... } — callback with parameters
        if dname == 'cdefine':
            parts = [p.strip() for p in info['arg'].split(',')]
            target = parts[0] if parts else ''
            params = parts[1:] if len(parts) > 1 else []
            old_in_define = self._in_define_body
            self._in_define_body = True
            body = self._parse_block_or_stmt()
            self._in_define_body = old_in_define
            return {
                'type': 'cdefine',
                'target': target,
                'params': params,
                'body': body,
                'line': tok.line,
            }

        # #qvar(type, expr) varname; — quick variable from expression
        if dname == 'qvar':
            # arg = "type, expr"
            comma_idx = info['arg'].find(',')
            if comma_idx >= 0:
                vtype = info['arg'][:comma_idx].strip()
                expr_str = info['arg'][comma_idx + 1:].strip()
            else:
                vtype = info['arg'].strip()
                expr_str = ''
            varname = info['var']
            self._match(TK_SEMICOLON)
            return {
                'type': 'qvar',
                'vtype': vtype,
                'expr_str': expr_str,
                'var': varname,
                'line': tok.line,
            }

        # #scanp(source, type, pos) varname;          — CORE: bind a slot
        #     to the caller's positional argument. v5+ ref-by-default.
        # #scanp(source, type, pos) &varname;         — explicit deep-copy
        #     (snapshot at scan time; mutations don't propagate).
        # #scanp(source, type, pos) *varname;         — explicit ref marker
        #     (deprecated; same as no-prefix since v5 ref-default).
        # #scanp_opt(source, type, pos) varname;      — `def`-module shim:
        #     missing args yield null instead of erroring.
        if dname in ('scanp', 'scanp_opt'):
            # Generic-aware split: don't split on commas inside < >
            raw = info['arg']
            parts = []
            depth = 0
            cur = []
            for ch in raw:
                if ch == '<':
                    depth += 1
                elif ch == '>':
                    depth -= 1
                if ch == ',' and depth == 0:
                    parts.append(''.join(cur).strip())
                    cur = []
                else:
                    cur.append(ch)
            parts.append(''.join(cur).strip())
            source = parts[0] if len(parts) > 0 else ''
            vtype = parts[1] if len(parts) > 1 else 'auto'
            pos = parts[2] if len(parts) > 2 else '0'
            # Support default value: #scanp(func, type, index) var = defaultExpr;
            default_expr = None
            if self._match(TK_ASSIGN):
                default_expr = self._parse_expression()
            self._match(TK_SEMICOLON)
            # `&varname` → explicit copy (snapshot of caller's value);
            # `*varname` or no prefix → live reference (v5 default).
            var_prefix = info.get('var_prefix', '')
            is_copy = (var_prefix == '&')
            return {
                'type': 'scanp',
                'source': source,
                'vtype': vtype,
                'pos': pos,
                'var': info['var'],
                'var_prefix': var_prefix,
                'is_copy': is_copy,
                'default': default_expr,
                'optional': dname == 'scanp_opt',
                'line': tok.line,
            }

        # #req[globalVar] localVar; — require global scope variable into local scope (copy)
        # #req[globalVar] *localVar; — require as reference (changes propagate back)
        if dname == 'req':
            # CSSC v5 — #req is ref-by-default. The legacy `*localvar`
            # prefix stays parsable as a no-op (it already meant ref).
            # The new `&localvar` prefix flags an explicit deep-copy
            # snapshot taken at #req-evaluation time, so the body sees
            # an independent value that won't track the outer slot.
            global_var = info['arg'].strip()
            local_var = info.get('var', '')
            # Lexer captures the `&`/`*` prefix when it appears glued to
            # the directive's var slot (e.g. `#req[g] &x;`). Honour it
            # before falling back to a token-stream peek for the rare
            # case where the var arrived as a separate token sequence.
            var_prefix = info.get('var_prefix', '')
            is_ref = True   # v5 default
            if var_prefix == '&':
                is_ref = False
            # var_prefix == '*' → ref (default); no flag change.
            if not local_var:
                if self._peek().type == TK_STAR:
                    self._advance()      # legacy `*` — still ref
                elif self._peek().type == TK_AMP:
                    self._advance()      # `&` — explicit copy
                    is_ref = False
                if self._peek().type == TK_IDENT:
                    local_var = self._advance().value
            self._match(TK_SEMICOLON)
            return {
                'type': 'directive',
                'directive': 'req',
                'global_var': global_var,
                'var': local_var,
                'is_ref': is_ref,
                'line': tok.line,
            }

        # #fvar(type) varname; — function variable declaration
        # Declaration allowed anywhere, but no assignment at declaration (#fvar(int) x = 1; is invalid).
        # Can only be populated via #define/#cdefine, or called like varname().
        if dname == 'fvar':
            # Check for illegal assignment at declaration
            if self._peek().type == TK_ASSIGN:
                raise CsscError(operation='Parser',
                                detail=f'#fvar cannot be declared with a default value',
                                hint='Use #define({name}) {{ ... }} to assign a callback to this function variable'.format(name=info['var']),
                                line=tok.line)
            self._match(TK_SEMICOLON)
            return {
                'type': 'directive',
                'directive': 'fvar',
                'arg': info['arg'],
                'var': info['var'],
                'value': None,
                'line': tok.line,
            }

        # #param(type) varname; — parameter declaration
        # Declaration allowed anywhere, but no assignment at declaration.
        # Can only be used/populated inside #define/#cdefine bodies.
        if dname == 'param':
            if self._peek().type == TK_ASSIGN:
                raise CsscError(operation='Parser',
                                detail=f'#param cannot be declared with a default value',
                                hint='Use #param inside a #define or #cdefine body',
                                line=tok.line)
            self._match(TK_SEMICOLON)
            return {
                'type': 'directive',
                'directive': 'param',
                'arg': info['arg'],
                'var': info['var'],
                'value': None,
                'line': tok.line,
            }

        # `#memory` was a short-lived alias for `#adress`. It's been
        # removed — `#adress` is the canonical spelling (yes, with the
        # missing 'd'; it's the established API). Reject the alias with
        # a clear redirect rather than silently aliasing, so legacy
        # `#memory[var]` code surfaces an explicit migration message
        # instead of subtly different behaviour.
        if dname == 'memory':
            raise CsscError(
                operation='Parser',
                detail="`#memory` is not a CSSC directive — use `#adress` "
                       "for variable-address introspection.",
                hint=(
                    "Three legal forms:\n"
                    "  `#adress[var] addr;`     — get the slot address\n"
                    "  `#adress[var] = 0xABC;`  — rebind var to an "
                    "existing address (aliasing)\n"
                    "  `if (#adress[var] != 0x0) { … }`  — guard the "
                    "delete of a possibly-released name."),
                line=tok.line,
            )

        # #reflect[address] var; — resolve address back to variable
        if dname == 'reflect':
            self._match(TK_SEMICOLON)
            return {
                'type': 'directive',
                'directive': 'reflect',
                'arg': info['arg'],
                'var': info['var'],
                'value': None,
                'line': tok.line,
            }

        # #load["path/to/file.cssc"] var; — load external CSSC file as a module
        if dname == 'load':
            path = info['arg'].strip().strip('"').strip("'")
            self._match(TK_SEMICOLON)
            return {
                'type': 'directive',
                'directive': 'load',
                'load_path': path,
                'var': info['var'],
                'value': None,
                'line': tok.line,
            }

        # #depend["path/to/project.obj"] alias; — depend on an isolated .obj package
        if dname == 'depend':
            path = info['arg'].strip().strip('"').strip("'")
            self._match(TK_SEMICOLON)
            return {
                'type': 'directive',
                'directive': 'depend',
                'depend_path': path,
                'var': info['var'],
                'value': None,
                'line': tok.line,
            }

        # #await[handle] var; — wait for a thread to finish, store result in var
        if dname == 'await':
            self._match(TK_SEMICOLON)
            return {
                'type': 'directive',
                'directive': 'await',
                'arg': info['arg'].strip(),
                'var': info['var'],
                'value': None,
                'line': tok.line,
            }

        # #unload[var]; — unload a previously loaded CSSC module
        if dname == 'unload':
            self._match(TK_SEMICOLON)
            return {
                'type': 'directive',
                'directive': 'unload',
                'arg': info['arg'].strip(),
                'var': '',
                'value': None,
                'line': tok.line,
            }

        # Type-specific directives: #string[bits], #int[bits], #array[type, size], #vector[type, bits], #map[keytype, valtype, bits]
        # These require their respective #include module
        if dname in ('string', 'int', 'array', 'vector', 'map'):
            # Generic-aware arg split
            raw = info['arg']
            parts, depth, cur = [], 0, []
            for ch in raw:
                if ch == '<': depth += 1
                elif ch == '>' and depth > 0: depth -= 1
                if ch == ',' and depth == 0:
                    parts.append(''.join(cur).strip())
                    cur = []
                else:
                    cur.append(ch)
            if cur:
                parts.append(''.join(cur).strip())
            node = {
                'type': 'directive',
                'directive': dname,
                'type_arg': parts[0] if len(parts) > 0 else 'auto',
                'bits_arg': parts[1] if len(parts) > 1 else '0',
                'extra_arg': parts[2] if len(parts) > 2 else None,
                'var': info['var'],
                'value': None,
                'line': tok.line,
            }
            if self._match(TK_ASSIGN):
                node['value'] = self._parse_expression()
            self._match(TK_SEMICOLON)
            return node

        # #thread[type, bits] var; — declare a thread-callable variable (requires #include("asyncthreads"))
        if dname == 'thread':
            parts = [p.strip() for p in info['arg'].split(',')]
            node = {
                'type': 'directive',
                'directive': 'thread',
                'thread_type': parts[0] if len(parts) > 0 else 'int',
                'thread_bits': parts[1] if len(parts) > 1 else '32',
                'var': info['var'],
                'value': None,
                'line': tok.line,
            }
            if self._match(TK_ASSIGN):
                node['value'] = self._parse_expression()
            self._match(TK_SEMICOLON)
            return node

        # #daemon[var]; — start a #define function as daemon thread (requires #include("asyncthreads"))
        if dname == 'daemon':
            self._match(TK_SEMICOLON)
            return {
                'type': 'directive',
                'directive': 'daemon',
                'arg': info['arg'].strip(),
                'var': '',
                'value': None,
                'line': tok.line,
            }

        # #killdaemon[var]; — stop a running daemon thread
        if dname == 'killdaemon':
            self._match(TK_SEMICOLON)
            return {
                'type': 'directive',
                'directive': 'killdaemon',
                'arg': info['arg'].strip(),
                'var': '',
                'value': None,
                'line': tok.line,
            }

        # #tlisten[var] { body } — watch variable for changes, run body
        if dname == 'tlisten':
            body = self._parse_block_or_stmt()
            return {
                'type': 'tlisten',
                'target': info['arg'].strip(),
                'body': body,
                'line': tok.line,
            }

        # #video[width, height, fps] var; — create video context (requires #include("video"))
        if dname == 'video':
            parts = [p.strip() for p in info['arg'].split(',')]
            self._match(TK_SEMICOLON)
            return {
                'type': 'directive',
                'directive': 'video',
                'video_width': parts[0] if len(parts) > 0 else '320',
                'video_height': parts[1] if len(parts) > 1 else '240',
                'video_fps': parts[2] if len(parts) > 2 else '60',
                'var': info['var'],
                'value': None,
                'line': tok.line,
            }

        # #console[width, height] var; — native Win32 console (requires #include("sys.console"))
        if dname == 'console':
            parts = [p.strip() for p in info['arg'].split(',')]
            self._match(TK_SEMICOLON)
            return {
                'type': 'directive',
                'directive': 'console',
                'console_width': parts[0] if len(parts) > 0 else '80',
                'console_height': parts[1] if len(parts) > 1 else '25',
                'var': info['var'],
                'value': None,
                'line': tok.line,
            }

        # #framebuffer[width, height] var; — create pixel buffer (requires #include("video"))
        if dname == 'framebuffer':
            parts = [p.strip() for p in info['arg'].split(',')]
            self._match(TK_SEMICOLON)
            return {
                'type': 'directive',
                'directive': 'framebuffer',
                'fb_width': parts[0] if len(parts) > 0 else '320',
                'fb_height': parts[1] if len(parts) > 1 else '240',
                'var': info['var'],
                'value': None,
                'line': tok.line,
            }

        # #matrix[width, height] var; — create 2D pixel matrix (requires #include("matrix"))
        if dname == 'matrix':
            parts = [p.strip() for p in info['arg'].split(',')]
            node = {
                'type': 'directive',
                'directive': 'matrix',
                'matrix_width': parts[0] if len(parts) > 0 else '0',
                'matrix_height': parts[1] if len(parts) > 1 else '0',
                'var': info['var'],
                'value': None,
                'line': tok.line,
            }
            if self._match(TK_ASSIGN):
                node['value'] = self._parse_expression()
            self._match(TK_SEMICOLON)
            return node

        # ─── gipeo embedded peripherals ─────────────────────────────────
        # #pin[N]   var;   — single GPIO line  (requires #include('gipeo'))
        # #i2c[bus, sda, scl]            var;
        # #spi[bus, sck, miso, mosi]     var;
        # #uart[bus, tx, rx]             var;
        # #adc[pin]                      var;
        # #pwm[pin, freq, resolution]    var;
        # #timer[slot, hz]               var;
        if dname in ('pin', 'i2c', 'spi', 'uart', 'adc', 'pwm', 'timer'):
            parts = [p.strip() for p in info['arg'].split(',')]
            self._match(TK_SEMICOLON)
            return {
                'type': 'directive',
                'directive': dname,
                'arg_parts': parts,
                'arg': info['arg'],
                'var': info['var'],
                'value': None,
                'line': tok.line,
            }

        # #tft[ctrl, w, h] var; — display panel (requires #include('tft'))
        # #oled[w, h] var;       — sugar alias for #tft[tft::SSD1306, w, h];
        #                          accepts optional explicit ctrl as first arg.
        if dname == 'tft' or dname == 'oled':
            parts = [p.strip() for p in info['arg'].split(',')]
            self._match(TK_SEMICOLON)
            # For #oled, prepend the SSD1306 default unless the user
            # already specified a controller as the first bracket arg.
            # We detect "first arg looks like a controller name" by
            # checking against the known set; otherwise treat the
            # bracket as `[w, h]` and inject ssd1306.
            if dname == 'oled':
                _known_ctrls = {
                    'ssd1306', 'sh1106', 'ili9341', 'st7735', 'st7789', 'epaper',
                    'tft::SSD1306', 'tft::SH1106', 'tft::ILI9341',
                    'tft::ST7735', 'tft::ST7789', 'tft::EPAPER',
                }
                first = parts[0].strip().strip('"\'') if parts else ''
                if first.lower() not in {c.lower() for c in _known_ctrls}:
                    # User wrote `#oled[128, 64] var;` — inject default.
                    parts = ['ssd1306'] + parts
            return {
                'type': 'directive',
                'directive': 'tft',   # both directives lower to the same op
                'arg_parts': parts,
                'arg': info['arg'],
                'var': info['var'],
                'value': None,
                'line': tok.line,
            }

        # ─── network.http directives ────────────────────────────────────
        # #get[url]  var;          — perform GET, capture result map into var
        # #post[url] var = body;   — POST with optional body init
        # #send[url] body;         — fire-and-forget POST (body required)
        # All three accept either a quoted URL inside the brackets OR an
        # identifier that resolves to a string at runtime.
        if dname in ('get', 'post', 'send'):
            url_arg = info['arg'].strip()
            varname = info.get('var', '')
            value_node = None
            # `=` after the var name → body expression (POST) or
            # destination expression (GET — uncommon but allowed).
            if not self._at_end() and self._peek().type == TK_ASSIGN:
                self._advance()
                value_node = self._parse_expression()
            self._match(TK_SEMICOLON)
            return {
                'type': 'directive',
                'directive': dname,
                'arg': url_arg,
                'var': varname,
                'value': value_node,
                'line': tok.line,
            }

        # #size(var) — returns byte size (used as expression via result capture)
        if dname == 'size':
            self._match(TK_SEMICOLON)
            return {
                'type': 'directive',
                'directive': 'size',
                'arg': info['arg'],
                'var': info['var'],
                'value': None,
                'line': tok.line,
            }

        # #iterator[type, source] name; — create C++ STL iterator into a container
        if dname == 'iterator':
            # arg = "vector<auto>, source" — generic-aware split
            raw = info['arg']
            parts = []
            depth = 0
            cur = []
            for ch in raw:
                if ch == '<': depth += 1
                elif ch == '>': depth -= 1
                if ch == ',' and depth == 0:
                    parts.append(''.join(cur).strip())
                    cur = []
                else:
                    cur.append(ch)
            parts.append(''.join(cur).strip())
            iter_type = parts[0] if len(parts) > 0 else 'auto'
            source_var = parts[1] if len(parts) > 1 else ''
            self._match(TK_SEMICOLON)
            return {
                'type': 'directive',
                'directive': 'iterator',
                'iter_type': iter_type,
                'source': source_var,
                'var': info['var'],
                'line': tok.line,
            }

        # #capacity[var] cap; — get allocated buffer size in bits
        if dname == 'capacity':
            self._match(TK_SEMICOLON)
            return {
                'type': 'directive',
                'directive': 'capacity',
                'arg': info['arg'],
                'var': info['var'],
                'value': None,
                'line': tok.line,
            }

        # #raii 0xAEFF method(args);  — call a method on a hex-addressed scope
        if dname == 'raii':
            target = info.get('var', '')
            target_hex = None
            if target.lower().startswith('0x'):
                try:
                    target_hex = int(target, 16)
                except ValueError:
                    target_hex = None
            method_tok = self._expect(TK_IDENT)
            method_name = method_tok.value if isinstance(method_tok.value, str) else str(method_tok.value)
            args = []
            if self._match(TK_LPAREN):
                if self._peek().type != TK_RPAREN:
                    args.append(self._parse_expression())
                    while self._match(TK_COMMA):
                        args.append(self._parse_expression())
                self._expect(TK_RPAREN)
            self._match(TK_SEMICOLON)
            return {
                'type': 'directive',
                'directive': 'raii',
                'target_hex': target_hex,
                'target_name': target if target_hex is None else None,
                'method': method_name,
                'args': args,
                'line': tok.line,
            }

        # #delete[var] — remove variable from memory, mandatory for #stack/#auto vars
        # Also supports #delete[0xADDR] — delete by raw memory address
        if dname == 'delete':
            self._match(TK_SEMICOLON)
            return {
                'type': 'directive',
                'directive': 'delete',
                'arg': info['arg'],
                'var': info['var'],
                'value': None,
                'line': tok.line,
            }

        # #delmember[target] — null out heap contents of `target` while
        # keeping its handle/size intact. Two argument shapes:
        #
        #   #delmember[arr]          → walk every entry, release strings
        #                              + null sub-handles; size/cap stay.
        #   #delmember[arr[i]]       → null one entry only (entry at i).
        #   #delmember[Obj->member]  → release the heap content of an
        #                              object member, leaving the slot
        #                              alive.
        #
        # Re-tokenises the bracket arg as a CSSC expression so `name`,
        # `Obj->name`, and `name[index]` all parse uniformly. The AST
        # carries `target` (identifier or arrow-access) and an optional
        # `index` expression.
        if dname == 'delmember':
            arg_text = info.get('arg', '') or info.get('var', '')
            arg_text = arg_text.strip()
            target_node = None
            index_node = None
            try:
                sub_lex = CsscLexer(arg_text)
                sub_toks = sub_lex.tokenize()
                sub_parser = CsscParser(sub_toks)
                expr = sub_parser._parse_expression()
            except Exception:
                expr = None
            if expr is None:
                raise CsscError(
                    operation='Parse',
                    detail=f'#delmember[{arg_text!r}]: argument must be '
                           f'an identifier, Obj->member, or name[index]',
                    line=tok.line)
            et = expr.get('type')
            if et in ('index_access', 'index'):
                target_node = expr.get('object')
                index_node = expr.get('index')
            elif et in ('identifier', 'arrow_access', 'dot_access'):
                target_node = expr
            else:
                raise CsscError(
                    operation='Parse',
                    detail=f'#delmember[{arg_text!r}]: argument must be '
                           f'an identifier, Obj->member, or name[index] '
                           f'(got {et!r})',
                    line=tok.line)
            self._match(TK_SEMICOLON)
            return {
                'type': 'directive',
                'directive': 'delmember',
                'arg': arg_text,
                'var': info.get('var', ''),
                'target': target_node,
                'index': index_node,
                'value': None,
                'line': tok.line,
            }

        # #set[0xADDR, bits] = value; — write value at raw memory address
        if dname == 'set':
            node = {
                'type': 'directive',
                'directive': 'set',
                'arg': info['arg'],
                'var': info.get('var', ''),
                'value': None,
                'line': tok.line,
            }
            if self._match(TK_ASSIGN):
                node['value'] = self._parse_expression()
            self._match(TK_SEMICOLON)
            return node

        # #exists[0xADDR] result_var; — check if address is allocated (1/0)
        if dname == 'exists':
            self._match(TK_SEMICOLON)
            return {
                'type': 'directive',
                'directive': 'exists',
                'arg': info['arg'],
                'var': info['var'],
                'value': None,
                'line': tok.line,
            }

        # `#adress[var]` — the canonical address-introspection directive.
        # Three legal forms (statement #1 / #2 here; the expression form
        # is dispatched from the expression parser):
        #   1. `#adress[var] addr;`        — STATEMENT: assign the slot
        #                                     address of `var` into
        #                                     the trailing name `addr`.
        #                                     `addr` should be a declared
        #                                     int slot; if `var` is
        #                                     unbound, `addr` is set
        #                                     to `0x0`.
        #   2. `#adress[var] = 0xABC;`     — STATEMENT: rebind `var` to
        #                                     point at the existing
        #                                     address 0xABC (aliasing).
        #                                     Interpreter only.
        #   3. `if (#adress[var] != 0x0)`  — EXPRESSION: slot address as
        #                                     an int. Escape hatch for
        #                                     the otherwise-fatal
        #                                     `#delete[<missing>]`.
        if dname == 'adress':
            node = {
                'type': 'directive',
                'directive': 'adress',
                'arg': info['arg'],
                'var': info.get('var', ''),
                'value': None,
                'line': tok.line,
            }
            if self._match(TK_ASSIGN):
                node['value'] = self._parse_expression()
            self._match(TK_SEMICOLON)
            return node

        # #stack[type, bits] var = val; — stack allocation with bit limit
        if dname == 'stack':
            node = {
                'type': 'directive',
                'directive': 'stack',
                'arg': info['arg'],
                'var': info['var'],
                'value': None,
                'line': tok.line,
            }
            if self._match(TK_ASSIGN):
                node['value'] = self._parse_expression()
            self._match(TK_SEMICOLON)
            return node

        # #heap[type, bits] var = val; — heap allocation, auto-destructed
        if dname == 'heap':
            node = {
                'type': 'directive',
                'directive': 'heap',
                'arg': info['arg'],
                'var': info['var'],
                'value': None,
                'line': tok.line,
            }
            if self._match(TK_ASSIGN):
                node['value'] = self._parse_expression()
            self._match(TK_SEMICOLON)
            return node

        # #auto[type] var = val; — auto-sized stack allocation, manual delete
        if dname == 'auto':
            node = {
                'type': 'directive',
                'directive': 'auto',
                'arg': info['arg'],
                'var': info['var'],
                'value': None,
                'line': tok.line,
            }
            if self._match(TK_ASSIGN):
                node['value'] = self._parse_expression()
            self._match(TK_SEMICOLON)
            return node

        # #peekstack[var, typeResult, currentindex, amount] stack_var;
        # #peekheap[var, typeResult, currentindex, amount] heap_var;
        if dname in ('peekstack', 'peekheap'):
            parts = [p.strip() for p in info['arg'].split(',')]
            if len(parts) < 4:
                raise CsscError(operation='Parser',
                                detail=f'#{dname} requires 4 arguments: var, typeResult, currentindex, amount',
                                hint=f'Usage: #{dname}[var, typeResult, currentindex, amount] result_var;',
                                line=tok.line)
            self._match(TK_SEMICOLON)
            return {
                'type': 'directive',
                'directive': dname,
                'peek_source': parts[0],
                'peek_type': parts[1],
                'peek_index': parts[2],
                'peek_amount': parts[3],
                'var': info['var'],
                'line': tok.line,
            }

        # #stdout(txt) — print to stdout console with timestamp and auto \n
        if dname == 'stdout':
            self._match(TK_SEMICOLON)
            return {
                'type': 'directive',
                'directive': 'stdout',
                'arg': info['arg'],
                'var': info.get('var', ''),
                'value': None,
                'line': tok.line,
            }

        # #sysarg[type, index] var; — extract system argument as stack variable
        if dname == 'sysarg':
            parts = [p.strip() for p in info['arg'].split(',')]
            if len(parts) < 2:
                raise CsscError(operation='Parser',
                                detail=f'#sysarg requires 2 arguments: type, index',
                                hint='Usage: #sysarg[type, index] var;',
                                line=tok.line)
            self._match(TK_SEMICOLON)
            return {
                'type': 'directive',
                'directive': 'sysarg',
                'sysarg_type': parts[0],
                'sysarg_index': parts[1],
                'var': info['var'],
                'line': tok.line,
            }

        # #reserve[label]; — initialize a deferred sector marked with ?label
        if dname == 'reserve':
            self._match(TK_SEMICOLON)
            return {
                'type': 'directive',
                'directive': 'reserve',
                'arg': info['arg'].strip(),
                'var': info.get('var', ''),
                'line': tok.line,
            }

        # #panic("message"); — throw artificial runtime error
        if dname == 'panic':
            self._match(TK_SEMICOLON)
            return {
                'type': 'directive',
                'directive': 'panic',
                'arg': info['arg'].strip().strip('"').strip("'"),
                'var': '',
                'value': None,
                'line': tok.line,
            }

        # #redefine(funcVar) +<pos> { code } — inject code at position in function
        # #redefine(funcVar) { code } — overwrite function body entirely
        if dname == 'redefine':
            target = info['arg'].strip()
            insert_pos = None
            # Check for +<pos>
            if self._match(TK_PLUS):
                self._match(TK_LT)
                pos_node = self._parse_additive()
                self._match(TK_GT)
                insert_pos = pos_node
            old_in_define = self._in_define_body
            self._in_define_body = True
            body = self._parse_block_or_stmt()
            self._in_define_body = old_in_define
            return {
                'type': 'redefine',
                'target': target,
                'insert_pos': insert_pos,
                'body': body,
                'line': tok.line,
            }

        # #sysout(expr); — return value to the CSSL caller (cssc.run() return value)
        if dname == 'sysout':
            val_node = None
            raw_arg = (info.get('arg') or '').strip()
            if raw_arg:
                # Always re-tokenize and parse as a full expression
                sub_lexer = CsscLexer(raw_arg + ';')
                sub_tokens = sub_lexer.tokenize()
                sub_parser = CsscParser(sub_tokens)
                val_node = sub_parser._parse_expression()
            self._match(TK_SEMICOLON)
            return {
                'type': 'directive',
                'directive': 'sysout',
                'value': val_node,
                'line': tok.line,
            }

        # #reallocate[var, type, region, size?] newvar; — move var to different memory region
        if dname == 'reallocate':
            # Generic-aware split: don't split inside <>, but ignore > in ->
            _arg = info['arg']
            parts, _d, _cur = [], 0, []
            for _i, _ch in enumerate(_arg):
                if _ch == '<': _d += 1; _cur.append(_ch)
                elif _ch == '>' and _d > 0: _d -= 1; _cur.append(_ch)
                elif _ch == ',' and _d == 0: parts.append(''.join(_cur).strip()); _cur = []
                else: _cur.append(_ch)
            if _cur: parts.append(''.join(_cur).strip())
            if len(parts) < 3:
                raise CsscError(operation='Parser',
                                detail='#reallocate requires at least 3 arguments: var, type, region',
                                hint='Usage: #reallocate[var, type, stack|heap, size?] newvar;',
                                line=tok.line)
            region = parts[2].lower()
            if region not in ('stack', 'heap'):
                raise CsscError(operation='Parser',
                                detail=f'#reallocate region must be stack or heap, got "{region}"',
                                line=tok.line)
            self._match(TK_SEMICOLON)
            return {
                'type': 'directive',
                'directive': 'reallocate',
                'source_var': parts[0],
                'realloc_type': parts[1],
                'target_region': region,
                'realloc_size': parts[3] if len(parts) > 3 else None,
                'var': info['var'],
                'line': tok.line,
            }

        # #resize[var, bits] — resize allocation (+/- bits)
        if dname == 'resize':
            self._match(TK_SEMICOLON)
            return {
                'type': 'directive',
                'directive': 'resize',
                'arg': info['arg'],
                'var': info.get('var', ''),
                'value': None,
                'line': tok.line,
            }

        # Default: #VARIABLE[type], #REQUIRE[path], #OUTPUT[path], #EXIT[code]
        node = {
            'type': 'directive',
            'directive': dname,
            'arg': info['arg'],
            'var': info['var'],
            'value': None,
            'line': tok.line,
        }
        if self._match(TK_ASSIGN):
            node['value'] = self._parse_expression()
        self._match(TK_SEMICOLON)
        return node

    def _parse_include_directive(self) -> dict:
        tok = self._advance()
        info = tok.value
        self._match(TK_SEMICOLON)
        return {
            'type': 'include',
            'module': info['module'],
            'var': info['var'],
            'line': tok.line,
        }

    def _parse_if(self) -> dict:
        tok = self._expect(TK_IF)
        # Support both if (cond) and if !(cond)
        negate = False
        if self._peek().type == TK_NOT:
            negate = True
            self._advance()
        self._expect(TK_LPAREN)
        condition = self._parse_expression()
        self._expect(TK_RPAREN)
        if negate:
            condition = {'type': 'unary', 'op': '!', 'operand': condition, 'line': tok.line}
        then_block = self._parse_block_or_stmt()
        else_block = None
        if self._match(TK_ELSE):
            if self._peek().type == TK_IF:
                # else if chain
                else_block = [self._parse_if()]
            else:
                else_block = self._parse_block_or_stmt()
        return {
            'type': 'if',
            'condition': condition,
            'then': then_block,
            'else': else_block,
            'line': tok.line,
        }

    _FOR_TYPE_KEYWORDS = {'int', 'float', 'string', 'bool', 'list', 'array', 'map', 'var', 'auto'}

    def _parse_for(self) -> dict:
        tok = self._expect(TK_FOR)
        self._expect(TK_LPAREN)
        # init — skip optional type keyword (e.g. "int n = 0")
        init = None
        has_type_decl = False
        if self._peek().type != TK_SEMICOLON:
            if self._peek().type == TK_IDENT and self._peek().value in self._FOR_TYPE_KEYWORDS:
                self._advance()  # skip the type keyword
                has_type_decl = True
            init = self._parse_expr_statement_inner()
            # Mark as for-loop declaration so runtime auto-declares the variable
            if has_type_decl and init and init.get('type') == 'assign':
                init['for_decl'] = True
        self._expect(TK_SEMICOLON)
        # condition
        cond = None
        if self._peek().type != TK_SEMICOLON:
            cond = self._parse_expression()
        self._expect(TK_SEMICOLON)
        # step
        step = None
        if self._peek().type != TK_RPAREN:
            step = self._parse_expr_statement_inner()
        self._expect(TK_RPAREN)
        body = self._parse_block_or_stmt()
        return {
            'type': 'for',
            'init': init,
            'condition': cond,
            'step': step,
            'body': body,
            'line': tok.line,
        }

    def _parse_while(self) -> dict:
        tok = self._expect(TK_WHILE)
        self._expect(TK_LPAREN)
        cond = self._parse_expression()
        self._expect(TK_RPAREN)
        body = self._parse_block_or_stmt()
        return {
            'type': 'while',
            'condition': cond,
            'body': body,
            'line': tok.line,
        }

    def _parse_select(self) -> dict:
        """Parse: select (iterable) ?label { body }
        Cursor-based iteration with explicit jump control.
          jump;     advance cursor +1, restart body
          jump++;   advance cursor +2
          !jump;    cursor -1
          !jump++;  cursor -2
        Body falling off the end (no jump) exits the loop.
        """
        tok = self._expect(TK_SELECT)
        self._expect(TK_LPAREN)
        iterable = self._parse_expression()
        self._expect(TK_RPAREN)
        self._expect(TK_QUESTION)
        label_tok = self._expect(TK_IDENT)
        # Parse body in select context — `jump`/`!jump` become select_jump signals
        if not hasattr(self, '_in_select'):
            self._in_select = 0
        self._in_select += 1
        try:
            body = self._parse_block_or_stmt()
        finally:
            self._in_select -= 1
        return {
            'type': 'select',
            'iterable': iterable,
            'label': label_tok.value,
            'body': body,
            'line': tok.line,
        }

    def _parse_sector(self) -> dict:
        """Parse: sector name<type: param, ...> ?reserveLabel { private: ... public: ... } free { ... }"""
        tok = self._expect(TK_SECTOR)
        name_tok = self._expect(TK_IDENT)

        # Optional generic parameters: <type: param, type: param, ...>
        params = []
        if not self._at_end() and self._peek().type == TK_LT:
            self._advance()  # consume <
            # CSSC v5: refs by default. The historical `*scopeVar` prefix
            # stays parsable as a deprecated alias for the ref behaviour
            # (no-op semantically). The NEW `&scopeVar` prefix forces a
            # deep-copy snapshot at injection time.
            #   scopeVar           — ref (default), shorthand for scopeVar: scopeVar
            #   scopeVar: newName  — ref (default), aliased name
            #   *scopeVar / *scopeVar: newName    — ref (deprecated form)
            #   &scopeVar / &scopeVar: newName    — explicit deep-copy snapshot
            while not self._at_end() and self._peek().type != TK_GT:
                copy_mode = False  # False = ref (default), True = deep-copy
                if not self._at_end() and self._peek().type == TK_STAR:
                    self._advance()        # legacy `*` — already ref-by-default
                elif not self._at_end() and self._peek().type == TK_AMP:
                    self._advance()        # `&` — explicit copy
                    copy_mode = True
                source_tok = self._expect(TK_IDENT)
                if not self._at_end() and self._peek().type == TK_COLON:
                    self._advance()                # consume :
                    inner_copy = False
                    if not self._at_end() and self._peek().type == TK_STAR:
                        self._advance()            # legacy
                    elif not self._at_end() and self._peek().type == TK_AMP:
                        self._advance()
                        inner_copy = True
                    param_tok = self._expect(TK_IDENT)
                    params.append({
                        'source_var': source_tok.value,
                        'param_name': param_tok.value,
                        'is_ref': not (copy_mode or inner_copy),
                    })
                else:
                    params.append({
                        'source_var': source_tok.value,
                        'param_name': source_tok.value,
                        'is_ref': not copy_mode,
                    })
                if not self._at_end() and self._peek().type == TK_COMMA:
                    self._advance()
            self._expect(TK_GT)  # consume >

        # Optional deferred init: ?reserveLabel — sector stays quiet until #reserve[label]
        reserve_label = None
        if not self._at_end() and self._peek().type == TK_QUESTION:
            self._advance()  # consume ?
            label_tok = self._expect(TK_IDENT)
            reserve_label = label_tok.value

        self._expect(TK_LBRACE)

        private_body = []
        public_body = []
        current = private_body  # default to private if no modifier given

        while not self._at_end() and self._peek().type != TK_RBRACE:
            # Check for access modifiers: private: / public:
            if self._peek().type == TK_PRIVATE:
                self._advance()
                self._expect(TK_COLON)
                current = private_body
                continue
            if self._peek().type == TK_PUBLIC:
                self._advance()
                self._expect(TK_COLON)
                current = public_body
                continue
            stmt = self._parse_statement()
            if stmt:
                current.append(stmt)

        self._expect(TK_RBRACE)

        # Optional: free { ... }
        free_body = None
        if not self._at_end() and self._peek().type == TK_FREE:
            self._advance()
            self._expect(TK_LBRACE)
            free_body = []
            while not self._at_end() and self._peek().type != TK_RBRACE:
                stmt = self._parse_statement()
                if stmt:
                    free_body.append(stmt)
            self._expect(TK_RBRACE)

        return {
            'type': 'sector',
            'name': name_tok.value,
            'params': params,
            'reserve_label': reserve_label,
            'private_body': private_body,
            'public_body': public_body,
            'free_body': free_body,
            'line': tok.line,
        }

    def _parse_object(self) -> dict:
        """Parse: object Name<params> { top-level... label<params>: stmts... } free { ... }"""
        tok = self._expect(TK_OBJECT)
        name_tok = self._expect(TK_IDENT)

        # CSSC v5 object constructor params — refs by default.
        # Forms:
        #   name              — scope ref (outer var with same name)
        #   *name             — scope ref (legacy, deprecated)
        #   &name             — scope COPY (deep-copy at instantiation)
        #   type: name        — typed constructor param (ref by default)
        #   type: *name       — typed param, ref (legacy alias)
        #   type: &name       — typed param, explicit copy
        # type may include nested generics: array<auto>, vector<int>, etc.
        params = []
        if not self._at_end() and self._peek().type == TK_LT:
            self._advance()  # consume outer <
            while not self._at_end() and self._peek().type != TK_GT:
                copy_mode = False
                if not self._at_end() and self._peek().type == TK_STAR:
                    self._advance()              # legacy `*` — no-op (ref is default)
                elif not self._at_end() and self._peek().type == TK_AMP:
                    self._advance()              # `&` — explicit copy
                    copy_mode = True
                # Read the first identifier — could be a scope var name OR a
                # type name. Accept `object` and `sector` keywords here too:
                # the user writes `<object: *display, sector: *tft, …>` to
                # mark a ref-capture's type for documentation / future
                # type-checking. Without this acceptance the parser fails
                # at the very first param ("Expected IDENT, got OBJECT").
                # Same applies to `free` / `private` / `public` in case
                # the user picks one as a type name — keyword status is a
                # lexer-only concern, the parser context here is
                # unambiguously a type-or-name slot.
                _OBJ_TPL_TYPE_KW = (TK_IDENT, TK_OBJECT, TK_SECTOR,
                                     TK_FREE, TK_PRIVATE, TK_PUBLIC)
                if self._peek().type not in _OBJ_TPL_TYPE_KW:
                    tk = self._peek()
                    raise CsscError(
                        operation='Parser',
                        detail=(f"object {name_tok.value!r}: expected type / "
                                f"param name in template-arg list, got "
                                f"{tk.type} ({tk.value!r})"),
                        line=tk.line, column=tk.column,
                    )
                first_tok = self._advance()
                # Use the raw text where available; keyword tokens carry
                # their literal in `.value` already (e.g. `object` →
                # 'object', `sector` → 'sector'). Fall back to the
                # lower-cased token-type name as a last resort.
                type_str = first_tok.value or str(first_tok.type).lower()
                if not self._at_end() and self._peek().type == TK_LT:
                    # Consume nested <...> as part of the type
                    type_str += '<'
                    self._advance()  # consume <
                    depth = 1
                    while depth > 0 and not self._at_end():
                        t = self._peek()
                        if t.type == TK_LT:
                            depth += 1
                            type_str += '<'
                        elif t.type == TK_GT:
                            depth -= 1
                            type_str += '>'
                        elif t.type == TK_COMMA and depth > 0:
                            type_str += ','
                        else:
                            val = t.value if t.type == TK_IDENT else str(t.value)
                            type_str += val
                        self._advance()
                # Now check: is there a colon? If so, this was a type and the param name follows
                if not self._at_end() and self._peek().type == TK_COLON:
                    self._advance()  # consume :
                    inner_copy = False
                    if not self._at_end() and self._peek().type == TK_STAR:
                        self._advance()           # legacy
                    elif not self._at_end() and self._peek().type == TK_AMP:
                        self._advance()
                        inner_copy = True
                    param_tok = self._expect(TK_IDENT)
                    params.append({
                        'source_var': type_str,   # type name (e.g. "array<auto>")
                        'param_name': param_tok.value,
                        'is_ref': not (copy_mode or inner_copy),
                        'is_typed': True,         # constructor parameter
                    })
                else:
                    # No colon — scope injection (name only)
                    params.append({
                        'source_var': type_str,   # outer variable name
                        'param_name': type_str,   # same name in object scope
                        'is_ref': not copy_mode,
                        'is_typed': False,        # scope injection, not constructor param
                    })
                if not self._at_end() and self._peek().type == TK_COMMA:
                    self._advance()
            self._expect(TK_GT)

        self._expect(TK_LBRACE)

        instructions = {}    # label_name → [stmts]
        top_level = []       # unnamed top-level statements
        current_label = None
        current_stmts = top_level
        # Access tracking — only used if method enables it via base!object.access.*
        public_labels = set()
        private_labels = set()
        public_members = set()
        private_members = set()
        current_access = 'public'  # default if no modifier

        while not self._at_end() and self._peek().type != TK_RBRACE:
            # Access modifier: private: or public:
            if self._peek().type == TK_PRIVATE:
                self._advance()
                if self._peek().type == TK_COLON:
                    self._advance()
                current_access = 'private'
                current_label = None
                current_stmts = top_level
                continue
            if self._peek().type == TK_PUBLIC:
                self._advance()
                if self._peek().type == TK_COLON:
                    self._advance()
                current_access = 'public'
                current_label = None
                current_stmts = top_level
                continue

            # Check for label — two forms:
            #   name:                     — simple label
            #   name<type: param, ...>:   — label with typed parameters

            # Form 1: name<...>: — label with parameters
            if (self._peek().type == TK_IDENT and
                    self._pos + 1 < len(self._tokens) and
                    self._tokens[self._pos + 1].type == TK_LT):
                # Check if this is label<params>: by scanning for > then :
                saved = self._pos
                label_name = self._advance().value  # consume name
                self._advance()  # consume <
                label_params = []  # list of {'kind': 'transfer'|'param', 'name': str, 'type': str|None, 'is_ref': bool}
                # CSSC v5 — label params are refs by default.
                # Forms:
                #   name              — transfer by ref (default)
                #   *name             — transfer by ref (legacy alias)
                #   &name             — transfer by COPY (explicit snapshot)
                #   type: name        — required typed call param (ref by default)
                #   type: *name       — typed param, ref (legacy)
                #   type: &name       — typed param, explicit copy
                #   type<gen>: name   — required param with nested generic type
                while not self._at_end() and self._peek().type != TK_GT:
                    # Guard against pathological / mid-typing input
                    # where the lookahead is not STAR / AMP / IDENT
                    # (e.g. `calculateMiddle<\n}` — user typed `<`
                    # and stopped before naming a param). Without
                    # this break the loop would spin forever — no
                    # branch advances the cursor when none of the
                    # below patterns matches, and the trailing COMMA
                    # consume can't fire either. The LSP hung
                    # indefinitely on every keystroke while the user
                    # was mid-typing a label param list.
                    pt = self._peek().type
                    # Accept `object` / `sector` keywords as type names in
                    # label-param slots too (`myLabel<object: *ref, ...>:`).
                    # Same reasoning as the object-decl template-arg
                    # acceptance set above: parser context here is
                    # unambiguous, the lexer's keyword status is just an
                    # artefact of tokenisation that this slot should
                    # tolerate.
                    _LBL_TYPE_KW = (TK_STAR, TK_AMP, TK_IDENT,
                                     TK_OBJECT, TK_SECTOR)
                    if pt not in _LBL_TYPE_KW:
                        break   # incomplete params — restore + fall through
                    # Leading * → transfer ref (legacy); leading & → transfer copy.
                    if self._peek().type == TK_STAR:
                        self._advance()              # legacy `*`
                        if not self._at_end() and self._peek().type == TK_IDENT:
                            pname = self._advance().value
                            label_params.append({'kind': 'transfer', 'name': pname,
                                                 'type': None, 'is_ref': True})
                    elif self._peek().type == TK_AMP:
                        self._advance()              # `&` — explicit copy
                        if not self._at_end() and self._peek().type == TK_IDENT:
                            pname = self._advance().value
                            label_params.append({'kind': 'transfer', 'name': pname,
                                                 'type': None, 'is_ref': False})
                    elif self._peek().type in (TK_IDENT, TK_OBJECT, TK_SECTOR):
                        # Could be: name (transfer copy), type: name, type: *name,
                        # or type<gen>: name (read type with possible nested generics).
                        # Module-prefixed types `mod::type` are also allowed.
                        # Keyword type slots (`object` / `sector`) flow
                        # through here and use their literal text as the
                        # type name.
                        first_tok = self._advance()
                        type_str = first_tok.value or str(first_tok.type).lower()
                        # Read `::ident...` chains (e.g. `bin::binary`).
                        while (not self._at_end() and self._peek().type == TK_DCOLON
                               and self._pos + 1 < len(self._tokens)
                               and self._tokens[self._pos + 1].type == TK_IDENT):
                            self._advance()  # ::
                            type_str += '::'
                            type_str += self._advance().value
                        # Read nested generics if present: type<...>
                        if not self._at_end() and self._peek().type == TK_LT:
                            self._advance()  # consume <
                            type_str += '<'
                            d = 1
                            while d > 0 and not self._at_end():
                                t = self._peek()
                                if t.type == TK_LT:
                                    d += 1
                                    type_str += '<'
                                elif t.type == TK_GT:
                                    d -= 1
                                    type_str += '>'
                                    if d == 0:
                                        self._advance()
                                        break
                                elif t.type == TK_COMMA and d > 0:
                                    type_str += ','
                                else:
                                    type_str += str(t.value) if isinstance(t.value, str) else str(t.type)
                                self._advance()
                        # Check for : indicating typed param
                        if not self._at_end() and self._peek().type == TK_COLON:
                            self._advance()  # consume :
                            # CSSC v5: typed param is ref by default.
                            # Legacy `*` keeps ref; new `&` flips to copy.
                            is_copy = False
                            if not self._at_end() and self._peek().type == TK_STAR:
                                self._advance()              # legacy alias
                            elif not self._at_end() and self._peek().type == TK_AMP:
                                self._advance()              # explicit copy
                                is_copy = True
                            if not self._at_end() and self._peek().type == TK_IDENT:
                                pname = self._advance().value
                                label_params.append({'kind': 'param', 'name': pname,
                                                     'type': type_str,
                                                     'is_ref': not is_copy})
                        else:
                            # No colon — bare-name transfer; ref-default.
                            label_params.append({'kind': 'transfer', 'name': type_str,
                                                 'type': None, 'is_ref': True})
                    if not self._at_end() and self._peek().type == TK_COMMA:
                        self._advance()
                self._expect(TK_GT)  # consume >
                if not self._at_end() and self._peek().type == TK_COLON:
                    self._advance()  # consume :
                    current_label = label_name
                    current_stmts = []
                    # Overload support: if label_name already exists, append to overloads
                    if label_name in instructions:
                        ovl_key = label_name + '__overloads'
                        if ovl_key not in instructions:
                            instructions[ovl_key] = []
                        # Save the previous (primary) definition as an overload too
                        if not instructions[ovl_key]:
                            instructions[ovl_key].append({
                                'params': instructions.get(label_name + '__params', []),
                                'body': instructions[label_name],
                            })
                        # Now register the new one as primary so subsequent stmts append to it
                        instructions[label_name] = current_stmts
                        instructions[label_name + '__params'] = label_params
                        instructions[ovl_key].append({
                            'params': label_params,
                            'body': current_stmts,
                        })
                    else:
                        instructions[current_label] = current_stmts
                        instructions[current_label + '__params'] = label_params
                    # Track label access (only first definition's access matters)
                    if current_access == 'private':
                        private_labels.add(label_name)
                    else:
                        public_labels.add(label_name)
                    continue
                else:
                    # Not a label — restore and fall through
                    self._pos = saved

            # Form 2: name: — simple label
            if (self._peek().type == TK_IDENT and
                    self._pos + 1 < len(self._tokens) and
                    self._tokens[self._pos + 1].type == TK_COLON):
                next2 = self._tokens[self._pos + 2] if self._pos + 2 < len(self._tokens) else None
                label_tok_peek = self._peek()
                is_label = True
                if next2 and next2.type == TK_LPAREN and next2.line == label_tok_peek.line:
                    is_label = False
                if is_label:
                    label_tok = self._advance()
                    self._advance()  # consume :
                    current_label = label_tok.value
                    current_stmts = []
                    # Overload support for simple labels
                    if label_tok.value in instructions:
                        ovl_key = label_tok.value + '__overloads'
                        if ovl_key not in instructions:
                            instructions[ovl_key] = []
                        if not instructions[ovl_key]:
                            instructions[ovl_key].append({
                                'params': instructions.get(label_tok.value + '__params', []),
                                'body': instructions[label_tok.value],
                            })
                        instructions[label_tok.value] = current_stmts
                        instructions[label_tok.value + '__params'] = []
                        instructions[ovl_key].append({
                            'params': [],
                            'body': current_stmts,
                        })
                    else:
                        instructions[current_label] = current_stmts
                    # Track label access
                    if current_access == 'private':
                        private_labels.add(label_tok.value)
                    else:
                        public_labels.add(label_tok.value)
                    continue
            stmt = self._parse_statement()
            if stmt:
                # Goto-as-top-level: if a goto statement is immediately followed
                # by a label declaration (or access modifier), treat it as a
                # top-level transition statement, not part of the current label.
                _goes_top = False
                if (isinstance(stmt, dict) and stmt.get('type') == 'call_label'
                        and current_label is not None):
                    nxt = self._peek() if not self._at_end() else None
                    nxt2 = self._tokens[self._pos + 1] if self._pos + 1 < len(self._tokens) else None
                    if nxt is not None:
                        # Next token starts a label?
                        if nxt.type in (TK_PRIVATE, TK_PUBLIC):
                            _goes_top = True
                        elif (nxt.type == TK_IDENT and nxt2 is not None
                              and nxt2.type == TK_COLON):
                            _goes_top = True
                        elif (nxt.type == TK_IDENT and nxt2 is not None
                              and nxt2.type == TK_LT):
                            # Could be label<params>: — scan ahead for matching > then :
                            scan_pos = self._pos + 2
                            depth = 1
                            while scan_pos < len(self._tokens) and depth > 0:
                                t = self._tokens[scan_pos]
                                if t.type == TK_LT:
                                    depth += 1
                                elif t.type == TK_GT:
                                    depth -= 1
                                    if depth == 0:
                                        scan_pos += 1
                                        break
                                scan_pos += 1
                            if (scan_pos < len(self._tokens)
                                    and self._tokens[scan_pos].type == TK_COLON):
                                _goes_top = True
                if _goes_top:
                    top_level.append(stmt)
                else:
                    current_stmts.append(stmt)
                # Track member variable access (for #stack/#heap/#auto declarations)
                if isinstance(stmt, dict) and stmt.get('type') == 'directive':
                    if stmt.get('directive') in ('stack', 'heap', 'auto'):
                        var = stmt.get('var', '')
                        # Strip Object->member prefix if present
                        member = var.split('->', 1)[1] if '->' in var else var
                        if member:
                            if current_access == 'private':
                                private_members.add(member)
                            else:
                                public_members.add(member)

        self._expect(TK_RBRACE)

        # Optional: free { ... }
        free_body = None
        if not self._at_end() and self._peek().type == TK_FREE:
            self._advance()
            self._expect(TK_LBRACE)
            free_body = []
            while not self._at_end() and self._peek().type != TK_RBRACE:
                stmt = self._parse_statement()
                if stmt:
                    free_body.append(stmt)
            self._expect(TK_RBRACE)

        return {
            'type': 'object',
            'name': name_tok.value,
            'params': params,
            'instructions': instructions,
            'top_level': top_level,
            'free_body': free_body,
            'public_labels': public_labels,
            'private_labels': private_labels,
            'public_members': public_members,
            'private_members': private_members,
            'line': tok.line,
        }

    def _parse_method(self) -> dict:
        """Parse: method Name<type> ?alias { decl_body } do { do_body } free { free_body }"""
        tok = self._expect(TK_METHOD)
        name_tok = self._expect(TK_IDENT)

        # Optional type constraint + scope params: <type, *param1, *param2>
        # type can include nested generics: array<auto>, vector<int>, etc.
        type_constraint = None
        scope_params = []  # list of {'name': str, 'is_ref': bool}
        if not self._at_end() and self._peek().type == TK_LT:
            self._advance()  # consume outer <
            # Read type name — may contain nested <> like array<auto>
            type_parts = []
            depth = 0
            while not self._at_end():
                t = self._peek()
                if t.type == TK_LT:
                    depth += 1
                    type_parts.append('<')
                    self._advance()
                elif t.type == TK_GT:
                    if depth == 0:
                        break  # this is the outer > or a comma-separated boundary
                    depth -= 1
                    type_parts.append('>')
                    self._advance()
                elif t.type == TK_COMMA and depth == 0:
                    break  # scope params start
                else:
                    val = t.value if t.type == TK_IDENT else t.type.lower() if isinstance(t.type, str) else str(t.value)
                    if t.type in (TK_SECTOR, TK_OBJECT):
                        val = t.type.lower()
                    type_parts.append(val)
                    self._advance()
            type_constraint = ''.join(type_parts)
            # Additional params: , *name or , name or , sector->member
            while not self._at_end() and self._peek().type == TK_COMMA:
                self._advance()  # consume ,
                is_ref = False
                if not self._at_end() and self._peek().type == TK_STAR:
                    self._advance()  # consume *
                    is_ref = True
                param_tok = self._expect(TK_IDENT)
                param_name = param_tok.value
                # Handle sector->member access
                if not self._at_end() and self._peek().type == TK_ARROW:
                    self._advance()  # consume ->
                    member_tok = self._expect(TK_IDENT)
                    param_name = param_name + '->' + member_tok.value
                scope_params.append({'name': param_name, 'is_ref': is_ref})
            self._expect(TK_GT)

        # Required alias: ?alias
        self._expect(TK_QUESTION)
        alias_tok = self._expect(TK_IDENT)

        # Declaration block: { decl_body }
        self._expect(TK_LBRACE)
        decl_body = []
        while not self._at_end() and self._peek().type != TK_RBRACE:
            # Check for alias!property pattern
            if (self._peek().type == TK_IDENT and
                    self._peek().value == alias_tok.value and
                    self._pos + 1 < len(self._tokens) and
                    self._tokens[self._pos + 1].type == TK_NOT):
                self._advance()  # consume alias
                self._advance()  # consume !
                # Parse property chain: ident.ident.ident
                # Accept keywords as property names (mirror, value, address, etc.)
                _STOP_TYPES = {TK_EOF, TK_SEMICOLON, TK_LBRACE, TK_RBRACE, TK_ASSIGN, TK_STAR}
                def _read_prop_ident():
                    t = self._peek()
                    if t.type == TK_IDENT:
                        self._advance()
                        return t.value
                    # Any keyword/token not in stop set → treat as property name
                    if t.type not in _STOP_TYPES:
                        self._advance()
                        # Return the string value of the keyword
                        if isinstance(t.value, str):
                            return t.value
                        return t.type.lower() if isinstance(t.type, str) else str(t.type)
                    return self._expect(TK_IDENT).value  # fallback, will error
                prop_parts = [_read_prop_ident()]
                while not self._at_end() and self._peek().type == TK_DOT:
                    self._advance()
                    prop_parts.append(_read_prop_ident())
                prop_path = '.'.join(prop_parts)

                if not self._at_end() and self._peek().type == TK_STAR:
                    # Binding: alias!prop *BindName;
                    self._advance()  # consume *
                    bind_tok = self._expect(TK_IDENT)
                    self._match(TK_SEMICOLON)
                    decl_body.append({
                        'type': 'method_bind',
                        'prop_path': prop_path,
                        'bind_name': bind_tok.value,
                        'line': bind_tok.line,
                    })
                elif not self._at_end() and self._peek().type == TK_ASSIGN:
                    # Setter: alias!prop = expr;
                    self._advance()  # consume =
                    value = self._parse_expression()
                    self._match(TK_SEMICOLON)
                    decl_body.append({
                        'type': 'method_set',
                        'prop_path': prop_path,
                        'value': value,
                        'line': tok.line,
                    })
                else:
                    # Just a read — skip
                    self._match(TK_SEMICOLON)
            else:
                # Regular statement in decl block
                stmt = self._parse_statement()
                if stmt:
                    decl_body.append(stmt)
        self._expect(TK_RBRACE)

        # Required: do { do_body }
        if self._at_end() or self._peek().type != TK_DO:
            raise CsscError(operation='Parser',
                            detail='method requires a `do { }` block after declaration',
                            line=tok.line)
        self._advance()  # consume 'do'
        self._expect(TK_LBRACE)
        do_body = []
        while not self._at_end() and self._peek().type != TK_RBRACE:
            stmt = self._parse_statement()
            if stmt:
                do_body.append(stmt)
        self._expect(TK_RBRACE)

        # Optional: free { free_body }
        free_body = None
        if not self._at_end() and self._peek().type == TK_FREE:
            self._advance()
            self._expect(TK_LBRACE)
            free_body = []
            while not self._at_end() and self._peek().type != TK_RBRACE:
                stmt = self._parse_statement()
                if stmt:
                    free_body.append(stmt)
            self._expect(TK_RBRACE)

        return {
            'type': 'method_def',
            'name': name_tok.value,
            'type_constraint': type_constraint,
            'scope_params': scope_params,
            'alias': alias_tok.value,
            'decl_body': decl_body,
            'do_body': do_body,
            'free_body': free_body,
            'line': tok.line,
        }

    def _parse_expr_statement_inner(self) -> dict:
        """Parse an expression statement without consuming semicolon."""
        expr = self._parse_expression()

        # ++/-- postfix already handled in expression

        # Deref assignment: *iter = expr
        if self._peek().type == TK_ASSIGN and expr.get('type') == 'unary' and expr.get('op') == '*':
            self._advance()
            value = self._parse_expression()
            return {'type': 'deref_assign', 'target': expr['operand'], 'value': value, 'line': expr['line']}

        # Assignment: ident = expr
        if self._peek().type == TK_ASSIGN and expr.get('type') == 'identifier':
            self._advance()
            value = self._parse_expression()
            return {'type': 'assign', 'target': expr['name'], 'value': value, 'line': expr['line']}

        # Compound assignment: ident += expr, ident -= expr
        if self._peek().type == TK_PLUS_ASSIGN and expr.get('type') == 'identifier':
            self._advance()
            value = self._parse_expression()
            return {'type': 'assign', 'target': expr['name'],
                    'value': {'type': 'binary', 'op': '+', 'left': expr, 'right': value, 'line': expr['line']},
                    'line': expr['line']}
        if self._peek().type == TK_MINUS_ASSIGN and expr.get('type') == 'identifier':
            self._advance()
            value = self._parse_expression()
            return {'type': 'assign', 'target': expr['name'],
                    'value': {'type': 'binary', 'op': '-', 'left': expr, 'right': value, 'line': expr['line']},
                    'line': expr['line']}

        # Compound assignment on arrow_access: Obj->member += expr / -= expr
        if self._peek().type == TK_PLUS_ASSIGN and expr.get('type') == 'arrow_access':
            self._advance()
            value = self._parse_expression()
            return {
                'type': 'arrow_assign',
                'object': expr['object'],
                'key': expr['key'],
                'value': {'type': 'binary', 'op': '+', 'left': expr, 'right': value, 'line': expr['line']},
                'line': expr['line'],
            }
        if self._peek().type == TK_MINUS_ASSIGN and expr.get('type') == 'arrow_access':
            self._advance()
            value = self._parse_expression()
            return {
                'type': 'arrow_assign',
                'object': expr['object'],
                'key': expr['key'],
                'value': {'type': 'binary', 'op': '-', 'left': expr, 'right': value, 'line': expr['line']},
                'line': expr['line'],
            }

        # Arrow assignment: expr->key = value
        if self._peek().type == TK_ASSIGN and expr.get('type') == 'arrow_access':
            self._advance()
            value = self._parse_expression()
            return {
                'type': 'arrow_assign',
                'object': expr['object'],
                'key': expr['key'],
                'value': value,
                'line': expr['line'],
            }

        # Dot assignment: obj.key = value
        if self._peek().type == TK_ASSIGN and expr.get('type') == 'dot_access':
            self._advance()
            value = self._parse_expression()
            return {
                'type': 'dot_assign',
                'object': expr['object'],
                'key': expr['key'],
                'value': value,
                'line': expr['line'],
            }

        # Namespace assignment: ns::ns::ident = value (e.g. gdt::CPU0::State = 1)
        # Useful for transpiler targets where the namespace is a foreign API.
        if self._peek().type == TK_ASSIGN and expr.get('type') == 'ns_access':
            self._advance()
            value = self._parse_expression()
            return {
                'type': 'ns_assign',
                'target': expr,
                'value': value,
                'line': expr.get('line', 0),
            }

        # Namespace compound assignment: ns::member += / -= value.
        # Sectors can hold mutable POD members (`#stack[int, …]`); the
        # ns_assign form already supports `=`, so the compound forms
        # are just sugar over `lhs = lhs + rhs` / `lhs = lhs - rhs`.
        # Without these branches, `std::YPos += 4;` failed with the
        # bogus "missing semicolon" diagnostic — the user's caro.cssc
        # hit exactly this.
        if (self._peek().type == TK_PLUS_ASSIGN
                and expr.get('type') == 'ns_access'):
            self._advance()
            value = self._parse_expression()
            return {
                'type': 'ns_assign',
                'target': expr,
                'value': {'type': 'binary', 'op': '+',
                          'left': expr, 'right': value,
                          'line': expr.get('line', 0)},
                'line': expr.get('line', 0),
            }
        if (self._peek().type == TK_MINUS_ASSIGN
                and expr.get('type') == 'ns_access'):
            self._advance()
            value = self._parse_expression()
            return {
                'type': 'ns_assign',
                'target': expr,
                'value': {'type': 'binary', 'op': '-',
                          'left': expr, 'right': value,
                          'line': expr.get('line', 0)},
                'line': expr.get('line', 0),
            }

        # Index assignment: arr[i] = value
        if self._peek().type == TK_ASSIGN and expr.get('type') == 'index':
            self._advance()
            value = self._parse_expression()
            return {
                'type': 'index_assign',
                'object': expr['object'],
                'index': expr['index'],
                'value': value,
                'line': expr['line'],
            }

        # Index compound assignment: arr[i] += value
        if self._peek().type == TK_PLUS_ASSIGN and expr.get('type') == 'index':
            self._advance()
            value = self._parse_expression()
            return {
                'type': 'index_assign',
                'object': expr['object'],
                'index': expr['index'],
                'value': {'type': 'binary', 'op': '+', 'left': expr, 'right': value, 'line': expr['line']},
                'line': expr['line'],
            }

        if self._peek().type == TK_MINUS_ASSIGN and expr.get('type') == 'index':
            self._advance()
            value = self._parse_expression()
            return {
                'type': 'index_assign',
                'object': expr['object'],
                'index': expr['index'],
                'value': {'type': 'binary', 'op': '-', 'left': expr, 'right': value, 'line': expr['line']},
                'line': expr['line'],
            }

        return {'type': 'expr_stmt', 'expr': expr, 'line': expr.get('line', 0)}

    def _parse_expr_statement(self) -> dict:
        node = self._parse_expr_statement_inner()

        # Result capture: expr varname;  or  expr *varname; (reference capture)
        # If the expression is a call/method_call and next token is an IDENT (not keyword),
        # treat it as result capture
        if (node.get('type') == 'expr_stmt' and
            node['expr'].get('type') in ('call', 'method_call', 'dot_call',
                                          'ns_call', 'member_ns_call') and
            self._peek().type == TK_IDENT and
            self._peek().value not in _KEYWORDS):
            varname_tok = self._advance()
            varname = varname_tok.value
            # Support Object->member result capture: Video() __main__->member;
            if not self._at_end() and self._peek().type == TK_ARROW:
                self._advance()  # consume ->
                member_tok = self._expect(TK_IDENT)
                varname = varname + '->' + member_tok.value
            self._expect_semicolon(node.get('line', 0))
            return {
                'type': 'result_capture',
                'expr': node['expr'],
                'var': varname,
                'ref_capture': False,
                'line': node.get('line', 0),
            }

        # func() *varname; — parsed as binary(call * ident) — reinterpret as ref capture
        if (node.get('type') == 'expr_stmt' and
            node['expr'].get('type') == 'binary' and
            node['expr'].get('op') == '*' and
            node['expr'].get('left', {}).get('type') in ('call', 'method_call',
                                                          'dot_call', 'ns_call',
                                                          'member_ns_call') and
            node['expr'].get('right', {}).get('type') == 'identifier'):
            call_expr = node['expr']['left']
            varname = node['expr']['right']['name']
            self._expect_semicolon(node.get('line', 0))
            return {
                'type': 'result_capture',
                'expr': call_expr,
                'var': varname,
                'ref_capture': True,
                'line': node.get('line', 0),
            }

        self._expect_semicolon(node.get('line', 0))
        return node

    # -- Expression parsing (precedence climbing) ---------------------------

    def _parse_expression(self) -> dict:
        return self._parse_or()

    def _parse_or(self) -> dict:
        left = self._parse_and()
        while self._peek().type == TK_OR:
            op = self._advance()
            right = self._parse_and()
            left = {'type': 'logical', 'op': '||', 'left': left, 'right': right, 'line': op.line}
        return left

    def _parse_and(self) -> dict:
        left = self._parse_comparison()
        while self._peek().type == TK_AND:
            op = self._advance()
            right = self._parse_comparison()
            left = {'type': 'logical', 'op': '&&', 'left': left, 'right': right, 'line': op.line}
        return left

    def _parse_comparison(self) -> dict:
        left = self._parse_additive()
        while self._peek().type in (TK_EQ, TK_NEQ, TK_LT, TK_GT, TK_LTE, TK_GTE):
            op_tok = self._advance()
            right = self._parse_additive()
            left = {'type': 'binary', 'op': op_tok.value, 'left': left, 'right': right, 'line': op_tok.line}
        return left

    def _parse_additive(self) -> dict:
        left = self._parse_multiplicative()
        while self._peek().type in (TK_PLUS, TK_MINUS):
            op_tok = self._advance()
            right = self._parse_multiplicative()
            left = {'type': 'binary', 'op': op_tok.value, 'left': left, 'right': right, 'line': op_tok.line}
        return left

    def _parse_multiplicative(self) -> dict:
        left = self._parse_unary()
        while self._peek().type in (TK_STAR, TK_SLASH, TK_PERCENT):
            op_tok = self._advance()
            right = self._parse_unary()
            left = {'type': 'binary', 'op': op_tok.value, 'left': left, 'right': right, 'line': op_tok.line}
        return left

    def _parse_unary(self) -> dict:
        if self._peek().type == TK_NOT:
            op = self._advance()
            expr = self._parse_unary()
            return {'type': 'unary', 'op': '!', 'operand': expr, 'line': op.line}
        if self._peek().type == TK_MINUS:
            op = self._advance()
            expr = self._parse_unary()
            return {'type': 'unary', 'op': '-', 'operand': expr, 'line': op.line}
        if self._peek().type == TK_STAR:
            # Legacy ref-prefix. New ownership model (see docs §2.5) makes
            # all argument passing by-reference by default, so `*x` is now
            # a synonym for `x`. We KEEP parsing it for backwards
            # compatibility and emit the same AST shape — _eval_unary
            # interprets `*` as a no-op for non-iterator operands now.
            op = self._advance()
            expr = self._parse_unary()
            return {'type': 'unary', 'op': '*', 'operand': expr, 'line': op.line}
        if self._peek().type == TK_AMP:
            # Explicit deep-copy. `&expr` evaluates expr then runs
            # cssc::copy on the result. Primitive types fall through
            # unchanged (cssc_copy is identity for int/float/bool/null).
            op = self._advance()
            expr = self._parse_unary()
            return {'type': 'copy_of', 'operand': expr, 'line': op.line}
        return self._parse_postfix()

    def _parse_postfix(self) -> dict:
        expr = self._parse_primary()

        while True:
            # Arrow access: expr->key or expr->method(args)
            if self._peek().type == TK_ARROW:
                self._advance()
                key_tok = self._expect(TK_IDENT)
                if self._peek().type == TK_LPAREN:
                    args = self._parse_args()
                    expr = {'type': 'method_call', 'object': expr, 'method': key_tok.value,
                            'args': args, 'line': expr.get('line', key_tok.line)}
                else:
                    expr = {'type': 'arrow_access', 'object': expr, 'key': key_tok.value,
                            'line': expr.get('line', key_tok.line)}
            # Namespace call on result: expr::func(args)
            # e.g. VideoModule->video::open(stream, "title")
            elif self._peek().type == TK_DCOLON:
                self._advance()  # consume ::
                # Accept keywords as member names (free, value, etc.)
                func_tok = self._peek()
                if func_tok.type == TK_IDENT:
                    self._advance()
                    func_name = func_tok.value
                else:
                    # keyword token used as member name
                    func_name = func_tok.type.lower() if isinstance(func_tok.type, str) else str(func_tok.value)
                    if isinstance(func_tok.value, str):
                        func_name = func_tok.value
                    self._advance()
                if self._peek().type == TK_LPAREN:
                    args = self._parse_args()
                    expr = {'type': 'member_ns_call', 'object': expr, 'func': func_name,
                            'args': args, 'line': expr.get('line', func_tok.line)}
                else:
                    expr = {'type': 'ns_access', 'namespace_expr': expr, 'member': func_name,
                            'line': expr.get('line', func_tok.line)}
            # Dot access: expr.key or expr.method(args)
            elif self._peek().type == TK_DOT:
                self._advance()
                key_tok = self._expect(TK_IDENT)
                if self._peek().type == TK_LPAREN:
                    args = self._parse_args()
                    expr = {'type': 'dot_call', 'object': expr, 'method': key_tok.value,
                            'args': args, 'line': expr.get('line', key_tok.line)}
                else:
                    expr = {'type': 'dot_access', 'object': expr, 'key': key_tok.value,
                            'line': expr.get('line', key_tok.line)}
            # Index: expr[index]
            elif self._peek().type == TK_LBRACKET:
                self._advance()
                index = self._parse_expression()
                self._expect(TK_RBRACKET)
                expr = {'type': 'index', 'object': expr, 'index': index,
                        'line': expr.get('line', 0)}
            # Postfix ++/--
            elif self._peek().type == TK_PLUS_PLUS and expr.get('type') == 'identifier':
                self._advance()
                expr = {'type': 'postfix', 'op': '++', 'operand': expr, 'line': expr['line']}
            elif self._peek().type == TK_MINUS_MINUS and expr.get('type') == 'identifier':
                self._advance()
                expr = {'type': 'postfix', 'op': '--', 'operand': expr, 'line': expr['line']}
            # Introspection: alias!property.sub — postfix ! on identifier
            elif (self._peek().type == TK_NOT and
                  expr.get('type') == 'identifier' and
                  self._pos + 1 < len(self._tokens) and
                  self._tokens[self._pos + 1].type == TK_IDENT):
                self._advance()  # consume !
                prop_parts = [self._expect(TK_IDENT).value]
                while not self._at_end() and self._peek().type == TK_DOT:
                    self._advance()
                    prop_parts.append(self._expect(TK_IDENT).value)
                expr = {'type': 'introspect', 'alias': expr['name'],
                        'prop_path': '.'.join(prop_parts),
                        'line': expr.get('line', 0)}
            else:
                break

        return expr

    def _parse_primary(self) -> dict:
        tok = self._peek()

        # #load["path"] as expression — returns loaded module
        if tok.type == TK_DIRECTIVE and isinstance(tok.value, dict) and tok.value.get('name') == 'load':
            self._advance()
            path = tok.value.get('arg', '').strip().strip('"').strip("'")
            return {'type': 'load_expr', 'load_path': path, 'line': tok.line}

        # Number — preserves hex-ness so the evaluator can route to hex-keyed vars
        if tok.type == TK_NUMBER:
            self._advance()
            return {
                'type': 'literal',
                'value': tok.value,
                'is_hex': bool(getattr(tok, 'is_hex', False)),
                'line': tok.line,
            }

        # String
        if tok.type == TK_STRING:
            self._advance()
            return {'type': 'string', 'value': tok.value, 'line': tok.line}

        # null
        if tok.type == TK_NULL:
            self._advance()
            return {'type': 'null', 'line': tok.line}

        # true/false
        if tok.type == TK_TRUE:
            self._advance()
            return {'type': 'literal', 'value': True, 'line': tok.line}
        if tok.type == TK_FALSE:
            self._advance()
            return {'type': 'literal', 'value': False, 'line': tok.line}

        # Parenthesized expression
        if tok.type == TK_LPAREN:
            self._advance()
            expr = self._parse_expression()
            self._expect(TK_RPAREN)
            return expr

        # Array literal: [a, b, c]
        if tok.type == TK_LBRACKET:
            self._advance()
            elements = []
            while self._peek().type != TK_RBRACKET and not self._at_end():
                elements.append(self._parse_expression())
                self._match(TK_COMMA)
            self._expect(TK_RBRACKET)
            return {'type': 'array', 'elements': elements, 'line': tok.line}

        # Map literal: {key: value, ...}
        if tok.type == TK_LBRACE:
            return self._parse_map_literal()

        # Identifier — possibly namespace::call, function call, or plain variable
        if tok.type == TK_IDENT:
            self._advance()
            name = tok.value

            # Namespace call: name::func(args)
            # After ::, accept identifiers AND keywords (e.g. cf::if, pk::in)
            if self._peek().type == TK_DCOLON:
                self._advance()  # consume ::
                next_tok = self._peek()
                # Accept any keyword as member/function name after ::
                _KW_STOP = {TK_EOF, TK_SEMICOLON, TK_LBRACE, TK_RBRACE, TK_COMMA, TK_ASSIGN}
                if next_tok.type == TK_IDENT:
                    self._advance()
                    func_tok = CsscToken(TK_IDENT, next_tok.value, next_tok.line, next_tok.column)
                elif next_tok.type not in _KW_STOP:
                    # Keyword token used as member name (free, value, run, etc.)
                    kw_val = next_tok.value if isinstance(next_tok.value, str) else next_tok.type.lower()
                    self._advance()
                    func_tok = CsscToken(TK_IDENT, kw_val, next_tok.line, next_tok.column)
                else:
                    raise CsscError(operation='Parser',
                        detail=f'Expected function name after "::", got {next_tok.type} ({next_tok.value!r})',
                        line=next_tok.line)
                if self._peek().type == TK_LPAREN:
                    args = self._parse_args()
                    return {'type': 'ns_call', 'namespace': name, 'func': func_tok.value,
                            'args': args, 'line': tok.line}
                # namespace::value (constant access)
                return {'type': 'ns_access', 'namespace': name, 'member': func_tok.value,
                        'line': tok.line}

            # Function call: name(args)
            if self._peek().type == TK_LPAREN:
                args = self._parse_args()
                return {'type': 'call', 'name': name, 'args': args, 'line': tok.line}

            return {'type': 'identifier', 'name': name, 'line': tok.line}

        raise CsscError(
            operation='Parser',
            detail=f"Unexpected token: {tok.type} ({tok.value!r})",
            line=tok.line, column=tok.column,
        )

    def _parse_args(self) -> list:
        self._expect(TK_LPAREN)
        args = []
        while self._peek().type != TK_RPAREN and not self._at_end():
            args.append(self._parse_expression())
            self._match(TK_COMMA)
        self._expect(TK_RPAREN)
        return args

    def _parse_map_literal(self) -> dict:
        tok = self._expect(TK_LBRACE)
        # Detect array literal vs map literal vs bind literal:
        # Empty {} → empty map
        if self._peek().type == TK_RBRACE:
            self._advance()
            return {'type': 'map_literal', 'pairs': [], 'line': tok.line}

        # Look ahead: after the first value token, is the next token , or }?
        # If so → array literal (or bind if semicolons found). If : or = → map literal.
        # Peek at token after the first simple value (string, number, ident, bool, null)
        is_array = False
        first = self._peek()
        if first.type == TK_LBRACE:
            # Nested {}: definitely an array of arrays/binds, not a map
            is_array = True
        elif first.type == TK_LBRACKET:
            # Nested []: array of arrays
            is_array = True
        elif first.type == TK_AMP:
            # `&` prefix marks a value-expression (explicit copy). Two
            # routings:
            #   `{&K, …}`  → array literal (each element is `&IDENT`)
            #   `{&K: …}` / `{&K = …}` → map literal with copy-key
            # We look ahead two tokens to decide: `&` then IDENT then
            # `:` / `=` is the map form, otherwise array.
            second = self._peek(1)
            third = self._peek(2)
            if (second.type == TK_IDENT
                    and third.type in (TK_COLON, TK_ASSIGN)):
                is_array = False
            else:
                is_array = True
        elif first.type in (TK_STRING, TK_NUMBER, TK_TRUE, TK_FALSE, TK_NULL, TK_IDENT):
            second = self._peek(1)
            if second.type in (TK_COMMA, TK_RBRACE):
                is_array = True
            elif first.type in (TK_NUMBER, TK_TRUE, TK_FALSE, TK_NULL) and second.type not in (TK_ASSIGN,) and second.type != TK_COLON:
                # Numbers, bools, null can never be map keys — must be expression list
                is_array = True
            elif first.type == TK_IDENT and second.type in (TK_ARROW, TK_DOT, TK_LBRACKET, TK_DCOLON, TK_LPAREN):
                # IDENT followed by member access / index / call / namespace
                # → it's an expression, not a map key. Without this branch
                # `{CPUClock->Output}` was misparsed as a map literal with
                # `CPUClock` as key, failing on the ARROW token.
                is_array = True

        if is_array:
            # Detect bind literal: {a, b; c, d; e, f}
            # Scan ahead for semicolons to distinguish from plain array
            is_bind = False
            save_pos = self._pos
            try:
                depth = 0
                scan = self._pos
                while scan < len(self._tokens):
                    t = self._tokens[scan]
                    if t.type == TK_LBRACE:
                        depth += 1
                    elif t.type == TK_RBRACE:
                        if depth == 0:
                            break
                        depth -= 1
                    elif t.type == TK_SEMICOLON and depth == 0:
                        is_bind = True
                        break
                    scan += 1
            except Exception:
                pass

            if is_bind:
                # Bind literal: {a, b; c, d; e, f} or {a, b, c; d, e, f}
                # — pairs are `;`-separated, cells WITHIN a pair are
                # `,`-separated. The pair width is whatever the source
                # chose; the CIR lowering enforces uniform width across
                # all pairs of a single literal so `i[row][col]` has a
                # consistent `row * pair_width + col` translation.
                pairs = []
                while self._peek().type != TK_RBRACE and not self._at_end():
                    cells = []
                    while self._peek().type not in (TK_SEMICOLON, TK_RBRACE) \
                            and not self._at_end():
                        cells.append(self._parse_expression())
                        if self._peek().type == TK_COMMA:
                            self._advance()
                        else:
                            break
                    if not cells:
                        raise CsscError(
                            operation='Parser',
                            detail='bind-literal pair must have at least '
                                   'one cell',
                            line=self._peek().line)
                    pairs.append(tuple(cells))
                    if self._peek().type == TK_SEMICOLON:
                        self._advance()  # consume ;
                    elif self._peek().type == TK_RBRACE:
                        pass  # last pair, no trailing ;
                    else:
                        self._match(TK_SEMICOLON)
                self._expect(TK_RBRACE)
                return {'type': 'bind_literal', 'pairs': pairs, 'line': tok.line}

            # Array/list literal: {val, val, ...}
            items = []
            while self._peek().type != TK_RBRACE and not self._at_end():
                items.append(self._parse_expression())
                self._match(TK_COMMA)
            self._expect(TK_RBRACE)
            return {'type': 'array_literal', 'items': items, 'line': tok.line}

        # Map literal: {key: value, key = value, ...}
        pairs = []
        while self._peek().type != TK_RBRACE and not self._at_end():
            # key can be string, identifier, or `&IDENT` (explicit-copy
            # prefix on the key — the runtime treats the key as a copy
            # of the named slot rather than a reference). The `&` is
            # currently swallowed here because the map-key downstream is
            # a plain Python string; we surface the copy intent via a
            # boolean flag attached to the pair if downstream callers
            # ever need it.
            key_tok = self._peek()
            if key_tok.type == TK_STRING:
                key = self._advance().value
            elif key_tok.type == TK_IDENT:
                key = self._advance().value
            elif key_tok.type == TK_AMP:
                self._advance()  # consume `&`
                inner = self._peek()
                if inner.type not in (TK_IDENT, TK_STRING):
                    raise CsscError(
                        operation='Parser',
                        detail=f"Expected identifier or string after `&` "
                               f"in map key, got {inner.type}",
                        line=inner.line)
                key = self._advance().value
            else:
                raise CsscError(operation='Parser', detail=f"Expected map key, got {key_tok.type}",
                                line=key_tok.line)
            # expect : or =
            if self._peek().type in (TK_ASSIGN,):
                self._advance()
            elif self._peek().type == TK_COLON:
                self._advance()
            else:
                # Try to accept just = sign
                self._expect(TK_ASSIGN)
            value = self._parse_expression()
            pairs.append((key, value))
            self._match(TK_COMMA)
        self._expect(TK_RBRACE)
        return {'type': 'map_literal', 'pairs': pairs, 'line': tok.line}


# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
class _BreakSignal(Exception):
    pass

class _ContinueSignal(Exception):
    pass

class _ReturnSignal(Exception):
    def __init__(self, value=None, source_var=None):
        self.value = value
        self.source_var = source_var  # variable name the return value came from

class _MirrorSignal(Exception):
    """Mirror: capture a return value but let the body keep running.

    Fields:
        value:      the snapshot at mirror time (always available)
        is_ref:     True when the user wrote bare `mirror X;`. The
                    caller re-fetches `ref_source` from the runtime
                    at body-end so deletions within the rest of the
                    body propagate to the outer capture (the live
                    reference semantic).
        ref_source: name of the bare-identifier slot whose value was
                    mirrored. None when the mirror expression isn't
                    a bare identifier (e.g. `mirror n+t;`) — in that
                    case the snapshot wins and live-link is N/A.
    """
    def __init__(self, value=None, is_ref=False, ref_source=None):
        self.value = value
        self.is_ref = is_ref
        self.ref_source = ref_source

class _DestructSignal(Exception):
    """Destruct: trigger free + kill object."""
    pass

class _SysReturnSignal(Exception):
    """System-level return: #sysout(value) — returns value to the CSSL caller."""
    def __init__(self, value=None):
        self.value = value

class _JumpSignal(Exception):
    """Jump control flow: jump; (skip iteration) or jump[funcAddr] (jump to function)."""
    def __init__(self, target=None):
        self.target = target


class _SelectJumpSignal(Exception):
    """Cursor advance signal inside select { } body. delta = +1, +2, -1, -2."""
    __slots__ = ('delta',)
    def __init__(self, delta=1):
        self.delta = delta


class CsscRuntime:
    """Execute CSSC AST with full resource management and namespace builtins."""

    def __init__(self, **kwargs):
        self._variables: Dict[str, Any] = {}
        self._variable_types: Dict[str, str] = {}
        self._resources: Dict[str, Tuple[str, Any]] = {}
        self._modules: Dict[str, Any] = {}  # loaded #include modules
        self._output_path: Optional[str] = None
        self._output_buffer: List[str] = []
        self._script_dir: str = kwargs.get('script_dir', os.getcwd())
        self._script_path: str = kwargs.get('script_path', '')
        self._search_paths: List[str] = kwargs.get('search_paths', [])
        self._running: bool = True
        self._exit_code: int = 0
        self._ns_builtins: Dict[str, Callable] = {}
        self._script_args: List[Any] = kwargs.get('args', [])
        # C++ acceleration
        self._accel = _CSSC_ACCEL
        self._cpp_scope = _cssc_accel_mod.CsscScope() if self._accel else None
        self._cpp_mem = _cssc_accel_mod.CsscMemPool() if self._accel and hasattr(_cssc_accel_mod, 'CsscMemPool') else None
        self._register_cssc_builtins()

    # -- cssc:: namespace builtins (100+) -----------------------------------
    def _register_cssc_builtins(self):
        self._ns_builtins = {
            # I/O (15 + aliases)
            'cout': self._b_cout,
            'coutln': self._b_coutln,
            'out': self._b_cout,
            'outln': self._b_coutln,
            'in': self._b_cin,
            'input': self._b_cin,
            'cerr': self._b_cerr,
            'clog': self._b_clog,
            'read_file': self._b_read_file,
            'write_file': self._b_write_file,
            'append_file': self._b_append_file,
            'file_exists': self._b_file_exists,
            'delete_file': self._b_delete_file,
            'copy_file': self._b_copy_file,
            'move_file': self._b_move_file,
            'file_size': self._b_file_size,
            'list_dir': self._b_list_dir,
            'mkdir': self._b_mkdir,
            # String (20)
            'strlen': lambda s: len(str(s)),
            'substr': lambda s, start, length=-1: str(s)[int(start):] if length == -1 else str(s)[int(start):int(start)+int(length)],
            'replace': lambda s, old, new: str(s).replace(str(old), str(new)),
            'split': lambda s, sep=' ': str(s).split(str(sep)),
            'join': lambda arr, sep='': str(sep).join(str(x) for x in arr) if isinstance(arr, list) else str(arr),
            'trim': lambda s: str(s).strip(),
            'ltrim': lambda s: str(s).lstrip(),
            'rtrim': lambda s: str(s).rstrip(),
            'upper': lambda s: str(s).upper(),
            'lower': lambda s: str(s).lower(),
            'contains': lambda s, sub: str(sub) in str(s),
            'starts_with': lambda s, p: str(s).startswith(str(p)),
            'ends_with': lambda s, p: str(s).endswith(str(p)),
            'index_of': lambda s, sub: str(s).find(str(sub)),
            'last_index_of': lambda s, sub: str(s).rfind(str(sub)),
            'char_at': lambda s, i: str(s)[int(i)] if 0 <= int(i) < len(str(s)) else '',
            'repeat': lambda s, n: str(s) * int(n),
            'reverse': lambda s: str(s)[::-1],
            'pad_left': lambda s, n, ch=' ': str(s).rjust(int(n), str(ch)[0] if ch else ' '),
            'pad_right': lambda s, n, ch=' ': str(s).ljust(int(n), str(ch)[0] if ch else ' '),
            # Math (20)
            'abs': lambda x: abs(x),
            'min': lambda a, b: min(a, b),
            'max': lambda a, b: max(a, b),
            'floor': lambda x: math.floor(x),
            'ceil': lambda x: math.ceil(x),
            'round': lambda x, n=0: round(x, int(n)),
            'sqrt': lambda x: math.sqrt(x),
            'pow': lambda x, y: math.pow(x, y),
            'log': lambda x: math.log(x),
            'log10': lambda x: math.log10(x),
            'sin': lambda x: math.sin(x),
            'cos': lambda x: math.cos(x),
            'tan': lambda x: math.tan(x),
            'pi': lambda: math.pi,
            'e': lambda: math.e,
            'random': lambda: random.random(),
            'random_int': lambda a, b: random.randint(int(a), int(b)),
            'random_float': lambda a, b: random.uniform(float(a), float(b)),
            'random_choice': lambda arr: random.choice(arr) if isinstance(arr, list) and arr else None,
            'clamp': lambda x, lo, hi: max(lo, min(x, hi)),
            # Array (20)
            'len': self._b_len,
            'push': lambda arr, val: (arr.append(val), arr)[-1] if isinstance(arr, list) else arr,
            'pop': lambda arr: arr.pop() if isinstance(arr, list) and arr else None,
            'shift': lambda arr: arr.pop(0) if isinstance(arr, list) and arr else None,
            'unshift': lambda arr, val: ([arr.insert(0, val), arr][-1]) if isinstance(arr, list) else arr,
            'slice': lambda arr, start, end=None: arr[int(start):] if end is None else arr[int(start):int(end)],
            'sort': lambda arr: sorted(arr) if isinstance(arr, list) else arr,
            'getIndex': lambda arr, i: arr[int(i)] if isinstance(arr, (list, tuple)) and 0 <= int(i) < len(arr) else None,
            'reverse_arr': lambda arr: list(reversed(arr)) if isinstance(arr, list) else arr,
            'map_arr': lambda arr, fn: arr,  # requires runtime callback support
            'filter': lambda arr, fn: arr,   # requires runtime callback support
            'find': lambda arr, val: arr.index(val) if isinstance(arr, list) and val in arr else -1,
            'concat': lambda a, b: (a if isinstance(a, list) else [a]) + (b if isinstance(b, list) else [b]),
            'unique': lambda arr: list(dict.fromkeys(arr)) if isinstance(arr, list) else arr,
            'flatten': lambda arr: [item for sub in arr for item in (sub if isinstance(sub, list) else [sub])] if isinstance(arr, list) else arr,
            'range': lambda start, end=None, step=1: list(range(int(start), int(end), int(step))) if end is not None else list(range(int(start))),
            'zip': lambda a, b: list(zip(a, b)) if isinstance(a, list) and isinstance(b, list) else [],
            'fill': lambda n, val=0: [val] * int(n),
            'count': lambda arr, val: arr.count(val) if isinstance(arr, list) else 0,
            'sum': lambda arr: sum(arr) if isinstance(arr, list) else 0,
            'avg': lambda arr: sum(arr) / len(arr) if isinstance(arr, list) and arr else 0,
            # Map (10)
            'keys': lambda m: list(m.keys()) if isinstance(m, dict) else [],
            'values': lambda m: list(m.values()) if isinstance(m, dict) else [],
            'has_key': lambda m, k: k in m if isinstance(m, dict) else False,
            'merge': lambda a, b: {**a, **b} if isinstance(a, dict) and isinstance(b, dict) else a,
            'entries': lambda m: list(m.items()) if isinstance(m, dict) else [],
            'from_entries': lambda arr: dict(arr) if isinstance(arr, list) else {},
            'map_keys': lambda m: list(m.keys()) if isinstance(m, dict) else [],
            'map_values': lambda m: list(m.values()) if isinstance(m, dict) else [],
            'map_size': lambda m: len(m) if isinstance(m, dict) else 0,
            'map_remove': lambda m, k: (m.pop(k, None), m)[-1] if isinstance(m, dict) else m,
            # Type (15)
            'typeof': self._b_typeof,
            'to_int': lambda v: int(v) if v is not None else 0,
            'to_float': lambda v: float(v) if v is not None else 0.0,
            'to_string': lambda v: str(v) if v is not None else 'null',
            'to_str': lambda v: str(v) if v is not None else 'null',
            'toString': lambda v: str(v) if v is not None else 'null',
            'to_bool': lambda v: bool(v),
            'to_array': lambda v: list(v) if hasattr(v, '__iter__') and not isinstance(v, str) else [v] if v is not None else [],
            'to_map': lambda v: dict(v) if isinstance(v, (list, tuple)) else {} if v is None else {'value': v},
            'is_int': lambda v: isinstance(v, int) and not isinstance(v, bool),
            'is_float': lambda v: isinstance(v, float),
            'is_string': lambda v: isinstance(v, str),
            'is_array': lambda v: isinstance(v, list),
            'is_map': lambda v: isinstance(v, dict),
            'is_bool': lambda v: isinstance(v, bool),
            'is_null': lambda v: v is None,
            'is_number': lambda v: isinstance(v, (int, float)) and not isinstance(v, bool),
            # Time (8)
            'time': lambda: time.time(),
            'timestamp': lambda: int(time.time()),
            'sleep': lambda ms: time.sleep(ms / 1000.0),
            'date': lambda: time.strftime('%Y-%m-%d'),
            'datetime': lambda: time.strftime('%Y-%m-%d %H:%M:%S'),
            'time_format': lambda fmt: time.strftime(fmt),
            'clock': lambda: time.perf_counter(),
            'elapsed': lambda start: time.perf_counter() - start,
            'detime': lambda: (lambda t: t.tm_hour + t.tm_min / 100.0)(time.localtime()),
            'sdetime': lambda: (lambda t: t.tm_min + t.tm_sec / 100.0)(time.localtime()),
            # Monotonic seconds-since-process-start. Mirrors the native
            # cssc_builtin_uptime — always live, no RTC dependency.
            'uptime': lambda: time.perf_counter(),
            # Process exit / restart (mirrors ESP.restart on chip).
            'reboot': lambda: self._b_exit(0),
            # Diagnostics markers — emit `[cssc-mem]` / `[cssc-cpu]` lines
            # the `cssc diagnostics` window parses. Same shape in both
            # interpreter paths so output is consistent.
            'diag_mem': self._b_diag_mem,
            'diag_cpu': self._b_diag_cpu,
            'diag_enable': self._b_diag_enable,
            # System (10)
            'env': lambda name: os.environ.get(str(name), ''),
            'set_env': lambda name, val: os.environ.__setitem__(str(name), str(val)),
            'cwd': lambda: os.getcwd(),
            'chdir': lambda p: os.chdir(p),
            'basename': lambda p: os.path.basename(str(p)),
            'dirname': lambda p: os.path.dirname(str(p)),
            'stem': lambda p: os.path.splitext(os.path.basename(str(p)))[0],
            'exec': self._b_exec,
            'exit': self._b_exit,
            'args': lambda: sys.argv[1:],
            'platform': lambda: sys.platform,
            'hostname': lambda: platform.node(),
            'user': lambda: os.environ.get('USER', os.environ.get('USERNAME', '')),
            # Hash/Encode (6)
            'md5': lambda s: hashlib.md5(str(s).encode()).hexdigest(),
            'sha256': lambda s: hashlib.sha256(str(s).encode()).hexdigest(),
            'base64_encode': lambda s: __import__('base64').b64encode(str(s).encode()).decode(),
            'base64_decode': lambda s: __import__('base64').b64decode(str(s)).decode(),
            'json_encode': lambda v: json.dumps(v),
            'json_decode': lambda s: json.loads(str(s)),
            # Format (4)
            'format': lambda fmt, *a: str(fmt).format(*a),
            'sprintf': lambda fmt, *a: fmt % a if a else fmt,
            'number_format': lambda n, dec=2: f'{float(n):.{int(dec)}f}',
            'hex': lambda n: hex(int(n)),
            # Script execution
            'run': self._b_run_cssc,
        }

    def _b_run_cssc(self, path, *args):
        """cssc::run(path, args...) — Run another .cssc script with args, returns output lines."""
        try:
            resolved = path
            if not os.path.isabs(path):
                resolved = os.path.join(self._script_dir, path)
            with open(resolved, 'r', encoding='utf-8') as f:
                source = f.read()
            tokens = CsscLexer(source, resolved).tokenize()
            ast = CsscParser(tokens, resolved).parse()
            child_rt = CsscRuntime(
                script_dir=os.path.dirname(os.path.abspath(resolved)),
                args=list(args),
            )
            child_rt.execute(ast)
            return ''.join(child_rt._output_buffer).splitlines()
        except Exception as e:
            raise CsscError(operation='Runtime', detail=f'cssc::run failed: {e}')

    # -- I/O builtins -------------------------------------------------------
    def _format_value(self, v):
        """Format a value for CSSC output: lists as {el1, el2, ...}, pointers resolved."""
        if v is None:
            return '0x0'
        if isinstance(v, CsscSector):
            return hex(id(v))
        if isinstance(v, CsscIterator):
            return f'iterator@{v._index}'
        if CsscMethodBinding is not None and isinstance(v, CsscMethodBinding):
            return self._format_value(v.get_value())
        if CsscMethod is not None and isinstance(v, CsscMethod):
            return f'Method({v._name})'
        if isinstance(v, CsscMatrix):
            return f'Matrix({v._width}x{v._height})'
        if isinstance(v, CsscPointer):
            resolved = self._resolve_value(v)
            if resolved is None or isinstance(resolved, CsscPointer):
                return '0x0'
            return self._format_value(resolved)
        if isinstance(v, CsscBind):
            inner = '; '.join(f'{self._format_value(a)}, {self._format_value(b)}' for a, b in v)
            return '{' + inner + '}'
        if isinstance(v, tuple) and len(v) == 2:
            return f'{self._format_value(v[0])}, {self._format_value(v[1])}'
        if isinstance(v, list):
            inner = ', '.join(self._format_value(x) for x in v)
            return '{' + inner + '}'
        if isinstance(v, dict):
            # If all keys are sequential integers (0, 1, 2...), display as {val, val}
            keys = list(v.keys())
            is_indexed = all(isinstance(k, int) and k == i for i, k in enumerate(keys))
            if is_indexed and keys:
                inner = ', '.join(self._format_value(v[k]) for k in keys)
            else:
                inner = ', '.join(f'{k}: {self._format_value(val)}' for k, val in v.items())
            return '{' + inner + '}'
        return str(v)

    def _b_cout(self, *args):
        text = ' '.join(self._format_value(a) for a in args)
        self._output_buffer.append(text)
        print(text, end='')

    def _b_coutln(self, *args):
        text = ' '.join(self._format_value(a) for a in args)
        self._output_buffer.append(text + '\n')
        print(text)

    def _b_cin(self, prompt='') -> str:
        return input(str(prompt))

    def _b_cerr(self, *args):
        text = ' '.join(self._format_value(a) for a in args)
        print(text, file=sys.stderr, end='')

    def _b_clog(self, *args):
        text = ' '.join(self._format_value(a) for a in args)
        print(f'[CSSC LOG] {text}', file=sys.stderr)

    def _b_read_file(self, path: str) -> str:
        resolved = self._resolve_path(path)
        if resolved and os.path.isfile(resolved):
            with open(resolved, 'r', encoding='utf-8') as fh:
                return fh.read()
        return ''

    def _b_write_file(self, path: str, content: str) -> bool:
        resolved = self._resolve_path(path) or path
        try:
            with open(resolved, 'w', encoding='utf-8') as fh:
                fh.write(str(content))
            return True
        except Exception:
            return False

    def _b_append_file(self, path: str, content: str) -> bool:
        resolved = self._resolve_path(path) or path
        try:
            with open(resolved, 'a', encoding='utf-8') as fh:
                fh.write(str(content))
            return True
        except Exception:
            return False

    def _b_file_exists(self, path: str) -> bool:
        resolved = self._resolve_path(path)
        return resolved is not None and os.path.exists(resolved)

    def _b_delete_file(self, path: str) -> bool:
        resolved = self._resolve_path(path)
        if resolved and os.path.isfile(resolved):
            os.remove(resolved)
            return True
        return False

    def _b_copy_file(self, src: str, dst: str) -> bool:
        try:
            shutil.copy2(self._resolve_path(src), self._resolve_path(dst) or dst)
            return True
        except Exception:
            return False

    def _b_move_file(self, src: str, dst: str) -> bool:
        try:
            shutil.move(self._resolve_path(src), self._resolve_path(dst) or dst)
            return True
        except Exception:
            return False

    def _b_file_size(self, path: str) -> int:
        resolved = self._resolve_path(path)
        if resolved and os.path.isfile(resolved):
            return os.path.getsize(resolved)
        return -1

    def _b_list_dir(self, path: str = '.') -> list:
        resolved = self._resolve_path(path)
        if resolved and os.path.isdir(resolved):
            return os.listdir(resolved)
        return []

    def _b_mkdir(self, path: str) -> bool:
        try:
            os.makedirs(self._resolve_path(path) or path, exist_ok=True)
            return True
        except Exception:
            return False

    # -- Other builtins -----------------------------------------------------
    def _b_len(self, value) -> int:
        if value is None:
            return 0
        try:
            return len(value)
        except TypeError:
            return 0

    def _b_typeof(self, value) -> str:
        if value is None:
            return 'null'
        if isinstance(value, bool):
            return 'bool'
        if isinstance(value, CsscVector):
            return 'vector'
        if isinstance(value, CsscMap):
            return 'map'
        if isinstance(value, CsscFunction):
            # `#define`d slot = index-based map<int> ([0]=value,[1]=addr)
            return 'map'
        if isinstance(value, CsscBind):
            return 'bind'
        if isinstance(value, CsscIterator):
            return 'iterator'
        if isinstance(value, CsscMatrix):
            return 'matrix'
        if isinstance(value, int):
            return 'int'
        if isinstance(value, float):
            return 'float'
        if isinstance(value, str):
            return 'string'
        if isinstance(value, list):
            return 'array'
        if isinstance(value, dict):
            return 'map'
        return type(value).__name__

    def _b_exec(self, command: str) -> str:
        try:
            result = subprocess.run(str(command), shell=True, capture_output=True, text=True, timeout=30)
            return result.stdout.strip()
        except subprocess.TimeoutExpired:
            return ''
        except Exception as e:
            return str(e)

    def _b_exit(self, code: int = 0):
        self._exit_code = int(code)
        self._running = False

    def _b_diag_mem(self):
        """Emit `[cssc-mem] heap=<free> free=<min-since-boot>` to stdout
        and return the current free-heap value. Interpreter-side proxy
        for the C runtime's cssc_diag_emit_mem — same line format so
        `cssc diagnostics` regex-parses both transparently."""
        if not getattr(self, '_diag_enabled', True):
            return 0
        try:
            import psutil   # type: ignore
            free_now = int(psutil.virtual_memory().available)
        except Exception:
            try:
                import resource   # type: ignore
                free_now = int(resource.getrusage(resource.RUSAGE_SELF).ru_maxrss * 1024)
            except Exception:
                free_now = 0
        cur_min = getattr(self, '_diag_min_free', 0xFFFFFFFF)
        if free_now and free_now < cur_min:
            self._diag_min_free = free_now
            cur_min = free_now
        sys.stdout.write(f"[cssc-mem] heap={free_now} free={cur_min}\n")
        sys.stdout.flush()
        return free_now

    def _b_diag_cpu(self, name, ms):
        if not getattr(self, '_diag_enabled', True):
            return
        try:
            ms_int = int(ms)
        except Exception:
            ms_int = 0
        sys.stdout.write(f"[cssc-cpu] {name} {ms_int}.0ms\n")
        sys.stdout.flush()

    def _b_diag_enable(self, on):
        self._diag_enabled = bool(on)
        if self._diag_enabled:
            self._diag_min_free = 0xFFFFFFFF

    def _resolve_path(self, path: str) -> Optional[str]:
        p = str(path)
        if os.path.isabs(p):
            return p
        candidate = os.path.join(self._script_dir, p)
        if os.path.exists(candidate):
            return candidate
        for sp in self._search_paths:
            candidate = os.path.join(sp, p)
            if os.path.exists(candidate):
                return candidate
        return os.path.join(self._script_dir, p)

    def _depend_locate(self, raw_path: str) -> Optional[str]:
        """Locate a .obj referenced by #depend['...'] through a priority chain:

          1. Literal path (absolute or relative-to-cwd)
          2. If path starts with '/' or '\\', treat as project-relative:
             strip the lead and try relative to CWD, then script_dir.
          3. %APPDATA%/cssc/objects/<basename> (with or without .obj suffix)
        """
        if not raw_path:
            return None

        # 1. Literal
        if os.path.isfile(raw_path):
            return os.path.abspath(raw_path)

        stripped = raw_path.lstrip('/\\')

        # 2. Project-relative candidates
        for base in (os.getcwd(), self._script_dir):
            if not base:
                continue
            c = os.path.join(base, stripped)
            if os.path.isfile(c):
                return os.path.abspath(c)

        # 3. Installed location
        try:
            from includecpp.core.cssl.native import cssc_obj_format as _obj_fmt
            basename = os.path.basename(stripped)
            name_no_ext = basename[:-4] if basename.endswith('.obj') else basename
            installed = _obj_fmt.resolve_installed(name_no_ext)
            if installed:
                return installed
        except Exception:
            pass

        return None

    # -- Module loading (#include) ------------------------------------------
    def _load_module(self, module_name: str) -> Any:
        if module_name == 'cssc.dll':
            return CsscDllModule(self._script_dir)
        if module_name == 'cssc.ini':
            return CsscIniModule(self._script_dir)
        if module_name == 'cssc.paths':
            return CsscPathsModule(self._script_dir)
        if module_name == 'cssc.env':
            return CsscEnvModule()
        if module_name == 'cssc.sys':
            return CsscSysModule()
        if module_name == 'cssc.io':
            return CsscIoModule(self._script_dir)
        if module_name == 'cssc.fastif':
            return CsscFastIfModule()
        if module_name in ('cssc.peek', 'peek'):
            return CsscPeekModule()
        if module_name == 'def':
            return CsscDefineModule()
        if module_name == 'cssc.math':
            return CsscMathModule()
        if module_name == 'stdio':
            return CsscStdioModule(self._script_dir)
        if module_name == 'sizes':
            return CsscSizesModule()
        if module_name == 'cssl':
            return CsscCsslModule(self._script_dir)
        if module_name == 'cssc.binary':
            return CsscBinaryModule(self._script_dir)
        if module_name == 'stdout':
            return CsscStdoutModule()
        if module_name == 'sys':
            return CsscSysArgsModule(args=getattr(self, '_script_args', None))
        if module_name == 'SharedLib':
            return CsscSharedLibModule()
        if module_name == 'matrix':
            from .cssl_matrix import CsscMatrixModule
            return CsscMatrixModule()
        if module_name == 'video':
            from .cssl_video import CsscVideoModule
            return CsscVideoModule()
        if module_name in ('video.sprite', 'sprite'):
            from .cssl_video_sprite import CsscVideoSpriteModule
            return CsscVideoSpriteModule()
        if module_name in ('video.tilemap', 'tilemap'):
            from .cssl_video_tilemap import CsscVideoTilemapModule
            return CsscVideoTilemapModule()
        if module_name in ('video.font', 'bitmapfont'):
            from .cssl_video_font import CsscVideoFontModule
            return CsscVideoFontModule()
        if module_name in ('math.accel', 'mathaccel', 'accel.math'):
            from .cssl_math_accel import CsscMathAccelModule
            return CsscMathAccelModule()
        if module_name == 'asyncthreads':
            from .cssl_asyncthreads import CsscAsyncThreadsModule
            return CsscAsyncThreadsModule(runtime=self)
        if module_name in ('serialcommunication', 'cssc.serialcommunication'):
            from .cssl_serialcom import CsscSerialComModule
            return CsscSerialComModule(runtime=self)
        if module_name in ('string', 'int', 'array', 'vector', 'map'):
            # Type modules — just enable the directive, no namespace functions
            class _TypeModule:
                _name = module_name
                def get_namespace(self): return {}
                def get_docs(self): return {f'#{module_name}': f'#{module_name}[args] var; — typed variable with methods'}
            return _TypeModule()
        if module_name == 'keyboard':
            from .cssl_input import CsscKeyboardModule
            return CsscKeyboardModule()
        if module_name == 'mouse':
            from .cssl_input import CsscMouseModule
            return CsscMouseModule()
        if module_name == 'sound':
            from .cssl_sound_native import CsscSoundModule
            return CsscSoundModule(script_dir=self._script_dir)
        if module_name in ('cssc.sidepackagetools', 'sidepackagetools'):
            from .cssl_sidepackage import CsscSidepackageModule
            return CsscSidepackageModule(runtime=self)
        if module_name == 'os':
            from .cssl_os import CsscOsModule
            return CsscOsModule(runtime=self)
        if module_name in ('sys.console', 'cssc.console', 'console'):
            from .cssl_console import CsscConsoleModule
            return CsscConsoleModule()
        if module_name == 'openai':
            from .cssl_openai import CsscOpenAIModule
            return CsscOpenAIModule()
        if module_name == 'retrogadgets':
            from .cssl_retrogadgets import CsscRetroGadgetsModule
            return CsscRetroGadgetsModule()
        if module_name == 'devdebug':
            from .cssl_devdebug import CsscDevDebugModule
            return CsscDevDebugModule()
        if module_name == 'stdgrace':
            from .cssl_stdgrace import CsscStdGraceModule
            return CsscStdGraceModule(runtime=self)
        if module_name == 'gipeo':
            from .cssl_gipeo import CsscGipeoModule
            return CsscGipeoModule()
        if module_name == 'allocwatcher':
            from .cssl_allocwatcher import CsscAllocWatcherModule
            return CsscAllocWatcherModule(runtime=self)
        if module_name == 'tft':
            from .cssl_tft import CsscTftModule
            return CsscTftModule()
        if module_name in ('network.http', 'http'):
            from .cssl_network_http import CsscNetworkHttpModule
            return CsscNetworkHttpModule()
        raise CsscError(operation='Runtime', detail=f"Unknown module: {module_name}",
                        hint="Available: cssc.dll, cssc.ini, cssc.paths, cssc.env, cssc.sys, cssc.io, cssc.fastif, peek, def, cssc.math, cssc.binary, stdio, stdout, sizes, sys, sys.console, cssl, matrix, video, video.sprite, video.tilemap, video.font, math.accel, asyncthreads, serialcommunication, keyboard, mouse, sound, gipeo, allocwatcher, tft, network.http, SharedLib")

    # -- Resource loading (#REQUIRE) ----------------------------------------
    def _load_resource(self, arg: str, varname: str):
        """Auto-detect resource type from path/content and load.

        Supports both string literals and expressions:
          #REQUIRE["config.ini"] cfg;         — string literal
          #REQUIRE[cp::search_walk("x.dll")] d;  — expression evaluated at runtime
        """
        # Check if arg is a plain string literal or an expression
        stripped = arg.strip()
        if (stripped.startswith('"') and stripped.endswith('"')) or \
           (stripped.startswith("'") and stripped.endswith("'")):
            # Plain string literal
            path = self._resolve_path(stripped.strip('"').strip("'"))
        else:
            # Expression — parse and evaluate it to get the path string
            try:
                lexer = CsscLexer(stripped)
                tokens = lexer.tokenize()
                parser = CsscParser(tokens)
                expr = parser._parse_expression()
                result = self._eval(expr)
                path = self._resolve_path(str(result))
            except Exception as e:
                raise CsscError(
                    operation='Runtime',
                    detail=f'Failed to evaluate #REQUIRE expression: {stripped} — {e}',
                    hint='Use #REQUIRE["path"] for string literals or #REQUIRE[expr] for expressions')

        # Try to detect type from extension
        ext = os.path.splitext(path)[1].lower() if path else ''

        if ext == '.ini' or ext == '.cfg' or ext == '.conf':
            self._load_ini(path, varname)
        elif ext == '.dll' or ext == '.so' or ext == '.dylib' or ext == '.pyd':
            self._load_dll(path, varname)
        elif ext == '.csl' or ext == '.cssc':
            self._load_csl(path, varname)
        elif ext == '.cssl':
            self._load_cssl_file(path, varname)
        elif ext == '.json':
            self._load_json(path, varname)
        else:
            # Auto-detect: try each loader
            if os.path.isfile(path):
                # Check content
                try:
                    with open(path, 'rb') as f:
                        header = f.read(16)
                    if header[:4] == b'MZ\x90\x00' or header[:4] == b'\x7fELF':
                        self._load_dll(path, varname)
                    elif b'[' in header and b']' in header[:64]:
                        self._load_ini(path, varname)
                    else:
                        # Default: treat as key-value store via CsslLibrary
                        self._load_csl(path, varname)
                except Exception:
                    self._load_csl(path, varname)
            else:
                # Path doesn't exist yet — create as key-value store
                self._load_csl(path, varname)

    def _load_ini(self, path: str, varname: str):
        ini = CsscIniHandler(path)
        self._variables[varname] = ini
        self._resources[varname] = ('ini', ini)

    def _load_dll(self, path: str, varname: str):
        try:
            dll = ctypes.CDLL(path)
            wrapper = CsscDllHandler(path, dll)
            self._variables[varname] = wrapper
            self._resources[varname] = ('dll', wrapper)
        except OSError:
            # Not a native DLL (could be a CSSL data file with .dll extension)
            # Fall back to CSL handler
            self._load_csl(path, varname)

    def _load_csl(self, path: str, varname: str):
        handler = CsscCslHandler(path)
        self._variables[varname] = handler
        self._resources[varname] = ('csl', handler)

    def _load_cssl_file(self, path: str, varname: str):
        if not os.path.isfile(path):
            raise CsscError(operation='Runtime', detail=f"CSSL file not found: {path}")
        handler = CsscCslHandler(path)
        self._variables[varname] = handler
        self._resources[varname] = ('cssl', handler)

    def _load_json(self, path: str, varname: str):
        if os.path.isfile(path):
            with open(path, 'r', encoding='utf-8') as fh:
                self._variables[varname] = json.load(fh)
        else:
            self._variables[varname] = {}
        self._resources[varname] = ('json', path)

    # -- Execution ----------------------------------------------------------
    def execute(self, ast: list):
        try:
            for node in ast:
                if not self._running:
                    break
                self._exec_node(node)
        except _SysReturnSignal as sr:
            return sr.value
        except _ReturnSignal:
            pass
        except _DestructSignal:
            # Object/sector ran `destruct;` — its free{} block already ran,
            # control unwinds cleanly. NOT an error.
            pass
        except CsscError:
            raise
        except Exception as e:
            raise CsscError(operation='Runtime', detail=str(e))
        # Auto-destruct heap variables (no #delete needed)
        if hasattr(self, '_heap_vars'):
            self._heap_vars.clear()
        return self._exit_code

    def _exec_node(self, node: dict):
        ntype = node.get('type')
        if ntype == 'directive':
            self._exec_directive(node)
        elif ntype == 'include':
            self._exec_include(node)
        elif ntype == 'if':
            self._exec_if(node)
        elif ntype == 'for':
            self._exec_for(node)
        elif ntype == 'while':
            self._exec_while(node)
        elif ntype == 'select':
            self._exec_select(node)
        elif ntype == 'select_jump':
            raise _SelectJumpSignal(delta=int(node.get('delta', 1)))
        elif ntype == 'break':
            raise _BreakSignal()
        elif ntype == 'continue':
            raise _ContinueSignal()
        elif ntype == 'jump':
            target = self._eval(node['target']) if node.get('target') else None
            raise _JumpSignal(target=target)
        elif ntype == 'return':
            val = self._eval(node['value']) if node.get('value') else None
            # Trigger 'returned' on method-bound values
            _ensure_method_imports()
            if CsscMethodBinding is not None and isinstance(val, CsscMethodBinding):
                val.trigger_do('returned', None)
                val = val.get_value()
            # Track source variable name for ownership transfer
            src_var = None
            if node.get('value') and node['value'].get('type') == 'identifier':
                src_var = node['value']['name']
            raise _ReturnSignal(val, source_var=src_var)
        elif ntype == 'deref_assign':
            # *iter = value — write through iterator
            target_val = self._eval(node['target'])
            value = self._eval(node['value'])
            if isinstance(target_val, CsscPointer):
                self._variables[target_val.name] = value
            elif isinstance(target_val, CsscIterator):
                target_val.deref_set(value)
            else:
                # target is an identifier node — resolve and check
                tname = node['target'].get('name') if isinstance(node['target'], dict) else None
                if tname:
                    existing = self._variables.get(tname)
                    if isinstance(existing, CsscIterator):
                        existing.deref_set(value)
                    else:
                        self._variables[tname] = value
        elif ntype == 'assign':
            self._exec_assign(node)
        elif ntype == 'arrow_assign':
            self._exec_arrow_assign(node)
        elif ntype == 'dot_assign':
            self._exec_dot_assign(node)
        elif ntype == 'index_assign':
            self._exec_index_assign(node)
        elif ntype == 'result_capture':
            expr = node['expr']
            ref_origins = []
            if expr.get('type') in ('call',) and expr.get('args'):
                for arg_node in expr['args']:
                    if arg_node.get('type') == 'unary' and arg_node.get('op') == '*':
                        operand = arg_node.get('operand', {})
                        if operand.get('type') == 'identifier':
                            ref_origins.append(operand['name'])
            result = self._eval(expr)
            varname = node['var']
            if varname in self._variable_types:
                self._strict_type_check(result, self._variable_types[varname],
                                        varname=varname, line=node.get('line', 0))
            # obj->member LHS routes into the object's _vars, NOT a flat
            # scope key. Without this, `Inner() Outer->inner;` planted a
            # `Outer->inner` literal-named entry in scope and later
            # `Outer->inner.run()` (which goes through _eval_arrow →
            # obj._vars[key]) saw None — method call no-oped silently.
            if '->' in varname:
                obj_name, _, member = varname.partition('->')
                holder = self._variables.get(obj_name)
                if isinstance(holder, (CsscObject, CsscSector)):
                    holder._vars[member] = result
                else:
                    self._variables[varname] = result
            else:
                self._variables[varname] = result
            # func() *x — reference capture: x holds ref to func["value"]
            if node.get('ref_capture'):
                func_name = None
                if expr.get('type') == 'call' and expr.get('name'):
                    func_name = expr['name']
                elif expr.get('type') == 'call' and expr.get('callee', {}).get('type') == 'identifier':
                    func_name = expr['callee']['name']
                if func_name:
                    if not hasattr(self, '_ref_links'):
                        self._ref_links = {}
                    self._ref_links[varname] = func_name
            # Transfer ownership of internal allocations returned by the function
            if hasattr(self, '_return_transfers') and self._return_transfers:
                for store_name, src_var, alloc_info in self._return_transfers:
                    store = getattr(self, store_name, None)
                    if store is not None:
                        store[varname] = alloc_info
                self._return_transfers.clear()
            # If call had *args, link result var to the originals
            if ref_origins:
                if not hasattr(self, '_ref_links'):
                    self._ref_links = {}
                for orig in ref_origins:
                    self._ref_links[varname] = orig
        elif ntype == 'expr_stmt':
            self._eval(node['expr'])
        elif ntype == 'block':
            for stmt in node.get('body', []):
                self._exec_node(stmt)
        elif ntype == 'private_scope':
            self._exec_private_scope(node)
        elif ntype == 'hex_scope':
            self._exec_hex_scope(node)
        elif ntype == 'define':
            self._exec_define(node)
        elif ntype == 'interrupt':
            # CCOS `#interrupt` handler — native (ccos) only. The
            # interpreter has no interrupt vector table; registering /
            # invoking it has no host meaning, so it is a no-op here
            # (kernel code is compiled with `cssc native --target ccos`).
            pass
        elif ntype == 'redefine':
            self._exec_redefine(node)
        elif ntype == 'sector':
            self._exec_sector(node)
        elif ntype == 'method_def':
            # Register method definition
            _ensure_method_imports()
            name = node['name']
            method = CsscMethod(
                name=name,
                type_constraint=node.get('type_constraint'),
                alias=node['alias'],
                decl_body=node['decl_body'],
                do_body=node['do_body'],
                free_body=node.get('free_body'),
                line=node.get('line', 0),
                scope_params=node.get('scope_params', []),
            )
            if not hasattr(self, '_methods'):
                self._methods = {}
            self._methods[name] = method
            self._variables[name] = method
        elif ntype == 'method_apply':
            # Apply method to a declaration: methodName ! #directive[...] var;
            _ensure_method_imports()
            method_name = node['method_name']
            decl_node = node['declaration']
            method = None
            if hasattr(self, '_methods'):
                method = self._methods.get(method_name)
            if method is None:
                method = self._variables.get(method_name)
            # Resolve ns::method through sector/module
            ns_callable = None
            if method is None and '::' in method_name:
                ns, mname = method_name.split('::', 1)
                ns_obj = self._modules.get(ns) or self._variables.get(ns)
                if isinstance(ns_obj, CsscSector):
                    method = ns_obj._vars.get(mname)
                elif isinstance(ns_obj, CsscObject):
                    method = ns_obj._vars.get(mname)
                elif hasattr(ns_obj, '_variables'):
                    method = ns_obj._variables.get(mname)
                # Module exposing a python callable via get_namespace() —
                # this is how `alw::watch ! sector __main__ { … }` reaches
                # the allocwatcher's `watch()` function from Python.
                if method is None and hasattr(ns_obj, 'get_namespace'):
                    try:
                        ns_dict = ns_obj.get_namespace()
                        if isinstance(ns_dict, dict) and callable(ns_dict.get(mname)):
                            ns_callable = ns_dict[mname]
                    except Exception:
                        pass
            # Decorator-callable shortcut: a plain Python callable from a
            # module's namespace. Bypasses the CsscMethodBinding pipeline
            # (which is for in-language method() definitions).
            #
            # Order: the decorator runs FIRST, *then* the declaration body
            # executes. This is what `alw::watch ! sector __main__ { … }`
            # needs: the watcher must be live while the sector body is
            # making allocations, not started after the body finishes.
            #
            # Since the sector instance doesn't exist yet at this point,
            # we pass `None` to the decorator (it can fall back to global
            # scope — which is exactly what allocwatcher does without an
            # arg). For decorators that strictly need the post-body
            # value, the user can keep using the explicit form
            # `alw::watch(target);` after the declaration.
            _is_cssc_method = (
                CsscMethod is not None and isinstance(method, CsscMethod)
            )
            if ns_callable is not None and not _is_cssc_method:
                try:
                    ns_callable(None)
                except TypeError:
                    # Decorator that doesn't accept None — try zero-arg.
                    try:
                        ns_callable()
                    except BaseException as e:
                        raise CsscError(operation='Runtime',
                                        detail=f"decorator '{method_name}' raised "
                                               f"{type(e).__name__}: {e}",
                                        line=node.get('line', 0))
                except BaseException as e:
                    raise CsscError(operation='Runtime',
                                    detail=f"decorator '{method_name}' raised "
                                           f"{type(e).__name__}: {e}",
                                    line=node.get('line', 0))
                # Now run the actual declaration with the decorator's
                # side effect already in place.
                self._exec_node(decl_node)
                return
            if not isinstance(method, CsscMethod):
                raise CsscError(operation='Runtime',
                                detail=f'method \'{method_name}\' not found',
                                line=node.get('line', 0))
            # Execute the declaration normally (creates the variable)
            self._exec_node(decl_node)
            var_name = decl_node.get('var', decl_node.get('name', ''))
            if not var_name and decl_node.get('type') == 'sector':
                var_name = decl_node.get('name', '')
            if not var_name and decl_node.get('type') == 'object':
                var_name = decl_node.get('name', '')
            # Type constraint check — infer from value for sector/object
            if method._type_constraint:
                actual = self._variable_types.get(var_name, 'auto')
                # Also check stripped member name (Object->member → member)
                if actual == 'auto' and '->' in var_name:
                    bare = var_name.split('->', 1)[1]
                    actual = self._variable_types.get(bare, 'auto')
                val = self._variables.get(var_name)
                if val is None and '->' in var_name:
                    bare = var_name.split('->', 1)[1]
                    val = self._variables.get(bare)
                if isinstance(val, CsscSector):
                    actual = 'sector'
                elif isinstance(val, CsscObject):
                    actual = 'object'
                elif isinstance(val, CsscFunction):
                    actual = 'function'
                if not method.check_type(actual):
                    raise CsscError(operation='Runtime',
                                    detail=f'method \'{method_name}\' requires type \'{method._type_constraint}\', got \'{actual}\'',
                                    line=node.get('line', 0))
            # Get allocation info
            alloc_info = None
            region = 'auto'
            for sv_name in ('_stack_vars', '_heap_vars', '_auto_vars'):
                store = getattr(self, sv_name, None)
                if store and var_name in store:
                    alloc_info = store[var_name]
                    region = sv_name.replace('_vars', '').lstrip('_')
                    break
            # Create binding
            binding = CsscMethodBinding(
                value=self._variables.get(var_name),
                method=method,
                runtime=self,
                var_name=var_name,
                alloc_info=alloc_info,
                type_name=self._variable_types.get(var_name, 'auto'),
                region=region,
                line=node.get('line', 0),
            )
            # Inject scope params: *param copies outer variable into binding scope
            for sp in method._scope_params:
                sp_name = sp['name']
                if '->' in sp_name:
                    # Sector->member: resolve through sector/object
                    parts = sp_name.split('->', 1)
                    owner = self._variables.get(parts[0])
                    if owner is None:
                        owner = self._modules.get(parts[0])
                    if owner is not None and hasattr(owner, '_vars') and parts[1] in owner._vars:
                        if sp['is_ref']:
                            binding._bindings[f'_scope_{sp_name}'] = sp_name
                elif sp_name in self._variables:
                    if sp['is_ref']:
                        binding._bindings[f'_scope_{sp_name}'] = sp_name
            # Execute declaration block to establish bindings
            for stmt in method._decl_body:
                if isinstance(stmt, dict):
                    if stmt.get('type') == 'method_bind':
                        binding._bindings[stmt['prop_path']] = stmt['bind_name']
                    elif stmt.get('type') == 'method_set':
                        val = self._eval(stmt['value'])
                        binding._introspector.set_property(stmt['prop_path'], val)
                    else:
                        # Regular statement — execute in binding scope
                        saved = self._variables.copy()
                        self._variables[method._alias] = binding
                        try:
                            self._exec_node(stmt)
                        finally:
                            self._variables = saved
            # Replace variable with binding
            self._variables[var_name] = binding
            if not hasattr(self, '_method_bindings'):
                self._method_bindings = {}
            self._method_bindings[var_name] = binding
        elif ntype == 'object':
            # Register object — NOT executed until Name() is called
            name = node['name']
            obj = CsscObject(name, node.get('instructions', {}),
                             node.get('top_level', []),
                             node.get('free_body'), self)
            # Carry access metadata from parser (sets, may be empty if no private:/public: used)
            obj._public_labels = set(node.get('public_labels', set()) or set())
            obj._private_labels = set(node.get('private_labels', set()) or set())
            obj._public_members = set(node.get('public_members', set()) or set())
            obj._private_members = set(node.get('private_members', set()) or set())
            # Process generic params: scope injections vs constructor params
            import copy as _copy
            constructor_params = []
            for p in (node.get('params') or []):
                inner_name = p['param_name']
                source_name = p.get('source_var', inner_name)
                is_ref = p.get('is_ref', False)
                is_typed = p.get('is_typed', False)
                if is_typed:
                    # Constructor parameter: injected at Object(args) instantiation
                    constructor_params.append({
                        'type': source_name,
                        'name': inner_name,
                        'is_ref': is_ref,
                    })
                else:
                    # Scope injection: take variable from outer scope now
                    if source_name in self._variables:
                        if is_ref:
                            obj._vars[inner_name] = self._variables[source_name]
                        else:
                            try:
                                obj._vars[inner_name] = _copy.deepcopy(self._variables[source_name])
                            except Exception:
                                obj._vars[inner_name] = self._variables[source_name]
            if constructor_params:
                obj._constructor_params = constructor_params
            self._variables[name] = obj
            self._modules[name] = obj
        elif ntype == 'call_label':
            # goto labelname(args) capture; — call label within current object
            # goto labelname<args> capture; — overload dispatch by arg types
            # goto labelname<*var, ...> — explicit transfer override at the goto site
            label = node['label']
            raw_args = node.get('args', [])
            # Separate value args from explicit transfer overrides
            value_args = []
            transfer_overrides = {}  # name -> resolved value
            for a in raw_args:
                if isinstance(a, dict) and a.get('type') == 'transfer_ref':
                    sname = a['name']
                    val = self._variables.get(sname)
                    if val is None and hasattr(self, '_parent_scopes'):
                        for ps in reversed(self._parent_scopes):
                            if sname in ps:
                                val = ps[sname]
                                break
                    if val is None:
                        val = self._modules.get(sname)
                    transfer_overrides[sname] = val
                else:
                    value_args.append(self._eval(a))
            args = value_args
            capture = node.get('capture')
            # Find the object we're inside (via _building_sector)
            obj_name = getattr(self, '_building_sector', None)
            obj = self._variables.get(obj_name) if obj_name else None
            if obj is None and obj_name and hasattr(self, '_parent_scopes'):
                for ps in reversed(self._parent_scopes):
                    if obj_name in ps:
                        obj = ps[obj_name]
                        break
            if isinstance(obj, CsscObject) and label in obj._instructions:
                # Resolve overload by runtime arg types (only value args count)
                resolved_params, resolved_body = obj._resolve_label_overload(label, args)
                if resolved_body is None:
                    resolved_body = obj._instructions.get(label, [])
                    resolved_params = obj._instructions.get(label + '__params', [])
                # Build extra_vars: required params from args, transfers from outer scope
                param_vars = {}
                arg_idx = 0
                for p in (resolved_params or []):
                    if p.get('kind') == 'param':
                        if arg_idx < len(args):
                            param_vars[p['name']] = args[arg_idx]
                            arg_idx += 1
                    elif p.get('kind') == 'transfer':
                        sname = p['name']
                        # Explicit override from goto<*var> takes precedence
                        if sname in transfer_overrides:
                            param_vars[sname] = transfer_overrides[sname]
                        elif sname in self._variables:
                            param_vars[sname] = self._variables[sname]
                        elif hasattr(self, '_parent_scopes'):
                            for ps in reversed(self._parent_scopes):
                                if sname in ps:
                                    param_vars[sname] = ps[sname]
                                    break
                # Also inject any explicit transfer overrides not bound to a label slot
                for sname, val in transfer_overrides.items():
                    if sname not in param_vars and val is not None:
                        param_vars[sname] = val
                if not hasattr(self, '_call_args_stack'):
                    self._call_args_stack = []
                self._call_args_stack.append((label, args))
                try:
                    result = obj._run_stmts(resolved_body, extra_vars=param_vars)
                except _MirrorSignal as m:
                    result = m.value
                except _DestructSignal:
                    if self._call_args_stack:
                        self._call_args_stack.pop()
                    raise
                finally:
                    if self._call_args_stack:
                        self._call_args_stack.pop()
                if capture:
                    self._variables[capture] = result
            else:
                raise CsscError(operation='Runtime',
                                detail=f'call: label \'{label}\' not found in current object',
                                line=node.get('line', 0))
        elif ntype == 'destruct':
            raise _DestructSignal()
        elif ntype == 'mirror':
            # v6 semantics: default = REFERENCE, `&` = DEEP-COPY.
            # When the mirror target is a bare identifier (a slot),
            # capture `ref_source` so the outer-capture re-fetches
            # the slot's CURRENT value at body-end — that's the
            # live-link behaviour the spec promises (deleting the
            # inner slot after `mirror inner;` invalidates the
            # outer to `0x0`). Expression mirrors (`mirror a+b;`)
            # have no slot to re-fetch → snapshot wins.
            import copy as _copy
            val = self._eval(node['value'])
            is_copy = bool(node.get('is_copy'))
            # If neither `is_copy` nor `is_ref` is present (very old
            # AST), fall back to the new v6 default (ref).
            if not is_copy and node.get('is_ref') is None:
                is_copy = False
            ref_source = None
            value_node = node.get('value')
            if (not is_copy
                    and isinstance(value_node, dict)
                    and value_node.get('type') in ('identifier',
                                                     'name', 'var_ref')):
                ref_source = (value_node.get('name') or '').strip() or None
            if is_copy:
                try:
                    raise _MirrorSignal(_copy.deepcopy(val),
                                          is_ref=False,
                                          ref_source=None)
                except _MirrorSignal:
                    raise
                except Exception:
                    raise _MirrorSignal(val, is_ref=False,
                                          ref_source=None)
            else:
                raise _MirrorSignal(val, is_ref=True,
                                      ref_source=ref_source)
        elif ntype == 'tlisten':
            target = node.get('target', '')
            body = node.get('body')
            if body and target:
                current_val = self._variables.get(target)
                if current_val is not None:
                    if isinstance(body, list):
                        for stmt in body:
                            self._exec_node(stmt)
                    elif isinstance(body, dict):
                        self._exec_node(body)
        elif ntype == 'cdefine':
            self._require_module('def', '#cdefine', node.get('line', 0))
            self._exec_cdefine(node)
        elif ntype == 'qvar':
            self._require_module('def', '#qvar', node.get('line', 0))
            self._exec_qvar(node)
        elif ntype == 'scanp':
            self._exec_scanp(node)

    # Module dependency map: directive -> required module name(s)
    _DIRECTIVE_MODULE_DEPS = {
        'fvar': 'def',
        'param': 'def',
        'scanp_opt': 'def',
        'sysarg': 'sys',
        'stdout': 'stdout',
        'matrix': 'matrix',
        'video': 'video',
        'framebuffer': 'video',
        'daemon': 'asyncthreads',
        'killdaemon': 'asyncthreads',
        'thread': 'asyncthreads',
        'await': 'asyncthreads',
        'string': 'string',
        'int': 'int',
        'array': 'array',
        'vector': 'vector',
        'map': 'map',
    }

    def _require_module(self, module_name, directive_name, line=0):
        """Check that a required module is loaded. Raise error if not."""
        for mod in self._modules.values():
            if getattr(mod, '_name', '') == module_name:
                return
        raise CsscError(
            operation='Runtime',
            detail=f'{directive_name} requires #include("{module_name}") to be loaded first',
            hint=f'Add: #include("{module_name}") at the top of your script',
            line=line)

    def _exec_directive(self, node: dict):
        directive = node['directive']
        arg = node['arg']
        var = node['var']
        # Resolve Object->member var names: strip prefix when inside the object's scope
        if '->' in var:
            parts = var.split('->', 1)
            obj_name, member = parts[0], parts[1]
            if getattr(self, '_building_sector', None) == obj_name:
                var = member
                node = dict(node)  # don't mutate original
                node['var'] = var
        # Check module dependencies for directives
        dep = self._DIRECTIVE_MODULE_DEPS.get(directive)
        if dep:
            self._require_module(dep, f'#{directive}', node.get('line', 0))

        if directive == 'REQUIRE':
            self._load_resource(arg, var)
        elif directive == 'VARIABLE':
            init_value = None
            if node.get('value') is not None:
                init_value = self._eval(node['value'])
            self._declare_variable(arg, var, init_value)
        elif directive == 'OUTPUT':
            self._output_path = self._resolve_path(arg)
        elif directive == 'EXIT':
            self._exit_code = int(arg) if arg else 0
            self._running = False
        elif directive == 'fvar':
            self._variables[var] = self._default_for_type(arg)
            self._variable_types[var] = arg
            if not hasattr(self, '_fvar_names'):
                self._fvar_names = set()
            self._fvar_names.add(var)
        elif directive == 'req':
            # #req[globalVar] localVar; — import global/parent scope variable into local scope
            # CSSC v5: ref-by-default (alias). `#req[X] &Y;` triggers an
            # explicit snapshot deep-copy via `_ref_links` removal +
            # copy.deepcopy below. Legacy `*Y` is still parsed as ref.
            global_var = node.get('global_var', '')
            is_ref = node.get('is_ref', True)
            parent_val = None
            parent_found = False
            parent_type = None

            # Sector member access: sectorName->member
            if '->' in global_var:
                parts = global_var.split('->', 1)
                sector_name = parts[0].strip()
                member_name = parts[1].strip()
                # During sector construction, resolve from local/parent scopes
                if getattr(self, '_building_sector', None) == sector_name:
                    if member_name in self._variables:
                        parent_val = self._variables[member_name]
                        parent_found = True
                    elif hasattr(self, '_parent_scopes') and self._parent_scopes:
                        for ps in reversed(self._parent_scopes):
                            if member_name in ps:
                                parent_val = ps[member_name]
                                parent_found = True
                                break
                    if not parent_found:
                        raise CsscError(operation='Runtime',
                                        detail=f'#req: member \'{member_name}\' not found in sector \'{sector_name}\'',
                                        line=node.get('line', 0))
                else:
                    # Find sector in parent scopes or current scope
                    sector_obj = None
                    if hasattr(self, '_parent_scopes') and self._parent_scopes:
                        for ps in reversed(self._parent_scopes):
                            if sector_name in ps and isinstance(ps[sector_name], CsscSector):
                                sector_obj = ps[sector_name]
                                break
                    if sector_obj is None and sector_name in self._variables:
                        val = self._variables[sector_name]
                        if isinstance(val, CsscSector):
                            sector_obj = val
                    if sector_obj is None:
                        raise CsscError(operation='Runtime',
                                        detail=f'#req: sector \'{sector_name}\' not found',
                                        line=node.get('line', 0))
                    # Check access: internal sector functions can access private members.
                    is_internal = False
                    if hasattr(self, '_call_args_stack') and self._call_args_stack:
                        calling_func = self._call_args_stack[-1][0]
                        if '->' in calling_func:
                            cf_parts = calling_func.split('->', 1)
                            if cf_parts[0].strip() == sector_name:
                                calling_func = cf_parts[1].strip()
                        if calling_func in sector_obj._public or calling_func in sector_obj._private:
                            is_internal = True
                    if member_name in sector_obj._private and not is_internal:
                        parent_val = None
                        parent_found = True
                    elif member_name in sector_obj._vars:
                        parent_val = sector_obj._vars[member_name]
                        parent_found = True
                    else:
                        raise CsscError(operation='Runtime',
                                        detail=f'#req: member \'{member_name}\' not found in sector \'{sector_name}\'',
                                        line=node.get('line', 0))
            else:
                # Standard variable lookup from parent scope
                if hasattr(self, '_parent_scopes') and self._parent_scopes:
                    for ps in reversed(self._parent_scopes):
                        if global_var in ps:
                            parent_val = ps[global_var]
                            parent_found = True
                            break
                elif global_var in self._variables:
                    parent_val = self._variables[global_var]
                    parent_found = True
            if not parent_found:
                raise CsscError(operation='Runtime',
                                detail=f'#req: variable \'{global_var}\' not found in parent scope',
                                hint=f'Ensure \'{global_var}\' is declared before the #define block',
                                line=node.get('line', 0))
            if is_ref:
                # Reference: localVar points to same object, changes propagate
                self._variables[var] = parent_val
                if not hasattr(self, '_ref_links'):
                    self._ref_links = {}
                # For sector members, link back to the sector's internal var
                if '->' in global_var:
                    parts = global_var.split('->', 1)
                    sector_name = parts[0].strip()
                    member_name = parts[1].strip()
                    # Direct reference into sector._vars so mutations propagate
                    self._ref_links[var] = f'{sector_name}->{member_name}'
                else:
                    self._ref_links[var] = global_var
            else:
                import copy
                self._variables[var] = copy.deepcopy(parent_val)
            # Copy type info from parent
            if hasattr(self, '_parent_scopes') and self._parent_scopes:
                pass
        elif directive == 'param':
            self._variables[var] = self._default_for_type(arg)
            self._variable_types[var] = arg
            if not hasattr(self, '_param_names'):
                self._param_names = set()
            self._param_names.add(var)
        elif directive == 'adress':
            # `#adress[var]` — three forms (parsed in the directive
            # dispatch). Statement-form #1 assigns the slot address
            # to a trailing name (`#adress[var] addr;`); form #2 rebinds
            # `var` to point at an existing address via
            # `#adress[var] = 0xABC;` (aliasing). The expression form
            # is handled in `_eval` so guards like
            # `if (#adress[var] != 0x0)` work without a temp.
            target_var = (arg or '').strip()
            if node.get('value') is not None:
                # --- ALIAS FORM: #adress[var] = 0xABC; ----------------
                addr_val = self._eval(node['value'])
                if isinstance(addr_val, str) and addr_val.lower().startswith('0x'):
                    addr_int = int(addr_val, 16)
                else:
                    addr_int = int(addr_val)
                if not hasattr(self, '_address_map'):
                    self._address_map = {}
                if addr_int not in self._address_map:
                    raise CsscError(operation='Runtime',
                                    detail=f'#adress: target address {hex(addr_int)} does not exist',
                                    hint='The address must belong to an existing #stack/#heap/#auto allocation',
                                    line=node.get('line', 0))
                source_name = self._address_map[addr_int]
                source_info = None
                source_store_name = None
                for _sv in ('_stack_vars', '_heap_vars', '_auto_vars'):
                    _store = getattr(self, _sv, None)
                    if _store and source_name in _store:
                        source_info = _store[source_name]
                        source_store_name = _sv
                        break
                if source_info is None:
                    raise CsscError(operation='Runtime',
                                    detail=f'#adress: source variable "{source_name}" buffer not found',
                                    line=node.get('line', 0))
                # Drop any existing allocation under target_var, then
                # alias it to the source's buffer (= shared memory).
                self._update_address_map(target_var, None, remove=True)
                for _sv in ('_stack_vars', '_heap_vars', '_auto_vars'):
                    _store = getattr(self, _sv, None)
                    if _store and target_var in _store:
                        del _store[target_var]
                        break
                alias_entry = {
                    'type': source_info['type'],
                    'max_bits': source_info['max_bits'],
                    'buffer': source_info['buffer'],
                    'region': source_info.get('region', 'heap'),
                }
                _store = getattr(self, source_store_name)
                _store[target_var] = alias_entry
                self._variables[target_var] = self._variables.get(source_name)
                self._variable_types[target_var] = source_info['type']
                return
            # --- GET FORM: #adress[var] addr_var; --------------------
            # Missing target_var is the user's escape hatch — return
            # 0x0 instead of raising, so the guarded idiom
            # `if (#adress[x] != 0x0) { #delete[x]; }` actually works.
            if target_var not in self._variables:
                if var:
                    self._variables[var] = '0x0'
                    self._variable_types[var] = 'string'
                return
            buf = None
            for _sv in ('_stack_vars', '_heap_vars', '_auto_vars'):
                _store = getattr(self, _sv, None)
                if _store and target_var in _store:
                    buf = _store[target_var]['buffer']
                    break
            if buf is not None:
                addr_str = hex(ctypes.addressof(buf))
            else:
                addr_str = hex(id(self._variables[target_var]))
            if var:
                self._variables[var] = addr_str
                self._variable_types[var] = 'string'
        elif directive == 'reflect':
            # #reflect[address] var; — resolve address back to value
            addr = arg
            addr_val = self._variables.get(addr, addr)
            if isinstance(addr_val, str) and addr_val.startswith('0x'):
                addr_int = int(addr_val, 16)
            else:
                addr_int = int(addr_val)
            found = None
            for store in [getattr(self, '_stack_vars', {}), getattr(self, '_heap_vars', {}), getattr(self, '_auto_vars', {})]:
                for vname, info in store.items():
                    buf = info['buffer']
                    if ctypes.addressof(buf) == addr_int:
                        found = self._variables.get(vname)
                        break
                if found is not None:
                    break
            if found is None:
                for vname, vval in self._variables.items():
                    if id(vval) == addr_int:
                        found = vval
                        break
            self._variables[var] = found
        elif directive == 'size':
            # #size[var] size_var; — get USED size in bits (actual data)
            target_var = arg
            if target_var not in self._variables:
                raise CsscError(operation='Runtime', detail=f'#size: variable "{target_var}" not defined',
                                line=node.get('line', 0))
            encoded = self._encode_value(self._variables[target_var])
            self._variables[var] = len(encoded) * 8
            self._variable_types[var] = 'int'
        elif directive == 'iterator':
            # #iterator[type, source] name; — create CsscIterator pointing into source container
            source_name = node.get('source', '')
            iter_type = node.get('iter_type', 'auto')
            if source_name not in self._variables:
                raise CsscError(operation='Runtime',
                                detail=f'#iterator: source variable "{source_name}" not defined',
                                line=node.get('line', 0))
            container = self._variables[source_name]
            if not isinstance(container, (list, CsscVector)):
                raise CsscError(operation='Runtime',
                                detail=f'#iterator: source "{source_name}" is not iterable (type: {self._b_typeof(container)})',
                                line=node.get('line', 0))
            it = CsscIterator(container, 0, iter_type)
            self._variables[var] = it
            self._variable_types[var] = 'iterator'
        elif directive == 'matrix':
            # #matrix[width, height] var; — create 2D pixel matrix
            w_expr = node.get('matrix_width', '0')
            h_expr = node.get('matrix_height', '0')
            try:
                w = int(self._eval({'type': 'identifier', 'name': w_expr}) if not w_expr.lstrip('-').isdigit() else int(w_expr))
            except Exception:
                w = int(w_expr) if w_expr.isdigit() else 0
            try:
                h = int(self._eval({'type': 'identifier', 'name': h_expr}) if not h_expr.lstrip('-').isdigit() else int(h_expr))
            except Exception:
                h = int(h_expr) if h_expr.isdigit() else 0
            fill = 0
            if node.get('value'):
                fill = int(self._eval(node['value']) or 0)
            mat = CsscMatrix(w, h, fill)
            self._variables[var] = mat
            self._variable_types[var] = 'matrix'
        elif directive == 'load':
            # #load["path/to/file.cssc"] var; — load external CSSC file as module
            load_path = node.get('load_path', '')
            resolved = self._resolve_path(load_path)
            if not os.path.isfile(resolved):
                raise CsscError(operation='Runtime',
                                detail=f'#load: file not found: {load_path}',
                                hint=f'Resolved path: {resolved}',
                                line=node.get('line', 0))
            with open(resolved, 'r', encoding='utf-8') as f:
                code = f.read()
            sub_lexer = CsscLexer(code, filename=resolved)
            sub_tokens = sub_lexer.tokenize()
            sub_parser = CsscParser(sub_tokens)
            sub_ast = sub_parser.parse()
            # Create child runtime with its own scope
            child_rt = CsscRuntime(script_dir=os.path.dirname(os.path.abspath(resolved)))
            # Share script args from parent
            child_rt._script_args = getattr(self, '_script_args', None)
            mod = CsscLoadedModule(var, resolved, child_rt, sub_ast)
            self._variables[var] = mod
            self._variable_types[var] = 'module'
            self._modules[var] = mod
        elif directive == 'depend':
            # #depend["path/to/project.obj"] alias; — depend on an isolated .obj
            # package. Interpreter mode extracts the bundled source (source/*.cssc)
            # and evaluates it as if it were the module body, exposing top-level
            # sectors/objects/defines under `alias`.
            depend_path = node.get('depend_path', '')
            resolved = self._depend_locate(depend_path)
            if not resolved:
                raise CsscError(operation='Runtime',
                                detail=f'#depend: could not locate .obj \'{depend_path}\'',
                                hint='Tried literal path, cwd, script dir, cproject root, and %APPDATA%/cssc/objects/. Build with `cssc install NAME -u ...`.',
                                line=node.get('line', 0))
            try:
                from includecpp.core.cssl.native import cssc_obj_format as _obj_fmt
                project_name, entries = _obj_fmt.unpack_obj(resolved)
            except Exception as e:
                raise CsscError(operation='Runtime',
                                detail=f'#depend: failed to read {resolved}: {e}',
                                line=node.get('line', 0))
            # Prefer source/<anything>.cssc as the "main" to run interpreted
            src_bytes = None
            src_name = None
            for name, data in entries.items():
                if name.startswith('source/') and name.endswith('.cssc'):
                    src_bytes = data
                    src_name = name
                    break
            if src_bytes is None:
                raise CsscError(operation='Runtime',
                                detail=f'#depend: {resolved} has no source/*.cssc entry for interpreted mode',
                                hint='Rebuild the .obj with the standard `cssc install ... -u` pipeline',
                                line=node.get('line', 0))
            code = src_bytes.decode('utf-8')
            sub_lexer = CsscLexer(code, filename=f'{resolved}::{src_name}')
            sub_tokens = sub_lexer.tokenize()
            sub_parser = CsscParser(sub_tokens)
            sub_ast = sub_parser.parse()
            # Run in a child runtime so the .obj is ISOLATED — its sectors
            # live in the child's scope and are exposed as a loaded module.
            child_rt = CsscRuntime(script_dir=os.path.dirname(os.path.abspath(resolved)))
            child_rt._script_args = getattr(self, '_script_args', None)
            mod = CsscLoadedModule(var, resolved, child_rt, sub_ast)
            mod._depend_origin = project_name
            self._variables[var] = mod
            self._variable_types[var] = 'module'
            self._modules[var] = mod
        elif directive == 'unload':
            # #unload[var] or #unload[Object->Member]
            target = arg
            mod = None
            owner_vars = self._variables
            real_name = target
            if '->' in target:
                parts = target.split('->', 1)
                obj = self._variables.get(parts[0])
                if isinstance(obj, (CsscObject, CsscSector)):
                    owner_vars = obj._vars
                    real_name = parts[1]
                    mod = obj._vars.get(parts[1])
            else:
                mod = self._variables.get(target)
            if mod is not None:
                if isinstance(mod, CsscLoadedModule) and mod._started:
                    for s in getattr(mod._runtime, '_sectors', []):
                        try:
                            s.run_free()
                        except Exception:
                            pass
                if real_name in owner_vars:
                    del owner_vars[real_name]
                self._modules.pop(real_name, None)
                if real_name in self._variable_types:
                    del self._variable_types[target]
        elif directive == 'panic':
            # #panic("message") — throw artificial runtime error
            msg = arg
            if msg in self._variables:
                msg = str(self._variables[msg])
            raise CsscError(operation='PANIC', detail=msg, line=node.get('line', 0))
        elif directive in ('string', 'int', 'array', 'vector', 'map'):
            # Type-specific directives with methods
            type_arg = node.get('type_arg', 'auto')
            bits_arg = node.get('bits_arg', '0')
            init_value = self._eval(node['value']) if node.get('value') else None
            var = node['var']
            if directive == 'string':
                val = str(init_value) if init_value is not None else ''
                self._variables[var] = val
                self._variable_types[var] = 'string'
            elif directive == 'int':
                val = int(init_value) if init_value is not None else 0
                self._variables[var] = val
                self._variable_types[var] = 'int'
            elif directive == 'vector':
                vec = CsscVector()
                if init_value is not None:
                    if isinstance(init_value, (list, CsscVector)):
                        vec.extend(init_value)
                    else:
                        vec.append(init_value)
                self._variables[var] = vec
                self._variable_types[var] = f'vector<{type_arg}>'
            elif directive == 'array':
                size = int(bits_arg) if bits_arg.isdigit() else 10
                arr = CsscArray(type_arg, size)
                if init_value is not None and isinstance(init_value, (list, tuple)):
                    for i, v in enumerate(init_value[:size]):
                        arr.append(v)
                self._variables[var] = arr
                self._variable_types[var] = f'array<{type_arg}>'
            elif directive == 'map':
                m = CsscMap()
                if init_value is not None:
                    if isinstance(init_value, dict):
                        m.update(init_value)
                    elif isinstance(init_value, (list, CsscVector)):
                        for i, v in enumerate(init_value):
                            m[i] = v
                self._variables[var] = m
                self._variable_types[var] = f'map<{type_arg}>'
        elif directive == 'thread':
            # #thread[type, bits] var; — same as #stack but marks for threading
            stype = node.get('thread_type', 'int')
            bits = int(node.get('thread_bits', '32'))
            init_val = self._eval(node['value']) if node.get('value') else self._default_for_type(stype)
            if init_val is not None:
                init_val = self._coerce(init_val, stype)
            self._variables[var] = init_val
            self._variable_types[var] = stype
            if not hasattr(self, '_thread_vars'):
                self._thread_vars = set()
            self._thread_vars.add(var)
        elif directive == 'daemon':
            # #daemon[var]; — start #define function as background daemon
            target = arg
            func = None
            resolved_name = target
            if '->' in target:
                parts = target.split('->', 1)
                sector_name = parts[0].strip()
                member_name = parts[1].strip()
                resolved_name = member_name
                # Look up in sector
                sector_obj = self._variables.get(sector_name)
                if isinstance(sector_obj, CsscSector):
                    func = sector_obj._vars.get(member_name)
                elif getattr(self, '_building_sector', None) == sector_name:
                    func = self._variables.get(member_name)
            else:
                func = self._variables.get(resolved_name)
            if not callable(func):
                raise CsscError(operation='Runtime',
                                detail=f'#daemon: \'{target}\' is not a callable function',
                                line=node.get('line', 0))
            # Find asyncthreads module
            at_mod = None
            for m in self._modules.values():
                if getattr(m, '_name', '') == 'asyncthreads':
                    at_mod = m
                    break
            if at_mod:
                at_mod.start_daemon(resolved_name, func, self)
        elif directive == 'killdaemon':
            # #killdaemon[var]; — stop a running daemon
            target = arg
            if '->' in target:
                parts = target.split('->', 1)
                target = parts[1].strip()
            at_mod = None
            for m in self._modules.values():
                if getattr(m, '_name', '') == 'asyncthreads':
                    at_mod = m
                    break
            if at_mod:
                at_mod.stop_daemon(target)
        elif directive == 'await':
            # #await[handle] var; — wait for thread to finish, store result
            handle_name = arg
            handle = self._variables.get(handle_name)
            from .cssl_asyncthreads import CsscDaemon
            if isinstance(handle, CsscDaemon):
                if handle._thread and handle._thread.is_alive():
                    handle._thread.join()
                self._variables[var] = handle._result
                self._variable_types[var] = 'auto'
            else:
                self._variables[var] = None
                self._variable_types[var] = 'auto'
        elif directive == 'video':
            # #video[w, h, fps] var; — create video context
            from .cssl_video import CsscVideoContext
            _vw = node.get('video_width', '320')
            _vh = node.get('video_height', '240')
            _vf = node.get('video_fps', '60')
            w = int(self._variables.get(_vw, _vw) if not str(_vw).lstrip('-').isdigit() else _vw)
            h = int(self._variables.get(_vh, _vh) if not str(_vh).lstrip('-').isdigit() else _vh)
            fps = int(self._variables.get(_vf, _vf) if not str(_vf).lstrip('-').isdigit() else _vf)
            self._variables[var] = CsscVideoContext(w, h, fps)
            self._variable_types[var] = 'video'
        elif directive == 'console':
            # #console[w, h] var; — create native Win32 console
            from .cssl_console import CsscConsoleContext
            _cw = node.get('console_width', '80')
            _ch = node.get('console_height', '25')
            w = int(self._variables.get(_cw, _cw) if not str(_cw).lstrip('-').isdigit() else _cw)
            h = int(self._variables.get(_ch, _ch) if not str(_ch).lstrip('-').isdigit() else _ch)
            # --no-console (CLI flag) downgrades the window to a stderr-
            # prefixed sink so headless/CI runs don't fight Win32.
            self._variables[var] = CsscConsoleContext(
                w, h, no_console=bool(getattr(self, '_no_console', False)))
            self._variable_types[var] = 'console'
        elif directive in ('pin', 'i2c', 'spi', 'uart', 'adc', 'pwm', 'timer'):
            # gipeo embedded peripherals — parser stored bracket parts
            # in `arg_parts`. Resolve identifiers to their int values
            # (allows #stack[int,32] PIN_LED = 5; #pin[PIN_LED] led;).
            self._exec_gipeo_directive(node, directive, var)
        elif directive == 'tft':
            # `#tft[ctrl, w, h] var;` — instantiate a display
            from .cssl_tft import CsscTft
            parts = node.get('arg_parts') or []
            ctrl = (parts[0] if len(parts) > 0 else 'ssd1306').strip().strip('"\'')
            # Allow controller as identifier (resolves through tft:: namespace)
            if ctrl in self._variables:
                resolved = self._variables.get(ctrl)
                if isinstance(resolved, str):
                    ctrl = resolved
            try:
                w = int(parts[1]) if len(parts) > 1 else 128
            except (TypeError, ValueError):
                w = int(self._variables.get(parts[1].strip(), 128) or 128)
            try:
                h = int(parts[2]) if len(parts) > 2 else 64
            except (TypeError, ValueError):
                h = int(self._variables.get(parts[2].strip(), 64) or 64)
            no_gui = bool(getattr(self, '_no_console', False))
            self._variables[var] = CsscTft(ctrl, w, h, no_gui=no_gui)
            self._variable_types[var] = 'tft'
        elif directive in ('get', 'post', 'send'):
            # network.http directives — desugar to namespace dispatch.
            # Same execution path as `http::get(url)` so behaviour is
            # identical regardless of which form the user picked.
            self._exec_http_directive(node, directive, var)
        elif directive == 'framebuffer':
            # #framebuffer[w, h] var; — create pixel buffer
            from .cssl_video import CsscFramebuffer
            w = int(node.get('fb_width', 320))
            h = int(node.get('fb_height', 240))
            self._variables[var] = CsscFramebuffer(w, h)
            self._variable_types[var] = 'framebuffer'
        elif directive == 'capacity':
            # #capacity[var] cap_var; — get ALLOCATED size in bits (buffer capacity)
            target_var = arg
            if target_var not in self._variables:
                raise CsscError(operation='Runtime', detail=f'#capacity: variable "{target_var}" not defined',
                                line=node.get('line', 0))
            _cap_found = False
            for _sv in ('_stack_vars', '_heap_vars', '_auto_vars'):
                _store = getattr(self, _sv, None)
                if _store and target_var in _store:
                    self._variables[var] = _store[target_var]['max_bits']
                    _cap_found = True
                    break
            if not _cap_found:
                self._variables[var] = sys.getsizeof(self._variables[target_var]) * 8
            self._variable_types[var] = 'int'
        elif directive == 'reserve':
            # #reserve[label] or #reserve[module.label] or #reserve[Object->Module.label]
            label = arg
            target_rt = self
            if '.' in label:
                mod_name, label = label.split('.', 1)
                # Resolve Object->Member chains
                mod = None
                if '->' in mod_name:
                    parts = mod_name.split('->', 1)
                    obj = self._variables.get(parts[0])
                    if isinstance(obj, CsscObject):
                        mod = obj._vars.get(parts[1])
                    elif isinstance(obj, CsscSector):
                        mod = obj._vars.get(parts[1])
                else:
                    mod = self._variables.get(mod_name)
                if isinstance(mod, CsscLoadedModule):
                    if not mod._started:
                        mod.start()
                    target_rt = mod._runtime
                else:
                    raise CsscError(operation='Runtime',
                                    detail=f'#reserve: \'{mod_name}\' is not a loaded module',
                                    line=node.get('line', 0))
            deferred = getattr(target_rt, '_deferred_sectors', {})
            if label not in deferred:
                raise CsscError(operation='Runtime',
                                detail=f'#reserve: no deferred sector with label \'{label}\'',
                                hint='Use: sector Name ?label {{ ... }} to defer initialization',
                                line=node.get('line', 0))
            sector_node = deferred.pop(label)
            sector_node['reserve_label'] = None
            target_rt._exec_sector(sector_node)
        elif directive == 'free':
            # #free[sectorName] or #free[module.sectorName] or #free[0xAEFF]
            sector_name = arg
            # Hex target: drop the persistent hex-scope storage.
            if isinstance(sector_name, str) and sector_name.lower().startswith('0x'):
                hex_id = int(sector_name, 16)
                hex_scopes = getattr(self, '_hex_scopes', None)
                if hex_scopes and hex_id in hex_scopes:
                    hex_scopes[hex_id]['freed'] = True
                    hex_scopes.pop(hex_id, None)
                return
            target_rt = self
            # Handle module.sector syntax
            if '.' in sector_name:
                mod_name, sector_name = sector_name.split('.', 1)
                mod = self._variables.get(mod_name)
                if isinstance(mod, CsscLoadedModule):
                    target_rt = mod._runtime
                else:
                    raise CsscError(operation='Runtime',
                                    detail=f'#free: \'{mod_name}\' is not a loaded module',
                                    line=node.get('line', 0))
            sector_obj = target_rt._variables.get(sector_name)
            # Search parent scopes if not found in current scope
            if sector_obj is None and hasattr(target_rt, '_parent_scopes') and target_rt._parent_scopes:
                for ps in reversed(target_rt._parent_scopes):
                    if sector_name in ps:
                        sector_obj = ps[sector_name]
                        break
            # Also search modules
            if sector_obj is None:
                sector_obj = target_rt._modules.get(sector_name)
            # Unwrap method binding for #free
            _ensure_method_imports()
            if CsscMethodBinding is not None and isinstance(sector_obj, CsscMethodBinding):
                sector_obj.trigger_do('delete', None)
                sector_obj.run_free()
                sector_obj = sector_obj.get_value()
            if isinstance(sector_obj, CsscObject):
                sector_obj.run_free()
            elif isinstance(sector_obj, CsscSector):
                sector_obj.run_free()
            elif isinstance(sector_obj, CsscLoadedModule):
                sector_obj.run_free()
            elif isinstance(sector_obj, CsscModule) or hasattr(sector_obj, 'get_namespace'):
                pass  # Builtin modules: no-op free (they have no cleanup)
            else:
                raise CsscError(operation='Runtime',
                                detail=f'#free: \'{sector_name}\' is not a sector or object',
                                line=node.get('line', 0))
            target_rt._modules.pop(sector_name, None)
            if sector_name in target_rt._variables:
                del target_rt._variables[sector_name]
            if sector_name in target_rt._variable_types:
                del target_rt._variable_types[sector_name]
            if hasattr(target_rt, '_sectors'):
                target_rt._sectors = [s for s in target_rt._sectors if s._name != sector_name]
            # Cleanup any pointers referencing the sector
            self._cleanup_pointers(sector_name)
        elif directive == 'delete':
            # #delete[var] or #delete[0xADDR] or #delete[Sector->Member] — free memory
            target_var = arg
            # Resolve Sector->Member to bare member name (used inside free blocks)
            if isinstance(target_var, str) and '->' in target_var:
                _parts = target_var.split('->', 1)
                _member = _parts[1].strip()
                if _member in self._variables:
                    target_var = _member
            # Detect hex address — resolve to variable name first
            if isinstance(target_var, str) and target_var.lower().startswith('0x'):
                addr_int = int(target_var, 16)
                # Prefer hex-keyed var storage (first-class hex identifier).
                hex_vars = getattr(self, '_hex_vars', None)
                if hex_vars and addr_int in hex_vars:
                    hex_vars.pop(addr_int)
                    return
                if not hasattr(self, '_address_map'):
                    self._address_map = {}
                target_var = self._address_map.get(addr_int)
                if target_var is None:
                    raise CsscError(operation='Runtime',
                                    detail=f'#delete: no allocation at address {hex(addr_int)}',
                                    hint='Use #exists[] to verify the address before deleting',
                                    line=node.get('line', 0))
            elif target_var in self._variables:
                # Check if the variable's VALUE is a hex address (indirect delete)
                val = self._variables[target_var]
                if isinstance(val, str) and val.lower().startswith('0x') and target_var not in getattr(self, '_stack_vars', {}) and target_var not in getattr(self, '_heap_vars', {}) and target_var not in getattr(self, '_auto_vars', {}):
                    addr_int = int(val, 16)
                    if not hasattr(self, '_address_map'):
                        self._address_map = {}
                    resolved = self._address_map.get(addr_int)
                    if resolved:
                        target_var = resolved
            # Method binding interception: trigger do {} and free {} on delete
            _ensure_method_imports()
            if target_var and CsscMethodBinding is not None:
                _mb = self._variables.get(target_var)
                if isinstance(_mb, CsscMethodBinding):
                    _mb.trigger_do('delete', None)
                    _mb.run_free()
            # Clean up address map before deleting
            self._update_address_map(target_var, None, remove=True)
            # Also clean up aliases sharing the same buffer
            _deleted_buf = None
            for _sv in ('_stack_vars', '_heap_vars', '_auto_vars'):
                _store = getattr(self, _sv, None)
                if _store and target_var in _store:
                    _deleted_buf = _store[target_var].get('buffer')
                    del _store[target_var]
            # Remove aliased entries that share the same buffer
            if _deleted_buf is not None:
                for _sv in ('_stack_vars', '_heap_vars', '_auto_vars'):
                    _store = getattr(self, _sv, None)
                    if _store:
                        aliases = [n for n, info in _store.items() if info.get('buffer') is _deleted_buf]
                        for alias in aliases:
                            del _store[alias]
                            self._update_address_map(alias, None, remove=True)
                            if alias in self._variables:
                                self._variables[alias] = None
                            if alias in self._variable_types:
                                del self._variable_types[alias]
            if target_var in self._variables:
                del self._variables[target_var]
            if target_var in self._variable_types:
                del self._variable_types[target_var]
            # Remove all CsscPointer references to this variable from containers
            self._cleanup_pointers(target_var)
            # Nullify any variables that hold a reference to this one via *
            if hasattr(self, '_ref_links'):
                for ref_holder, orig_name in list(self._ref_links.items()):
                    if orig_name == target_var and ref_holder in self._variables:
                        self._variables[ref_holder] = None
        elif directive == 'set':
            # #set[0xADDR, bits] = value; — write value at raw memory address
            parts = self._split_generic_args(arg)
            addr_expr = parts[0].strip() if len(parts) > 0 else ''
            bits_expr = parts[1].strip() if len(parts) > 1 else ''
            addr_int = self._resolve_address(addr_expr)
            if not hasattr(self, '_address_map'):
                self._address_map = {}
            if addr_int not in self._address_map:
                raise CsscError(operation='Runtime',
                                detail=f'#set: address {hex(addr_int)} is not a known allocation',
                                hint='Use #exists[] to verify the address, or allocate with #stack/#heap first',
                                line=node.get('line', 0))
            target_name = self._address_map[addr_int]
            target_info = None
            for _sv in ('_stack_vars', '_heap_vars', '_auto_vars'):
                _store = getattr(self, _sv, None)
                if _store and target_name in _store:
                    target_info = _store[target_name]
                    break
            if target_info is None:
                raise CsscError(operation='Runtime',
                                detail=f'#set: variable "{target_name}" at {hex(addr_int)} has no buffer',
                                line=node.get('line', 0))
            max_bits = self._resolve_size(bits_expr) if bits_expr else target_info['max_bits']
            max_bytes = max_bits // 8
            write_val = self._eval(node['value']) if node.get('value') is not None else self._default_for_type(target_info['type'])
            if isinstance(write_val, CsscPointer):
                write_val = self._resolve_value(write_val)
            write_val = self._coerce(write_val, target_info['type'])
            encoded = self._encode_value(write_val)
            if len(encoded) > max_bytes:
                raise CsscError(operation='Runtime',
                                detail=f'#set: value exceeds bit limit ({len(encoded) * 8} > {max_bits} bits)',
                                hint=f'Allocated {max_bits} bits at {hex(addr_int)}, value needs {len(encoded) * 8} bits',
                                line=node.get('line', 0))
            buf = target_info['buffer']
            buf.value = encoded[:ctypes.sizeof(buf)]
            self._variables[target_name] = write_val
        elif directive == 'exists':
            # #exists[0xADDR] result_var; — check if address is allocated (returns 1/0)
            addr_expr = arg.strip()
            try:
                addr_int = self._resolve_address(addr_expr)
            except (ValueError, TypeError):
                addr_int = -1
            if not hasattr(self, '_address_map'):
                self._address_map = {}
            result = 1 if addr_int in self._address_map else 0
            self._variables[var] = result
            self._variable_types[var] = 'int'
        elif directive == 'stdout':
            # #stdout(txt) — print plain text to dedicated stdout console window
            # Requires #include("stdout")
            stdout_loaded = any(isinstance(m, CsscStdoutModule) for m in self._modules.values())
            if not stdout_loaded:
                raise CsscError(operation='Runtime',
                                detail='#stdout requires #include("stdout")',
                                hint='Add #include("stdout"); at the top of your script',
                                line=node.get('line', 0))
            txt = str(arg) if arg else ''
            if txt in self._variables:
                txt = str(self._variables[txt])
            stdout_mod = None
            for mod in self._modules.values():
                if isinstance(mod, CsscStdoutModule):
                    stdout_mod = mod
                    break
            if stdout_mod:
                stdout_mod.write(txt)
            self._output_buffer.append(txt + '\n')
        elif directive == 'sysarg':
            # #sysarg[type, index] var; — extract system argument as stack variable
            # Requires #include("sys")
            sys_loaded = any(isinstance(m, (CsscSysModule, CsscSysArgsModule)) for m in self._modules.values())
            if not sys_loaded:
                raise CsscError(operation='Runtime',
                                detail='#sysarg requires #include("sys")',
                                hint='Add #include("sys") sys; at the top of your script',
                                line=node.get('line', 0))
            stype = node.get('sysarg_type', 'string')
            idx_expr = node.get('sysarg_index', '0')
            try:
                idx = int(self._eval({'type': 'identifier', 'name': idx_expr}) if not idx_expr.lstrip('-').isdigit() else int(idx_expr))
            except Exception:
                idx = int(idx_expr) if idx_expr.lstrip('-').isdigit() else 0
            args = getattr(self, '_script_args', None) or list(sys.argv[1:])
            raw_val = args[idx] if 0 <= idx < len(args) else None
            if raw_val is not None:
                val = self._coerce(raw_val, stype)
            else:
                val = self._default_for_type(stype)
            if not hasattr(self, '_stack_vars'):
                self._stack_vars = {}
            encoded = self._encode_value(val)
            buf = ctypes.create_string_buffer(max(len(encoded), 32))
            buf.value = encoded[:len(buf)]
            self._variables[var] = val
            self._variable_types[var] = stype
            self._stack_vars[var] = {'type': stype, 'max_bits': len(buf) * 8, 'buffer': buf, 'region': 'stack'}
            self._update_address_map(var, buf)
        elif directive == 'sysout':
            # #sysout(value); — return value to CSSL caller
            val_node = node.get('value')
            val = self._eval(val_node) if val_node else None
            raise _SysReturnSignal(val)
        elif directive == 'reallocate':
            # #reallocate[var, type, region, size?] newvar;
            # TRUE reallocation: moves the buffer between regions, zero-copy.
            # Type-strict: type must match source. No coercion — type mismatch is an error.
            src = node.get('source_var', '')
            target_region = node.get('target_region', 'heap')
            vtype = node.get('realloc_type', 'auto')
            size_expr = node.get('realloc_size')
            # Resolve Sector->Member references
            if '->' in src and src not in self._variables:
                _arrow_parts = src.split('->', 1)
                _sector_name, _member_name = _arrow_parts[0].strip(), _arrow_parts[1].strip()
                # During sector construction, resolve from local scope
                if getattr(self, '_building_sector', None) == _sector_name:
                    if _member_name in self._variables:
                        src = _member_name
                else:
                    _sector_obj = self._variables.get(_sector_name)
                    if hasattr(_sector_obj, 'get_member') and _sector_obj.get_member(_member_name) is not None:
                        self._variables[_member_name] = _sector_obj.get_member(_member_name)
                        src = _member_name
            if src not in self._variables:
                raise CsscError(operation='Runtime',
                                detail=f'#reallocate: source variable \'{src}\' not found',
                                line=node.get('line', 0))
            val = self._variables[src]
            src_type = self._variable_types.get(src, 'auto')
            # Type-strict check: declared type must match source type
            if vtype != 'auto' and src_type != 'auto' and vtype != src_type:
                raise CsscError(operation='Runtime',
                                detail=f'#reallocate: type mismatch — \'{src}\' is {src_type}, not {vtype}',
                                hint=f'Use #reallocate[{src}, {src_type}, {target_region}] to match the source type',
                                line=node.get('line', 0))
            # Find source allocation — take ownership of its buffer
            src_alloc = None
            src_store_name = None
            for _sv in ('_stack_vars', '_heap_vars', '_auto_vars'):
                _store = getattr(self, _sv, None)
                if _store and src in _store:
                    src_alloc = _store.pop(src)  # take it out
                    src_store_name = _sv
                    break
            old_max_bits = src_alloc['max_bits'] if src_alloc else 256
            buf = src_alloc['buffer'] if src_alloc else None
            # Determine new capacity
            encoded = self._encode_value(val)
            used_bits = len(encoded) * 8
            if size_expr is not None:
                max_bits = self._resolve_size(size_expr)
            else:
                if (old_max_bits - used_bits) < 32:
                    max_bits = old_max_bits + 32
                else:
                    max_bits = old_max_bits
            max_bytes = max(max_bits // 8, len(encoded))
            # Real realloc: resize existing buffer in-place if possible
            if buf is not None:
                old_size = ctypes.sizeof(buf)
                if max_bytes != old_size:
                    # ctypes.resize() changes the buffer size in-place
                    try:
                        ctypes.resize(buf, max_bytes)
                    except ValueError:
                        # Can't resize — create new buffer and copy raw memory
                        new_buf = ctypes.create_string_buffer(max_bytes)
                        ctypes.memmove(new_buf, buf, min(old_size, max_bytes))
                        buf = new_buf
                # No re-encode needed — type-strict, buffer data stays as-is
            else:
                buf = ctypes.create_string_buffer(max_bytes)
                buf.value = encoded[:max_bytes]
            # Move value: rename from src → var (zero-copy for the Python object)
            self._variables[var] = val
            self._variable_types[var] = vtype
            alloc_entry = {'type': vtype, 'max_bits': max_bits, 'buffer': buf, 'region': target_region}
            if target_region == 'stack':
                if not hasattr(self, '_stack_vars'):
                    self._stack_vars = {}
                self._stack_vars[var] = alloc_entry
            else:
                if not hasattr(self, '_heap_vars'):
                    self._heap_vars = {}
                self._heap_vars[var] = alloc_entry
            self._update_address_map(src, None, remove=True)
            self._update_address_map(var, buf)
            # Remove source name — buffer ownership transferred, no copy made
            if src in self._variables:
                del self._variables[src]
            if src in self._variable_types:
                del self._variable_types[src]
            self._cleanup_pointers(src)
        elif directive == 'raii':
            self._exec_raii_invoke(node)
        elif directive == 'DEFINE':
            # Transpiler-only hint — no-op at runtime in either interpreter.
            pass
        elif directive == 'debug':
            # `#debug(msg);` — formatted message ALWAYS goes into the
            # devdebug.stdout container (so #console sync works without
            # --debug); stderr printing is gated on --debug.
            val = self._eval(node.get('value')) if node.get('value') else node.get('arg', '')
            msg = '' if val is None else str(val)
            self._push_devdebug_stdout(msg)
            if getattr(self, '_debug_enabled', False):
                import sys as _sys
                _sys.stderr.write(f'[debug] {msg}\n')
                _sys.stderr.flush()
        elif directive == 'trace':
            # `#trace(funcName);` — wrap the function so each call logs.
            if getattr(self, '_debug_enabled', False):
                target = node.get('arg', '').strip() or node.get('var', '')
                self._install_trace(target, node.get('line', 0))
        elif directive == 'catch':
            self._exec_catch_directive(node)
        elif directive == 'stack':
            # #stack[type, bits] var = val; — stack allocation with ctypes buffer
            if not hasattr(self, '_stack_vars'):
                self._stack_vars = {}
            parts = self._split_generic_args(arg)
            vtype = parts[0] if len(parts) > 0 else 'auto'
            max_bits = self._resolve_size(parts[1]) if len(parts) > 1 else 256
            max_bytes = max_bits // 8
            init_value = None
            if node.get('value') is not None:
                # Doc §8.4: `elem = list[i]` is a live-reference. Detect
                # the AST shape and wrap as CsscPointer so subsequent
                # reads dereference live. Explicit `&list[i]` is the
                # snapshot form — that lowers through `copy_of` which
                # evaluates eagerly via the normal _eval path below.
                init_value = self._slot_init_value(node['value'])
            # Copy interception: if source is method-bound, trigger 'copied' before coercion
            _ensure_method_imports()
            if CsscMethodBinding is not None and isinstance(init_value, CsscMethodBinding):
                init_value.trigger_do('copied', None)
                init_value = init_value.get_value()  # unwrap after do {} ran
            # If *var creates a CsscPointer, store it as-is (lazy reference)
            # ONLY when the declared type is auto / dyn / var / explicit pointer form.
            # For scalar POD types (int/float/bool/string) the user asked for a
            # value copy — dereference the pointer eagerly so subsequent
            # `c = c + 5` reads the concrete numeric value, not the wrapper.
            # Bug repro: `#stack[int, 64] c = _v[1]; c = c + 5;` was producing
            # string-concat "205" instead of 25, because CsscPointer.__str__ leaks
            # into the + dispatch. Fix: deref before storing when vtype is scalar.
            _pod_scalar_types = {'int', 'i32', 'i64', 'float', 'f32', 'f64',
                                    'double', 'bool', 'string', 'str', 'char'}
            _wants_pointer_semantics = (
                vtype in ('auto', 'dyn', 'var', '')
                or vtype.startswith('*')
                or vtype.startswith('&')
                or vtype.startswith('vector')
                or vtype.startswith('array')
                or vtype.startswith('map')
                or vtype.startswith('bind')
            )
            if isinstance(init_value, CsscPointer):
                if not _wants_pointer_semantics and \
                        vtype.split('<', 1)[0].strip() in _pod_scalar_types:
                    init_value = self._resolve_value(init_value)
                    if init_value is not None:
                        init_value = self._coerce(init_value, vtype)
                    else:
                        init_value = self._default_for_type(vtype)
                # else: keep CsscPointer — lazy dereference on access
            elif init_value is not None:
                init_value = self._coerce(init_value, vtype)
            else:
                init_value = self._default_for_type(vtype)
            # Callable/pointer/complex references: skip encoding, store directly.
            # Containers (vector/array/map/bind) carry their SECOND #stack arg as
            # a capacity (element count), NOT a scalar bit-limit — so they bypass
            # the byte-encoding bit check too (matches native, where `array<int>,8`
            # means 8 slots, not 8 bits).
            if isinstance(init_value, (CsscPointer, CsscMatrix, CsscLoadedModule,
                                       CsscObject, CsscSector,
                                       CsscVector, CsscArray, CsscMap, CsscBind)):
                buf = ctypes.create_string_buffer(max(max_bytes, 8))
            elif callable(init_value) and not isinstance(init_value, (bool, int, float, str, list, dict)):
                addr_bytes = hex(id(init_value)).encode('utf-8')
                buf = ctypes.create_string_buffer(max(max_bytes, len(addr_bytes)))
                buf.value = addr_bytes
            else:
                encoded = self._encode_value(init_value)
                if len(encoded) > max_bytes:
                    raise CsscError(operation='Runtime',
                                    detail=f'#stack: value exceeds bit limit ({len(encoded) * 8} > {max_bits} bits)',
                                    hint=f'Increase bit limit or reduce value size',
                                    line=node.get('line', 0))
                buf = ctypes.create_string_buffer(max_bytes)
                buf.value = encoded[:max_bytes]
            if isinstance(var, str) and var.lower().startswith('0x'):
                # Hex-keyed variable: bypass string-indexed scope storage entirely.
                hex_id = int(var, 16)
                if not hasattr(self, '_hex_vars'):
                    self._hex_vars = {}
                self._hex_vars[hex_id] = {
                    'value': init_value, 'type': vtype, 'max_bits': max_bits, 'buffer': buf,
                }
            else:
                self._variables[var] = init_value
                self._variable_types[var] = vtype
                self._stack_vars[var] = {'type': vtype, 'max_bits': max_bits, 'buffer': buf, 'region': 'stack'}
                self._update_address_map(var, buf)
        elif directive == 'heap':
            # #heap[type, bits] var = val; — heap allocation, auto-destructed
            if not hasattr(self, '_heap_vars'):
                self._heap_vars = {}
            parts = self._split_generic_args(arg)
            vtype = parts[0] if len(parts) > 0 else 'auto'
            max_bits = self._resolve_size(parts[1]) if len(parts) > 1 else 1024
            max_bytes = max_bits // 8
            init_value = None
            if node.get('value') is not None:
                init_value = self._eval(node['value'])
            # Copy interception: if source is method-bound, trigger 'copied' before coercion
            _ensure_method_imports()
            if CsscMethodBinding is not None and isinstance(init_value, CsscMethodBinding):
                init_value.trigger_do('copied', None)
                init_value = init_value.get_value()  # unwrap after do {} ran
            # Same eager-deref fix as #stack: for scalar POD vtypes,
            # dereference a CsscPointer at init to keep subsequent arithmetic
            # in the numeric type domain.
            _heap_pod_scalar_types = {'int', 'i32', 'i64', 'float', 'f32',
                                          'f64', 'double', 'bool', 'string',
                                          'str', 'char'}
            _heap_wants_ptr = (
                vtype in ('auto', 'dyn', 'var', '')
                or vtype.startswith('*') or vtype.startswith('&')
                or vtype.startswith('vector') or vtype.startswith('array')
                or vtype.startswith('map') or vtype.startswith('bind')
            )
            if isinstance(init_value, CsscPointer):
                if not _heap_wants_ptr and \
                        vtype.split('<', 1)[0].strip() in _heap_pod_scalar_types:
                    init_value = self._resolve_value(init_value)
                    if init_value is not None:
                        init_value = self._coerce(init_value, vtype)
                    else:
                        init_value = self._default_for_type(vtype)
                # else: keep CsscPointer for lazy semantics
            elif init_value is not None:
                init_value = self._coerce(init_value, vtype)
            else:
                init_value = self._default_for_type(vtype)
            if isinstance(init_value, (CsscMatrix, CsscLoadedModule, CsscObject, CsscSector)):
                buf = ctypes.create_string_buffer(8)
                self._variables[var] = init_value
                self._variable_types[var] = vtype
                self._heap_vars[var] = {'type': vtype, 'max_bits': max_bits, 'buffer': buf}
            else:
                encoded = self._encode_value(init_value)
                if len(encoded) > max_bytes:
                    raise CsscError(operation='Runtime',
                                    detail=f'#heap: value exceeds bit limit ({len(encoded) * 8} > {max_bits} bits)',
                                    hint=f'Increase bit limit or reduce value size',
                                    line=node.get('line', 0))
                buf = ctypes.create_string_buffer(max_bytes)
                buf.value = encoded[:max_bytes]
                self._variables[var] = init_value
                self._variable_types[var] = vtype
                self._heap_vars[var] = {'type': vtype, 'max_bits': max_bits, 'buffer': buf}
            self._update_address_map(var, buf)
        elif directive == 'auto':
            # #auto[type] var = val; — auto-sized stack allocation, manual delete
            if not hasattr(self, '_auto_vars'):
                self._auto_vars = {}
            vtype = arg if arg else 'auto'
            init_value = None
            if node.get('value') is not None:
                init_value = self._eval(node['value'])
            if init_value is not None:
                init_value = self._coerce(init_value, vtype)
            else:
                init_value = self._default_for_type(vtype)
            encoded = self._encode_value(init_value)
            buf_size = max(len(encoded), 32)
            buf = ctypes.create_string_buffer(buf_size)
            buf.value = encoded[:buf_size]
            self._variables[var] = init_value
            self._variable_types[var] = vtype
            self._auto_vars[var] = {'type': vtype, 'max_bits': buf_size * 8, 'buffer': buf, 'region': 'heap'}
            self._update_address_map(var, buf)
        elif directive in ('peekstack', 'peekheap'):
            # #peekstack[var, typeResult, index, amount] result_var; — peek into collection, stack alloc (needs #delete)
            # #peekheap[var, typeResult, index, amount] result_var; — peek into collection, heap alloc (auto-managed)
            peek_type = node.get('peek_type', 'auto')
            source_var = node.get('peek_source', '')
            idx_expr = node.get('peek_index', '0')
            amount_expr = node.get('peek_amount', '1')
            # Resolve index and amount
            try:
                idx = int(self._eval({'type': 'identifier', 'name': idx_expr}) if not idx_expr.lstrip('-').isdigit() else int(idx_expr))
            except Exception:
                idx = int(idx_expr) if idx_expr.lstrip('-').isdigit() else 0
            try:
                amount = int(self._eval({'type': 'identifier', 'name': amount_expr}) if not amount_expr.lstrip('-').isdigit() else int(amount_expr))
            except Exception:
                amount = int(amount_expr) if amount_expr.lstrip('-').isdigit() else 1
            # Get source collection
            source = self._variables.get(source_var)
            if source is None:
                raise CsscError(operation='Runtime',
                                detail=f'#{directive}: source variable \'{source_var}\' not found',
                                line=node.get('line', 0))
            if not isinstance(source, (list, tuple, str)):
                raise CsscError(operation='Runtime',
                                detail=f'#{directive}: source \'{source_var}\' is not a collection (got {type(source).__name__})',
                                line=node.get('line', 0))
            # Peek: extract elements from idx with given amount (positive=forward, negative=backward)
            if amount >= 0:
                result = source[idx:idx + amount] if idx < len(source) else []
            else:
                start = max(0, idx + amount)
                result = source[start:idx] if idx <= len(source) else []
            # Single element if amount is 1 or -1
            if abs(amount) == 1:
                result = result[0] if result else None
            # Coerce to requested type
            if peek_type != 'auto' and result is not None:
                result = self._coerce(result, peek_type)
            self._variables[var] = result
            self._variable_types[var] = peek_type
            if directive == 'peekstack':
                if not hasattr(self, '_stack_vars'):
                    self._stack_vars = {}
                encoded = self._encode_value(result)
                buf = ctypes.create_string_buffer(max(len(encoded), 32))
                buf.value = encoded[:len(buf)]
                self._stack_vars[var] = {'type': peek_type, 'max_bits': len(buf) * 8, 'buffer': buf, 'region': 'stack'}
                self._update_address_map(var, buf)
            else:
                if not hasattr(self, '_heap_vars'):
                    self._heap_vars = {}
                encoded = self._encode_value(result)
                buf = ctypes.create_string_buffer(max(len(encoded), 32))
                buf.value = encoded[:len(buf)]
                self._heap_vars[var] = {'type': peek_type, 'max_bits': len(buf) * 8, 'buffer': buf, 'region': 'heap'}
                self._update_address_map(var, buf)
        elif directive == 'resize':
            # #resize[var, +/-bits] — resize allocation
            parts = self._split_generic_args(arg)
            target_var = parts[0] if len(parts) > 0 else ''
            delta_bits = self._resolve_size(parts[1]) if len(parts) > 1 else 0
            # Resolve CsscPointer refs: if target_var holds a pointer, follow it
            val = self._variables.get(target_var)
            if isinstance(val, CsscPointer):
                target_var = val.name
            # Also search parent scopes for the alloc info
            found_in = None
            if hasattr(self, '_stack_vars') and target_var in self._stack_vars:
                found_in = self._stack_vars
            elif hasattr(self, '_heap_vars') and target_var in self._heap_vars:
                found_in = self._heap_vars
            elif hasattr(self, '_auto_vars') and target_var in self._auto_vars:
                found_in = self._auto_vars
            # Check parent scopes' alloc stores (for refs from #scanp inside #define)
            if found_in is None and hasattr(self, '_parent_scopes'):
                for ps in reversed(self._parent_scopes):
                    for sv in ('_stack_vars', '_heap_vars', '_auto_vars'):
                        store = getattr(self, sv, None)
                        if store and target_var in store:
                            found_in = store
                            break
                    if found_in:
                        break
            if found_in is None:
                raise CsscError(operation='Runtime',
                                detail=f'#resize: "{target_var}" is not a #stack, #heap, or #auto variable',
                                line=node.get('line', 0))
            info = found_in[target_var]
            new_bits = info['max_bits'] + delta_bits
            if new_bits <= 0:
                raise CsscError(operation='Runtime',
                                detail=f'#resize: resulting size would be {new_bits} bits (must be > 0)',
                                line=node.get('line', 0))
            new_bytes = new_bits // 8
            old_buf = info['buffer']
            old_data = old_buf.raw[:min(ctypes.sizeof(old_buf), new_bytes)]
            new_buf = ctypes.create_string_buffer(new_bytes)
            new_buf[:len(old_data)] = old_data
            self._update_address_map(target_var, None, remove=True)
            info['max_bits'] = new_bits
            info['buffer'] = new_buf
            self._update_address_map(target_var, new_buf)
        elif directive == 'clock':
            # #clock[milliseconds] — pause execution for given duration
            ms = self._resolve_size(arg) if arg else 0
            if ms > 0:
                time.sleep(ms / 1000.0)
        elif directive == 'cast':
            # #cast[source, target] result; — explicit type cast
            # target must be an existing #heap variable with correct size
            parts = self._split_generic_args(arg)
            if len(parts) < 2:
                raise CsscError(operation='Runtime',
                                detail='#cast requires two arguments: #cast[source, target] result;',
                                line=node.get('line', 0))
            source_name = parts[0].strip()
            target_name = parts[1].strip()
            # Get source value
            if source_name in self._variables:
                source_val = self._variables[source_name]
            else:
                try:
                    expr_tokens = CsscLexer(source_name + ';', '<cast>').tokenize()
                    expr_ast = CsscParser(expr_tokens, '<cast>').parse()
                    if expr_ast:
                        n = expr_ast[0]
                        source_val = self._eval(n.get('expr', n) if n.get('type') == 'expr_stmt' else n)
                    else:
                        raise CsscError(operation='Runtime',
                                        detail=f'#cast: unknown source "{source_name}"',
                                        line=node.get('line', 0))
                except CsscError:
                    raise
                except Exception:
                    raise CsscError(operation='Runtime',
                                    detail=f'#cast: cannot resolve source "{source_name}"',
                                    line=node.get('line', 0))
            # Target must be an existing #heap variable
            if not hasattr(self, '_heap_vars') or target_name not in self._heap_vars:
                raise CsscError(operation='Runtime',
                                detail=f'#cast: target "{target_name}" must be an existing #heap variable',
                                hint='Declare with #heap[type, bits] first',
                                line=node.get('line', 0))
            target_type = self._variable_types.get(target_name, 'auto')
            target_info = self._heap_vars[target_name]
            # #cast is EXPLICIT type conversion — always coerce, no strict type check
            cast_val = False
            try:
                from includecpp.core.cssl.cssl_binary import Binary
                if isinstance(source_val, Binary):
                    b = CsscBinaryModule()._get_binary()
                    cast_val = b.frombinary(source_val, target_type)
                else:
                    cast_val = self._coerce(source_val, target_type)
            except (CsscError, Exception):
                cast_val = False
            # Check size fits
            if cast_val is not False:
                encoded = self._encode_value(cast_val)
                max_bytes = target_info['max_bits'] // 8
                if len(encoded) > max_bytes:
                    raise CsscError(operation='Runtime',
                                    detail=f'#cast: result size ({len(encoded) * 8} bits) exceeds target capacity ({target_info["max_bits"]} bits)',
                                    hint=f'Use #resize[{target_name}, {len(encoded) * 8 - target_info["max_bits"]}] first',
                                    line=node.get('line', 0))
                self._variables[target_name] = cast_val
                target_info['buffer'] = ctypes.create_string_buffer(max_bytes)
                target_info['buffer'].value = encoded[:max_bytes]
            # Store result in var if provided
            if var:
                self._variables[var] = cast_val
                self._variable_types[var] = target_type if cast_val is not False else 'bool'
        else:
            # v5.2: Check custom hash operations from cproject mods
            if hasattr(self, '_custom_hash_ops') and directive in self._custom_hash_ops:
                op_info = self._custom_hash_ops[directive]
                cb = op_info.get('callback')
                if callable(cb):
                    # Parse and evaluate args from the directive arg string
                    call_args = []
                    if arg:
                        for a in self._split_generic_args(arg):
                            a = a.strip()
                            # Try to evaluate as expression (handles func calls, vars, etc.)
                            try:
                                expr_tokens = CsscLexer(a + ';', '<arg>').tokenize()
                                expr_ast = CsscParser(expr_tokens, '<arg>').parse()
                                if expr_ast and len(expr_ast) > 0:
                                    node_a = expr_ast[0]
                                    if node_a.get('type') == 'expr_stmt':
                                        call_args.append(self._eval(node_a.get('expr', node_a)))
                                    else:
                                        call_args.append(self._eval(node_a))
                                else:
                                    call_args.append(a.strip('"').strip("'"))
                            except Exception:
                                a = a.strip('"').strip("'")
                                if a in self._variables:
                                    call_args.append(self._variables[a])
                                else:
                                    call_args.append(a)
                    result = cb(*call_args)
                    if var and result is not None:
                        self._variables[var] = result
            else:
                raise CsscError(operation='Runtime',
                                detail=f'Unknown directive "#{directive}"',
                                hint=f'Check spelling or ensure the required module/extension is loaded',
                                line=node.get('line', 0))

    @staticmethod
    def _encode_value(value):
        """Encode a Python value to bytes for ctypes buffer storage.

        Numeric values are packed as fixed-width binary (8 bytes each) so
        float precision artifacts like 17.579999999999984 don't blow the bit
        limit of a user-declared #stack[float, 64] slot.
        """
        import struct as _struct
        if isinstance(value, CsscPointer):
            return str(value).encode('utf-8')
        elif isinstance(value, str):
            return value.encode('utf-8')
        elif isinstance(value, bool):
            return b'\x01' if value else b'\x00'
        elif isinstance(value, int):
            # Minimal signed-bytes encoding so small values fit in a tight
            # #stack[int, 32] slot. +8 accounts for the sign bit.
            nbytes = max(1, (value.bit_length() + 8) // 8)
            try:
                return value.to_bytes(nbytes, 'little', signed=True)
            except OverflowError:
                return value.to_bytes(nbytes + 1, 'little', signed=True)
        elif isinstance(value, float):
            return _struct.pack('<d', value)
        elif isinstance(value, (list, tuple, dict)):
            import json as _json
            def _sanitize(v):
                if isinstance(v, CsscPointer):
                    return repr(v)
                if isinstance(v, CsscFunction):
                    return repr(v)
                if isinstance(v, tuple):
                    return [_sanitize(x) for x in v]
                if isinstance(v, list):
                    return [_sanitize(x) for x in v]
                if isinstance(v, dict):
                    return {str(k): _sanitize(val) for k, val in v.items()}
                return v
            return _json.dumps(_sanitize(value)).encode('utf-8')
        elif isinstance(value, CsscFunction):
            return str(value).encode('utf-8')
        return str(value).encode('utf-8') if value is not None else b''

    def _cleanup_pointers(self, deleted_name: str):
        """Nullify all CsscPointer references to deleted_name — in containers AND direct variables.
        Replaces with None (dangling → 0x0) instead of removing, preserving indices.

        Subclass preservation: a list comprehension would build a plain
        Python `list` and drop the CsscBind subclass (along with its
        `pair_width`). Iterate in place and only rebuild a fresh
        plain list when the value is a vanilla list AND contains a
        matching CsscPointer; CsscBind values are scanned but written
        in place to keep their type.
        """
        for vname, vval in list(self._variables.items()):
            if isinstance(vval, CsscPointer) and vval.name == deleted_name:
                self._variables[vname] = None
            elif isinstance(vval, CsscBind):
                for _ix in range(list.__len__(vval)):
                    _p = list.__getitem__(vval, _ix)
                    if isinstance(_p, CsscPointer) and _p.name == deleted_name:
                        list.__setitem__(vval, _ix, None)
                    elif isinstance(_p, tuple):
                        if any(isinstance(_c, CsscPointer)
                                and _c.name == deleted_name
                                for _c in _p):
                            list.__setitem__(vval, _ix,
                                tuple(None if (isinstance(_c, CsscPointer)
                                                and _c.name == deleted_name)
                                      else _c for _c in _p))
            elif isinstance(vval, list):
                if any(isinstance(x, CsscPointer) and x.name == deleted_name
                       for x in vval):
                    self._variables[vname] = [
                        None if (isinstance(x, CsscPointer) and x.name == deleted_name) else x
                        for x in vval
                    ]
            elif isinstance(vval, dict):
                for k, v in vval.items():
                    if isinstance(v, CsscPointer) and v.name == deleted_name:
                        vval[k] = None

    def _slot_init_value(self, value_node):
        """Evaluate a slot-init RHS with v5-ref-by-default semantics.

        Per Doc §8.4 an indexed access `container[i]` in a slot init is
        a *live reference* — mutations to `container[i]` propagate to
        the slot. The explicit-copy form is `&container[i]` which lowers
        through a `copy_of` AST node and falls through to eager eval.

        Anything else uses the normal eager `_eval` path.
        """
        if isinstance(value_node, dict):
            t = value_node.get('type')
            if t == 'index':
                obj_node = value_node.get('object', {})
                idx_node = value_node.get('index')
                if isinstance(obj_node, dict) and obj_node.get('type') == 'identifier':
                    src = obj_node.get('name', '')
                    if src in self._variables:
                        idx = self._eval(idx_node)
                        return CsscPointer(src, idx)
        return self._eval(value_node)

    def _resolve_value(self, val):
        """If val is a CsscPointer, resolve LIVE to the actual variable value.
        Supports indexed pointers: *var[index] resolves to var[index] at access time."""
        if isinstance(val, CsscPointer):
            result = self._variables.get(val.name)
            if result is None and hasattr(self, '_parent_scopes'):
                for scope in reversed(self._parent_scopes):
                    if val.name in scope:
                        result = scope[val.name]
                        break
            # Apply index if present — live resolution
            if val.index is not None and result is not None:
                idx = val.index
                if isinstance(result, CsscFunction):
                    # func[0] = last return value
                    if idx == 0 or idx == 'value':
                        return result._last_return
                elif isinstance(result, (list, dict)):
                    try:
                        return result[idx]
                    except (IndexError, KeyError):
                        return None
                elif hasattr(result, '__getitem__'):
                    try:
                        return result[idx]
                    except Exception:
                        return None
            return result
        return val

    def _update_address_map(self, var: str, buf=None, remove: bool = False):
        """Keep _address_map in sync: maps real ctypes addresses to variable names."""
        if not hasattr(self, '_address_map'):
            self._address_map = {}
        if remove:
            to_del = [addr for addr, vname in self._address_map.items() if vname == var]
            for addr in to_del:
                del self._address_map[addr]
        elif buf is not None:
            self._address_map[ctypes.addressof(buf)] = var

    def _resolve_address(self, addr_expr: str) -> int:
        """Resolve an address expression: hex literal, variable name, or variable value."""
        # Try as variable name first
        if addr_expr in self._variables:
            addr_val = self._variables[addr_expr]
        else:
            addr_val = addr_expr
        if isinstance(addr_val, str) and addr_val.lower().startswith('0x'):
            return int(addr_val, 16)
        return int(addr_val)

    def _resolve_size(self, s):
        """Resolve a size argument: plain int, variable name, or ns::member."""
        s = s.strip()
        # Plain integer (possibly negative for resize)
        if s.lstrip('-').isdigit():
            return int(s)
        # Namespace access: sz::normal_string
        if '::' in s:
            ns, member = s.split('::', 1)
            mod = self._modules.get(ns) or self._variables.get(ns)
            if mod and isinstance(mod, CsscModule):
                val = mod.get_namespace().get(member)
                if val is not None:
                    return int(val)
            raise CsscError(operation='Runtime', detail=f'Cannot resolve size: {s}')
        # Variable name
        val = self._variables.get(s)
        if val is not None:
            return int(val)
        raise CsscError(operation='Runtime', detail=f'Cannot resolve size: {s}')

    def _exec_define(self, node: dict):
        """#define(varName) { ... } — bind a callback (no params) to a variable."""
        target = node['target']
        body = node['body']
        def _callback(*_args):
            if not hasattr(self, '_call_args_stack'):
                self._call_args_stack = []
            self._call_args_stack.append((target, _args))
            # Scope isolation: save global vars, create clean local scope
            saved_vars = self._variables.copy()
            saved_types = self._variable_types.copy()
            # Store parent scope so #req can access globals
            if not hasattr(self, '_parent_scopes'):
                self._parent_scopes = []
            self._parent_scopes.append(saved_vars)
            # Start with empty scope — only #req will add globals
            local_scope = {target: saved_vars.get(target)}
            self._variables = local_scope
            self._variable_types = {}
            if target in saved_types:
                self._variable_types[target] = saved_types[target]
            # Spec §6.1: inside `#define(Sec->fn)` bodies, sector
            # members are addressable BARE (`frame_index` not just
            # `World->frame_index`). The native backend already does
            # this via `_bind_sector_members`; the interpreter needs
            # the same. Find the owning sector from the target
            # prefix and inject every member into the local scope as
            # a write-through alias. Mutations propagate back to the
            # sector's `_vars` dict on exit.
            sector_owner = None
            sector_member_snapshot: Dict[str, Any] = {}
            if '->' in target:
                _sec_name = target.split('->', 1)[0].strip()
                _candidate = (saved_vars.get(_sec_name)
                              or getattr(self, '_modules', {}).get(_sec_name))
                if _candidate is None:
                    for _s in getattr(self, '_sectors', []) or []:
                        if getattr(_s, '_name', None) == _sec_name:
                            _candidate = _s
                            break
                if isinstance(_candidate, CsscSector):
                    sector_owner = _candidate
                    for _mn, _mv in sector_owner._vars.items():
                        # Don't shadow the function name itself
                        # (handled by `target` injection above).
                        if _mn == target.split('->', 1)[1].strip():
                            continue
                        # Don't override anything the parser already
                        # placed in local_scope (callable shadow, etc.).
                        if _mn in local_scope:
                            continue
                        local_scope[_mn] = _mv
                        sector_member_snapshot[_mn] = _mv
            # `mirror value;` vs `return value;` — both produce the
            # function's return value, BUT differ in what happens
            # afterwards:
            #
            #   * `return value;` — HARD short-circuit. Body aborts.
            #     Cleanup statements after the `return` are SKIPPED.
            #     Use this when there's nothing left to clean up.
            #
            #   * `mirror value;` — captures the return value AND
            #     keeps running the remaining body. The trailing
            #     `#delete[copied]` / `#free[X]` etc. still execute.
            #     Default is REF (v6 ownership): if `value` is a
            #     bare slot name, the outer capture stays live-
            #     linked — deleting the inner slot in the rest of
            #     the body invalidates the outer to `0x0`.
            #   * `mirror &value;` — explicit DEEP-COPY. Snapshot
            #     wins; later body deletes don't affect outer.
            #
            # Implementation: per-stmt try/except. `mirror` raises
            # `_MirrorSignal`; we catch it at the stmt level (aborts
            # the current stmt path, e.g. inside an if-body) but the
            # outer FOR loop keeps walking. `return` raises
            # `_ReturnSignal` which short-circuits the body normally.
            mirror_value = _UNSET = object()
            mirror_ref_source = None
            try:
                for stmt in body:
                    try:
                        self._exec_node(stmt)
                    except _MirrorSignal as _m:
                        # First mirror wins; subsequent mirrors are
                        # ignored. Body keeps walking — cleanup runs.
                        if mirror_value is _UNSET:
                            mirror_value = _m.value
                            if _m.is_ref and _m.ref_source:
                                mirror_ref_source = _m.ref_source
            except _ReturnSignal as r:
                if r.source_var:
                    if not hasattr(self, '_return_transfers'):
                        self._return_transfers = []
                    for _sv in ('_stack_vars', '_auto_vars', '_heap_vars'):
                        _store = getattr(self, _sv, None)
                        if _store and r.source_var in _store:
                            self._return_transfers.append((_sv, r.source_var, _store.pop(r.source_var)))
                            break
                mirror_value = r.value
                mirror_ref_source = None
            finally:
                # Live-ref re-fetch: if mirror was a bare-slot ref
                # AND that slot still exists at body-end → use its
                # current value (may have been mutated by post-mirror
                # statements). If the slot was deleted, the outer
                # capture becomes `0x0` per spec.
                if mirror_ref_source is not None:
                    if mirror_ref_source in self._variables:
                        mirror_value = self._variables[mirror_ref_source]
                    else:
                        mirror_value = 0    # 0x0 per spec
                self._call_args_stack.pop()
                # Spec §6.1: write back mutated sector members so the
                # body's `frame_index = frame_index + 1;` actually
                # updates the sector's state across calls. Compare
                # the snapshot taken at body entry to the current
                # local scope; propagate any changed cells.
                if sector_owner is not None:
                    for _mn, _old in sector_member_snapshot.items():
                        _new = self._variables.get(_mn, _old)
                        if _new is not _old:
                            sector_owner._vars[_mn] = _new
                # Restore global scope, propagate #req *ref changes back
                if hasattr(self, '_ref_links'):
                    for local_name, global_name in list(self._ref_links.items()):
                        if local_name in self._variables:
                            new_val = self._variables[local_name]
                            # Sector member ref: "sectorName->member"
                            if '->' in global_name:
                                parts = global_name.split('->', 1)
                                sn, mn = parts[0].strip(), parts[1].strip()
                                # Write back to sector object
                                for scope in ([saved_vars] + (self._parent_scopes if hasattr(self, '_parent_scopes') else [])):
                                    if sn in scope and isinstance(scope[sn], CsscSector):
                                        scope[sn]._vars[mn] = new_val
                                        break
                            else:
                                if global_name in saved_vars:
                                    saved_vars[global_name] = new_val
                                # Propagate through ALL ancestor scopes
                                if hasattr(self, '_parent_scopes'):
                                    for ps in reversed(self._parent_scopes):
                                        if global_name in ps:
                                            ps[global_name] = new_val
                self._variables = saved_vars
                self._variable_types = saved_types
                if hasattr(self, '_parent_scopes') and self._parent_scopes:
                    self._parent_scopes.pop()
            # Prefer the mirror/return-captured value; fall back to
            # the function-slot's last write (legacy compat with
            # `funcname = value;` style assignment-as-return).
            if mirror_value is not _UNSET:
                return mirror_value
            return self._variables.get(target)
        is_fvar = hasattr(self, '_fvar_names') and target in self._fvar_names
        alloc_bits = None
        for _sv in ('_stack_vars', '_heap_vars'):
            _store = getattr(self, _sv, None)
            if _store and target in _store:
                alloc_bits = _store[target].get('max_bits')
                break
        # #auto is auto-sizing — no overflow check
        func = CsscFunction(_callback, name=target, is_fvar=is_fvar,
                            max_bits=alloc_bits, encode_fn=self._encode_value)
        func._body = body  # Store AST for #redefine support
        # Sector member define: #define(sector->member) { ... }
        if '->' in target:
            parts = target.split('->', 1)
            sector_name, member_name = parts[0].strip(), parts[1].strip()
            sector_obj = self._variables.get(sector_name)
            if isinstance(sector_obj, CsscSector):
                sector_obj._vars[member_name] = func
                sector_obj._public.add(member_name)
            elif getattr(self, '_building_sector', None) == sector_name:
                # Inside sector body — register directly in local scope and mark as public
                self._variables[member_name] = func
                if not hasattr(self, '_sector_public_overrides'):
                    self._sector_public_overrides = set()
                self._sector_public_overrides.add(member_name)
            else:
                raise CsscError(operation='Runtime',
                                detail=f'#define: \'{sector_name}\' is not a sector',
                                line=node.get('line', 0))
        else:
            self._variables[target] = func
        self._defines = getattr(self, '_defines', {})
        self._defines[target] = func

    def _exec_sector(self, node: dict):
        """sector name<type: param, ...> ?label { private: ... public: ... } free { ... }"""
        name = node['name']
        # Deferred init: ?label means don't construct yet — wait for #reserve[label]
        reserve_label = node.get('reserve_label')
        if reserve_label:
            if not hasattr(self, '_deferred_sectors'):
                self._deferred_sectors = {}
            self._deferred_sectors[reserve_label] = node
            return
        # Scope isolation
        saved_vars = self._variables.copy()
        saved_types = self._variable_types.copy()
        saved_stack = {k: v for k, v in getattr(self, '_stack_vars', {}).items()}
        saved_heap = {k: v for k, v in getattr(self, '_heap_vars', {}).items()}
        saved_auto = {k: v for k, v in getattr(self, '_auto_vars', {}).items()}

        self._variables = {}
        self._variable_types = {}
        _saved_building_sector = getattr(self, '_building_sector', None)
        self._building_sector = name
        _saved_public_overrides = getattr(self, '_sector_public_overrides', set())
        self._sector_public_overrides = set()

        # Self-reference: create a LIVE placeholder sector that shares this body's
        # _variables dict. Inner sectors/objects can access the parent via <*name>.
        # The placeholder is finalized into a real CsscSector after the body runs.
        _self_placeholder = CsscSector(
            name, set(), set(),
            self._variables,  # SHARED reference, not a copy
            None, self, {},
        )
        self._variables[name] = _self_placeholder
        # Also expose under saved_vars so inner constructs see it as a parent-scope var
        saved_vars[name] = _self_placeholder

        # Inject generic parameters as private members from outer scope
        # New syntax: <outerVar, innerName> or <outerVar, *innerName> (zero-copy)
        import copy as _copy
        _dep_names = set()
        for p in (node.get('params') or []):
            inner_name = p['param_name']
            source_name = p.get('source_var', p.get('param_type', inner_name))
            is_ref = p.get('is_ref', False)
            # Record the injected alias for sector-isolation enforcement.
            # Module deps (e.g. `<ini>`) live in self._modules, not
            # saved_vars, so the value-injection below is a no-op for them —
            # but the NAME must still be an allowed namespace in the body.
            if inner_name:
                _dep_names.add(inner_name)
            if source_name in saved_vars:
                if is_ref:
                    # Zero-copy: share the same object reference
                    self._variables[inner_name] = saved_vars[source_name]
                else:
                    # Copy: deep copy to isolate
                    try:
                        self._variables[inner_name] = _copy.deepcopy(saved_vars[source_name])
                    except Exception:
                        self._variables[inner_name] = saved_vars[source_name]
                self._variable_types[inner_name] = self._variable_types.get(source_name, 'auto')
                # Copy alloc info if it exists
                for sv, outer_store in (('_stack_vars', saved_stack), ('_heap_vars', saved_heap), ('_auto_vars', saved_auto)):
                    if source_name in outer_store:
                        store = getattr(self, sv, None)
                        if store is not None:
                            store[inner_name] = outer_store[source_name]

        # Execute private body
        for stmt in (node.get('private_body') or []):
            self._exec_node(stmt)
        private_names = set(self._variables.keys()) - {name}  # exclude self-ref

        # Execute public body
        for stmt in (node.get('public_body') or []):
            self._exec_node(stmt)
        public_names = (set(self._variables.keys()) - private_names) | self._sector_public_overrides
        private_names -= self._sector_public_overrides

        self._building_sector = _saved_building_sector
        self._sector_public_overrides = _saved_public_overrides

        # Collect sector vars and alloc info — exclude self-reference placeholder
        sector_vars = {k: v for k, v in self._variables.items() if k != name}
        sector_allocs = {}
        for sv in ('_stack_vars', '_heap_vars', '_auto_vars'):
            store = getattr(self, sv, None)
            if store:
                for vname in list(store.keys()):
                    if vname in sector_vars:
                        sector_allocs[vname] = (sv, store.pop(vname))

        # Restore outer scope
        self._variables = saved_vars
        # Drop the saved_vars[name] self-reference if it was injected (will be re-added below)
        self._variables.pop(name, None)
        self._variable_types = saved_types
        for sv, saved in (('_stack_vars', saved_stack), ('_heap_vars', saved_heap), ('_auto_vars', saved_auto)):
            store = getattr(self, sv, None)
            if store is not None:
                # Only restore keys that were removed by sector body
                for k, v in saved.items():
                    if k not in store:
                        store[k] = v

        # Finalize the placeholder in-place: copy real public/private sets and free_body.
        # Inner sectors that captured the placeholder will see the finalized data.
        _self_placeholder._public = set(public_names)
        _self_placeholder._private = set(private_names)
        _self_placeholder._free_body = node.get('free_body')
        _self_placeholder._alloc_stores = sector_allocs
        # _vars is already shared with sector_vars (was self._variables during build)
        # but we need to remove the self-reference key from it
        _self_placeholder._vars.pop(name, None)
        sector = _self_placeholder
        self._variables[name] = sector
        self._modules[name] = sector

        if not hasattr(self, '_sectors'):
            self._sectors = []
        self._sectors.append(sector)

    def _exec_cdefine(self, node: dict):
        """#cdefine(func, p1, p2) { ... } — callback with named parameters."""
        target = node['target']
        params = node['params']
        body = node['body']
        def _callback(*call_args):
            old_vals = {}
            for i, pname in enumerate(params):
                old_vals[pname] = self._variables.get(pname)
                if i < len(call_args):
                    self._variables[pname] = call_args[i]
            # Also expose positional args via _call_args_stack so that
            # `#scanp(target, type, pos) v;` inside the body can fetch them.
            # Named-param binding and positional access are independent paths;
            # both must work (one resolves by name, the other by index).
            if not hasattr(self, '_call_args_stack'):
                self._call_args_stack = []
            self._call_args_stack.append((target, list(call_args)))
            # `mirror value;` keeps the body running and live-links
            # the outer capture to the slot when `value` is a bare
            # identifier. `mirror &value;` is the explicit snapshot
            # form. See `_exec_define` for the full rationale.
            mirror_value = _UNSET = object()
            mirror_ref_source = None
            try:
                for stmt in body:
                    try:
                        self._exec_node(stmt)
                    except _MirrorSignal as _m:
                        if mirror_value is _UNSET:
                            mirror_value = _m.value
                            if _m.is_ref and _m.ref_source:
                                mirror_ref_source = _m.ref_source
                        # body keeps walking — cleanup runs
            except _ReturnSignal as r:
                mirror_value = r.value
                mirror_ref_source = None
            finally:
                if mirror_ref_source is not None:
                    if mirror_ref_source in self._variables:
                        mirror_value = self._variables[mirror_ref_source]
                    else:
                        mirror_value = 0    # 0x0 per spec
                if self._call_args_stack:
                    self._call_args_stack.pop()
                for pname in params:
                    if old_vals[pname] is None:
                        self._variables.pop(pname, None)
                    else:
                        self._variables[pname] = old_vals[pname]
            if mirror_value is not _UNSET:
                return mirror_value
            return self._variables.get(target)
        alloc_bits = None
        for _sv in ('_stack_vars', '_heap_vars', '_auto_vars'):
            _store = getattr(self, _sv, None)
            if _store and target in _store:
                alloc_bits = _store[target].get('max_bits')
                break
        func = CsscFunction(_callback, name=target,
                            max_bits=alloc_bits, encode_fn=self._encode_value)
        func._body = body
        func._params = params
        self._variables[target] = func
        self._defines = getattr(self, '_defines', {})
        self._defines[target] = func

    def _exec_redefine(self, node: dict):
        """#redefine(funcVar) +<pos> { code } — inject/overwrite function body.
        Mutates the body list in-place so the closure captures the changes."""
        target = node['target']
        new_body = node['body']
        insert_pos = node.get('insert_pos')
        # Resolve the function
        func = self._variables.get(target)
        _ensure_method_imports()
        if CsscMethodBinding is not None and isinstance(func, CsscMethodBinding):
            func = func.get_value()
        if not isinstance(func, CsscFunction):
            raise CsscError(operation='Runtime',
                            detail=f'#redefine: "{target}" is not a function',
                            hint='#redefine can only modify #define/#cdefine functions',
                            line=node.get('line', 0))
        if func._body is None:
            raise CsscError(operation='Runtime',
                            detail=f'#redefine: "{target}" has no modifiable body',
                            line=node.get('line', 0))
        stmts = new_body if isinstance(new_body, list) else [new_body]
        if insert_pos is not None:
            # +<pos>: inject new code at position (in-place mutation)
            pos = int(self._eval(insert_pos))
            pos = max(0, min(pos, len(func._body)))
            for i, s in enumerate(stmts):
                func._body.insert(pos + i, s)
        else:
            # No position: overwrite entirely (in-place mutation)
            func._body.clear()
            func._body.extend(stmts)

    def _exec_qvar(self, node: dict):
        """#qvar(type, expr) varName; — quick variable from expression."""
        vtype = node['vtype']
        expr_str = node['expr_str']
        varname = node['var']
        if expr_str:
            lexer = CsscLexer(expr_str)
            tokens = lexer.tokenize()
            parser = CsscParser(tokens)
            expr = parser._parse_expression()
            val = self._eval(expr)
        else:
            val = None
        self._variables[varname] = self._coerce(val, vtype) if val is not None else None
        self._variable_types[varname] = vtype

    def _exec_gipeo_directive(self, node: dict, directive: str, var: str) -> None:
        """Instantiate a gipeo peripheral from `#<directive>[…] var;`.
        Bracket-parts arrive as strings — each is either a hex/decimal
        literal or an identifier we resolve in scope. Centralized so all
        7 directive variants share one int-coercion path."""
        from .cssl_gipeo import (
            CsscPin, CsscI2C, CsscSPI, CsscUART, CsscADC, CsscPWM, CsscTimer
        )
        parts = node.get('arg_parts', [])

        def _resolve_int(s: str, default: int = 0) -> int:
            s = (s or '').strip()
            if not s:
                return default
            try:
                if s.startswith(('0x', '0X')):
                    return int(s, 16)
                return int(s)
            except ValueError:
                pass
            v = self._variables.get(s)
            if v is None and hasattr(self, '_parent_scopes'):
                for ps in reversed(self._parent_scopes):
                    if s in ps:
                        v = ps[s]
                        break
            try:
                return int(v) if v is not None else default
            except (TypeError, ValueError):
                return default

        if directive == 'pin':
            obj = CsscPin(_resolve_int(parts[0] if parts else '0'))
        elif directive == 'i2c':
            obj = CsscI2C(
                _resolve_int(parts[0] if len(parts) > 0 else '0'),
                _resolve_int(parts[1] if len(parts) > 1 else '0'),
                _resolve_int(parts[2] if len(parts) > 2 else '0'),
            )
        elif directive == 'spi':
            obj = CsscSPI(
                _resolve_int(parts[0] if len(parts) > 0 else '0'),
                _resolve_int(parts[1] if len(parts) > 1 else '0'),
                _resolve_int(parts[2] if len(parts) > 2 else '0'),
                _resolve_int(parts[3] if len(parts) > 3 else '0'),
            )
        elif directive == 'uart':
            obj = CsscUART(
                _resolve_int(parts[0] if len(parts) > 0 else '0'),
                _resolve_int(parts[1] if len(parts) > 1 else '1'),
                _resolve_int(parts[2] if len(parts) > 2 else '3'),
            )
        elif directive == 'adc':
            obj = CsscADC(_resolve_int(parts[0] if parts else '0'))
        elif directive == 'pwm':
            obj = CsscPWM(
                _resolve_int(parts[0] if len(parts) > 0 else '0'),
                _resolve_int(parts[1] if len(parts) > 1 else '5000'),
                _resolve_int(parts[2] if len(parts) > 2 else '8'),
            )
        elif directive == 'timer':
            obj = CsscTimer(
                _resolve_int(parts[0] if len(parts) > 0 else '0'),
                _resolve_int(parts[1] if len(parts) > 1 else '1000'),
            )
        else:
            return
        self._variables[var] = obj
        self._variable_types[var] = directive

    def _exec_http_directive(self, node: dict, directive: str, var: str) -> None:
        """`#get`, `#post`, `#send` desugar to network.http dispatch.

        - `#get[url] var;`              → http::get(url) → var
        - `#post[url] var = body;`      → http::post(url, body) → var
        - `#send[url] body;`            → http::post(url, body) (no capture)

        URLs in the bracket can be string literals (preserved verbatim)
        or identifiers that resolve to a string at runtime."""
        from .cssl_network_http import _build_request, _execute, _DEFAULT_TIMEOUT_S
        url_arg = (node.get('arg') or '').strip()
        # Strip surrounding quotes; otherwise treat as expression text
        # and resolve against scope.
        if (url_arg.startswith('"') and url_arg.endswith('"')) or \
           (url_arg.startswith("'") and url_arg.endswith("'")):
            url = url_arg[1:-1]
        elif url_arg in self._variables:
            url = str(self._variables[url_arg])
        else:
            url = url_arg
        if directive == 'get':
            req = _build_request('GET', url)
            result = _execute(req, _DEFAULT_TIMEOUT_S)
        else:
            # post / send — body is in node['value']
            body_node = node.get('value')
            body = self._eval(body_node) if body_node is not None else ''
            req = _build_request('POST', url, body=body)
            result = _execute(req, _DEFAULT_TIMEOUT_S)
        if var:
            self._variables[var] = result
            self._variable_types[var] = 'map'

    def _push_devdebug_stdout(self, msg: str) -> None:
        """Append `msg` to every loaded `devdebug` module's stdout list.

        Tolerant by design: works whether or not `#include('devdebug')` is
        present (no-op if not loaded), and survives multiple devdebug
        instances loaded under different aliases. Pushes to the same list
        instance that `dev::stdout` exposes via `get_namespace()`, so any
        sync on that ref sees the entry immediately."""
        try:
            from .cssl_devdebug import CsscDevDebugModule
        except Exception:
            return
        for mod in self._modules.values():
            if isinstance(mod, CsscDevDebugModule):
                try:
                    mod.stdout.append(msg)
                except Exception:
                    pass

    def _install_trace(self, target_name: str, line: int = 0):
        """Wrap the named function so each invocation prints args + result.

        Active only when `self._debug_enabled` is True. The wrapping is
        installed in-place on `self._variables[target_name]`.
        """
        import sys as _sys
        original = self._variables.get(target_name)
        if not callable(original):
            _sys.stderr.write(f'[trace] cannot trace "{target_name}": not callable\n')
            return
        if getattr(original, '_cssc_traced', False):
            return  # already wrapped — idempotent
        def _wrapper(*args, **kwargs):
            arg_repr = ', '.join(repr(a) for a in args)
            _sys.stderr.write(f'[trace] {target_name}({arg_repr})\n')
            _sys.stderr.flush()
            try:
                result = original(*args, **kwargs)
            except BaseException as e:
                _sys.stderr.write(f'[trace] {target_name}(...) raised {type(e).__name__}: {e}\n')
                raise
            _sys.stderr.write(f'[trace] {target_name}(...) → {result!r}\n')
            _sys.stderr.flush()
            return result
        _wrapper._cssc_traced = True
        self._variables[target_name] = _wrapper

    def _exec_catch_directive(self, node: dict):
        """`#catch (executable) ?caller { body }` — run executable in a
        try/except. On failure, bind `caller` to '<ErrType>: <msg>' and
        run the body. Body is skipped on success.

        `executable` may be any CSSC expression: a bare function name
        (legacy form, called with no args), a call expression (`fn(a, b)`,
        `obj.method(x)`, `i()`), or any other expression that has side
        effects we want to guard."""
        expr_node = node.get('value')
        target = (node.get('arg') or '').strip()
        caller_name = node.get('caller') or node.get('var') or ''
        body = node.get('body') or []
        # Save any pre-existing `caller` binding so we can restore it after.
        had_caller = caller_name in self._variables
        old_caller = self._variables.get(caller_name)
        try:
            if expr_node is not None:
                # Expression path — covers calls, member chains, identifiers.
                # If the AST is a bare identifier and resolves to a callable,
                # invoke it (legacy `#catch (myfn)` semantics).
                ntype = expr_node.get('type') if isinstance(expr_node, dict) else None
                if ntype in ('identifier', 'ident'):
                    name = expr_node.get('name') or target
                    callee = self._variables.get(name)
                    if callee is None:
                        callee = self._modules.get(name)
                    if callable(callee):
                        callee()
                    elif callee is None:
                        raise CsscError(operation='Runtime',
                                        detail=f'#catch: undefined target "{name}"',
                                        line=node.get('line', 0))
                    # Non-callable identifier — evaluating it has no effect,
                    # treat as success (matches "guard the read" intent).
                else:
                    self._eval(expr_node)
            elif target:
                # Legacy fallback when no AST was attached — bare-name call.
                callee = self._variables.get(target) or self._modules.get(target)
                if callable(callee):
                    callee()
                elif callee is None:
                    raise CsscError(operation='Runtime',
                                    detail=f'#catch: undefined target "{target}"',
                                    line=node.get('line', 0))
            # Success: skip body
        except _MirrorSignal:
            raise
        except _ReturnSignal:
            raise
        except _DestructSignal:
            raise
        except CsscError as e:
            err_str = f'{type(e).__name__}: {e.detail}' if hasattr(e, 'detail') else f'CsscError: {e}'
            if caller_name:
                self._variables[caller_name] = err_str
            for stmt in body:
                self._exec_node(stmt)
        except BaseException as e:
            err_str = f'{type(e).__name__}: {e}'
            if caller_name:
                self._variables[caller_name] = err_str
            for stmt in body:
                self._exec_node(stmt)
        finally:
            if caller_name:
                if had_caller:
                    self._variables[caller_name] = old_caller
                else:
                    self._variables.pop(caller_name, None)

    def _exec_scanp(self, node: dict):
        """#scanp(source, type, pos) varName; — bind a slot to the caller's
        positional argument.

        v5+ ownership rules (Doc §2.5, §4.5):
          * no prefix on varname     → ref (default; shared object)
          * `*varname`               → ref (deprecated explicit marker)
          * `&varname`               → deep-copy (snapshot at scan time)

        Legacy `*type` (asterisk on the TYPE) is still accepted and means
        ref — it predates the v5 flip and reads as the same intent.

        `#scanp_opt` (`def`-module) sets ``optional=True``; missing args
        resolve to null (or an explicit default if one was provided).
        """
        source = node['source']
        vtype = node['vtype']
        pos = int(node['pos'])
        varname = node['var']
        is_optional = bool(node.get('optional'))
        is_copy_var = bool(node.get('is_copy'))      # &varname
        var_prefix = node.get('var_prefix', '')      # '*' or '&' or ''
        # Legacy `*type` (asterisk on the TYPE) — keep parsing but it's just
        # the old way to say "ref". Strip and route the same as default.
        if vtype.startswith('*'):
            vtype = vtype[1:]
        # Pull positional from the live call-args stack.
        call_args = ()
        if hasattr(self, '_call_args_stack'):
            for target_name, args in reversed(self._call_args_stack):
                if target_name == source:
                    call_args = args
                    break
        val = call_args[pos] if pos < len(call_args) else None
        # Default-value fallback for `#scanp(...) v = expr;`.
        if val is None and node.get('default') is not None:
            val = self._eval(node['default'])
            self._variables[varname] = val
            self._variable_types[varname] = vtype
            return
        # Missing arg (`pos` past end of call_args) → silent null, no
        # crash. Classic nullptr: the variable is allocated as null/0x0
        # so the caller can branch on `if (x == null)`. Same shape as
        # `#scanp_opt`; user code can opt into a default via `= expr;`.
        if val is None:
            self._variables[varname] = None
            self._variable_types[varname] = vtype
            return

        if is_copy_var and val is not None:
            # `&varname` — explicit deep-copy snapshot.
            try:
                val = self._deepcopy(val) if hasattr(self, '_deepcopy') \
                    else __import__('copy').deepcopy(val)
            except Exception:
                pass
            if vtype != 'auto':
                val = self._coerce(val, vtype)
            self._variables[varname] = val
            self._variable_types[varname] = vtype
            return

        # Default / *varname → ref. CsscPointers resolve live.
        if val is not None and isinstance(val, CsscPointer):
            resolved = self._resolve_value(val)
            if resolved is None:
                raise CsscError(operation='Runtime',
                                detail=f'Reference *{val.name} points to a deleted or undefined variable',
                                hint=f'Ensure "{val.name}" is not #delete\'d before passing it by reference',
                                line=node.get('line', 0))
            self._variables[varname] = resolved
            self._variable_types[varname] = vtype
            if not hasattr(self, '_ref_links'):
                self._ref_links = {}
            self._ref_links[varname] = val.name
            return
        # Plain value flows in by ref-default (shared object).
        if val is not None and vtype != 'auto':
            val = self._coerce(val, vtype)
        self._variables[varname] = val
        self._variable_types[varname] = vtype

    def _exec_include(self, node: dict):
        module_name = node['module']
        varname = node['var']
        # When no alias was given, varname == ''. Falling through with that
        # empty key would clobber every prior no-alias include (they'd all
        # collide on _modules['']) — so fall back to the module name itself
        # as the storage key. Aliased includes still keep their alias key.
        storage_key = varname or (module_name or '').strip()
        # .cobj — native code library. In interpreter mode we load it via
        # ctypes and wrap it as a CsscLoadedCobj (acts as a sector).
        if isinstance(module_name, str) and module_name.lower().endswith('.cobj'):
            mod = self._load_cobj(module_name, varname)
            if mod is not None:
                self._modules[storage_key] = mod
                if varname:
                    self._variables[varname] = mod
                return
            # Fallback to regular include if loader refused.
        mod = self._load_module(module_name)
        self._modules[storage_key] = mod
        if varname:
            # Only bind the script-visible name when an alias was given;
            # no-alias includes don't expose a variable, just gate directives.
            self._variables[varname] = mod

    def _load_cobj(self, path: str, alias: str):
        """Load a .cobj native library via ctypes. Extracts the embedded DLL
        to a temp path, LoadLibrarys it, and calls cssc_cobj_init. Register
        cleanup so the process-exit hook runs cssc_cobj_cleanup."""
        import os, tempfile, atexit
        try:
            from includecpp.core.cssl.native import cssc_cobj_format as _cf
        except ImportError:
            return None
        resolved = self._resolve_path(path) if hasattr(self, '_resolve_path') else path
        if not resolved or not os.path.isfile(resolved):
            if os.path.isfile(path):
                resolved = path
            else:
                raise CsscError(operation='Runtime',
                                detail=f'#include: .cobj not found: {path}',
                                line=0)
        try:
            name, dll_bytes = _cf.unpack_cobj(resolved)
        except Exception as e:
            raise CsscError(operation='Runtime',
                            detail=f'#include: invalid .cobj {resolved}: {e}',
                            line=0)
        # Write DLL to a temp file and load via ctypes.
        import ctypes
        tmp_dir = tempfile.gettempdir()
        tmp_dll = os.path.join(tmp_dir, f'cssc_cobj_{alias}_{os.getpid()}.dll')
        with open(tmp_dll, 'wb') as f:
            f.write(dll_bytes)
        try:
            lib = ctypes.CDLL(tmp_dll)
        except OSError as e:
            raise CsscError(operation='Runtime',
                            detail=f'#include: LoadLibrary failed on extracted DLL: {e}',
                            line=0)
        # The interpreter can't yet pass its Python scope stack through the C
        # ABI to cssc_cobj_init — that bridge is for compiled hosts only. We
        # surface the .cobj as a plain sector-like value and tell the user.
        mod = CsscLoadedModule(alias, resolved, None, [])
        mod._depend_origin = name
        if not hasattr(self, '_cobj_cleanups'):
            self._cobj_cleanups = []
        self._cobj_cleanups.append((lib, tmp_dll))
        if hasattr(self, '_warn'):
            try:
                self._warn(f"#include('{path}'): .cobj loaded, but native calls are "
                           f"only fully wired in compiled exes. Interpreter mode "
                           f"exposes it as an empty sector.")
            except Exception:
                pass
        return mod

    def _declare_variable(self, var_type: str, name: str, init_value=None):
        if init_value is not None:
            self._variables[name] = self._coerce(init_value, var_type)
        else:
            self._variables[name] = self._default_for_type(var_type)
        self._variable_types[name] = var_type

    def _exec_if(self, node: dict):
        condition = self._eval(node['condition'])
        if self._is_truthy(condition):
            for stmt in node['then']:
                self._exec_node(stmt)
        elif node.get('else'):
            for stmt in node['else']:
                self._exec_node(stmt)

    def _exec_for(self, node: dict):
        # Snapshot the iter-var name so the cleanup step at the bottom
        # can remove it after the loop. Only applies when the `for`
        # header declared a fresh variable (init flagged `for_decl`),
        # NOT when the user wrote `for (i = 0; …)` against an outer
        # slot — that one stays.
        iter_var = None
        init_node = node.get('init')
        if isinstance(init_node, dict) and init_node.get('for_decl'):
            iter_var = init_node.get('target')
        try:
            if init_node:
                self._exec_node(init_node)
            while True:
                if not self._running:
                    break
                if node.get('condition'):
                    cond = self._eval(node['condition'])
                    if not self._is_truthy(cond):
                        break
                try:
                    for stmt in node['body']:
                        self._exec_node(stmt)
                except _BreakSignal:
                    break
                except _ContinueSignal:
                    pass
                except _JumpSignal as js:
                    if js.target is not None:
                        if isinstance(js.target, CsscFunction):
                            js.target()
                        elif callable(js.target):
                            js.target()
                    # No target or after target call: skip to step (like continue)
                if node.get('step'):
                    self._exec_node(node['step'])
        finally:
            # v5 auto-cleanup: drop the for-declared iter var so it
            # cannot leak into the surrounding scope. Mirrors what
            # `select` does for `?label` (see _exec_select).
            if iter_var:
                self._variables.pop(iter_var, None)
                if hasattr(self, '_variable_types'):
                    self._variable_types.pop(iter_var, None)

    def _exec_while(self, node: dict):
        while self._running:
            cond = self._eval(node['condition'])
            if not self._is_truthy(cond):
                break
            try:
                for stmt in node['body']:
                    self._exec_node(stmt)
            except _BreakSignal:
                break
            except _ContinueSignal:
                pass
            except _JumpSignal as js:
                if js.target is not None:
                    if isinstance(js.target, CsscFunction):
                        js.target()
                    elif callable(js.target):
                        js.target()

    def _exec_hex_scope(self, node: dict):
        """`0xAEFF { body }` — persistent, globally-keyed scope.

        The body runs once with an isolated variable frame; the resulting vars
        and `#define`-declared callbacks get stashed in `self._hex_scopes[id]`
        for later `#raii 0xAEFF method()` dispatch. Stays alive until
        `#free[0xAEFF]`.
        """
        hex_id = int(node.get('hex_id', 0))
        if not hasattr(self, '_hex_scopes'):
            self._hex_scopes = {}
        outer_vars = self._variables
        outer_types = self._variable_types
        outer_stack = getattr(self, '_stack_vars', None)
        if not hasattr(self, '_parent_scopes'):
            self._parent_scopes = []
        self._parent_scopes.append(outer_vars)
        self._variables = {}
        self._variable_types = {}
        if outer_stack is not None:
            self._stack_vars = {}
        funcs = {}
        try:
            for stmt in node.get('body', []):
                # Capture #define(name) { … } inside the hex scope as callable entries.
                if isinstance(stmt, dict) and stmt.get('type') == 'define':
                    funcs[stmt.get('target', '')] = stmt
                else:
                    self._exec_node(stmt)
            self._hex_scopes[hex_id] = {
                'vars': dict(self._variables),
                'types': dict(self._variable_types),
                'stack': dict(self._stack_vars) if outer_stack is not None else {},
                'funcs': funcs,
                'freed': False,
            }
        finally:
            if self._parent_scopes and self._parent_scopes[-1] is outer_vars:
                self._parent_scopes.pop()
            self._variables = outer_vars
            self._variable_types = outer_types
            if outer_stack is not None:
                self._stack_vars = outer_stack

    def _exec_raii_invoke(self, node: dict):
        """`#raii 0xAEFF method(args);` — call a method defined inside a hex
        scope, with that scope's vars swapped in for the duration of the call."""
        hex_id = node.get('target_hex')
        if hex_id is None:
            raise CsscError(operation='Runtime',
                            detail='#raii requires a hex target (0xNN)',
                            line=node.get('line', 0))
        scopes = getattr(self, '_hex_scopes', {}) or {}
        scope = scopes.get(hex_id)
        if scope is None or scope.get('freed'):
            raise CsscError(operation='Runtime',
                            detail=f'#raii: hex scope {hex(hex_id)} not found or freed',
                            line=node.get('line', 0))
        method_name = node.get('method', '')
        method_node = scope['funcs'].get(method_name)
        if method_node is None:
            raise CsscError(operation='Runtime',
                            detail=f'#raii: method "{method_name}" not defined in {hex(hex_id)}',
                            line=node.get('line', 0))
        args = [self._eval(a) for a in node.get('args', [])]
        # Swap runtime state onto the hex scope's vars so body-code sees them.
        outer_vars = self._variables
        outer_types = self._variable_types
        outer_stack = getattr(self, '_stack_vars', None)
        if not hasattr(self, '_parent_scopes'):
            self._parent_scopes = []
        self._parent_scopes.append(outer_vars)
        self._variables = scope['vars']
        self._variable_types = scope['types']
        if outer_stack is not None:
            self._stack_vars = scope.get('stack', {})
        try:
            # Execute the #define body — the runtime has no separate
            # call-convention for hex-scope-local funcs; we just re-run the body.
            for stmt in method_node.get('body', []) or []:
                self._exec_node(stmt)
        except _ReturnSignal as r:
            # Return values from raii calls are discarded (cannot assign).
            _ = r.value
        finally:
            # Commit state changes back to the hex-scope storage.
            scope['vars'] = self._variables
            scope['types'] = self._variable_types
            if outer_stack is not None:
                scope['stack'] = self._stack_vars
                self._stack_vars = outer_stack
            if self._parent_scopes and self._parent_scopes[-1] is outer_vars:
                self._parent_scopes.pop()
            self._variables = outer_vars
            self._variable_types = outer_types

    def _exec_private_scope(self, node: dict):
        """Bare `{ ... }` at statement level — isolated variable frame.

        Inside the block, freshly declared variables are invisible to the
        outer scope. Outer variables aren't implicitly visible either —
        they must be pulled in explicitly via `#req[outerVar] localVar;`
        (which walks _parent_scopes). Nothing leaks out, nothing returns.
        """
        body = node.get('body', [])
        outer_vars = self._variables
        outer_types = self._variable_types
        outer_stack = getattr(self, '_stack_vars', None)
        outer_heap = getattr(self, '_heap_vars', None)
        outer_auto = getattr(self, '_auto_vars', None)
        if not hasattr(self, '_parent_scopes'):
            self._parent_scopes = []
        self._parent_scopes.append(outer_vars)
        self._variables = {}
        self._variable_types = {}
        if outer_stack is not None:
            self._stack_vars = {}
        if outer_heap is not None:
            self._heap_vars = {}
        if outer_auto is not None:
            self._auto_vars = {}
        try:
            for stmt in body:
                self._exec_node(stmt)
        finally:
            if self._parent_scopes and self._parent_scopes[-1] is outer_vars:
                self._parent_scopes.pop()
            self._variables = outer_vars
            self._variable_types = outer_types
            if outer_stack is not None:
                self._stack_vars = outer_stack
            if outer_heap is not None:
                self._heap_vars = outer_heap
            if outer_auto is not None:
                self._auto_vars = outer_auto

    def _exec_select(self, node: dict):
        """select (iterable) ?label { body }
        Cursor-based iteration. The body must explicitly raise a select_jump
        signal (jump; / jump++; / !jump; / !jump++;) to advance/rewind the
        cursor. Body completing without a jump exits the loop.
        """
        iterable = self._eval(node['iterable'])
        if iterable is None:
            return
        # Coerce strings/dicts to indexable list of items
        if isinstance(iterable, dict):
            items = list(iterable.values())
        elif isinstance(iterable, str):
            items = list(iterable)
        elif isinstance(iterable, (list, tuple)):
            items = list(iterable)
        else:
            try:
                items = list(iterable)
            except TypeError:
                return
        label = node['label']
        body = node['body']
        cursor = 0
        # Save outer label binding for restore
        had_old = label in self._variables
        old_val = self._variables.get(label)
        # Track cursor per active select label so `label.pos()` in the body
        # can read the current iterator position.
        if not hasattr(self, '_select_cursors'):
            self._select_cursors = {}
        had_old_cursor = label in self._select_cursors
        old_cursor = self._select_cursors.get(label)
        # Safety: cap iterations to prevent infinite loops from malformed jumps
        _max_iter = max(len(items) * 1000, 100000)
        _count = 0
        try:
            while 0 <= cursor < len(items):
                _count += 1
                if _count > _max_iter:
                    raise CsscError(
                        operation='Runtime',
                        detail=f'select: iteration limit exceeded ({_max_iter}). Likely infinite jump loop.',
                        line=node.get('line', 0),
                    )
                self._variables[label] = items[cursor]
                self._select_cursors[label] = cursor
                jumped = False
                try:
                    for stmt in body:
                        self._exec_node(stmt)
                except _SelectJumpSignal as sj:
                    cursor += sj.delta
                    jumped = True
                except _BreakSignal:
                    break
                except _ContinueSignal:
                    cursor += 1
                    jumped = True
                if not jumped:
                    # Body completed without jump → exit loop
                    break
        finally:
            if had_old:
                self._variables[label] = old_val
            else:
                self._variables.pop(label, None)
            if had_old_cursor:
                self._select_cursors[label] = old_cursor
            else:
                self._select_cursors.pop(label, None)

    def _exec_assign(self, node: dict):
        target = node['target']
        if target not in self._variables and not node.get('for_decl'):
            raise CsscError(operation='Runtime',
                            detail=f'Undeclared variable "{target}". Use #VARIABLE[type], #stack, #heap, or #auto to declare variables first.',
                            line=node.get('line', 0))
        # #fvar variables can only be assigned via #define/#cdefine, not direct assignment
        if hasattr(self, '_fvar_names') and target in self._fvar_names:
            raise CsscError(operation='Runtime',
                            detail=f'Cannot directly assign to #fvar variable "{target}"',
                            hint='Use #define({name}) {{ ... }} or #cdefine({name}, ...) {{ ... }} to assign'.format(name=target),
                            line=node.get('line', 0))
        # #param variables can only be set inside #define/#cdefine via #scanp
        if hasattr(self, '_param_names') and target in self._param_names:
            raise CsscError(operation='Runtime',
                            detail=f'Cannot directly assign to #param variable "{target}"',
                            hint='#param variables are populated by #scanp inside #define/#cdefine',
                            line=node.get('line', 0))
        value = self._eval(node['value'])
        # Method binding interception: trigger do {} on assignment
        existing = self._variables.get(target)
        _ensure_method_imports()
        # Source-side: if value is a method-bound variable being copied, trigger 'copied'
        if CsscMethodBinding is not None and isinstance(value, CsscMethodBinding):
            if not isinstance(existing, CsscMethodBinding):
                # Copying into a non-bound target — source gets 'copied' event
                value.trigger_do('copied', None)
            value = value.get_value()
        if CsscMethodBinding is not None and isinstance(existing, CsscMethodBinding):
            existing.set_value(value)  # update value FIRST so do {} sees new value
            existing.trigger_do('assign', value)
            return
        # Iterator assignment: i = int updates index, keeps container binding
        if isinstance(existing, CsscIterator) and isinstance(value, (int, float)):
            existing._index = int(value)
            return
        if isinstance(existing, CsscIterator) and isinstance(value, CsscIterator):
            existing._index = value._index
            return
        if target in self._variable_types:
            self._strict_type_check(value, self._variable_types[target], target, node.get('line', 0))
            value = self._coerce(value, self._variable_types[target])
        self._variables[target] = value
        # Propagate ref assignments: if target is a *ref, write back to original
        if hasattr(self, '_ref_links') and target in self._ref_links:
            orig = self._ref_links[target]
            if orig in self._variables:
                self._variables[orig] = value
            # Also propagate through parent scopes (for #req *ref inside #define)
            if hasattr(self, '_parent_scopes'):
                for ps in reversed(self._parent_scopes):
                    if orig in ps:
                        ps[orig] = value
                        break
        # Auto-realloc for #auto variables
        _auto = getattr(self, '_auto_vars', None)
        if _auto and target in _auto:
            encoded = self._encode_value(value)
            info = _auto[target]
            if len(encoded) > info['max_bits'] // 8:
                new_size = max(len(encoded) * 2, 64)
                info['buffer'] = ctypes.create_string_buffer(new_size)
                info['max_bits'] = new_size * 8
            info['buffer'].value = encoded[:info['max_bits'] // 8]

    def _exec_arrow_assign(self, node: dict):
        obj = self._eval(node['object'])
        key = node['key']
        value = self._eval(node['value'])
        if isinstance(obj, dict):
            obj[key] = value
        elif hasattr(obj, 'set'):
            obj.set(key, value)
        elif hasattr(obj, '__setitem__'):
            obj[key] = value

    def _exec_dot_assign(self, node: dict):
        obj = self._eval(node['object'])
        key = node['key']
        value = self._eval(node['value'])
        # Method binding: unwrap inner value, intercept mutation
        _ensure_method_imports()
        if CsscMethodBinding is not None and isinstance(obj, CsscMethodBinding):
            inner = obj.get_value()
            if isinstance(inner, dict):
                inner[key] = value
            elif hasattr(inner, key):
                setattr(inner, key, value)
            obj.trigger_do('dot_assign', value)
            return
        if isinstance(obj, dict):
            obj[key] = value
        elif hasattr(obj, key):
            setattr(obj, key, value)

    def _exec_index_assign(self, node: dict):
        """arr[i] = value — assign to an index of a list/dict/string."""
        # Chained bind write: `particles[row][col] = value;`. Detect
        # BEFORE the regular eval of `node['object']` which would
        # collapse the inner index into a scalar (CsscBind's
        # `__getitem__` returns flat-cell semantics by default). When
        # the LHS shape is `index_access(index_access(name, row), col)`
        # AND the innermost identifier resolves to a CsscBind with
        # pair_width > 0, we mutate the underlying pair's cell
        # directly — matching the native lowerer's
        # `cssc_bind_entry_pair_cell_set(ent, row, col, val)` semantic.
        inner_obj_node = node.get('object')
        if (isinstance(inner_obj_node, dict)
                and inner_obj_node.get('type') == 'index'):
            innermost = inner_obj_node.get('object')
            if (isinstance(innermost, dict)
                    and innermost.get('type') == 'identifier'):
                _name = innermost.get('name')
                _bv = self._variables.get(_name)
                if (isinstance(_bv, CsscBind)
                        and _bv.pair_width > 0):
                    _row = self._eval(inner_obj_node.get('index'))
                    _col = self._eval(node.get('index'))
                    _val = self._eval(node.get('value'))
                    try:
                        _row_i = int(_row)
                        _col_i = int(_col)
                    except (TypeError, ValueError):
                        raise CsscError(
                            operation='Runtime',
                            detail=(f'bind chained-write `{_name}[row][col]'
                                    f' = …`: row/col must evaluate to int '
                                    f'(got row={type(_row).__name__}, '
                                    f'col={type(_col).__name__})'),
                            line=node.get('line', 0))
                    _n_pairs = list.__len__(_bv)
                    if not (0 <= _row_i < _n_pairs):
                        raise CsscError(
                            operation='Runtime',
                            detail=(f'bind row index {_row_i} out of '
                                    f'range (have {_n_pairs} pairs)'),
                            line=node.get('line', 0))
                    _pair = list.__getitem__(_bv, _row_i)
                    if not (0 <= _col_i < len(_pair)):
                        raise CsscError(
                            operation='Runtime',
                            detail=(f'bind column index {_col_i} out of '
                                    f'range (pair_width={_bv.pair_width})'),
                            line=node.get('line', 0))
                    # Pairs are stored as tuples (immutable) — rebuild
                    # with the new value at the target column and
                    # write back via list.__setitem__ on the CsscBind.
                    _new_pair = list(_pair)
                    _new_pair[_col_i] = _val
                    list.__setitem__(_bv, _row_i, tuple(_new_pair))
                    return
        obj = self._eval(node['object'])
        idx = self._eval(node['index'])
        value = self._eval(node['value'])
        # Method binding: unwrap, intercept
        _ensure_method_imports()
        if CsscMethodBinding is not None and isinstance(obj, CsscMethodBinding):
            inner = obj.get_value()
            if isinstance(inner, str):
                # String character mutation via binding
                idx = int(idx)
                chars = list(inner)
                if 0 <= idx < len(chars):
                    chars[idx] = str(value) if value is not None else '\x00'
                elif idx >= len(chars):
                    chars.extend(['\x00'] * (idx - len(chars) + 1))
                    chars[idx] = str(value) if value is not None else '\x00'
                obj.set_value(''.join(chars))
                obj.trigger_do('index_assign', value)
                return
            elif isinstance(inner, list):
                idx = int(idx)
                if 0 <= idx < len(inner):
                    inner[idx] = value
                obj.trigger_do('index_assign', value)
                return
        # String character mutation: str[i] = char → immutable → rebuild
        if isinstance(obj, str):
            idx = int(idx)
            var_name = node['object'].get('name') if isinstance(node['object'], dict) else None
            if var_name:
                chars = list(obj)
                if 0 <= idx < len(chars):
                    chars[idx] = str(value) if value is not None else '\x00'
                elif idx >= len(chars):
                    chars.extend(['\x00'] * (idx - len(chars) + 1))
                    chars[idx] = str(value) if value is not None else '\x00'
                new_str = ''.join(chars)
                self._variables[var_name] = new_str
                return
        if isinstance(obj, list):
            idx = int(idx)
            if 0 <= idx < len(obj):
                obj[idx] = value
            else:
                raise CsscError(operation='Runtime',
                                detail=f'Index {idx} out of range (list size: {len(obj)})',
                                line=node.get('line', 0))
        elif isinstance(obj, dict):
            obj[idx] = value
        elif hasattr(obj, '__setitem__'):
            obj[idx] = value
        else:
            # Don't silently swallow assignments to non-container
            # targets. A user that writes `x[0] = 1` where `x` is a
            # scalar (e.g. because `particles[0]` collapsed to a
            # cell rather than a row) was previously getting a no-op
            # — exactly the silent-no-op the Three-Layer-Safety
            # model exists to avoid. Surface the type mismatch as
            # an explicit runtime error so the user can either fix
            # the LHS or learn about the chained-bind shape rule.
            _name = (node['object'].get('name')
                     if isinstance(node.get('object'), dict)
                     else '<expr>')
            raise CsscError(
                operation='Runtime',
                detail=(f'indexed write `{_name}[{idx!r}] = …`: target '
                        f'is a {type(obj).__name__} which has no '
                        f'`[]=` operator (silent no-op guard). '
                        f'If you meant chained bind-cell write '
                        f'`bind[row][col] = …`, ensure `{_name}` is a '
                        f'bind slot with pair_width > 0 (`#stack[bind, '
                        f'N] {_name} = {{a, b; c, d}};`). If you meant '
                        f'a scalar update, drop the `[]` and write '
                        f'`{_name} = …;`.'),
                line=node.get('line', 0))

    # -- Expression evaluation ----------------------------------------------
    def _eval_arg(self, a: dict) -> Any:
        """Evaluate a function-call argument with v6 ref-by-default
        semantics.

        Convention (CSSC_Language_Documentation.md §2.5):
          fn(x)    — REFERENCE. `x` is shared with the callee; mutations
                     propagate. `#delete[param]` in the callee deletes
                     the caller's slot too (see `_exec_scanp` +
                     `_delete_cross_frame` for the alias mechanism).
          fn(&x)   — COPY. `&x` evaluates to a deep-copied snapshot;
                     callee mutations do NOT touch the caller's `x`.
          fn(*x)   — legacy alias for ref-pass. The unary `*` handler
                     in `_eval` is a no-op for non-iterator operands.

        The metadata (ref vs. copy + source-slot name) used by
        `_exec_scanp` to decide aliasing lives in
        `_compute_arg_meta` — kept separate so callers can collect
        both the value and the meta in lock-step (see `_eval_call`,
        `_eval_ns_call`, `_eval_method_call`, etc.).
        """
        # `&expr` (copy_of) — eval already deep-copied. Just return.
        if isinstance(a, dict) and a.get('type') == 'copy_of':
            return self._eval(a)
        # `*expr` — legacy ref-prefix. Eval normally; for iterators the
        # unary handler dereferences, for plain identifiers it returns
        # the underlying value (same as bare reference).
        if isinstance(a, dict) and a.get('type') == 'unary' and a.get('op') == '*':
            return self._eval(a)
        # Default: ref-pass. Python list/dict semantics already share
        # the underlying object via reference; CsscObject/CsscSector
        # are class instances, also shared. So just evaluating is
        # enough — no snapshot.
        return self._eval(a)

    # ── v6 ref-by-default arg-metadata pipeline ─────────────────────
    # Each call site computes a `meta` list parallel to the values
    # list. The meta carries (kind, src_name): `kind` is 'ref' or
    # 'copy' (call-site `&` wins), `src_name` is the caller-slot name
    # when the arg was a bare identifier so `_exec_scanp` can register
    # `_ref_links[param] = src_name` and `#delete[param]` can
    # propagate cross-frame.
    #
    # Why a side-channel (`_pending_arg_metas`) instead of changing
    # `_call_args_stack`'s tuple shape: every reader of the stack
    # (`_exec_scanp`, ad-hoc debug paths, the second-runtime mirror)
    # would have to learn the new shape simultaneously. A parallel
    # `_call_args_meta_stack` keeps the legacy stack format intact
    # and lets only the param-binder + delete-handler opt in.

    def _compute_arg_meta(self, a: Any) -> Dict[str, Any]:
        """Inspect a call-arg AST node and return its
        (kind, src_name) metadata. Used by every call-site evaluator
        to populate `self._pending_arg_metas` before the callable
        is invoked.
        """
        if not isinstance(a, dict):
            return {'kind': 'ref', 'src_name': None}
        t = a.get('type')
        if t == 'copy_of':
            # `&expr` — explicit caller-side copy. No alias.
            return {'kind': 'copy', 'src_name': None}
        if t == 'identifier':
            nm = (a.get('name') or '').strip()
            return {'kind': 'ref', 'src_name': nm or None}
        if t == 'unary' and a.get('op') == '*':
            # Legacy `*x` — same as bare ref.
            op = a.get('operand') or {}
            if isinstance(op, dict) and op.get('type') == 'identifier':
                nm = (op.get('name') or '').strip()
                return {'kind': 'ref', 'src_name': nm or None}
            return {'kind': 'ref', 'src_name': None}
        # Expression results, literals, container builders, calls —
        # no slot to alias. Param gets a fresh value; `#delete[param]`
        # cannot propagate.
        return {'kind': 'ref', 'src_name': None}

    def _stash_pending_arg_metas(self, ast_args: List[Any]) -> None:
        """Set `self._pending_arg_metas` for the *next* callable
        invocation. The invoked callback pops it via
        `_consume_pending_arg_metas` when pushing to
        `_call_args_stack`.

        Idempotent: callers that don't go through a user `#define`
        body (e.g. `cssc::outln` builtins) simply leave the stash
        in place; the next user-callable invocation consumes it.
        Pure builtins never read meta, so the stale stash is
        harmless. To be defensive, callers SHOULD overwrite on
        every call boundary.
        """
        self._pending_arg_metas = [self._compute_arg_meta(a)
                                     for a in ast_args]

    def _consume_pending_arg_metas(self,
                                     n_args: int) -> List[Dict[str, Any]]:
        """Return the meta list for the about-to-be-pushed call frame.
        Falls back to all-ref/no-src metas when the stash is missing
        (defensive: a Python-level invocation that bypassed the AST
        evaluators won't have set it; treating those args as plain
        ref with no source slot is the safe default — no alias is
        recorded, `#delete[param]` only kills the local slot).
        """
        metas = getattr(self, '_pending_arg_metas', None)
        self._pending_arg_metas = None
        if metas is None:
            return [{'kind': 'ref', 'src_name': None}
                     for _ in range(n_args)]
        # Pad/truncate to actual call_args length so OOB lookups in
        # `_exec_scanp` are safe.
        if len(metas) < n_args:
            metas = list(metas) + [{'kind': 'ref', 'src_name': None}
                                    for _ in range(n_args - len(metas))]
        elif len(metas) > n_args:
            metas = metas[:n_args]
        return metas

    def _push_call_meta(self, target: str,
                         metas: List[Dict[str, Any]]) -> None:
        """Push `metas` to `_call_args_meta_stack` in lock-step with
        the matching `_call_args_stack.append((target, args))`. Caller
        is responsible for ordering."""
        if not hasattr(self, '_call_args_meta_stack'):
            self._call_args_meta_stack = []
        self._call_args_meta_stack.append((target, metas))

    def _pop_call_meta(self) -> None:
        """Pop the matching meta frame after the callback returns.
        Tolerant of underflow (defensive — should never happen with
        balanced push/pop)."""
        meta_stack = getattr(self, '_call_args_meta_stack', None)
        if meta_stack:
            meta_stack.pop()

    def _lookup_arg_meta(self, source: str,
                          pos: int) -> Optional[Dict[str, Any]]:
        """Find the meta for `source(...)`'s positional arg `pos`.

        Walks `_call_args_meta_stack` newest-to-oldest. Returns the
        meta dict or `None` when no matching frame / pos exists. The
        `source` discriminator matches by callee-slot name so nested
        calls don't pick the wrong frame's metas.
        """
        meta_stack = getattr(self, '_call_args_meta_stack', None)
        if not meta_stack:
            return None
        for tgt, metas in reversed(meta_stack):
            if tgt == source:
                if 0 <= pos < len(metas):
                    return metas[pos]
                return None
        return None

    def _delete_cross_frame(self, name: str) -> bool:
        """`#delete[name]` cross-frame propagation.

        If `name` is a ref-aliased param (registered by `_exec_scanp`
        via `_ref_links[name] = src_name`), this looks up the source
        slot in the parent scope's variable stores and deletes it
        there too. Returns True iff a parent-side delete happened.

        Mechanism: walks `_parent_scopes` newest-to-oldest, removes
        the source name from each frame's `_variables` /
        `_stack_vars` / `_heap_vars` / `_auto_vars` it appears in.
        The local-side cleanup (deleting `name` from the current
        frame) stays in the caller — this helper only handles the
        cross-frame propagation.
        """
        ref_links = getattr(self, '_ref_links', None)
        if not ref_links or name not in ref_links:
            return False
        src = ref_links.get(name)
        if not src:
            return False
        # If the alias chain registered a sector member like
        # `sectorName->member`, write through the sector's _vars
        # dict; that's the v5 #req-style channel. For plain-name
        # aliases we walk parent variable stores.
        if isinstance(src, str) and '->' in src:
            return False  # sector ref-link — left to the #req cleanup path
        parent_scopes = getattr(self, '_parent_scopes', None) or []
        deleted = False
        for ps in reversed(parent_scopes):
            if isinstance(ps, dict) and src in ps:
                ps.pop(src, None)
                deleted = True
        # Also wipe from the parent's typed-store sidecars when present.
        # These are class attributes shared across the interpreter, so
        # we walk them too — defensive: if the variable was deleted
        # from `_variables` but its storage record stuck around, later
        # lookups can revive a stale value (the `0x0` requirement
        # would silently fail).
        for store_attr in ('_stack_vars', '_heap_vars', '_auto_vars'):
            store = getattr(self, store_attr, None)
            if isinstance(store, dict) and src in store:
                store.pop(src, None)
                deleted = True
        # Drop the alias entry itself so re-binds (rare) don't keep
        # propagating to the now-gone parent slot.
        ref_links.pop(name, None)
        return deleted

    # NB: the historical `_copy_for_pass_by_value` helper was removed
    # in v5 — the implicit deep-copy at call-boundary is gone, and the
    # only path that still copies is the explicit `&expr` operator
    # which goes through the `copy_of` AST node + `copy.deepcopy()` in
    # _eval. The runtime API `cssc_copy()` mirrors this on the C side.

    def _eval(self, node: dict) -> Any:
        if node is None:
            return None
        ntype = node.get('type')

        if ntype == 'literal':
            # Hex-literal: first-class identifier for hex-keyed variables. If
            # a declared hex var matches, resolve to its value; else treat as
            # plain integer literal.
            if node.get('is_hex'):
                hex_vars = getattr(self, '_hex_vars', None)
                if hex_vars is not None:
                    entry = hex_vars.get(node['value'])
                    if entry is not None:
                        return entry['value']
            return node['value']
        if ntype == 'string':
            return node['value']
        if ntype == 'null':
            return None
        if ntype == 'array':
            return [self._eval(e) for e in node['elements']]
        if ntype == 'map_literal':
            return {k: self._eval(v) for k, v in node['pairs']}
        if ntype == 'array_literal':
            return [self._eval(e) for e in node['items']]
        if ntype == 'bind_literal':
            # Preserve the source literal's pair width so chained
            # `bind[row][col]` reads return the right cell. Each pair
            # in `node['pairs']` is a list of cell expression nodes —
            # length per pair is the structural width (uneven widths
            # are caught at CIR lowering time; here we mirror what the
            # native runtime stores).
            raw_pairs = node['pairs'] or []
            evaluated = [tuple(self._eval(c) for c in pair)
                          for pair in raw_pairs]
            pair_width = len(evaluated[0]) if evaluated else 0
            return CsscBind(evaluated, pair_width=pair_width)
        if ntype == 'identifier':
            name = node['name']
            # C++ fast path: scalar types stored natively in C++ scope
            if self._accel and self._cpp_scope.has(name):
                t = self._cpp_scope.get_type(name)
                if t == 1: return self._cpp_scope.get_int(name, True)
                if t == 2: return self._cpp_scope.get_float(name, True)
                if t == 3: return self._cpp_scope.get_str(name, True)
                if t == 4: return self._cpp_scope.get_bool(name, True)
            return self._variables.get(name)
        if ntype == 'introspect':
            # alias!property.sub — resolve method introspection
            _ensure_method_imports()
            alias = node['alias']
            binding = self._variables.get(alias)
            if CsscMethodBinding is not None and isinstance(binding, CsscMethodBinding):
                return binding._introspector.resolve(node['prop_path'])
            return None
        if ntype == 'binary':
            return self._eval_binary(node)
        if ntype == 'logical':
            return self._eval_logical(node)
        if ntype == 'load_expr':
            # #load["path"] as expression — returns CsscLoadedModule
            load_path = node.get('load_path', '')
            resolved = self._resolve_path(load_path)
            if not os.path.isfile(resolved):
                raise CsscError(operation='Runtime', detail=f'#load: file not found: {load_path}', line=node.get('line', 0))
            with open(resolved, 'r', encoding='utf-8') as f:
                code = f.read()
            sub_lexer = CsscLexer(code, filename=resolved)
            sub_tokens = sub_lexer.tokenize()
            sub_parser = CsscParser(sub_tokens)
            sub_ast = sub_parser.parse()
            child_rt = CsscRuntime(script_dir=os.path.dirname(os.path.abspath(resolved)))
            child_rt._script_args = getattr(self, '_script_args', None)
            return CsscLoadedModule('_loaded', resolved, child_rt, sub_ast)
        if ntype == 'copy_of':
            import copy as _copy
            return _copy.deepcopy(self._eval(node['operand']))
        if ntype == 'unary':
            return self._eval_unary(node)
        if ntype == 'postfix':
            return self._eval_postfix(node)
        if ntype == 'call':
            return self._eval_call(node)
        if ntype == 'ns_call':
            return self._eval_ns_call(node)
        if ntype == 'member_ns_call':
            mod = self._eval(node['object'])
            func_name = node['func']
            args = [self._eval(a) for a in node['args']]
            if mod is not None and hasattr(mod, 'get_namespace'):
                funcs = mod.get_namespace()
                if func_name in funcs:
                    return funcs[func_name](*args)
            if mod is not None:
                method = getattr(mod, func_name, None)
                if callable(method):
                    return method(*args)
            return None
        if ntype == 'ns_access':
            return self._eval_ns_access(node)
        if ntype == 'method_call':
            return self._eval_method_call(node)
        if ntype == 'dot_call':
            return self._eval_dot_call(node)
        if ntype == 'arrow_access':
            return self._eval_arrow(node)
        if ntype == 'dot_access':
            return self._eval_dot_access(node)
        if ntype == 'index':
            # Detect chained `bind[row][col]` BEFORE the recursive
            # _eval(node['object']) collapses the inner index into a
            # scalar. The pattern is `index_access(index_access(name,
            # row), col)` where the innermost identifier resolves to
            # a CsscBind with pair_width > 0. The native lowerer
            # treats this as one structured read at
            # `pair(row)[col]`; the interpreter must match.
            inner_obj_node = node.get('object')
            if (isinstance(inner_obj_node, dict)
                    and inner_obj_node.get('type') == 'index'):
                innermost = inner_obj_node.get('object')
                if (isinstance(innermost, dict)
                        and innermost.get('type') == 'identifier'):
                    _bv = self._variables.get(innermost.get('name'))
                    if (isinstance(_bv, CsscBind)
                            and _bv.pair_width > 0):
                        _row = self._eval(inner_obj_node.get('index'))
                        _col = self._eval(node.get('index'))
                        try:
                            _row_i = int(_row)
                            _col_i = int(_col)
                        except (TypeError, ValueError):
                            return None
                        _n_pairs = list.__len__(_bv)
                        if 0 <= _row_i < _n_pairs:
                            _pair = list.__getitem__(_bv, _row_i)
                            if 0 <= _col_i < len(_pair):
                                _cell = _pair[_col_i]
                                if isinstance(_cell, CsscPointer):
                                    return self._resolve_value(_cell)
                                return _cell
                        return None
            obj = self._eval(node['object'])
            idx = self._eval(node['index'])
            # String index: str[i] → single character
            if isinstance(obj, str):
                idx = int(idx)
                if 0 <= idx < len(obj):
                    return obj[idx]
                return ''
            # CsscBind: flat-cell indexing. `bind` is conceptually a
            # flat list of N cells (2 per declared pair), so the
            # bounds check is `pair_count * 2`, not `pair_count`.
            # CsscBind.__getitem__ already returns the right cell;
            # we just skip the wrong list-bound check below.
            if isinstance(obj, CsscBind) and isinstance(idx, int):
                cell_count = list.__len__(obj) * 2
                val = obj[idx] if 0 <= idx < cell_count else None
                if isinstance(val, CsscPointer):
                    return self._resolve_value(val)
                return val
            # A plain list whose elements are all 2-tuples is treated
            # as a bind-entry too (the `push_back(localmap)` path stores
            # the CsscBind as a plain Python list of tuples because
            # container insertion doesn't preserve the wrapper class).
            # Flat-cell indexing covers that case transparently —
            # `pair_count * 2` cell positions, even/odd split.
            if (isinstance(obj, list) and isinstance(idx, int) and obj
                    and all(isinstance(p, tuple) and len(p) == 2 for p in obj)):
                cell_count = len(obj) * 2
                if 0 <= idx < cell_count:
                    pair_idx, cell = divmod(idx, 2)
                    val = obj[pair_idx][cell]
                else:
                    val = None
                if isinstance(val, CsscPointer):
                    return self._resolve_value(val)
                return val
            if isinstance(obj, list) and isinstance(idx, int):
                val = obj[idx] if 0 <= idx < len(obj) else None
                # Lazy dereference: resolve CsscPointer stored in containers
                if isinstance(val, CsscPointer):
                    return self._resolve_value(val)
                return val
            if isinstance(obj, dict):
                if idx in obj:
                    val = obj[idx]
                    if isinstance(val, CsscPointer):
                        return self._resolve_value(val)
                    return val
                str_idx = str(idx) if not isinstance(idx, str) else idx
                val = obj.get(str_idx)
                if isinstance(val, CsscPointer):
                    return self._resolve_value(val)
                return val
            # Support __getitem__ for CsscFunction and other custom objects
            if hasattr(obj, '__getitem__'):
                try:
                    return obj[idx]
                except (KeyError, IndexError, TypeError):
                    return None
            return None
        return None

    _BINOP_MAP = {'+': 0, '-': 1, '*': 2, '/': 3, '%': 4, '**': 5, '//': 6,
                  '==': 10, '!=': 11, '<': 12, '>': 13, '<=': 14, '>=': 15}

    def _eval_binary(self, node: dict) -> Any:
        left = self._eval(node['left'])
        right = self._eval(node['right'])
        op = node['op']
        # Unwrap method bindings to their raw values for arithmetic
        _ensure_method_imports()
        if CsscMethodBinding is not None:
            if isinstance(left, CsscMethodBinding):
                left = left.get_value()
            if isinstance(right, CsscMethodBinding):
                right = right.get_value()
        # C++ fast path for numeric binary ops
        if self._accel and isinstance(left, (int, float)) and isinstance(right, (int, float)):
            code = self._BINOP_MAP.get(op)
            if code is not None:
                if code >= 10:  # comparison ops
                    return _cssc_accel_mod.compare_num(float(left), float(right), code - 10)
                elif isinstance(left, int) and isinstance(right, int) and not isinstance(left, bool) and not isinstance(right, bool) and code != 3:
                    return _cssc_accel_mod.binary_op_int(left, right, code)
                else:
                    return _cssc_accel_mod.binary_op_num(float(left), float(right), code)
        if op == '+':
            if isinstance(left, str) or isinstance(right, str):
                l = self._format_value(left)
                r = self._format_value(right)
                return l + r
            if isinstance(left, list) and isinstance(right, list):
                return left + right
            if isinstance(left, (int, float)) and isinstance(right, (int, float)):
                return left + right
            return str(left) + str(right)
        if op == '-' and isinstance(left, (int, float)) and isinstance(right, (int, float)):
            return left - right
        if op == '*':
            if isinstance(left, str) and isinstance(right, int):
                return left * right
            if isinstance(left, (int, float)) and isinstance(right, (int, float)):
                return left * right
            return 0
        if op == '/' and isinstance(right, (int, float)) and right != 0:
            return left / right
        if op == '%' and isinstance(right, (int, float)) and right != 0:
            return left % right
        if op == '==':
            # None (dangling pointer/0x0) equals 0x0 (parsed as 0) and 0x1
            if left is None and isinstance(right, int) and right == 0:
                return True
            if right is None and isinstance(left, int) and left == 0:
                return True
            return left == right
        if op == '!=':
            if left is None and isinstance(right, int) and right == 0:
                return False
            if right is None and isinstance(left, int) and left == 0:
                return False
            return left != right
        if op == '<':
            return left < right if left is not None and right is not None else False
        if op == '>':
            return left > right if left is not None and right is not None else False
        if op == '<=':
            return left <= right if left is not None and right is not None else False
        if op == '>=':
            return left >= right if left is not None and right is not None else False
        return None

    def _eval_logical(self, node: dict) -> Any:
        if node['op'] == '&&':
            left = self._eval(node['left'])
            if not self._is_truthy(left):
                return left
            return self._eval(node['right'])
        if node['op'] == '||':
            left = self._eval(node['left'])
            if self._is_truthy(left):
                return left
            return self._eval(node['right'])
        return None

    def _eval_unary(self, node: dict) -> Any:
        if node['op'] == '*':
            # *iter — dereference iterator to get element at current position
            operand = node['operand']
            if operand.get('type') in ('identifier', 'ident'):
                name = operand['name']
                val = self._variables.get(name)
                if val is None and hasattr(self, '_parent_scopes'):
                    for ps in reversed(self._parent_scopes):
                        if name in ps:
                            val = ps[name]
                            break
                if isinstance(val, CsscIterator):
                    return val.deref()
                # For function/object values, return the value directly —
                # a name-based pointer would dangle the moment the holding
                # label/scope returns. Callers that push_back(*cb) into a
                # vector and later iterate `?n { n(); }` need the actual
                # callable, not a stale pointer to a freed param frame.
                if isinstance(val, (CsscFunction, CsscObject, CsscSector)):
                    return val
                return CsscPointer(name)
            # *var[index] — indexed pointer (live reference)
            if operand.get('type') == 'index':
                obj_node = operand.get('object', {})
                if obj_node.get('type') in ('identifier', 'ident'):
                    idx = self._eval(operand.get('index'))
                    return CsscPointer(obj_node['name'], index=idx)
            return self._eval(operand)
        val = self._eval(node['operand'])
        if node['op'] == '-':
            return -val if isinstance(val, (int, float)) else val
        if node['op'] == '!':
            return not self._is_truthy(val)
        return val

    def _eval_postfix(self, node: dict) -> Any:
        name = node['operand']['name']
        old_val = self._variables.get(name, 0)
        if isinstance(old_val, CsscIterator):
            if node['op'] == '++':
                old_val._index += 1
            elif node['op'] == '--':
                old_val._index -= 1
            return old_val
        if node['op'] == '++':
            self._variables[name] = old_val + 1
        elif node['op'] == '--':
            self._variables[name] = old_val - 1
        return old_val  # postfix returns old value

    def _eval_call(self, node: dict) -> Any:
        name = node['name']
        ast_args = node['args']
        args = [self._eval_arg(a) for a in ast_args]
        # v6 ref-by-default: stash the per-arg meta so the callee's
        # `#scanp` can decide ref vs. copy from the CALL SITE syntax,
        # not the callee's `&` hint (spec §2.5). The callback
        # consumes the stash when pushing to `_call_args_stack`.
        self._stash_pending_arg_metas(ast_args)
        # Trigger 'passed' on method-bound args, then unwrap
        _ensure_method_imports()
        for i, a in enumerate(args):
            if CsscMethodBinding is not None and isinstance(a, CsscMethodBinding):
                a.trigger_do('passed', None)
                args[i] = a.get_value()
        # Check cssc:: builtins (bare calls also resolve here)
        if name in self._ns_builtins:
            func = self._ns_builtins[name]
            try:
                return func(*args)
            except TypeError:
                # Try with fewer args
                import inspect
                try:
                    sig = inspect.signature(func)
                    nparams = len([p for p in sig.parameters.values()
                                   if p.default is inspect.Parameter.empty])
                    return func(*args[:nparams])
                except Exception:
                    return func(*args[:1]) if args else func()
        # Check #define / #cdefine callbacks stored in variables
        var = self._variables.get(name)
        # Walk parent scopes if not found locally (covers nested label
        # bodies that need outer-scope functions like the user's
        # `Firmware_ESP8266->default` callback).
        if var is None and hasattr(self, '_parent_scopes'):
            for ps in reversed(self._parent_scopes):
                if name in ps:
                    var = ps[name]
                    break
        # Resolve pointer-by-reference values (`*cb` push_back'd into a
        # vector then dereffed during iteration as `n()`). Without this,
        # callback arrays of `*func` pointers couldn't be invoked from
        # inside select loops — they read back as `CsscPointer("cb")`.
        if isinstance(var, CsscPointer):
            var = self._resolve_value(var)
        # Unwrap method binding for call
        _ensure_method_imports()
        if CsscMethodBinding is not None and isinstance(var, CsscMethodBinding):
            var = var.get_value()
        if isinstance(var, CsscObject):
            return var.execute()
        if callable(var):
            return var(*args)
        raise CsscError(operation='Runtime', detail=f"Unknown function: {name}", line=node.get('line', 0))

    def _eval_ns_call(self, node: dict) -> Any:
        ns = node['namespace']
        func_name = node['func']
        ast_args = node['args']
        args = [self._eval_arg(a) for a in ast_args]
        # v6 ref-by-default: stash per-arg meta for the callee's
        # `#scanp` (only matters when the call routes to a user
        # `#define` / object method; `cssc::` builtins read values
        # directly and never call `_lookup_arg_meta`).
        self._stash_pending_arg_metas(ast_args)

        # cssc:: namespace
        if ns == 'cssc':
            if func_name in self._ns_builtins:
                func = self._ns_builtins[func_name]
                try:
                    return func(*args)
                except TypeError:
                    import inspect
                    try:
                        sig = inspect.signature(func)
                        nparams = len([p for p in sig.parameters.values()
                                       if p.default is inspect.Parameter.empty])
                        return func(*args[:nparams])
                    except Exception:
                        return func(*args[:1]) if args else func()
            raise CsscError(operation='Runtime', detail=f"Unknown cssc builtin: {func_name}",
                            line=node.get('line', 0))

        # Module namespace: modvar::func(args)
        mod = self._modules.get(ns) or self._variables.get(ns)
        if mod is not None:
            if isinstance(mod, CsscSector):
                if not mod.is_public(func_name):
                    return None  # private → 0x0
                func = mod._vars.get(func_name)
                if isinstance(func, CsscObject):
                    return func.execute(*args)
                if callable(func):
                    return func(*args)
                return None  # not callable → 0x0
            if isinstance(mod, CsscModule) or hasattr(mod, 'get_namespace'):
                funcs = mod.get_namespace()
                if func_name in funcs:
                    val = funcs[func_name]
                    if isinstance(val, CsscObject):
                        return val.execute(*args)
                    if callable(val):
                        return val(*args)
                    return val
                raise CsscError(operation='Runtime',
                                detail=f"Module '{ns}' has no function '{func_name}'",
                                line=node.get('line', 0))
            # Generic object with callable attributes
            method = getattr(mod, func_name, None)
            if isinstance(method, CsscObject):
                return method.execute(*args)
            if callable(method):
                return method(*args)

        raise CsscError(operation='Runtime', detail=f"Unknown namespace: {ns}",
                        line=node.get('line', 0))

    def _eval_ns_access(self, node: dict) -> Any:
        member = node['member']
        # Nested namespace access form: `outer::inner::member` is parsed as
        # ns_access(namespace_expr=ns_access(...), member=...). Resolve the
        # inner namespace expression first and then look up `member` on it.
        ns_expr = node.get('namespace_expr')
        if ns_expr is not None:
            base = self._eval(ns_expr)
            if base is None:
                return None
            if isinstance(base, CsscSector):
                if not base.is_public(member):
                    return None
                return base.get_member(member)
            if isinstance(base, CsscModule) or hasattr(base, 'get_namespace'):
                ns_dict = base.get_namespace()
                if member in ns_dict:
                    return ns_dict[member]
            if isinstance(base, dict):
                return base.get(member)
            return getattr(base, member, None)
        ns = node['namespace']
        if ns == 'cssc':
            if member in self._ns_builtins:
                return self._ns_builtins[member]
            return None
        # During sector construction, resolve from local scope
        if getattr(self, '_building_sector', None) == ns and member in self._variables:
            return self._variables[member]
        mod = self._modules.get(ns) or self._variables.get(ns)
        # Trigger the CSSC watermark intro when a #depend-registered alias is
        # first accessed. Safe to call every time — show_once is idempotent.
        if mod is not None and getattr(mod, '_depend_origin', None):
            try:
                from includecpp.core.cssl import cssl_watermark as _wm
                _wm.show_once()
            except Exception:
                pass
        if mod:
            if isinstance(mod, CsscSector):
                if not mod.is_public(member):
                    return None  # private → 0x0
                return mod.get_member(member)
            if isinstance(mod, CsscModule) or hasattr(mod, 'get_namespace'):
                ns_dict = mod.get_namespace()
                if member in ns_dict:
                    val = ns_dict[member]
                    # Property-style access: auto-call zero-arg functions
                    if callable(val):
                        import inspect
                        try:
                            sig = inspect.signature(val)
                            params = [p for p in sig.parameters.values()
                                      if p.default is inspect.Parameter.empty]
                            if len(params) == 0:
                                return val()
                        except (ValueError, TypeError):
                            pass
                    return val
            return getattr(mod, member, None)
        return None

    def _eval_method_call(self, node: dict) -> Any:
        method_name = node['method']
        obj_node = node.get('object') or {}
        # `label.pos()` inside `select (...) ?label { ... }` — return the
        # cursor position without evaluating `label` (its value is the current
        # element, not something you can call .pos() on).
        if (method_name == 'pos' and obj_node.get('type') in ('identifier', 'ident')
                and hasattr(self, '_select_cursors')):
            ident = obj_node.get('name')
            if ident in self._select_cursors:
                return int(self._select_cursors[ident])
        obj = self._eval(node['object'])
        ast_args = node['args']
        args = [self._eval_arg(a) for a in ast_args]
        # v6 ref-by-default: stash arg meta so an object-method body
        # using `#scanp` reads the call-site decision (spec §2.5).
        # Built-in container methods (push_back, size, …) never call
        # `_lookup_arg_meta` so the stash is harmless there.
        self._stash_pending_arg_metas(ast_args)
        # Resolve CsscPointer args to actual values — BUT keep CsscPointer
        # for container mutation methods so references are stored, not values.
        _CONTAINER_STORE_METHODS = {'push_back', 'push_front', 'insert', 'append', 'set'}
        if not (isinstance(obj, (list, CsscBind)) and method_name in _CONTAINER_STORE_METHODS):
            args = [self._resolve_value(a) if isinstance(a, CsscPointer) else a for a in args]
        if obj is None:
            return None
        # CsscIterator — delegate to real methods (begin, end)
        if isinstance(obj, CsscIterator):
            m = getattr(obj, method_name, None)
            if m and callable(m):
                return m(*args)
            raise CsscError(operation='Runtime', detail=f"No method '{method_name}' on iterator",
                            line=node.get('line', 0))
        # CsscMatrix — delegate to real methods (get, set, fill, width, height, copy, size)
        if isinstance(obj, CsscMatrix):
            m = getattr(obj, method_name, None)
            if m and callable(m):
                return m(*args)
            raise CsscError(operation='Runtime', detail=f"No method '{method_name}' on matrix",
                            line=node.get('line', 0))
        # CsscVector — delegate to real Vector methods from cssl_types
        if isinstance(obj, CsscVector):
            m = getattr(obj, method_name, None)
            if m and callable(m):
                return m(*args)
        # Check custom method dicts FIRST for built-in types (before getattr)
        # Dict method simulation
        if isinstance(obj, dict):
            dict_methods = {
                'get': lambda k, d=None: obj.get(k, d),
                'set': lambda k, v: obj.__setitem__(k, v),
                'has': lambda k: k in obj,
                'keys': lambda: list(obj.keys()),
                'values': lambda: list(obj.values()),
                'items': lambda: [[k, v] for k, v in obj.items()],
                'remove': lambda k: obj.pop(k, None),
                'size': lambda: len(obj),
                'length': lambda: len(obj),
                'clear': lambda: obj.clear(),
                'exists': lambda: True,
                'empty': lambda: len(obj) == 0,
                'begin': lambda: list(obj.keys())[0] if obj else None,
                'end': lambda: list(obj.keys())[-1] if obj else None,
                'front': lambda: list(obj.values())[0] if obj else None,
                'back': lambda: list(obj.values())[-1] if obj else None,
                'contains': lambda k: k in obj,
                'count': lambda k: 1 if k in obj else 0,
            }
            if method_name in dict_methods:
                return dict_methods[method_name](*args)
        # Bind method simulation — chain-of-maps operations.
        # CsscBind also matches isinstance(obj, list) below, so handle bind-only
        # methods FIRST and let the rest fall through to the list dispatch.
        if isinstance(obj, CsscBind) and method_name == 'addmap':
            if not args:
                return obj
            payload = args[0]
            if isinstance(payload, dict):
                for k, v in payload.items():
                    obj.append((k, v))
            elif isinstance(payload, (list, tuple)) and len(payload) == 2 and not isinstance(payload[0], (list, tuple, dict)):
                obj.append((payload[0], payload[1]))
            elif isinstance(payload, (list, tuple)):
                for entry in payload:
                    if isinstance(entry, (list, tuple)) and len(entry) >= 2:
                        obj.append((entry[0], entry[1]))
                    else:
                        obj.append((entry, None))
            else:
                obj.append((payload, None))
            return obj
        # List method simulation
        if isinstance(obj, list):
            list_methods = {
                'get': lambda i: obj[int(i)] if 0 <= int(i) < len(obj) else None,
                'push': lambda v: (obj.append(v), obj)[-1],
                'pop': lambda: obj.pop() if obj else None,
                'size': lambda: len(obj),
                'length': lambda: len(obj),
                'contains': lambda v: v in obj,
                'indexOf': lambda v: obj.index(v) if v in obj else -1,
                'clear': lambda: obj.clear(),
                'sort': lambda: (obj.sort(), obj)[-1],
                'reverse': lambda: (obj.reverse(), obj)[-1],
                'append': lambda v: (obj.append(v), obj)[-1],
                'atIndex': lambda i: obj[int(i)] if 0 <= int(i) < len(obj) else None,
                'takeout': lambda i: obj.pop(int(i)) if 0 <= int(i) < len(obj) else None,
                'pushafter': lambda i, v: (obj.insert(int(i) + 1, v), obj)[-1],
                'notAtIndex': lambda i, t: not isinstance(obj[int(i)], {'string': str, 'int': int, 'float': float, 'bool': bool, 'array': list, 'map': dict}.get(str(t), object)) if 0 <= int(i) < len(obj) else True,
                'remove': lambda v: (obj.remove(v), obj)[-1] if v in obj else obj,
                'insert': lambda i, v: (obj.insert(int(i), v), obj)[-1],
                'slice': lambda start, end=None: obj[int(start):] if end is None else obj[int(start):int(end)],
                'join': lambda sep='': sep.join(str(x) for x in obj),
                'first': lambda: obj[0] if obj else None,
                'last': lambda: obj[-1] if obj else None,
                'empty': lambda: len(obj) == 0,
                'exists': lambda: True,
                'push_back': lambda v: (obj.append(v), obj)[-1],
                'push_front': lambda v: (obj.insert(0, v), obj)[-1],
                'pop_back': lambda: obj.pop() if obj else None,
                'pop_front': lambda: obj.pop(0) if obj else None,
                'emplace_back': lambda v: (obj.append(v), obj)[-1],
                'emplace_front': lambda v: (obj.insert(0, v), obj)[-1],
                'front': lambda: obj[0] if obj else None,
                'back': lambda: obj[-1] if obj else None,
                'begin': lambda: obj[0] if obj else None,
                'end': lambda: obj[-1] if obj else None,
                'rbegin': lambda: obj[-1] if obj else None,
                'rend': lambda: obj[0] if obj else None,
                'at': lambda i: obj[int(i)] if 0 <= int(i) < len(obj) else None,
                'erase': lambda i: (obj.pop(int(i)), obj)[-1] if 0 <= int(i) < len(obj) else obj,
                'resize': lambda n, fill=None: (obj.extend([fill] * (int(n) - len(obj))) if int(n) > len(obj) else obj[:int(n)], obj)[-1],
                'capacity': lambda: len(obj),
                'shrink_to_fit': lambda: obj,
                'data': lambda: obj,
                'swap': lambda other: (obj.clear(), obj.extend(other))[-1] if isinstance(other, list) else obj,
            }
            if method_name in list_methods:
                return list_methods[method_name](*args)
        # String methods (also iterable)
        if isinstance(obj, str):
            str_methods = {
                'length': lambda: len(obj),
                'size': lambda: len(obj),
                'begin': lambda: obj[0] if obj else '',
                'end': lambda: obj[-1] if obj else '',
                'front': lambda: obj[0] if obj else '',
                'back': lambda: obj[-1] if obj else '',
                'data': lambda: obj,
                'capacity': lambda: len(obj),
                'upper': lambda: obj.upper(),
                'lower': lambda: obj.lower(),
                'trim': lambda: obj.strip(),
                'split': lambda sep=' ': obj.split(sep),
                'replace': lambda old, new: obj.replace(old, new),
                'contains': lambda sub: str(sub) in obj,
                'starts_with': lambda p: obj.startswith(str(p)),
                'startsWith': lambda p: obj.startswith(str(p)),
                'ends_with': lambda p: obj.endswith(str(p)),
                'endsWith': lambda p: obj.endswith(str(p)),
                'index_of': lambda sub: obj.find(str(sub)),
                'indexOf': lambda sub: obj.find(str(sub)),
                'index': lambda i: obj[int(i)] if 0 <= int(i) < len(obj) else '',
                'charAt': lambda i: obj[int(i)] if 0 <= int(i) < len(obj) else '',
                'substr': lambda start, length=-1: obj[int(start):] if length == -1 else obj[int(start):int(start)+int(length)],
                'substring': lambda start, end=-1: obj[int(start):] if end == -1 else obj[int(start):int(end)],
                'reverse': lambda: obj[::-1],
                'repeat': lambda n: obj * int(n),
                'padStart': lambda n, ch=' ': obj.rjust(int(n), str(ch)[0] if ch else ' '),
                'padEnd': lambda n, ch=' ': obj.ljust(int(n), str(ch)[0] if ch else ' '),
                'isEmpty': lambda: len(obj) == 0,
                'isDigit': lambda: obj.isdigit(),
                'isAlpha': lambda: obj.isalpha(),
                'toInt': lambda: int(obj) if obj.lstrip('-').isdigit() else 0,
                'toFloat': lambda: float(obj) if obj.replace('.', '', 1).lstrip('-').isdigit() else 0.0,
                'exists': lambda: True,
            }
            if method_name in str_methods:
                return str_methods[method_name](*args)
        # Fallback: try getattr for object methods
        method = getattr(obj, method_name, None)
        if callable(method):
            return method(*args)
        raise CsscError(operation='Runtime', detail=f"No method '{method_name}' on {self._b_typeof(obj)}",
                        line=node.get('line', 0))

    def _eval_dot_call(self, node: dict) -> Any:
        # Same as method_call but with dot syntax
        return self._eval_method_call({
            'object': node['object'],
            'method': node['method'],
            'args': node['args'],
            'line': node.get('line', 0),
            'type': 'method_call',
        })

    def _eval_arrow(self, node: dict) -> Any:
        # During sector construction, SectorName->member resolves to local scope
        obj_node = node['object']
        key = node['key']
        if obj_node.get('type') in ('ident', 'identifier') and getattr(self, '_building_sector', None) == obj_node.get('name'):
            # Check object/sector _vars first (arrow assigns write there directly)
            obj_ref = self._variables.get(obj_node.get('name'))
            if isinstance(obj_ref, (CsscObject, CsscSector)) and key in obj_ref._vars:
                return obj_ref._vars[key]
            return self._variables.get(key)
        obj = self._eval(obj_node)
        # If obj is None, try parent scopes (matches the second runtime's
        # behavior — needed so Sector->Member resolves inside #define callbacks).
        if obj is None and obj_node.get('type') in ('ident', 'identifier'):
            name = obj_node.get('name')
            if hasattr(self, '_parent_scopes'):
                for ps in reversed(self._parent_scopes):
                    if name in ps:
                        obj = ps[name]
                        break
        if obj is None:
            return None
        # CsscObject / CsscSector members live in _vars (a dict), NOT as
        # Python attributes. Without this branch `_AiProc_->ai` returned None
        # from inside the object's own labels, silently NOPing every method
        # call on the resolved (None) target.
        if isinstance(obj, CsscSector):
            return obj.get_member(key) if hasattr(obj, 'get_member') else obj._vars.get(key)
        if isinstance(obj, CsscObject):
            return obj._vars.get(key)
        if isinstance(obj, dict):
            return obj.get(key)
        method = getattr(obj, key, None)
        if method is not None:
            return method
        if hasattr(obj, 'get') and callable(obj.get):
            return obj.get(key)
        return None

    def _eval_dot_access(self, node: dict) -> Any:
        obj = self._eval(node['object'])
        key = node['key']
        if obj is None:
            return None
        if isinstance(obj, dict):
            return obj.get(key)
        return getattr(obj, key, None)

    # -- Type helpers -------------------------------------------------------
    @staticmethod
    def _split_generic_args(s):
        """Split a string by commas, respecting <> nesting.
        e.g. 'vector<int>, 1028' -> ['vector<int>', '1028']
        """
        parts = []
        depth = 0
        current = []
        for ch in s:
            if ch == '<':
                depth += 1
                current.append(ch)
            elif ch == '>':
                depth -= 1
                current.append(ch)
            elif ch == ',' and depth == 0:
                parts.append(''.join(current).strip())
                current = []
            else:
                current.append(ch)
        if current:
            parts.append(''.join(current).strip())
        return parts

    @staticmethod
    def _parse_base_type(vtype):
        """Extract base type from generic: 'vector<int>' -> ('vector', 'int'),
        'map<string, int>' -> ('map', 'string, int'), 'int' -> ('int', None),
        'cbin::binary' -> ('binary', None) with module prefix stripped."""
        vtype = vtype.strip()
        # Handle module::type syntax (e.g. cbin::binary)
        if '::' in vtype:
            vtype = vtype.split('::')[-1]
        lt = vtype.find('<')
        if lt >= 0 and vtype.endswith('>'):
            return vtype[:lt].strip(), vtype[lt + 1:-1].strip()
        return vtype.strip(), None

    def _default_for_type(self, vtype):
        """Get default value for a type, including generic types."""
        base, _ = self._parse_base_type(vtype)
        if base == 'binary':
            from includecpp.core.cssl.cssl_binary import Binary
            return Binary(data=b'', metadata={'type': 'empty', 'serializer': 'raw'})
        if base in ('array', 'list', 'vector'):
            return CsscVector()
        if base in ('map', 'dict'):
            return CsscMap()
        defaults = {'int': 0, 'float': 0.0, 'string': '', 'str': '',
                    'bind': CsscBind([]),
                    'bool': False, 'boolean': False, 'auto': None, 'var': None, 'void': None}
        return defaults.get(base, None)

    def _strict_type_check(self, value: Any, target_type: str, varname: str = '', line: int = 0):
        """Strict type check — raises error if value is incompatible with target type.
        CSSC is strict: once a type is assigned, it stays. Only compatible values are allowed."""
        base, _ = self._parse_base_type(target_type)
        if base in ('auto', 'var', 'void', None):
            return  # No type restriction
        ok = False
        if base == 'int':
            ok = isinstance(value, (int, bool)) or (isinstance(value, float) and value == int(value))
            if not ok and isinstance(value, str):
                ok = value.lstrip('-').isdigit()
        elif base == 'float':
            ok = isinstance(value, (int, float, bool))
            if not ok and isinstance(value, str):
                try:
                    float(value)
                    ok = True
                except ValueError:
                    pass
        elif base in ('string', 'str'):
            ok = True  # Everything can become a string
        elif base in ('bool', 'boolean'):
            ok = isinstance(value, (bool, int))
        elif base in ('array', 'list', 'vector'):
            ok = isinstance(value, (list, tuple))
        elif base in ('map', 'dict'):
            ok = isinstance(value, dict)
        elif base == 'bind':
            ok = isinstance(value, CsscBind)
        else:
            ok = True  # Unknown/custom types — allow
        if not ok:
            val_type = type(value).__name__
            raise CsscError(operation='Runtime',
                            detail=f'Type mismatch: cannot assign {val_type} to variable "{varname}" of type {target_type}',
                            hint=f'Variable "{varname}" is strictly typed as {target_type}',
                            line=line)

    def _coerce(self, value: Any, target_type: str) -> Any:
        # Preserve callable references (functions) — never coerce them to primitive types
        if callable(value) and not isinstance(value, (bool, int, float, str, list, dict)):
            return value
        base, _ = self._parse_base_type(target_type)
        if base == 'int':
            try:
                return int(value) if value is not None else 0
            except (ValueError, TypeError):
                return 0
        if base == 'float':
            try:
                return float(value) if value is not None else 0.0
            except (ValueError, TypeError):
                return 0.0
        if base in ('string', 'str'):
            return str(value) if value is not None else ''
        if base in ('bool', 'boolean'):
            return self._is_truthy(value)
        if base in ('array', 'list', 'vector'):
            # `array<T>` is a distinct type from `vector<T>` — it stays a
            # CsscArray so `cssc::typeof` reports 'array' (native reports
            # 'array' for its array_* slot kinds too). `vector`/`list`
            # collapse to CsscVector ('vector'). Both share the same mutable
            # list method surface, so the choice is purely nominal/typeof.
            if base == 'array':
                if isinstance(value, CsscArray): return value
            elif isinstance(value, CsscVector):
                return value
            raw = None
            if isinstance(value, list):
                raw = list(value)
            elif isinstance(value, dict):
                raw = list(value.values()) if value else []
            elif isinstance(value, str) and ',' in value:
                parts = [p.strip() for p in value.split(',')]
                raw = []
                for p in parts:
                    if p.lstrip('-').isdigit():
                        raw.append(int(p))
                    else:
                        try:
                            raw.append(float(p))
                        except ValueError:
                            raw.append(p)
            else:
                raw = [value] if value is not None else []
            if base == 'array':
                inner = 'dynamic'
                if '<' in target_type and '>' in target_type:
                    inner = target_type[target_type.find('<') + 1:
                                        target_type.rfind('>')].strip() or 'dynamic'
                arr = CsscArray(inner)
                arr.extend(raw)
                return arr
            vec = CsscVector()
            vec.extend(raw)
            return vec
        if base in ('map', 'dict'):
            if isinstance(value, CsscMap): return value
            if isinstance(value, dict):
                m = CsscMap()
                m.update(value)
                return m
            if isinstance(value, (list, tuple)):
                m = CsscMap()
                # Per CSSC Doc §3.2 the map-literal syntax is the comma form
                # `{'k', 'v', 'k2', 'v2'}` — the parser routes that through
                # an array-literal AST node, which arrives here. Walk the
                # items in pairs (key, value, key, value, …) instead of
                # numeric-indexing them. Odd-length lists fall back to the
                # numeric form so positional-only payloads still work.
                lst = list(value)
                if lst and len(lst) % 2 == 0:
                    for i in range(0, len(lst), 2):
                        m[lst[i]] = lst[i + 1]
                else:
                    m.update({i: v for i, v in enumerate(lst)})
                return m
            return CsscMap()
        if base == 'bind':
            if isinstance(value, CsscBind):
                return value
            if isinstance(value, list):
                # Pair-up rule for flat lists from `{a, b}` / `{a, b, c, d}`
                # literals (post-parser routing): every two adjacent
                # items form one (key, value) pair. Items that are
                # already 2-tuples (from canonical `{k, v; k, v}` bind
                # literals) pass through as-is. This matches the v6
                # native semantics where a `bind` is a flat cell list
                # accessed pair-wise — `i[0]` is the first cell, not a
                # (first_cell, None) tuple.
                #
                # CRITICAL: the produced pairs are width-2 tuples, so the
                # CsscBind MUST carry `pair_width=2`. Without it the bind
                # is mislabelled flat (`pair_width=0`) while its entries
                # are tuples — an inconsistent state that makes both
                # single-index (`b[0]` returns the whole `(a,b)` tuple
                # instead of cell `a`) and chained-index (`b[row][col]`
                # degrades to row-only, dropping `col` and returning the
                # whole pair — the stray trailing cell users saw as
                # `…, 0`) read wrong. `pair_width=2` restores the
                # documented invariant `b[row][col] == b[row*2 + col]`.
                if value and isinstance(value[0], (list, tuple)) and len(value[0]) >= 2:
                    return CsscBind([(p[0], p[1]) for p in value],
                                    pair_width=2)
                _pairs = []
                _it = iter(value)
                for _a in _it:
                    _b = next(_it, None)
                    _pairs.append((_a, _b))
                return CsscBind(_pairs, pair_width=2)
            return CsscBind([])
        if base == 'binary':
            from includecpp.core.cssl.cssl_binary import Binary
            if isinstance(value, Binary):
                return value
            return CsscBinaryModule()._get_binary().tobinary(value)
        return value

    def _is_truthy(self, value: Any) -> bool:
        if value is None:
            return False
        if isinstance(value, bool):
            return value
        if isinstance(value, (int, float)):
            return value != 0
        if isinstance(value, str):
            return len(value) > 0 and value.lower() not in ('false', '0', 'null', 'none')
        if isinstance(value, (list, dict)):
            return len(value) > 0
        return True

    def cleanup(self):
        for name, (rtype, resource) in self._resources.items():
            try:
                if hasattr(resource, 'close') and callable(resource.close):
                    resource.close()
                elif hasattr(resource, 'save') and callable(resource.save):
                    resource.save()
            except Exception:
                pass
        if self._output_path and self._output_buffer:
            try:
                with open(self._output_path, 'w', encoding='utf-8') as fh:
                    fh.write(''.join(self._output_buffer))
            except Exception:
                pass

    def get_output(self) -> str:
        return ''.join(self._output_buffer)

    def status(self) -> dict:
        return {
            'variables': len(self._variables),
            'modules': list(self._modules.keys()),
            'resources': {k: v[0] for k, v in self._resources.items()},
            'running': self._running,
            'exit_code': self._exit_code,
            'output_lines': len(self._output_buffer),
        }


# ---------------------------------------------------------------------------
# Runtime — Signals
# ---------------------------------------------------------------------------
class _BreakSignal(Exception):
    pass

class _ContinueSignal(Exception):
    pass

class _ReturnSignal(Exception):
    def __init__(self, value=None, source_var=None):
        self.value = value
        self.source_var = source_var


# ---------------------------------------------------------------------------
# Resource Handlers (for #REQUIRE)
# ---------------------------------------------------------------------------
class CsscIniHandler:
    """Wraps configparser for .ini file access via arrow/dot syntax."""

    def __init__(self, path: str):
        self._path = path
        self._parser = configparser.ConfigParser()
        if os.path.isfile(path):
            self._parser.read(path, encoding="utf-8")

    def get(self, key: str, default=None):
        for sec in self._parser.sections():
            if self._parser.has_option(sec, key):
                return self._parser.get(sec, key)
        if self._parser.has_option("DEFAULT", key):
            return self._parser.get("DEFAULT", key)
        return default

    def set(self, key: str, value):
        if not self._parser.sections():
            self._parser.add_section("main")
        sec = self._parser.sections()[0]
        self._parser.set(sec, key, str(value))
        self.save()

    def has(self, key: str) -> bool:
        return self.get(key) is not None

    def remove(self, key: str) -> bool:
        for sec in self._parser.sections():
            if self._parser.has_option(sec, key):
                self._parser.remove_option(sec, key)
                self.save()
                return True
        return False

    def sections(self) -> list:
        return self._parser.sections()

    def keys(self, section: str = "") -> list:
        if section:
            return list(self._parser.options(section)) if self._parser.has_section(section) else []
        result = []
        for sec in self._parser.sections():
            result.extend(self._parser.options(sec))
        return result

    def all(self) -> dict:
        result = {}
        for sec in self._parser.sections():
            for k, v in self._parser.items(sec):
                result[k] = v
        return result

    def save(self):
        with open(self._path, "w", encoding="utf-8") as fh:
            self._parser.write(fh)

    def close(self):
        self.save()

    def exist(self) -> bool:
        return os.path.isfile(self._path)

    def exists(self):
        return self.exist()

    def edit(self, key: str, value) -> bool:
        self.set(key, value)
        return True

    def path(self) -> str:
        return self._path


class CsscDllHandler:
    """Wraps ctypes CDLL for method dispatch."""

    def __init__(self, path: str, dll=None):
        self._path = path
        self._dll = dll

    def call(self, func_name: str, *args):
        if self._dll:
            func = getattr(self._dll, func_name, None)
            if func:
                return func(*args)
        return None

    def has_function(self, name: str) -> bool:
        if self._dll:
            return hasattr(self._dll, name)
        return False

    def functions(self) -> list:
        return []

    def exist(self) -> bool:
        return self._dll is not None

    def exists(self):
        return self.exist()

    def path(self) -> str:
        return self._path

    def close(self):
        pass


class CsscCslHandler:
    """Key-value store handler for .csl/.json files."""

    def __init__(self, path: str):
        self._path = path
        self._data: Dict[str, Any] = {}
        if os.path.isfile(path):
            try:
                with open(path, "r", encoding="utf-8") as fh:
                    content = fh.read().strip()
                    if content:
                        self._data = json.loads(content)
            except (json.JSONDecodeError, Exception):
                # Try line-based key=value format
                try:
                    with open(path, "r", encoding="utf-8") as fh:
                        for line in fh:
                            line = line.strip()
                            if "=" in line and not line.startswith(("#", "//")):
                                k, v = line.split("=", 1)
                                self._data[k.strip()] = v.strip()
                except Exception:
                    pass

    def get(self, key: str, default=None):
        return self._data.get(key, default)

    def set(self, key: str, value):
        self._data[key] = value
        self.save()

    def has(self, key: str) -> bool:
        return key in self._data

    def remove(self, key: str) -> bool:
        if key in self._data:
            del self._data[key]
            self.save()
            return True
        return False

    def keys(self) -> list:
        return list(self._data.keys())

    def values(self) -> list:
        return list(self._data.values())

    def all(self) -> dict:
        return dict(self._data)

    def size(self) -> int:
        return len(self._data)

    def save(self):
        with open(self._path, "w", encoding="utf-8") as fh:
            json.dump(self._data, fh, indent=2)

    def close(self):
        self.save()

    def exist(self) -> bool:
        return os.path.isfile(self._path)

    def exists(self):
        return self.exist()

    def edit(self, key: str, value) -> bool:
        self.set(key, value)
        return True

    def clear(self):
        self._data.clear()
        self.save()

    def path(self) -> str:
        return self._path


