class CsscDefineModule(CsscModule):
    """def - Extended function definitions with parameters.

    Enables #cdefine, #param, #fvar, #qvar, #scanp, #scanp_opt directives
    for defining callbacks with named (and optional) parameters.
    Usage: #include("def");
    """
    _name = 'def'

    def get_namespace(self):
        return {}

    def get_docs(self):
        return {
            '#cdefine(func, p1, p2) { … }':
                'Define a callback with named parameters.',
            '#param(type) name;':
                'Declare a typed parameter for the next #cdefine.',
            '#fvar(type) name;':
                'Declare a function variable (return type).',
            '#qvar(type, expr) name;':
                'Quick variable from an expression result.',
            '#scanp(func, type, pos) name;':
                'Scan a *required* arg from a #define-style call into name.',
            '#scanp_opt(func, type, pos) name;':
                'Like #scanp, but missing args yield null without erroring '
                '— use for trailing optional parameters.',
        }


class CsscSysArgsModule(CsscModule):
    """sys - System arguments module.

    Provides access to script arguments passed via CLI or cssc::run()/cssl::run().
    Usage: #include("sys") sys;
    Adds: #sysarg[type, index] var; — stack variable from args (needs #delete)
    Access: sys::args, sys::argc, sys::arg(index)
    """
    _name = 'sys'

    def __init__(self, args=None):
        super().__init__()
        self._args = list(args) if args else list(sys.argv[1:])

    def get_namespace(self):
        return {
            'args': self._args,
            'argc': len(self._args),
            'arg': self._get_arg,
            'has_arg': self._has_arg,
            'arg_int': self._arg_int,
            'arg_float': self._arg_float,
            'arg_bool': self._arg_bool,
        }

    def _get_arg(self, index):
        """Get argument at index, returns null if out of bounds."""
        idx = int(index)
        if 0 <= idx < len(self._args):
            return self._args[idx]
        return None

    def _has_arg(self, index):
        """Check if argument at index exists."""
        return 0 <= int(index) < len(self._args)

    def _arg_int(self, index):
        """Get argument at index as integer."""
        val = self._get_arg(index)
        if val is None:
            return 0
        try:
            return int(val)
        except (ValueError, TypeError):
            return 0

    def _arg_float(self, index):
        """Get argument at index as float."""
        val = self._get_arg(index)
        if val is None:
            return 0.0
        try:
            return float(val)
        except (ValueError, TypeError):
            return 0.0

    def _arg_bool(self, index):
        """Get argument at index as boolean."""
        val = self._get_arg(index)
        if val is None:
            return False
        return str(val).lower() not in ('false', '0', 'no', 'off', '')

    def get_docs(self):
        return {
            'args': 'sys::args — list of all arguments passed to the script',
            'argc': 'sys::argc — number of arguments',
            'arg': 'sys::arg(index) — get argument at index (returns null if out of bounds)',
            'has_arg': 'sys::has_arg(index) — check if argument at index exists',
            'arg_int': 'sys::arg_int(index) — get argument at index as integer',
            'arg_float': 'sys::arg_float(index) — get argument at index as float',
            'arg_bool': 'sys::arg_bool(index) — get argument at index as boolean',
        }


class CsscStdoutModule(CsscModule):
    """stdout - Dedicated output console window.

    When included, opens a separate console window.
    Adds #stdout(txt) directive which prints plain text with auto newline.
    Usage: #include("stdout");
           #stdout(myvar);
           #stdout("Hello World");
    """
    _name = 'stdout'

    def __init__(self):
        super().__init__()
        self._proc = None
        self._start_console()

    def _start_console(self):
        import subprocess, sys, os, tempfile
        # Write a tiny Python script that reads lines from stdin and prints them
        self._script = os.path.join(tempfile.gettempdir(), '_cssc_stdout_console.py')
        with open(self._script, 'w', encoding='utf-8') as f:
            f.write(
                'import sys, ctypes\n'
                'try:\n'
                '    ctypes.windll.kernel32.SetConsoleTitleW("CSSC stdout")\n'
                '    # Set Consolas font 16pt\n'
                '    import ctypes.wintypes\n'
                '    class CONSOLE_FONT_INFOEX(ctypes.Structure):\n'
                '        _fields_ = [("cbSize", ctypes.wintypes.ULONG),\n'
                '                    ("nFont", ctypes.wintypes.DWORD),\n'
                '                    ("dwFontSize", ctypes.wintypes.COORD),\n'
                '                    ("FontFamily", ctypes.c_uint),\n'
                '                    ("FontWeight", ctypes.c_uint),\n'
                '                    ("FaceName", ctypes.c_wchar * 32)]\n'
                '    font = CONSOLE_FONT_INFOEX()\n'
                '    font.cbSize = ctypes.sizeof(CONSOLE_FONT_INFOEX)\n'
                '    font.nFont = 0\n'
                '    font.dwFontSize.X = 0\n'
                '    font.dwFontSize.Y = 16\n'
                '    font.FontFamily = 54\n'
                '    font.FontWeight = 400\n'
                '    font.FaceName = "Consolas"\n'
                '    handle = ctypes.windll.kernel32.GetStdHandle(-11)\n'
                '    ctypes.windll.kernel32.SetCurrentConsoleFontEx(handle, False, ctypes.byref(font))\n'
                'except Exception:\n'
                '    pass\n'
                'for line in sys.stdin:\n'
                '    sys.stdout.write(line)\n'
                '    sys.stdout.flush()\n'
            )
        try:
            CREATE_NEW_CONSOLE = 0x00000010
            self._proc = subprocess.Popen(
                [sys.executable, self._script],
                stdin=subprocess.PIPE,
                creationflags=CREATE_NEW_CONSOLE if sys.platform == 'win32' else 0,
                encoding='utf-8',
                errors='replace',
            )
        except Exception:
            self._proc = None

    def write(self, text):
        if self._proc and self._proc.stdin:
            try:
                self._proc.stdin.write(str(text) + '\n')
                self._proc.stdin.flush()
            except Exception:
                pass

    def close(self):
        if self._proc and self._proc.stdin:
            try:
                self._proc.stdin.close()
                self._proc.wait(timeout=2)
            except Exception:
                pass

    def __del__(self):
        self.close()

    def get_namespace(self):
        return {}

    def get_docs(self):
        return {}


class CsscSizesModule(CsscModule):
    """sizes - Recommended bit sizes for all data types.

    Provides hardcoded size constants as variables (not functions):
      sz::small_int, sz::normal_int, sz::large_int
    Usage: #include("sizes") sz;
           #stack[string, sz::normal_string] mystr;
    """
    _name = 'sizes'

    def get_namespace(self):
        return {
            # int
            'small_int': 16,
            'normal_int': 32,
            'large_int': 64,
            # float
            'small_float': 32,
            'normal_float': 64,
            'large_float': 128,
            # string
            'small_string': 128,
            'normal_string': 256,
            'large_string': 1024,
            # bool
            'small_bool': 8,
            'normal_bool': 8,
            'large_bool': 8,
            # array / vector / list
            'small_array': 256,
            'normal_array': 1024,
            'large_array': 4096,
            'small_vector': 256,
            'normal_vector': 1024,
            'large_vector': 4096,
            'small_list': 256,
            'normal_list': 1024,
            'large_list': 4096,
            # map / dict
            'small_map': 512,
            'normal_map': 2048,
            'large_map': 8192,
            'small_dict': 512,
            'normal_dict': 2048,
            'large_dict': 8192,
            # auto / var
            'small_auto': 64,
            'normal_auto': 256,
            'large_auto': 1024,
            'small_var': 64,
            'normal_var': 256,
            'large_var': 1024,
        }

    def get_docs(self):
        ns = self.get_namespace()
        return {k: f'{k} = {v} bits' for k, v in ns.items()}


class CsscStdioModule(CsscModule):
    """stdio - Standard file I/O operations.

    Usage: #include("stdio") io;
    Provides: io::write, io::read, io::exists, io::createdir,
              io::createfile, io::removefile, io::removedir, io::move
    """
    _name = 'stdio'

    def __init__(self, script_dir=''):
        self._script_dir = script_dir

    def _resolve(self, path):
        p = os.path.expanduser(path)
        if not os.path.isabs(p) and self._script_dir:
            p = os.path.join(self._script_dir, p)
        return os.path.normpath(p)

    def get_namespace(self):
        return {
            'write': self._write,
            'read': self._read,
            'exists': self._exists,
            'createdir': self._createdir,
            'createfile': self._createfile,
            'removefile': self._removefile,
            'removedir': self._removedir,
            'move': self._move,
        }

    def _write(self, path, content):
        try:
            p = self._resolve(path)
            with open(p, 'w', encoding='utf-8') as f:
                f.write(str(content))
            return True
        except Exception:
            return False

    def _read(self, path):
        try:
            p = self._resolve(path)
            with open(p, 'r', encoding='utf-8') as f:
                return f.read()
        except Exception:
            return ''

    def _exists(self, path):
        return os.path.exists(self._resolve(path))

    def _createdir(self, path):
        try:
            os.makedirs(self._resolve(path), exist_ok=True)
            return True
        except Exception:
            return False

    def _createfile(self, path):
        try:
            p = self._resolve(path)
            parent = os.path.dirname(p)
            if parent:
                os.makedirs(parent, exist_ok=True)
            with open(p, 'a', encoding='utf-8'):
                pass
            return True
        except Exception:
            return False

    def _removefile(self, path):
        try:
            os.remove(self._resolve(path))
            return True
        except Exception:
            return False

    def _removedir(self, path):
        try:
            import shutil
            shutil.rmtree(self._resolve(path))
            return True
        except Exception:
            return False

    def _move(self, src, dst):
        try:
            import shutil
            shutil.move(self._resolve(src), self._resolve(dst))
            return True
        except Exception:
            return False

    def get_docs(self):
        return {
            'write': 'io::write(path, content) success; — Write content to file',
            'read': 'io::read(path) content; — Read file contents as string',
            'exists': 'io::exists(path) result; — Check if file/dir exists (bool)',
            'createdir': 'io::createdir(path) success; — Create directory (recursive)',
            'createfile': 'io::createfile(path) success; — Create empty file',
            'removefile': 'io::removefile(path) success; — Delete a file',
            'removedir': 'io::removedir(path) success; — Delete a directory (recursive)',
            'move': 'io::move(src, dst) success; — Move/rename file or directory',
        }


class CsscCsslModule(CsscModule):
    """cssl - Run CSSL code from within CSSC with full interop.

    Usage: #include("cssl") cssl;
    Provides: cssl::run, cssl::execute, cssl::resolve, cssl::resolve_exists, cssl::validate
    """
    _name = 'cssl'

    def __init__(self, script_dir=''):
        self._script_dir = script_dir
        self._runtime = None  # kept alive for shared object access

    def _resolve_path(self, path):
        p = os.path.expanduser(path)
        if not os.path.isabs(p) and self._script_dir:
            p = os.path.join(self._script_dir, p)
        return os.path.normpath(p)

    def _get_runtime(self):
        """Get or create a persistent CSSL runtime (keeps share() objects alive)."""
        if self._runtime is None:
            from includecpp.core.cssl.cssl_runtime import CSSLRuntime
            self._runtime = CSSLRuntime()
        return self._runtime

    def get_namespace(self):
        return {
            'run': self._run,
            'execute': self._execute,
            'resolve': self._resolve,
            'resolve_exists': self._resolve_exists,
            'validate': self._validate,
        }

    def _run(self, path, *args):
        """Run a .cssl file and return output as a list of lines. Runtime stays alive.

        Args passed are available via include("sys") in the CSSL script.
        """
        try:
            import io as _io
            runtime = self._get_runtime()
            resolved = self._resolve_path(path)
            with open(resolved, 'r', encoding='utf-8') as f:
                source = f.read()
            runtime.clear_output()
            # Pass args to the runtime so sys module can access them
            if args:
                runtime._script_args = list(args)
            # Suppress stdout so CSSL doesn't print directly — only capture
            old_stdout = sys.stdout
            sys.stdout = _io.StringIO()
            try:
                runtime.execute_program(source)
            finally:
                captured = sys.stdout.getvalue()
                sys.stdout = old_stdout
            output = runtime.get_output() or captured
            return output.splitlines() if output else []
        except Exception as e:
            raise CsscError(operation='Runtime', detail=f'cssl::run failed: {e}')

    def _execute(self, rows):
        """Execute CSSL code from a list of strings. Runtime stays alive."""
        try:
            import io as _io
            runtime = self._get_runtime()
            if isinstance(rows, list):
                source = '\n'.join(str(r) for r in rows)
            else:
                source = str(rows)
            runtime.clear_output()
            old_stdout = sys.stdout
            sys.stdout = _io.StringIO()
            try:
                runtime.execute_program(source)
            finally:
                captured = sys.stdout.getvalue()
                sys.stdout = old_stdout
            output = runtime.get_output() or captured
            return output.splitlines() if output else []
        except Exception as e:
            raise CsscError(operation='Runtime', detail=f'cssl::execute failed: {e}')

    def _resolve(self, name):
        """Resolve a shared object by name from the CSSL runtime."""
        try:
            from includecpp.core.cssl_bridge import _live_objects
        except ImportError:
            raise CsscError(operation='Runtime', detail='cssl::resolve: cssl_bridge not available')
        name = str(name)
        if name not in _live_objects:
            raise CsscError(operation='Runtime', detail=f'cssl::resolve: "{name}" not found. Use share("{name}", obj) in CSSL first.')
        obj = _live_objects[name]
        # If callable (function), return it directly — CSSC can call it
        if callable(obj) and not isinstance(obj, type):
            return obj
        # If it's a class or instance, CSSC can't handle OOP — use validate() first
        return obj

    def _resolve_exists(self, name):
        """Check if a shared object exists."""
        try:
            from includecpp.core.cssl_bridge import _live_objects
        except ImportError:
            return False
        return str(name) in _live_objects

    def _validate(self, name):
        """Check if a shared object can be used by CSSC (not a class/instance)."""
        try:
            from includecpp.core.cssl_bridge import _live_objects
        except ImportError:
            return False
        name = str(name)
        if name not in _live_objects:
            return False
        obj = _live_objects[name]
        # Classes and class instances can't be used in CSSC (no OOP)
        if isinstance(obj, type):
            return False
        if hasattr(obj, '__dict__') and hasattr(type(obj), '__mro__') and type(obj).__name__ not in ('function', 'builtin_function_or_method', 'method'):
            # It's a class instance — check if it's a simple type
            if not isinstance(obj, (int, float, str, bool, list, dict, tuple)):
                return False
        return True

    def get_docs(self):
        return {
            'run': 'cssl::run(path) output; — Run a .cssl file, returns output as list of lines',
            'execute': 'cssl::execute(rows) output; — Execute CSSL code from list of strings',
            'resolve': 'cssl::resolve(name) obj; — Get a shared object from CSSL (via share())',
            'resolve_exists': 'cssl::resolve_exists(name) bool; — Check if shared object exists',
            'validate': 'cssl::validate(name) bool; — Check if shared object is CSSC-compatible (no OOP)',
        }


class CsscBinaryModule(CsscModule):
    """cssc.binary — Binary data I/O for CSSC.

    Usage: #include("cssc.binary") cbin;
    Provides: cbin::read, cbin::write, cbin::tobinary, cbin::frombinary,
              cbin::typeof, cbin::add, cbin::find, cbin::contains,
              cbin::delete, cbin::get, cbin::getBytes
    """
    _name = 'cssc.binary'

    def __init__(self, script_dir=''):
        self._script_dir = script_dir
        self._binary = None

    def _get_binary(self):
        if self._binary is None:
            from includecpp.core.cssl.cssl_binary import CsslBinary
            self._binary = CsslBinary()
        return self._binary

    def _resolve_path(self, path):
        p = os.path.expanduser(str(path))
        if not os.path.isabs(p) and self._script_dir:
            p = os.path.join(self._script_dir, p)
        return os.path.normpath(p)

    def get_namespace(self):
        return {
            'read': self._read,
            'write': self._write,
            'tobinary': self._tobinary,
            'frombinary': self._frombinary,
            'typeof': self._typeof,
            'add': self._add,
            'find': self._find,
            'contains': self._contains,
            'delete': self._delete,
            'get': self._get,
            'getBytes': self._getBytes,
        }

    def _read(self, path):
        """cbin::read(path) bin; — Read binary file into Binary object."""
        return self._get_binary().read(self._resolve_path(path))

    def _write(self, path, binary):
        """cbin::write(path, binary) — Write Binary object to file."""
        return self._get_binary().write(self._resolve_path(path), binary)

    def _tobinary(self, value):
        """cbin::tobinary(value) bin; — Convert any value to Binary."""
        return self._get_binary().tobinary(value)

    def _frombinary(self, binary, target_type=''):
        """cbin::frombinary(binary, type) val; — Extract data from Binary, cast to type."""
        return self._get_binary().frombinary(binary, target_type)

    def _typeof(self, binary):
        """cbin::typeof(binary) type; — Get stored type name from Binary metadata."""
        if hasattr(binary, '_metadata') and isinstance(binary._metadata, dict):
            return binary._metadata.get('type', type(binary).__name__)
        return type(binary).__name__

    def _add(self, binary, id_key, data):
        """cbin::add(binary, id, data) bin; — Embed named data in Binary."""
        return self._get_binary().add(binary, id_key, data)

    def _find(self, binary, id_key):
        """cbin::find(binary, id) val; — Extract embedded data by id."""
        return self._get_binary().find(binary, id=id_key)

    def _contains(self, binary, id_key):
        """cbin::contains(binary, id) exists; — Check if embedded data exists."""
        return self._get_binary().contains(binary, id=id_key)

    def _delete(self, binary, id_key):
        """cbin::delete(binary, id) bin; — Remove embedded data by id."""
        return self._get_binary().delete(binary, id=id_key)

    def _get(self, binary, id_key):
        """cbin::get(binary, id) val; — Alias for find."""
        return self._get_binary().get(binary, id=id_key)

    def _getBytes(self, binary):
        """cbin::getBytes(binary) bytes; — Get raw bytes as string."""
        result = self._get_binary().getBytes(binary)
        if isinstance(result, bytes):
            try:
                return result.decode('utf-8')
            except UnicodeDecodeError:
                return result.hex()
        return str(result)

    def get_docs(self):
        return {
            'read': 'cbin::read(path) bin; — Read binary file into Binary object',
            'write': 'cbin::write(path, binary) — Write Binary to file',
            'tobinary': 'cbin::tobinary(value) bin; — Convert any value to Binary',
            'frombinary': 'cbin::frombinary(binary, type) val; — Extract data, cast to type',
            'typeof': 'cbin::typeof(binary) type; — Get stored type name from binary',
            'add': 'cbin::add(binary, id, data) bin; — Embed named data in binary',
            'find': 'cbin::find(binary, id) val; — Extract embedded data by id',
            'contains': 'cbin::contains(binary, id) bool; — Check if data exists',
            'delete': 'cbin::delete(binary, id) bin; — Remove embedded data',
            'get': 'cbin::get(binary, id) val; — Alias for find',
            'getBytes': 'cbin::getBytes(binary) str; — Get raw bytes as string',
        }


class CsscSharedLibModule(CsscModule):
    """SharedLib — Shared library communication between CSSC and CSSL runtimes.

    Provides the CSSC-side API for cross-runtime data processing.
    Components: SCP (communication), EHP (data handling), IL (ID linking), PRG (finalization).

    Usage::

        #include("SharedLib") sl;
        #heap[vector<map<map<string, string>, bind>>, 8000] global;
        sl::setup(global);
        sl::linkSCP(*handler);

    API:
        sl::setup(globalVar)       — initialize shared state with a global vector
        sl::global                 — access the shared global vector
        sl::add(id, data)          — register new item in pipeline (EHP stage)
        sl::map(id, bound)         — map a binding to an ID for IL tracking
        sl::warn(msg)              — log warning
        sl::error(msg)             — log error (non-fatal)
        sl::accept(id)             — mark package as processed (IL→PRG→FD)
        sl::linkSCP(handler)       — link SCP handler function
        sl::stage(id)              — get current pipeline stage for an item
        sl::warnings()             — get all warnings
        sl::errors()               — get all errors
    """
    _name = 'SharedLib'

    def __init__(self):
        super().__init__()
        from .cssl_sharedlib_ipc import get_shared_state
        self._state = get_shared_state()

    def get_namespace(self):
        return {
            'setup': self._setup,
            'global': self._state.global_vector,
            'add': self._add,
            'map': self._map,
            'warn': self._warn,
            'error': self._error,
            'accept': self._accept,
            'linkSCP': self._link_scp,
            'stage': self._stage,
            'warnings': self._get_warnings,
            'errors': self._get_errors,
        }

    def _setup(self, global_var):
        """sl::setup(globalVar) — Initialize shared state with a global vector.

        Connects the CSSC-side global vector to the shared IPC state,
        so both runtimes see the same data.
        """
        if isinstance(global_var, list):
            self._state.setup(global_var)
        return True

    def _add(self, item_id, data):
        """sl::add(id, data) → stamp

        Register a new item in the shared pipeline (EHP stage).
        Returns the generated stamp string.
        """
        return self._state.add_item(str(item_id), data)

    def _map(self, source_id, binding):
        """sl::map(id, bound) → {success, message}

        Map a binding to a source ID for IL (ID Linker) tracking.
        Returns a map with success boolean and message.
        """
        success, message = self._state.map_binding(str(source_id), binding)
        return {0: success, 1: message}

    def _warn(self, message):
        """sl::warn(msg) — Log a SharedLib warning."""
        self._state.warn(str(message))

    def _error(self, message):
        """sl::error(msg) — Log a SharedLib error (non-fatal)."""
        self._state.error(str(message))

    def _accept(self, item_id, result=None):
        """sl::accept(id) — Mark package as processed (moves to FD stage).

        After accept, the result is available to the CSSL side via async::await.
        """
        return self._state.accept(str(item_id), result)

    def _link_scp(self, handler):
        """sl::linkSCP(handler) — Link an SCP handler function.

        The handler is called with (msg_type, payload) for each SCP message.
        Also starts the SCP dispatcher thread if not already running.
        """
        if callable(handler):
            self._state.scp_register(handler)
            self._state.scp_start_dispatcher()
            return True
        return False

    def _stage(self, item_id):
        """sl::stage(id) — Get current pipeline stage for an item."""
        return self._state.get_stage(str(item_id))

    def _get_warnings(self):
        """sl::warnings() — Get all collected warnings."""
        return self._state.get_warnings()

    def _get_errors(self):
        """sl::errors() — Get all collected errors."""
        return self._state.get_errors()

    def get_docs(self):
        return {
            'setup': 'sl::setup(globalVar) — Initialize shared state with a global vector',
            'global': 'sl::global — Access the shared global vector (read/write)',
            'add': 'sl::add(id, data) → stamp — Register new item in shared pipeline (EHP stage)',
            'map': 'sl::map(id, bound) → {success, message} — Map binding to ID for IL tracking',
            'warn': 'sl::warn(msg) — Log a SharedLib warning',
            'error': 'sl::error(msg) — Log a SharedLib error (non-fatal)',
            'accept': 'sl::accept(id) — Mark package as processed (→FD stage)',
            'linkSCP': 'sl::linkSCP(handler) — Link SCP handler function for cross-runtime messages',
            'stage': 'sl::stage(id) — Get current pipeline stage (EHP/IL/PRG/FD)',
            'warnings': 'sl::warnings() — Get all collected warnings',
            'errors': 'sl::errors() — Get all collected errors',
        }


# CCOS freestanding kernel intrinsics — `cssc::outb`, `cssc::poke32`,
# `cssc::hlt`, `cssc::lgdt`, `cssc::rdmsr`, the Limine `cssc::fb*` accessors,
# etc. These lower to raw CPU instructions / MMIO on the bare-metal `ccos`
# target and are meaningless in the host interpreter. The interpreter rejects
# them up front so both engines agree: they are compile-and-run-on-hardware
# only (parity with the native lowering, which emits them solely for the
# freestanding runtime profile).
_CCOS_FREESTANDING_INTRINSICS = frozenset({
    'outb', 'outw', 'outl', 'inb', 'inw', 'inl',
    'poke8', 'poke16', 'poke32', 'poke64',
    'peek8', 'peek16', 'peek32', 'peek64', 'memfill32', 'memcopy',
    'alloc', 'readCs', 'shl', 'shr', 'band', 'bor', 'bxor', 'fontRow',
    'hlt', 'cli', 'sti', 'pause', 'lgdt', 'lidt', 'ltr',
    'readCr0', 'readCr2', 'readCr3', 'readCr4',
    'writeCr0', 'writeCr3', 'writeCr4',
    'invlpg', 'rdmsr', 'wrmsr', 'rdtsc',
    'fbAddr', 'fbWidth', 'fbHeight', 'fbPitch', 'fbBpp', 'hhdmOffset',
    'memmapCount', 'memmapBase', 'memmapLength', 'memmapType',
    'memUsable', 'heapUsed', 'framesFree', 'framesTotal',
})


# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
class CsscRuntime:
    """Execute CSSC AST with full resource management and namespace builtins."""

    def __init__(self, **kwargs):
        self._variables = {}
        self._variable_types = {}
        self._resources = {}
        self._modules = {}
        self._output_path = None
        self._output_buffer = []
        self._script_dir = kwargs.get('script_dir', os.getcwd())
        self._search_paths = kwargs.get('search_paths', [])
        self._running = True
        self._exit_code = 0
        self._ns_builtins = {}
        self._script_args = kwargs.get('args', [])
        # C++ acceleration
        self._accel = _CSSC_ACCEL
        self._cpp_scope = _cssc_accel_mod.CsscScope() if self._accel else None
        self._cpp_mem = _cssc_accel_mod.CsscMemPool() if self._accel and hasattr(_cssc_accel_mod, 'CsscMemPool') else None
        self._register_cssc_builtins()

    def _register_cssc_builtins(self):
        self._ns_builtins = {
            # I/O (15)
            'cout': self._b_cout, 'coutln': self._b_coutln, 'out': self._b_cout, 'outln': self._b_coutln, 'in': self._b_cin, 'input': self._b_cin,
            'cerr': self._b_cerr, 'clog': self._b_clog,
            'read_file': self._b_read_file, 'write_file': self._b_write_file,
            'append_file': self._b_append_file, 'file_exists': self._b_file_exists,
            'delete_file': self._b_delete_file, 'copy_file': self._b_copy_file,
            'move_file': self._b_move_file, 'file_size': self._b_file_size,
            'list_dir': self._b_list_dir, 'mkdir': self._b_mkdir,
            # String (20)
            'strlen': lambda s: len(str(s)),
            'substr': lambda s, start, length=-1: str(s)[int(start):] if length == -1 else str(s)[int(start):int(start)+int(length)],
            'replace': lambda s, old, new: str(s).replace(str(old), str(new)),
            'split': lambda s, sep=' ': str(s).split(str(sep)),
            'join': lambda arr, sep='': str(sep).join(str(x) for x in arr) if isinstance(arr, list) else str(arr),
            'trim': lambda s: str(s).strip(),
            'ltrim': lambda s: str(s).lstrip(),
            'rtrim': lambda s: str(s).rstrip(),
            'upper': lambda s: str(s).upper(),
            'lower': lambda s: str(s).lower(),
            'contains': lambda s, sub: str(sub) in str(s),
            'starts_with': lambda s, p: str(s).startswith(str(p)),
            'ends_with': lambda s, p: str(s).endswith(str(p)),
            'index_of': lambda s, sub: str(s).find(str(sub)),
            'last_index_of': lambda s, sub: str(s).rfind(str(sub)),
            'char_at': lambda s, i: str(s)[int(i)] if 0 <= int(i) < len(str(s)) else '',
            'repeat': lambda s, n: str(s) * int(n),
            'reverse': lambda s: str(s)[::-1],
            'pad_left': lambda s, n, ch=' ': str(s).rjust(int(n), str(ch)[0] if ch else ' '),
            'pad_right': lambda s, n, ch=' ': str(s).ljust(int(n), str(ch)[0] if ch else ' '),
            # Math (20)
            'abs': lambda x: abs(x),
            'min': lambda a, b: min(a, b),
            'max': lambda a, b: max(a, b),
            'floor': lambda x: math.floor(x),
            'ceil': lambda x: math.ceil(x),
            'round': lambda x, n=0: round(x, int(n)),
            'sqrt': lambda x: math.sqrt(x),
            'pow': lambda x, y: math.pow(x, y),
            'log': lambda x: math.log(x),
            'log10': lambda x: math.log10(x),
            'sin': lambda x: math.sin(x),
            'cos': lambda x: math.cos(x),
            'tan': lambda x: math.tan(x),
            'pi': lambda: math.pi,
            'e_const': lambda: math.e,
            'random': lambda: random.random(),
            'random_int': lambda a, b: random.randint(int(a), int(b)),
            'random_float': lambda a, b: random.uniform(float(a), float(b)),
            'random_choice': lambda arr: random.choice(arr) if isinstance(arr, list) and arr else None,
            'clamp': lambda x, lo, hi: max(lo, min(x, hi)),
            # Array (20)
            'len': self._b_len,
            'push': lambda arr, val: (arr.append(val), arr)[-1] if isinstance(arr, list) else arr,
            'pop': lambda arr: arr.pop() if isinstance(arr, list) and arr else None,
            'shift': lambda arr: arr.pop(0) if isinstance(arr, list) and arr else None,
            'unshift': lambda arr, val: ([arr.insert(0, val), arr][-1]) if isinstance(arr, list) else arr,
            'slice': lambda arr, start, end=None: arr[int(start):] if end is None else arr[int(start):int(end)],
            'sort': lambda arr: sorted(arr) if isinstance(arr, list) else arr,
            'getIndex': lambda arr, i: arr[int(i)] if isinstance(arr, (list, tuple)) and 0 <= int(i) < len(arr) else None,
            'reverse_arr': lambda arr: list(reversed(arr)) if isinstance(arr, list) else arr,
            'find': lambda arr, val: arr.index(val) if isinstance(arr, list) and val in arr else -1,
            'concat': lambda a, b: (a if isinstance(a, list) else [a]) + (b if isinstance(b, list) else [b]),
            'unique': lambda arr: list(dict.fromkeys(arr)) if isinstance(arr, list) else arr,
            'flatten': lambda arr: [item for sub in arr for item in (sub if isinstance(sub, list) else [sub])] if isinstance(arr, list) else arr,
            'range': lambda start, end=None, step=1: list(range(int(start), int(end), int(step))) if end is not None else list(range(int(start))),
            'zip_arr': lambda a, b: list(zip(a, b)) if isinstance(a, list) and isinstance(b, list) else [],
            'fill': lambda n, val=0: [val] * int(n),
            'count': lambda arr, val: arr.count(val) if isinstance(arr, list) else 0,
            'sum': lambda arr: sum(arr) if isinstance(arr, list) else 0,
            'avg': lambda arr: sum(arr) / len(arr) if isinstance(arr, list) and arr else 0,
            'map_arr': lambda arr, fn: arr,
            'filter_arr': lambda arr, fn: arr,
            # Map (10)
            'keys': lambda m: list(m.keys()) if isinstance(m, dict) else [],
            'values': lambda m: list(m.values()) if isinstance(m, dict) else [],
            'has_key': lambda m, k: k in m if isinstance(m, dict) else False,
            'merge': lambda a, b: {**a, **b} if isinstance(a, dict) and isinstance(b, dict) else a,
            'entries': lambda m: list(m.items()) if isinstance(m, dict) else [],
            'from_entries': lambda arr: dict(arr) if isinstance(arr, list) else {},
            'map_keys': lambda m: list(m.keys()) if isinstance(m, dict) else [],
            'map_values': lambda m: list(m.values()) if isinstance(m, dict) else [],
            'map_size': lambda m: len(m) if isinstance(m, dict) else 0,
            'map_remove': lambda m, k: (m.pop(k, None), m)[-1] if isinstance(m, dict) else m,
            # Type (15)
            'typeof': self._b_typeof,
            'to_int': lambda v: int(v) if v is not None else 0,
            'to_float': lambda v: float(v) if v is not None else 0.0,
            'to_string': lambda v: str(v) if v is not None else 'null',
            'to_str': lambda v: str(v) if v is not None else 'null',
            'toString': lambda v: str(v) if v is not None else 'null',
            'to_bool': lambda v: bool(v),
            'to_array': lambda v: list(v) if hasattr(v, '__iter__') and not isinstance(v, str) else [v] if v is not None else [],
            'to_map': lambda v: dict(v) if isinstance(v, (list, tuple)) else {} if v is None else {'value': v},
            'is_int': lambda v: isinstance(v, int) and not isinstance(v, bool),
            'is_float': lambda v: isinstance(v, float),
            'is_string': lambda v: isinstance(v, str),
            'is_array': lambda v: isinstance(v, list),
            'is_map': lambda v: isinstance(v, dict),
            'is_bool': lambda v: isinstance(v, bool),
            'is_null': lambda v: v is None,
            'is_number': lambda v: isinstance(v, (int, float)) and not isinstance(v, bool),
            # Time (8)
            'time': lambda: time.time(),
            'timestamp': lambda: int(time.time()),
            'sleep': lambda ms: time.sleep(ms / 1000.0),
            'date': lambda: time.strftime('%Y-%m-%d'),
            'datetime': lambda: time.strftime('%Y-%m-%d %H:%M:%S'),
            'time_format': lambda fmt: time.strftime(fmt),
            'clock': lambda: time.perf_counter(),
            'elapsed': lambda start: time.perf_counter() - start,
            'detime': lambda: (lambda t: t.tm_hour + t.tm_min / 100.0)(time.localtime()),
            'sdetime': lambda: (lambda t: t.tm_min + t.tm_sec / 100.0)(time.localtime()),
            # Monotonic seconds-since-process-start. Mirrors the native
            # cssc_builtin_uptime — always live, no RTC dependency.
            'uptime': lambda: time.perf_counter(),
            # Process exit / restart (mirrors ESP.restart on chip).
            'reboot': lambda: self._b_exit(0),
            # Diagnostics markers — emit `[cssc-mem]` / `[cssc-cpu]` lines
            # the `cssc diagnostics` window parses. Same shape in both
            # interpreter paths so output is consistent.
            'diag_mem': self._b_diag_mem,
            'diag_cpu': self._b_diag_cpu,
            'diag_enable': self._b_diag_enable,
            # System (10)
            'env': lambda name: os.environ.get(str(name), ''),
            'set_env': lambda name, val: os.environ.__setitem__(str(name), str(val)),
            'cwd': lambda: os.getcwd(),
            'chdir': lambda p: os.chdir(p),
            'basename': lambda p: os.path.basename(str(p)),
            'dirname': lambda p: os.path.dirname(str(p)),
            'stem': lambda p: os.path.splitext(os.path.basename(str(p)))[0],
            'exec': self._b_exec,
            'exit': self._b_exit,
            'args': lambda: sys.argv[1:],
            'platform': lambda: sys.platform,
            'hostname': lambda: platform.node(),
            'user': lambda: os.environ.get('USER', os.environ.get('USERNAME', '')),
            # Hash/Encode (6)
            'md5': lambda s: hashlib.md5(str(s).encode()).hexdigest(),
            'sha256': lambda s: hashlib.sha256(str(s).encode()).hexdigest(),
            'base64_encode': lambda s: __import__('base64').b64encode(str(s).encode()).decode(),
            'base64_decode': lambda s: __import__('base64').b64decode(str(s)).decode(),
            'json_encode': lambda v: json.dumps(v),
            'json_decode': lambda s: json.loads(str(s)),
            # Format (4)
            'format': lambda fmt, *a: str(fmt).format(*a),
            'sprintf': lambda fmt, *a: fmt % a if a else fmt,
            'number_format': lambda n, dec=2: f'{float(n):.{int(dec)}f}',
            'hex': lambda n: hex(int(n)),
            'run': self._b_run_cssc,
        }

    def _b_run_cssc(self, path, *args):
        """cssc::run(path, args...) — Run another .cssc script with args."""
        try:
            resolved = path
            if not os.path.isabs(path):
                resolved = os.path.join(self._script_dir, path)
            with open(resolved, 'r', encoding='utf-8') as f:
                source = f.read()
            tokens = CsscLexer(source, resolved).tokenize()
            ast = CsscParser(tokens, resolved).parse()
            child_rt = self.__class__(
                script_dir=os.path.dirname(os.path.abspath(resolved)),
                args=list(args),
            )
            child_rt.execute(ast)
            return ''.join(child_rt._output_buffer).splitlines()
        except Exception as e:
            raise CsscError(operation='Runtime', detail=f'cssc::run failed: {e}')

    # -- I/O builtins -------------------------------------------------------
    def _format_value(self, v):
        if v is None:
            return '0x0'
        # bool BEFORE int (bool ⊂ int): native cssc_bool_to_str emits the
        # canonical lowercase 'true'/'false', not Python's 'True'/'False'.
        if isinstance(v, bool):
            return 'true' if v else 'false'
        if isinstance(v, CsscSector):
            return hex(id(v))
        if isinstance(v, CsscIterator):
            return f'iterator@{v._index}'
        if CsscMethodBinding is not None and isinstance(v, CsscMethodBinding):
            return self._format_value(v.get_value())
        if CsscMethod is not None and isinstance(v, CsscMethod):
            return f'Method({v._name})'
        if isinstance(v, CsscMatrix):
            return f'Matrix({v._width}x{v._height})'
        if isinstance(v, CsscPointer):
            resolved = self._resolve_value(v)
            if resolved is None or isinstance(resolved, CsscPointer):
                return '0x0'
            return self._format_value(resolved)
        if isinstance(v, CsscBind):
            inner = '; '.join(f'{self._format_value(a)}, {self._format_value(b)}' for a, b in v)
            return '{' + inner + '}'
        if isinstance(v, tuple) and len(v) == 2:
            return f'{self._format_value(v[0])}, {self._format_value(v[1])}'
        if isinstance(v, list):
            inner = ', '.join(self._format_value(x) for x in v)
            return '{' + inner + '}'
        if isinstance(v, dict):
            keys = list(v.keys())
            is_indexed = all(isinstance(k, int) and k == i for i, k in enumerate(keys))
            if is_indexed and keys:
                inner = ', '.join(self._format_value(v[k]) for k in keys)
            else:
                inner = ', '.join(f'{k}: {self._format_value(val)}' for k, val in v.items())
            return '{' + inner + '}'
        return str(v)

    def _b_cout(self, *args):
        text = ' '.join(self._format_value(a) for a in args)
        self._output_buffer.append(text)
        print(text, end='')

    def _b_coutln(self, *args):
        text = ' '.join(self._format_value(a) for a in args)
        self._output_buffer.append(text + '\n')
        print(text)

    def _b_cin(self, prompt=''):
        return input(str(prompt))

    def _b_cerr(self, *args):
        text = ' '.join(self._format_value(a) for a in args)
        print(text, file=sys.stderr, end='')

    def _b_clog(self, *args):
        text = ' '.join(self._format_value(a) for a in args)
        print(f'[CSSC LOG] {text}', file=sys.stderr)

    def _b_read_file(self, path):
        resolved = self._resolve_path(path)
        if resolved and os.path.isfile(resolved):
            with open(resolved, 'r', encoding='utf-8') as fh:
                return fh.read()
        return ''

    def _b_write_file(self, path, content):
        try:
            with open(self._resolve_path(path) or path, 'w', encoding='utf-8') as fh:
                fh.write(str(content))
            return True
        except Exception:
            return False

    def _b_append_file(self, path, content):
        try:
            with open(self._resolve_path(path) or path, 'a', encoding='utf-8') as fh:
                fh.write(str(content))
            return True
        except Exception:
            return False

    def _b_file_exists(self, path):
        resolved = self._resolve_path(path)
        return resolved is not None and os.path.exists(resolved)

    def _b_delete_file(self, path):
        resolved = self._resolve_path(path)
        if resolved and os.path.isfile(resolved):
            os.remove(resolved)
            return True
        return False

    def _b_copy_file(self, src, dst):
        try:
            shutil.copy2(self._resolve_path(src), self._resolve_path(dst) or dst)
            return True
        except Exception:
            return False

    def _b_move_file(self, src, dst):
        try:
            shutil.move(self._resolve_path(src), self._resolve_path(dst) or dst)
            return True
        except Exception:
            return False

    def _b_file_size(self, path):
        resolved = self._resolve_path(path)
        return os.path.getsize(resolved) if resolved and os.path.isfile(resolved) else -1

    def _b_list_dir(self, path='.'):
        resolved = self._resolve_path(path)
        return os.listdir(resolved) if resolved and os.path.isdir(resolved) else []

    def _b_mkdir(self, path):
        try:
            os.makedirs(self._resolve_path(path) or path, exist_ok=True)
            return True
        except Exception:
            return False

    def _b_len(self, value):
        if value is None:
            return 0
        try:
            return len(value)
        except TypeError:
            return 0

    def _b_typeof(self, value):
        if value is None: return 'null'
        if isinstance(value, bool): return 'bool'
        if isinstance(value, CsscVector): return 'vector'
        if isinstance(value, CsscMap): return 'map'
        if isinstance(value, CsscBind): return 'bind'
        # A `#define`d slot is an index-based `map<int>` ([0]=value,
        # [1]=address) — so it reports as `map`, letting user code detect
        # "is this slot a function yet?" via `typeof(x) == typeof(aMap)`.
        if isinstance(value, CsscFunction): return 'map'
        if isinstance(value, CsscIterator): return 'iterator'
        _ensure_method_imports()
        if CsscMethodBinding is not None and isinstance(value, CsscMethodBinding): return self._b_typeof(value.get_value())
        if CsscMethod is not None and isinstance(value, CsscMethod): return 'method'
        if isinstance(value, CsscMatrix): return 'matrix'
        if isinstance(value, CsscObject): return 'object'
        if isinstance(value, int): return 'int'
        if isinstance(value, float): return 'float'
        if isinstance(value, str): return 'string'
        if isinstance(value, list): return 'array'
        if isinstance(value, dict): return 'map'
        return type(value).__name__

    def _slot_value_snapshot(self, name):
        """Current value of `name` (from the C++ accel scope if active,
        else `_variables`). Used by the `#define` upgrade so a variable's
        pre-`#define` value survives at `[0]` — a variable IS a function
        whose value slot is `[0]`, so `#stack[int] x = 201; #define(x){…}`
        must keep `x[0] == 201`."""
        if getattr(self, '_accel', None) and self._cpp_scope.has(name):
            t = self._cpp_scope.get_type(name)
            if t == 1: return self._cpp_scope.get_int(name, True)
            if t == 2: return self._cpp_scope.get_float(name, True)
            if t == 3: return self._cpp_scope.get_str(name, True)
            if t == 4: return self._cpp_scope.get_bool(name, True)
        return self._variables.get(name)

    def _b_exec(self, command):
        try:
            result = subprocess.run(str(command), shell=True, capture_output=True, text=True, timeout=30)
            return result.stdout.strip()
        except subprocess.TimeoutExpired:
            return ''
        except Exception as e:
            return str(e)

    def _b_exit(self, code=0):
        self._exit_code = int(code)
        self._running = False

    def _b_diag_mem(self):
        if not getattr(self, '_diag_enabled', True):
            return 0
        try:
            import psutil   # type: ignore
            free_now = int(psutil.virtual_memory().available)
        except Exception:
            free_now = 0
        cur_min = getattr(self, '_diag_min_free', 0xFFFFFFFF)
        if free_now and free_now < cur_min:
            self._diag_min_free = free_now
            cur_min = free_now
        sys.stdout.write(f"[cssc-mem] heap={free_now} free={cur_min}\n")
        sys.stdout.flush()
        return free_now

    def _b_diag_cpu(self, name, ms):
        if not getattr(self, '_diag_enabled', True):
            return
        try:
            ms_int = int(ms)
        except Exception:
            ms_int = 0
        sys.stdout.write(f"[cssc-cpu] {name} {ms_int}.0ms\n")
        sys.stdout.flush()

    def _b_diag_enable(self, on):
        self._diag_enabled = bool(on)
        if self._diag_enabled:
            self._diag_min_free = 0xFFFFFFFF

    def _resolve_path(self, path):
        p = str(path)
        if os.path.isabs(p):
            return p
        candidate = os.path.join(self._script_dir, p)
        if os.path.exists(candidate):
            return candidate
        for sp in self._search_paths:
            candidate = os.path.join(sp, p)
            if os.path.exists(candidate):
                return candidate
        return os.path.join(self._script_dir, p)

    def _depend_locate(self, raw_path):
        """Locate a .obj referenced by #depend['...']. Tries, in order:
          1. Literal path (absolute or relative-to-cwd)
          2. Leading '/' stripped, relative to cwd then script_dir
          3. %APPDATA%/cssc/objects/<basename>[.obj]
        """
        if not raw_path:
            return None
        if os.path.isfile(raw_path):
            return os.path.abspath(raw_path)
        stripped = raw_path.lstrip('/\\')
        for base in (os.getcwd(), self._script_dir):
            if not base:
                continue
            c = os.path.join(base, stripped)
            if os.path.isfile(c):
                return os.path.abspath(c)
        try:
            from includecpp.core.cssl.native import cssc_obj_format as _obj_fmt
            basename = os.path.basename(stripped)
            name_no_ext = basename[:-4] if basename.endswith('.obj') else basename
            installed = _obj_fmt.resolve_installed(name_no_ext)
            if installed:
                return installed
        except Exception:
            pass
        return None

    # -- Module loading (#include) ------------------------------------------
    def _load_module(self, module_name):
        def _lazy_import(mod_file, cls_name):
            import importlib
            mod = importlib.import_module(f'.{mod_file}', package='includecpp.core.cssl')
            return getattr(mod, cls_name)()

        def _lazy_import_with_rt(mod_file, cls_name):
            import importlib
            mod = importlib.import_module(f'.{mod_file}', package='includecpp.core.cssl')
            return getattr(mod, cls_name)(runtime=self)

        def _lazy_import_with_dir(mod_file, cls_name):
            import importlib
            mod = importlib.import_module(f'.{mod_file}', package='includecpp.core.cssl')
            return getattr(mod, cls_name)(script_dir=self._script_dir)

        modules = {
            'cssc.dll': lambda: CsscDllModule(self._script_dir),
            'cssc.ini': lambda: CsscIniModule(self._script_dir),
            'cssc.paths': lambda: CsscPathsModule(self._script_dir),
            'cssc.env': lambda: CsscEnvModule(),
            'cssc.sys': lambda: CsscSysModule(),
            'cssc.io': lambda: CsscIoModule(self._script_dir),
            'cssc.fastif': lambda: CsscFastIfModule(),
            'cssc.peek': lambda: CsscPeekModule(),
            'peek': lambda: CsscPeekModule(),
            'def': lambda: CsscDefineModule(),
            'cssc.math': lambda: CsscMathModule(),
            'stdio': lambda: CsscStdioModule(self._script_dir),
            'sizes': lambda: CsscSizesModule(),
            'cssl': lambda: CsscCsslModule(self._script_dir),
            'cssc.binary': lambda: CsscBinaryModule(self._script_dir),
            'stdout': lambda: CsscStdoutModule(),
            'sys': lambda: CsscSysArgsModule(args=getattr(self, '_script_args', None)),
            'SharedLib': lambda: CsscSharedLibModule(),
            'matrix': lambda: _lazy_import('cssl_matrix', 'CsscMatrixModule'),
            'video': lambda: _lazy_import('cssl_video', 'CsscVideoModule'),
            'video.sprite':  lambda: _lazy_import('cssl_video_sprite', 'CsscVideoSpriteModule'),
            'sprite':        lambda: _lazy_import('cssl_video_sprite', 'CsscVideoSpriteModule'),
            'video.tilemap': lambda: _lazy_import('cssl_video_tilemap', 'CsscVideoTilemapModule'),
            'tilemap':       lambda: _lazy_import('cssl_video_tilemap', 'CsscVideoTilemapModule'),
            'video.font':    lambda: _lazy_import('cssl_video_font', 'CsscVideoFontModule'),
            'bitmapfont':    lambda: _lazy_import('cssl_video_font', 'CsscVideoFontModule'),
            'math.accel':    lambda: _lazy_import('cssl_math_accel', 'CsscMathAccelModule'),
            'mathaccel':     lambda: _lazy_import('cssl_math_accel', 'CsscMathAccelModule'),
            'accel.math':    lambda: _lazy_import('cssl_math_accel', 'CsscMathAccelModule'),
            'asyncthreads': lambda: _lazy_import_with_rt('cssl_asyncthreads', 'CsscAsyncThreadsModule'),
            'serialcommunication': lambda: _lazy_import_with_rt('cssl_serialcom', 'CsscSerialComModule'),
            'cssc.serialcommunication': lambda: _lazy_import_with_rt('cssl_serialcom', 'CsscSerialComModule'),
            'string': lambda: type('M', (), {'_name': 'string', 'get_namespace': lambda s: {}, 'get_docs': lambda s: {}})(),
            'int': lambda: type('M', (), {'_name': 'int', 'get_namespace': lambda s: {}, 'get_docs': lambda s: {}})(),
            'array': lambda: type('M', (), {'_name': 'array', 'get_namespace': lambda s: {}, 'get_docs': lambda s: {}})(),
            'vector': lambda: type('M', (), {'_name': 'vector', 'get_namespace': lambda s: {}, 'get_docs': lambda s: {}})(),
            'map': lambda: type('M', (), {'_name': 'map', 'get_namespace': lambda s: {}, 'get_docs': lambda s: {}})(),
            'keyboard': lambda: _lazy_import('cssl_input', 'CsscKeyboardModule'),
            'mouse': lambda: _lazy_import('cssl_input', 'CsscMouseModule'),
            'sound': lambda: _lazy_import_with_dir('cssl_sound_native', 'CsscSoundModule'),
            'cssc.sidepackagetools': lambda: _lazy_import_with_rt('cssl_sidepackage', 'CsscSidepackageModule'),
            'sidepackagetools': lambda: _lazy_import_with_rt('cssl_sidepackage', 'CsscSidepackageModule'),
            'os': lambda: _lazy_import_with_rt('cssl_os', 'CsscOsModule'),
            'sys.console': lambda: _lazy_import('cssl_console', 'CsscConsoleModule'),
            'cssc.console': lambda: _lazy_import('cssl_console', 'CsscConsoleModule'),
            'console': lambda: _lazy_import('cssl_console', 'CsscConsoleModule'),
            'openai': lambda: _lazy_import('cssl_openai', 'CsscOpenAIModule'),
            'retrogadgets': lambda: _lazy_import('cssl_retrogadgets', 'CsscRetroGadgetsModule'),
            'devdebug': lambda: _lazy_import('cssl_devdebug', 'CsscDevDebugModule'),
            'stdgrace': lambda: _lazy_import_with_rt('cssl_stdgrace', 'CsscStdGraceModule'),
            'gipeo':    lambda: _lazy_import('cssl_gipeo', 'CsscGipeoModule'),
            'allocwatcher': lambda: _lazy_import_with_rt('cssl_allocwatcher', 'CsscAllocWatcherModule'),
            'tft':          lambda: _lazy_import('cssl_tft', 'CsscTftModule'),
            'network.http': lambda: _lazy_import('cssl_network_http', 'CsscNetworkHttpModule'),
            'http':         lambda: _lazy_import('cssl_network_http', 'CsscNetworkHttpModule'),
        }
        factory = modules.get(module_name)
        if factory:
            return factory()
        raise CsscError(operation='Runtime', detail=f'Unknown module: {module_name}',
                        hint='Available: cssc.dll, cssc.ini, cssc.paths, cssc.env, cssc.sys, cssc.io, cssc.fastif, peek, def, cssc.math, cssc.binary, stdio, stdout, sizes, sys, sys.console, cssl, matrix, video, video.sprite, video.tilemap, video.font, math.accel, asyncthreads, serialcommunication, keyboard, mouse, sound, gipeo, tft, network.http, SharedLib')

    # -- Resource loading (#REQUIRE) ----------------------------------------
    def _load_resource(self, arg, varname):
        # Support both string literals and expressions in #REQUIRE[...]
        stripped = arg.strip()
        if (stripped.startswith('"') and stripped.endswith('"')) or \
           (stripped.startswith("'") and stripped.endswith("'")):
            path = self._resolve_path(stripped.strip('"').strip("'"))
        else:
            try:
                lexer = CsscLexer(stripped)
                tokens = lexer.tokenize()
                parser = CsscParser(tokens)
                expr = parser._parse_expression()
                result = self._eval(expr)
                path = self._resolve_path(str(result))
            except Exception as e:
                raise CsscError(operation='Runtime',
                    detail=f'Failed to evaluate #REQUIRE expression: {stripped} - {e}',
                    hint='Use #REQUIRE["path"] for literals or #REQUIRE[expr] for expressions')
        ext = os.path.splitext(path)[1].lower() if path else ''
        if ext in ('.ini', '.cfg', '.conf'):
            self._variables[varname] = CsscIniHandler(path)
            self._resources[varname] = ('ini', self._variables[varname])
        elif ext in ('.dll', '.so', '.dylib', '.pyd'):
            try:
                dll = ctypes.CDLL(path)
                handler = CsscDllHandler(path, dll)
                self._variables[varname] = handler
                self._resources[varname] = ('dll', handler)
            except OSError:
                # Not a native DLL — fall back to CSL handler (CSSL data file)
                handler = CsscCslHandler(path)
                self._variables[varname] = handler
                self._resources[varname] = ('csl', handler)
        elif ext == '.json':
            if os.path.isfile(path):
                with open(path, 'r', encoding='utf-8') as fh:
                    self._variables[varname] = json.load(fh)
            else:
                self._variables[varname] = {}
            self._resources[varname] = ('json', path)
        else:
            handler = CsscCslHandler(path)
            self._variables[varname] = handler
            self._resources[varname] = ('csl', handler)

    # -- Execution ----------------------------------------------------------
    def execute(self, ast):
        try:
            for node in ast:
                if not self._running:
                    break
                self._exec_node(node)
        except _SysReturnSignal as sr:
            return sr.value
        except _ReturnSignal:
            pass
        except _DestructSignal:
            # Object/sector ran `destruct;` — its free{} block already ran,
            # control unwinds cleanly. NOT an error.
            pass
        except CsscError:
            raise
        except Exception as e:
            raise CsscError(operation='Runtime', detail=str(e))
        # Auto-destruct heap variables (no #delete needed)
        if hasattr(self, '_heap_vars'):
            self._heap_vars.clear()
        return self._exit_code

    def _exec_node(self, node):
        ntype = node.get('type')
        if ntype == 'directive':
            self._exec_directive(node)
        elif ntype == 'include':
            mod = self._load_module(node['module'])
            varname = node.get('var', '') or ''
            # Same collision avoidance as the first runtime: empty alias
            # falls back to the module name as the storage key, so two
            # no-alias #include() lines don't overwrite each other.
            storage_key = varname or (node.get('module') or '').strip()
            self._modules[storage_key] = mod
            if varname:
                self._variables[varname] = mod
        elif ntype == 'if':
            self._exec_if(node)
        elif ntype == 'for':
            self._exec_for(node)
        elif ntype == 'while':
            self._exec_while(node)
        elif ntype == 'select':
            self._exec_select(node)
        elif ntype == 'select_jump':
            raise _SelectJumpSignal(delta=int(node.get('delta', 1)))
        elif ntype == 'break':
            raise _BreakSignal()
        elif ntype == 'continue':
            raise _ContinueSignal()
        elif ntype == 'jump':
            target = self._eval(node['target']) if node.get('target') else None
            raise _JumpSignal(target=target)
        elif ntype == 'return':
            val = self._eval(node['value']) if node.get('value') else None
            src_var = None
            if node.get('value') and node['value'].get('type') == 'identifier':
                src_var = node['value']['name']
            raise _ReturnSignal(val, source_var=src_var)
        elif ntype == 'deref_assign':
            # *iter = value — write through iterator
            target_val = self._eval(node['target'])
            value = self._eval(node['value'])
            if isinstance(target_val, CsscPointer):
                self._variables[target_val.name] = value
            elif isinstance(target_val, CsscIterator):
                target_val.deref_set(value)
            else:
                tname = node['target'].get('name') if isinstance(node['target'], dict) else None
                if tname:
                    existing = self._variables.get(tname)
                    if isinstance(existing, CsscIterator):
                        existing.deref_set(value)
                    else:
                        self._variables[tname] = value
        elif ntype == 'assign':
            if node['target'] not in self._variables and not node.get('for_decl'):
                raise CsscError(operation='Runtime',
                                detail=f'Undeclared variable "{node["target"]}". Use #VARIABLE[type], #stack, #heap, or #auto to declare variables first.',
                                line=node.get('line', 0))
            # #fvar variables can only be assigned via #define/#cdefine
            if hasattr(self, '_fvar_names') and node['target'] in self._fvar_names:
                raise CsscError(operation='Runtime',
                                detail=f'Cannot directly assign to #fvar variable "{node["target"]}"',
                                hint='Use #define({name}) {{ ... }} or #cdefine({name}, ...) {{ ... }} to assign'.format(name=node['target']),
                                line=node.get('line', 0))
            if hasattr(self, '_param_names') and node['target'] in self._param_names:
                raise CsscError(operation='Runtime',
                                detail=f'Cannot directly assign to #param variable "{node["target"]}"',
                                hint='#param variables are populated by #scanp inside #define/#cdefine',
                                line=node.get('line', 0))
            val = self._eval(node['value'])
            # Method binding interception
            _existing = self._variables.get(node['target'])
            _ensure_method_imports()
            # Source-side: if value is a method-bound variable being copied, trigger 'copied'
            if CsscMethodBinding is not None and isinstance(val, CsscMethodBinding):
                if not isinstance(_existing, CsscMethodBinding):
                    val.trigger_do('copied', None)
                val = val.get_value()
            if CsscMethodBinding is not None and isinstance(_existing, CsscMethodBinding):
                _existing.set_value(val)  # update value FIRST so introspection sees new state
                _existing.trigger_do('assign', val)
                return
            # Iterator assignment: i = int updates index, keeps container binding
            if isinstance(_existing, CsscIterator) and isinstance(val, (int, float)):
                _existing._index = int(val)
                return
            if isinstance(_existing, CsscIterator) and isinstance(val, CsscIterator):
                _existing._index = val._index
                return
            if node['target'] in self._variable_types:
                self._strict_type_check(val, self._variable_types[node['target']], node['target'], node.get('line', 0))
                val = self._coerce(val, self._variable_types[node['target']])
            self._variables[node['target']] = val
            # Propagate ref assignments: if target is a *ref, write back to original
            if hasattr(self, '_ref_links') and node['target'] in self._ref_links:
                orig = self._ref_links[node['target']]
                if orig in self._variables:
                    self._variables[orig] = val
                # Also propagate through parent scopes (for #req *ref inside #define)
                if hasattr(self, '_parent_scopes'):
                    for ps in reversed(self._parent_scopes):
                        if orig in ps:
                            ps[orig] = val
                            break
            # Auto-realloc for #auto variables
            _auto = getattr(self, '_auto_vars', None)
            if _auto and node['target'] in _auto:
                encoded = self._encode_value(val)
                info = _auto[node['target']]
                if len(encoded) > info['max_bits'] // 8:
                    new_size = max(len(encoded) * 2, 64)
                    info['buffer'] = ctypes.create_string_buffer(new_size)
                    info['max_bits'] = new_size * 8
                info['buffer'].value = encoded[:info['max_bits'] // 8]
        elif ntype == 'arrow_assign':
            obj = self._eval(node['object'])
            # Check parent scopes if obj not found (Sector->member = val inside #define)
            if obj is None and node['object'].get('type') in ('ident', 'identifier'):
                name = node['object'].get('name')
                if hasattr(self, '_parent_scopes'):
                    for ps in reversed(self._parent_scopes):
                        if name in ps:
                            obj = ps[name]
                            break
            val = self._eval(node['value'])
            if isinstance(obj, CsscSector):
                obj._vars[node['key']] = val
            elif isinstance(obj, CsscObject):
                obj._vars[node['key']] = val
            elif isinstance(obj, dict):
                obj[node['key']] = val
            elif hasattr(obj, 'set'):
                obj.set(node['key'], val)
        elif ntype == 'dot_assign':
            obj = self._eval(node['object'])
            val = self._eval(node['value'])
            # Method binding: unwrap inner value, intercept mutation
            _ensure_method_imports()
            if CsscMethodBinding is not None and isinstance(obj, CsscMethodBinding):
                inner = obj.get_value()
                if isinstance(inner, dict):
                    inner[node['key']] = val
                elif hasattr(inner, node['key']):
                    setattr(inner, node['key'], val)
                obj.trigger_do('dot_assign', val)
            elif isinstance(obj, dict):
                obj[node['key']] = val
            elif hasattr(obj, node['key']):
                setattr(obj, node['key'], val)
        elif ntype == 'index_assign':
            # Chained bind write: see _exec_index_assign in the legacy
            # runtime for the long-form rationale. Detect the
            # `index_access(index_access(name, row), col) = val` shape
            # against a CsscBind with pair_width > 0 BEFORE the
            # `_eval(node['object'])` collapses the inner index into a
            # flat-cell scalar — that collapse is the root cause of
            # the silent-no-op reported by the user.
            _inner = node.get('object')
            _handled_chained = False
            if (isinstance(_inner, dict)
                    and _inner.get('type') == 'index'):
                _innermost = _inner.get('object')
                if (isinstance(_innermost, dict)
                        and _innermost.get('type') == 'identifier'):
                    _name = _innermost.get('name')
                    _bv = self._variables.get(_name)
                    if (isinstance(_bv, CsscBind)
                            and _bv.pair_width > 0):
                        _row = self._eval(_inner.get('index'))
                        _col = self._eval(node.get('index'))
                        _val_v = self._eval(node.get('value'))
                        try:
                            _row_i = int(_row); _col_i = int(_col)
                        except (TypeError, ValueError):
                            raise CsscError(
                                operation='Runtime',
                                detail=(f'bind chained-write '
                                        f'`{_name}[row][col] = …`: '
                                        f'row/col must be int'),
                                line=node.get('line', 0))
                        _n_pairs = list.__len__(_bv)
                        if not (0 <= _row_i < _n_pairs):
                            raise CsscError(
                                operation='Runtime',
                                detail=(f'bind row index {_row_i} '
                                        f'out of range (have '
                                        f'{_n_pairs} pairs)'),
                                line=node.get('line', 0))
                        _pair = list.__getitem__(_bv, _row_i)
                        if not (0 <= _col_i < len(_pair)):
                            raise CsscError(
                                operation='Runtime',
                                detail=(f'bind column index {_col_i}'
                                        f' out of range '
                                        f'(pair_width='
                                        f'{_bv.pair_width})'),
                                line=node.get('line', 0))
                        _new_pair = list(_pair)
                        _new_pair[_col_i] = _val_v
                        list.__setitem__(_bv, _row_i,
                                          tuple(_new_pair))
                        _handled_chained = True
            if _handled_chained:
                pass
            else:
                obj = self._eval(node['object'])
                idx = self._eval(node['index'])
                val = self._eval(node['value'])
                # Method binding: unwrap, intercept
                _ensure_method_imports()
                if CsscMethodBinding is not None and isinstance(obj, CsscMethodBinding):
                    inner = obj.get_value()
                    if isinstance(inner, str):
                        idx = int(idx)
                        chars = list(inner)
                        if 0 <= idx < len(chars):
                            chars[idx] = str(val) if val is not None else '\x00'
                        elif idx >= len(chars):
                            chars.extend(['\x00'] * (idx - len(chars) + 1))
                            chars[idx] = str(val) if val is not None else '\x00'
                        obj.set_value(''.join(chars))
                        obj.trigger_do('index_assign', val)
                    elif isinstance(inner, list):
                        idx = int(idx)
                        if 0 <= idx < len(inner):
                            inner[idx] = val
                        obj.trigger_do('index_assign', val)
                elif isinstance(obj, str):
                    # String character mutation: str[i] = char → rebuild
                    idx = int(idx)
                    var_name = node['object'].get('name') if isinstance(node['object'], dict) else None
                    if var_name:
                        chars = list(obj)
                        if 0 <= idx < len(chars):
                            chars[idx] = str(val) if val is not None else '\x00'
                        elif idx >= len(chars):
                            chars.extend(['\x00'] * (idx - len(chars) + 1))
                            chars[idx] = str(val) if val is not None else '\x00'
                        self._variables[var_name] = ''.join(chars)
                elif isinstance(obj, list):
                    idx = int(idx)
                    if 0 <= idx < len(obj):
                        obj[idx] = val
                    else:
                        raise CsscError(operation='Runtime',
                                        detail=f'Index {idx} out of range (list size: {len(obj)})',
                                        line=node.get('line', 0))
                elif isinstance(obj, dict):
                    obj[idx] = val
                elif hasattr(obj, '__setitem__'):
                    obj[idx] = val
                else:
                    # Three-layer-safety: don't silently swallow an
                    # assignment to a non-container target. The user
                    # gets an explicit type error with a hint about
                    # what shape was expected.
                    _name = (node['object'].get('name')
                             if isinstance(node.get('object'), dict)
                             else '<expr>')
                    raise CsscError(
                        operation='Runtime',
                        detail=(f'indexed write `{_name}[{idx!r}] = …`: '
                                f'target is a '
                                f'{type(obj).__name__} which has no '
                                f'`[]=` operator. Chained bind-cell '
                                f'writes need pair_width > 0 (declare '
                                f'`{_name}` as `#stack[bind, N] = '
                                f'{{a, b; c, d}};`).'),
                        line=node.get('line', 0))
        elif ntype == 'result_capture':
            expr = node['expr']
            ref_origins = []
            if expr.get('type') in ('call',) and expr.get('args'):
                for arg_node in expr['args']:
                    if arg_node.get('type') == 'unary' and arg_node.get('op') == '*':
                        operand = arg_node.get('operand', {})
                        if operand.get('type') == 'identifier':
                            ref_origins.append(operand['name'])
            result = self._eval(expr)
            varname = node['var']
            if varname in self._variable_types:
                self._strict_type_check(result, self._variable_types[varname],
                                        varname=varname, line=node.get('line', 0))
            # obj->member LHS routes into the object's _vars, NOT a flat
            # scope key. Without this, `Inner() Outer->inner;` planted a
            # `Outer->inner` literal-named entry in scope and later
            # `Outer->inner.run()` (which goes through _eval_arrow →
            # obj._vars[key]) saw None — method call no-oped silently.
            if '->' in varname:
                obj_name, _, member = varname.partition('->')   
                holder = self._variables.get(obj_name)
                if isinstance(holder, (CsscObject, CsscSector)):
                    holder._vars[member] = result
                else:
                    self._variables[varname] = result
            else:
                self._variables[varname] = result
            # func() *x — reference capture: x holds ref to func["value"]
            if node.get('ref_capture'):
                func_name = expr.get('name') or (expr.get('callee', {}).get('name') if isinstance(expr.get('callee'), dict) else None)
                if func_name:
                    if not hasattr(self, '_ref_links'):
                        self._ref_links = {}
                    self._ref_links[varname] = func_name
            # Transfer ownership of internal allocations returned by the function
            if hasattr(self, '_return_transfers') and self._return_transfers:
                for store_name, src_var, alloc_info in self._return_transfers:
                    store = getattr(self, store_name, None)
                    if store is not None:
                        store[varname] = alloc_info
                self._return_transfers.clear()
            if ref_origins:
                if not hasattr(self, '_ref_links'):
                    self._ref_links = {}
                for orig in ref_origins:
                    self._ref_links[varname] = orig
        elif ntype == 'expr_stmt':
            self._eval(node['expr'])
        elif ntype == 'block':
            for stmt in node.get('body', []):
                self._exec_node(stmt)
        elif ntype == 'private_scope':
            self._exec_private_scope(node)
        elif ntype == 'hex_scope':
            self._exec_hex_scope(node)
        elif ntype == 'define':
            self._exec_define(node)
        elif ntype == 'interrupt':
            # CCOS `#interrupt` handler — native (ccos) only. The
            # interpreter has no interrupt vector table; registering /
            # invoking it has no host meaning, so it is a no-op here
            # (kernel code is compiled with `cssc native --target ccos`).
            pass
        elif ntype == 'redefine':
            self._exec_redefine(node)
        elif ntype == 'sector':
            self._exec_sector(node)
        elif ntype == 'method_def':
            # Register method definition
            _ensure_method_imports()
            name = node['name']
            method = CsscMethod(
                name=name,
                type_constraint=node.get('type_constraint'),
                alias=node['alias'],
                decl_body=node['decl_body'],
                do_body=node['do_body'],
                free_body=node.get('free_body'),
                line=node.get('line', 0),
                scope_params=node.get('scope_params', []),
            )
            if not hasattr(self, '_methods'):
                self._methods = {}
            self._methods[name] = method
            self._variables[name] = method
        elif ntype == 'method_apply':
            # Apply method to a declaration: methodName ! #directive[...] var;
            _ensure_method_imports()
            method_name = node['method_name']
            decl_node = node['declaration']
            method = None
            if hasattr(self, '_methods'):
                method = self._methods.get(method_name)
            if method is None:
                method = self._variables.get(method_name)
            # Resolve ns::method through sector/module
            ns_callable = None
            if method is None and '::' in method_name:
                ns, mname = method_name.split('::', 1)
                ns_obj = self._modules.get(ns) or self._variables.get(ns)
                if isinstance(ns_obj, CsscSector):
                    method = ns_obj._vars.get(mname)
                elif isinstance(ns_obj, CsscObject):
                    method = ns_obj._vars.get(mname)
                elif hasattr(ns_obj, '_variables'):
                    method = ns_obj._variables.get(mname)
                # Module exposing a python callable via get_namespace() —
                # this is how `alw::watch ! sector __main__ { … }` reaches
                # the allocwatcher's `watch()` function from Python.
                if method is None and hasattr(ns_obj, 'get_namespace'):
                    try:
                        ns_dict = ns_obj.get_namespace()
                        if isinstance(ns_dict, dict) and callable(ns_dict.get(mname)):
                            ns_callable = ns_dict[mname]
                    except Exception:
                        pass
            # Decorator-callable shortcut: a plain Python callable from a
            # module's namespace. Bypasses the CsscMethodBinding pipeline
            # (which is for in-language method() definitions).
            #
            # Order: the decorator runs FIRST, *then* the declaration body
            # executes. This is what `alw::watch ! sector __main__ { … }`
            # needs: the watcher must be live while the sector body is
            # making allocations, not started after the body finishes.
            #
            # Since the sector instance doesn't exist yet at this point,
            # we pass `None` to the decorator (it can fall back to global
            # scope — which is exactly what allocwatcher does without an
            # arg). For decorators that strictly need the post-body
            # value, the user can keep using the explicit form
            # `alw::watch(target);` after the declaration.
            _is_cssc_method = (
                CsscMethod is not None and isinstance(method, CsscMethod)
            )
            if ns_callable is not None and not _is_cssc_method:
                try:
                    ns_callable(None)
                except TypeError:
                    # Decorator that doesn't accept None — try zero-arg.
                    try:
                        ns_callable()
                    except BaseException as e:
                        raise CsscError(operation='Runtime',
                                        detail=f"decorator '{method_name}' raised "
                                               f"{type(e).__name__}: {e}",
                                        line=node.get('line', 0))
                except BaseException as e:
                    raise CsscError(operation='Runtime',
                                    detail=f"decorator '{method_name}' raised "
                                           f"{type(e).__name__}: {e}",
                                    line=node.get('line', 0))
                # Now run the actual declaration with the decorator's
                # side effect already in place.
                self._exec_node(decl_node)
                return
            if not isinstance(method, CsscMethod):
                raise CsscError(operation='Runtime',
                                detail=f'method \'{method_name}\' not found',
                                line=node.get('line', 0))
            # Execute the declaration normally (creates the variable)
            self._exec_node(decl_node)
            var_name = decl_node.get('var', decl_node.get('name', ''))
            if not var_name and decl_node.get('type') == 'sector':
                var_name = decl_node.get('name', '')
            if not var_name and decl_node.get('type') == 'object':
                var_name = decl_node.get('name', '')
            # Type constraint check — infer from value for sector/object
            if method._type_constraint:
                actual = self._variable_types.get(var_name, 'auto')
                # Also check stripped member name (Object->member → member)
                if actual == 'auto' and '->' in var_name:
                    bare = var_name.split('->', 1)[1]
                    actual = self._variable_types.get(bare, 'auto')
                val = self._variables.get(var_name)
                if val is None and '->' in var_name:
                    bare = var_name.split('->', 1)[1]
                    val = self._variables.get(bare)
                if isinstance(val, CsscSector):
                    actual = 'sector'
                elif isinstance(val, CsscObject):
                    actual = 'object'
                elif isinstance(val, CsscFunction):
                    actual = 'function'
                if not method.check_type(actual):
                    raise CsscError(operation='Runtime',
                                    detail=f'method \'{method_name}\' requires type \'{method._type_constraint}\', got \'{actual}\'',
                                    line=node.get('line', 0))
            # Get allocation info
            alloc_info = None
            region = 'auto'
            for sv_name in ('_stack_vars', '_heap_vars', '_auto_vars'):
                store = getattr(self, sv_name, None)
                if store and var_name in store:
                    alloc_info = store[var_name]
                    region = sv_name.replace('_vars', '').lstrip('_')
                    break
            # Create binding
            binding = CsscMethodBinding(
                value=self._variables.get(var_name),
                method=method,
                runtime=self,
                var_name=var_name,
                alloc_info=alloc_info,
                type_name=self._variable_types.get(var_name, 'auto'),
                region=region,
                line=node.get('line', 0),
            )
            # Inject scope params: *param copies outer variable into binding scope
            for sp in method._scope_params:
                sp_name = sp['name']
                if '->' in sp_name:
                    # Sector->member: resolve through sector/object
                    parts = sp_name.split('->', 1)
                    owner = self._variables.get(parts[0])
                    if owner is None:
                        owner = self._modules.get(parts[0])
                    if owner is not None and hasattr(owner, '_vars') and parts[1] in owner._vars:
                        if sp['is_ref']:
                            binding._bindings[f'_scope_{sp_name}'] = sp_name
                elif sp_name in self._variables:
                    if sp['is_ref']:
                        binding._bindings[f'_scope_{sp_name}'] = sp_name
            # Execute declaration block to establish bindings
            for stmt in method._decl_body:
                if isinstance(stmt, dict):
                    if stmt.get('type') == 'method_bind':
                        binding._bindings[stmt['prop_path']] = stmt['bind_name']
                    elif stmt.get('type') == 'method_set':
                        val = self._eval(stmt['value'])
                        binding._introspector.set_property(stmt['prop_path'], val)
                    else:
                        # Regular statement — execute in binding scope
                        saved = self._variables.copy()
                        self._variables[method._alias] = binding
                        try:
                            self._exec_node(stmt)
                        finally:
                            self._variables = saved
            # Replace variable with binding
            self._variables[var_name] = binding
            if not hasattr(self, '_method_bindings'):
                self._method_bindings = {}
            self._method_bindings[var_name] = binding
        elif ntype == 'object':
            # Register object — NOT executed until Name() is called
            name = node['name']
            obj = CsscObject(name, node.get('instructions', {}),
                             node.get('top_level', []),
                             node.get('free_body'), self)
            # Carry access metadata from parser (sets, may be empty if no private:/public: used)
            obj._public_labels = set(node.get('public_labels', set()) or set())
            obj._private_labels = set(node.get('private_labels', set()) or set())
            obj._public_members = set(node.get('public_members', set()) or set())
            obj._private_members = set(node.get('private_members', set()) or set())
            # Process generic params: scope injections vs constructor params
            import copy as _copy
            constructor_params = []
            for p in (node.get('params') or []):
                inner_name = p['param_name']
                source_name = p.get('source_var', inner_name)
                is_ref = p.get('is_ref', False)
                is_typed = p.get('is_typed', False)
                if is_typed:
                    # Constructor parameter: injected at Object(args) instantiation
                    constructor_params.append({
                        'type': source_name,
                        'name': inner_name,
                        'is_ref': is_ref,
                    })
                else:
                    # Scope injection: take variable from outer scope now
                    if source_name in self._variables:
                        if is_ref:
                            obj._vars[inner_name] = self._variables[source_name]
                        else:
                            try:
                                obj._vars[inner_name] = _copy.deepcopy(self._variables[source_name])
                            except Exception:
                                obj._vars[inner_name] = self._variables[source_name]
            if constructor_params:
                obj._constructor_params = constructor_params
            self._variables[name] = obj
            self._modules[name] = obj
        elif ntype == 'call_label':
            # goto labelname(args) capture; — call label within current object
            # goto labelname<args> capture; — overload dispatch by arg types
            # goto labelname<*var, ...> — explicit transfer override at the goto site
            label = node['label']
            raw_args = node.get('args', [])
            # Separate value args from explicit transfer overrides
            value_args = []
            transfer_overrides = {}  # name -> resolved value
            for a in raw_args:
                if isinstance(a, dict) and a.get('type') == 'transfer_ref':
                    sname = a['name']
                    val = self._variables.get(sname)
                    if val is None and hasattr(self, '_parent_scopes'):
                        for ps in reversed(self._parent_scopes):
                            if sname in ps:
                                val = ps[sname]
                                break
                    if val is None:
                        val = self._modules.get(sname)
                    transfer_overrides[sname] = val
                else:
                    value_args.append(self._eval(a))
            args = value_args
            capture = node.get('capture')
            # Find the object we're inside (via _building_sector)
            obj_name = getattr(self, '_building_sector', None)
            obj = self._variables.get(obj_name) if obj_name else None
            if obj is None and obj_name and hasattr(self, '_parent_scopes'):
                for ps in reversed(self._parent_scopes):
                    if obj_name in ps:
                        obj = ps[obj_name]
                        break
            if isinstance(obj, CsscObject) and label in obj._instructions:
                # Resolve overload by runtime arg types (only value args count)
                resolved_params, resolved_body = obj._resolve_label_overload(label, args)
                if resolved_body is None:
                    resolved_body = obj._instructions.get(label, [])
                    resolved_params = obj._instructions.get(label + '__params', [])
                # Build extra_vars: required params from args, transfers from outer scope
                param_vars = {}
                arg_idx = 0
                for p in (resolved_params or []):
                    if p.get('kind') == 'param':
                        if arg_idx < len(args):
                            param_vars[p['name']] = args[arg_idx]
                            arg_idx += 1
                    elif p.get('kind') == 'transfer':
                        sname = p['name']
                        # Explicit override from goto<*var> takes precedence
                        if sname in transfer_overrides:
                            param_vars[sname] = transfer_overrides[sname]
                        elif sname in self._variables:
                            param_vars[sname] = self._variables[sname]
                        elif hasattr(self, '_parent_scopes'):
                            for ps in reversed(self._parent_scopes):
                                if sname in ps:
                                    param_vars[sname] = ps[sname]
                                    break
                # Also inject any explicit transfer overrides not bound to a label slot
                for sname, val in transfer_overrides.items():
                    if sname not in param_vars and val is not None:
                        param_vars[sname] = val
                if not hasattr(self, '_call_args_stack'):
                    self._call_args_stack = []
                self._call_args_stack.append((label, args))
                try:
                    result = obj._run_stmts(resolved_body, extra_vars=param_vars)
                except _MirrorSignal as m:
                    result = m.value
                except _DestructSignal:
                    if self._call_args_stack:
                        self._call_args_stack.pop()
                    raise
                finally:
                    if self._call_args_stack:
                        self._call_args_stack.pop()
                if capture:
                    self._variables[capture] = result
            else:
                raise CsscError(operation='Runtime',
                                detail=f'call: label \'{label}\' not found in current object',
                                line=node.get('line', 0))
        elif ntype == 'destruct':
            raise _DestructSignal()
        elif ntype == 'mirror':
            # v6 semantics: default = REFERENCE, `&` = DEEP-COPY.
            # When the mirror target is a bare identifier (a slot),
            # capture `ref_source` so the outer-capture re-fetches
            # the slot's CURRENT value at body-end — that's the
            # live-link behaviour the spec promises (deleting the
            # inner slot after `mirror inner;` invalidates the
            # outer to `0x0`). Expression mirrors (`mirror a+b;`)
            # have no slot to re-fetch → snapshot wins.
            import copy as _copy
            val = self._eval(node['value'])
            is_copy = bool(node.get('is_copy'))
            # If neither `is_copy` nor `is_ref` is present (very old
            # AST), fall back to the new v6 default (ref).
            if not is_copy and node.get('is_ref') is None:
                is_copy = False
            ref_source = None
            value_node = node.get('value')
            if (not is_copy
                    and isinstance(value_node, dict)
                    and value_node.get('type') in ('identifier',
                                                     'name', 'var_ref')):
                ref_source = (value_node.get('name') or '').strip() or None
            if is_copy:
                try:
                    raise _MirrorSignal(_copy.deepcopy(val),
                                          is_ref=False,
                                          ref_source=None)
                except _MirrorSignal:
                    raise
                except Exception:
                    raise _MirrorSignal(val, is_ref=False,
                                          ref_source=None)
            else:
                raise _MirrorSignal(val, is_ref=True,
                                      ref_source=ref_source)
        elif ntype == 'tlisten':
            target = node.get('target', '')
            body = node.get('body')
            if body and target:
                current_val = self._variables.get(target)
                if current_val is not None:
                    if isinstance(body, list):
                        for stmt in body:
                            self._exec_node(stmt)
                    elif isinstance(body, dict):
                        self._exec_node(body)
        elif ntype == 'cdefine':
            self._require_module('def', '#cdefine', node.get('line', 0))
            self._exec_cdefine(node)
        elif ntype == 'qvar':
            self._require_module('def', '#qvar', node.get('line', 0))
            self._exec_qvar(node)
        elif ntype == 'scanp':
            self._exec_scanp(node)

    _DIRECTIVE_MODULE_DEPS = {
        'fvar': 'def',
        'param': 'def',
        'scanp_opt': 'def',
        'sysarg': 'sys',
        'stdout': 'stdout',
        'matrix': 'matrix',
        'video': 'video',
        'framebuffer': 'video',
        'daemon': 'asyncthreads',
        'killdaemon': 'asyncthreads',
        'thread': 'asyncthreads',
        'await': 'asyncthreads',
        'string': 'string',
        'int': 'int',
        'array': 'array',
        'vector': 'vector',
        'map': 'map',
    }

    def _require_module(self, module_name, directive_name, line=0):
        for mod in self._modules.values():
            if getattr(mod, '_name', '') == module_name:
                return
        raise CsscError(
            operation='Runtime',
            detail=f'{directive_name} requires #include("{module_name}") to be loaded first',
            hint=f'Add: #include("{module_name}") at the top of your script',
            line=line)

    def _exec_directive(self, node):
        directive = node['directive']
        arg = node.get('arg', '')
        # Resolve Object->member var names: strip prefix when inside the object's scope
        var = node.get('var', '')
        if '->' in var:
            parts = var.split('->', 1)
            obj_name, member = parts[0], parts[1]
            if getattr(self, '_building_sector', None) == obj_name:
                node = dict(node)
                node['var'] = member
        # Check module dependencies
        dep = self._DIRECTIVE_MODULE_DEPS.get(directive)
        if dep:
            self._require_module(dep, f'#{directive}', node.get('line', 0))
        if directive == 'REQUIRE':
            self._load_resource(node['arg'], node['var'])
        elif directive == 'VARIABLE':
            init_value = self._eval(node['value']) if node.get('value') is not None else None
            if init_value is not None:
                self._variables[node['var']] = self._coerce(init_value, node['arg'])
            else:
                self._variables[node['var']] = self._default_for_type(node['arg'])
            self._variable_types[node['var']] = node['arg']
        elif directive == 'OUTPUT':
            self._output_path = self._resolve_path(node['arg'])
        elif directive == 'EXIT':
            self._exit_code = int(node['arg']) if node['arg'] else 0
            self._running = False
        elif directive == 'fvar':
            self._variables[node['var']] = self._default_for_type(node['arg'])
            self._variable_types[node['var']] = node['arg']
            if not hasattr(self, '_fvar_names'):
                self._fvar_names = set()
            self._fvar_names.add(node['var'])
        elif directive == 'req':
            # CSSC v5 #req: ref by default; `&Y` requests an explicit
            # snapshot copy at import time. Legacy `*Y` parsed as ref.
            global_var = node.get('global_var', '')
            is_ref = node.get('is_ref', True)
            var = node['var']
            parent_val = None
            parent_found = False
            # Sector member access: sectorName->member
            if '->' in global_var:
                parts = global_var.split('->', 1)
                sector_name = parts[0].strip()
                member_name = parts[1].strip()
                # During sector construction, resolve from local/parent scopes
                if getattr(self, '_building_sector', None) == sector_name:
                    if member_name in self._variables:
                        parent_val = self._variables[member_name]
                        parent_found = True
                    elif hasattr(self, '_parent_scopes') and self._parent_scopes:
                        for ps in reversed(self._parent_scopes):
                            if member_name in ps:
                                parent_val = ps[member_name]
                                parent_found = True
                                break
                    if not parent_found:
                        raise CsscError(operation='Runtime', detail=f'#req: member \'{member_name}\' not found in sector \'{sector_name}\'', line=node.get('line', 0))
                else:
                    sector_obj = None
                    if hasattr(self, '_parent_scopes') and self._parent_scopes:
                        for ps in reversed(self._parent_scopes):
                            if sector_name in ps and isinstance(ps[sector_name], CsscSector):
                                sector_obj = ps[sector_name]
                                break
                    if sector_obj is None and sector_name in self._variables:
                        val = self._variables[sector_name]
                        if isinstance(val, CsscSector):
                            sector_obj = val
                    if sector_obj is None:
                        raise CsscError(operation='Runtime', detail=f'#req: sector \'{sector_name}\' not found', line=node.get('line', 0))
                    is_internal = False
                    if hasattr(self, '_call_args_stack') and self._call_args_stack:
                        calling_func = self._call_args_stack[-1][0]
                        if '->' in calling_func:
                            cf_parts = calling_func.split('->', 1)
                            if cf_parts[0].strip() == sector_name:
                                calling_func = cf_parts[1].strip()
                        if calling_func in sector_obj._public or calling_func in sector_obj._private:
                            is_internal = True
                    if member_name in sector_obj._private and not is_internal:
                        parent_val = None
                        parent_found = True
                    elif member_name in sector_obj._vars:
                        parent_val = sector_obj._vars[member_name]
                        parent_found = True
                    else:
                        raise CsscError(operation='Runtime', detail=f'#req: member \'{member_name}\' not found in sector \'{sector_name}\'', line=node.get('line', 0))
            else:
                if hasattr(self, '_parent_scopes') and self._parent_scopes:
                    for ps in reversed(self._parent_scopes):
                        if global_var in ps:
                            parent_val = ps[global_var]
                            parent_found = True
                            break
                elif global_var in self._variables:
                    parent_val = self._variables[global_var]
                    parent_found = True
            if not parent_found:
                raise CsscError(operation='Runtime', detail=f'#req: variable \'{global_var}\' not found in parent scope', line=node.get('line', 0))
            if is_ref:
                self._variables[var] = parent_val
                if not hasattr(self, '_ref_links'):
                    self._ref_links = {}
                if '->' in global_var:
                    self._ref_links[var] = global_var
                else:
                    self._ref_links[var] = global_var
            else:
                import copy
                self._variables[var] = copy.deepcopy(parent_val)
        elif directive == 'param':
            self._variables[node['var']] = self._default_for_type(node['arg'])
            self._variable_types[node['var']] = node['arg']
            if not hasattr(self, '_param_names'):
                self._param_names = set()
            self._param_names.add(node['var'])
        elif directive == 'adress':
            # `#adress[var]` — see the canonical handler earlier in
            # this file for the full docstring. Three forms: GET
            # (`addr;` trailing name), ALIAS (`= 0xABC`), and
            # EXPRESSION (handled in `_eval`). Missing target_var
            # returns 0x0 instead of raising so the guard idiom
            # `if (#adress[x] != 0x0) { #delete[x]; }` works as the
            # escape hatch for fatal `#delete[<missing>]`.
            target_var = (node.get('arg') or '').strip()
            var = node.get('var')
            if node.get('value') is not None:
                # ALIAS FORM
                addr_val = self._eval(node['value'])
                if isinstance(addr_val, str) and addr_val.lower().startswith('0x'):
                    addr_int = int(addr_val, 16)
                else:
                    addr_int = int(addr_val)
                if not hasattr(self, '_address_map'):
                    self._address_map = {}
                if addr_int not in self._address_map:
                    raise CsscError(operation='Runtime',
                                    detail=f'#adress: target address {hex(addr_int)} does not exist',
                                    hint='The address must belong to an existing #stack/#heap/#auto allocation',
                                    line=node.get('line', 0))
                source_name = self._address_map[addr_int]
                source_info = None
                source_store_name = None
                for _sv in ('_stack_vars', '_heap_vars', '_auto_vars'):
                    _store = getattr(self, _sv, None)
                    if _store and source_name in _store:
                        source_info = _store[source_name]
                        source_store_name = _sv
                        break
                if source_info is None:
                    raise CsscError(operation='Runtime',
                                    detail=f'#adress: source variable "{source_name}" buffer not found',
                                    line=node.get('line', 0))
                self._update_address_map(target_var, None, remove=True)
                for _sv in ('_stack_vars', '_heap_vars', '_auto_vars'):
                    _store = getattr(self, _sv, None)
                    if _store and target_var in _store:
                        del _store[target_var]
                        break
                alias_entry = {
                    'type': source_info['type'],
                    'max_bits': source_info['max_bits'],
                    'buffer': source_info['buffer'],
                    'region': source_info.get('region', 'heap'),
                }
                _store = getattr(self, source_store_name)
                _store[target_var] = alias_entry
                self._variables[target_var] = self._variables.get(source_name)
                self._variable_types[target_var] = source_info['type']
            else:
                # GET FORM — missing target returns 0x0.
                if target_var not in self._variables:
                    if var:
                        self._variables[var] = '0x0'
                        self._variable_types[var] = 'string'
                else:
                    buf = None
                    for _sv in ('_stack_vars', '_heap_vars', '_auto_vars'):
                        _store = getattr(self, _sv, None)
                        if _store and target_var in _store:
                            buf = _store[target_var]['buffer']
                            break
                    if buf is not None:
                        addr_str = hex(ctypes.addressof(buf))
                    else:
                        addr_str = hex(id(self._variables[target_var]))
                    if var:
                        self._variables[var] = addr_str
                        self._variable_types[var] = 'string'
        elif directive == 'reflect':
            # #reflect[address] var; — resolve address back to value
            addr = node['arg']
            addr_val = self._variables.get(addr, addr)
            if isinstance(addr_val, str) and addr_val.startswith('0x'):
                addr_int = int(addr_val, 16)
            else:
                addr_int = int(addr_val)
            found = None
            for store in [getattr(self, '_stack_vars', {}), getattr(self, '_heap_vars', {}), getattr(self, '_auto_vars', {})]:
                for vname, info in store.items():
                    buf = info['buffer']
                    if ctypes.addressof(buf) == addr_int:
                        found = self._variables.get(vname)
                        break
                if found is not None:
                    break
            if found is None:
                for vname, vval in self._variables.items():
                    if id(vval) == addr_int:
                        found = vval
                        break
            self._variables[node['var']] = found
        elif directive == 'size':
            # #size[var] size_var; — get USED size in bits (actual data)
            target_var = node['arg']
            if target_var not in self._variables:
                raise CsscError(operation='Runtime', detail=f'#size: variable "{target_var}" not defined',
                                line=node.get('line', 0))
            encoded = self._encode_value(self._variables[target_var])
            self._variables[node['var']] = len(encoded) * 8
            self._variable_types[node['var']] = 'int'
        elif directive == 'iterator':
            source_name = node.get('source', '')
            iter_type = node.get('iter_type', 'auto')
            if source_name not in self._variables:
                raise CsscError(operation='Runtime',
                                detail=f'#iterator: source variable "{source_name}" not defined',
                                line=node.get('line', 0))
            container = self._variables[source_name]
            if not isinstance(container, (list, CsscVector)):
                raise CsscError(operation='Runtime',
                                detail=f'#iterator: source "{source_name}" is not iterable (type: {self._b_typeof(container)})',
                                line=node.get('line', 0))
            it = CsscIterator(container, 0, iter_type)
            self._variables[node['var']] = it
            self._variable_types[node['var']] = 'iterator'
        elif directive == 'matrix':
            w_expr = node.get('matrix_width', '0')
            h_expr = node.get('matrix_height', '0')
            try:
                w = int(self._eval({'type': 'identifier', 'name': w_expr}) if not w_expr.lstrip('-').isdigit() else int(w_expr))
            except Exception:
                w = int(w_expr) if w_expr.isdigit() else 0
            try:
                h = int(self._eval({'type': 'identifier', 'name': h_expr}) if not h_expr.lstrip('-').isdigit() else int(h_expr))
            except Exception:
                h = int(h_expr) if h_expr.isdigit() else 0
            fill = 0
            if node.get('value'):
                fill = int(self._eval(node['value']) or 0)
            mat = CsscMatrix(w, h, fill)
            self._variables[node['var']] = mat
            self._variable_types[node['var']] = 'matrix'
        elif directive == 'load':
            load_path = node.get('load_path', '')
            resolved = self._resolve_path(load_path)
            if not os.path.isfile(resolved):
                raise CsscError(operation='Runtime', detail=f'#load: file not found: {load_path}', line=node.get('line', 0))
            with open(resolved, 'r', encoding='utf-8') as f:
                code = f.read()
            sub_lexer = CsscLexer(code, filename=resolved)
            sub_tokens = sub_lexer.tokenize()
            sub_parser = CsscParser(sub_tokens)
            sub_ast = sub_parser.parse()
            child_rt = CsscRuntime(script_dir=os.path.dirname(os.path.abspath(resolved)))
            child_rt._script_args = getattr(self, '_script_args', None)
            mod = CsscLoadedModule(node['var'], resolved, child_rt, sub_ast)
            self._variables[node['var']] = mod
            self._variable_types[node['var']] = 'module'
            self._modules[node['var']] = mod
        elif directive == 'depend':
            # #depend["path.obj"] alias; — isolated .obj package (interpreter mode
            # extracts bundled source)
            depend_path = node.get('depend_path', '')
            resolved = self._depend_locate(depend_path)
            if not resolved:
                raise CsscError(operation='Runtime',
                                detail=f'#depend: could not locate .obj \'{depend_path}\'',
                                hint='Tried literal, cwd, script dir, cproject root, and %APPDATA%/cssc/objects/.',
                                line=node.get('line', 0))
            try:
                from includecpp.core.cssl.native import cssc_obj_format as _obj_fmt
                project_name, entries = _obj_fmt.unpack_obj(resolved)
            except Exception as e:
                raise CsscError(operation='Runtime',
                                detail=f'#depend: failed to read {resolved}: {e}',
                                line=node.get('line', 0))
            src_bytes = None
            for name, data in entries.items():
                if name.startswith('source/') and name.endswith('.cssc'):
                    src_bytes = data
                    break
            if src_bytes is None:
                raise CsscError(operation='Runtime',
                                detail=f'#depend: {resolved} has no source/*.cssc entry for interpreted mode',
                                line=node.get('line', 0))
            code = src_bytes.decode('utf-8')
            sub_lexer = CsscLexer(code, filename=resolved)
            sub_tokens = sub_lexer.tokenize()
            sub_parser = CsscParser(sub_tokens)
            sub_ast = sub_parser.parse()
            child_rt = CsscRuntime(script_dir=os.path.dirname(os.path.abspath(resolved)))
            child_rt._script_args = getattr(self, '_script_args', None)
            mod = CsscLoadedModule(node['var'], resolved, child_rt, sub_ast)
            mod._depend_origin = project_name
            self._variables[node['var']] = mod
            self._variable_types[node['var']] = 'module'
            self._modules[node['var']] = mod
        elif directive == 'unload':
            target = node.get('arg', '')
            # Resolve Object->Member for unload
            mod = None
            owner_vars = self._variables
            real_name = target
            if '->' in target:
                parts = target.split('->', 1)
                obj = self._variables.get(parts[0])
                if isinstance(obj, (CsscObject, CsscSector)):
                    owner_vars = obj._vars
                    real_name = parts[1]
                    mod = obj._vars.get(parts[1])
            else:
                mod = self._variables.get(target)
            if mod is not None:
                if isinstance(mod, CsscLoadedModule) and mod._started:
                    for s in getattr(mod._runtime, '_sectors', []):
                        try: s.run_free()
                        except Exception: pass
                if real_name in owner_vars:
                    del owner_vars[real_name]
                self._modules.pop(real_name, None)
                if real_name in self._variable_types:
                    del self._variable_types[real_name]
        elif directive == 'panic':
            # #panic("message") — throw artificial runtime error
            msg = arg
            if msg in self._variables:
                msg = str(self._variables[msg])
            raise CsscError(operation='PANIC', detail=msg, line=node.get('line', 0))
        elif directive in ('string', 'int', 'array', 'vector', 'map'):
            # Type-specific directives with methods
            type_arg = node.get('type_arg', 'auto')
            bits_arg = node.get('bits_arg', '0')
            init_value = self._eval(node['value']) if node.get('value') else None
            var = node['var']
            if directive == 'string':
                val = str(init_value) if init_value is not None else ''
                self._variables[var] = val
                self._variable_types[var] = 'string'
            elif directive == 'int':
                val = int(init_value) if init_value is not None else 0
                self._variables[var] = val
                self._variable_types[var] = 'int'
            elif directive == 'vector':
                vec = CsscVector()
                if init_value is not None:
                    if isinstance(init_value, (list, CsscVector)):
                        vec.extend(init_value)
                    else:
                        vec.append(init_value)
                self._variables[var] = vec
                self._variable_types[var] = f'vector<{type_arg}>'
            elif directive == 'array':
                size = int(bits_arg) if bits_arg.isdigit() else 10
                arr = CsscArray(type_arg, size)
                if init_value is not None and isinstance(init_value, (list, tuple)):
                    for i, v in enumerate(init_value[:size]):
                        arr.append(v)
                self._variables[var] = arr
                self._variable_types[var] = f'array<{type_arg}>'
            elif directive == 'map':
                m = CsscMap()
                if init_value is not None:
                    if isinstance(init_value, dict):
                        m.update(init_value)
                    elif isinstance(init_value, (list, CsscVector)):
                        for i, v in enumerate(init_value):
                            m[i] = v
                self._variables[var] = m
                self._variable_types[var] = f'map<{type_arg}>'
        elif directive == 'thread':
            stype = node.get('thread_type', 'int')
            init_val = self._eval(node['value']) if node.get('value') else self._default_for_type(stype)
            if init_val is not None:
                init_val = self._coerce(init_val, stype)
            self._variables[node['var']] = init_val
            self._variable_types[node['var']] = stype
            if not hasattr(self, '_thread_vars'):
                self._thread_vars = set()
            self._thread_vars.add(node['var'])
        elif directive == 'daemon':
            target = node.get('arg', '')
            func = None
            resolved_name = target
            if '->' in target:
                parts = target.split('->', 1)
                sector_name, member_name = parts[0].strip(), parts[1].strip()
                resolved_name = member_name
                sector_obj = self._variables.get(sector_name)
                if isinstance(sector_obj, CsscSector):
                    func = sector_obj._vars.get(member_name)
                elif getattr(self, '_building_sector', None) == sector_name:
                    func = self._variables.get(member_name)
            else:
                func = self._variables.get(resolved_name)
            if not callable(func):
                raise CsscError(operation='Runtime', detail=f'#daemon: \'{target}\' is not callable', line=node.get('line', 0))
            at_mod = None
            for m in self._modules.values():
                if getattr(m, '_name', '') == 'asyncthreads':
                    at_mod = m
                    break
            if at_mod:
                at_mod.start_daemon(resolved_name, func, self)
        elif directive == 'killdaemon':
            target = node.get('arg', '')
            if '->' in target:
                target = target.split('->', 1)[1].strip()
            at_mod = None
            for m in self._modules.values():
                if getattr(m, '_name', '') == 'asyncthreads':
                    at_mod = m
                    break
            if at_mod:
                at_mod.stop_daemon(target)
        elif directive == 'await':
            handle_name = node.get('arg', '')
            handle = self._variables.get(handle_name)
            from .cssl_asyncthreads import CsscDaemon
            if isinstance(handle, CsscDaemon):
                if handle._thread and handle._thread.is_alive():
                    handle._thread.join()
                self._variables[node['var']] = handle._result
                self._variable_types[node['var']] = 'auto'
            else:
                self._variables[node['var']] = None
                self._variable_types[node['var']] = 'auto'
        elif directive == 'video':
            from .cssl_video import CsscVideoContext
            _vw = node.get('video_width', '320')
            _vh = node.get('video_height', '240')
            _vf = node.get('video_fps', '60')
            w = int(self._variables.get(_vw, _vw) if not str(_vw).lstrip('-').isdigit() else _vw)
            h = int(self._variables.get(_vh, _vh) if not str(_vh).lstrip('-').isdigit() else _vh)
            fps = int(self._variables.get(_vf, _vf) if not str(_vf).lstrip('-').isdigit() else _vf)
            self._variables[node['var']] = CsscVideoContext(w, h, fps)
            self._variable_types[node['var']] = 'video'
        elif directive == 'console':
            from .cssl_console import CsscConsoleContext
            _cw = node.get('console_width', '80')
            _ch = node.get('console_height', '25')
            w = int(self._variables.get(_cw, _cw) if not str(_cw).lstrip('-').isdigit() else _cw)
            h = int(self._variables.get(_ch, _ch) if not str(_ch).lstrip('-').isdigit() else _ch)
            self._variables[node['var']] = CsscConsoleContext(
                w, h, no_console=bool(getattr(self, '_no_console', False)))
            self._variable_types[node['var']] = 'console'
        elif directive in ('pin', 'i2c', 'spi', 'uart', 'adc', 'pwm', 'timer'):
            self._exec_gipeo_directive(node, directive, node['var'])
        elif directive == 'tft':
            from .cssl_tft import CsscTft
            parts = node.get('arg_parts') or []
            ctrl = (parts[0] if len(parts) > 0 else 'ssd1306').strip().strip('"\'')
            if ctrl in self._variables:
                resolved = self._variables.get(ctrl)
                if isinstance(resolved, str):
                    ctrl = resolved
            try:    w = int(parts[1]) if len(parts) > 1 else 128
            except (TypeError, ValueError): w = 128
            try:    h = int(parts[2]) if len(parts) > 2 else 64
            except (TypeError, ValueError): h = 64
            no_gui = bool(getattr(self, '_no_console', False))
            self._variables[node['var']] = CsscTft(ctrl, w, h, no_gui=no_gui)
            self._variable_types[node['var']] = 'tft'
        elif directive in ('get', 'post', 'send'):
            self._exec_http_directive(node, directive, node['var'])
        elif directive == 'framebuffer':
            from .cssl_video import CsscFramebuffer
            w = int(node.get('fb_width', 320))
            h = int(node.get('fb_height', 240))
            self._variables[node['var']] = CsscFramebuffer(w, h)
            self._variable_types[node['var']] = 'framebuffer'
        elif directive == 'capacity':
            # #capacity[var] cap_var; — get ALLOCATED size in bits (buffer capacity)
            target_var = node['arg']
            if target_var not in self._variables:
                raise CsscError(operation='Runtime', detail=f'#capacity: variable "{target_var}" not defined',
                                line=node.get('line', 0))
            _cap_found = False
            for _sv in ('_stack_vars', '_heap_vars', '_auto_vars'):
                _store = getattr(self, _sv, None)
                if _store and target_var in _store:
                    self._variables[node['var']] = _store[target_var]['max_bits']
                    _cap_found = True
                    break
            if not _cap_found:
                self._variables[node['var']] = sys.getsizeof(self._variables[target_var]) * 8
            self._variable_types[node['var']] = 'int'
        elif directive == 'reserve':
            label = node.get('arg', '')
            target_rt = self
            if '.' in label:
                mod_name, label = label.split('.', 1)
                # Resolve Object->Member chains in module name
                mod = None
                if '->' in mod_name:
                    parts = mod_name.split('->', 1)
                    obj = self._variables.get(parts[0])
                    if isinstance(obj, CsscObject):
                        mod = obj._vars.get(parts[1])
                    elif isinstance(obj, CsscSector):
                        mod = obj._vars.get(parts[1])
                else:
                    mod = self._variables.get(mod_name)
                if isinstance(mod, CsscLoadedModule):
                    if not mod._started:
                        mod.start()
                    target_rt = mod._runtime
                else:
                    raise CsscError(operation='Runtime', detail=f'#reserve: \'{mod_name}\' is not a loaded module', line=node.get('line', 0))
            deferred = getattr(target_rt, '_deferred_sectors', {})
            if label not in deferred:
                raise CsscError(operation='Runtime',
                                detail=f'#reserve: no deferred sector with label \'{label}\'',
                                hint='Use: sector Name ?label {{ ... }} to defer initialization',
                                line=node.get('line', 0))
            sector_node = deferred.pop(label)
            sector_node['reserve_label'] = None
            target_rt._exec_sector(sector_node)
        elif directive == 'free':
            sector_name = node.get('arg', '')
            # Hex target: drop the persistent hex-scope storage.
            if isinstance(sector_name, str) and sector_name.lower().startswith('0x'):
                hex_id = int(sector_name, 16)
                hex_scopes = getattr(self, '_hex_scopes', None)
                if hex_scopes and hex_id in hex_scopes:
                    hex_scopes[hex_id]['freed'] = True
                    hex_scopes.pop(hex_id, None)
                return
            target_rt = self
            if '.' in sector_name:
                mod_name, sector_name = sector_name.split('.', 1)
                mod = self._variables.get(mod_name)
                if isinstance(mod, CsscLoadedModule):
                    target_rt = mod._runtime
                else:
                    raise CsscError(operation='Runtime', detail=f'#free: \'{mod_name}\' is not a loaded module', line=node.get('line', 0))
            sector_obj = target_rt._variables.get(sector_name)
            # Search parent scopes if not found in current scope
            if sector_obj is None and hasattr(target_rt, '_parent_scopes') and target_rt._parent_scopes:
                for ps in reversed(target_rt._parent_scopes):
                    if sector_name in ps:
                        sector_obj = ps[sector_name]
                        break
            if sector_obj is None:
                sector_obj = target_rt._modules.get(sector_name)
            # Unwrap method binding for #free
            _ensure_method_imports()
            if CsscMethodBinding is not None and isinstance(sector_obj, CsscMethodBinding):
                sector_obj.trigger_do('delete', None)
                sector_obj.run_free()
                sector_obj = sector_obj.get_value()
            if isinstance(sector_obj, CsscObject):
                sector_obj.run_free()
            elif isinstance(sector_obj, CsscSector):
                sector_obj.run_free()
            elif isinstance(sector_obj, CsscLoadedModule):
                sector_obj.run_free()
            elif isinstance(sector_obj, CsscModule) or hasattr(sector_obj, 'get_namespace'):
                pass  # Builtin modules: no-op free
            else:
                raise CsscError(operation='Runtime', detail=f'#free: \'{sector_name}\' is not a sector or object', line=node.get('line', 0))
            target_rt._modules.pop(sector_name, None)
            if sector_name in target_rt._variables:
                del target_rt._variables[sector_name]
            if sector_name in target_rt._variable_types:
                del target_rt._variable_types[sector_name]
            if hasattr(target_rt, '_sectors'):
                target_rt._sectors = [s for s in target_rt._sectors if s._name != sector_name]
            self._cleanup_pointers(sector_name)
        elif directive == 'delmember':
            # #delmember[target] / #delmember[target[i]] — soft wipe:
            # release heap content while keeping size/cap intact. The
            # interpreter walks the resolved target and either nulls
            # one entry (indexed form) or every entry (container form).
            target_node = node.get('target') or {}
            index_node = node.get('index')
            target_val = self._eval(target_node) if target_node else None
            if target_val is None:
                pass  # silent no-op on undefined / null
            elif index_node is not None:
                idx = self._eval(index_node)
                # Array<bind> entry at index: replace the whole slot
                # with `None` so the next select iteration sees a null
                # entry and `if (i == 0x0)` matches. Same behaviour as
                # the v6 native `cssc_array_bind_null_at` runtime.
                # CsscBind: same idea — wipe the pair at idx to
                # `(None, None)` so flat-cell access returns None.
                if isinstance(target_val, CsscBind) and isinstance(idx, int):
                    n_pairs = list.__len__(target_val)
                    if 0 <= idx < n_pairs * 2:
                        pair_idx, cell = divmod(idx, 2)
                        a, b = list.__getitem__(target_val, pair_idx)
                        if cell == 0:
                            list.__setitem__(target_val, pair_idx, (None, b))
                        else:
                            list.__setitem__(target_val, pair_idx, (a, None))
                elif isinstance(target_val, list) and isinstance(idx, int):
                    if 0 <= idx < len(target_val):
                        target_val[idx] = None
                elif isinstance(target_val, dict):
                    target_val.pop(idx, None)
            else:
                # No index: wipe everything but preserve length/size.
                # For an array<bind> Buffer this means every entry
                # slot becomes None (matches v6 native null_all).
                if isinstance(target_val, CsscBind):
                    for i in range(list.__len__(target_val)):
                        list.__setitem__(target_val, i, (None, None))
                elif isinstance(target_val, list):
                    for i in range(len(target_val)):
                        target_val[i] = None
                elif isinstance(target_val, dict):
                    target_val.clear()
            return
        elif directive == 'delete':
            # #delete[var] or #delete[0xADDR] or #delete[Sector->Member] — free memory
            target_var = node['arg']
            # Resolve Sector->Member to bare member name (used inside free blocks)
            if isinstance(target_var, str) and '->' in target_var:
                _parts = target_var.split('->', 1)
                _member = _parts[1].strip()
                if _member in self._variables:
                    target_var = _member
            # Detect hex address — resolve to variable name first
            if isinstance(target_var, str) and target_var.lower().startswith('0x'):
                addr_int = int(target_var, 16)
                # Prefer hex-keyed var storage (first-class hex identifier).
                hex_vars = getattr(self, '_hex_vars', None)
                if hex_vars and addr_int in hex_vars:
                    hex_vars.pop(addr_int)
                    return
                if not hasattr(self, '_address_map'):
                    self._address_map = {}
                target_var = self._address_map.get(addr_int)
                if target_var is None:
                    raise CsscError(operation='Runtime',
                                    detail=f'#delete: no allocation at address {hex(addr_int)}',
                                    hint='Use #exists[] to verify the address before deleting',
                                    line=node.get('line', 0))
            elif target_var in self._variables:
                val = self._variables[target_var]
                if isinstance(val, str) and val.lower().startswith('0x') and target_var not in getattr(self, '_stack_vars', {}) and target_var not in getattr(self, '_heap_vars', {}) and target_var not in getattr(self, '_auto_vars', {}):
                    addr_int = int(val, 16)
                    if not hasattr(self, '_address_map'):
                        self._address_map = {}
                    resolved = self._address_map.get(addr_int)
                    if resolved:
                        target_var = resolved
            # Method binding interception: trigger do {} and free {} on delete
            _ensure_method_imports()
            if target_var and CsscMethodBinding is not None:
                _mb = self._variables.get(target_var)
                if isinstance(_mb, CsscMethodBinding):
                    _mb.trigger_do('delete', None)
                    _mb.run_free()
            self._update_address_map(target_var, None, remove=True)
            _deleted_buf = None
            for _sv in ('_stack_vars', '_heap_vars', '_auto_vars'):
                _store = getattr(self, _sv, None)
                if _store and target_var in _store:
                    _deleted_buf = _store[target_var].get('buffer')
                    del _store[target_var]
            # Remove aliased entries that share the same buffer
            if _deleted_buf is not None:
                for _sv in ('_stack_vars', '_heap_vars', '_auto_vars'):
                    _store = getattr(self, _sv, None)
                    if _store:
                        aliases = [n for n, info in _store.items() if info.get('buffer') is _deleted_buf]
                        for alias in aliases:
                            del _store[alias]
                            self._update_address_map(alias, None, remove=True)
                            if alias in self._variables:
                                self._variables[alias] = None
                            if alias in self._variable_types:
                                del self._variable_types[alias]
            if target_var in self._variables:
                del self._variables[target_var]
            if target_var in self._variable_types:
                del self._variable_types[target_var]
            self._cleanup_pointers(target_var)
            if hasattr(self, '_ref_links'):
                for ref_holder, orig_name in list(self._ref_links.items()):
                    if orig_name == target_var and ref_holder in self._variables:
                        self._variables[ref_holder] = None
            # v6 ref-by-default cross-frame propagation: when the
            # deleted name is itself a ref-aliased param (registered
            # by `_exec_scanp`), delete the CALLER's source slot
            # too. This is what makes
            #   `i(l);  // inside i: #scanp(...,0) zahl; #delete[zahl];`
            # invalidate the caller's `l` to `0x0` per spec §2.5.
            self._delete_cross_frame(target_var)
        elif directive == 'set':
            # #set[0xADDR, bits] = value; — write value at raw memory address
            parts = self._split_generic_args(node['arg'])
            addr_expr = parts[0].strip() if len(parts) > 0 else ''
            bits_expr = parts[1].strip() if len(parts) > 1 else ''
            addr_int = self._resolve_address(addr_expr)
            if not hasattr(self, '_address_map'):
                self._address_map = {}
            if addr_int not in self._address_map:
                raise CsscError(operation='Runtime',
                                detail=f'#set: address {hex(addr_int)} is not a known allocation',
                                hint='Use #exists[] to verify the address, or allocate with #stack/#heap first',
                                line=node.get('line', 0))
            target_name = self._address_map[addr_int]
            target_info = None
            for _sv in ('_stack_vars', '_heap_vars', '_auto_vars'):
                _store = getattr(self, _sv, None)
                if _store and target_name in _store:
                    target_info = _store[target_name]
                    break
            if target_info is None:
                raise CsscError(operation='Runtime',
                                detail=f'#set: variable "{target_name}" at {hex(addr_int)} has no buffer',
                                line=node.get('line', 0))
            max_bits = self._resolve_size(bits_expr) if bits_expr else target_info['max_bits']
            max_bytes = max_bits // 8
            write_val = self._eval(node['value']) if node.get('value') is not None else self._default_for_type(target_info['type'])
            if isinstance(write_val, CsscPointer):
                write_val = self._resolve_value(write_val)
            write_val = self._coerce(write_val, target_info['type'])
            encoded = self._encode_value(write_val)
            if len(encoded) > max_bytes:
                raise CsscError(operation='Runtime',
                                detail=f'#set: value exceeds bit limit ({len(encoded) * 8} > {max_bits} bits)',
                                hint=f'Allocated {max_bits} bits at {hex(addr_int)}, value needs {len(encoded) * 8} bits',
                                line=node.get('line', 0))
            buf = target_info['buffer']
            buf.value = encoded[:ctypes.sizeof(buf)]
            self._variables[target_name] = write_val
        elif directive == 'exists':
            # #exists[0xADDR] result_var; — check if address is allocated (returns 1/0)
            addr_expr = node['arg'].strip()
            try:
                addr_int = self._resolve_address(addr_expr)
            except (ValueError, TypeError):
                addr_int = -1
            if not hasattr(self, '_address_map'):
                self._address_map = {}
            result = 1 if addr_int in self._address_map else 0
            self._variables[node['var']] = result
            self._variable_types[node['var']] = 'int'
        elif directive == 'stdout':
            stdout_loaded = any(isinstance(m, CsscStdoutModule) for m in self._modules.values())
            if not stdout_loaded:
                raise CsscError(operation='Runtime',
                                detail='#stdout requires #include("stdout")',
                                hint='Add #include("stdout"); at the top of your script',
                                line=node.get('line', 0))
            txt = str(node.get('arg', '')) if node.get('arg') else ''
            if txt in self._variables:
                txt = str(self._variables[txt])
            stdout_mod = None
            for mod in self._modules.values():
                if isinstance(mod, CsscStdoutModule):
                    stdout_mod = mod
                    break
            if stdout_mod:
                stdout_mod.write(txt)
            self._output_buffer.append(txt + '\n')
        elif directive == 'sysarg':
            sys_loaded = any(isinstance(m, (CsscSysModule, CsscSysArgsModule)) for m in self._modules.values())
            if not sys_loaded:
                raise CsscError(operation='Runtime',
                                detail='#sysarg requires #include("sys")',
                                hint='Add #include("sys") sys; at the top of your script',
                                line=node.get('line', 0))
            stype = node.get('sysarg_type', 'string')
            idx_expr = node.get('sysarg_index', '0')
            try:
                idx = int(self._eval({'type': 'identifier', 'name': idx_expr}) if not idx_expr.lstrip('-').isdigit() else int(idx_expr))
            except Exception:
                idx = int(idx_expr) if idx_expr.lstrip('-').isdigit() else 0
            args = getattr(self, '_script_args', None) or list(sys.argv[1:])
            raw_val = args[idx] if 0 <= idx < len(args) else None
            var = node['var']
            if raw_val is not None:
                val = self._coerce(raw_val, stype)
            else:
                val = self._default_for_type(stype)
            if not hasattr(self, '_stack_vars'):
                self._stack_vars = {}
            encoded = self._encode_value(val)
            buf = ctypes.create_string_buffer(max(len(encoded), 32))
            buf.value = encoded[:len(buf)]
            self._variables[var] = val
            self._variable_types[var] = stype
            self._stack_vars[var] = {'type': stype, 'max_bits': len(buf) * 8, 'buffer': buf, 'region': 'stack'}
            self._update_address_map(var, buf)
        elif directive == 'sysout':
            val_node = node.get('value')
            val = self._eval(val_node) if val_node else None
            raise _SysReturnSignal(val)
        elif directive == 'reallocate':
            # TRUE reallocation: moves the buffer between regions, zero-copy.
            # Type-strict: type must match source. No coercion.
            src = node.get('source_var', '')
            target_region = node.get('target_region', 'heap')
            vtype = node.get('realloc_type', 'auto')
            size_expr = node.get('realloc_size')
            # Resolve Sector->Member references
            if '->' in src and src not in self._variables:
                _arrow_parts = src.split('->', 1)
                _sector_name, _member_name = _arrow_parts[0].strip(), _arrow_parts[1].strip()
                if getattr(self, '_building_sector', None) == _sector_name:
                    if _member_name in self._variables:
                        src = _member_name
                else:
                    _sector_obj = self._variables.get(_sector_name)
                    if hasattr(_sector_obj, 'get_member') and _sector_obj.get_member(_member_name) is not None:
                        self._variables[_member_name] = _sector_obj.get_member(_member_name)
                        src = _member_name
            if src not in self._variables:
                raise CsscError(operation='Runtime', detail=f'#reallocate: source \'{src}\' not found', line=node.get('line', 0))
            val = self._variables[src]
            src_type = self._variable_types.get(src, 'auto')
            if vtype != 'auto' and src_type != 'auto' and vtype != src_type:
                raise CsscError(operation='Runtime',
                                detail=f'#reallocate: type mismatch — \'{src}\' is {src_type}, not {vtype}',
                                hint=f'Use #reallocate[{src}, {src_type}, {target_region}] to match the source type',
                                line=node.get('line', 0))
            src_alloc = None
            src_store_name = None
            for _sv in ('_stack_vars', '_heap_vars', '_auto_vars'):
                _store = getattr(self, _sv, None)
                if _store and src in _store:
                    src_alloc = _store.pop(src)
                    src_store_name = _sv
                    break
            old_max_bits = src_alloc['max_bits'] if src_alloc else 256
            buf = src_alloc['buffer'] if src_alloc else None
            encoded = self._encode_value(val)
            used_bits = len(encoded) * 8
            if size_expr is not None:
                max_bits = self._resolve_size(size_expr)
            else:
                max_bits = (old_max_bits + 32) if (old_max_bits - used_bits) < 32 else old_max_bits
            max_bytes = max(max_bits // 8, len(encoded))
            if buf is not None:
                old_size = ctypes.sizeof(buf)
                if max_bytes != old_size:
                    try:
                        ctypes.resize(buf, max_bytes)
                    except ValueError:
                        new_buf = ctypes.create_string_buffer(max_bytes)
                        ctypes.memmove(new_buf, buf, min(old_size, max_bytes))
                        buf = new_buf
            else:
                buf = ctypes.create_string_buffer(max_bytes)
                buf.value = encoded[:max_bytes]
            var = node['var']
            self._variables[var] = val
            self._variable_types[var] = vtype
            alloc_entry = {'type': vtype, 'max_bits': max_bits, 'buffer': buf, 'region': target_region}
            if target_region == 'stack':
                if not hasattr(self, '_stack_vars'):
                    self._stack_vars = {}
                self._stack_vars[var] = alloc_entry
            else:
                if not hasattr(self, '_heap_vars'):
                    self._heap_vars = {}
                self._heap_vars[var] = alloc_entry
            self._update_address_map(src, None, remove=True)
            self._update_address_map(var, buf)
            if src in self._variables:
                del self._variables[src]
            if src in self._variable_types:
                del self._variable_types[src]
            self._cleanup_pointers(src)
        elif directive == 'raii':
            self._exec_raii_invoke(node)
        elif directive == 'DEFINE':
            # Transpiler-only hint — no-op at runtime in either interpreter.
            pass
        elif directive == 'debug':
            # `#debug(msg);` — formatted message ALWAYS goes into the
            # devdebug.stdout container (so #console sync works without
            # --debug); stderr printing is gated on --debug.
            val = self._eval(node.get('value')) if node.get('value') else node.get('arg', '')
            msg = '' if val is None else str(val)
            self._push_devdebug_stdout(msg)
            if getattr(self, '_debug_enabled', False):
                import sys as _sys
                _sys.stderr.write(f'[debug] {msg}\n')
                _sys.stderr.flush()
        elif directive == 'trace':
            # `#trace(funcName);` — wrap the function so each call logs.
            if getattr(self, '_debug_enabled', False):
                target = node.get('arg', '').strip() or node.get('var', '')
                self._install_trace(target, node.get('line', 0))
        elif directive == 'catch':
            self._exec_catch_directive(node)
        elif directive == 'stack':
            # #stack[type, bits] var = val; — stack allocation with ctypes buffer
            if not hasattr(self, '_stack_vars'):
                self._stack_vars = {}
            parts = self._split_generic_args(node['arg'])
            vtype = parts[0] if len(parts) > 0 else 'auto'
            max_bits = self._resolve_size(parts[1]) if len(parts) > 1 else 256
            max_bytes = max_bits // 8
            init_value = None
            if node.get('value') is not None:
                # Doc §8.4: indexed access is a live ref by default.
                init_value = self._slot_init_value(node['value'])
            # Copy interception: if source is method-bound, trigger 'copied' before coercion
            _ensure_method_imports()
            if CsscMethodBinding is not None and isinstance(init_value, CsscMethodBinding):
                init_value.trigger_do('copied', None)
                init_value = init_value.get_value()  # unwrap after do {} ran
            # See the fix at the primary #stack site (~line 6496): eagerly
            # dereference a CsscPointer when the declared type is a scalar
            # POD, so `#stack[int, 64] c = _v[i]; c = c + 5;` produces 25
            # not "205".
            _pod_scalar_types = {'int', 'i32', 'i64', 'float', 'f32', 'f64',
                                    'double', 'bool', 'string', 'str', 'char'}
            _wants_pointer_semantics = (
                vtype in ('auto', 'dyn', 'var', '')
                or vtype.startswith('*') or vtype.startswith('&')
                or vtype.startswith('vector') or vtype.startswith('array')
                or vtype.startswith('map') or vtype.startswith('bind')
            )
            if isinstance(init_value, CsscPointer):
                if not _wants_pointer_semantics and \
                        vtype.split('<', 1)[0].strip() in _pod_scalar_types:
                    init_value = self._resolve_value(init_value)
                    if init_value is not None:
                        init_value = self._coerce(init_value, vtype)
                    else:
                        init_value = self._default_for_type(vtype)
            elif init_value is not None:
                init_value = self._coerce(init_value, vtype)
            else:
                init_value = self._default_for_type(vtype)
            # Callable/pointer/complex references: skip encoding, store directly.
            # Containers (vector/array/map/bind) carry their SECOND #stack arg as
            # a capacity (element count), NOT a scalar bit-limit — so they bypass
            # the byte-encoding bit check too (matches native, where `array<int>,8`
            # means 8 slots, not 8 bits).
            if isinstance(init_value, (CsscPointer, CsscMatrix, CsscLoadedModule,
                                       CsscObject, CsscSector,
                                       CsscVector, CsscArray, CsscMap, CsscBind)):
                buf = ctypes.create_string_buffer(max(max_bytes, 8))
            elif callable(init_value) and not isinstance(init_value, (bool, int, float, str, list, dict)):
                addr_bytes = hex(id(init_value)).encode('utf-8')
                buf = ctypes.create_string_buffer(max(max_bytes, len(addr_bytes)))
                buf.value = addr_bytes
            else:
                encoded = self._encode_value(init_value)
                if len(encoded) > max_bytes:
                    raise CsscError(operation='Runtime',
                                    detail=f'#stack: value exceeds bit limit ({len(encoded) * 8} > {max_bits} bits)',
                                    hint=f'Increase bit limit or reduce value size',
                                    line=node.get('line', 0))
                buf = ctypes.create_string_buffer(max_bytes)
                buf.value = encoded[:max_bytes]
            _sv = node['var']
            if isinstance(_sv, str) and _sv.lower().startswith('0x'):
                hex_id = int(_sv, 16)
                if not hasattr(self, '_hex_vars'):
                    self._hex_vars = {}
                self._hex_vars[hex_id] = {
                    'value': init_value, 'type': vtype, 'max_bits': max_bits, 'buffer': buf,
                }
            else:
                self._variables[_sv] = init_value
                self._variable_types[_sv] = vtype
                self._stack_vars[_sv] = {'type': vtype, 'max_bits': max_bits, 'buffer': buf, 'region': 'stack'}
                self._update_address_map(_sv, buf)
        elif directive == 'heap':
            # #heap[type, bits] var = val; — heap allocation, auto-destructed
            if not hasattr(self, '_heap_vars'):
                self._heap_vars = {}
            parts = self._split_generic_args(node['arg'])
            vtype = parts[0] if len(parts) > 0 else 'auto'
            max_bits = self._resolve_size(parts[1]) if len(parts) > 1 else 1024
            max_bytes = max_bits // 8
            init_value = None
            if node.get('value') is not None:
                init_value = self._eval(node['value'])
            # Copy interception: if source is method-bound, trigger 'copied' before coercion
            _ensure_method_imports()
            if CsscMethodBinding is not None and isinstance(init_value, CsscMethodBinding):
                init_value.trigger_do('copied', None)
                init_value = init_value.get_value()  # unwrap after do {} ran
            # If *var creates a CsscPointer, store it as-is (lazy reference).
            # Coerce only non-pointer values to the declared type.
            if isinstance(init_value, CsscPointer):
                pass  # keep CsscPointer — lazy dereference on access
            elif init_value is not None:
                init_value = self._coerce(init_value, vtype)
            else:
                init_value = self._default_for_type(vtype)
            # Complex objects (Matrix, LoadedModule, etc.) skip encoding
            if isinstance(init_value, (CsscMatrix, CsscLoadedModule, CsscObject,
                                       CsscSector,
                                       CsscVector, CsscArray, CsscMap, CsscBind)):
                buf = ctypes.create_string_buffer(8)
                self._variables[node['var']] = init_value
                self._variable_types[node['var']] = vtype
                self._heap_vars[node['var']] = {'type': vtype, 'max_bits': max_bits, 'buffer': buf}
            else:
                encoded = self._encode_value(init_value)
                if len(encoded) > max_bytes:
                    raise CsscError(operation='Runtime',
                                    detail=f'#heap: value exceeds bit limit ({len(encoded) * 8} > {max_bits} bits)',
                                    hint=f'Increase bit limit or reduce value size',
                                    line=node.get('line', 0))
                buf = ctypes.create_string_buffer(max_bytes)
                buf.value = encoded[:max_bytes]
                self._variables[node['var']] = init_value
                self._variable_types[node['var']] = vtype
                self._heap_vars[node['var']] = {'type': vtype, 'max_bits': max_bits, 'buffer': buf}
            self._update_address_map(node['var'], buf)
        elif directive == 'auto':
            # #auto[type] var = val; — auto-sized stack allocation, manual delete
            if not hasattr(self, '_auto_vars'):
                self._auto_vars = {}
            vtype = node['arg'] if node['arg'] else 'auto'
            init_value = None
            if node.get('value') is not None:
                init_value = self._eval(node['value'])
            if init_value is not None:
                init_value = self._coerce(init_value, vtype)
            else:
                init_value = self._default_for_type(vtype)
            encoded = self._encode_value(init_value)
            buf_size = max(len(encoded), 32)
            buf = ctypes.create_string_buffer(buf_size)
            buf.value = encoded[:buf_size]
            self._variables[node['var']] = init_value
            self._variable_types[node['var']] = vtype
            self._auto_vars[node['var']] = {'type': vtype, 'max_bits': buf_size * 8, 'buffer': buf, 'region': 'heap'}
            self._update_address_map(node['var'], buf)
        elif directive in ('peekstack', 'peekheap'):
            peek_type = node.get('peek_type', 'auto')
            source_var = node.get('peek_source', '')
            idx_expr = node.get('peek_index', '0')
            amount_expr = node.get('peek_amount', '1')
            try:
                idx = int(self._eval({'type': 'identifier', 'name': idx_expr}) if not idx_expr.lstrip('-').isdigit() else int(idx_expr))
            except Exception:
                idx = int(idx_expr) if idx_expr.lstrip('-').isdigit() else 0
            try:
                amount = int(self._eval({'type': 'identifier', 'name': amount_expr}) if not amount_expr.lstrip('-').isdigit() else int(amount_expr))
            except Exception:
                amount = int(amount_expr) if amount_expr.lstrip('-').isdigit() else 1
            source = self._variables.get(source_var)
            if source is None:
                raise CsscError(operation='Runtime', detail=f'#{directive}: source \'{source_var}\' not found', line=node.get('line', 0))
            if not isinstance(source, (list, tuple, str)):
                raise CsscError(operation='Runtime', detail=f'#{directive}: source \'{source_var}\' is not a collection', line=node.get('line', 0))
            if amount >= 0:
                result = source[idx:idx + amount] if idx < len(source) else []
            else:
                start = max(0, idx + amount)
                result = source[start:idx] if idx <= len(source) else []
            if abs(amount) == 1:
                result = result[0] if result else None
            if peek_type != 'auto' and result is not None:
                result = self._coerce(result, peek_type)
            var = node['var']
            self._variables[var] = result
            self._variable_types[var] = peek_type
            if directive == 'peekstack':
                if not hasattr(self, '_stack_vars'):
                    self._stack_vars = {}
                encoded = self._encode_value(result)
                buf = ctypes.create_string_buffer(max(len(encoded), 32))
                buf.value = encoded[:len(buf)]
                self._stack_vars[var] = {'type': peek_type, 'max_bits': len(buf) * 8, 'buffer': buf, 'region': 'stack'}
                self._update_address_map(var, buf)
            else:
                if not hasattr(self, '_heap_vars'):
                    self._heap_vars = {}
                encoded = self._encode_value(result)
                buf = ctypes.create_string_buffer(max(len(encoded), 32))
                buf.value = encoded[:len(buf)]
                self._heap_vars[var] = {'type': peek_type, 'max_bits': len(buf) * 8, 'buffer': buf, 'region': 'heap'}
                self._update_address_map(var, buf)
        elif directive == 'resize':
            # #resize[var, +/-bits] — resize allocation
            parts = self._split_generic_args(node['arg'])
            target_var = parts[0] if len(parts) > 0 else ''
            delta_bits = self._resolve_size(parts[1]) if len(parts) > 1 else 0
            # Resolve refs: CsscPointer, #ref_links, or direct variable
            val = self._variables.get(target_var)
            if isinstance(val, CsscPointer):
                target_var = val.name
            elif hasattr(self, '_ref_links') and target_var in self._ref_links:
                target_var = self._ref_links[target_var]
            found_in = None
            # Search current scope alloc stores
            for sv in ('_stack_vars', '_heap_vars', '_auto_vars'):
                store = getattr(self, sv, None)
                if store and target_var in store:
                    found_in = store
                    break
            # Search parent scopes' alloc stores (for refs inside #define)
            if found_in is None and hasattr(self, '_parent_scopes'):
                for ps in reversed(self._parent_scopes):
                    # Parent scope's ref_links might map our target_var
                    if target_var in ps:
                        ref_val = ps[target_var]
                        if isinstance(ref_val, CsscPointer):
                            target_var = ref_val.name
                    for sv in ('_stack_vars', '_heap_vars', '_auto_vars'):
                        store = getattr(self, sv, None)
                        if store and target_var in store:
                            found_in = store
                            break
                    if found_in:
                        break
            if found_in is None:
                raise CsscError(operation='Runtime',
                                detail=f'#resize: "{target_var}" is not a #stack, #heap, or #auto variable',
                                line=node.get('line', 0))
            info = found_in[target_var]
            new_bits = info['max_bits'] + delta_bits
            if new_bits <= 0:
                raise CsscError(operation='Runtime',
                                detail=f'#resize: resulting size would be {new_bits} bits (must be > 0)',
                                line=node.get('line', 0))
            new_bytes = new_bits // 8
            old_buf = info['buffer']
            old_data = old_buf.raw[:min(ctypes.sizeof(old_buf), new_bytes)]
            new_buf = ctypes.create_string_buffer(new_bytes)
            new_buf[:len(old_data)] = old_data
            self._update_address_map(target_var, None, remove=True)
            info['max_bits'] = new_bits
            info['buffer'] = new_buf
            self._update_address_map(target_var, new_buf)
        elif directive == 'clock':
            ms = self._resolve_size(node['arg']) if node.get('arg') else 0
            if ms > 0:
                time.sleep(ms / 1000.0)
        elif directive == 'cast':
            # #cast[source, target] result; — explicit type cast
            parts = self._split_generic_args(node['arg'])
            if len(parts) < 2:
                raise CsscError(operation='Runtime',
                                detail='#cast requires two arguments: #cast[source, target] result;',
                                line=node.get('line', 0))
            source_name = parts[0].strip()
            target_name = parts[1].strip()
            if source_name in self._variables:
                source_val = self._variables[source_name]
            else:
                try:
                    expr_tokens = CsscLexer(source_name + ';', '<cast>').tokenize()
                    expr_ast = CsscParser(expr_tokens, '<cast>').parse()
                    if expr_ast:
                        n = expr_ast[0]
                        source_val = self._eval(n.get('expr', n) if n.get('type') == 'expr_stmt' else n)
                    else:
                        raise CsscError(operation='Runtime',
                                        detail=f'#cast: unknown source "{source_name}"',
                                        line=node.get('line', 0))
                except CsscError:
                    raise
                except Exception:
                    raise CsscError(operation='Runtime',
                                    detail=f'#cast: cannot resolve source "{source_name}"',
                                    line=node.get('line', 0))
            if not hasattr(self, '_heap_vars') or target_name not in self._heap_vars:
                raise CsscError(operation='Runtime',
                                detail=f'#cast: target "{target_name}" must be an existing #heap variable',
                                hint='Declare with #heap[type, bits] first',
                                line=node.get('line', 0))
            target_type = self._variable_types.get(target_name, 'auto')
            target_info = self._heap_vars[target_name]
            cast_val = False
            try:
                from includecpp.core.cssl.cssl_binary import Binary
                if isinstance(source_val, Binary):
                    b = CsscBinaryModule()._get_binary()
                    cast_val = b.frombinary(source_val, target_type)
                else:
                    # #cast is EXPLICIT — always coerce, no strict type check
                    cast_val = self._coerce(source_val, target_type)
            except (CsscError, Exception):
                cast_val = False
            if cast_val is not False:
                encoded = self._encode_value(cast_val)
                max_bytes = target_info['max_bits'] // 8
                if len(encoded) > max_bytes:
                    raise CsscError(operation='Runtime',
                                    detail=f'#cast: result size ({len(encoded) * 8} bits) exceeds target capacity ({target_info["max_bits"]} bits)',
                                    hint=f'Use #resize[{target_name}, {len(encoded) * 8 - target_info["max_bits"]}] first',
                                    line=node.get('line', 0))
                self._variables[target_name] = cast_val
                target_info['buffer'] = ctypes.create_string_buffer(max_bytes)
                target_info['buffer'].value = encoded[:max_bytes]
            if node.get('var'):
                self._variables[node['var']] = cast_val
                self._variable_types[node['var']] = target_type if cast_val is not False else 'bool'
        else:
            # v5.2: Check custom hash operations from cproject mods
            if hasattr(self, '_custom_hash_ops') and directive in self._custom_hash_ops:
                op_info = self._custom_hash_ops[directive]
                cb = op_info.get('callback')
                if callable(cb):
                    # Parse and evaluate args from the directive arg string
                    call_args = []
                    if node.get('arg'):
                        for a in self._split_generic_args(node['arg']):
                            a = a.strip()
                            try:
                                expr_tokens = CsscLexer(a + ';', '<arg>').tokenize()
                                expr_ast = CsscParser(expr_tokens, '<arg>').parse()
                                if expr_ast and len(expr_ast) > 0:
                                    node_a = expr_ast[0]
                                    if node_a.get('type') == 'expr_stmt':
                                        call_args.append(self._eval(node_a.get('expr', node_a)))
                                    else:
                                        call_args.append(self._eval(node_a))
                                else:
                                    call_args.append(a.strip('"').strip("'"))
                            except Exception:
                                a = a.strip('"').strip("'")
                                if a in self._variables:
                                    call_args.append(self._variables[a])
                                else:
                                    call_args.append(a)
                    result = cb(*call_args)
                    if node.get('var') and result is not None:
                        self._variables[node['var']] = result
            else:
                raise CsscError(operation='Runtime',
                                detail=f'Unknown directive "#{directive}"',
                                hint=f'Check spelling or ensure the required module/extension is loaded',
                                line=node.get('line', 0))

    @staticmethod
    def _encode_value(value):
        import struct as _struct
        if isinstance(value, CsscPointer):
            return str(value).encode('utf-8')
        elif isinstance(value, str):
            return value.encode('utf-8')
        elif isinstance(value, bool):
            return b'\x01' if value else b'\x00'
        elif isinstance(value, int):
            nbytes = max(1, (value.bit_length() + 8) // 8)
            try:
                return value.to_bytes(nbytes, 'little', signed=True)
            except OverflowError:
                return value.to_bytes(nbytes + 1, 'little', signed=True)
        elif isinstance(value, float):
            return _struct.pack('<d', value)
        elif isinstance(value, (list, tuple, dict)):
            import json as _json
            def _sanitize(v):
                if isinstance(v, CsscPointer):
                    return repr(v)
                if isinstance(v, CsscFunction):
                    return repr(v)
                if isinstance(v, tuple):
                    return [_sanitize(x) for x in v]
                if isinstance(v, list):
                    return [_sanitize(x) for x in v]
                if isinstance(v, dict):
                    return {str(k): _sanitize(val) for k, val in v.items()}
                return v
            return _json.dumps(_sanitize(value)).encode('utf-8')
        elif isinstance(value, CsscFunction):
            return str(value).encode('utf-8')
        return str(value).encode('utf-8') if value is not None else b''

    def _cleanup_pointers(self, deleted_name):
        """Nullify all CsscPointer references to deleted_name — in containers AND direct variables.

        See the matching method on the primary runtime for the
        CsscBind subclass-preservation rationale: a list comp builds
        a plain `list` and drops `pair_width`, so we iterate in place
        for CsscBind values and only rebuild a fresh list when the
        target is a vanilla list AND actually contains a matching
        CsscPointer.
        """
        for vname, vval in list(self._variables.items()):
            if isinstance(vval, CsscPointer) and vval.name == deleted_name:
                self._variables[vname] = None
            elif isinstance(vval, CsscBind):
                for _ix in range(list.__len__(vval)):
                    _p = list.__getitem__(vval, _ix)
                    if isinstance(_p, CsscPointer) and _p.name == deleted_name:
                        list.__setitem__(vval, _ix, None)
                    elif isinstance(_p, tuple):
                        if any(isinstance(_c, CsscPointer)
                                and _c.name == deleted_name
                                for _c in _p):
                            list.__setitem__(vval, _ix,
                                tuple(None if (isinstance(_c, CsscPointer)
                                                and _c.name == deleted_name)
                                      else _c for _c in _p))
            elif isinstance(vval, list):
                if any(isinstance(x, CsscPointer) and x.name == deleted_name
                       for x in vval):
                    self._variables[vname] = [
                        None if (isinstance(x, CsscPointer) and x.name == deleted_name) else x
                        for x in vval
                    ]
            elif isinstance(vval, dict):
                for k, v in vval.items():
                    if isinstance(v, CsscPointer) and v.name == deleted_name:
                        vval[k] = None

    def _slot_init_value(self, value_node):
        """Evaluate a slot-init RHS with v5-ref-by-default semantics.

        Per Doc §8.4 an indexed access `container[i]` in a slot init is
        a *live reference* — mutations to `container[i]` propagate to
        the slot. The explicit-copy form is `&container[i]` which lowers
        through a `copy_of` AST node and falls through to eager eval.

        Anything else uses the normal eager `_eval` path.
        """
        if isinstance(value_node, dict):
            t = value_node.get('type')
            if t == 'index':
                obj_node = value_node.get('object', {})
                idx_node = value_node.get('index')
                if isinstance(obj_node, dict) and obj_node.get('type') == 'identifier':
                    src = obj_node.get('name', '')
                    if src in self._variables:
                        idx = self._eval(idx_node)
                        return CsscPointer(src, idx)
        return self._eval(value_node)

    def _resolve_value(self, val):
        """If val is a CsscPointer, resolve LIVE to the actual variable value.
        Supports indexed pointers: *var[index] resolves to var[index] at access time."""
        if isinstance(val, CsscPointer):
            result = self._variables.get(val.name)
            if result is None and hasattr(self, '_parent_scopes'):
                for scope in reversed(self._parent_scopes):
                    if val.name in scope:
                        result = scope[val.name]
                        break
            # Apply index if present — live resolution
            if val.index is not None and result is not None:
                idx = val.index
                if isinstance(result, CsscFunction):
                    # func[0] = last return value
                    if idx == 0 or idx == 'value':
                        return result._last_return
                elif isinstance(result, (list, dict)):
                    try:
                        return result[idx]
                    except (IndexError, KeyError):
                        return None
                elif hasattr(result, '__getitem__'):
                    try:
                        return result[idx]
                    except Exception:
                        return None
            return result
        return val

    def _update_address_map(self, var, buf=None, remove=False):
        """Keep _address_map in sync: maps real ctypes addresses to variable names."""
        if not hasattr(self, '_address_map'):
            self._address_map = {}
        if remove:
            to_del = [addr for addr, vname in self._address_map.items() if vname == var]
            for addr in to_del:
                del self._address_map[addr]
        elif buf is not None:
            self._address_map[ctypes.addressof(buf)] = var

    def _resolve_address(self, addr_expr):
        """Resolve an address expression: hex literal, variable name, or variable value."""
        if addr_expr in self._variables:
            addr_val = self._variables[addr_expr]
        else:
            addr_val = addr_expr
        if isinstance(addr_val, str) and addr_val.lower().startswith('0x'):
            return int(addr_val, 16)
        return int(addr_val)

    def _resolve_size(self, s):
        s = s.strip()
        if s.lstrip('-').isdigit():
            return int(s)
        if '::' in s:
            ns, member = s.split('::', 1)
            mod = self._modules.get(ns) or self._variables.get(ns)
            if mod and isinstance(mod, CsscModule):
                val = mod.get_namespace().get(member)
                if val is not None:
                    return int(val)
            raise CsscError(operation='Runtime', detail=f'Cannot resolve size: {s}')
        val = self._variables.get(s)
        if val is not None:
            return int(val)
        raise CsscError(operation='Runtime', detail=f'Cannot resolve size: {s}')

    def _exec_define(self, node):
        target = node['target']
        body = node['body']
        def _callback(*_args):
            if not hasattr(self, '_call_args_stack'):
                self._call_args_stack = []
            self._call_args_stack.append((target, _args))
            # v6 ref-by-default: pull the meta queue the caller
            # stashed via `_stash_pending_arg_metas` and push a
            # parallel frame so `_exec_scanp` can decide ref/copy
            # from the CALL SITE.
            metas = self._consume_pending_arg_metas(len(_args))
            self._push_call_meta(target, metas)
            # Scope isolation
            saved_vars = self._variables.copy()
            saved_types = self._variable_types.copy()
            if not hasattr(self, '_parent_scopes'):
                self._parent_scopes = []
            self._parent_scopes.append(saved_vars)
            local_scope = {target: saved_vars.get(target)}
            self._variables = local_scope
            self._variable_types = {}
            if target in saved_types:
                self._variable_types[target] = saved_types[target]
            # Spec §6.1: see the matching block in the legacy
            # `_exec_define` above — sector members are addressable
            # bare from inside `#define(Sec->fn)` bodies. Inject the
            # owning sector's `_vars` into the local scope here so
            # `frame_index` resolves without the `Sec->` prefix.
            sector_owner = None
            sector_member_snapshot: Dict[str, Any] = {}
            if '->' in target:
                _sec_name = target.split('->', 1)[0].strip()
                _candidate = (saved_vars.get(_sec_name)
                              or getattr(self, '_modules', {}).get(_sec_name))
                if _candidate is None:
                    for _s in getattr(self, '_sectors', []) or []:
                        if getattr(_s, '_name', None) == _sec_name:
                            _candidate = _s
                            break
                if isinstance(_candidate, CsscSector):
                    sector_owner = _candidate
                    _own_mn = target.split('->', 1)[1].strip()
                    for _mn, _mv in sector_owner._vars.items():
                        if _mn == _own_mn:
                            continue
                        if _mn in local_scope:
                            continue
                        local_scope[_mn] = _mv
                        sector_member_snapshot[_mn] = _mv
            # `mirror value;` vs `return value;` — both produce the
            # function's return value, BUT differ in what happens
            # afterwards:
            #
            #   * `return value;` — HARD short-circuit. Body aborts.
            #     Cleanup statements after the `return` are SKIPPED.
            #     Use this when there's nothing left to clean up.
            #
            #   * `mirror value;` — captures the return value AND
            #     keeps running the remaining body. The trailing
            #     `#delete[copied]` / `#free[X]` etc. still execute.
            #     Default is REF (v6 ownership): if `value` is a
            #     bare slot name, the outer capture stays live-
            #     linked — deleting the inner slot in the rest of
            #     the body invalidates the outer to `0x0`.
            #   * `mirror &value;` — explicit DEEP-COPY. Snapshot
            #     wins; later body deletes don't affect outer.
            #
            # Implementation: per-stmt try/except. `mirror` raises
            # `_MirrorSignal`; we catch it at the stmt level (aborts
            # the current stmt path, e.g. inside an if-body) but the
            # outer FOR loop keeps walking. `return` raises
            # `_ReturnSignal` which short-circuits the body normally.
            mirror_value = _UNSET = object()
            mirror_ref_source = None
            try:
                for stmt in body:
                    try:
                        self._exec_node(stmt)
                    except _MirrorSignal as _m:
                        # First mirror wins; subsequent mirrors are
                        # ignored. Body keeps walking — cleanup runs.
                        if mirror_value is _UNSET:
                            mirror_value = _m.value
                            if _m.is_ref and _m.ref_source:
                                mirror_ref_source = _m.ref_source
            except _ReturnSignal as r:
                if r.source_var:
                    if not hasattr(self, '_return_transfers'):
                        self._return_transfers = []
                    for _sv in ('_stack_vars', '_auto_vars', '_heap_vars'):
                        _store = getattr(self, _sv, None)
                        if _store and r.source_var in _store:
                            self._return_transfers.append((_sv, r.source_var, _store.pop(r.source_var)))
                            break
                mirror_value = r.value
                mirror_ref_source = None
            finally:
                # Live-ref re-fetch: if mirror was a bare-slot ref
                # AND that slot still exists at body-end → use its
                # current value (may have been mutated by post-mirror
                # statements). If the slot was deleted, the outer
                # capture becomes `0x0` per spec.
                if mirror_ref_source is not None:
                    if mirror_ref_source in self._variables:
                        mirror_value = self._variables[mirror_ref_source]
                    else:
                        mirror_value = 0    # 0x0 per spec
                self._call_args_stack.pop()
                # v6 ref-by-default: pop the meta frame in lock-step.
                self._pop_call_meta()
                # Spec §6.1 sector-member write-back. Same logic as
                # the legacy `_exec_define` — if the body mutated a
                # bare sector member, propagate it back to the owning
                # sector's `_vars` so subsequent calls see the update.
                if sector_owner is not None:
                    for _mn, _old in sector_member_snapshot.items():
                        _new = self._variables.get(_mn, _old)
                        if _new is not _old:
                            sector_owner._vars[_mn] = _new
                if hasattr(self, '_ref_links'):
                    # Pass 1: write-back ref-aliased params whose
                    # local slot was MUTATED (assigned, not deleted).
                    # If the slot was already #delete'd by the body,
                    # `_delete_cross_frame` already cleared the alias
                    # entry AND the parent slot — so the iteration
                    # naturally skips those.
                    for local_name, global_name in list(self._ref_links.items()):
                        if local_name in self._variables:
                            new_val = self._variables[local_name]
                            if '->' in global_name:
                                parts = global_name.split('->', 1)
                                sn, mn = parts[0].strip(), parts[1].strip()
                                for scope in ([saved_vars] + (self._parent_scopes if hasattr(self, '_parent_scopes') else [])):
                                    if sn in scope and isinstance(scope[sn], CsscSector):
                                        scope[sn]._vars[mn] = new_val
                                        break
                            else:
                                if global_name in saved_vars:
                                    saved_vars[global_name] = new_val
                                if hasattr(self, '_parent_scopes'):
                                    for ps in reversed(self._parent_scopes):
                                        if global_name in ps:
                                            ps[global_name] = new_val
                    # Pass 2: drop alias entries whose local name
                    # lived in this scope. The local slot is about
                    # to vanish; the entry would be a stale alias to
                    # nothing.
                    for local_name in list(self._ref_links.keys()):
                        if local_name in self._variables:
                            self._ref_links.pop(local_name, None)
                self._variables = saved_vars
                self._variable_types = saved_types
                if hasattr(self, '_parent_scopes') and self._parent_scopes:
                    self._parent_scopes.pop()
            # Prefer the mirror/return-captured value; fall back to
            # the function-slot's last write (legacy compat with
            # `funcname = value;` style assignment-as-return).
            if mirror_value is not _UNSET:
                return mirror_value
            return self._variables.get(target)
        is_fvar = hasattr(self, '_fvar_names') and target in self._fvar_names
        alloc_bits = None
        for _sv in ('_stack_vars', '_heap_vars'):
            _store = getattr(self, _sv, None)
            if _store and target in _store:
                alloc_bits = _store[target].get('max_bits')
                break
        # #auto is auto-sizing — no overflow check
        func = CsscFunction(_callback, name=target, is_fvar=is_fvar,
                            max_bits=alloc_bits, encode_fn=self._encode_value)
        func._body = body  # Store AST for #redefine support
        # A variable IS a function: its value slot is `[0]`. Upgrading an
        # existing slot to callable must PRESERVE what was last assigned to
        # it — `#stack[float] fvar = 32.221; #define(fvar){…}` keeps
        # `fvar[0] == 32.221`. On re-#define, carry the prior function's
        # `[0]` forward.
        _prev = self._slot_value_snapshot(target)
        if isinstance(_prev, CsscFunction):
            func._last_return = _prev._last_return
        elif _prev is not None:
            func._last_return = _prev
        if '->' in target:
            parts = target.split('->', 1)
            sector_name, member_name = parts[0].strip(), parts[1].strip()
            sector_obj = self._variables.get(sector_name)
            if isinstance(sector_obj, CsscSector):
                sector_obj._vars[member_name] = func
                sector_obj._public.add(member_name)
            elif getattr(self, '_building_sector', None) == sector_name:
                self._variables[member_name] = func
                if not hasattr(self, '_sector_public_overrides'):
                    self._sector_public_overrides = set()
                self._sector_public_overrides.add(member_name)
            else:
                raise CsscError(operation='Runtime', detail=f'#define: \'{sector_name}\' is not a sector', line=node.get('line', 0))
        else:
            self._variables[target] = func
        self._defines = getattr(self, '_defines', {})
        self._defines[target] = func

    def _exec_sector(self, node):
        name = node['name']
        # Deferred init: ?label means don't construct yet — wait for #reserve[label]
        reserve_label = node.get('reserve_label')
        if reserve_label:
            if not hasattr(self, '_deferred_sectors'):
                self._deferred_sectors = {}
            self._deferred_sectors[reserve_label] = node
            return
        saved_vars = self._variables.copy()
        saved_types = self._variable_types.copy()
        saved_stack = {k: v for k, v in getattr(self, '_stack_vars', {}).items()}
        saved_heap = {k: v for k, v in getattr(self, '_heap_vars', {}).items()}
        saved_auto = {k: v for k, v in getattr(self, '_auto_vars', {}).items()}
        self._variables = {}
        self._variable_types = {}
        _saved_building_sector = getattr(self, '_building_sector', None)
        self._building_sector = name
        _saved_public_overrides = getattr(self, '_sector_public_overrides', set())
        self._sector_public_overrides = set()

        # Self-reference: live placeholder shares the body's _variables dict
        _self_placeholder = CsscSector(
            name, set(), set(),
            self._variables,  # SHARED reference
            None, self, {},
        )
        self._variables[name] = _self_placeholder
        saved_vars[name] = _self_placeholder

        # Inject generic parameters as private members from outer scope
        # Syntax: <outerVar, innerName> or <outerVar, *innerName> (zero-copy)
        import copy as _copy
        _dep_names = set()
        for p in (node.get('params') or []):
            inner_name = p['param_name']
            source_name = p.get('source_var', p.get('param_type', inner_name))
            is_ref = p.get('is_ref', False)
            # Record the injected alias for sector-isolation enforcement.
            # Module deps (e.g. `<ini>`) live in self._modules, not
            # saved_vars, so the value-injection below is a no-op for them —
            # but the NAME must still be an allowed namespace in the body.
            if inner_name:
                _dep_names.add(inner_name)
            if source_name in saved_vars:
                if is_ref:
                    self._variables[inner_name] = saved_vars[source_name]
                else:
                    try:
                        self._variables[inner_name] = _copy.deepcopy(saved_vars[source_name])
                    except Exception:
                        self._variables[inner_name] = saved_vars[source_name]
                self._variable_types[inner_name] = self._variable_types.get(source_name, 'auto')
                for sv, outer in (('_stack_vars', saved_stack), ('_heap_vars', saved_heap), ('_auto_vars', saved_auto)):
                    if source_name in outer:
                        store = getattr(self, sv, None)
                        if store is not None:
                            store[inner_name] = outer[source_name]
        for stmt in (node.get('private_body') or []):
            self._exec_node(stmt)
        private_names = set(self._variables.keys()) - {name}
        for stmt in (node.get('public_body') or []):
            self._exec_node(stmt)
        public_names = (set(self._variables.keys()) - private_names - {name}) | self._sector_public_overrides
        private_names -= self._sector_public_overrides
        self._building_sector = _saved_building_sector
        self._sector_public_overrides = _saved_public_overrides
        sector_vars = {k: v for k, v in self._variables.items() if k != name}
        sector_allocs = {}
        for sv in ('_stack_vars', '_heap_vars', '_auto_vars'):
            store = getattr(self, sv, None)
            if store:
                for vname in list(store.keys()):
                    if vname in sector_vars:
                        sector_allocs[vname] = (sv, store.pop(vname))
        self._variables = saved_vars
        self._variables.pop(name, None)
        self._variable_types = saved_types
        for sv, saved in (('_stack_vars', saved_stack), ('_heap_vars', saved_heap), ('_auto_vars', saved_auto)):
            store = getattr(self, sv, None)
            if store is not None:
                for k, v in saved.items():
                    if k not in store:
                        store[k] = v
        # Finalize placeholder in-place
        _self_placeholder._public = set(public_names)
        _self_placeholder._private = set(private_names)
        _self_placeholder._free_body = node.get('free_body')
        _self_placeholder._alloc_stores = sector_allocs
        _self_placeholder._deps = _dep_names
        _self_placeholder._vars.pop(name, None)
        sector = _self_placeholder
        self._variables[name] = sector
        self._modules[name] = sector
        if not hasattr(self, '_sectors'):
            self._sectors = []
        self._sectors.append(sector)

    def _exec_cdefine(self, node):
        target = node['target']
        params = node['params']
        body = node['body']
        def _callback(*call_args):
            old_vals = {}
            for i, pname in enumerate(params):
                old_vals[pname] = self._variables.get(pname)
                if i < len(call_args):
                    self._variables[pname] = call_args[i]
            if not hasattr(self, '_call_args_stack'):
                self._call_args_stack = []
            self._call_args_stack.append((target, list(call_args)))
            # v6 ref-by-default arg-meta frame in lock-step.
            metas = self._consume_pending_arg_metas(len(call_args))
            self._push_call_meta(target, metas)
            # `mirror value;` keeps the body running and live-links
            # the outer capture to the slot when `value` is a bare
            # identifier. `mirror &value;` is the explicit snapshot
            # form. See `_exec_define` for the full rationale.
            mirror_value = _UNSET = object()
            mirror_ref_source = None
            try:
                for stmt in body:
                    try:
                        self._exec_node(stmt)
                    except _MirrorSignal as _m:
                        if mirror_value is _UNSET:
                            mirror_value = _m.value
                            if _m.is_ref and _m.ref_source:
                                mirror_ref_source = _m.ref_source
                        # body keeps walking — cleanup runs
            except _ReturnSignal as r:
                mirror_value = r.value
                mirror_ref_source = None
            finally:
                if mirror_ref_source is not None:
                    if mirror_ref_source in self._variables:
                        mirror_value = self._variables[mirror_ref_source]
                    else:
                        mirror_value = 0    # 0x0 per spec
                if self._call_args_stack:
                    self._call_args_stack.pop()
                # v6 ref-by-default: pop the meta frame in lock-step.
                self._pop_call_meta()
                # Drop alias entries owned by this frame (matches the
                # cleanup in `_exec_define`).
                ref_links = getattr(self, '_ref_links', None)
                if ref_links:
                    for pname in params:
                        ref_links.pop(pname, None)
                for pname in params:
                    if old_vals[pname] is None:
                        self._variables.pop(pname, None)
                    else:
                        self._variables[pname] = old_vals[pname]
            if mirror_value is not _UNSET:
                return mirror_value
            return self._variables.get(target)
        alloc_bits = None
        for _sv in ('_stack_vars', '_heap_vars', '_auto_vars'):
            _store = getattr(self, _sv, None)
            if _store and target in _store:
                alloc_bits = _store[target].get('max_bits')
                break
        func = CsscFunction(_callback, name=target,
                            max_bits=alloc_bits, encode_fn=self._encode_value)
        func._body = body
        func._params = params
        self._variables[target] = func
        self._defines = getattr(self, '_defines', {})
        self._defines[target] = func

    def _exec_redefine(self, node):
        """#redefine(funcVar) +<pos> { code } — inject/overwrite function body.
        Mutates the body list in-place so the closure captures the changes."""
        target = node['target']
        new_body = node['body']
        insert_pos = node.get('insert_pos')
        func = self._variables.get(target)
        _ensure_method_imports()
        if CsscMethodBinding is not None and isinstance(func, CsscMethodBinding):
            func = func.get_value()
        if not isinstance(func, CsscFunction):
            raise CsscError(operation='Runtime',
                            detail=f'#redefine: "{target}" is not a function',
                            hint='#redefine can only modify #define/#cdefine functions',
                            line=node.get('line', 0))
        if func._body is None:
            raise CsscError(operation='Runtime',
                            detail=f'#redefine: "{target}" has no modifiable body',
                            line=node.get('line', 0))
        stmts = new_body if isinstance(new_body, list) else [new_body]
        if insert_pos is not None:
            pos = int(self._eval(insert_pos))
            pos = max(0, min(pos, len(func._body)))
            for i, s in enumerate(stmts):
                func._body.insert(pos + i, s)
        else:
            func._body.clear()
            func._body.extend(stmts)

    def _exec_gipeo_directive(self, node: dict, directive: str, var: str) -> None:
        """Twin of the first runtime's helper — see that one for full docs."""
        from .cssl_gipeo import (
            CsscPin, CsscI2C, CsscSPI, CsscUART, CsscADC, CsscPWM, CsscTimer
        )
        parts = node.get('arg_parts', [])

        def _resolve_int(s: str, default: int = 0) -> int:
            s = (s or '').strip()
            if not s:
                return default
            try:
                if s.startswith(('0x', '0X')):
                    return int(s, 16)
                return int(s)
            except ValueError:
                pass
            v = self._variables.get(s)
            if v is None and hasattr(self, '_parent_scopes'):
                for ps in reversed(self._parent_scopes):
                    if s in ps:
                        v = ps[s]
                        break
            try:
                return int(v) if v is not None else default
            except (TypeError, ValueError):
                return default

        if directive == 'pin':
            obj = CsscPin(_resolve_int(parts[0] if parts else '0'))
        elif directive == 'i2c':
            obj = CsscI2C(
                _resolve_int(parts[0] if len(parts) > 0 else '0'),
                _resolve_int(parts[1] if len(parts) > 1 else '0'),
                _resolve_int(parts[2] if len(parts) > 2 else '0'))
        elif directive == 'spi':
            obj = CsscSPI(
                _resolve_int(parts[0] if len(parts) > 0 else '0'),
                _resolve_int(parts[1] if len(parts) > 1 else '0'),
                _resolve_int(parts[2] if len(parts) > 2 else '0'),
                _resolve_int(parts[3] if len(parts) > 3 else '0'))
        elif directive == 'uart':
            obj = CsscUART(
                _resolve_int(parts[0] if len(parts) > 0 else '0'),
                _resolve_int(parts[1] if len(parts) > 1 else '1'),
                _resolve_int(parts[2] if len(parts) > 2 else '3'))
        elif directive == 'adc':
            obj = CsscADC(_resolve_int(parts[0] if parts else '0'))
        elif directive == 'pwm':
            obj = CsscPWM(
                _resolve_int(parts[0] if len(parts) > 0 else '0'),
                _resolve_int(parts[1] if len(parts) > 1 else '5000'),
                _resolve_int(parts[2] if len(parts) > 2 else '8'))
        elif directive == 'timer':
            obj = CsscTimer(
                _resolve_int(parts[0] if len(parts) > 0 else '0'),
                _resolve_int(parts[1] if len(parts) > 1 else '1000'))
        else:
            return
        self._variables[var] = obj
        self._variable_types[var] = directive

    def _exec_qvar(self, node):
        vtype = node['vtype']
        expr_str = node['expr_str']
        varname = node['var']
        if expr_str:
            lexer = CsscLexer(expr_str)
            tokens = lexer.tokenize()
            parser = CsscParser(tokens)
            expr = parser._parse_expression()
            val = self._eval(expr)
        else:
            val = None
        self._variables[varname] = self._coerce(val, vtype) if val is not None else None
        self._variable_types[varname] = vtype

    def _exec_http_directive(self, node: dict, directive: str, var: str) -> None:
        """`#get`, `#post`, `#send` desugar to network.http dispatch.

        - `#get[url] var;`              → http::get(url) → var
        - `#post[url] var = body;`      → http::post(url, body) → var
        - `#send[url] body;`            → http::post(url, body) (no capture)

        URLs in the bracket can be string literals (preserved verbatim)
        or identifiers that resolve to a string at runtime."""
        from .cssl_network_http import _build_request, _execute, _DEFAULT_TIMEOUT_S
        url_arg = (node.get('arg') or '').strip()
        # Strip surrounding quotes; otherwise treat as expression text
        # and resolve against scope.
        if (url_arg.startswith('"') and url_arg.endswith('"')) or \
           (url_arg.startswith("'") and url_arg.endswith("'")):
            url = url_arg[1:-1]
        elif url_arg in self._variables:
            url = str(self._variables[url_arg])
        else:
            url = url_arg
        if directive == 'get':
            req = _build_request('GET', url)
            result = _execute(req, _DEFAULT_TIMEOUT_S)
        else:
            # post / send — body is in node['value']
            body_node = node.get('value')
            body = self._eval(body_node) if body_node is not None else ''
            req = _build_request('POST', url, body=body)
            result = _execute(req, _DEFAULT_TIMEOUT_S)
        if var:
            self._variables[var] = result
            self._variable_types[var] = 'map'

    def _push_devdebug_stdout(self, msg: str) -> None:
        """Append `msg` to every loaded devdebug module's stdout list.
        See first-runtime twin for full doc."""
        try:
            from .cssl_devdebug import CsscDevDebugModule
        except Exception:
            return
        for mod in self._modules.values():
            if isinstance(mod, CsscDevDebugModule):
                try:
                    mod.stdout.append(msg)
                except Exception:
                    pass

    def _install_trace(self, target_name: str, line: int = 0):
        """Wrap the named function so each invocation prints args + result.
        Active only when `self._debug_enabled` is True. Idempotent."""
        import sys as _sys
        original = self._variables.get(target_name)
        if not callable(original):
            _sys.stderr.write(f'[trace] cannot trace "{target_name}": not callable\n')
            return
        if getattr(original, '_cssc_traced', False):
            return
        def _wrapper(*args, **kwargs):
            arg_repr = ', '.join(repr(a) for a in args)
            _sys.stderr.write(f'[trace] {target_name}({arg_repr})\n')
            _sys.stderr.flush()
            try:
                result = original(*args, **kwargs)
            except BaseException as e:
                _sys.stderr.write(f'[trace] {target_name}(...) raised {type(e).__name__}: {e}\n')
                raise
            _sys.stderr.write(f'[trace] {target_name}(...) → {result!r}\n')
            _sys.stderr.flush()
            return result
        _wrapper._cssc_traced = True
        self._variables[target_name] = _wrapper

    def _exec_catch_directive(self, node: dict):
        """`#catch (executable) ?caller { body }` — evaluate `executable` in
        a try/except. On failure, bind `caller` to '<ErrType>: <msg>' and
        run the body. Body is skipped on success.

        `executable` may be any CSSC expression: a bare function name
        (called with no args), a call expression (`fn(a, b)`,
        `obj.method(x)`, `i()`), or any other expression we want to guard."""
        expr_node = node.get('value')
        target = (node.get('arg') or '').strip()
        caller_name = node.get('caller') or node.get('var') or ''
        body = node.get('body') or []
        had_caller = caller_name in self._variables
        old_caller = self._variables.get(caller_name)
        try:
            if expr_node is not None:
                ntype = expr_node.get('type') if isinstance(expr_node, dict) else None
                if ntype in ('identifier', 'ident'):
                    name = expr_node.get('name') or target
                    callee = self._variables.get(name)
                    if callee is None:
                        callee = self._modules.get(name)
                    if callable(callee):
                        callee()
                    elif callee is None:
                        raise CsscError(operation='Runtime',
                                        detail=f'#catch: undefined target "{name}"',
                                        line=node.get('line', 0))
                else:
                    self._eval(expr_node)
            elif target:
                callee = self._variables.get(target) or self._modules.get(target)
                if callable(callee):
                    callee()
                elif callee is None:
                    raise CsscError(operation='Runtime',
                                    detail=f'#catch: undefined target "{target}"',
                                    line=node.get('line', 0))
        except _MirrorSignal:
            raise
        except _ReturnSignal:
            raise
        except _DestructSignal:
            raise
        except CsscError as e:
            err_str = f'{type(e).__name__}: {e.detail}' if hasattr(e, 'detail') else f'CsscError: {e}'
            if caller_name:
                self._variables[caller_name] = err_str
            for stmt in body:
                self._exec_node(stmt)
        except BaseException as e:
            err_str = f'{type(e).__name__}: {e}'
            if caller_name:
                self._variables[caller_name] = err_str
            for stmt in body:
                self._exec_node(stmt)
        finally:
            if caller_name:
                if had_caller:
                    self._variables[caller_name] = old_caller
                else:
                    self._variables.pop(caller_name, None)

    def _exec_scanp(self, node):
        """Bind a positional call-arg to a local slot under v6
        ref-by-default semantics (spec §2.5).

        The CALLER decides ref vs. copy at the call site:
          * `f(x)`  → ref (param aliases caller's slot). `#delete[param]`
                       in the body deletes the caller's slot too via
                       `_delete_cross_frame`.
          * `f(&x)` → copy (param is an independent snapshot).
          * literal / expression arg → ref-by-value (no alias to
                       record; `#delete[param]` only kills the local).

        The callee's `&varname` in `#scanp(...) &varname;` is a HINT
        for the LSP (`DELETE_OF_COPY_PARAM_VIA_REF_CALL` lint), not a
        runtime override. The LSP migration lint
        `REF_BY_DEFAULT_BEHAVIOR_CHANGE` warns when the call-site /
        callee intents disagree.

        Missing positional arg → silent null (classic nullptr
        semantics; users branch on `if (x == null)`).
        """
        source = node['source']
        vtype = node['vtype']
        pos = int(node['pos'])
        varname = node['var']
        # Legacy `*type` (asterisk on the TYPE) — strip and treat as ref.
        if vtype.startswith('*'):
            vtype = vtype[1:]
        call_args = ()
        if hasattr(self, '_call_args_stack'):
            for target_name, args in reversed(self._call_args_stack):
                if target_name == source:
                    call_args = args
                    break
        val = call_args[pos] if pos < len(call_args) else None
        # Default-value fallback for `#scanp(...) v = expr;`.
        if val is None and node.get('default') is not None:
            val = self._eval(node['default'])
            self._variables[varname] = val
            self._variable_types[varname] = vtype
            return
        # Missing arg → silent null (classic nullptr semantics).
        if val is None:
            self._variables[varname] = None
            self._variable_types[varname] = vtype
            return
        # ── v6 ownership decision ──────────────────────────────────
        # Caller's syntax (via _lookup_arg_meta) is the source of
        # truth. Callee's `&varname` is intentionally IGNORED here
        # so the lint's claim (`DELETE_OF_COPY_PARAM_VIA_REF_CALL`)
        # holds — caller decides.
        meta = self._lookup_arg_meta(source, pos) or {
            'kind': 'ref', 'src_name': None}
        kind = meta.get('kind', 'ref')
        src_name = meta.get('src_name')
        if kind == 'copy':
            # `f(&x)` — caller explicitly requested copy. The value
            # we got was already deep-copied by `_eval(copy_of)`, but
            # do an extra defensive deepcopy in case the AST shape
            # was non-standard.
            try:
                val = __import__('copy').deepcopy(val)
            except Exception:
                pass
            if vtype != 'auto':
                val = self._coerce(val, vtype)
            self._variables[varname] = val
            self._variable_types[varname] = vtype
            return
        # ── Ref-pass: register alias if the caller passed a bare slot ──
        # `_delete_cross_frame` reads `_ref_links[varname]` to find
        # the source slot in the parent scope and delete it too.
        if isinstance(val, CsscPointer):
            resolved = self._resolve_value(val)
            if resolved is None:
                raise CsscError(operation='Runtime',
                                detail=f'Reference *{val.name} points to a deleted or undefined variable',
                                hint=f'Ensure "{val.name}" is not #delete\'d before passing it by reference',
                                line=node.get('line', 0))
            self._variables[varname] = resolved
            self._variable_types[varname] = vtype
            if not hasattr(self, '_ref_links'):
                self._ref_links = {}
            self._ref_links[varname] = val.name
            return
        if vtype != 'auto':
            val = self._coerce(val, vtype)
        self._variables[varname] = val
        self._variable_types[varname] = vtype
        # Register the alias so `#delete[varname]` cascades into the
        # caller's slot. Only when the caller passed a bare slot
        # name; literals / expression results have no source.
        if src_name:
            if not hasattr(self, '_ref_links'):
                self._ref_links = {}
            self._ref_links[varname] = src_name

    def _exec_if(self, node):
        if self._is_truthy(self._eval(node['condition'])):
            for stmt in node['then']:
                self._exec_node(stmt)
        elif node.get('else'):
            for stmt in node['else']:
                self._exec_node(stmt)

    def _exec_for(self, node):
        # v5 auto-cleanup of the for-declared iter var. Same logic as
        # the primary runtime's _exec_for: snapshot the target if `init`
        # declared it fresh (for_decl=True), and pop it in `finally`.
        iter_var = None
        init_node = node.get('init')
        if isinstance(init_node, dict) and init_node.get('for_decl'):
            iter_var = init_node.get('target')
        try:
            if init_node:
                self._exec_node(init_node)
            while self._running:
                if node.get('condition') and not self._is_truthy(self._eval(node['condition'])):
                    break
                try:
                    for stmt in node['body']:
                        self._exec_node(stmt)
                except _BreakSignal:
                    break
                except _ContinueSignal:
                    pass
                except _JumpSignal as js:
                    if js.target is not None:
                        if isinstance(js.target, CsscFunction):
                            js.target()
                        elif callable(js.target):
                            js.target()
                if node.get('step'):
                    self._exec_node(node['step'])
        finally:
            if iter_var:
                self._variables.pop(iter_var, None)
                if hasattr(self, '_variable_types'):
                    self._variable_types.pop(iter_var, None)

    def _exec_while(self, node):
        while self._running:
            if not self._is_truthy(self._eval(node['condition'])):
                break
            try:
                for stmt in node['body']:
                    self._exec_node(stmt)
            except _BreakSignal:
                break
            except _ContinueSignal:
                pass
            except _JumpSignal as js:
                if js.target is not None:
                    if isinstance(js.target, CsscFunction):
                        js.target()
                    elif callable(js.target):
                        js.target()

    def _exec_hex_scope(self, node):
        """`0xAEFF { body }` — persistent hex-keyed scope."""
        hex_id = int(node.get('hex_id', 0))
        if not hasattr(self, '_hex_scopes'):
            self._hex_scopes = {}
        outer_vars = self._variables
        outer_types = self._variable_types
        outer_stack = getattr(self, '_stack_vars', None)
        if not hasattr(self, '_parent_scopes'):
            self._parent_scopes = []
        self._parent_scopes.append(outer_vars)
        self._variables = {}
        self._variable_types = {}
        if outer_stack is not None:
            self._stack_vars = {}
        funcs = {}
        try:
            for stmt in node.get('body', []):
                if isinstance(stmt, dict) and stmt.get('type') == 'define':
                    funcs[stmt.get('target', '')] = stmt
                else:
                    self._exec_node(stmt)
            self._hex_scopes[hex_id] = {
                'vars': dict(self._variables),
                'types': dict(self._variable_types),
                'stack': dict(self._stack_vars) if outer_stack is not None else {},
                'funcs': funcs,
                'freed': False,
            }
        finally:
            if self._parent_scopes and self._parent_scopes[-1] is outer_vars:
                self._parent_scopes.pop()
            self._variables = outer_vars
            self._variable_types = outer_types
            if outer_stack is not None:
                self._stack_vars = outer_stack

    def _exec_raii_invoke(self, node):
        """`#raii 0xAEFF method(args);` — dispatch method in hex scope."""
        hex_id = node.get('target_hex')
        if hex_id is None:
            raise CsscError(operation='Runtime',
                            detail='#raii requires a hex target (0xNN)',
                            line=node.get('line', 0))
        scopes = getattr(self, '_hex_scopes', {}) or {}
        scope = scopes.get(hex_id)
        if scope is None or scope.get('freed'):
            raise CsscError(operation='Runtime',
                            detail=f'#raii: hex scope {hex(hex_id)} not found or freed',
                            line=node.get('line', 0))
        method_name = node.get('method', '')
        method_node = scope['funcs'].get(method_name)
        if method_node is None:
            raise CsscError(operation='Runtime',
                            detail=f'#raii: method "{method_name}" not defined in {hex(hex_id)}',
                            line=node.get('line', 0))
        _ = [self._eval(a) for a in node.get('args', [])]
        outer_vars = self._variables
        outer_types = self._variable_types
        outer_stack = getattr(self, '_stack_vars', None)
        if not hasattr(self, '_parent_scopes'):
            self._parent_scopes = []
        self._parent_scopes.append(outer_vars)
        self._variables = scope['vars']
        self._variable_types = scope['types']
        if outer_stack is not None:
            self._stack_vars = scope.get('stack', {})
        try:
            for stmt in method_node.get('body', []) or []:
                self._exec_node(stmt)
        except _ReturnSignal:
            pass
        finally:
            scope['vars'] = self._variables
            scope['types'] = self._variable_types
            if outer_stack is not None:
                scope['stack'] = self._stack_vars
                self._stack_vars = outer_stack
            if self._parent_scopes and self._parent_scopes[-1] is outer_vars:
                self._parent_scopes.pop()
            self._variables = outer_vars
            self._variable_types = outer_types

    def _exec_private_scope(self, node):
        """Bare `{ ... }` at statement level — isolated variable frame."""
        body = node.get('body', [])
        outer_vars = self._variables
        outer_types = self._variable_types
        outer_stack = getattr(self, '_stack_vars', None)
        outer_heap = getattr(self, '_heap_vars', None)
        outer_auto = getattr(self, '_auto_vars', None)
        if not hasattr(self, '_parent_scopes'):
            self._parent_scopes = []
        self._parent_scopes.append(outer_vars)
        self._variables = {}
        self._variable_types = {}
        if outer_stack is not None:
            self._stack_vars = {}
        if outer_heap is not None:
            self._heap_vars = {}
        if outer_auto is not None:
            self._auto_vars = {}
        try:
            for stmt in body:
                self._exec_node(stmt)
        finally:
            if self._parent_scopes and self._parent_scopes[-1] is outer_vars:
                self._parent_scopes.pop()
            self._variables = outer_vars
            self._variable_types = outer_types
            if outer_stack is not None:
                self._stack_vars = outer_stack
            if outer_heap is not None:
                self._heap_vars = outer_heap
            if outer_auto is not None:
                self._auto_vars = outer_auto

    def _exec_select(self, node):
        """select (iterable) ?label { body } — cursor-based iteration."""
        iterable = self._eval(node['iterable'])
        if iterable is None:
            return
        if isinstance(iterable, dict):
            items = list(iterable.values())
        elif isinstance(iterable, str):
            items = list(iterable)
        elif isinstance(iterable, (list, tuple)):
            items = list(iterable)
        else:
            try:
                items = list(iterable)
            except TypeError:
                return
        label = node['label']
        body = node['body']
        cursor = 0
        had_old = label in self._variables
        old_val = self._variables.get(label)
        if not hasattr(self, '_select_cursors'):
            self._select_cursors = {}
        had_old_cursor = label in self._select_cursors
        old_cursor = self._select_cursors.get(label)
        _max_iter = max(len(items) * 1000, 100000)
        _count = 0
        try:
            while 0 <= cursor < len(items):
                _count += 1
                if _count > _max_iter:
                    raise CsscError(
                        operation='Runtime',
                        detail=f'select: iteration limit exceeded ({_max_iter}). Likely infinite jump loop.',
                        line=node.get('line', 0),
                    )
                self._variables[label] = items[cursor]
                self._select_cursors[label] = cursor
                jumped = False
                try:
                    for stmt in body:
                        self._exec_node(stmt)
                except _SelectJumpSignal as sj:
                    cursor += sj.delta
                    jumped = True
                except _BreakSignal:
                    break
                except _ContinueSignal:
                    cursor += 1
                    jumped = True
                if not jumped:
                    break
        finally:
            if had_old:
                self._variables[label] = old_val
            else:
                self._variables.pop(label, None)
            if had_old_cursor:
                self._select_cursors[label] = old_cursor
            else:
                self._select_cursors.pop(label, None)

    # -- Expression evaluation ----------------------------------------------
    def _eval_arg(self, a):
        """Twin of the first runtime's helper. Ownership model (docs §2.5):
        all argument passes are references by default. `&x` (copy_of AST)
        is the explicit deep-copy. `*x` is a legacy no-op alias."""
        if isinstance(a, dict) and a.get('type') == 'copy_of':
            return self._eval(a)
        if isinstance(a, dict) and a.get('type') == 'unary' and a.get('op') == '*':
            return self._eval(a)
        return self._eval(a)

    # ── v6 ref-by-default arg-metadata pipeline ─────────────────────
    # MIRROR of the primary CsscRuntime helpers. Keep both copies in
    # sync — duck-typing via hasattr is *not* enough since the two
    # CsscRuntime classes are independent (the second class shadows
    # the first by name but doesn't inherit from it). Each call-site
    # evaluator stashes per-arg meta via `_stash_pending_arg_metas`
    # right before invoking the callable. The matching callback (in
    # `_exec_define` / `_exec_cdefine` / label call) pushes the meta
    # frame onto `_call_args_meta_stack` in lock-step with
    # `_call_args_stack`. `_exec_scanp` reads the meta to decide ref
    # vs. copy from the CALL SITE (spec §2.5), not the callee's `&`.

    def _compute_arg_meta(self, a):
        """Inspect a call-arg AST node and return its
        (kind, src_name) metadata."""
        if not isinstance(a, dict):
            return {'kind': 'ref', 'src_name': None}
        t = a.get('type')
        if t == 'copy_of':
            return {'kind': 'copy', 'src_name': None}
        if t == 'identifier':
            nm = (a.get('name') or '').strip()
            return {'kind': 'ref', 'src_name': nm or None}
        if t == 'unary' and a.get('op') == '*':
            op = a.get('operand') or {}
            if isinstance(op, dict) and op.get('type') == 'identifier':
                nm = (op.get('name') or '').strip()
                return {'kind': 'ref', 'src_name': nm or None}
            return {'kind': 'ref', 'src_name': None}
        return {'kind': 'ref', 'src_name': None}

    def _stash_pending_arg_metas(self, ast_args):
        """Set the meta queue for the next callable invocation."""
        self._pending_arg_metas = [self._compute_arg_meta(a)
                                     for a in ast_args]

    def _consume_pending_arg_metas(self, n_args):
        """Return + clear the pending meta queue, padded/truncated to
        `n_args` so positional lookups in `_exec_scanp` are safe."""
        metas = getattr(self, '_pending_arg_metas', None)
        self._pending_arg_metas = None
        if metas is None:
            return [{'kind': 'ref', 'src_name': None}
                     for _ in range(n_args)]
        if len(metas) < n_args:
            metas = list(metas) + [{'kind': 'ref', 'src_name': None}
                                    for _ in range(n_args - len(metas))]
        elif len(metas) > n_args:
            metas = metas[:n_args]
        return metas

    def _push_call_meta(self, target, metas):
        """Push a meta frame in lock-step with `_call_args_stack`."""
        if not hasattr(self, '_call_args_meta_stack'):
            self._call_args_meta_stack = []
        self._call_args_meta_stack.append((target, metas))

    def _pop_call_meta(self):
        """Pop the matching meta frame; tolerant of underflow."""
        meta_stack = getattr(self, '_call_args_meta_stack', None)
        if meta_stack:
            meta_stack.pop()

    def _lookup_arg_meta(self, source, pos):
        """Find the meta for `source(...)`'s positional arg `pos`."""
        meta_stack = getattr(self, '_call_args_meta_stack', None)
        if not meta_stack:
            return None
        for tgt, metas in reversed(meta_stack):
            if tgt == source:
                if 0 <= pos < len(metas):
                    return metas[pos]
                return None
        return None

    def _delete_cross_frame(self, name, _depth=0):
        """`#delete[name]` cross-frame propagation through the
        ref-link CHAIN.

        If `name` is a ref-aliased param (registered by `_exec_scanp`
        via `_ref_links[name] = src_name`), this deletes the source
        slot from every parent frame it appears in AND recurses on
        `src` itself when `src` is also a ref-link — that's the
        N-level cascade case:

            i(y)                  // y in caller
              outer_fn(q)         // q is ref-aliased to y
                inner_fn(p)       // p is ref-aliased to q
                  #delete[p];     // → pop q (alias-to-y) AND pop y

        Recursion depth is capped at 16 frames so a pathological
        cycle in `_ref_links` (shouldn't happen in well-formed AST
        but defensive) doesn't blow the Python recursion limit.

        Returns True iff *any* parent-side delete happened.
        """
        if _depth > 16:
            return False
        ref_links = getattr(self, '_ref_links', None)
        if not ref_links or name not in ref_links:
            return False
        src = ref_links.get(name)
        if not src:
            return False
        if isinstance(src, str) and '->' in src:
            return False  # sector ref-link path (handled elsewhere)
        deleted = False
        # First: recursively walk the alias chain. If `src` itself is
        # an alias, we must delete its target FIRST — otherwise the
        # ref_links entry for `src` would survive the pop below and
        # later resolve to a stale name.
        chain_deleted = self._delete_cross_frame(src, _depth + 1)
        if chain_deleted:
            deleted = True
        # Now drop `src` from every parent frame it appears in.
        parent_scopes = getattr(self, '_parent_scopes', None) or []
        for ps in reversed(parent_scopes):
            if isinstance(ps, dict) and src in ps:
                ps.pop(src, None)
                deleted = True
        for store_attr in ('_stack_vars', '_heap_vars', '_auto_vars'):
            store = getattr(self, store_attr, None)
            if isinstance(store, dict) and src in store:
                store.pop(src, None)
                deleted = True
        ref_links.pop(name, None)
        return deleted

    # `_copy_for_pass_by_value` removed in v5 — see the matching note
    # on the primary CsscRuntime. Explicit copies now go through the
    # `copy_of` AST node (`&expr`) which deep-copies in _eval.

    def _eval(self, node):
        if node is None:
            return None
        ntype = node.get('type')
        if ntype == 'literal':
            if node.get('is_hex'):
                hv = getattr(self, '_hex_vars', None)
                if hv is not None:
                    entry = hv.get(node['value'])
                    if entry is not None:
                        return entry['value']
            return node['value']
        if ntype == 'string': return node['value']
        if ntype == 'null': return None
        if ntype == 'array': return [self._eval(e) for e in node['elements']]
        if ntype == 'map_literal': return {k: self._eval(v) for k, v in node['pairs']}
        if ntype == 'array_literal': return [self._eval(e) for e in node['items']]
        if ntype == 'bind_literal':
            # Preserve the source literal's pair width so chained
            # `bind[row][col]` reads return the right cell. Each pair
            # in `node['pairs']` is a list of cell expression nodes —
            # length per pair is the structural width (uneven widths
            # are caught at CIR lowering time; here we mirror what the
            # native runtime stores).
            raw_pairs = node['pairs'] or []
            evaluated = [tuple(self._eval(c) for c in pair)
                          for pair in raw_pairs]
            pair_width = len(evaluated[0]) if evaluated else 0
            return CsscBind(evaluated, pair_width=pair_width)
        if ntype == 'identifier':
            name = node['name']
            # C++ fast path: scalar types stored natively in C++ scope
            if self._accel and self._cpp_scope.has(name):
                t = self._cpp_scope.get_type(name)
                if t == 1: return self._cpp_scope.get_int(name, True)
                if t == 2: return self._cpp_scope.get_float(name, True)
                if t == 3: return self._cpp_scope.get_str(name, True)
                if t == 4: return self._cpp_scope.get_bool(name, True)
            return self._variables.get(name)
        if ntype == 'introspect':
            _ensure_method_imports()
            alias = node['alias']
            binding = self._variables.get(alias)
            if CsscMethodBinding is not None and isinstance(binding, CsscMethodBinding):
                return binding._introspector.resolve(node['prop_path'])
            return None
        if ntype == 'load_expr':
            # #load["path"] as expression — returns CsscLoadedModule
            load_path = node.get('load_path', '')
            resolved = self._resolve_path(load_path)
            if not os.path.isfile(resolved):
                raise CsscError(operation='Runtime', detail=f'#load: file not found: {load_path}', line=node.get('line', 0))
            with open(resolved, 'r', encoding='utf-8') as f:
                code = f.read()
            sub_lexer = CsscLexer(code, filename=resolved)
            sub_tokens = sub_lexer.tokenize()
            sub_parser = CsscParser(sub_tokens)
            sub_ast = sub_parser.parse()
            child_rt = CsscRuntime(script_dir=os.path.dirname(os.path.abspath(resolved)))
            child_rt._script_args = getattr(self, '_script_args', None)
            return CsscLoadedModule('_loaded', resolved, child_rt, sub_ast)
        if ntype == 'copy_of':
            import copy as _copy
            return _copy.deepcopy(self._eval(node['operand']))
        if ntype == 'binary': return self._eval_binary(node)
        if ntype == 'logical': return self._eval_logical(node)
        if ntype == 'unary': return self._eval_unary(node)
        if ntype == 'postfix': return self._eval_postfix(node)
        if ntype == 'call': return self._eval_call(node)
        if ntype == 'ns_call': return self._eval_ns_call(node)
        if ntype == 'member_ns_call':
            # Object->member::func(args) — resolve member as module, call func
            mod = self._eval(node['object'])
            func_name = node['func']
            args = [self._eval(a) for a in node['args']]
            if mod is not None and hasattr(mod, 'get_namespace'):
                funcs = mod.get_namespace()
                if func_name in funcs:
                    return funcs[func_name](*args)
            if mod is not None:
                method = getattr(mod, func_name, None)
                if callable(method):
                    return method(*args)
            return None
        if ntype == 'ns_access': return self._eval_ns_access(node)
        if ntype in ('method_call', 'dot_call'): return self._eval_method_call(node)
        if ntype == 'arrow_access': return self._eval_arrow(node)
        if ntype == 'dot_access': return self._eval_dot(node)
        if ntype == 'index':
            # Detect the chained `i[row][col]` pattern BEFORE evaluating
            # the inner expression. If the receiver is itself an `index`
            # node whose own receiver is a CsscBind (or bind-shaped
            # list of uniform tuples), we want structured pair access,
            # not flat-then-index-into-cell. Mirrors the CIR lowering's
            # `cssc_bind_entry_pair_cell_{val,int}` dispatch so `cssc
            # run` and `cssc build` agree on what `i[1][0]` returns.
            inner_node = node.get('object') or {}
            if isinstance(inner_node, dict) and inner_node.get('type') == 'index':
                inner_recv = self._eval(inner_node.get('object'))
                row = self._eval(inner_node.get('index'))
                col = self._eval(node.get('index'))
                if (isinstance(inner_recv, CsscBind)
                        and isinstance(row, int)
                        and isinstance(col, int)):
                    pw = inner_recv.pair_width
                    if pw > 0:
                        n_cells = list.__len__(inner_recv) * pw
                        flat = row * pw + col
                        if 0 <= flat < n_cells:
                            pair_idx, cell = divmod(flat, pw)
                            val = list.__getitem__(inner_recv,
                                                     pair_idx)[cell]
                            if isinstance(val, CsscPointer):
                                return self._resolve_value(val)
                            return val
                        return None
                    # pair_width == 0 (flat bind): degrade to row-only.
                    if 0 <= row < list.__len__(inner_recv):
                        val = list.__getitem__(inner_recv, row)
                        if isinstance(val, CsscPointer):
                            return self._resolve_value(val)
                        return val
                    return None
                # bind-shaped list (list of uniform tuples): same idea.
                if (isinstance(inner_recv, list) and inner_recv
                        and all(isinstance(p, tuple) for p in inner_recv)
                        and len({len(p) for p in inner_recv}) == 1
                        and isinstance(row, int) and isinstance(col, int)):
                    pw = len(inner_recv[0])
                    if 0 <= row < len(inner_recv) and 0 <= col < pw:
                        val = inner_recv[row][col]
                        if isinstance(val, CsscPointer):
                            return self._resolve_value(val)
                        return val
                    return None
                # Fall through: not a bind chained access. Evaluate
                # the inner-then-outer in the normal way below by
                # treating `inner_recv` as if we had eval'd
                # `node['object']` directly.
                obj = inner_recv
                if isinstance(obj, str) and isinstance(row, int):
                    # `str[row][col]` is not a thing, but the inner
                    # `str[row]` evaluates to a 1-char string; we
                    # handle it via the normal string-index path.
                    obj = obj[row] if 0 <= row < len(obj) else ''
                # Now the outer index applies to `obj` with the user's
                # outer `col`. Fall through into the canonical path
                # by treating col as the new idx.
                idx = col
            else:
                obj = self._eval(node['object'])
                idx = self._eval(node['index'])
            # String index: str[i] → single character
            if isinstance(obj, str):
                idx = int(idx)
                if 0 <= idx < len(obj):
                    return obj[idx]
                return ''
            # CsscBind / bind-entry-shaped list: flat-cell indexing.
            # `bind = {k, v}` → 1 pair, 2 cells. `bind[0] = k`,
            # `bind[1] = v`. The push_back path stores the bind into
            # array<bind> as a plain Python list, so we detect that
            # shape too via "all 2-tuples".
            if isinstance(obj, CsscBind) and isinstance(idx, int):
                cell_count = obj._cell_count()
                val = obj[idx] if 0 <= idx < cell_count else None
                if isinstance(val, CsscPointer):
                    return self._resolve_value(val)
                return val
            if (isinstance(obj, list) and isinstance(idx, int) and obj
                    and all(isinstance(p, tuple) and len(p) == 2 for p in obj)):
                cell_count = len(obj) * 2
                if 0 <= idx < cell_count:
                    pair_idx, cell = divmod(idx, 2)
                    val = obj[pair_idx][cell]
                else:
                    val = None
                if isinstance(val, CsscPointer):
                    return self._resolve_value(val)
                return val
            if isinstance(obj, list) and isinstance(idx, int):
                val = obj[idx] if 0 <= idx < len(obj) else None
                if isinstance(val, CsscPointer):
                    return self._resolve_value(val)
                return val
            if isinstance(obj, dict):
                if idx in obj:
                    val = obj[idx]
                    if isinstance(val, CsscPointer):
                        return self._resolve_value(val)
                    return val
                str_idx = str(idx) if not isinstance(idx, str) else idx
                val = obj.get(str_idx)
                if isinstance(val, CsscPointer):
                    return self._resolve_value(val)
                return val
            if hasattr(obj, '__getitem__'):
                try:
                    val = obj[idx]
                    if isinstance(val, CsscPointer):
                        return self._resolve_value(val)
                    return val
                except (KeyError, IndexError, TypeError):
                    return None
            return None
        return None

    _BINOP_MAP = {'+': 0, '-': 1, '*': 2, '/': 3, '%': 4, '**': 5, '//': 6,
                  '==': 10, '!=': 11, '<': 12, '>': 13, '<=': 14, '>=': 15}

    def _eval_binary(self, node):
        left = self._eval(node['left'])
        right = self._eval(node['right'])
        op = node['op']
        # Unwrap method bindings to their raw values for arithmetic
        _ensure_method_imports()
        if CsscMethodBinding is not None:
            if isinstance(left, CsscMethodBinding):
                left = left.get_value()
            if isinstance(right, CsscMethodBinding):
                right = right.get_value()
        # A variable IS a function: in a VALUE context a callable slot
        # decays to its value cell `[0]` (f[0] = last-return / pre-#define
        # value), never the whole `{value, address}` object. This keeps
        # `fvar + 2.0`, `0 + var`, comparisons etc. operating on the value
        # regardless of whether the slot has been `#define`d, and stops the
        # raw address / object-repr from leaking into arithmetic.
        if isinstance(left, CsscFunction): left = left._last_return
        if isinstance(right, CsscFunction): right = right._last_return
        # Null-pointer equality: `i == 0x0` after `#delmember[arr[i]]`
        # wipes the entry to None. CSSC treats 0x0 / 0 as null, so
        # `None == 0` and `None == 0x0` should match. Symmetric for
        # `!=` (returns False when None matches null literal).
        if op in ('==', '!=') and (
                (left is None and right == 0)
                or (right is None and left == 0)):
            return (op == '==')
        # C++ fast path for numeric binary ops
        if self._accel and isinstance(left, (int, float)) and isinstance(right, (int, float)):
            code = self._BINOP_MAP.get(op)
            if code is not None:
                if code >= 10:  # comparison ops
                    return _cssc_accel_mod.compare_num(float(left), float(right), code - 10)
                elif isinstance(left, int) and isinstance(right, int) and not isinstance(left, bool) and not isinstance(right, bool) and code != 3:
                    return _cssc_accel_mod.binary_op_int(left, right, code)
                else:
                    return _cssc_accel_mod.binary_op_num(float(left), float(right), code)
        if op == '+':
            if isinstance(left, str) or isinstance(right, str):
                l = self._format_value(left)
                r = self._format_value(right)
                return l + r
            if isinstance(left, list) and isinstance(right, list): return left + right
            if isinstance(left, (int, float)) and isinstance(right, (int, float)): return left + right
            return self._format_value(left) + self._format_value(right)
        if op == '-' and isinstance(left, (int, float)) and isinstance(right, (int, float)): return left - right
        if op == '*':
            if isinstance(left, str) and isinstance(right, int): return left * right
            if isinstance(left, (int, float)) and isinstance(right, (int, float)): return left * right
            return 0
        if op == '/' and isinstance(right, (int, float)) and right != 0: return left / right
        if op == '%' and isinstance(right, (int, float)) and right != 0: return left % right
        if op == '==': return left == right
        if op == '!=': return left != right
        if op == '<': return left < right if left is not None and right is not None else False
        if op == '>': return left > right if left is not None and right is not None else False
        if op == '<=': return left <= right if left is not None and right is not None else False
        if op == '>=': return left >= right if left is not None and right is not None else False
        return None

    def _eval_logical(self, node):
        if node['op'] == '&&':
            left = self._eval(node['left'])
            return self._eval(node['right']) if self._is_truthy(left) else left
        if node['op'] == '||':
            left = self._eval(node['left'])
            return left if self._is_truthy(left) else self._eval(node['right'])
        return None

    def _eval_unary(self, node):
        if node['op'] == '*':
            operand = node['operand']
            if operand.get('type') in ('identifier', 'ident'):
                name = operand['name']
                val = self._variables.get(name)
                if val is None and hasattr(self, '_parent_scopes'):
                    for ps in reversed(self._parent_scopes):
                        if name in ps:
                            val = ps[name]
                            break
                if isinstance(val, CsscIterator):
                    return val.deref()
                # Function/object/sector references: return the value
                # directly so push_back(*cb) → iterate → `n()` finds an
                # actual callable, not a name-based pointer that dangles
                # the moment the holding label/scope returns.
                if isinstance(val, (CsscFunction, CsscObject, CsscSector)):
                    return val
                return CsscPointer(name)
            # *var[index] — indexed pointer (live reference to var[index])
            if operand.get('type') == 'index':
                obj_node = operand.get('object', {})
                if obj_node.get('type') in ('identifier', 'ident'):
                    idx = self._eval(operand.get('index'))
                    return CsscPointer(obj_node['name'], index=idx)
            return self._eval(operand)
        val = self._eval(node['operand'])
        if node['op'] == '-': return -val if isinstance(val, (int, float)) else val
        if node['op'] == '!': return not self._is_truthy(val)
        return val

    def _eval_postfix(self, node):
        name = node['operand']['name']
        old_val = self._variables.get(name, 0)
        if isinstance(old_val, CsscIterator):
            if node['op'] == '++': old_val._index += 1
            elif node['op'] == '--': old_val._index -= 1
            return old_val
        if node['op'] == '++': self._variables[name] = old_val + 1
        elif node['op'] == '--': self._variables[name] = old_val - 1
        return old_val

    def _eval_call(self, node):
        name = node['name']
        ast_args = node['args']
        args = [self._eval_arg(a) for a in ast_args]
        # v6 ref-by-default — stash per-arg meta for the callee's
        # `#scanp` so it decides ref/copy from the CALL SITE syntax
        # (spec §2.5). The matching `_compute_arg_meta` /
        # `_lookup_arg_meta` / `_delete_cross_frame` helpers live on
        # this same class; see the helper block right after
        # `_eval_arg`.
        self._stash_pending_arg_metas(ast_args)
        # Trigger 'passed' on method-bound args, then unwrap
        _ensure_method_imports()
        for i, a in enumerate(args):
            if CsscMethodBinding is not None and isinstance(a, CsscMethodBinding):
                a.trigger_do('passed', None)
                args[i] = a.get_value()
        if name in self._ns_builtins:
            func = self._ns_builtins[name]
            try: return func(*args)
            except TypeError:
                import inspect
                try:
                    sig = inspect.signature(func)
                    n = len([p for p in sig.parameters.values() if p.default is inspect.Parameter.empty])
                    return func(*args[:n])
                except Exception:
                    return func(*args[:1]) if args else func()
        var = self._variables.get(name)
        # Resolve pointer-by-reference: push_back(*cb) earlier may have
        # stored a CsscPointer, then iteration sets `n` to it; calling
        # `n()` needs the live resolution. Without this, function arrays
        # built via `*` refs all read back as "Unknown function".
        if isinstance(var, CsscPointer):
            var = self._resolve_value(var)
        # Unwrap method binding for call
        _ensure_method_imports()
        if CsscMethodBinding is not None and isinstance(var, CsscMethodBinding):
            var = var.get_value()
        if isinstance(var, CsscObject):
            # Object(args) — execute top-level code, pass constructor params
            return var.execute(*args)
        if callable(var):
            return var(*args)
        # Check parent scopes
        if hasattr(self, '_parent_scopes'):
            for ps in reversed(self._parent_scopes):
                if name in ps:
                    pvar = ps[name]
                    if isinstance(pvar, CsscPointer):
                        pvar = self._resolve_value(pvar)
                    if CsscMethodBinding is not None and isinstance(pvar, CsscMethodBinding):
                        pvar = pvar.get_value()
                    if isinstance(pvar, CsscObject):
                        return pvar.execute(*args)
                    if callable(pvar):
                        return pvar(*args)
        raise CsscError(operation='Runtime', detail=f'Unknown function: {name}', line=node.get('line', 0))

    def _check_sector_isolation(self, ns, func, line):
        """Enforce CSSC sector isolation identically to the native compiler:
        inside a sector method body a ns-call may only reach `cssc::`, the
        sector itself, one of its own members, or a `<dep>` injected in the
        sector header. Anything else is a hard error with the SAME wording
        the compiler emits (`cir_lower._sector_isolation_error_text`). No-op
        outside a sector method body."""
        stack = getattr(self, '_owning_sector_stack', None)
        if not stack:
            return
        sec = stack[-1]
        if sec is None:
            return
        owning = sec._name
        if ns == 'cssc' or ns == owning:
            return
        if ns in getattr(sec, '_deps', ()):
            return
        if ns in sec._public or ns in sec._private:
            return
        detail = (f"sector {owning} may not call {ns}::{func}: {ns} is neither "
                  f"cssc, a member of {owning}, nor an injected <dep>")
        hint = (f"inject it: `sector {owning}<{ns}> {{ ... }}` "
                f"(sectors are isolated scopes — external modules must be "
                f"declared as dependencies)")
        raise CsscError(operation='Sector-Isolation', detail=detail,
                        hint=hint, line=(line or 0))

    def _eval_ns_call(self, node):
        ns = node['namespace']
        func_name = node['func']
        # Sector isolation — before arg eval / resolution, same as native.
        self._check_sector_isolation(ns, func_name, node.get('line', 0))
        ast_args = node['args']
        args = [self._eval_arg(a) for a in ast_args]
        # v6 ref-by-default arg-meta stash (spec §2.5). Builtins
        # ignore the stash; user `#define`/object-method paths read
        # it via `_lookup_arg_meta` inside their `#scanp` lowering.
        self._stash_pending_arg_metas(ast_args)
        if ns == 'cssc':
            if func_name in _CCOS_FREESTANDING_INTRINSICS:
                raise CsscError(
                    operation='Runtime',
                    detail=(f"cssc::{func_name} is a freestanding CCOS kernel "
                            f"intrinsic — it maps to a CPU instruction / MMIO "
                            f"access on the bare-metal `ccos` target and cannot "
                            f"run in the interpreter. Build it with "
                            f"`cssc native <file> --target ccos` and run the "
                            f"kernel in QEMU / on hardware."),
                    line=node.get('line', 0))
            if func_name in self._ns_builtins:
                func = self._ns_builtins[func_name]
                try: return func(*args)
                except TypeError:
                    import inspect
                    try:
                        sig = inspect.signature(func)
                        n = len([p for p in sig.parameters.values() if p.default is inspect.Parameter.empty])
                        return func(*args[:n])
                    except Exception:
                        return func(*args[:1]) if args else func()
            raise CsscError(operation='Runtime', detail=f'Unknown cssc builtin: {func_name}', line=node.get('line', 0))
        mod = self._modules.get(ns) or self._variables.get(ns)
        if mod is not None:
            if isinstance(mod, CsscSector):
                if not mod.is_public(func_name):
                    return None  # private → 0x0
                func = mod._vars.get(func_name)
                if isinstance(func, CsscObject):
                    return func.execute(*args)
                if callable(func):
                    # Sector method dispatch: push the sector's _vars
                    # onto _parent_scopes so the body's `#req[member]`
                    # can resolve sector members through the standard
                    # parent-scope walk. Without this, the callback's
                    # parent scope would only be the CALLER's vars,
                    # which doesn't contain Greeter's members.
                    if not hasattr(self, '_parent_scopes'):
                        self._parent_scopes = []
                    if not hasattr(self, '_owning_sector_stack'):
                        self._owning_sector_stack = []
                    self._parent_scopes.append(mod._vars)
                    # Track the running sector so ns-calls in its body are
                    # isolation-checked (see _check_sector_isolation).
                    self._owning_sector_stack.append(mod)
                    try:
                        return func(*args)
                    finally:
                        # Defensive pop — guard against the caller
                        # already having consumed our frame (e.g.
                        # via a transitive exception unwinding the
                        # callback's own try/finally).
                        if (self._parent_scopes
                                and self._parent_scopes[-1] is mod._vars):
                            self._parent_scopes.pop()
                        if (self._owning_sector_stack
                                and self._owning_sector_stack[-1] is mod):
                            self._owning_sector_stack.pop()
                return None  # not callable → 0x0
            if isinstance(mod, CsscModule) or hasattr(mod, 'get_namespace'):
                funcs = mod.get_namespace()
                if func_name in funcs:
                    val = funcs[func_name]
                    if isinstance(val, CsscObject):
                        return val.execute(*args)
                    if callable(val):
                        return val(*args)
                    return val
                raise CsscError(operation='Runtime', detail=f"Module '{ns}' has no function '{func_name}'", line=node.get('line', 0))
            method = getattr(mod, func_name, None)
            if isinstance(method, CsscObject):
                return method.execute(*args)
            if callable(method):
                return method(*args)
        raise CsscError(operation='Runtime', detail=f'Unknown namespace: {ns}', line=node.get('line', 0))

    def _eval_ns_access(self, node):
        member = node['member']
        ns_expr = node.get('namespace_expr')
        if ns_expr is not None:
            base = self._eval(ns_expr)
            if base is None:
                return None
            if isinstance(base, CsscSector):
                if not base.is_public(member):
                    return None
                return base.get_member(member)
            if isinstance(base, CsscModule) or hasattr(base, 'get_namespace'):
                ns_dict = base.get_namespace()
                if member in ns_dict:
                    return ns_dict[member]
            if isinstance(base, dict):
                return base.get(member)
            return getattr(base, member, None)
        ns = node['namespace']
        if ns == 'cssc': return self._ns_builtins.get(member)
        # During sector construction, resolve from local scope
        if getattr(self, '_building_sector', None) == ns and member in self._variables:
            return self._variables[member]
        mod = self._modules.get(ns) or self._variables.get(ns)
        # Trigger watermark once on first #depend-alias access
        if mod is not None and getattr(mod, '_depend_origin', None):
            try:
                from includecpp.core.cssl import cssl_watermark as _wm
                _wm.show_once()
            except Exception:
                pass
        if mod:
            if isinstance(mod, CsscSector):
                if not mod.is_public(member):
                    return None  # private → 0x0
                return mod.get_member(member)
            if isinstance(mod, CsscModule) or hasattr(mod, 'get_namespace'):
                ns_dict = mod.get_namespace()
                if member in ns_dict:
                    val = ns_dict[member]
                    if callable(val):
                        import inspect
                        try:
                            sig = inspect.signature(val)
                            params = [p for p in sig.parameters.values()
                                      if p.default is inspect.Parameter.empty]
                            if len(params) == 0:
                                return val()
                        except (ValueError, TypeError):
                            pass
                    return val
            return getattr(mod, member, None)
        return None

    def _eval_method_call(self, node):
        method_name = node['method']
        obj_node = node.get('object') or {}
        # `label.pos()` inside `select (...) ?label { ... }` — return cursor pos.
        if (method_name == 'pos' and obj_node.get('type') in ('identifier', 'ident')
                and hasattr(self, '_select_cursors')):
            ident = obj_node.get('name')
            if ident in self._select_cursors:
                return int(self._select_cursors[ident])
        obj = self._eval(node['object'])
        ast_args = node['args']
        args = [self._eval_arg(a) for a in ast_args]
        # v6 ref-by-default arg-meta stash (spec §2.5).
        self._stash_pending_arg_metas(ast_args)
        # Resolve CsscPointer args to actual values — BUT keep CsscPointer
        # for container mutation methods so references are stored, not values.
        _CONTAINER_STORE_METHODS = {'push_back', 'push_front', 'insert', 'append', 'set'}
        if not (isinstance(obj, (list, CsscBind)) and method_name in _CONTAINER_STORE_METHODS):
            args = [self._resolve_value(a) if isinstance(a, CsscPointer) else a for a in args]
        if obj is None: return None
        # Sector/Object/LoadedModule -> member function call: obj->func(args)
        if isinstance(obj, (CsscSector, CsscLoadedModule)):
            member = obj._vars.get(method_name) if hasattr(obj, '_vars') else None
            if member is None:
                member = getattr(obj, method_name, None)
            if isinstance(member, CsscObject):
                return member.execute(*args)
            if callable(member):
                return member(*args)
            return None
        if isinstance(obj, CsscObject):
            # obj->label(args) — call label on object
            handler = getattr(obj, method_name, None)
            if handler is not None:
                if callable(handler):
                    return handler(*args)
                return handler
        # CsscIterator — delegate to real methods
        if isinstance(obj, CsscIterator):
            m = getattr(obj, method_name, None)
            if m and callable(m):
                return m(*args)
            raise CsscError(operation='Runtime', detail=f"No method '{method_name}' on iterator",
                            line=node.get('line', 0))
        # CsscMatrix — delegate to real methods
        if isinstance(obj, CsscMatrix):
            m = getattr(obj, method_name, None)
            if m and callable(m):
                return m(*args)
            raise CsscError(operation='Runtime', detail=f"No method '{method_name}' on matrix",
                            line=node.get('line', 0))
        # CsscVector — delegate to real Vector methods from cssl_types
        if isinstance(obj, CsscVector):
            m = getattr(obj, method_name, None)
            if m and callable(m):
                return m(*args)
        # Check custom method dicts FIRST for built-in types (before getattr)
        if isinstance(obj, dict):
            dm = {'get': lambda k, d=None: obj.get(k, d), 'set': lambda k, v: obj.__setitem__(k, v),
                  'has': lambda k: k in obj, 'keys': lambda: list(obj.keys()),
                  'values': lambda: list(obj.values()), 'items': lambda: [[k, v] for k, v in obj.items()],
                  'remove': lambda k: obj.pop(k, None),
                  'size': lambda: len(obj), 'length': lambda: len(obj),
                  'clear': lambda: obj.clear(), 'exists': lambda: True,
                  'empty': lambda: len(obj) == 0,
                  'begin': lambda: list(obj.keys())[0] if obj else None,
                  'end': lambda: list(obj.keys())[-1] if obj else None,
                  'front': lambda: list(obj.values())[0] if obj else None,
                  'back': lambda: list(obj.values())[-1] if obj else None,
                  'contains': lambda k: k in obj, 'count': lambda k: 1 if k in obj else 0}
            if method_name in dm: return dm[method_name](*args)
        # Bind chain-of-maps — addmap appends a map's entries to the chain.
        if isinstance(obj, CsscBind) and method_name == 'addmap':
            if not args: return obj
            payload = args[0]
            if isinstance(payload, dict):
                for k, v in payload.items():
                    obj.append((k, v))
            elif isinstance(payload, (list, tuple)) and len(payload) == 2 and not isinstance(payload[0], (list, tuple, dict)):
                obj.append((payload[0], payload[1]))
            elif isinstance(payload, (list, tuple)):
                for entry in payload:
                    if isinstance(entry, (list, tuple)) and len(entry) >= 2:
                        obj.append((entry[0], entry[1]))
                    else:
                        obj.append((entry, None))
            else:
                obj.append((payload, None))
            return obj
        if isinstance(obj, list):
            lm = {'get': lambda i: obj[int(i)] if 0 <= int(i) < len(obj) else None,
                  'push': lambda v: (obj.append(v), obj)[-1], 'pop': lambda: obj.pop() if obj else None,
                  'size': lambda: len(obj), 'length': lambda: len(obj),
                  'contains': lambda v: v in obj,
                  'indexOf': lambda v: obj.index(v) if v in obj else -1,
                  'clear': lambda: obj.clear(), 'sort': lambda: (obj.sort(), obj)[-1],
                  'reverse': lambda: (obj.reverse(), obj)[-1],
                  'append': lambda v: (obj.append(v), obj)[-1],
                  'atIndex': lambda i: obj[int(i)] if 0 <= int(i) < len(obj) else None,
                  'takeout': lambda i: obj.pop(int(i)) if 0 <= int(i) < len(obj) else None,
                  'pushafter': lambda i, v: (obj.insert(int(i) + 1, v), obj)[-1],
                  'notAtIndex': lambda i, t: not isinstance(obj[int(i)], {'string': str, 'int': int, 'float': float, 'bool': bool, 'array': list, 'map': dict}.get(str(t), object)) if 0 <= int(i) < len(obj) else True,
                  'remove': lambda v: (obj.remove(v), obj)[-1] if v in obj else obj,
                  'insert': lambda i, v: (obj.insert(int(i), v), obj)[-1],
                  'slice': lambda start, end=None: obj[int(start):] if end is None else obj[int(start):int(end)],
                  'join': lambda sep='': sep.join(str(x) for x in obj),
                  'first': lambda: obj[0] if obj else None,
                  'last': lambda: obj[-1] if obj else None,
                  'empty': lambda: len(obj) == 0,
                  'flat': lambda: [item for sub in obj for item in (sub if isinstance(sub, list) else [sub])],
                  'unique': lambda: list(dict.fromkeys(obj)),
                  'count': lambda v: obj.count(v),
                  'exists': lambda: True,
                  'push_back': lambda v: (obj.append(v), obj)[-1],
                  'push_front': lambda v: (obj.insert(0, v), obj)[-1],
                  'pop_back': lambda: obj.pop() if obj else None,
                  'pop_front': lambda: obj.pop(0) if obj else None,
                  'emplace_back': lambda v: (obj.append(v), obj)[-1],
                  'emplace_front': lambda v: (obj.insert(0, v), obj)[-1],
                  'front': lambda: obj[0] if obj else None,
                  'back': lambda: obj[-1] if obj else None,
                  'begin': lambda: obj[0] if obj else None,
                  'end': lambda: obj[-1] if obj else None,
                  'rbegin': lambda: obj[-1] if obj else None,
                  'rend': lambda: obj[0] if obj else None,
                  'at': lambda i: obj[int(i)] if 0 <= int(i) < len(obj) else None,
                  'erase': lambda i: (obj.pop(int(i)), obj)[-1] if 0 <= int(i) < len(obj) else obj,
                  'resize': lambda n, fill=None: (obj.extend([fill] * (int(n) - len(obj))) if int(n) > len(obj) else obj[:int(n)], obj)[-1],
                  'capacity': lambda: len(obj), 'data': lambda: obj,
                  'swap': lambda other: (obj.clear(), obj.extend(other))[-1] if isinstance(other, list) else obj}
            if method_name in lm: return lm[method_name](*args)
        if isinstance(obj, str):
            sm = {'length': lambda: len(obj), 'size': lambda: len(obj),
                  'begin': lambda: obj[0] if obj else '',
                  'end': lambda: obj[-1] if obj else '',
                  'front': lambda: obj[0] if obj else '',
                  'back': lambda: obj[-1] if obj else '',
                  'data': lambda: obj, 'capacity': lambda: len(obj),
                  'upper': lambda: obj.upper(), 'lower': lambda: obj.lower(),
                  'trim': lambda: obj.strip(), 'split': lambda sep=' ': obj.split(sep),
                  'replace': lambda old, new: obj.replace(old, new),
                  'contains': lambda sub: str(sub) in obj,
                  'starts_with': lambda p: obj.startswith(str(p)), 'startsWith': lambda p: obj.startswith(str(p)),
                  'ends_with': lambda p: obj.endswith(str(p)), 'endsWith': lambda p: obj.endswith(str(p)),
                  'index_of': lambda sub: obj.find(str(sub)), 'indexOf': lambda sub: obj.find(str(sub)),
                  'index': lambda i: obj[int(i)] if 0 <= int(i) < len(obj) else '',
                  'charAt': lambda i: obj[int(i)] if 0 <= int(i) < len(obj) else '',
                  'substr': lambda start, length=-1: obj[int(start):] if length == -1 else obj[int(start):int(start)+int(length)],
                  'substring': lambda start, end=-1: obj[int(start):] if end == -1 else obj[int(start):int(end)],
                  'reverse': lambda: obj[::-1], 'repeat': lambda n: obj * int(n),
                  'padStart': lambda n, ch=' ': obj.rjust(int(n), str(ch)[0] if ch else ' '),
                  'padEnd': lambda n, ch=' ': obj.ljust(int(n), str(ch)[0] if ch else ' '),
                  'isEmpty': lambda: len(obj) == 0,
                  'isDigit': lambda: obj.isdigit(), 'isAlpha': lambda: obj.isalpha(),
                  'toInt': lambda: int(obj) if obj.lstrip('-').isdigit() else 0,
                  'toFloat': lambda: float(obj) if obj.replace('.', '', 1).lstrip('-').isdigit() else 0.0,
                  'exists': lambda: True}
            if method_name in sm: return sm[method_name](*args)
        # Fallback: try getattr for object methods
        method = getattr(obj, method_name, None)
        if callable(method): return method(*args)
        raise CsscError(operation='Runtime', detail=f"No method '{method_name}' on {self._b_typeof(obj)}", line=node.get('line', 0))

    def _eval_arrow(self, node):
        obj_node = node['object']
        key = node['key']
        if obj_node.get('type') in ('ident', 'identifier') and getattr(self, '_building_sector', None) == obj_node.get('name'):
            # Check object/sector _vars first (arrow assigns write there directly)
            obj_ref = self._variables.get(obj_node.get('name'))
            if isinstance(obj_ref, (CsscObject, CsscSector)) and key in obj_ref._vars:
                return obj_ref._vars[key]
            return self._variables.get(key)
        obj = self._eval(obj_node)
        # If obj is None, try parent scopes (for Sector->Member inside #define callbacks)
        if obj is None and obj_node.get('type') in ('ident', 'identifier'):
            name = obj_node.get('name')
            if hasattr(self, '_parent_scopes'):
                for ps in reversed(self._parent_scopes):
                    if name in ps:
                        obj = ps[name]
                        break
        if obj is None: return None
        if isinstance(obj, CsscSector): return obj.get_member(key)
        # CsscObject members are dict-keyed in _vars, not Python attributes.
        # Without this, `obj_self->member` reads from inside the object's own
        # labels returned None — every chained method call became a silent NOP.
        if isinstance(obj, CsscObject): return obj._vars.get(key)
        if isinstance(obj, dict): return obj.get(key)
        method = getattr(obj, key, None)
        if method is not None: return method
        if hasattr(obj, 'get') and callable(obj.get): return obj.get(key)
        return None

    def _eval_dot(self, node):
        obj = self._eval(node['object'])
        key = node['key']
        if obj is None: return None
        if isinstance(obj, dict): return obj.get(key)
        return getattr(obj, key, None)

    # -- Type helpers -------------------------------------------------------
    @staticmethod
    def _split_generic_args(s):
        parts = []
        depth = 0
        current = []
        for ch in s:
            if ch == '<':
                depth += 1
                current.append(ch)
            elif ch == '>':
                depth -= 1
                current.append(ch)
            elif ch == ',' and depth == 0:
                parts.append(''.join(current).strip())
                current = []
            else:
                current.append(ch)
        if current:
            parts.append(''.join(current).strip())
        return parts

    @staticmethod
    def _parse_base_type(vtype):
        lt = vtype.find('<')
        if lt >= 0 and vtype.endswith('>'):
            return vtype[:lt].strip(), vtype[lt + 1:-1].strip()
        return vtype.strip(), None

    def _default_for_type(self, vtype):
        base, elem = self._parse_base_type(vtype)
        if base == 'array':
            return CsscArray(elem or 'dynamic')
        if base in ('list', 'vector'):
            return CsscVector()
        if base in ('map', 'dict'):
            return CsscMap()
        defaults = {'int': 0, 'float': 0.0, 'string': '', 'str': '',
                    'bind': CsscBind([]),
                    'bool': False, 'boolean': False, 'auto': None, 'var': None, 'void': None}
        return defaults.get(base, None)

    def _strict_type_check(self, value, target_type, varname='', line=0):
        """Strict type check — raises error if value is incompatible with target type."""
        base, _ = self._parse_base_type(target_type)
        if base in ('auto', 'var', 'void', None):
            return
        ok = False
        if base == 'int':
            ok = isinstance(value, (int, bool)) or (isinstance(value, float) and value == int(value))
            if not ok and isinstance(value, str):
                ok = value.lstrip('-').isdigit()
        elif base == 'float':
            ok = isinstance(value, (int, float, bool))
            if not ok and isinstance(value, str):
                try:
                    float(value)
                    ok = True
                except ValueError:
                    pass
        elif base in ('string', 'str'):
            ok = True
        elif base in ('bool', 'boolean'):
            ok = isinstance(value, (bool, int))
        elif base in ('array', 'list', 'vector'):
            ok = isinstance(value, (list, tuple))
        elif base in ('map', 'dict'):
            ok = isinstance(value, dict)
        elif base == 'bind':
            ok = isinstance(value, CsscBind)
        else:
            ok = True
        if not ok:
            val_type = type(value).__name__
            raise CsscError(operation='Runtime',
                            detail=f'Type mismatch: cannot assign {val_type} to variable "{varname}" of type {target_type}',
                            hint=f'Variable "{varname}" is strictly typed as {target_type}',
                            line=line)

    def _coerce(self, value, target_type):
        # Preserve callable references (functions) — never coerce them to primitive types
        if callable(value) and not isinstance(value, (bool, int, float, str, list, dict)):
            return value
        base, elem = self._parse_base_type(target_type)
        if base == 'int':
            try: return int(value) if value is not None else 0
            except (ValueError, TypeError): return 0
        if base == 'float':
            try: return float(value) if value is not None else 0.0
            except (ValueError, TypeError): return 0.0
        if base in ('string', 'str'): return str(value) if value is not None else ''
        if base in ('bool', 'boolean'): return self._is_truthy(value)
        if base in ('array', 'list', 'vector'):
            # `array<T>` is a distinct type from `vector<T>` — it stays a
            # CsscArray so `cssc::typeof` reports 'array' (native reports
            # 'array' for its array_* slot kinds). `vector`/`list` collapse
            # to CsscVector ('vector'). Both share the same mutable list
            # method surface, so the distinction is purely nominal/typeof.
            if base == 'array':
                if isinstance(value, CsscArray): return value
            elif isinstance(value, CsscVector):
                return value
            raw = None
            if isinstance(value, list):
                raw = list(value)
            elif isinstance(value, dict):
                raw = list(value.values()) if value else []
            elif isinstance(value, str) and ',' in value:
                parts = [p.strip() for p in value.split(',')]
                raw = []
                for p in parts:
                    if p.lstrip('-').isdigit():
                        raw.append(int(p))
                    else:
                        try: raw.append(float(p))
                        except ValueError: raw.append(p)
            else:
                raw = [value] if value is not None else []
            if base == 'array':
                arr = CsscArray(elem or 'dynamic')
                arr.extend(raw)
                return arr
            vec = CsscVector()
            vec.extend(raw)
            return vec
        if base in ('map', 'dict'):
            if isinstance(value, CsscMap): return value
            if isinstance(value, dict):
                m = CsscMap()
                m.update(value)
                return m
            if isinstance(value, (list, tuple)):
                m = CsscMap()
                # Per CSSC Doc §3.2 the map-literal syntax is the comma form
                # `{'k', 'v', 'k2', 'v2'}` — the parser routes that through
                # an array-literal AST node, which arrives here. Walk the
                # items in pairs (key, value, key, value, …) instead of
                # numeric-indexing them. Odd-length lists fall back to the
                # numeric form so positional-only payloads still work.
                lst = list(value)
                if lst and len(lst) % 2 == 0:
                    for i in range(0, len(lst), 2):
                        m[lst[i]] = lst[i + 1]
                else:
                    m.update({i: v for i, v in enumerate(lst)})
                return m
            return CsscMap()
        if base == 'bind':
            if isinstance(value, CsscBind): return value
            if isinstance(value, list):
                # Type-strict cells (parity with the native lowerer): a
                # `bind<int>` holds only ints, a `bind<string>` only
                # strings, etc. `bind<auto>` / bare `bind` (elem not a
                # concrete scalar) is the deterministic escape hatch and
                # skips the check. A null (`0x0` → None) cell is the
                # universal sentinel and matches any typed slot.
                if elem in ('int', 'float', 'bool', 'string'):
                    # Flatten ONLY the pre-paired `[(a,b),(c,d)]` shape into
                    # its cells; a flat list keeps each element as one cell
                    # so a container cell (CsscVector is a list subclass!)
                    # is checked as a whole, not silently spread into ints.
                    _prepaired = (value and isinstance(value[0], tuple)
                                  and len(value[0]) >= 2
                                  and all(isinstance(_p, tuple) for _p in value))
                    if _prepaired:
                        _flat = [_c for _pair in value for _c in _pair]
                    else:
                        _flat = list(value)
                    for _ci, _cell in enumerate(_flat):
                        if _cell is None:
                            continue
                        if elem == 'int':
                            _ok = isinstance(_cell, int) and not isinstance(_cell, bool)
                        elif elem == 'float':
                            _ok = isinstance(_cell, (int, float)) and not isinstance(_cell, bool)
                        elif elem == 'bool':
                            _ok = isinstance(_cell, bool)
                        else:
                            _ok = isinstance(_cell, str)
                        if not _ok:
                            raise CsscError(
                                operation='Runtime',
                                detail=(f'bind<{elem}> cell #{_ci} is a '
                                        f'{type(_cell).__name__}, not '
                                        f'{elem} — a typed bind is strict: '
                                        f'every cell must be {elem}'),
                                hint='use bind<auto> for a heterogeneous '
                                     'record, or put a matching value in '
                                     'this cell',
                                line=0)
                # Pair-up rule for flat lists from `{a, b}` / `{a, b, c, d}`
                # literals (post-parser routing): every two adjacent
                # items form one (key, value) pair. Items that are
                # already 2-tuples (from canonical `{k, v; k, v}` bind
                # literals) pass through as-is. This matches the v6
                # native semantics where a `bind` is a flat cell list
                # accessed pair-wise — `i[0]` is the first cell, not a
                # (first_cell, None) tuple.
                #
                # CRITICAL: the produced pairs are width-2 tuples, so the
                # CsscBind MUST carry `pair_width=2`. Without it the bind
                # is mislabelled flat (`pair_width=0`) while its entries
                # are tuples — an inconsistent state that makes both
                # single-index (`b[0]` returns the whole `(a,b)` tuple
                # instead of cell `a`) and chained-index (`b[row][col]`
                # degrades to row-only, dropping `col` and returning the
                # whole pair — the stray trailing cell users saw as
                # `…, 0`) read wrong. `pair_width=2` restores the
                # documented invariant `b[row][col] == b[row*2 + col]`.
                if value and isinstance(value[0], (list, tuple)) and len(value[0]) >= 2:
                    return CsscBind([(p[0], p[1]) for p in value],
                                    pair_width=2)
                _pairs = []
                _it = iter(value)
                for _a in _it:
                    _b = next(_it, None)
                    _pairs.append((_a, _b))
                return CsscBind(_pairs, pair_width=2)
            return CsscBind([])
        return value

    def _is_truthy(self, value):
        if value is None: return False
        if isinstance(value, bool): return value
        if isinstance(value, (int, float)): return value != 0
        if isinstance(value, str): return len(value) > 0 and value.lower() not in ('false', '0', 'null', 'none')
        if isinstance(value, (list, dict)): return len(value) > 0
        return True

    def cleanup(self):
        for name, (rtype, resource) in self._resources.items():
            try:
                if hasattr(resource, 'close') and callable(resource.close):
                    resource.close()
                elif hasattr(resource, 'save') and callable(resource.save):
                    resource.save()
            except Exception:
                pass
        if self._output_path and self._output_buffer:
            try:
                with open(self._output_path, 'w', encoding='utf-8') as fh:
                    fh.write(''.join(self._output_buffer))
            except Exception:
                pass

    def get_output(self):
        return ''.join(self._output_buffer)

    def status(self):
        return {
            'variables': len(self._variables),
            'modules': list(self._modules.keys()),
            'resources': {k: v[0] for k, v in self._resources.items()},
            'running': self._running,
            'exit_code': self._exit_code,
            'output_lines': len(self._output_buffer),
        }


# ---------------------------------------------------------------------------
# CProject — cssc.cproject configuration parser
# ---------------------------------------------------------------------------
def _cproject_iter_logical_lines(content: str):
    """Yield logical lines from a cproject document.

    A physical line is joined with the next until any open `[`/`{` brackets
    close, so multi-line array/dict values are parsed as one unit:

        include = [
            "/core",
            "/render"
        ]

    is yielded as `include = [ "/core", "/render" ]`.

    String contents are respected — brackets inside quotes don't affect
    depth. Trailing `//` line comments are stripped BEFORE the bracket
    counter so a comment isn't glued into the buffered value.
    """
    def _strip_line_comment(text: str) -> str:
        in_str = False
        str_char = None
        i = 0
        while i < len(text):
            ch = text[i]
            if ch in ('"', "'"):
                if not in_str:
                    in_str = True
                    str_char = ch
                elif ch == str_char:
                    in_str = False
                    str_char = None
            elif not in_str and ch == '/' and i + 1 < len(text) and text[i + 1] == '/':
                return text[:i]
            i += 1
        return text

    buf: list = []
    depth = 0
    for raw in content.splitlines():
        line = _strip_line_comment(raw).rstrip()
        if not line and depth == 0:
            if buf:
                yield ' '.join(buf)
                buf = []
            continue
        in_str = False
        str_char = None
        for ch in line:
            if ch in ('"', "'"):
                if not in_str:
                    in_str = True
                    str_char = ch
                elif ch == str_char:
                    in_str = False
                    str_char = None
            elif not in_str and ch in ('[', '{'):
                depth += 1
            elif not in_str and ch in (']', '}'):
                depth -= 1
        buf.append(line)
        if depth <= 0:
            depth = 0
            yield ' '.join(buf)
            buf = []
    if buf:
        yield ' '.join(buf)


def _cproject_to_bool(val, default=True) -> bool:
    if isinstance(val, bool):
        return val
    if isinstance(val, (int, float)):
        return val != 0
    if isinstance(val, str):
        s = val.strip().lower()
        if s in ('false', '0', 'no', 'off', 'disable', 'disabled'):
            return False
        if s in ('true', '1', 'yes', 'on', 'enable', 'enabled'):
            return True
    return default


def _cproject_to_str_list(val) -> list:
    if val is None:
        return []
    if isinstance(val, str):
        s = val.strip()
        if not s:
            return []
        return [s]
    if isinstance(val, (list, tuple)):
        out = []
        for item in val:
            if isinstance(item, str) and item.strip():
                out.append(item.strip())
        return out
    return []


def _cproject_normalize_pattern(pattern: str) -> str:
    p = pattern.strip().replace('\\', '/')
    while p.startswith('./'):
        p = p[2:]
    if p.startswith('/'):
        p = p[1:]
    while p.endswith('/') and len(p) > 1:
        p = p[:-1]
    return p


def _cproject_pattern_matches(rel_path: str, pattern: str) -> bool:
    """Match `rel_path` (project-relative, forward-slashes) against an
    include/exclude pattern from `cssc.cproject`.

    Rules:
      * `""` (empty) → matches every path.
      * `"/"` → matches ONLY files directly in the project root (no
        subdirectory). Use to include/exclude the "root only" bucket
        without touching subdirs.
      * `"core"` / `"/core"` → matches the `core` dir itself and any file
        beneath it (`core`, `core/foo.cssc`, `core/nested/x.cssc`).
      * `"tests"` / `"/tests"` → same, one level deeper.
      * `"*.cssc"` → glob on the basename via fnmatch.
      * `"core/*.cssc"` → glob on the full relative path via fnmatch.
      * `"**/foo.cssc"` → recursive glob (fnmatch supports `**`).
    """
    import fnmatch as _fn
    rp = rel_path.replace('\\', '/').lstrip('/')
    raw = pattern.strip().replace('\\', '/')

    if raw == '':
        return True
    if raw == '/':
        return '/' not in rp
    pat = _cproject_normalize_pattern(raw)
    if pat == '':
        return True

    if any(ch in pat for ch in ('*', '?', '[')):
        if _fn.fnmatch(rp, pat):
            return True
        base = rp.rsplit('/', 1)[-1]
        return _fn.fnmatch(base, pat)
    if rp == pat:
        return True
    if rp.startswith(pat + '/'):
        return True
    return False


class CsscCProject:
    """Parse and manage cssc.cproject configuration files.

    Format (INI-like):
        dir = "path";
        prebuilds_enabled = true;
        buildmodules.source += [{"data" = {"source" = ["/file.cssl"], "entry" = "func"}, "name" = "modname"}];
        lsp.highlights += "white<#>blue<qtext>white<()>gray<-p>"
    """

    def __init__(self, path: str):
        self.path = os.path.abspath(path)
        self.dir = os.path.dirname(self.path)
        self.prebuilds_enabled = False
        self.buildmodules = []  # list of {"data": {"source": [...], "entry": "..."}, "name": "..."}
        self.lsp_highlights = []  # list of highlight rule strings
        self.warn_mem_leak = True    # LSP: emit "potential memory leak" warnings
        self.warn_scope_violation = True   # LSP: emit scope-violation lints
        self.warn_module_use_missing = True  # LSP: emit missing-module lints
        self.include: list = []      # LSP: paths to analyse (relative to project dir); [] = all
        self.exclude: list = []      # LSP: paths to skip (matched before include)
        self._raw = {}
        if os.path.isfile(self.path):
            self._parse()

    @property
    def _data(self) -> dict:
        """Read-only view of the raw parsed key→value map. Provided for
        backwards compatibility with callers that used `cp._data.get(...)`
        (the LSP still uses this shape). New code should use the typed
        attributes (`warn_mem_leak`, `include`, `exclude`, ...).
        """
        return self._raw

    def _parse(self):
        with open(self.path, 'r', encoding='utf-8') as fh:
            content = fh.read()

        for raw_line in _cproject_iter_logical_lines(content):
            line = raw_line.strip()
            if not line or line.startswith('//') or line.startswith('#'):
                continue
            # Remove trailing semicolons and comments
            if '//' in line:
                # Avoid stripping // inside strings
                in_str = False
                str_char = None
                for i, ch in enumerate(line):
                    if ch in ('"', "'") and not in_str:
                        in_str = True
                        str_char = ch
                    elif ch == str_char and in_str:
                        in_str = False
                    elif ch == '/' and i + 1 < len(line) and line[i + 1] == '/' and not in_str:
                        line = line[:i].strip()
                        break
            line = line.rstrip(';').strip()
            if not line:
                continue

            # Parse key = value or key += value
            append_mode = False
            if '+=' in line:
                key, _, val = line.partition('+=')
                append_mode = True
            elif '=' in line:
                key, _, val = line.partition('=')
            else:
                continue

            key = key.strip()
            val = val.strip()

            # Parse value
            parsed_val = self._parse_value(val)
            self._raw[key] = parsed_val

            # Handle known keys
            if key == 'dir':
                if isinstance(parsed_val, str):
                    self.dir = parsed_val
            elif key == 'prebuilds_enabled':
                self.prebuilds_enabled = bool(parsed_val) if not isinstance(parsed_val, str) else parsed_val.lower() == 'true'
            elif key == 'buildmodules.source':
                if isinstance(parsed_val, list):
                    if append_mode:
                        self.buildmodules.extend(parsed_val)
                    else:
                        self.buildmodules = parsed_val
            elif key == 'lsp.highlights':
                if isinstance(parsed_val, str):
                    if append_mode:
                        self.lsp_highlights.append(parsed_val)
                    else:
                        self.lsp_highlights = [parsed_val]
            elif key in ('warn_mem_leak', 'lsp.warn_mem_leak'):
                self.warn_mem_leak = _cproject_to_bool(parsed_val, True)
            elif key in ('warn_scope_violation', 'lsp.warn_scope_violation'):
                self.warn_scope_violation = _cproject_to_bool(parsed_val, True)
            elif key in ('warn_module_use_missing', 'lsp.warn_module_use_missing'):
                self.warn_module_use_missing = _cproject_to_bool(parsed_val, True)
            elif key in ('include', 'lsp.include'):
                self.include = _cproject_to_str_list(parsed_val)
            elif key in ('exclude', 'lsp.exclude'):
                self.exclude = _cproject_to_str_list(parsed_val)

    def _parse_value(self, val: str):
        """Parse a cproject value (string, bool, number, list, dict)."""
        val = val.strip()
        # String
        if (val.startswith('"') and val.endswith('"')) or (val.startswith("'") and val.endswith("'")):
            return val[1:-1]
        # Boolean
        if val.lower() == 'true':
            return True
        if val.lower() == 'false':
            return False
        # Number
        if val.lstrip('-').isdigit():
            return int(val)
        try:
            return float(val)
        except ValueError:
            pass
        # List [...] or dict {...}
        if val.startswith('['):
            return self._parse_list(val)
        if val.startswith('{'):
            return self._parse_dict(val)
        return val

    def _parse_list(self, val: str) -> list:
        """Parse a cproject list: [item1, item2, ...]."""
        val = val.strip()
        if not val.startswith('[') or not val.endswith(']'):
            return [val]
        inner = val[1:-1].strip()
        if not inner:
            return []
        # Split by commas respecting nesting
        items = []
        depth = 0
        current = []
        for ch in inner:
            if ch in ('[', '{'):
                depth += 1
                current.append(ch)
            elif ch in (']', '}'):
                depth -= 1
                current.append(ch)
            elif ch == ',' and depth == 0:
                items.append(''.join(current).strip())
                current = []
            else:
                current.append(ch)
        if current:
            items.append(''.join(current).strip())
        return [self._parse_value(item) for item in items if item]

    def _parse_dict(self, val: str) -> dict:
        """Parse a cproject dict: {"key" = value, ...}."""
        val = val.strip()
        if not val.startswith('{') or not val.endswith('}'):
            return {}
        inner = val[1:-1].strip()
        if not inner:
            return {}
        # Split by commas respecting nesting
        pairs = []
        depth = 0
        current = []
        for ch in inner:
            if ch in ('[', '{'):
                depth += 1
                current.append(ch)
            elif ch in (']', '}'):
                depth -= 1
                current.append(ch)
            elif ch == ',' and depth == 0:
                pairs.append(''.join(current).strip())
                current = []
            else:
                current.append(ch)
        if current:
            pairs.append(''.join(current).strip())
        result = {}
        for pair in pairs:
            if '=' in pair:
                k, _, v = pair.partition('=')
                k = k.strip().strip('"').strip("'")
                result[k] = self._parse_value(v.strip())
        return result

    def path_included(self, file_path: str) -> bool:
        """Check whether `file_path` passes this cproject's include/exclude rules.

        Rules:
          * Empty `include` list = all paths pass the include gate.
          * A non-empty `include` list requires at least one pattern to match.
          * `exclude` runs AFTER include — any match excludes the file.
          * Patterns are matched with `_cproject_pattern_matches` — leading `/`
            is project-root-anchored, glob metacharacters (`*`, `?`, `[`, `**`)
            are honoured, otherwise a bare name matches path prefixes
            (e.g. `core` matches `core/foo.cssc`).
        """
        abs_file = os.path.abspath(file_path).replace('\\', '/')
        abs_root = os.path.abspath(self.dir).replace('\\', '/')
        if abs_file.lower().startswith(abs_root.lower() + '/'):
            rel = abs_file[len(abs_root) + 1:]
        elif abs_file.lower() == abs_root.lower():
            rel = ''
        else:
            rel = abs_file.rsplit('/', 1)[-1]

        if self.include:
            if not any(_cproject_pattern_matches(rel, p) for p in self.include):
                return False
        if self.exclude:
            if any(_cproject_pattern_matches(rel, p) for p in self.exclude):
                return False
        return True

    @staticmethod
    def find_in_dir(script_dir: str) -> 'CsscCProject':
        """Look for cssc.cproject in the given directory."""
        cproject_path = os.path.join(script_dir, 'cssc.cproject')
        if os.path.isfile(cproject_path):
            return CsscCProject(cproject_path)
        return None


# ---------------------------------------------------------------------------
# CProject Mod Extension — bridges CSSL mods into CSSC runtime
# ---------------------------------------------------------------------------
class CsscModExtension:
    """Collects custom builtins and hash operations registered by CSSL mod code.

    Provides the CSSCParser API that mod CSSL code calls:
        this->CSSCParser->addBuiltinFunction(name, param, callback, stub=...)
        this->CSSCParser->addHashOperation(call, behaviour, brackets, parameters, callback)
    """

    def __init__(self):
        self._builtin_functions = {}  # name -> {callback, params, stub}
        self._hash_operations = {}   # call -> {behaviour, brackets, parameters, callback}
        self._runtime = None  # Set by inject_into_runtime for function resolution

    def isFunction(self, value):
        """Check if a value is an unresolved function call (e.g. 'platform()').
        Used by CSSL mods to detect params that need resolving."""
        if not isinstance(value, str):
            return False
        s = value.strip()
        # Check for pattern like funcname() or funcname(args)
        if '(' in s and s.endswith(')'):
            fname = s[:s.index('(')].strip()
            if fname and fname.isidentifier():
                # Check if it's a known builtin or custom function
                if self._runtime:
                    if fname in self._runtime._ns_builtins:
                        return True
                    if fname in getattr(self._runtime, '_custom_hash_ops', {}):
                        return True
                    if fname in self._runtime._variables:
                        return True
                return True  # Assume it's a function if it looks like one
        return False

    def reslovefunc(self, value):
        """Resolve an unresolved function call string by evaluating it in the CSSC runtime.
        Used by CSSL mods: auto msg = this->CSSCParser->reslovefunc(msg);"""
        if not isinstance(value, str) or not self._runtime:
            return value
        s = value.strip()
        try:
            # Parse and evaluate the expression in the CSSC runtime
            tokens = CsscLexer(s + ';', '<resolve>').tokenize()
            parser = CsscParser(tokens, '<resolve>')
            ast = parser.parse()
            if ast and len(ast) > 0:
                node = ast[0]
                # expr_stmt wraps the actual expression
                if node.get('type') == 'expr_stmt':
                    return self._runtime._eval(node.get('expr', node))
                elif node.get('type') == 'expr_statement':
                    return self._runtime._eval(node.get('expr', node))
                return self._runtime._eval(node)
        except Exception:
            pass
        return value

    def addBuiltinFunction(self, *args, **kwargs):
        """Register a custom builtin function for CSSC."""
        # Resolve name: first positional string, or call=/name= kwarg
        name = kwargs.get('name') or kwargs.get('call')
        positional_rest = list(args)
        if not name:
            # First positional string arg is the name
            for i, a in enumerate(args):
                if isinstance(a, str):
                    name = a
                    positional_rest = list(args[:i]) + list(args[i+1:])
                    break
        else:
            positional_rest = list(args)
        param = kwargs.get('param')
        callback = kwargs.get('callback')
        # Remaining positional args: callable ones are callback, others are param
        for a in positional_rest:
            if callable(a) and callback is None:
                callback = a
            elif param is None and not callable(a):
                param = a
        stub = kwargs.get('stub')
        self._builtin_functions[name] = {
            'callback': callback,
            'params': param,
            'stub': stub,
        }

    def addHashOperation(self, call=None, behaviour='func', brackets='()', parameters=None, callback=None, **kwargs):
        """Register a custom # hash operation for CSSC."""
        if call:
            self._hash_operations[call] = {
                'behaviour': behaviour,
                'brackets': brackets,
                'parameters': parameters or [],
                'callback': callback,
            }

    def inject_into_runtime(self, runtime):
        """Inject registered custom builtins and hash ops into a CsscRuntime."""
        # Store runtime reference for isFunction/reslovefunc resolution
        self._runtime = runtime
        # Inject builtin functions (callable as funcname() directly in CSSC)
        for name, info in self._builtin_functions.items():
            cb = info.get('callback')
            if callable(cb):
                runtime._ns_builtins[name] = cb
            elif cb is not None:
                # cb might be a CSSL method reference — wrap it
                runtime._ns_builtins[name] = lambda *a, _cb=cb, **kw: _cb(*a, **kw) if callable(_cb) else _cb
        # Inject hash operations into runtime's custom directive handlers
        if not hasattr(runtime, '_custom_hash_ops'):
            runtime._custom_hash_ops = {}
        for call_name, info in self._hash_operations.items():
            # Strip leading # if present
            op_name = call_name.lstrip('#')
            runtime._custom_hash_ops[op_name] = info


def _load_cproject_mods(cproject: CsscCProject, script_dir: str) -> list:
    """Load CSSL mod files from a cproject and return list of CsscModExtension."""
    if not cproject or not cproject.prebuilds_enabled:
        return []
    extensions = []
    for mod_entry in cproject.buildmodules:
        mod_name = mod_entry.get('name', 'unnamed')
        mod_data = mod_entry.get('data', {})
        sources = mod_data.get('source', [])
        entry_func = mod_data.get('entry', 'run_extension')

        for src_path in sources:
            # Resolve relative paths from cproject dir
            if src_path.startswith('/'):
                full_path = os.path.join(cproject.dir, src_path.lstrip('/'))
            else:
                full_path = os.path.join(cproject.dir, src_path)
            full_path = os.path.abspath(full_path)

            if not os.path.isfile(full_path):
                print(f'CSSC CProject Warning: Mod source not found: {full_path}', file=sys.stderr)
                continue

            try:
                # Run the CSSL source file to get the extension
                from .cssl_runtime import CSSLRuntime
                with open(full_path, 'r', encoding='utf-8') as fh:
                    cssl_source = fh.read()

                runtime = CSSLRuntime()
                # Create CsscModExtension as the CSSCParser stub
                ext = CsscModExtension()

                # Make CSSCParser available in the CSSL scope
                runtime.scope.set('CSSCParser', ext)

                # Execute the CSSL source
                runtime.execute_program(cssl_source)

                # Call the entry function
                entry = runtime.scope.get(entry_func)
                if entry is not None and callable(entry):
                    result = entry()
                elif entry is not None:
                    # Function AST node — call via runtime
                    runtime._call_function(entry, [], {})

                # Collect the CsscModExtension that was actually populated.
                # include("cssl.cssc") reuses ext from scope if available,
                # but scan scope in case a different instance was used.
                collected = ext
                scope_vars = runtime.scope.variables if hasattr(runtime.scope, 'variables') else {}
                for var_name, val in scope_vars.items():
                    if isinstance(val, CsscModExtension) and (val._builtin_functions or val._hash_operations):
                        collected = val
                        break
                    if hasattr(val, 'CSSCParser') and isinstance(getattr(val, 'CSSCParser', None), CsscModExtension):
                        cparser = val.CSSCParser
                        if cparser._builtin_functions or cparser._hash_operations:
                            collected = cparser
                            break

                extensions.append(collected)
            except Exception as e:
                print(f'CSSC CProject Warning: Failed to load mod "{mod_name}" from {full_path}: {e}', file=sys.stderr)

    return extensions


# ---------------------------------------------------------------------------
# Runner
# ---------------------------------------------------------------------------
class CsscRunner:
    """Run .cssc script files."""

    def __init__(self, **kwargs):
        self._search_paths = kwargs.get('search_paths', [])
        self._verbose = kwargs.get('verbose', False)
        self._last_error = None
        self._last_output = None
        self._cproject = None  # Loaded cssc.cproject

    def run_file(self, path, **kwargs):
        path = os.path.abspath(path)
        if not os.path.isfile(path):
            self._last_error = f'File not found: {path}'
            return 1
        script_dir = os.path.dirname(path)
        # Load cssc.cproject from script directory
        self._cproject = CsscCProject.find_in_dir(script_dir)
        with open(path, 'r', encoding='utf-8') as fh:
            source = fh.read()
        return self.run_string(source, filename=path, script_dir=script_dir, **kwargs)

    def run_string(self, source, filename='<string>', **kwargs):
        self._last_error = None
        self._last_output = None
        try:
            script_dir = kwargs.get('script_dir', os.getcwd())
            cproject = self._cproject or CsscCProject.find_in_dir(script_dir)
            use_modules = '#include(' in source or (cproject and cproject.prebuilds_enabled)

            # C++ fast path: use native interpreter when no modules needed
            if _CSSC_ACCEL and _cssc_accel_mod and hasattr(_cssc_accel_mod, 'run_cssc') and not use_modules and not self._verbose:
                output = _cssc_accel_mod.run_cssc(source)
                self._last_output = output
                if output:
                    sys.stdout.write(output)
                return 0
            # Also try cssc_core module
            if not use_modules and not self._verbose:
                try:
                    _api_path = Path(__file__).parent / 'cpp' / 'build' / ('api.pyd' if sys.platform == 'win32' else 'api.so')
                    if _api_path.exists():
                        import importlib.util as _ilu2
                        if sys.platform == 'win32' and hasattr(os, 'add_dll_directory'):
                            os.add_dll_directory(str(_api_path.parent))
                        _spec2 = _ilu2.spec_from_file_location('api_cssc', str(_api_path))
                        if _spec2 and _spec2.loader:
                            _api2 = _ilu2.module_from_spec(_spec2)
                            _spec2.loader.exec_module(_api2)
                            if hasattr(_api2, 'cssc_core'):
                                output = _api2.cssc_core.run_cssc(source)
                                self._last_output = output
                                if output:
                                    sys.stdout.write(output)
                                return 0
                except Exception:
                    pass

            # Python fallback
            tokens = CsscLexer(source, filename).tokenize()
            if self._verbose:
                for tok in tokens:
                    print(f'  {tok}')
            ast = CsscParser(tokens, filename).parse()
            runtime = CsscRuntime(
                script_dir=script_dir,
                script_path=filename,
                search_paths=self._search_paths + kwargs.get('search_paths', []),
            )
            # Forward debug flag (set by `cssc run --debug`).
            runtime._debug_enabled = bool(getattr(self, '_debug_enabled', False))
            # Forward --no-console (degrades #console[…] windows to a
            # stderr-prefixed sink for headless / CI runs).
            runtime._no_console = bool(getattr(self, '_no_console', False))
            # Load cproject mods if available
            if cproject and cproject.prebuilds_enabled:
                mod_extensions = _load_cproject_mods(cproject, script_dir)
                for ext in mod_extensions:
                    if isinstance(ext, CsscModExtension):
                        ext.inject_into_runtime(runtime)
            exit_code = runtime.execute(ast)
            self._last_output = runtime.get_output()
            runtime.cleanup()
            return exit_code
        except CsscError as e:
            # Auto-fill the source file so every runtime error carries
            # `in <path>`, not just the line number. Re-format the exception
            # message with `script=filename` so the display shows both.
            if not getattr(e, 'script', ''):
                try:
                    e.script = filename
                    e.args = (f"CSSC {e.operation} Error"
                                 f"{f' in {filename}' if filename else ''}"
                                 f"{f' line {e.line}' if e.line else ''}"
                                 f": {e.detail}"
                                 f"{f'{chr(10)}  Hint: {e.hint}' if e.hint else ''}",)
                except Exception:
                    pass
            self._last_error = str(e)
            print(f'\x1b[1;31mcssc: fatal error:\x1b[0m {e}', file=sys.stderr)
            return 1
        except Exception as e:
            self._last_error = str(e)
            msg = str(e)
            if 'Traceback' in msg or '.py' in msg:
                msg = msg.split('\n')[-1] if '\n' in msg else msg
            file_prefix = f' in {filename}' if filename and filename != '<string>' else ''
            print(f'\x1b[1;31mcssc: fatal error:\x1b[0m{file_prefix}: {msg}',
                  file=sys.stderr)
            return 1

    def validate(self, source):
        errors = []
        try:
            tokens = CsscLexer(source).tokenize()
            CsscParser(tokens).parse()
        except CsscError as e:
            errors.append({'line': e.line, 'message': str(e)})
        except Exception as e:
            errors.append({'line': 0, 'message': str(e)})
        return errors

    @staticmethod
    def create_template(path, template='basic'):
        templates = {
            'basic': (
                '// CSSC Script v5.1\n'
                '#VARIABLE[string] message;\n'
                'message = "Hello from CSSC!";\n'
                'cssc::coutln(message);\n'
            ),
            'config': (
                '// CSSC Config Script\n'
                '#REQUIRE["config.ini"] cfg;\n'
                '#VARIABLE[string] name;\n'
                'cfg.get("app_name") name;\n'
                'if (name == null) {\n'
                '    cfg.set("app_name", "MyApp");\n'
                '    name = "MyApp";\n'
                '}\n'
                'cssc::coutln("App: " + name);\n'
            ),
            'module': (
                '// CSSC Module Script\n'
                '#include("cssc.paths") cps;\n'
                '#include("cssc.io") cio;\n'
                '#VARIABLE[string] config_path;\n'
                'cps::search_walk("config.ini") config_path;\n'
                'if (config_path != "") {\n'
                '    cio::read(config_path) content;\n'
                '    cssc::coutln(content);\n'
                '} else {\n'
                '    cssc::coutln("Config not found");\n'
                '}\n'
            ),
        }
        content = templates.get(template, templates['basic'])
        with open(path, 'w', encoding='utf-8') as fh:
            fh.write(content)

    def get_last_error(self):
        return self._last_error

    def get_last_output(self):
        return self._last_output

    def status(self):
        return {
            'search_paths': self._search_paths,
            'verbose': self._verbose,
            'last_error': self._last_error is not None,
        }


# ---------------------------------------------------------------------------
# File association
# ---------------------------------------------------------------------------
def register_cssc_file_association():
    """Register .cssc file association for double-click execution."""
    python_exe = sys.executable
    if sys.platform == 'win32':
        try:
            import winreg
            key = winreg.CreateKey(winreg.HKEY_CURRENT_USER, r'Software\Classes\.cssc')
            winreg.SetValue(key, '', winreg.REG_SZ, 'CSSCScript')
            winreg.CloseKey(key)
            key = winreg.CreateKey(winreg.HKEY_CURRENT_USER, r'Software\Classes\CSSCScript')
            winreg.SetValue(key, '', winreg.REG_SZ, 'CSSC Script File')
            winreg.CloseKey(key)
            key = winreg.CreateKey(winreg.HKEY_CURRENT_USER, r'Software\Classes\CSSCScript\DefaultIcon')
            winreg.SetValue(key, '', winreg.REG_SZ, f'{python_exe},0')
            winreg.CloseKey(key)
            cmd = f'"{python_exe}" -m includecpp cssc run "%1"'
            key = winreg.CreateKey(winreg.HKEY_CURRENT_USER, r'Software\Classes\CSSCScript\shell\open\command')
            winreg.SetValue(key, '', winreg.REG_SZ, cmd)
            winreg.CloseKey(key)
            return True
        except Exception:
            return False
    else:
        desktop_dir = Path.home() / '.local' / 'share' / 'applications'
        desktop_dir.mkdir(parents=True, exist_ok=True)
        desktop_content = (
            '[Desktop Entry]\nType=Application\nName=CSSC Script Runner\n'
            f'Exec={python_exe} -m includecpp cssc run %f\n'
            'MimeType=text/x-cssc;\nTerminal=true\nCategories=Development;\n'
        )
        (desktop_dir / 'cssc-runner.desktop').write_text(desktop_content)
        mime_dir = Path.home() / '.local' / 'share' / 'mime' / 'packages'
        mime_dir.mkdir(parents=True, exist_ok=True)
        (mime_dir / 'cssc.xml').write_text(
            '<?xml version="1.0" encoding="UTF-8"?>\n'
            '<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">\n'
            '  <mime-type type="text/x-cssc">\n'
            '    <comment>CSSC Script File</comment>\n'
            '    <glob pattern="*.cssc"/>\n'
            '  </mime-type>\n'
            '</mime-info>\n'
        )
        try:
            subprocess.run(['update-mime-database', str(Path.home() / '.local' / 'share' / 'mime')],
                           capture_output=True, timeout=10)
        except Exception:
            pass
        return True


