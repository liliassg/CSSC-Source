def _retrogadgets_completion_dict() -> dict:
    """LSP-completion entries for the retrogadgets gdt namespace.

    Mirrors the *real* Retro Gadgets API as documented at
    docs.retrogadgets.game — system chips, input/output modules, and
    singletons. Slot counts match the typical gadget configuration.
    """
    out: dict = {}

    # System chips — multi-slot 0..3
    for n in range(4):
        out[f'CPU{n}']               = f'gdt::CPU{n} — programmable Lua CPU (Source, Time, DeltaTime, EventChannels)'
        out[f'VideoChip{n}']         = f'gdt::VideoChip{n} — rasterizer (Mode, Width, Height, RenderBuffers, Clear, Draw*, Raster*, Render*)'
        out[f'AudioChip{n}']         = f'gdt::AudioChip{n} — sample player (ChannelsCount, Volume, Play, PlayLoop, Stop, Pause, GetSpectrumData)'
        out[f'FlashMemory{n}']       = f'gdt::FlashMemory{n} — persistent storage (Size, Usage, Save(table), Load())'
        out[f'GamepadChip{n}']       = f'gdt::GamepadChip{n} — gamepad input (GamepadIndex, IsActive, GetButton, GetAxis, GetButtonAxis)'
        out[f'KeyboardChip{n}']      = f'gdt::KeyboardChip{n} — keyboard input (GetButton, GetButtonAxis)'
        out[f'Wifi{n}']              = f'gdt::Wifi{n} — networking (WebGet, WebPost*, WebGetAudioStream, WebAbort, ClearCookieCache)'
        out[f'Serial{n}']            = f'gdt::Serial{n} — serial bus (Write*, Print, Println, GetAvailablePorts, BaudRate, Parity)'
        out[f'MagneticConnector{n}'] = f'gdt::MagneticConnector{n} — physical connector (ButtonState, IsConnected, AttachedConnector)'

    # Input modules — multi-slot 0..7
    for n in range(8):
        out[f'AnalogStick{n}']  = f'gdt::AnalogStick{n} — analog stick (X: -100..100, Y: -100..100, InputSourceX, InputSourceY)'
        out[f'DPad{n}']         = f'gdt::DPad{n} — directional pad (X, Y discrete -100/0/100, InputSourceX, InputSourceY)'
        out[f'Keypad{n}']       = f'gdt::Keypad{n} — button matrix (ButtonsState, ButtonsDown, ButtonsUp, ButtonsInputSource)'
        out[f'Knob{n}']         = f'gdt::Knob{n} — rotary input (Mode, Value, DeltaValue, IsMoving)'
        out[f'LedButton{n}']    = f'gdt::LedButton{n} — illuminated button (ButtonState, ButtonDown/Up, LedState, LedColor, InputSource)'
        out[f'ScreenButton{n}'] = f'gdt::ScreenButton{n} — screen-overlay button (ButtonState, VideoChip, Offset, Width, Height)'
        out[f'Slider{n}']       = f'gdt::Slider{n} — linear input (Value 0..100, IsMoving)'
        out[f'Switch{n}']       = f'gdt::Switch{n} — toggle switch (State, InputSource)'
        out[f'Webcam{n}']       = f'gdt::Webcam{n} — webcam input (RenderTarget, AccessDenied, IsActive, IsAvailable, GetRenderBuffer)'

    # Output modules — multi-slot 0..7
    for n in range(8):
        out[f'AnalogGauge{n}']    = f'gdt::AnalogGauge{n} — needle gauge (Value 0..100)'
        out[f'Lcd{n}']            = f'gdt::Lcd{n} — character LCD (Text, BgColor, TextColor)'
        out[f'Led{n}']            = f'gdt::Led{n} — single LED (State, Color)'
        out[f'LedMatrix{n}']      = f'gdt::LedMatrix{n} — LED matrix (States[col][row], Colors[col][row])'
        out[f'LedStrip{n}']       = f'gdt::LedStrip{n} — LED strip (States[i], Colors[i])'
        out[f'Screen{n}']         = f'gdt::Screen{n} — screen panel (VideoChip, Offset, Width, Height)'
        out[f'SegmentDisplay{n}'] = f'gdt::SegmentDisplay{n} — 7-segment (States, Colors, ShowDigit, SetDigitColor)'
        out[f'Speaker{n}']        = f'gdt::Speaker{n} — audio output (State)'

    # Singletons
    out['ROM']          = 'gdt::ROM — cartridge ROM (User.{Assets,SpriteSheets,Codes,AudioSamples}, System.*)'
    out['PowerButton']  = 'gdt::PowerButton — power toggle (ButtonState)'
    out['RealityChip']  = 'gdt::RealityChip — host system access (Cpu, Ram, Network, GetDateTime, LoadAudioSample, ListDirectory)'
    out['SecurityChip'] = 'gdt::SecurityChip — asset access permissions (no API yet)'

    # Convenience helpers (real Retro Gadgets exposes these as top-level
    # globals; we surface them under gdt:: too for namespace consistency)
    out['Color']     = 'gdt::Color — Color(r,g,b), ColorRGBA, ColorHSV + named constants (red, blue, white, …)'
    out['Vec']       = 'gdt::Vec — vec2(x,y), vec3(x,y,z) constructors'
    out['Multitool'] = 'gdt::Multitool — debug terminal (log, print, write, writeln, setFgColor, clear, …)'
    return out
