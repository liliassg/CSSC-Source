def _module_funcs_with_docs(mod):
    """Get {name: doc} dict from a module's namespace + docs."""
    ns = mod.get_namespace()
    docs = mod.get_docs() if hasattr(mod, 'get_docs') else {}
    return {name: docs.get(name, f'{mod._name}::{name}()') for name in ns}


