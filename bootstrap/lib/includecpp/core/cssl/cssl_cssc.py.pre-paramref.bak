# ---------------------------------------------------------------------------
# CSSC Builtin Modules (#include)
# ---------------------------------------------------------------------------
class CsscModule:
    """Base class for CSSC builtin modules."""
    _name = ''

    def get_namespace(self):
        return {}

    def get_docs(self):
        return {}


class CsscIterator:
    """C++ style iterator — wraps a container reference and current index."""
    __slots__ = ('_container', '_index', '_elem_type')

    def __init__(self, container, index=0, elem_type='auto'):
        self._container = container
        self._index = index
        self._elem_type = elem_type

    def deref(self):
        """*iter — read element at current position."""
        if self._index < 0 or self._index >= len(self._container):
            return None
        return self._container[self._index]

    def deref_set(self, value):
        """*iter = value — write element at current position."""
        if 0 <= self._index < len(self._container):
            self._container[self._index] = value

    def __add__(self, n):
        if isinstance(n, CsscIterator):
            return self._index + n._index
        return CsscIterator(self._container, self._index + int(n), self._elem_type)

    def __radd__(self, n):
        return CsscIterator(self._container, int(n) + self._index, self._elem_type)

    def __sub__(self, n):
        if isinstance(n, CsscIterator):
            return self._index - n._index
        return CsscIterator(self._container, self._index - int(n), self._elem_type)

    def __eq__(self, other):
        if isinstance(other, CsscIterator):
            return self._index == other._index
        return self._index == other

    def __ne__(self, other):
        return not self.__eq__(other)

    def __lt__(self, other):
        if isinstance(other, CsscIterator):
            return self._index < other._index
        return self._index < other

    def __gt__(self, other):
        if isinstance(other, CsscIterator):
            return self._index > other._index
        return self._index > other

    def __le__(self, other):
        return not self.__gt__(other)

    def __ge__(self, other):
        return not self.__lt__(other)

    def __repr__(self):
        return f'iterator@{self._index}'

    def __str__(self):
        return f'iterator@{self._index}'

    def __hash__(self):
        return hash(('CsscIterator', id(self._container), self._index))


class CsscSector(CsscModule):
    """Runtime representation of a CSSC sector (namespace with access control)."""

    def __init__(self, name, public_names, private_names, sector_vars,
                 free_body, runtime, alloc_stores=None):
        self._name = name
        self._public = set(public_names)
        self._private = set(private_names)
        self._vars = sector_vars          # dict: member_name → value
        self._free_body = free_body       # AST nodes or None
        self._runtime = runtime           # CsscRuntime ref for free execution
        self._alloc_stores = alloc_stores or {}  # member → (store_name, alloc_info)
        self._freed = False
        # Injected dependency aliases from `sector Name<dep1, dep2>`. Sector
        # isolation: a ns-call inside a sector body may only reach cssc::,
        # this sector, its own members, or one of these deps (set by
        # _exec_sector). Mirrors the native compiler's _SECTORS[...]['deps'].
        self._deps = set()

    def __getattr__(self, name):
        """Allow module.Sector.member access via Python attribute."""
        if name.startswith('_'):
            raise AttributeError(name)
        if name in self._public and name in self._vars:
            return self._vars[name]
        return None

    def get_namespace(self):
        """Return public members as {name: value/callable}."""
        return {n: self._vars[n] for n in self._public if n in self._vars}

    def get_member(self, member_name):
        """Return the actual value of a public member."""
        return self._vars.get(member_name)

    def get_member_address(self, member_name):
        """Return hex address of a member's memory buffer."""
        info = self._alloc_stores.get(member_name)
        if info:
            _sv, alloc = info
            buf = alloc.get('buffer')
            if buf is not None:
                return hex(ctypes.addressof(buf))
        # Fallback: Python object id
        val = self._vars.get(member_name)
        return hex(id(val)) if val is not None else '0x0'

    def is_public(self, name):
        return name in self._public

    def run_free(self):
        """Execute the free { } block."""
        if self._freed or not self._free_body:
            return
        self._freed = True
        # Strict check: #reallocate in free block must use Sector->Member syntax
        # #delete is exempt — free block runs in sector scope, bare names are fine
        sector_name = self._name
        for stmt in self._free_body:
            if isinstance(stmt, dict) and stmt.get('type') == 'directive':
                d = stmt.get('directive', '')
                if d == 'reallocate':
                    src = stmt.get('source_var', '')
                    if src and '->' not in src and src in self._vars:
                        raise CsscError(operation='Runtime',
                                        detail=f'#reallocate[{src}, ...] inside free block requires sector-qualified name',
                                        hint=f'Use: #reallocate[{sector_name}->{src}, ...]',
                                        line=stmt.get('line', 0))
        # Temporarily inject sector vars into runtime scope
        saved_vars = self._runtime._variables.copy()
        saved_types = self._runtime._variable_types.copy()
        self._runtime._variables = dict(self._vars)
        self._runtime._variable_types = {}
        self._runtime._building_sector = sector_name
        # Restore alloc stores so #delete works
        for vname, (sv, alloc) in self._alloc_stores.items():
            store = getattr(self._runtime, sv, None)
            if store is not None:
                store[vname] = alloc
        try:
            for stmt in self._free_body:
                self._runtime._exec_node(stmt)
        except Exception:
            pass
        finally:
            self._runtime._variables = saved_vars
            self._runtime._variable_types = saved_types
            self._runtime._building_sector = None


class CsscDllModule(CsscModule):
    """cssc.dll - Data Linking Library management.

    CSSC's own DLL system — JSON-based key-value data stores with
    optional locking and sections. Creates .dll files in the script's directory.
    NOT Windows/ctypes DLLs.

    Usage: #include("cssc.dll") cdll;
           cdll::createdll("mylib");
           cdll::link("mylib", "key", value);
           cdll::get("mylib", "key") result;
    """
    _name = 'cssc.dll'

    def __init__(self, script_dir=''):
        self._script_dir = script_dir or os.getcwd()
        self._cache = {}  # name -> dict (in-memory DLL data)

    def _dll_path(self, name):
        """Get the .dll file path in the script's directory."""
        n = str(name)
        if not n.endswith('.dll'):
            n += '.dll'
        return os.path.join(self._script_dir, n)

    def _load_dll(self, name):
        """Load a DLL from disk into cache."""
        n = str(name)
        if n in self._cache:
            return self._cache[n]
        path = self._dll_path(n)
        if os.path.exists(path):
            try:
                with open(path, 'r', encoding='utf-8') as f:
                    data = json.loads(f.read())
                self._cache[n] = data
                return data
            except Exception:
                return None
        return None

    def _save_dll(self, name):
        """Save a DLL from cache to disk."""
        n = str(name)
        if n not in self._cache:
            return
        path = self._dll_path(n)
        with open(path, 'w', encoding='utf-8') as f:
            f.write(json.dumps(self._cache[n], ensure_ascii=False, indent=2))

    def get_namespace(self):
        return {
            'createdll': self._createdll,
            'deletedll': self._deletedll,
            'hasdll': self._hasdll,
            'listdlls': self._listdlls,
            'dllinfo': self._dllinfo,
            'link': self._link,
            'get': self._get,
            'unlink': self._unlink,
            'islinked': self._islinked,
            'editlink': self._editlink,
            'getall': self._getall,
            'find': self._find,
            'createsection': self._createsection,
            'listsections': self._listsections,
            'listentries': self._listentries,
            'version': self._version,
        }

    def _createdll(self, name, locked=False):
        n = str(name)
        if self._load_dll(n) is not None:
            raise CsscError(operation='Runtime',
                            detail=f'DLL \'{n}\' already exists',
                            hint=f'Use hasdll("{n}") to check first, or deletedll("{n}") to recreate')
        self._cache[n] = {'_meta': {'locked': bool(locked)}, '_default': {}}
        self._save_dll(n)
        return f'{n}.dll'

    def _deletedll(self, name):
        n = str(name)
        self._cache.pop(n, None)
        path = self._dll_path(n)
        if os.path.exists(path):
            os.remove(path)
            return True
        return False

    def _hasdll(self, name):
        n = str(name)
        return n in self._cache or os.path.exists(self._dll_path(n))

    def _listdlls(self):
        result = []
        for f in os.listdir(self._script_dir):
            if f.endswith('.dll'):
                result.append(f[:-4])
        return result

    def _dllinfo(self, name):
        dll = self._load_dll(name)
        if not dll:
            return {}
        meta = dll.get('_meta', {})
        sections = [k for k in dll if not k.startswith('_')]
        return {'name': str(name), 'locked': meta.get('locked', False),
                'sections': sections, 'path': self._dll_path(name)}

    def _link(self, libname, key, data=None, section=None, **_kw):
        dll = self._load_dll(libname)
        if not dll:
            raise CsscError(operation='Runtime', detail=f'DLL \'{libname}\' not found')
        sec = str(section) if section else '_default'
        if sec not in dll:
            dll[sec] = {}
        # Serialize data for storage
        import base64, pickle
        dll[sec][str(key)] = base64.b64encode(pickle.dumps(data)).decode('ascii')
        self._save_dll(libname)
        return f'{libname}:{sec}:{key}'

    def _get(self, libname, key, section=None, **_kw):
        dll = self._load_dll(libname)
        if not dll:
            return None
        sec = str(section) if section else '_default'
        sect = dll.get(sec, {})
        raw = sect.get(str(key))
        if raw is None:
            return None
        import base64, pickle
        try:
            return pickle.loads(base64.b64decode(raw))
        except Exception:
            return raw

    def _unlink(self, libname, key, section=None, **_kw):
        dll = self._load_dll(libname)
        if not dll:
            return False
        sec = str(section) if section else '_default'
        sect = dll.get(sec, {})
        if str(key) in sect:
            del sect[str(key)]
            self._save_dll(libname)
            return True
        return False

    def _islinked(self, libname, key, section=None, **_kw):
        dll = self._load_dll(libname)
        if not dll:
            return False
        sec = str(section) if section else '_default'
        return str(key) in dll.get(sec, {})

    def _editlink(self, libname, key, data, section=None, **_kw):
        return self._link(libname, key, data, section=section)

    def _getall(self, libname, **_kw):
        dll = self._load_dll(libname)
        if not dll:
            return {}
        result = {}
        import base64, pickle
        for sec_name, sec_data in dll.items():
            if sec_name.startswith('_') and sec_name != '_default':
                continue
            if isinstance(sec_data, dict):
                for k, v in sec_data.items():
                    try:
                        result[k] = pickle.loads(base64.b64decode(v))
                    except Exception:
                        result[k] = v
        return result

    def _find(self, libname, key, section=None, **_kw):
        return self._get(libname, key, section=section)

    def _createsection(self, libname, section_name, **_kw):
        dll = self._load_dll(libname)
        if not dll:
            raise CsscError(operation='Runtime', detail=f'DLL \'{libname}\' not found')
        dll[str(section_name)] = {}
        self._save_dll(libname)
        return str(section_name)

    def _listsections(self, libname, **_kw):
        dll = self._load_dll(libname)
        if not dll:
            return []
        return [k for k in dll if not k.startswith('_')]

    def _listentries(self, libname, section=None, **_kw):
        dll = self._load_dll(libname)
        if not dll:
            return []
        sec = str(section) if section else '_default'
        return list(dll.get(sec, {}).keys())

    def _version(self):
        return '5.1.0'

    def get_docs(self):
        return {
            'createdll': 'cdll::createdll(name, locked?) — create a new Data Linking Library',
            'deletedll': 'cdll::deletedll(name) — delete a DLL',
            'hasdll': 'cdll::hasdll(name) — check if DLL exists',
            'listdlls': 'cdll::listdlls() — list all DLL names',
            'dllinfo': 'cdll::dllinfo(name) — get DLL metadata',
            'link': 'cdll::link(lib, key, value, section?, key?) — store a link entry',
            'get': 'cdll::get(lib, key, section?, key?) — retrieve a value',
            'unlink': 'cdll::unlink(lib, key, section?, key?) — remove a link',
            'islinked': 'cdll::islinked(lib, key) — check if entry exists',
            'editlink': 'cdll::editlink(lib, key, newvalue) — update existing link',
            'getall': 'cdll::getall(lib) — get all entries from DLL',
            'find': 'cdll::find(lib, key) — find entry in DLL, returns value or null',
            'createsection': 'cdll::createsection(lib, name) — create a section in DLL',
            'listsections': 'cdll::listsections(lib) — list sections in DLL',
            'listentries': 'cdll::listentries(lib, section?) — list entry keys',
            'version': 'cdll::version() — get module version',
        }


class CsscIniModule(CsscModule):
    """cssc.ini - INI/config file management."""
    _name = 'cssc.ini'

    def __init__(self, script_dir=''):
        self._script_dir = script_dir

    def _resolve(self, p):
        return os.path.join(self._script_dir, p) if not os.path.isabs(p) else p

    def get_namespace(self):
        return {
            'open': self.open_ini, 'create': self.create_ini, 'read': self.read_value,
            'write': self.write_value, 'delete': self.delete_key, 'has_key': self.has_key,
            'has_section': self.has_section, 'sections': self.get_sections, 'keys': self.get_keys,
            'values': self.get_values, 'all': self.get_all, 'save': self.save_handler,
            'merge': self.merge, 'diff': self.diff, 'copy': self.copy_ini,
            'backup': self.backup, 'restore': self.restore, 'validate': self.validate,
            'to_json': self.to_json, 'to_map': self.to_map, 'from_map': self.from_map,
            'add_section': self.add_section, 'remove_section': self.remove_section,
            'count_keys': self.count_keys, 'count_sections': self.count_sections,
            'exists': self.exists, 'size': self.file_size, 'search': self.search,
            'get_typed': self.get_typed, 'set_typed': self.set_typed,
            'get_list': self.get_list, 'set_list': self.set_list,
            'get_or_default': self.get_or_default, 'increment': self.increment,
            'toggle': self.toggle, 'clear_section': self.clear_section, 'clear_all': self.clear_all,
            'export': self.export_ini, 'rename_key': self.rename_key,
        }

    def open_ini(self, path):
        return CsscIniHandler(self._resolve(path))

    def create_ini(self, path):
        resolved = self._resolve(path)
        if not os.path.isfile(resolved):
            with open(resolved, 'w', encoding='utf-8') as f:
                f.write('')
        return CsscIniHandler(resolved)

    # ------------------------------------------------------------------
    # ini::read / write / has_key / delete are PARITY-CRITICAL: the native
    # runtime (cssc_ini.c) implements them with a hand-rolled parser that
    # is CASE-SENSITIVE, writes `key=value` (no spaces), tolerates
    # duplicate keys (first-match-wins on read), and preserves blank/
    # comment lines verbatim on write. Python's configparser lower-cases
    # keys (optionxform) and raises DuplicateOptionError on duplicates —
    # so a save written by one engine and read by the other diverged
    # (e.g. `isAlive` written case-sensitively by native but lower-cased
    # to `isalive` by the interpreter, accumulating BOTH keys in the file
    # and crashing configparser on the next read). Native is the canonical
    # low-level reference, so these four methods mirror cssc_ini.c exactly.
    # The remaining convenience methods (has_section/sections/merge/...)
    # have no native counterpart and stay configparser-backed.
    # ------------------------------------------------------------------
    @staticmethod
    def _ini_classify(raw_line):
        """Mirror cssc_ini.c line classification: drop a trailing CR, cut an
        inline comment at the first ';' or '#', then trim outer whitespace."""
        s = raw_line
        if s.endswith('\r'):
            s = s[:-1]
        for i, ch in enumerate(s):
            if ch == ';' or ch == '#':
                s = s[:i]
                break
        return s.strip()

    @staticmethod
    def _ini_is_section(trimmed, section):
        """Case-sensitive `[section]` match (cssc_ini.c ini_line_is_section)."""
        if not trimmed.startswith('['):
            return False
        end = trimmed.find(']')
        if end < 0:
            return False
        return trimmed[1:end] == section

    @staticmethod
    def _ini_key_of(trimmed):
        """The key of a `key = value` binding (cssc_ini.c ini_line_matches_key
        key extraction), or None if the line is not a binding. Case is kept."""
        if not trimmed or trimmed[0] in (';', '#', '['):
            return None
        eq = trimmed.find('=')
        if eq < 0:
            return None
        return trimmed[:eq].rstrip()

    @staticmethod
    def _ini_value_after_eq(trimmed):
        """Value after '=', leading spaces/tabs and trailing whitespace
        stripped (cssc_ini.c ini_value_after_eq + read-side trailing strip)."""
        eq = trimmed.find('=')
        if eq < 0:
            return ''
        return trimmed[eq + 1:].lstrip(' \t').rstrip()

    def _ini_load(self, path):
        try:
            with open(self._resolve(path), 'r', encoding='utf-8', newline='') as f:
                return f.read()
        except OSError:
            return None

    def read_value(self, path, section, key, default=''):
        data = self._ini_load(path)
        if data is None:
            return default
        in_section = False
        for raw in data.split('\n'):
            trimmed = self._ini_classify(raw)
            if trimmed.startswith('['):
                in_section = self._ini_is_section(trimmed, section)
            elif in_section and self._ini_key_of(trimmed) == key:
                return self._ini_value_after_eq(trimmed)
        return default

    def has_key(self, path, section, key):
        data = self._ini_load(path)
        if data is None:
            return 0
        in_section = False
        for raw in data.split('\n'):
            trimmed = self._ini_classify(raw)
            if trimmed.startswith('['):
                in_section = self._ini_is_section(trimmed, section)
            elif in_section and self._ini_key_of(trimmed) == key:
                return 1
        return 0

    def write_value(self, path, section, key, value):
        resolved = self._resolve(path)
        value = '' if value is None else str(value)
        data = self._ini_load(path)
        if data is None:
            data = ''
        parts = data.split('\n')
        n = len(parts)
        out = []
        in_target = False
        wrote_key = False
        saw_target = False
        for i, raw in enumerate(parts):
            had_nl = (i < n - 1)
            trimmed = self._ini_classify(raw)
            is_section = trimmed.startswith('[')
            is_key_match = (in_target and not is_section
                            and self._ini_key_of(trimmed) == key)
            if is_section:
                if in_target and not wrote_key:
                    out.append('%s=%s\n' % (key, value))
                    wrote_key = True
                in_target = self._ini_is_section(trimmed, section)
                if in_target:
                    saw_target = True
            if is_key_match:
                out.append('%s=%s' % (key, value))
                wrote_key = True
            else:
                out.append(raw)
            if had_nl:
                out.append('\n')
        out_str = ''.join(out)
        if not saw_target:
            lead = '\n' if (out_str and not out_str.endswith('\n')) else ''
            out_str += '%s[%s]\n%s=%s\n' % (lead, section, key, value)
        elif not wrote_key:
            lead = '\n' if (out_str and not out_str.endswith('\n')) else ''
            out_str += '%s%s=%s\n' % (lead, key, value)
        try:
            with open(resolved, 'w', encoding='utf-8', newline='') as f:
                f.write(out_str)
        except OSError:
            return 0
        return 1

    def delete_key(self, path, section, key):
        resolved = self._resolve(path)
        data = self._ini_load(path)
        if data is None:
            return 0
        parts = data.split('\n')
        n = len(parts)
        out = []
        in_section = False
        removed = False
        for i, raw in enumerate(parts):
            had_nl = (i < n - 1)
            trimmed = self._ini_classify(raw)
            if trimmed.startswith('['):
                in_section = self._ini_is_section(trimmed, section)
            elif in_section and self._ini_key_of(trimmed) == key:
                removed = True
                continue
            out.append(raw)
            if had_nl:
                out.append('\n')
        if removed:
            try:
                with open(resolved, 'w', encoding='utf-8', newline='') as f:
                    f.write(''.join(out))
            except OSError:
                return 0
        return 1 if removed else 0

    def has_section(self, path, section):
        return CsscIniHandler(self._resolve(path))._parser.has_section(section)

    def get_sections(self, path):
        return CsscIniHandler(self._resolve(path))._parser.sections()

    def get_keys(self, path, section=''):
        return CsscIniHandler(self._resolve(path)).keys(section)

    def get_values(self, path, section):
        h = CsscIniHandler(self._resolve(path))
        if h._parser.has_section(section):
            return [h._parser.get(section, k) for k in h._parser.options(section)]
        return []

    def get_all(self, path):
        return CsscIniHandler(self._resolve(path)).all()

    def save_handler(self, handler):
        if isinstance(handler, CsscIniHandler):
            handler.save()
            return True
        return False

    def merge(self, path1, path2, out):
        h1 = CsscIniHandler(self._resolve(path1))
        h2 = CsscIniHandler(self._resolve(path2))
        for sec in h2._parser.sections():
            if not h1._parser.has_section(sec):
                h1._parser.add_section(sec)
            for k, v in h2._parser.items(sec):
                h1._parser.set(sec, k, v)
        h1._path = self._resolve(out)
        h1.save()
        return True

    def diff(self, path1, path2):
        d1 = CsscIniHandler(self._resolve(path1)).all()
        d2 = CsscIniHandler(self._resolve(path2)).all()
        return {
            'added': {k: v for k, v in d2.items() if k not in d1},
            'removed': {k: v for k, v in d1.items() if k not in d2},
            'changed': {k: (d1[k], d2[k]) for k in d1 if k in d2 and d1[k] != d2[k]},
        }

    def copy_ini(self, src, dst):
        try:
            shutil.copy2(self._resolve(src), self._resolve(dst))
            return True
        except Exception:
            return False

    def backup(self, path):
        bak = self._resolve(path) + '.bak'
        try:
            shutil.copy2(self._resolve(path), bak)
            return bak
        except Exception:
            return ''

    def restore(self, path):
        bak = self._resolve(path) + '.bak'
        if os.path.isfile(bak):
            shutil.copy2(bak, self._resolve(path))
            return True
        return False

    def validate(self, path):
        try:
            cp = __import__('configparser').ConfigParser()
            cp.read(self._resolve(path), encoding='utf-8')
            return {'valid': True, 'sections': len(cp.sections())}
        except Exception as e:
            return {'valid': False, 'error': str(e)}

    def to_json(self, path):
        return json.dumps(CsscIniHandler(self._resolve(path)).all())

    def to_map(self, path):
        return CsscIniHandler(self._resolve(path)).all()

    def from_map(self, data, path):
        h = self.create_ini(path)
        for k, v in data.items():
            h.set(k, v)
        return True

    def add_section(self, path, section):
        h = CsscIniHandler(self._resolve(path))
        if not h._parser.has_section(section):
            h._parser.add_section(section)
            h.save()
            return True
        return False

    def remove_section(self, path, section):
        h = CsscIniHandler(self._resolve(path))
        if h._parser.remove_section(section):
            h.save()
            return True
        return False

    def count_keys(self, path):
        return len(CsscIniHandler(self._resolve(path)).all())

    def count_sections(self, path):
        return len(CsscIniHandler(self._resolve(path)).sections())

    def exists(self, path):
        return os.path.isfile(self._resolve(path))

    def file_size(self, path):
        r = self._resolve(path)
        return os.path.getsize(r) if os.path.isfile(r) else -1

    def search(self, path, pattern):
        d = CsscIniHandler(self._resolve(path)).all()
        return [k for k in d if pattern.lower() in k.lower()]

    def get_typed(self, path, section, key, type_name='string'):
        v = self.read_value(path, section, key)
        if type_name == 'int':
            try:
                return int(v)
            except Exception:
                return 0
        if type_name == 'float':
            try:
                return float(v)
            except Exception:
                return 0.0
        if type_name == 'bool':
            return v.lower() in ('true', '1', 'yes')
        return v

    def set_typed(self, path, section, key, value, type_name='string'):
        return self.write_value(path, section, key, str(value))

    def get_list(self, path, section, key, sep=','):
        v = self.read_value(path, section, key)
        return [x.strip() for x in v.split(sep)] if v else []

    def set_list(self, path, section, key, values, sep=','):
        return self.write_value(path, section, key, sep.join(str(x) for x in values))

    def get_or_default(self, path, section, key, default=''):
        return self.read_value(path, section, key, default)

    def increment(self, path, section, key, amount=1):
        v = self.get_typed(path, section, key, 'int') + amount
        self.write_value(path, section, key, str(v))
        return v

    def toggle(self, path, section, key):
        v = not self.get_typed(path, section, key, 'bool')
        self.write_value(path, section, key, str(v).lower())
        return v

    def clear_section(self, path, section):
        h = CsscIniHandler(self._resolve(path))
        if h._parser.has_section(section):
            for k in h._parser.options(section):
                h._parser.remove_option(section, k)
            h.save()
            return True
        return False

    def clear_all(self, path):
        h = CsscIniHandler(self._resolve(path))
        for s in h._parser.sections():
            h._parser.remove_section(s)
        h.save()
        return True

    def export_ini(self, path, fmt='json'):
        d = CsscIniHandler(self._resolve(path)).all()
        return json.dumps(d, indent=2) if fmt == 'json' else str(d)

    def rename_key(self, path, section, old, new):
        h = CsscIniHandler(self._resolve(path))
        if h._parser.has_option(section, old):
            val = h._parser.get(section, old)
            h._parser.remove_option(section, old)
            h._parser.set(section, new, val)
            h.save()
            return True
        return False


class CsscPathsModule(CsscModule):
    """cssc.paths - Path utilities and file search."""
    _name = 'cssc.paths'

    def __init__(self, script_dir=''):
        self._script_dir = script_dir

    def get_namespace(self):
        return {
            'resolve': self.resolve, 'join': self.join_path, 'dirname': self.dirname,
            'basename': self.basename, 'ext': self.ext, 'stem': self.stem,
            'exists': self.exists, 'is_file': self.is_file, 'is_dir': self.is_dir,
            'abs': self.abspath, 'rel': self.relpath, 'normalize': self.normalize,
            'search_walk': self.search_walk, 'search_glob': self.search_glob,
            'search_up': self.search_up, 'list': self.list_path, 'list_files': self.list_files,
            'list_dirs': self.list_dirs, 'list_recursive': self.list_recursive,
            'home': self.home, 'temp': self.temp, 'cwd': self.cwd,
            'script_dir': self.get_script_dir, 'appdata': self.appdata,
            'mkdir': self.mkdir, 'rmdir': self.rmdir, 'touch': self.touch,
            'size': self.size, 'modified': self.modified, 'created': self.created,
            'copy': self.copy, 'move': self.move, 'delete': self.delete,
            'rename': self.rename, 'parent': self.parent, 'parts': self.parts,
            'with_ext': self.with_ext, 'with_name': self.with_name,
            'common': self.common_path, 'is_absolute': self.is_absolute,
            'expand_user': self.expand_user, 'separator': self.separator,
            'glob_match': self.glob_match, 'walk': self.walk,
        }

    def resolve(self, p):
        if os.path.isabs(p):
            return p
        return os.path.abspath(os.path.join(self._script_dir, p))

    def join_path(self, *parts):
        return os.path.join(*[str(p) for p in parts])

    def dirname(self, p):
        return os.path.dirname(p)

    def basename(self, p):
        return os.path.basename(p)

    def ext(self, p):
        return os.path.splitext(p)[1]

    def stem(self, p):
        return os.path.splitext(os.path.basename(p))[0]

    def exists(self, p):
        return os.path.exists(self.resolve(p))

    def is_file(self, p):
        return os.path.isfile(self.resolve(p))

    def is_dir(self, p):
        return os.path.isdir(self.resolve(p))

    def abspath(self, p):
        return os.path.abspath(self.resolve(p))

    def relpath(self, p, base=None):
        return os.path.relpath(self.resolve(p), base or self._script_dir)

    def normalize(self, p):
        return os.path.normpath(p)

    def search_walk(self, filename, start_dir=None):
        """Walk directory tree to find a file by name. Returns absolute path."""
        start = start_dir or self._script_dir
        for root, dirs, files in os.walk(start):
            if filename in files:
                return os.path.join(root, filename)
        return ''

    def search_glob(self, pattern, start_dir=None):
        import glob
        start = start_dir or self._script_dir
        return glob.glob(os.path.join(start, '**', pattern), recursive=True)

    def search_up(self, filename, start_dir=None):
        """Search upward from start_dir for a file."""
        current = start_dir or self._script_dir
        while True:
            candidate = os.path.join(current, filename)
            if os.path.exists(candidate):
                return candidate
            parent = os.path.dirname(current)
            if parent == current:
                break
            current = parent
        return ''

    def list_path(self, p='.'):
        resolved = self.resolve(p)
        return os.listdir(resolved) if os.path.isdir(resolved) else []

    def list_files(self, p='.', ext=''):
        items = self.list_path(p)
        resolved = self.resolve(p)
        files = [f for f in items if os.path.isfile(os.path.join(resolved, f))]
        if ext:
            files = [f for f in files if f.endswith(ext)]
        return files

    def list_dirs(self, p='.'):
        items = self.list_path(p)
        resolved = self.resolve(p)
        return [d for d in items if os.path.isdir(os.path.join(resolved, d))]

    def list_recursive(self, p='.', ext=''):
        result = []
        for root, dirs, files in os.walk(self.resolve(p)):
            for f in files:
                if not ext or f.endswith(ext):
                    result.append(os.path.join(root, f))
        return result

    def home(self):
        return str(Path.home())

    def temp(self):
        import tempfile
        return tempfile.gettempdir()

    def cwd(self):
        return os.getcwd()

    def get_script_dir(self):
        return self._script_dir

    def appdata(self):
        return os.environ.get('APPDATA', os.path.join(str(Path.home()), '.config'))

    def mkdir(self, p):
        os.makedirs(self.resolve(p), exist_ok=True)
        return True

    def rmdir(self, p):
        resolved = self.resolve(p)
        if os.path.isdir(resolved):
            shutil.rmtree(resolved)
            return True
        return False

    def touch(self, p):
        resolved = self.resolve(p)
        Path(resolved).touch()
        return True

    def size(self, p):
        resolved = self.resolve(p)
        return os.path.getsize(resolved) if os.path.exists(resolved) else -1

    def modified(self, p):
        resolved = self.resolve(p)
        return os.path.getmtime(resolved) if os.path.exists(resolved) else 0

    def created(self, p):
        resolved = self.resolve(p)
        return os.path.getctime(resolved) if os.path.exists(resolved) else 0

    def copy(self, src, dst):
        try:
            shutil.copy2(self.resolve(src), self.resolve(dst))
            return True
        except Exception:
            return False

    def move(self, src, dst):
        try:
            shutil.move(self.resolve(src), self.resolve(dst))
            return True
        except Exception:
            return False

    def delete(self, p):
        resolved = self.resolve(p)
        if os.path.isfile(resolved):
            os.remove(resolved)
            return True
        return False

    def rename(self, old, new):
        try:
            os.rename(self.resolve(old), self.resolve(new))
            return True
        except Exception:
            return False

    def parent(self, p):
        return os.path.dirname(self.resolve(p))

    def parts(self, p):
        return list(Path(p).parts)

    def with_ext(self, p, ext):
        base = os.path.splitext(p)[0]
        return base + (ext if ext.startswith('.') else '.' + ext)

    def with_name(self, p, name):
        return os.path.join(os.path.dirname(p), name)

    def common_path(self, *paths):
        return os.path.commonpath([self.resolve(p) for p in paths])

    def is_absolute(self, p):
        return os.path.isabs(p)

    def expand_user(self, p):
        return os.path.expanduser(p)

    def separator(self):
        return os.sep

    def glob_match(self, pattern, path):
        import fnmatch
        return fnmatch.fnmatch(path, pattern)

    def walk(self, p='.'):
        result = []
        for root, dirs, files in os.walk(self.resolve(p)):
            result.append({'dir': root, 'subdirs': dirs, 'files': files})
        return result


class CsscEnvModule(CsscModule):
    """cssc.env - Environment variable management."""
    _name = 'cssc.env'

    def get_namespace(self):
        return {
            'get': self.get_env, 'set': self.set_env, 'has': self.has_env,
            'delete': self.delete_env, 'all': self.all_env, 'keys': self.keys_env,
            'expand': self.expand, 'path': self.get_path, 'add_path': self.add_path,
            'remove_path': self.remove_path, 'home': self.home, 'user': self.user,
            'temp': self.temp_dir, 'appdata': self.appdata, 'shell': self.shell,
            'hostname': self.hostname, 'os_name': self.os_name, 'arch': self.arch,
            'is_windows': self.is_windows, 'is_linux': self.is_linux, 'is_mac': self.is_mac,
            'python_version': self.python_version, 'python_path': self.python_path,
            'load_dotenv': self.load_dotenv, 'save_dotenv': self.save_dotenv,
            'search': self.search_env, 'prefix': self.prefix_env,
            'to_map': self.to_map, 'from_map': self.from_map,
            'backup': self.backup, 'restore': self.restore,
            'diff': self.diff_env, 'merge': self.merge_env,
            'count': self.count_env, 'clear_prefix': self.clear_prefix,
            'get_or_default': self.get_or_default,
            'get_int': self.get_int, 'get_bool': self.get_bool, 'get_list': self.get_list,
            'set_list': self.set_list,
        }

    def get_env(self, name, default=''):
        return os.environ.get(str(name), default)

    def set_env(self, name, value):
        os.environ[str(name)] = str(value)
        return True

    def has_env(self, name):
        return str(name) in os.environ

    def delete_env(self, name):
        if str(name) in os.environ:
            del os.environ[str(name)]
            return True
        return False

    def all_env(self):
        return dict(os.environ)

    def keys_env(self):
        return list(os.environ.keys())

    def expand(self, s):
        return os.path.expandvars(str(s))

    def get_path(self):
        return os.environ.get('PATH', '').split(os.pathsep)

    def add_path(self, p):
        os.environ['PATH'] = str(p) + os.pathsep + os.environ.get('PATH', '')
        return True

    def remove_path(self, p):
        paths = self.get_path()
        paths = [x for x in paths if x != str(p)]
        os.environ['PATH'] = os.pathsep.join(paths)
        return True

    def home(self):
        return str(Path.home())

    def user(self):
        return os.environ.get('USER', os.environ.get('USERNAME', ''))

    def temp_dir(self):
        import tempfile
        return tempfile.gettempdir()

    def appdata(self):
        return os.environ.get('APPDATA', os.path.join(str(Path.home()), '.config'))

    def shell(self):
        return os.environ.get('SHELL', os.environ.get('COMSPEC', ''))

    def hostname(self):
        return platform.node()

    def os_name(self):
        return platform.system()

    def arch(self):
        return platform.machine()

    def is_windows(self):
        return sys.platform == 'win32'

    def is_linux(self):
        return sys.platform == 'linux'

    def is_mac(self):
        return sys.platform == 'darwin'

    def python_version(self):
        return sys.version

    def python_path(self):
        return sys.executable

    def load_dotenv(self, path='.env'):
        if os.path.isfile(path):
            with open(path, 'r', encoding='utf-8') as fh:
                for line in fh:
                    line = line.strip()
                    if '=' in line and not line.startswith('#'):
                        k, v = line.split('=', 1)
                        os.environ[k.strip()] = v.strip().strip('"').strip("'")
            return True
        return False

    def save_dotenv(self, path='.env', keys=None):
        with open(path, 'w', encoding='utf-8') as fh:
            for k, v in sorted(os.environ.items()):
                if keys is None or k in keys:
                    fh.write(f'{k}={v}\n')
        return True

    def search_env(self, pattern):
        return {k: v for k, v in os.environ.items() if pattern.lower() in k.lower()}

    def prefix_env(self, prefix):
        return {k: v for k, v in os.environ.items() if k.startswith(prefix)}

    def to_map(self):
        return dict(os.environ)

    def from_map(self, data):
        for k, v in data.items():
            os.environ[str(k)] = str(v)
        return True

    def backup(self):
        return dict(os.environ)

    def restore(self, backup_data):
        os.environ.clear()
        os.environ.update(backup_data)
        return True

    def diff_env(self, other):
        current = dict(os.environ)
        return {
            'added': {k: v for k, v in other.items() if k not in current},
            'removed': {k: v for k, v in current.items() if k not in other},
            'changed': {k: (current[k], other[k]) for k in current if k in other and current[k] != other[k]},
        }

    def merge_env(self, data, overwrite=True):
        for k, v in data.items():
            if overwrite or k not in os.environ:
                os.environ[str(k)] = str(v)
        return True

    def count_env(self):
        return len(os.environ)

    def clear_prefix(self, prefix):
        keys = [k for k in os.environ if k.startswith(prefix)]
        for k in keys:
            del os.environ[k]
        return len(keys)

    def get_or_default(self, name, default=''):
        return os.environ.get(str(name), default)

    def get_int(self, name, default=0):
        try:
            return int(os.environ.get(str(name), default))
        except (ValueError, TypeError):
            return default

    def get_bool(self, name, default=False):
        v = os.environ.get(str(name), '')
        if not v:
            return default
        return v.lower() in ('true', '1', 'yes')

    def get_list(self, name, sep=','):
        v = os.environ.get(str(name), '')
        return [x.strip() for x in v.split(sep)] if v else []

    def set_list(self, name, values, sep=','):
        os.environ[str(name)] = sep.join(str(x) for x in values)
        return True


class CsscSysModule(CsscModule):
    """cssc.sys - System information and process management."""
    _name = 'cssc.sys'

    def get_namespace(self):
        return {
            'platform': self.get_platform, 'os': self.get_os, 'arch': self.get_arch,
            'hostname': self.get_hostname, 'user': self.get_user, 'pid': self.get_pid,
            'python_version': self.python_version, 'python_path': self.python_path,
            'argv': self.get_argv, 'argc': self.get_argc,
            'exec': self.exec_cmd, 'exec_async': self.exec_async,
            'exec_code': self.exec_code, 'exec_lines': self.exec_lines,
            'exit': self.sys_exit, 'sleep': self.sleep_ms,
            'time': self.get_time, 'timestamp': self.get_timestamp,
            'clock': self.get_clock, 'uptime': self.get_uptime,
            'cpu_count': self.cpu_count, 'memory': self.memory_info,
            'disk_usage': self.disk_usage, 'is_admin': self.is_admin,
            'locale': self.get_locale, 'encoding': self.get_encoding,
            'line_sep': self.line_sep, 'path_sep': self.path_sep,
            'max_int': self.max_int, 'float_info': self.float_info,
            'version': self.version, 'which': self.which,
            'kill': self.kill_process, 'processes': self.list_processes,
            'is_64bit': self.is_64bit, 'endianness': self.endianness,
            'temp_dir': self.temp_dir, 'beep': self.beep,
            'clipboard_get': self.clipboard_get, 'clipboard_set': self.clipboard_set,
            'open_url': self.open_url, 'open_file': self.open_file,
            'notify': self.notify,
        }

    def get_platform(self):
        return sys.platform

    def get_os(self):
        return platform.system()

    def get_arch(self):
        return platform.machine()

    def get_hostname(self):
        return platform.node()

    def get_user(self):
        return os.environ.get('USER', os.environ.get('USERNAME', ''))

    def get_pid(self):
        return os.getpid()

    def python_version(self):
        return f'{sys.version_info.major}.{sys.version_info.minor}.{sys.version_info.micro}'

    def python_path(self):
        return sys.executable

    def get_argv(self):
        return sys.argv[1:]

    def get_argc(self):
        return len(sys.argv) - 1

    def exec_cmd(self, command, timeout=30):
        try:
            result = subprocess.run(str(command), shell=True, capture_output=True, text=True, timeout=timeout)
            return {'stdout': result.stdout.strip(), 'stderr': result.stderr.strip(),
                    'code': result.returncode}
        except subprocess.TimeoutExpired:
            return {'stdout': '', 'stderr': 'Timeout', 'code': -1}
        except Exception as e:
            return {'stdout': '', 'stderr': str(e), 'code': -1}

    def exec_async(self, command):
        import threading
        result = {'done': False, 'stdout': '', 'stderr': '', 'code': -1}

        def _run():
            r = self.exec_cmd(command)
            result.update(r)
            result['done'] = True

        threading.Thread(target=_run, daemon=True).start()
        return result

    def exec_code(self, command):
        r = self.exec_cmd(command)
        return r.get('code', -1)

    def exec_lines(self, command):
        r = self.exec_cmd(command)
        return r.get('stdout', '').splitlines()

    def sys_exit(self, code=0):
        sys.exit(int(code))

    def sleep_ms(self, ms):
        time.sleep(float(ms) / 1000.0)

    def get_time(self):
        return time.time()

    def get_timestamp(self):
        return int(time.time())

    def get_clock(self):
        return time.perf_counter()

    def get_uptime(self):
        return time.perf_counter()

    def cpu_count(self):
        return os.cpu_count() or 1

    def memory_info(self):
        try:
            import psutil
            mem = psutil.virtual_memory()
            return {'total': mem.total, 'available': mem.available, 'percent': mem.percent}
        except ImportError:
            return {'total': 0, 'available': 0, 'percent': 0}

    def disk_usage(self, path='/'):
        try:
            usage = shutil.disk_usage(path)
            return {'total': usage.total, 'used': usage.used, 'free': usage.free}
        except Exception:
            return {'total': 0, 'used': 0, 'free': 0}

    def is_admin(self):
        try:
            return os.getuid() == 0
        except AttributeError:
            try:
                return ctypes.windll.shell32.IsUserAnAdmin() != 0
            except Exception:
                return False

    def get_locale(self):
        import locale
        return locale.getdefaultlocale()[0] or 'en_US'

    def get_encoding(self):
        return sys.getdefaultencoding()

    def line_sep(self):
        return os.linesep

    def path_sep(self):
        return os.pathsep

    def max_int(self):
        return sys.maxsize

    def float_info(self):
        return {'max': sys.float_info.max, 'min': sys.float_info.min, 'epsilon': sys.float_info.epsilon}

    def version(self):
        return '5.1.0'

    def which(self, name):
        return shutil.which(name) or ''

    def kill_process(self, pid):
        try:
            os.kill(int(pid), 9)
            return True
        except Exception:
            return False

    def list_processes(self):
        try:
            import psutil
            return [{'pid': p.pid, 'name': p.name()} for p in psutil.process_iter(['pid', 'name'])]
        except ImportError:
            return []

    def is_64bit(self):
        return sys.maxsize > 2 ** 32

    def endianness(self):
        return sys.byteorder

    def temp_dir(self):
        import tempfile
        return tempfile.gettempdir()

    def beep(self, freq=440, duration=200):
        if sys.platform == 'win32':
            try:
                import winsound
                winsound.Beep(int(freq), int(duration))
                return True
            except Exception:
                pass
        return False

    def clipboard_get(self):
        try:
            if sys.platform == 'win32':
                result = subprocess.run(['powershell', '-command', 'Get-Clipboard'],
                                        capture_output=True, text=True, timeout=5)
                return result.stdout.strip()
        except Exception:
            pass
        return ''

    def clipboard_set(self, text):
        try:
            if sys.platform == 'win32':
                subprocess.run(['powershell', '-command', f'Set-Clipboard -Value "{text}"'],
                               capture_output=True, timeout=5)
                return True
        except Exception:
            pass
        return False

    def open_url(self, url):
        import webbrowser
        webbrowser.open(str(url))
        return True

    def open_file(self, path):
        try:
            if sys.platform == 'win32':
                os.startfile(path)
            elif sys.platform == 'darwin':
                subprocess.run(['open', path])
            else:
                subprocess.run(['xdg-open', path])
            return True
        except Exception:
            return False

    def notify(self, title, message=''):
        try:
            if sys.platform == 'win32':
                from ctypes import windll
                windll.user32.MessageBoxW(0, str(message), str(title), 0)
                return True
        except Exception:
            pass
        return False


class CsscIoModule(CsscModule):
    """cssc.io - Advanced file I/O operations."""
    _name = 'cssc.io'

    def __init__(self, script_dir=''):
        self._script_dir = script_dir

    def _resolve(self, p):
        return os.path.join(self._script_dir, p) if not os.path.isabs(p) else p

    def get_namespace(self):
        return {
            'read': self.read_file, 'write': self.write_file, 'append': self.append_file,
            'read_lines': self.read_lines, 'write_lines': self.write_lines,
            'read_bytes': self.read_bytes, 'write_bytes': self.write_bytes,
            'read_json': self.read_json, 'write_json': self.write_json,
            'read_csv': self.read_csv, 'write_csv': self.write_csv,
            'exists': self.exists, 'size': self.size, 'delete': self.delete,
            'copy': self.copy, 'move': self.move, 'rename': self.rename,
            'touch': self.touch, 'truncate': self.truncate,
            'head': self.head, 'tail': self.tail, 'grep': self.grep,
            'count_lines': self.count_lines, 'count_words': self.count_words,
            'count_chars': self.count_chars, 'md5': self.md5, 'sha256': self.sha256,
            'is_binary': self.is_binary, 'encoding': self.detect_encoding,
            'mime_type': self.mime_type, 'modified': self.modified,
            'created': self.created, 'permissions': self.permissions,
            'temp_file': self.temp_file, 'temp_dir': self.temp_dir_create,
            'watch': self.watch_file, 'diff': self.diff_files,
            'merge_files': self.merge_files, 'split_file': self.split_file,
            'compress': self.compress, 'decompress': self.decompress,
            'base64_encode': self.b64_encode_file, 'base64_decode': self.b64_decode_file,
        }

    def read_file(self, path, encoding='utf-8'):
        resolved = self._resolve(path)
        if os.path.isfile(resolved):
            with open(resolved, 'r', encoding=encoding) as fh:
                return fh.read()
        return ''

    def write_file(self, path, content, encoding='utf-8'):
        with open(self._resolve(path), 'w', encoding=encoding) as fh:
            fh.write(str(content))
        return True

    def append_file(self, path, content, encoding='utf-8'):
        with open(self._resolve(path), 'a', encoding=encoding) as fh:
            fh.write(str(content))
        return True

    def read_lines(self, path, encoding='utf-8'):
        resolved = self._resolve(path)
        if os.path.isfile(resolved):
            with open(resolved, 'r', encoding=encoding) as fh:
                return fh.readlines()
        return []

    def write_lines(self, path, lines, encoding='utf-8'):
        with open(self._resolve(path), 'w', encoding=encoding) as fh:
            fh.writelines(str(l) + '\n' for l in lines)
        return True

    def read_bytes(self, path):
        resolved = self._resolve(path)
        if os.path.isfile(resolved):
            with open(resolved, 'rb') as fh:
                return fh.read()
        return b''

    def write_bytes(self, path, data):
        with open(self._resolve(path), 'wb') as fh:
            fh.write(data if isinstance(data, bytes) else str(data).encode())
        return True

    def read_json(self, path):
        resolved = self._resolve(path)
        if os.path.isfile(resolved):
            with open(resolved, 'r', encoding='utf-8') as fh:
                return json.load(fh)
        return None

    def write_json(self, path, data, indent=2):
        with open(self._resolve(path), 'w', encoding='utf-8') as fh:
            json.dump(data, fh, indent=indent)
        return True

    def read_csv(self, path, delimiter=','):
        import csv
        resolved = self._resolve(path)
        if os.path.isfile(resolved):
            with open(resolved, 'r', encoding='utf-8', newline='') as fh:
                return list(csv.reader(fh, delimiter=delimiter))
        return []

    def write_csv(self, path, rows, delimiter=','):
        import csv
        with open(self._resolve(path), 'w', encoding='utf-8', newline='') as fh:
            writer = csv.writer(fh, delimiter=delimiter)
            writer.writerows(rows)
        return True

    def exists(self, path):
        return os.path.exists(self._resolve(path))

    def size(self, path):
        resolved = self._resolve(path)
        return os.path.getsize(resolved) if os.path.exists(resolved) else -1

    def delete(self, path):
        resolved = self._resolve(path)
        if os.path.isfile(resolved):
            os.remove(resolved)
            return True
        return False

    def copy(self, src, dst):
        try:
            shutil.copy2(self._resolve(src), self._resolve(dst))
            return True
        except Exception:
            return False

    def move(self, src, dst):
        try:
            shutil.move(self._resolve(src), self._resolve(dst))
            return True
        except Exception:
            return False

    def rename(self, old, new):
        try:
            os.rename(self._resolve(old), self._resolve(new))
            return True
        except Exception:
            return False

    def touch(self, path):
        Path(self._resolve(path)).touch()
        return True

    def truncate(self, path, size=0):
        with open(self._resolve(path), 'r+') as fh:
            fh.truncate(size)
        return True

    def head(self, path, n=10):
        lines = self.read_lines(path)
        return lines[:n]

    def tail(self, path, n=10):
        lines = self.read_lines(path)
        return lines[-n:]

    def grep(self, path, pattern):
        lines = self.read_lines(path)
        return [l.rstrip('\n') for l in lines if pattern in l]

    def count_lines(self, path):
        return len(self.read_lines(path))

    def count_words(self, path):
        content = self.read_file(path)
        return len(content.split())

    def count_chars(self, path):
        return len(self.read_file(path))

    def md5(self, path):
        resolved = self._resolve(path)
        if os.path.isfile(resolved):
            return hashlib.md5(open(resolved, 'rb').read()).hexdigest()
        return ''

    def sha256(self, path):
        resolved = self._resolve(path)
        if os.path.isfile(resolved):
            return hashlib.sha256(open(resolved, 'rb').read()).hexdigest()
        return ''

    def is_binary(self, path):
        resolved = self._resolve(path)
        if os.path.isfile(resolved):
            with open(resolved, 'rb') as fh:
                chunk = fh.read(1024)
                return b'\x00' in chunk
        return False

    def detect_encoding(self, path):
        return 'utf-8'  # simplified

    def mime_type(self, path):
        import mimetypes
        t, _ = mimetypes.guess_type(path)
        return t or 'application/octet-stream'

    def modified(self, path):
        resolved = self._resolve(path)
        return os.path.getmtime(resolved) if os.path.exists(resolved) else 0

    def created(self, path):
        resolved = self._resolve(path)
        return os.path.getctime(resolved) if os.path.exists(resolved) else 0

    def permissions(self, path):
        resolved = self._resolve(path)
        if os.path.exists(resolved):
            return oct(os.stat(resolved).st_mode)[-3:]
        return ''

    def temp_file(self, prefix='cssc_', suffix='.tmp'):
        import tempfile
        fd, path = tempfile.mkstemp(prefix=prefix, suffix=suffix)
        os.close(fd)
        return path

    def temp_dir_create(self, prefix='cssc_'):
        import tempfile
        return tempfile.mkdtemp(prefix=prefix)

    def watch_file(self, path, interval=1.0):
        """Returns current mtime — caller polls to detect changes."""
        resolved = self._resolve(path)
        return os.path.getmtime(resolved) if os.path.exists(resolved) else 0

    def diff_files(self, path1, path2):
        import difflib
        lines1 = self.read_lines(path1)
        lines2 = self.read_lines(path2)
        diff = difflib.unified_diff(lines1, lines2, fromfile=path1, tofile=path2)
        return list(diff)

    def merge_files(self, paths, output):
        content = ''
        for p in paths:
            content += self.read_file(p)
        self.write_file(output, content)
        return True

    def split_file(self, path, chunk_size=1024):
        content = self.read_bytes(path)
        chunks = []
        for i in range(0, len(content), chunk_size):
            chunk_path = f'{path}.{i // chunk_size}'
            self.write_bytes(chunk_path, content[i:i + chunk_size])
            chunks.append(chunk_path)
        return chunks

    def compress(self, path, output=''):
        import gzip
        resolved = self._resolve(path)
        out = self._resolve(output or path + '.gz')
        with open(resolved, 'rb') as f_in:
            with gzip.open(out, 'wb') as f_out:
                f_out.writelines(f_in)
        return out

    def decompress(self, path, output=''):
        import gzip
        resolved = self._resolve(path)
        out = self._resolve(output or path.replace('.gz', ''))
        with gzip.open(resolved, 'rb') as f_in:
            with open(out, 'wb') as f_out:
                f_out.writelines(f_in)
        return out

    def b64_encode_file(self, path):
        import base64
        data = self.read_bytes(path)
        return base64.b64encode(data).decode() if data else ''

    def b64_decode_file(self, data, path):
        import base64
        self.write_bytes(path, base64.b64decode(data))
        return True


class CsscFastIfModule(CsscModule):
    """cssc.fastif - One-line conditional expressions (ternary-style).

    Provides inline if/else without multiline blocks.
    Usage: cf::if(when_true, when_false, condition)
    """
    _name = 'cssc.fastif'

    def get_namespace(self):
        return {
            # Core ternary
            'if': self._if,
            'unless': self._unless,
            'either': self._either,
            'coalesce': self._coalesce,
            'fallback': self._fallback,

            # Boolean helpers
            'all': self._all,
            'any': self._any,
            'none': self._none,

            # Comparison shortcuts
            'eq': self._eq,
            'ne': self._ne,
            'gt': self._gt,
            'lt': self._lt,
            'ge': self._ge,
            'le': self._le,

            # Guard / assertion
            'guard': self._guard,
            'assert': self._assert,
            'require': self._require,

            # Value mapping
            'map_value': self._map_value,
            'clamp': self._clamp,
            'in_range': self._in_range,
            'between': self._between,

            # Null / default
            'default': self._default,
            'is_null': self._is_null,
            'is_not_null': self._is_not_null,
            'null_or': self._null_or,

            # Type check shortcuts
            'is_string': self._is_string,
            'is_int': self._is_int,
            'is_float': self._is_float,
            'is_bool': self._is_bool,
            'is_array': self._is_array,
            'is_map': self._is_map,
            'is_number': self._is_number,

            # Logic combinators
            'and_then': self._and_then,
            'or_else': self._or_else,
            'xor': self._xor,
            'nand': self._nand,
            'nor': self._nor,
            'implies': self._implies,

            # Switch/case
            'switch': self._switch,
            'match': self._match,
        }

    def get_docs(self):
        return {
            'if': 'cf::if(when_true, when_false, condition) — inline ternary: returns when_true if condition is truthy, else when_false',
            'unless': 'cf::unless(value, condition) — returns value only if condition is falsy, else null',
            'either': 'cf::either(a, b) — returns a if truthy, else b',
            'coalesce': 'cf::coalesce(a, b, ...) — returns first non-null argument',
            'fallback': 'cf::fallback(value, fallback_value) — returns value if not null, else fallback_value',
            'all': 'cf::all(a, b, ...) — returns true if all arguments are truthy',
            'any': 'cf::any(a, b, ...) — returns true if any argument is truthy',
            'none': 'cf::none(a, b, ...) — returns true if no argument is truthy',
            'eq': 'cf::eq(a, b) — returns true if a == b',
            'ne': 'cf::ne(a, b) — returns true if a != b',
            'gt': 'cf::gt(a, b) — returns true if a > b',
            'lt': 'cf::lt(a, b) — returns true if a < b',
            'ge': 'cf::ge(a, b) — returns true if a >= b',
            'le': 'cf::le(a, b) — returns true if a <= b',
            'guard': 'cf::guard(condition, error_msg) — raises error if condition is falsy',
            'assert': 'cf::assert(condition, msg) — raises error if condition is falsy',
            'require': 'cf::require(value, msg) — raises error if value is null',
            'map_value': 'cf::map_value(key, map) — returns map[key] or null',
            'clamp': 'cf::clamp(value, min, max) — clamps value between min and max',
            'in_range': 'cf::in_range(value, min, max) — returns true if min <= value <= max',
            'between': 'cf::between(value, low, high) — returns true if low < value < high',
            'default': 'cf::default(value, default_val) — returns value if not null, else default_val',
            'is_null': 'cf::is_null(value) — returns true if value is null',
            'is_not_null': 'cf::is_not_null(value) — returns true if value is not null',
            'null_or': 'cf::null_or(value, replacement) — returns replacement if value is null',
            'is_string': 'cf::is_string(value) — returns true if value is a string',
            'is_int': 'cf::is_int(value) — returns true if value is an integer',
            'is_float': 'cf::is_float(value) — returns true if value is a float',
            'is_bool': 'cf::is_bool(value) — returns true if value is a boolean',
            'is_array': 'cf::is_array(value) — returns true if value is an array/list',
            'is_map': 'cf::is_map(value) — returns true if value is a map/dict',
            'is_number': 'cf::is_number(value) — returns true if value is int or float',
            'and_then': 'cf::and_then(condition, value) — returns value if condition is truthy, else null',
            'or_else': 'cf::or_else(condition, value) — returns value if condition is falsy, else null',
            'xor': 'cf::xor(a, b) — returns true if exactly one is truthy',
            'nand': 'cf::nand(a, b) — returns true if not both are truthy',
            'nor': 'cf::nor(a, b) — returns true if neither is truthy',
            'implies': 'cf::implies(a, b) — logical implication: !a || b',
            'switch': 'cf::switch(value, case1, result1, case2, result2, ..., default) — returns result for matching case',
            'match': 'cf::match(value, pattern_map) — returns pattern_map[value] if key exists, else null',
        }

    # -- Core ternary --
    def _if(self, when_true, when_false, condition):
        return when_true if condition else when_false

    def _unless(self, value, condition):
        return value if not condition else None

    def _either(self, a, b):
        return a if a else b

    def _coalesce(self, *args):
        for a in args:
            if a is not None:
                return a
        return None

    def _fallback(self, value, fallback_value):
        return value if value is not None else fallback_value

    # -- Boolean helpers --
    def _all(self, *args):
        return all(bool(a) for a in args)

    def _any(self, *args):
        return any(bool(a) for a in args)

    def _none(self, *args):
        return not any(bool(a) for a in args)

    # -- Comparison --
    def _eq(self, a, b):
        return a == b

    def _ne(self, a, b):
        return a != b

    def _gt(self, a, b):
        return a > b

    def _lt(self, a, b):
        return a < b

    def _ge(self, a, b):
        return a >= b

    def _le(self, a, b):
        return a <= b

    # -- Guard --
    def _guard(self, condition, error_msg='Guard failed'):
        if not condition:
            raise CsscError(operation='fastif::guard', detail=str(error_msg))
        return True

    def _assert(self, condition, msg='Assertion failed'):
        if not condition:
            raise CsscError(operation='fastif::assert', detail=str(msg))
        return True

    def _require(self, value, msg='Required value is null'):
        if value is None:
            raise CsscError(operation='fastif::require', detail=str(msg))
        return value

    # -- Value mapping --
    def _map_value(self, key, mapping):
        if isinstance(mapping, dict):
            return mapping.get(key)
        return None

    def _clamp(self, value, min_val, max_val):
        return max(min_val, min(max_val, value))

    def _in_range(self, value, min_val, max_val):
        return min_val <= value <= max_val

    def _between(self, value, low, high):
        return low < value < high

    # -- Null / default --
    def _default(self, value, default_val):
        return value if value is not None else default_val

    def _is_null(self, value):
        return value is None

    def _is_not_null(self, value):
        return value is not None

    def _null_or(self, value, replacement):
        return replacement if value is None else value

    # -- Type checks --
    def _is_string(self, value):
        return isinstance(value, str)

    def _is_int(self, value):
        return isinstance(value, int) and not isinstance(value, bool)

    def _is_float(self, value):
        return isinstance(value, float)

    def _is_bool(self, value):
        return isinstance(value, bool)

    def _is_array(self, value):
        return isinstance(value, list)

    def _is_map(self, value):
        return isinstance(value, dict)

    def _is_number(self, value):
        return isinstance(value, (int, float)) and not isinstance(value, bool)

    # -- Logic combinators --
    def _and_then(self, condition, value):
        return value if condition else None

    def _or_else(self, condition, value):
        return value if not condition else None

    def _xor(self, a, b):
        return bool(a) != bool(b)

    def _nand(self, a, b):
        return not (bool(a) and bool(b))

    def _nor(self, a, b):
        return not (bool(a) or bool(b))

    def _implies(self, a, b):
        return (not bool(a)) or bool(b)

    # -- Switch/case --
    def _switch(self, value, *args):
        # args = case1, result1, case2, result2, ..., [default]
        i = 0
        while i + 1 < len(args):
            if args[i] == value:
                return args[i + 1]
            i += 2
        # Odd number = last arg is default
        if len(args) % 2 == 1:
            return args[-1]
        return None

    def _match(self, value, pattern_map):
        if isinstance(pattern_map, dict):
            return pattern_map.get(value)
        return None


class CsscPeekModule(CsscModule):
    """cssc.peek - Look-ahead / look-around utilities for collections.

    Peek into arrays/lists without modifying them. Useful for
    scanning, windowing, and conditional iteration patterns.
    Usage: pk::peek(collection, index)
    """
    _name = 'cssc.peek'

    def get_namespace(self):
        return {
            # Core peek
            'peek': self._peek,
            'cpeek': self._cpeek,
            'peek_safe': self._peek_safe,
            'peek_next': self._peek_next,
            'peek_prev': self._peek_prev,
            'peek_first': self._peek_first,
            'peek_last': self._peek_last,
            'peek_at': self._peek_at,

            # Range / window
            'peek_range': self._peek_range,
            'peek_window': self._peek_window,
            'peek_around': self._peek_around,
            'peek_ahead': self._peek_ahead,
            'peek_behind': self._peek_behind,

            # Search / find
            'find': self._find,
            'find_index': self._find_index,
            'find_last': self._find_last,
            'find_last_index': self._find_last_index,
            'contains': self._contains,
            'count': self._count,
            'count_where': self._count_where,

            # Boundary checks
            'has_next': self._has_next,
            'has_prev': self._has_prev,
            'is_first': self._is_first,
            'is_last': self._is_last,
            'is_empty': self._is_empty,
            'is_valid_index': self._is_valid_index,
            'bounds_check': self._bounds_check,

            # Comparison
            'equals_next': self._equals_next,
            'equals_prev': self._equals_prev,
            'matches_pattern': self._matches_pattern,

            # Aggregate peek
            'min': self._min,
            'max': self._max,
            'sum': self._sum,
            'avg': self._avg,

            # Slice / extract
            'take': self._take,
            'take_last': self._take_last,
            'skip': self._skip,
            'skip_last': self._skip_last,
            'every_nth': self._every_nth,

            # Pair / zip
            'pairs': self._pairs,
            'zip': self._zip,
            'enumerate': self._enumerate,
        }

    def get_docs(self):
        return {
            'peek': 'pk::peek(collection, currentindex, peekamount) — peek ahead/behind by offset. Returns single element at index+amount, or null if out of bounds',
            'cpeek': 'pk::cpeek(collection, pos, range) — peek a range of elements. Returns array (auto-managed). Positive range = forward, negative = backward',
            'peek_safe': 'pk::peek_safe(collection, index, default) — get element or default if out of bounds',
            'peek_next': 'pk::peek_next(collection, current_index) — get element at current_index + 1',
            'peek_prev': 'pk::peek_prev(collection, current_index) — get element at current_index - 1',
            'peek_first': 'pk::peek_first(collection) — get first element',
            'peek_last': 'pk::peek_last(collection) — get last element',
            'peek_at': 'pk::peek_at(collection, index) — alias for peek, returns null if invalid',
            'peek_range': 'pk::peek_range(collection, start, end) — get sublist from start to end (exclusive)',
            'peek_window': 'pk::peek_window(collection, index, size) — get window of size elements centered at index',
            'peek_around': 'pk::peek_around(collection, index, radius) — get elements within radius of index',
            'peek_ahead': 'pk::peek_ahead(collection, index, count) — get next count elements after index',
            'peek_behind': 'pk::peek_behind(collection, index, count) — get previous count elements before index',
            'find': 'pk::find(collection, value) — find first occurrence, return element or null',
            'find_index': 'pk::find_index(collection, value) — find first index of value, -1 if not found',
            'find_last': 'pk::find_last(collection, value) — find last occurrence, return element or null',
            'find_last_index': 'pk::find_last_index(collection, value) — find last index, -1 if not found',
            'contains': 'pk::contains(collection, value) — returns true if value is in collection',
            'count': 'pk::count(collection, value) — count occurrences of value',
            'count_where': 'pk::count_where(collection, target_value) — count elements equal to target_value',
            'has_next': 'pk::has_next(collection, index) — returns true if index + 1 is valid',
            'has_prev': 'pk::has_prev(collection, index) — returns true if index - 1 is valid',
            'is_first': 'pk::is_first(collection, index) — returns true if index == 0',
            'is_last': 'pk::is_last(collection, index) — returns true if index == len - 1',
            'is_empty': 'pk::is_empty(collection) — returns true if collection is empty',
            'is_valid_index': 'pk::is_valid_index(collection, index) — returns true if index is within bounds',
            'bounds_check': 'pk::bounds_check(collection, index) — returns clamped index within valid range',
            'equals_next': 'pk::equals_next(collection, index) — returns true if element at index equals next element',
            'equals_prev': 'pk::equals_prev(collection, index) — returns true if element at index equals previous element',
            'matches_pattern': 'pk::matches_pattern(collection, pattern_list) — returns true if start of collection matches pattern',
            'min': 'pk::min(collection) — returns minimum value',
            'max': 'pk::max(collection) — returns maximum value',
            'sum': 'pk::sum(collection) — returns sum of all numeric elements',
            'avg': 'pk::avg(collection) — returns average of all numeric elements',
            'take': 'pk::take(collection, n) — returns first n elements',
            'take_last': 'pk::take_last(collection, n) — returns last n elements',
            'skip': 'pk::skip(collection, n) — returns all elements after first n',
            'skip_last': 'pk::skip_last(collection, n) — returns all elements except last n',
            'every_nth': 'pk::every_nth(collection, n) — returns every nth element',
            'pairs': 'pk::pairs(collection) — returns list of adjacent pairs [[0,1],[1,2],...]',
            'zip': 'pk::zip(collection1, collection2) — returns list of paired elements [[a0,b0],[a1,b1],...]',
            'enumerate': 'pk::enumerate(collection) — returns list of [index, element] pairs',
        }

    # -- Core peek --
    def _peek(self, collection, index, amount=0):
        """pk::peek(collection, currentindex, peekamount) — peek ahead/behind by offset.

        amount is an offset: positive = forward, negative = backward.
        pk::peek(vec, 3, 2)  = vec[3 + 2] = vec[5]  (peek 2 ahead)
        pk::peek(vec, 3, -1) = vec[3 - 1] = vec[2]  (peek 1 behind)
        pk::peek(vec, 3, 0)  = vec[3]                (peek at current)
        Always returns a single element, or null if out of bounds.
        """
        idx = int(index)
        amount = int(amount)
        if not isinstance(collection, (list, tuple, str)):
            return None
        target = idx + amount
        return collection[target] if 0 <= target < len(collection) else None

    def _cpeek(self, collection, index, range_amount):
        """pk::cpeek(collection, pos, range) — peek a range of elements, returns array (auto-managed).

        pk::cpeek(vec, 3, 5) = vec[3:8]  (5 elements starting at index 3)
        pk::cpeek(vec, 3, -2) = vec[1:3] (2 elements before index 3)
        """
        idx = int(index)
        amount = int(range_amount)
        if not isinstance(collection, (list, tuple, str)):
            return []
        if amount >= 0:
            return list(collection[idx:idx + amount]) if idx < len(collection) else []
        else:
            start = max(0, idx + amount)
            return list(collection[start:idx]) if idx <= len(collection) else []

    def _peek_safe(self, collection, index, default=None):
        idx = int(index)
        if isinstance(collection, (list, tuple, str)):
            return collection[idx] if 0 <= idx < len(collection) else default
        return default

    def _peek_next(self, collection, current_index):
        return self._peek(collection, int(current_index) + 1)

    def _peek_prev(self, collection, current_index):
        return self._peek(collection, int(current_index) - 1)

    def _peek_first(self, collection):
        return self._peek(collection, 0)

    def _peek_last(self, collection):
        if isinstance(collection, (list, tuple, str)) and len(collection) > 0:
            return collection[-1]
        return None

    def _peek_at(self, collection, index):
        return self._peek(collection, index)

    # -- Range / window --
    def _peek_range(self, collection, start, end):
        if isinstance(collection, (list, tuple, str)):
            return list(collection[int(start):int(end)])
        return []

    def _peek_window(self, collection, index, size):
        idx = int(index)
        sz = int(size)
        half = sz // 2
        start = max(0, idx - half)
        end = min(len(collection), start + sz)
        if isinstance(collection, (list, tuple)):
            return list(collection[start:end])
        return []

    def _peek_around(self, collection, index, radius):
        idx = int(index)
        r = int(radius)
        if isinstance(collection, (list, tuple)):
            start = max(0, idx - r)
            end = min(len(collection), idx + r + 1)
            return list(collection[start:end])
        return []

    def _peek_ahead(self, collection, index, count):
        idx = int(index)
        if isinstance(collection, (list, tuple)):
            return list(collection[idx + 1:idx + 1 + int(count)])
        return []

    def _peek_behind(self, collection, index, count):
        idx = int(index)
        if isinstance(collection, (list, tuple)):
            start = max(0, idx - int(count))
            return list(collection[start:idx])
        return []

    # -- Search / find --
    def _find(self, collection, value):
        if isinstance(collection, (list, tuple)):
            for item in collection:
                if item == value:
                    return item
        return None

    def _find_index(self, collection, value):
        if isinstance(collection, (list, tuple)):
            for i, item in enumerate(collection):
                if item == value:
                    return i
        return -1

    def _find_last(self, collection, value):
        if isinstance(collection, (list, tuple)):
            for item in reversed(collection):
                if item == value:
                    return item
        return None

    def _find_last_index(self, collection, value):
        if isinstance(collection, (list, tuple)):
            for i in range(len(collection) - 1, -1, -1):
                if collection[i] == value:
                    return i
        return -1

    def _contains(self, collection, value):
        if isinstance(collection, (list, tuple, str)):
            return value in collection
        return False

    def _count(self, collection, value):
        if isinstance(collection, (list, tuple)):
            return sum(1 for item in collection if item == value)
        return 0

    def _count_where(self, collection, target_value):
        return self._count(collection, target_value)

    # -- Boundary checks --
    def _has_next(self, collection, index):
        if isinstance(collection, (list, tuple)):
            return int(index) + 1 < len(collection)
        return False

    def _has_prev(self, collection, index):
        return int(index) - 1 >= 0

    def _is_first(self, collection, index):
        return int(index) == 0

    def _is_last(self, collection, index):
        if isinstance(collection, (list, tuple)):
            return int(index) == len(collection) - 1
        return False

    def _is_empty(self, collection):
        if isinstance(collection, (list, tuple, str, dict)):
            return len(collection) == 0
        return True

    def _is_valid_index(self, collection, index):
        if isinstance(collection, (list, tuple, str)):
            return 0 <= int(index) < len(collection)
        return False

    def _bounds_check(self, collection, index):
        if isinstance(collection, (list, tuple)):
            return max(0, min(int(index), len(collection) - 1))
        return 0

    # -- Comparison --
    def _equals_next(self, collection, index):
        idx = int(index)
        if isinstance(collection, (list, tuple)) and idx + 1 < len(collection):
            return collection[idx] == collection[idx + 1]
        return False

    def _equals_prev(self, collection, index):
        idx = int(index)
        if isinstance(collection, (list, tuple)) and idx - 1 >= 0:
            return collection[idx] == collection[idx - 1]
        return False

    def _matches_pattern(self, collection, pattern_list):
        if not isinstance(collection, (list, tuple)) or not isinstance(pattern_list, (list, tuple)):
            return False
        if len(pattern_list) > len(collection):
            return False
        for i, p in enumerate(pattern_list):
            if p is not None and collection[i] != p:
                return False
        return True

    # -- Aggregate --
    def _min(self, collection):
        if isinstance(collection, (list, tuple)) and collection:
            nums = [x for x in collection if isinstance(x, (int, float))]
            return min(nums) if nums else None
        return None

    def _max(self, collection):
        if isinstance(collection, (list, tuple)) and collection:
            nums = [x for x in collection if isinstance(x, (int, float))]
            return max(nums) if nums else None
        return None

    def _sum(self, collection):
        if isinstance(collection, (list, tuple)):
            return sum(x for x in collection if isinstance(x, (int, float)))
        return 0

    def _avg(self, collection):
        if isinstance(collection, (list, tuple)):
            nums = [x for x in collection if isinstance(x, (int, float))]
            return sum(nums) / len(nums) if nums else 0
        return 0

    # -- Slice / extract --
    def _take(self, collection, n):
        if isinstance(collection, (list, tuple)):
            return list(collection[:int(n)])
        return []

    def _take_last(self, collection, n):
        if isinstance(collection, (list, tuple)):
            return list(collection[-int(n):]) if n else []
        return []

    def _skip(self, collection, n):
        if isinstance(collection, (list, tuple)):
            return list(collection[int(n):])
        return []

    def _skip_last(self, collection, n):
        if isinstance(collection, (list, tuple)):
            return list(collection[:-int(n)]) if n else list(collection)
        return []

    def _every_nth(self, collection, n):
        if isinstance(collection, (list, tuple)):
            step = max(1, int(n))
            return list(collection[::step])
        return []

    # -- Pair / zip --
    def _pairs(self, collection):
        if isinstance(collection, (list, tuple)) and len(collection) >= 2:
            return [[collection[i], collection[i + 1]] for i in range(len(collection) - 1)]
        return []

    def _zip(self, collection1, collection2):
        if isinstance(collection1, (list, tuple)) and isinstance(collection2, (list, tuple)):
            return [[a, b] for a, b in zip(collection1, collection2)]
        return []

    def _enumerate(self, collection):
        if isinstance(collection, (list, tuple)):
            return [[i, v] for i, v in enumerate(collection)]
        return []



class CsscMathModule(CsscModule):
    """cssc.math — Advanced mathematics module.

    Extended math functions beyond cssc:: builtins: constants, trig,
    hyperbolic, logarithmic, combinatorics, conversions, and more.
    Usage: #include("cssc.math") math;
    """
    _name = 'cssc.math'

    def get_namespace(self):
        return {
            # Constants
            'pi': lambda: math.pi,
            'e': lambda: math.e,
            'tau': lambda: math.tau,
            'inf': lambda: math.inf,
            'nan': lambda: math.nan,
            # Basic
            'abs': lambda x: abs(x),
            'ceil': lambda x: math.ceil(x),
            'floor': lambda x: math.floor(x),
            'round': lambda x, n=0: round(x, int(n)),
            'trunc': lambda x: math.trunc(x),
            'sign': lambda x: (1 if x > 0 else (-1 if x < 0 else 0)),
            'clamp': lambda x, lo, hi: max(lo, min(x, hi)),
            'min': lambda *args: min(args) if len(args) > 1 else min(args[0]) if args else 0,
            'max': lambda *args: max(args) if len(args) > 1 else max(args[0]) if args else 0,
            # Powers & roots
            'pow': lambda x, y: math.pow(x, y),
            'sqrt': lambda x: math.sqrt(x),
            'cbrt': lambda x: x ** (1.0 / 3.0),
            'hypot': lambda x, y: math.hypot(x, y),
            'exp': lambda x: math.exp(x),
            'exp2': lambda x: 2.0 ** x,
            # Logarithmic
            'log': lambda x: math.log(x),
            'log2': lambda x: math.log2(x),
            'log10': lambda x: math.log10(x),
            'log_base': lambda x, b: math.log(x, b),
            # Trigonometric
            'sin': lambda x: math.sin(x),
            'cos': lambda x: math.cos(x),
            'tan': lambda x: math.tan(x),
            'asin': lambda x: math.asin(x),
            'acos': lambda x: math.acos(x),
            'atan': lambda x: math.atan(x),
            'atan2': lambda y, x: math.atan2(y, x),
            # Hyperbolic
            'sinh': lambda x: math.sinh(x),
            'cosh': lambda x: math.cosh(x),
            'tanh': lambda x: math.tanh(x),
            'asinh': lambda x: math.asinh(x),
            'acosh': lambda x: math.acosh(x),
            'atanh': lambda x: math.atanh(x),
            # Angle conversion
            'deg': lambda r: math.degrees(r),
            'rad': lambda d: math.radians(d),
            # Combinatorics
            'factorial': lambda n: math.factorial(int(n)),
            'gcd': lambda a, b: math.gcd(int(a), int(b)),
            'lcm': lambda a, b: abs(int(a) * int(b)) // math.gcd(int(a), int(b)) if int(a) and int(b) else 0,
            'perm': lambda n, k=None: math.perm(int(n), int(k) if k is not None else None),
            'comb': lambda n, k: math.comb(int(n), int(k)),
            'fib': self._fibonacci,
            # Modular arithmetic
            'mod': lambda a, b: a % b,
            'divmod': lambda a, b: list(divmod(a, b)),
            'is_even': lambda x: int(x) % 2 == 0,
            'is_odd': lambda x: int(x) % 2 != 0,
            'is_prime': self._is_prime,
            # Rounding & precision
            'fmod': lambda x, y: math.fmod(x, y),
            'remainder': lambda x, y: math.remainder(x, y),
            'copysign': lambda x, y: math.copysign(x, y),
            'is_finite': lambda x: math.isfinite(x),
            'is_inf': lambda x: math.isinf(x),
            'is_nan': lambda x: math.isnan(x),
            # Bit operations
            'bit_length': lambda x: int(x).bit_length(),
            'bit_count': lambda x: bin(int(x)).count('1'),
            # Conversion
            'to_int': lambda x: int(x),
            'to_float': lambda x: float(x),
            'to_hex': lambda x: hex(int(x)),
            'to_bin': lambda x: bin(int(x)),
            'to_oct': lambda x: oct(int(x)),
            'from_hex': lambda s: int(s, 16),
            'from_bin': lambda s: int(s, 2),
            'from_oct': lambda s: int(s, 8),
            # Statistics
            'sum': lambda arr: sum(arr),
            'avg': lambda arr: sum(arr) / len(arr) if arr else 0,
            'median': self._median,
            'variance': self._variance,
            'stddev': self._stddev,
            # Vector math
            'dot': lambda a, b: sum(x * y for x, y in zip(a, b)),
            'cross': lambda a, b: [a[1]*b[2]-a[2]*b[1], a[2]*b[0]-a[0]*b[2], a[0]*b[1]-a[1]*b[0]],
            'magnitude': lambda v: math.sqrt(sum(x*x for x in v)),
            'normalize': self._normalize,
            'distance': lambda a, b: math.sqrt(sum((x-y)**2 for x, y in zip(a, b))),
            # Interpolation
            'lerp': lambda a, b, t: a + (b - a) * t,
            'map_range': lambda v, a1, a2, b1, b2: b1 + (v - a1) * (b2 - b1) / (a2 - a1),
        }

    def _fibonacci(self, n):
        n = int(n)
        if n <= 0: return 0
        if n == 1: return 1
        a, b = 0, 1
        for _ in range(2, n + 1):
            a, b = b, a + b
        return b

    def _is_prime(self, n):
        n = int(n)
        if n < 2: return False
        if n < 4: return True
        if n % 2 == 0 or n % 3 == 0: return False
        i = 5
        while i * i <= n:
            if n % i == 0 or n % (i + 2) == 0: return False
            i += 6
        return True

    def _median(self, arr):
        s = sorted(arr)
        n = len(s)
        if n == 0: return 0
        if n % 2 == 1: return s[n // 2]
        return (s[n // 2 - 1] + s[n // 2]) / 2

    def _variance(self, arr):
        if not arr: return 0
        m = sum(arr) / len(arr)
        return sum((x - m) ** 2 for x in arr) / len(arr)

    def _stddev(self, arr):
        return math.sqrt(self._variance(arr))

    def _normalize(self, v):
        m = math.sqrt(sum(x*x for x in v))
        return [x / m for x in v] if m != 0 else v

    def get_docs(self):
        return {
            'pi': 'math::pi() — Pi constant (3.14159...)',
            'e': 'math::e() — Euler number (2.71828...)',
            'tau': 'math::tau() — Tau constant (2*pi = 6.28318...)',
            'inf': 'math::inf() — Positive infinity',
            'nan': 'math::nan() — Not a Number',
            'abs': 'math::abs(x) — Absolute value',
            'ceil': 'math::ceil(x) — Round up to integer',
            'floor': 'math::floor(x) — Round down to integer',
            'round': 'math::round(x, n) — Round to n decimal places',
            'trunc': 'math::trunc(x) — Truncate to integer',
            'sign': 'math::sign(x) — Sign of x: -1, 0, or 1',
            'clamp': 'math::clamp(x, lo, hi) — Clamp x between lo and hi',
            'min': 'math::min(a, b, ...) — Minimum value',
            'max': 'math::max(a, b, ...) — Maximum value',
