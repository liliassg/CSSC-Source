"""CSSC AST → CIR lowering.

Phase 1 surface:
  - `#stack[<type>, <bits>] name = <expr>;` for int/string
  - `#heap[<type>, <bits>] name = <expr>;` (same as stack in Phase 1 — no heap yet)
  - `#auto[<type>] name = <expr>;` (same as stack in Phase 1)
  - `#delete[name];`
  - `cssc::outln(<expr>);` for int and string
  - Expressions: integer literal, bool literal, string literal, identifier
  - Top-level only (no functions / branches / loops yet — those land in
    Phase 2 with their own CIR ops).

Anything unsupported raises CsscError with a clear "v6 Phase X" tag so
the user knows which phase will add support.
"""
from __future__ import annotations

from typing import Any, Dict, List, Optional, Tuple

# CsscError is exposed by cssl_cssc.py — import lazily inside functions to
# avoid a circular import at module load.

from .builder import CIRBuilder
from .types import (
    CIRType, INT64, FLOAT32, FLOAT64, BOOL, PTR, STRING_PTR, CSSCVAL, VOID,
)


SUPPORTED_OUTLN_KINDS = frozenset({'int', 'string', 'bool', 'float'})
SUPPORTED_SLOT_TYPES  = frozenset({'int', 'string', 'bool', 'float',
                                    'vector_int', 'vector_float',
                                    'vector_bool',   # Phase A.1
                                    'vector_string', # Phase A.2
                                    'array_int',  'array_float',
                                    'array_bool',    # Phase A.3
                                    'array_string',   # Phase 5b: caro.cssc support
                                    'map_si',
                                    'map_ss', 'map_is', 'map_ii',
                                    'map_sf', 'map_if',
                                    'bind_ss',
                                    'bind_entry',   # heterogeneous (k1,v1,k2,v2,…) record
                                    'array_bind'})

# Tag values for heterogeneous bind cells. The same numbering is used by
# the host (x86_64), Xtensa, and AVR runtimes when interpreting a bind
# entry's per-cell tag byte.
_BIND_TAG_VOID   = 0
_BIND_TAG_INT    = 1
_BIND_TAG_FLOAT  = 2
_BIND_TAG_STRING = 3
_BIND_TAG_BOOL   = 4
_BIND_TAG_PTR    = 5

# `array<T>` shares `vector<T>`'s runtime AND its mutable surface — the
# two differ only nominally. Per the CSSC design decision (2026-07,
# aligning native with the interpreter and the documented `array<float>
# values; values.push(...)` form), arrays accept push/pop/clear/set and
# indexed writes exactly like vectors; there are no immutable container
# kinds in v6 native.

# Per-slot-kind traits for typed-container lowering.
# Keyed by internal slot kind ('vector_int' / 'vector_float' / ...).
# Each entry: dict with
#   'elem'     — the CIRType of an element (INT64, FLOAT64, ...)
#   'rt'       — the runtime-symbol suffix ('int' / 'float')
#   'expected' — the CSSC element-kind name for lower_expr's `expected_kind`
_VECTOR_TRAITS = None  # filled in below; see _vector_traits()


def _normalise_slot_type(raw: str) -> str:
    """Map a parser-level type string to the internal kind name.

    Generic forms collapse to flat kind identifiers; this table grows as
    each parametrised container type lands.
    """
    raw = raw.strip().replace(' ', '')
    if raw == 'vector<int>':
        return 'vector_int'
    if raw == 'vector<float>':
        return 'vector_float'
    if raw == 'vector<bool>':
        # Phase A.1: 1-byte storage per element, ABI passes i1 (LLVM)
        # which lowers to a single-byte store on every backend.
        return 'vector_bool'
    if raw == 'vector<string>':
        # Phase A.2: parallel to array<string>, but mutable. Each element
        # is a heap-allocated cssc_str* with refcount-cascade on push /
        # pop / overwrite / clear / free. Runtime helpers under
        # cssc_vector_*_string share the array_string ptr-table layout.
        return 'vector_string'
    if raw == 'array<int>':
        return 'array_int'
    if raw == 'array<float>':
        return 'array_float'
    if raw == 'array<bool>':
        # Bool table — storage mirrors vector_bool (1 byte per element)
        # and shares its full mutable method surface.
        return 'array_bool'
    if raw == 'array<auto>':
        # Polymorphic-int array literal slot. `array<auto>` appears in
        # label params (`label<array<auto>: data>:`) where the caller
        # is expected to pass a literal like `{0, 1, 0, 1}`. We collapse
        # to `array_int` because that's the only literal shape the
        # current parser produces from `{N, N, N}` initialisers without
        # an explicit type annotation. If a user genuinely needs a
        # heterogeneous element type, `array<bind>` is the proper
        # vehicle — its elements carry per-cell type tags.
        return 'array_int'
    if raw == 'vector<auto>':
        # Symmetric to array<auto> — `vector<auto>` collapses to
        # vector<int>. Mutable variant; same rationale on element shape.
        return 'vector_int'
    if raw == 'array<string>':
        # Phase 5b: array of cssc_str* — each entry is a refcount-managed
        # heap pointer. Indexing returns a borrowed ptr (no retain);
        # `select` iteration walks the table; `#delmember[arr[i]]`
        # cssc_releases the element and nulls the slot.
        return 'array_string'
    if raw == 'map<string,int>':
        return 'map_si'
    if raw == 'map<string,string>':
        return 'map_ss'
    if raw == 'map<int,string>':
        return 'map_is'
    if raw == 'map<int,int>':
        return 'map_ii'
    if raw == 'map<string,float>':
        return 'map_sf'
    if raw == 'map<int,float>':
        return 'map_if'
    # Single-parameter / auto maps. A one-arg `map<T>` is read as the
    # homogeneous `map<T, T>` (key type == value type), mirroring how a
    # bare `map<int>` reads as int→int; `map<auto>` / `map<auto,auto>`
    # collapse to the int→int default just like array<auto>→array_int.
    # `map<int>` in particular is a common `cssc::typeof(...)` sentinel.
    if raw in ('map<int>', 'map<auto>', 'map<auto,auto>'):
        return 'map_ii'
    if raw == 'map<string>':
        return 'map_ss'
    if raw == 'bind':
        # A standalone `bind` slot is a heterogeneous record — a flat
        # cell-list of (k_1, v_1, k_2, v_2, …) with each cell carrying
        # its own type tag. Stored as a `ptr` to a single
        # `cssc_bind_entry` (the same struct array<bind> uses for its
        # rows). Heterogeneous types per pair are the whole point;
        # `bind<string, string>` keeps the legacy bind_ss behaviour for
        # back-compat with code that wants the string-keyed pair list.
        return 'bind_entry'
    if raw == 'bind<string,string>':
        # Explicit string-string bind: classic bind_ss pair-list,
        # multiple entries, key+value both heap-allocated cssc_str*.
        return 'bind_ss'
    if raw.startswith('bind<') and raw.endswith('>'):
        # Any other parametrised bind (`bind<int>`, `bind<float>`,
        # `bind<auto>`, `bind<int,int>`, …) is a heterogeneous cell-record
        # — the element type parameter is informational (each cell carries
        # its own 1-byte type tag at runtime), so it collapses to the same
        # `bind_entry` a bare `bind` uses. Only `bind<string,string>`
        # (handled above) keeps the dedicated bind_ss pair-list.
        return 'bind_entry'
    if raw == 'array<bind>':
        # Heterogeneous tuple-array: each entry is an N-cell record where
        # each cell carries a 1-byte type tag and an 8-byte value (string
        # cells store a cssc_str* pointer; numeric cells store the raw
        # bits). Entry-arity N is per-entry, so different push_backs can
        # carry different shapes.
        return 'array_bind'
    # `array<map<K, V>>` — list of small key→value records. The native
    # backend implements this on top of `array_bind` because both have
    # identical layout (per-entry: tag + value cells, owned by the
    # outer list). The user-facing distinction is purely semantic:
    # `bind` is "tuple-of-cells", `map<K, V>` is "keyed pair". The
    # CIR-side runtime helpers (cssc_array_bind_*) work the same way
    # for both shapes — push_back of a `{k, v}` literal produces a
    # 2-cell entry where cell 0 is the key and cell 1 is the value.
    if raw.startswith('array<map<') and raw.endswith('>>'):
        return 'array_bind'
    # `array<bind<…>>` — same story; the inner bind type parameters
    # are dropped because array_bind already supports heterogeneous
    # cells at runtime.
    if raw.startswith('array<bind<') and raw.endswith('>>'):
        return 'array_bind'
    return raw


# Slot kind → cssc::typeof(...) string, byte-identical to the interpreter's
# `_b_typeof`. Containers erase to a bare `ptr` at the CIR level, so typeof
# must fold from the slot kind, not the CIR type.
_KIND_TYPEOF_STR = {
    'int': 'int', 'bool': 'bool', 'float': 'float', 'string': 'string',
    'vector_int': 'vector', 'vector_float': 'vector',
    'vector_bool': 'vector', 'vector_string': 'vector',
    'array_int': 'array', 'array_float': 'array',
    'array_bool': 'array', 'array_string': 'array', 'array_bind': 'array',
    'map_ii': 'map', 'map_if': 'map', 'map_is': 'map',
    'map_si': 'map', 'map_sf': 'map', 'map_ss': 'map',
    'bind_entry': 'bind', 'bind_ss': 'bind',
}


def _bind_declared_elem(raw_vtype: str) -> Optional[str]:
    """For a *typed* bind (`bind<int>`, `bind<float>`, `bind<bool>`,
    `bind<string>`) return the element kind every cell must match. CSSC is
    type-strict: `bind<int>` holds only ints. `bind<auto>` and bare
    `bind` are the deterministic escape hatch — heterogeneous cells
    allowed — so they return None (no per-cell constraint). The pair form
    `bind<string,string>` (→ bind_ss) is a keyed pair-list, not a
    homogeneous cell record, so it also returns None here."""
    r = raw_vtype.strip().replace(' ', '')
    if not (r.startswith('bind<') and r.endswith('>')):
        return None
    inner = r[5:-1]
    if inner in ('', 'auto') or ',' in inner:
        return None
    return {'int': 'int', 'float': 'float',
            'bool': 'bool', 'string': 'string'}.get(inner)


def _vector_traits(slot_kind: str) -> dict:
    """Return the traits dict for a vector-typed slot kind.

    Built lazily to avoid a circular dependency between this module and
    the CIRType singletons at import time. Includes the immutable
    `array_*` variants which share the runtime + storage of their
    mutable `vector_*` counterparts.
    """
    global _VECTOR_TRAITS
    if _VECTOR_TRAITS is None:
        _VECTOR_TRAITS = {
            'vector_int':   {'elem': INT64,   'rt': 'int',   'expected': 'int'},
            'vector_float': {'elem': FLOAT64, 'rt': 'float', 'expected': 'float'},
            # Phase A.1: bool elements stored 1 byte per slot. The CIR
            # element type is BOOL (i1) — LLVM/clang/Xtensa all serialise
            # i1 as a single byte to memory. Runtime helpers live under
            # cssc_vector_*_bool and mirror the numeric vector pattern.
            'vector_bool':  {'elem': BOOL,    'rt': 'bool',  'expected': 'bool'},
            # Phase A.2: parallel to array_string but mutable.
            'vector_string':{'elem': STRING_PTR, 'rt': 'string',
                              'expected': 'string'},
            'array_int':    {'elem': INT64,   'rt': 'int',   'expected': 'int'},
            'array_float':  {'elem': FLOAT64, 'rt': 'float', 'expected': 'float'},
            # Bool table — same runtime + mutable surface as vector_bool.
            'array_bool':   {'elem': BOOL,    'rt': 'bool',  'expected': 'bool'},
            # Phase 5b: each element is a heap-allocated cssc_str* (4 bytes
            # on Xtensa, 8 bytes on host). The runtime suffix is 'string'
            # — runtime helpers live under cssc_array_string_* and
            # parallel the cssc_vector_int_* family but carry refcount-
            # cascade semantics on element destroy.
            'array_string': {'elem': STRING_PTR, 'rt': 'string',
                              'expected': 'string'},
        }
    return _VECTOR_TRAITS[slot_kind]


_LOWER_ACTIVE_FILE: List[str] = ['']


def _current_source_file() -> str:
    """Return the .cssc file currently being lowered (for error messages).

    The main source is pushed at `lower()` entry; every `#load` push/pop
    keeps this stack accurate so errors inside a loaded child file report
    the child's path, not the parent's.
    """
    return _LOWER_ACTIVE_FILE[-1] if _LOWER_ACTIVE_FILE else ''


def _csscerror(detail: str, hint: str = '', line: Optional[int] = None,
               operation: str = 'CIR-Lower'):
    from ...cssl_cssc import CsscError  # type: ignore
    script = _current_source_file()
    return CsscError(operation=operation, detail=detail, hint=hint,
                     line=line or 0, script=script)


# Shared, byte-for-byte-identical wording for the sector-isolation error so
# the native compiler and the interpreter reject the same code the same way.
def _sector_isolation_error_text(sector: str, ns: str, func: str):
    detail = (f"sector {sector} may not call {ns}::{func}: {ns} is neither "
              f"cssc, a member of {sector}, nor an injected <dep>")
    hint = (f"inject it: `sector {sector}<{ns}> {{ ... }}` "
            f"(sectors are isolated scopes — external modules must be "
            f"declared as dependencies)")
    return detail, hint


def _check_sector_isolation(ns: str, func: str, line: Optional[int]) -> None:
    """Enforce CSSC sector isolation: inside a sector body, a `ns::func(...)`
    call may only target `cssc::`, the sector itself, one of the sector's own
    functions, or a `<dep>` injected in the sector header. Anything else is a
    hard error (matching the interpreter). No-op outside a sector body."""
    owning = _owning_sector_current()
    if owning is None:
        return
    sec = _SECTORS.get(owning)
    if sec is None:
        return
    if ns == 'cssc' or ns == owning:
        return
    if ns in sec.get('deps', set()):
        return
    if ns in sec.get('functions', {}):
        return
    detail, hint = _sector_isolation_error_text(owning, ns, func)
    raise _csscerror(detail=detail, hint=hint, line=line,
                     operation='Sector-Isolation')


def _parse_slot_arg(arg: str) -> Tuple[str, int]:
    """Parse `int, 32` into ('int', 32). Bits defaults to 64 when absent.

    Respects angle-bracket nesting so types like `map<string, int>, 256`
    split correctly into ('map<string, int>', 256) rather than treating
    the inner comma as the bits separator.
    """
    depth = 0
    split_at = -1
    for i, ch in enumerate(arg):
        if ch == '<':
            depth += 1
        elif ch == '>':
            depth -= 1
        elif ch == ',' and depth == 0:
            split_at = i
            break
    if split_at < 0:
        vtype = arg.strip()
        bits_part = ''
    else:
        vtype = arg[:split_at].strip()
        bits_part = arg[split_at + 1:].strip()
    if not vtype:
        raise _csscerror(detail='#stack/#heap requires a type argument',
                         hint='Usage: #stack[int, 32] x = 5;')
    bits = 64
    if bits_part:
        try:
            bits = int(bits_part, 0)
        except ValueError:
            raise _csscerror(detail=f'invalid bit-width {bits_part!r}',
                             hint='Usage: #stack[int, 32] x = 5;')
    return vtype, bits


# Module-level registry of declared sectors. Keys are sector names; values
# are dicts with:
#   'free_body' — list of AST statements to run on `#free[Name]`
#   'slots'     — sector member metadata (Phase 4b)
#   'functions' — name → llvm symbol mapping (Phase 4a)
# Filled in by `_lower_sector`; consulted by `_lower_ns_call` and the
# directive lowerer for `#free`.
_SECTORS: Dict[str, dict] = {}

# Module-level registry of declared objects (Phase 4c). Same shape as
# _SECTORS but with `labels` instead of `functions`; objects are
# instantiated via `Counter() c;` rather than accessed via `Name::func()`.
# Singleton in Phase 4c: every instance handle aliases the same globals.
_OBJECTS: Dict[str, dict] = {}

# Deferred-init sectors (CSSC spec §6.5). Populated by `_lower_sector`
# when it encounters `sector Name ?label { … };` — the sector node is
# stashed here keyed on the label, with `reserve_label` already cleared
# on the stored copy so the eventual recursion through `_lower_sector`
# doesn't loop. `_lower_reserve_directive` pops the entry and re-enters
# `_lower_sector` so the sector's globals + init store sequence land at
# the `#reserve[label]` program-order position.
_DEFERRED_SECTORS: Dict[str, dict] = {}

# Per-function stack of callable-alias dicts. Pushed by every emitter
# that opens a CIR function body (`_lower_define`, sector functions,
# object label functions); popped at the end of that body. The active
# dict (`_callable_alias_top()`) maps a LOCAL alias name (created
# inside the body via `#req[callable] alias;`) to the REAL callable
# name (the global `#define` target). `_lower_call` consults the top
# of stack BEFORE raising "function not defined" so a #req'd alias
# resolves to the underlying `#define`d function.
#
# Stack-shape keeps the aliases strictly scoped: an alias declared in
# function A's body cannot leak into function B's body.
_CALLABLE_ALIAS_STACK: List[Dict[str, str]] = []


def _callable_alias_push() -> None:
    """Open a fresh callable-alias frame; call at every function-body
    enter so `#req[callable] alias;` aliases stay scoped to one body."""
    _CALLABLE_ALIAS_STACK.append({})


def _callable_alias_pop() -> None:
    """Close the current callable-alias frame; call at function-body
    exit. Tolerant of empty stack — defensive against unmatched calls."""
    if _CALLABLE_ALIAS_STACK:
        _CALLABLE_ALIAS_STACK.pop()


def _callable_alias_top() -> Dict[str, str]:
    """Return the top callable-alias dict or an empty dict when no
    function body is currently being emitted."""
    if not _CALLABLE_ALIAS_STACK:
        return {}
    return _CALLABLE_ALIAS_STACK[-1]


def _callable_alias_bind(local: str, callable_name: str) -> None:
    """Bind `local` as an alias to the global callable `callable_name`
    in the current function body's frame."""
    if not _CALLABLE_ALIAS_STACK:
        _CALLABLE_ALIAS_STACK.append({})
    _CALLABLE_ALIAS_STACK[-1][local] = callable_name


def _callable_alias_resolve(local: str) -> Optional[str]:
    """Resolve a local name to a real callable through the alias stack.
    Returns None when no binding exists at any level."""
    for frame in reversed(_CALLABLE_ALIAS_STACK):
        if local in frame:
            return frame[local]
    return None


# Per-function stack of the OWNING sector name (or None when the
# function isn't a sector member). Pushed by sector function emission
# in `_lower_sector` and popped at the end of each define body.
# `_lower_req` consults the top of this stack so a bare-name
# `#req[member] alias;` inside a sector function body finds the
# member in the enclosing sector's slots dict.
_OWNING_SECTOR_STACK: List[Optional[str]] = []


def _owning_sector_push(sector_name: Optional[str]) -> None:
    """Open a sector-owner frame for the current function body.
    Pass `None` for free `#define` functions outside any sector."""
    _OWNING_SECTOR_STACK.append(sector_name)


def _owning_sector_pop() -> None:
    """Close the current sector-owner frame; tolerant of underflow."""
    if _OWNING_SECTOR_STACK:
        _OWNING_SECTOR_STACK.pop()


def _owning_sector_current() -> Optional[str]:
    """Return the sector name owning the current function body, or
    `None` when the body is a free function / no body is active."""
    if not _OWNING_SECTOR_STACK:
        return None
    return _OWNING_SECTOR_STACK[-1]


# Per-label active-object frame so `call other_label(args);` from inside
# `if`/`select`/`while` bodies can resolve `other_label` against the
# current object's label table. Without this, `_lower_stmt` saw
# `call_label` as a top-level node and rejected it because the
# call-target resolution helpers (`_emit_self_label_call`) are
# scoped to `_lower_object`'s direct body loop.
#
# Push from `_lower_object` when entering a label body; pop when
# exiting. The `dict` carries the metadata `_emit_self_label_call`
# needs (name, labels, label_params, label_return_kinds, line).
_OWNING_OBJECT_STACK: List[Optional[dict]] = []


def _owning_object_push(meta: Optional[dict]) -> None:
    """Open an object-owner frame so nested control-flow stmts can
    resolve self-directed `call <label>` calls."""
    _OWNING_OBJECT_STACK.append(meta)


def _owning_object_pop() -> None:
    """Close the current object-owner frame; tolerant of underflow."""
    if _OWNING_OBJECT_STACK:
        _OWNING_OBJECT_STACK.pop()


def _owning_object_current() -> Optional[dict]:
    """Return the object-owner metadata for the current label body, or
    `None` when no object body is active."""
    if not _OWNING_OBJECT_STACK:
        return None
    return _OWNING_OBJECT_STACK[-1]

# Per-function map of instance-name → object-name. Phase 4c is singleton
# so e.g. `Counter() c1; Counter() c2;` makes both c1 and c2 point at the
# same module globals. Phase 4d will move to per-instance malloc.
# Compile-time constants populated by `#DEFINE name <expr>;`. The value
# is a CSSC scalar (int / float / str / bool); identifier lookups
# resolve against this registry before falling through to slot scope.
# Wiped at the start of every `lower()` call so cross-compile state
# doesn't leak.
_CT_CONSTS: Dict[str, Any] = {}


_INSTANCES: Dict[str, str] = {}
# A.3.13: stack of saved _INSTANCES snapshots, one entry per active
# function-lowering frame. `_instance_scope_enter()` pushes the current
# dict and clears it for the inner frame; `_instance_scope_exit()`
# restores. This prevents a `Counter() c;` declared inside a #define body
# from leaking into a sibling #define that happens to declare an `int c`.
_INSTANCE_STACK: List[Dict[str, str]] = []


def _instance_scope_enter() -> None:
    """Push the current _INSTANCES dict and start a fresh frame.

    Object declarations made inside the just-entered function will be
    visible only to that function's body and any nested functions emitted
    while it is open. The outer frame's instances are *not* visible
    inside (function-local scoping), which matches the v6 calling
    convention — objects are always passed explicitly as args, never
    inherited lexically.
    """
    _INSTANCE_STACK.append(dict(_INSTANCES))
    _INSTANCES.clear()


def _instance_scope_exit() -> None:
    """Pop the most-recent _INSTANCES snapshot back into place."""
    if not _INSTANCE_STACK:
        return
    saved = _INSTANCE_STACK.pop()
    _INSTANCES.clear()
    _INSTANCES.update(saved)


def _instance_unbind(name: str) -> None:
    """Drop `name` from the current frame's _INSTANCES dict."""
    _INSTANCES.pop(name, None)


def _instance_bind(name: str, obj_type: str) -> None:
    """Add `name → obj_type` to the current frame's _INSTANCES dict.

    Used by `_bind_object_members` when binding a ref-captured object
    handle so the body's `cap.method()` calls dispatch correctly.
    """
    _INSTANCES[name] = obj_type


def _instance_lookup_type(name: str) -> Optional[str]:
    """Resolve `name` to its object type by walking the current frame
    and every saved snapshot on the instance stack. Used when binding
    a ref-captured handle whose source lived in an outer frame
    (top-level `#stack[…] vd = Foo();` viewed from inside an inner
    object's ctor body)."""
    if name in _INSTANCES:
        return _INSTANCES[name]
    for snapshot in reversed(_INSTANCE_STACK):
        if name in snapshot:
            return snapshot[name]
    return None

# Top-level `#define(name) { body }` registry — used by `_lower_call` to
# resolve free-function calls and by `_lower_scanp` to discover the active
# define's param slots. Entries:
#   {'sym':<llvm symbol>, 'arity':int, 'arg_kinds':[kind,...],
#    'param_slots':[slot_id,...] | []}
# `param_slots` is populated only while the matching #define body is being
# lowered; it's cleared again on body exit so a stray #scanp outside the
# body errors out instead of pulling a stale slot id.
_DEFINES: Dict[str, dict] = {}
# CCOS `#interrupt(name){…}` handlers → {name: {'sym': 'cssc_isr_<name>'}}.
# Registered at lower time so `#adress[name]` can resolve the ISR address.
_INTERRUPTS: Dict[str, dict] = {}

# Top-level slots that any `#define`/`#cdefine` body `#req`s — these get
# promoted to module-level globals at slot-decl time so a function body
# can bind a local name to them through `b.global_addr`. Populated by
# `_prescan_top_level_reqs` before any lowering starts. Entries:
#   {'sym':<llvm symbol>, 'kind':<int|bool|float>, 'bits':int}
# Only populated for names referenced via #req; unreferenced top-level
# slots stay as plain main-locals (no extra global cost).
_PROMOTED_GLOBALS: Dict[str, dict] = {}


_PARAM_TYPES: Dict[str, str] = {}


# Tracks the homogeneous cell kind of each `bind` / `bind_entry` slot,
# populated by `_init_bind_entry` at slot-init time. Keys are SSA slot
# ids; values are one of {'int', 'float', 'string', 'bool', 'mixed'}.
# Read/write dispatch consults this so float bind cells round-trip
# through f64 bitcasts instead of being mis-typed as raw i64 / ptr.
_BIND_CELL_KIND: Dict[int, str] = {}


# Stack of "outer slot snapshots" maintained by `_lower_private_scope`.
# Each entry is a dict of {name: kind} captured at bare-block entry. The
# identifier-lookup path consults the top of this stack: if a name is
# absent from the current scope but present in the snapshot, that means
# the user wrote a bare-block reference to an outer slot WITHOUT
# `#req[outer] local;` — per spec §5.4 the outer name is not in scope.
# Rather than hard-erroring, we emit a one-shot warning and return a
# zero/null sentinel of the matching CIR kind so the program keeps
# building. The warning is dedup'd by (line, name) so a hot loop only
# fires once.
_BARE_BLOCK_OUTER_SCOPES: List[Dict[str, str]] = []
_BARE_BLOCK_WARN_SEEN: set = set()


def _csscwarn(detail: str, line: Optional[int], hint: Optional[str] = None) -> None:
    """Emit a `[CSSC] warning` line to stdout without aborting the build.

    Mirrors `_csscerror`'s formatting so warnings and errors look like
    siblings in build output. Line is shown as `line <N>` when known.
    Goes to stdout (not stderr) so it interleaves naturally with the
    `[1/7] Parse … [2/7] Lower …` build status lines and PowerShell
    doesn't flag it as a native-command error.
    """
    import sys as _sys
    where = f'line {line}: ' if line is not None else ''
    _sys.stdout.write(f'[CSSC] warning {where}{detail}\n')
    if hint:
        _sys.stdout.write(f'  Hint: {hint}\n')
    _sys.stdout.flush()


def lower(ast: List[dict], source_filename: str = '<stdin>') -> CIRBuilder:
    """Walk the parsed AST and produce a CIRBuilder with the full module.

    Returns the builder (with `.module` containing the lowered Module).
    Caller is responsible for handing the module to `cir_to_llvm` next.
    """
    b = CIRBuilder(source_filename=source_filename, module_name='cssc_main')

    # Reset module-level registries (lowering is stateless across calls).
    _SECTORS.clear()
    _OBJECTS.clear()
    _INSTANCES.clear()
    _INSTANCE_STACK.clear()
    _INCLUDED_MODULES.clear()
    _LOADED_FILES.clear()
    _DEFINES.clear()
    _INTERRUPTS.clear()
    _CT_CONSTS.clear()
    _PROMOTED_GLOBALS.clear()
    _PARAM_TYPES.clear()
    _BARE_BLOCK_OUTER_SCOPES.clear()
    _BARE_BLOCK_WARN_SEEN.clear()
    _BIND_CELL_KIND.clear()
    _LOWER_ACTIVE_FILE.clear()
    _LOWER_ACTIVE_FILE.append(source_filename or '<stdin>')

    # Pre-scan: every name a `#req[name] ...` references from inside any
    # #define/#cdefine body needs its top-level slot promoted to a real
    # module global so the body can resolve it through `global_addr`.
    # We populate the registry here, then `_lower_slot_decl` consults
    # it at top-level decl time to decide between alloca and global.
    promoted = _collect_req_targets(ast)
    for nm in promoted:
        _PROMOTED_GLOBALS[nm] = {'sym': f'cssc_g_{nm}', 'kind': '', 'bits': 0}

    # A.3.13: enter a fresh _INSTANCES scope for `cssc_user_main` so its
    # local instance declarations stay isolated from any later sibling
    # function (sectors / #defines / object label methods that lower
    # AFTER user_main returns).
    _instance_scope_enter()
    try:
        with b.function('cssc_user_main', VOID, []):
            for stmt in ast:
                _lower_stmt(b, stmt)
            # ret void is auto-emitted by the context manager if missing.
    finally:
        _instance_scope_exit()

    # Perf-opt #3: per-function scope-elision analysis. A function
    # only NEEDS cssc_scope_push/pop when its body carries state that
    # the runtime's cleanup pass would touch — arg-linking aliases,
    # heap-releasing helpers, or explicit scope operations. Everything
    # else (pure integer/float bodies) can safely skip the scope
    # brackets: mem2reg promotes their locals to registers and the
    # runtime cleanup is a no-op anyway. Runs after all lowering so
    # every emitted `Call.callee` name is visible.
    _annotate_needs_scope(b.module)
    return b


def _annotate_needs_scope(module) -> None:
    """Set `Function.needs_scope=False` on every function whose body has
    no aliasable heap state.

    Heuristic (conservative — false means "definitely no scope work"):
      * Any `Call` op whose callee is in `_SCOPE_TRIGGER_SYMBOLS`
        (arg-link, heap-release, string-free, container mutators, or
        scope-alias) keeps needs_scope True.
      * Any `SlotRelease`/`SlotRetain` on a heap kind keeps
        needs_scope True — those emit runtime release calls.
      * Any `ScopePush`/`ScopePop`/`ScopeBind`/`RefArg`/`RefDelete`
        keeps needs_scope True — the whole point of these ops is
        to touch the runtime frame.
    Functions with NONE of the above have needs_scope=False; the
    subsequent lowering path drops the two runtime calls and their
    declares.
    """
    for fn in module.functions:
        # `main` and any name that isn't scope-owning in the first
        # place default to True — the emitter never emits the push/pop
        # for them regardless. Only run the analysis on scope-owning
        # candidates so we don't waste time in the loop.
        needs = _function_body_needs_scope(fn)
        fn.needs_scope = needs


_SCOPE_TRIGGER_SYMBOLS = frozenset({
    'cssc_arg_link',
    'cssc_scope_alias',
    'cssc_scope_delete', 'cssc_scope_delete_aliased',
    'cssc_scope_delete_in_frame',
    'cssc_release', 'cssc_retain',
    'cssc_string_free', 'cssc_string_copy',
    # Container / bind mutators can mutate refcount-managed heap that
    # the scope cleanup would otherwise reap.
    'cssc_vector_push_int', 'cssc_vector_push_float',
    'cssc_vector_push_bool', 'cssc_vector_push_string',
    'cssc_map_si_set', 'cssc_map_ss_set', 'cssc_map_is_set',
    'cssc_map_ii_set', 'cssc_map_sf_set', 'cssc_map_if_set',
    'cssc_bind_ss_set',
})

_HEAP_SLOT_KINDS = frozenset({
    'string',
    'vector_int', 'vector_float', 'vector_bool', 'vector_string',
    'array_int', 'array_float', 'array_bool', 'array_string',
    'map_si', 'map_ss', 'map_is', 'map_ii', 'map_sf', 'map_if',
    'bind_ss', 'bind_entry', 'array_bind',
    'pin', 'i2c', 'spi', 'uart', 'adc', 'pwm', 'timer',
    'tft', 'oled', 'video', 'matrix', 'framebuffer', 'console',
})

# Container kinds that may cross a `#define` parameter boundary. Each is
# a heap object carried by pointer in the i64 ABI slot — exactly like a
# `string` (`cssc_str*`) — so the whole scanp/call-site machinery treats
# them identically to string once the kind is recognised here. Peripheral
# handles (pin/i2c/…) are heap too but are NOT passable params, so they
# stay out of this set.
_CONTAINER_PARAM_KINDS = frozenset({
    'vector_int', 'vector_float', 'vector_bool', 'vector_string',
    'array_int', 'array_float', 'array_bool', 'array_string',
    'map_si', 'map_ss', 'map_is', 'map_ii', 'map_sf', 'map_if',
    'bind_ss', 'bind_entry', 'array_bind',
})

# The subset of container kinds that `_init_vector` can build from an
# `array` / `array_literal` node (numeric + string element vectors and
# their immutable `array<T>` twins).
_VECTOR_INITABLE_KINDS = frozenset({
    'vector_int', 'vector_float', 'vector_bool', 'vector_string',
    'array_int', 'array_float', 'array_bool', 'array_string',
})

# Scalar (POD + heap-string) kinds that fit a `#define` parameter slot
# directly: int/bool/float travel as their raw value, string travels as
# its `cssc_str*` pointer. Extended by `_CONTAINER_PARAM_KINDS` above for
# the full native parameter surface.
_NATIVE_PARAM_SCALAR_KINDS = frozenset({'int', 'string', 'float', 'bool'})


def _function_body_needs_scope(fn) -> bool:
    """Walk every op in `fn` and return True if any op requires the
    runtime scope frame to be live. See `_annotate_needs_scope` for
    the exact list of triggers."""
    from .ops import (
        Call as _Call, SlotRelease as _SlotRelease,
        SlotRetain as _SlotRetain, ScopePush as _ScopePush,
        ScopePop as _ScopePop, ScopeBind as _ScopeBind,
        RefArg as _RefArg, RefDelete as _RefDelete,
    )
    for blk in fn.blocks:
        for op in blk.ops:
            if isinstance(op, _ScopeBind):
                # A bind only needs the runtime scope frame when it binds a
                # HEAP-kind slot (so scope-pop can reap it). POD binds
                # (int/bool/float) — including every `#scanp` param of a
                # pure-POD function like `fib` — are pure name resolution
                # with no runtime effect and must NOT force the frame; that
                # over-broad trigger was why the existing scope-elision pass
                # never fired for scanp'd functions. Unknown kind ('') is
                # treated conservatively as needing scope.
                if (not op.elem_kind) or op.elem_kind in _HEAP_SLOT_KINDS:
                    return True
                continue
            if isinstance(op, (_ScopePush, _ScopePop, _RefArg, _RefDelete)):
                return True
            if isinstance(op, _Call):
                if op.callee in _SCOPE_TRIGGER_SYMBOLS:
                    return True
            if isinstance(op, (_SlotRelease, _SlotRetain)):
                if op.elem_kind in _HEAP_SLOT_KINDS:
                    return True
    return False


# ---------------------------------------------------------------------------
# Statements.
# ---------------------------------------------------------------------------
def _lower_stmt(b: CIRBuilder, node: dict) -> None:
    t = node.get('type')
    line = node.get('line')
    if line is not None:
        b.set_loc(b.module.source_filename, line)

    if t == 'sector':
        return _lower_sector(b, node)
    if t == 'object':
        return _lower_object(b, node)
    if t == 'define':
        return _lower_define(b, node)
    if t == 'interrupt':
        return _lower_interrupt(b, node)
    if t == 'scanp':
        return _lower_scanp(b, node)
    if t == 'cdefine':
        return _lower_cdefine(b, node)
    if t == 'qvar':
        return _lower_qvar(b, node)
    if t == 'result_capture':
        return _lower_result_capture(b, node)
    if t == 'arrow_assign':
        return _lower_arrow_assign(b, node)
    if t == 'dot_assign':
        # A.3.9: `inst.field = v` — adapt to arrow_assign (heap-allocated
        # objects make the two forms semantically identical in v6 native).
        return _lower_dot_assign(b, node)
    if t == 'ns_assign':
        # A.3.9: `Sector::member = v` — write a sector module global.
        return _lower_ns_assign(b, node)
    if t == 'deref_assign':
        # A.3.9: `*ptr = v` — store through a raw pointer.
        return _lower_deref_assign(b, node)
    if t == 'private_scope':
        return _lower_private_scope(b, node)
    if t == 'include':
        return _lower_include(b, node)
    if t == 'depend':
        return _lower_depend(b, node)
    if t == 'require':
        return _lower_require(b, node)
    if t == 'directive':
        return _lower_directive(b, node)
    if t == 'expr_stmt':
        # Parser wraps statement-level expressions in expr_stmt; unwrap and
        # dispatch on the inner expression.
        inner = node.get('expr', {})
        inner_t = inner.get('type')
        if inner_t == 'ns_call':
            _lower_ns_call(b, inner)
            return
        if inner_t == 'call':
            _lower_call(b, inner)
            return
        if inner_t == 'dot_call':
            # Side-effecting method call discarded as a statement (e.g.
            # `xs.push_back(40);`). Lower as expression, drop the result.
            _lower_dot_call_expr(b, inner)
            return
        if inner_t == 'method_call':
            # A.3.7: arrow-style method call as a statement
            # (`obj->step(args);`). Forwarded to the same dispatcher as
            # the dot form; the helper handles arrow-vs-dot resolution.
            _lower_method_call_expr(b, inner)
            return
        if inner_t == 'member_ns_call':
            # `Sector::func(args);` invoked for side-effects only.
            _lower_member_ns_call_expr(b, inner)
            return
        if inner_t == 'postfix':
            # A.3.1: `i++` / `i--` as a statement. Lower the mutation
            # (slot += 1 / slot -= 1) and discard the old-value result
            # that postfix would normally yield in expression position.
            _lower_postfix_stmt(b, inner)
            return
        raise _csscerror(detail=f'expr_stmt of type {inner_t!r} not yet supported',
                         hint='Phase 1-3: ns_call, call, dot_call, method_call, '
                              'member_ns_call, postfix',
                         line=line)
    if t == 'ns_call':
        _lower_ns_call(b, node)
        return
    if t == 'call':
        _lower_call(b, node)
        return
    if t == 'assign':
        _lower_assign(b, node)
        return
    if t == 'if':
        _lower_if(b, node)
        return
    if t == 'for':
        _lower_for(b, node)
        return
    if t == 'while':
        _lower_while(b, node)
        return
    if t == 'index_assign':
        _lower_index_assign(b, node)
        return
    if t == 'select':
        _lower_select(b, node)
        return
    if t == 'select_jump':
        _lower_select_jump(b, node)
        return
    if t == 'return':
        _lower_return(b, node)
        return
    if t == 'mirror':
        _lower_mirror(b, node)
        return
    if t == 'break':
        _lower_break(b, node)
        return
    if t == 'continue':
        _lower_continue(b, node)
        return
    # Self-directed `call <label>(args);` inside a nested control-flow
    # body (if / select / while / for) of an object label. The owner-
    # object frame was pushed by `_lower_object` when entering the
    # parent label body. Without this dispatch, `_lower_object`'s
    # direct loop catches `call_label` correctly but anything nested
    # one block deeper (the typical pattern when calling a helper
    # label from inside an `if`) would surface "unsupported top-level
    # node 'call_label'" — exactly what caro.cssc hit at line 44.
    if t == 'call_label':
        obj_meta = _owning_object_current()
        if obj_meta is None:
            raise _csscerror(
                detail='`call <label>` is only valid inside an object body',
                hint='Move the call into the enclosing object\'s ctor body '
                     'or one of its labels, or use `inst.<label>(args)` if '
                     'the target lives on a different instance.',
                line=line,
            )
        _emit_self_label_call(
            b, node,
            obj_meta['name'],
            obj_meta['labels'],
            obj_meta['label_params'],
            obj_meta['label_return_kinds'],
            obj_meta.get('line', line),
        )
        return
    if t == 'destruct':
        obj_meta = _owning_object_current()
        if obj_meta is None:
            raise _csscerror(
                detail='`destruct;` is only valid inside an object label body',
                hint='`destruct;` self-destroys the current instance from '
                     'inside one of its own labels. Outside an object body, '
                     'use `#delete[<handle>];` instead.',
                line=line,
            )
        _emit_self_destruct(b, obj_meta['name'], line)
        return
    raise _csscerror(detail=f'unsupported top-level node {t!r}',
                     hint='Phase 1-3 supports: directives, ns_call, call, assign, '
                          'index_assign, if, for, while, select, select_jump, return, '
                          'dot_call (as expr_stmt)',
                     line=line)


# ---------------------------------------------------------------------------
# Phase 2: assignment + control flow.
# ---------------------------------------------------------------------------
def _lower_assign(b: CIRBuilder, node: dict) -> None:
    """Lower an `assign` statement: `target = value`.

    Supports simple-name assignment to a known slot for any kind that the
    `_store_to_slot` dispatcher handles. A.3.2: `for_decl: True` (set by
    the parser on the init of `for (int i = 0; ...)`) auto-declares the
    target as an int slot before storing into it — without the auto-decl,
    `_lower_assign` would have rejected an undeclared `i`.
    """
    line = node.get('line')
    target = node.get('target', '')
    if isinstance(target, dict):
        # Compound targets (member assign, index assign) would arrive here
        # in later phases.
        raise _csscerror(detail='Phase 2: only simple-name assignment supported',
                         hint='dot/index/member assignment lands in Phase 3+',
                         line=line)
    # A.3.2: auto-declare slot for `for (int i = 0; ...)` form.
    if node.get('for_decl') and target and not b.scope_has(target):
        decl_kind = node.get('decl_kind') or 'int'
        decl_bits = node.get('decl_bits') or 64
        if decl_kind not in ('int', 'bool', 'float'):
            raise _csscerror(
                detail=f'for-decl: only int/bool/float allowed (got {decl_kind!r})',
                hint='for-decl is meant for monomorphic loop counters; '
                     'declare heap kinds with #stack/#heap before the loop',
                line=line,
            )
        new_slot = b.slot_alloc(decl_kind, decl_bits)
        b.scope_bind(target, new_slot, elem_kind=decl_kind)
    if not target or not b.scope_has(target):
        raise _csscerror(detail=f'assign: target {target!r} not declared',
                         hint=f'declare with #stack/#heap/#auto first',
                         line=line)
    slot = b.scope_lookup(target)
    kind = b.scope_kind(target)
    val_id, val_type = _lower_expr(b, node['value'], expected_kind=kind)
    _store_to_slot(b, slot, kind, val_id, val_type, line,
                   rhs_node=node.get('value'))


def _lower_postfix_stmt(b: CIRBuilder, node: dict) -> None:
    """A.3.1: `i++` / `i--` lowered as a statement.

    The parser emits `{'type': 'postfix', 'op': '++'|'--', 'target': name}`
    inside an `expr_stmt`. In expression position (rare in CSSC — typically
    just the step clause of a for-loop) the old value is the result; as a
    statement we just mutate and discard the old value. POD numeric kinds
    only — heap kinds don't support postfix.
    """
    line = node.get('line')
    op = node.get('op')
    if op not in ('++', '--'):
        raise _csscerror(detail=f'postfix: unsupported operator {op!r}',
                         line=line)
    target_node = node.get('target') or node.get('operand') or node.get('expr')
    # Parser variants either store the target as a sub-AST or as a bare
    # identifier string. Normalise to a name string.
    if isinstance(target_node, dict):
        if target_node.get('type') != 'identifier':
            raise _csscerror(
                detail='postfix target must be an identifier slot',
                hint='`x[0]++` / `obj->m++` are not supported yet',
                line=line,
            )
        target_name = target_node.get('name', '')
    else:
        target_name = target_node or ''
    if not target_name or not b.scope_has(target_name):
        raise _csscerror(
            detail=f'postfix: target {target_name!r} not declared',
            line=line,
        )
    kind = b.scope_kind(target_name)
    if kind not in ('int',):
        # bool/float postfix is doable but unusual in CSSC — gate to int
        # until a real use-case surfaces.
        raise _csscerror(
            detail=f'postfix on {kind!r} slot is not supported (only int)',
            hint='use `x = x + 1.0;` for float counters',
            line=line,
        )
    slot = b.scope_lookup(target_name)
    cur = b.slot_load(slot, kind)
    one = b.const_int(1)
    delta = '+' if op == '++' else '-'
    new_val = b.bin_int(delta, cur, one)
    _store_to_slot(b, slot, kind, new_val, INT64, line)


def _lower_method_call_expr(b: CIRBuilder, node: dict) -> Tuple[int, CIRType]:
    """A.3.7: arrow-form `obj->method(args)`. Forwards to the dot_call
    dispatcher because v6 native heap-allocates every object, so the dot
    and arrow forms are semantically identical.

    Special case (Phase 4b): `Sector->func(args)` where `Sector` is a
    declared sector, not an object instance. Route to the sector's
    function via `_DEFINES[f'{Sec}::{func}']` — matches the interpreter's
    permissive treatment of `->` on sectors.
    """
    receiver = node.get('object', {})
    if isinstance(receiver, dict) and receiver.get('type') == 'identifier':
        rname = receiver.get('name', '')
        method = node.get('method', '')
        if rname in _SECTORS:
            qualified = f'{rname}::{method}'
            if qualified in _DEFINES:
                return _lower_call_expr(b, {
                    'type': 'call', 'name': qualified,
                    'args': node.get('args', []) or [],
                    'line': node.get('line'),
                })
    return _lower_dot_call_expr(b, node)


def _lower_member_ns_call_expr(b: CIRBuilder, node: dict) -> Tuple[int, CIRType]:
    """A.3.7 / Phase 4b: `Sector::func(args)` — call a sector-namespaced
    function. Also handles the load-alias-chained form `alias::Sector::func`
    that arrives here as `member_ns_call` with an `ns_access` LHS.

    Sector-body #define now registers `_DEFINES[f'{Sec}::{func}']` with
    full param metadata, so we delegate to `_lower_call_expr` with a
    synthetic bare-call node keyed by the sector-qualified name. That
    path handles arg-marshaling (n_args packing, ref/copy bits, float/
    bool coercions) identically to a top-level `#define` call.
    """
    line = node.get('line')
    receiver = node.get('object', {})
    func = node.get('func', '')
    args = node.get('args', []) or []

    if receiver.get('type') == 'ns_access':
        outer_ns = receiver.get('namespace', '')
        sector = receiver.get('member', '')
        outer_meta = _INCLUDED_MODULES.get(outer_ns)
        if outer_meta is None:
            raise _csscerror(
                detail=(f'alias {outer_ns!r} not visible in this scope'),
                hint='did you #load or #include it?',
                line=line,
            )
        if sector not in _SECTORS:
            raise _csscerror(
                detail=f'sector {sector!r} (via alias {outer_ns!r}) not '
                       f'declared',
                hint=f'declared sectors: {sorted(_SECTORS.keys())}',
                line=line,
            )
        qualified = f'{sector}::{func}'
        if qualified in _DEFINES:
            return _lower_call_expr(b, {
                'type': 'call', 'name': qualified,
                'args': args, 'line': line,
            })
        raise _csscerror(
            detail=f'{outer_ns}::{sector}::{func}: no matching '
                   f'sector-scoped definition',
            hint=(f"emit it via `#define({sector}::{func}) {{ … }}` or "
                  f"`#cdefine({func}, args…) {{ … }}` inside "
                  f"`sector {sector} {{ … }}`"),
            line=line,
        )
    if receiver.get('type') != 'identifier':
        raise _csscerror(
            detail='member_ns_call requires a sector identifier on the LHS',
            hint='`Foo::bar()` where Foo is a #include\'d sector',
            line=line,
        )
    sector = receiver.get('name', '')
    if sector not in _SECTORS:
        raise _csscerror(
            detail=f'sector {sector!r} not visible in this scope',
            hint='did you #include it?',
            line=line,
        )
    qualified = f'{sector}::{func}'
    if qualified in _DEFINES:
        return _lower_call_expr(b, {
            'type': 'call', 'name': qualified,
            'args': args, 'line': line,
        })
    info = _SECTORS[sector]
    funcs = info.get('functions', {})
    if func not in funcs:
        raise _csscerror(
            detail=f'sector {sector!r} has no function {func!r}',
            hint=f'declared functions: {sorted(funcs.keys())}',
            line=line,
        )
    fn_meta = funcs[func]
    if isinstance(fn_meta, str):
        sym = fn_meta
    else:
        sym = fn_meta.get('sym') or f'cssc_sec_{sector}_{func}'
    # Lower args using the function's declared param kinds. If the sector
    # didn't pre-scan param types, fall back to int — the user is
    # responsible for not mixing kinds in v6 sector calls.
    param_kinds = (fn_meta.get('params', [])
                    if isinstance(fn_meta, dict) else [])
    raw_args = node.get('args', []) or []
    if param_kinds and len(raw_args) != len(param_kinds):
        raise _csscerror(
            detail=f'{sector}::{func}() expects {len(param_kinds)} arg(s), '
                   f'got {len(raw_args)}',
            line=line,
        )
    arg_ssa: List[int] = []
    arg_tys: List[CIRType] = []
    for i, arg_node in enumerate(raw_args):
        want_kind = param_kinds[i] if i < len(param_kinds) else None
        v_id, v_ty = _lower_expr(b, arg_node, expected_kind=want_kind)
        arg_ssa.append(v_id)
        arg_tys.append(v_ty)
    if isinstance(fn_meta, dict):
        ret_kind = fn_meta.get('return')
        ret_ty = _cssc_kind_to_cirtype(ret_kind) if ret_kind else VOID
    else:
        ret_ty = VOID
    result_id = b.call(sym, arg_ssa, arg_tys,
                       return_type=ret_ty, external=False)
    if ret_ty.is_void():
        return b.const_int(0), INT64
    return result_id, ret_ty


def _lower_if(b: CIRBuilder, node: dict) -> None:
    """Lower `if (cond) { then-body } else { else-body }`.

    Emits:
        ... cond ...
        br i1 %cond, label %if.then.N, label %(if.else.N | if.end.N)
        if.then.N:
          ... then-body ...
          br label %if.end.N
        if.else.N:
          ... else-body ...
          br label %if.end.N
        if.end.N:        ; insertion point continues here
    """
    line = node.get('line')
    cond_id, cond_ty = _lower_expr(b, node['condition'], expected_kind='bool')
    if cond_ty.kind != 'i1':
        if cond_ty.kind == 'i64':
            zero = b.const_int(0)
            cond_id = b.cmp_int('!=', cond_id, zero)
            cond_ty = BOOL
        elif cond_ty.kind == 'f64':
            zero_f = b.const_float(0.0)
            cond_id = b.cmp_float('!=', cond_id, zero_f, bits=64)
            cond_ty = BOOL
        elif cond_ty.kind in ('ptr', 'string_ptr'):
            i_id = b.ptr_to_int(cond_id)
            zero = b.const_int(0)
            cond_id = b.cmp_int('!=', i_id, zero)
            cond_ty = BOOL
        else:
            raise _csscerror(
                detail=f'if-condition must be boolean (got {cond_ty.kind}); '
                       f'use an explicit comparison',
                line=line,
            )

    has_else = bool(node.get('else'))
    then_blk = b.new_block('if.then')
    else_blk = b.new_block('if.else') if has_else else None
    end_blk = b.new_block('if.end')

    b.br_cond(cond_id, then_blk, else_blk or end_blk)

    # Per-branch scope frames. `#delete[x]` inside one branch unbinds
    # `x` from the lowerer's scope dict; without per-branch save/restore
    # the unbind leaks to the post-if code path even though that path
    # only runs when the branch wasn't taken. The classic surface form
    # this trips on is:
    #
    #     if (uptime >= deadline) {
    #         #delete[uptime];
    #         break;
    #     }
    #     #delete[uptime];     ← previously errored "not in scope"
    #
    # By snapshotting `b._slots` / `b._slot_kinds` at branch entry and
    # restoring at branch exit, the post-if `#delete[uptime]` sees the
    # same scope it would in a non-branching path. The runtime side
    # already gets the right slot_release op for whichever branch
    # ran — only the COMPILE-time scope tracking needed the fix.
    _saved_slots_outer = dict(b._slots)              # noqa: SLF001
    _saved_kinds_outer = dict(b._slot_kinds)         # noqa: SLF001

    # then
    b.set_block(then_blk)
    for stmt in node.get('then', []) or []:
        if _current_block_terminates(b):
            break  # dead code after return/jump
        _lower_stmt(b, stmt)
    if not _current_block_terminates(b):
        b.br(end_blk)

    # Restore scope before lowering the else branch so the else sees
    # the SAME pre-if bindings the then branch saw, not what the then
    # branch deleted.
    b._slots = dict(_saved_slots_outer)              # noqa: SLF001
    b._slot_kinds = dict(_saved_kinds_outer)         # noqa: SLF001

    # else (optional)
    if else_blk is not None:
        b.set_block(else_blk)
        for stmt in node.get('else', []) or []:
            if _current_block_terminates(b):
                break
            _lower_stmt(b, stmt)
        if not _current_block_terminates(b):
            b.br(end_blk)
        # Restore again so the post-if code path sees the pre-if
        # bindings regardless of what the else did.
        b._slots = dict(_saved_slots_outer)          # noqa: SLF001
        b._slot_kinds = dict(_saved_kinds_outer)     # noqa: SLF001

    b.set_block(end_blk)


def _lower_for(b: CIRBuilder, node: dict) -> None:
    """Lower C-style `for (init; cond; step) { body }`.

    No automatic per-iteration scope_push/pop — same reasoning as
    `_lower_while`. Allocations inside the body are the user's
    responsibility; the LSP catches forgotten `#delete`s, the
    runtime stays out of the way.

    Emits:
        ... init ...
        br label %for.cond.N
        for.cond.N:
          ... cond ...
          br i1 %c, label %for.body.N, label %for.end.N
        for.body.N:
          ... body ...
          br label %for.step.N
        for.step.N:
          ... step ...
          br label %for.cond.N
        for.end.N:        ; insertion point continues here
    """
    line = node.get('line')
    init = node.get('init')
    if init is not None:
        _lower_stmt(b, init)

    cond_blk = b.new_block('for.cond')
    body_blk = b.new_block('for.body')
    step_blk = b.new_block('for.step')
    end_blk = b.new_block('for.end')

    b.br(cond_blk)

    # cond
    b.set_block(cond_blk)
    cond_node = node.get('condition')
    if cond_node is None:
        # No condition → infinite loop semantically; jump straight to body.
        b.br(body_blk)
    else:
        cond_id, cond_ty = _lower_expr(b, cond_node, expected_kind='bool')
        if cond_ty.kind != 'i1':
            raise _csscerror(
                detail=f'for-condition must be boolean (got {cond_ty.kind})',
                line=line,
            )
        b.br_cond(cond_id, body_blk, end_blk)

    # body — push break/continue targets so the body's `break;` /
    # `continue;` know where to jump.
    b.set_block(body_blk)
    _loop_stack(b).append((step_blk, end_blk))
    try:
        for stmt in node.get('body', []) or []:
            if _current_block_terminates(b):
                break
            _lower_stmt(b, stmt)
    finally:
        _loop_stack(b).pop()
    if not _current_block_terminates(b):
        b.br(step_blk)

    # step
    b.set_block(step_blk)
    step = node.get('step')
    if step is not None:
        _lower_stmt(b, step)
    if not _current_block_terminates(b):
        b.br(cond_blk)

    b.set_block(end_blk)


def _lower_while(b: CIRBuilder, node: dict) -> None:
    """Lower `while (cond) { body }`.

    No automatic per-iteration scope_push/pop. CSSC's contract is
    "you allocated, you `#delete`". If a `#stack[…] x = …;` inside the
    loop body has no matching `#delete[x]`, the slot accumulates on
    the enclosing function's arena across iterations — by design. The
    LSP is responsible for surfacing forgotten `#delete`s before the
    user flashes; the runtime stays minimal.
    """
    line = node.get('line')
    cond_blk = b.new_block('while.cond')
    body_blk = b.new_block('while.body')
    end_blk = b.new_block('while.end')

    b.br(cond_blk)

    b.set_block(cond_blk)
    cond_id, cond_ty = _lower_expr(b, node['condition'], expected_kind='bool')
    if cond_ty.kind != 'i1':
        raise _csscerror(
            detail=f'while-condition must be boolean (got {cond_ty.kind})',
            line=line,
        )
    b.br_cond(cond_id, body_blk, end_blk)

    b.set_block(body_blk)
    _loop_stack(b).append((cond_blk, end_blk))
    try:
        for stmt in node.get('body', []) or []:
            if _current_block_terminates(b):
                break
            _lower_stmt(b, stmt)
    finally:
        _loop_stack(b).pop()
    if not _current_block_terminates(b):
        b.br(cond_blk)

    b.set_block(end_blk)


def _current_block_terminates(b: CIRBuilder) -> bool:
    """True if the current insertion block already has a terminator op."""
    blk = b._current_block  # noqa: SLF001 — internal access for IR-shape check
    if blk is None or not blk.ops:
        return False
    return blk.ops[-1].is_terminator()


def _lower_directive(b: CIRBuilder, node: dict) -> None:
    directive = node.get('directive')
    line = node.get('line')

    if directive in ('stack', 'heap', 'auto'):
        return _lower_slot_decl(b, node)

    if directive == 'delete':
        return _lower_delete(b, node)

    if directive == 'free':
        return _lower_free_directive(b, node)

    if directive == 'delmember':
        return _lower_delmember(b, node)

    if directive == 'req':
        return _lower_req(b, node)

    # Pure-declaration directives: `#fvar(type) name;` reserves a slot
    # for a function reference that will be populated by a later
    # `#define(name) { … }`. `#param(type) name;` does the same for a
    # parameter the body will read via `#scanp`. Neither produces any
    # runtime artefact on its own — the actual binding work happens at
    # the matching #define / #scanp site, so we just accept the
    # declaration and continue.
    if directive in ('fvar', 'param'):
        if directive == 'param':
            _pname = (node.get('var') or '').strip()
            _ptype = (node.get('arg')
                      or node.get('vtype')
                      or node.get('kind')
                      or 'int')
            if isinstance(_ptype, str):
                _ptype = _ptype.strip()
            else:
                _ptype = 'int'
            if _pname:
                _PARAM_TYPES[_pname] = _normalise_slot_type(_ptype) or _ptype
        return

    if directive == 'debug':
        msg = node.get('arg') or node.get('value') or ''
        if isinstance(msg, dict):
            msg_id, msg_ty = _lower_expr(b, msg, expected_kind='string')
            if msg_ty.kind == 'i64':
                msg_id = b.call('cssc_int_to_str', [msg_id], [INT64],
                                return_type=STRING_PTR, external=True)
                msg_ty = STRING_PTR
            elif msg_ty.kind == 'f64':
                msg_id = b.call('cssc_float_to_str', [msg_id], [FLOAT64],
                                return_type=STRING_PTR, external=True)
                msg_ty = STRING_PTR
            elif msg_ty.kind == 'i1':
                msg_id = b.call('cssc_bool_to_str', [msg_id], [BOOL],
                                return_type=STRING_PTR, external=True)
                msg_ty = STRING_PTR
            # CRITICAL: distinguish HEAP cssc_str* from RAW literal ptr.
            # cssc_string_data does GEP+8 (offset into cssc_str layout to
            # the data field). Calling it on a raw literal ptr (from
            # b.const_str, kind='ptr') GEPs past the string's actual bytes
            # into whatever adjacent .rodata constant follows — same bug
            # class as the mouse::isClicked "left"→"aster Volume" crash.
            # Symptom before this fix: every `#debug('boot: ready')` etc.
            # was pushed as garbage bytes to the devdebug ring buffer,
            # visible as truncated / mangled entries in cssc debug's log.
            if msg_ty.kind == 'string_ptr':
                data_id = b.call('cssc_string_data', [msg_id], [PTR],
                                 return_type=PTR, external=True)
                b.call('cssc_devdebug_push', [data_id], [PTR],
                       return_type=VOID, external=True)
            elif msg_ty.kind == 'ptr':
                # Raw literal ptr — already char*, pass directly.
                b.call('cssc_devdebug_push', [msg_id], [PTR],
                       return_type=VOID, external=True)
            else:
                # Fallback: materialise via string_from_lit + extract.
                fallback = b.string_from_lit(str(msg))
                data_id = b.call('cssc_string_data', [fallback], [PTR],
                                 return_type=PTR, external=True)
                b.call('cssc_devdebug_push', [data_id], [PTR],
                       return_type=VOID, external=True)
        else:
            ptr_id = b.const_str(str(msg))
            b.call('cssc_devdebug_push', [ptr_id], [PTR],
                   return_type=VOID, external=True)
        return

    # GPIO / peripherals — emit per-target runtime calls. The runtime
    # emitter (transembly) provides host stubs and per-chip MMIO; only
    # the symbols this user-module actually touches are linked, keeping
    # the firmware minimal.
    if directive in ('pin', 'i2c', 'spi', 'uart', 'adc', 'pwm', 'timer',
                     'tft', 'oled', 'video', 'matrix',
                     'framebuffer', 'console'):
        return _lower_gpio_directive(b, node)

    # Trivial 1-runtime-call directives — register the external symbol
    # and route. The runtime emitter only materialises definitions for
    # symbols actually referenced, so a program that never #panics
    # never pays for the abort path.
    if directive == 'panic':
        return _lower_panic(b, node)
    if directive == 'sysout':
        return _lower_sysout(b, node)
    if directive == 'sysarg':
        return _lower_sysarg(b, node)

    # `#adress[var] addr;` — write the slot address of `var` (cast to
    # int) into the declared int slot `addr`. The canonical escape
    # hatch for the "is it still alive?" check before `#delete`:
    #
    #     #stack[int, 64] tmp;
    #     #adress[x] tmp;
    #     if (tmp != 0x0) { #delete[x]; }
    #
    # If `var` is unbound at compile time, we store `0x0` into the
    # destination — exactly the value the runtime guard tests against.
    # See `_lower_adress` for the alias-form rejection.
    if directive == 'adress':
        return _lower_adress(b, node)

    # Compile-time constant binding: `#DEFINE name <expr>;`. The expr is
    # evaluated by `_ct_eval` (which knows cssc::time / cssc::date /
    # numeric + string literals + arithmetic) and the result is parked
    # in `_CT_CONSTS[name]`. Identifier lookups in the rest of the
    # lowering pass consult this registry first — see `_lower_expr`.
    if directive == 'DEFINE':
        return _lower_define_directive(b, node)

    # `#reserve[label]` — instantiate a deferred sector marked with
    # `?label` (CSSC spec §6.5). The sector's body is registered at
    # `sector …{…} ?label;` time but NOT emitted; this directive pulls
    # it from `_DEFERRED_SECTORS`, clears the reserve_label, and
    # recursively lowers it so its globals + init store sequence land
    # at the directive's program-order position.
    if directive == 'reserve':
        return _lower_reserve_directive(b, node)

    # `#depend['path/to/X.obj'] alias;` — pre-compiled CSSC bundle
    # produced by `cssc build src.cssc --obj [--esp8266|--esp32]`. The
    # parser routes this through the directive-shape path; forward to
    # `_lower_depend` which registers the alias in _INCLUDED_MODULES
    # so subsequent `alias::*` qualifications resolve, and queues the
    # bundle for link-time inclusion when the build orchestrator
    # consumes the per-module reference list.
    if directive == 'depend':
        return _lower_depend(b, node)
    # `#require['path/to/lib.obj'] alias;` — same shape as #depend
    # for Arduino-library bundles. Same dispatch.
    if directive == 'require':
        return _lower_require(b, node)

    # (#tft / #oled / #video / #matrix / #framebuffer / #console are now
    # handled above by the GPIO-style _lower_gpio_directive path.)

    if directive == 'load':
        return _lower_load(b, node)
    if directive == 'unload':
        return _lower_unload(b, node)

    if directive in ('thread', 'daemon', 'killdaemon', 'await', 'tlisten'):
        raise _csscerror(
            detail=f"#{directive} not yet wired into v6 native",
            hint=f"threading directives require a runtime task surface; "
                 f"use the legacy `cssc build` path for #{directive} "
                 f"until the v6 task layer lands.",
            line=line,
        )

    raise _csscerror(detail=f'unsupported directive #{directive} in v6 native',
                     hint='see [CSSC_V6_NATIVE_PLAN.md] for the roadmap',
                     line=line)


def _lower_define_directive(b: CIRBuilder, node: dict) -> None:
    """Handle `#DEFINE name <expr>;` — compile-time constant binding.

    Three forms feed this handler:
      1. `#DEFINE name;` — declares `name` as a foreign-namespace alias
         used by the transpilers. For the v6 native backend this is a
         no-op; the identifier remains unbound on the cssc:: surface.
      2. `#DEFINE __main__ 'value';` — legacy string-value form. Stash
         the literal and continue.
      3. `#DEFINE name <expr>;` — compile-time evaluated. We run the
         expression through `_ct_eval` here, in the lowering pass, and
         park the resulting Python scalar in `_CT_CONSTS[name]`. Every
         later identifier reference to `name` resolves to the baked
         value (no runtime call, no slot, immediate IR constant).
    """
    line = node.get('line')
    name = (node.get('var') or node.get('arg', '')).strip()
    if not name:
        raise _csscerror(detail='#DEFINE requires a name', line=line)
    expr = node.get('value_expr')
    str_value = node.get('value')
    if expr is None and str_value is None:
        # Form 1 — pure namespace declaration. Nothing to lower; the
        # parser already recorded the alias for the transpiler pass.
        return
    if expr is not None:
        value = _ct_eval(expr, line)
    else:
        value = str_value
    _CT_CONSTS[name] = value


def _emit_ct_constant(b: CIRBuilder, value: Any,
                      line: Optional[int]) -> Tuple[int, CIRType]:
    """Materialise a compile-time-constant Python value into the IR.

    Bool maps to ConstBool, int → ConstInt (i64), float → ConstFloat
    (f64), str → cssc_string_lit(<heap copy>). Anything else (None,
    bytes, list, …) is a bug in `_ct_eval` and raises.
    """
    if isinstance(value, bool):
        return b.const_bool(value), BOOL
    if isinstance(value, int):
        return b.const_int(value), INT64
    if isinstance(value, float):
        return b.const_float(value), FLOAT64
    if isinstance(value, str):
        # Cast to heap cssc_str so downstream identifier-load semantics
        # match a real string slot. The slot adopts the heap ptr — same
        # as `#stack[string, N] x = "literal";` would have done.
        heap_ptr = b.string_from_lit(value)
        return heap_ptr, STRING_PTR
    raise _csscerror(
        detail=f'#DEFINE: cannot emit compile-time value of type '
               f'{type(value).__name__}',
        line=line,
    )


def _ct_eval(node: dict, line: Optional[int]) -> Any:
    """Statically evaluate a CSSC expression at compile time.

    Returns a Python scalar (int / float / str / bool). Supported
    surface:
      * literals (int / float / string / bool)
      * unary +/- on numeric
      * binary + - * / % on numeric (and `+` on strings)
      * == != < > <= >= comparisons
      * cssc::time()          — Unix epoch seconds at build time (i64)
      * cssc::tick()          — ms since epoch at build time (i64)
      * cssc::date()          — 'YYYY-MM-DD' (string)
      * cssc::datetime()      — 'YYYY-MM-DDTHH:MM:SS' (string)
      * cssc::uptime()        — 0.0 (program hasn't started yet at CT)
      * cssc::env(NAME)       — os.environ.get(NAME, '') (string)
      * cssc::pi / cssc::PI   — math.pi
      * cssc::int(x), cssc::float(x), cssc::to_string(x) — conversions

    Anything outside this surface raises a CsscError pointing at the
    `#DEFINE` line so the user gets a clear error rather than a stale
    runtime null.
    """
    import os as _os
    import time as _time
    import datetime as _dt
    import math as _math

    if not isinstance(node, dict):
        raise _csscerror(
            detail=f'#DEFINE: expected an expression, got {type(node).__name__}',
            line=line,
        )
    t = node.get('type')
    if t == 'literal':
        return node.get('value')
    if t == 'string':
        return str(node.get('value', ''))
    if t == 'identifier':
        nm = node.get('name', '')
        if nm in _CT_CONSTS:
            return _CT_CONSTS[nm]
        raise _csscerror(
            detail=f"#DEFINE: identifier {nm!r} is not a compile-time "
                   f"constant (defined via another #DEFINE?)",
            hint='only literals + prior #DEFINE names can be referenced '
                 'in a compile-time expression',
            line=line,
        )
    if t == 'unary':
        op = node.get('op')
        v = _ct_eval(node.get('operand'), line)
        if op == '-': return -v
        if op == '+': return +v
        if op == '!': return not v
        raise _csscerror(detail=f'#DEFINE: unary {op!r} not supported',
                         line=line)
    if t == 'binary':
        lhs = _ct_eval(node.get('left'), line)
        rhs = _ct_eval(node.get('right'), line)
        op = node.get('op', '')
        try:
            if op == '+':  return lhs + rhs
            if op == '-':  return lhs - rhs
            if op == '*':  return lhs * rhs
            if op == '/':
                if isinstance(lhs, int) and isinstance(rhs, int):
                    return lhs // rhs   # int / int → int (Python //) on CT
                return lhs / rhs
            if op == '%':  return lhs % rhs
            if op == '==': return lhs == rhs
            if op == '!=': return lhs != rhs
            if op == '<':  return lhs < rhs
            if op == '>':  return lhs > rhs
            if op == '<=': return lhs <= rhs
            if op == '>=': return lhs >= rhs
        except (TypeError, ZeroDivisionError) as e:
            raise _csscerror(
                detail=f'#DEFINE: binary {op!r} on '
                       f'{type(lhs).__name__}/{type(rhs).__name__}: {e}',
                line=line,
            )
        raise _csscerror(detail=f'#DEFINE: binary {op!r} not supported',
                         line=line)
    if t == 'ns_call':
        ns = node.get('namespace', '')
        fn = node.get('func', '')
        args = [_ct_eval(a, line) for a in (node.get('args') or [])]
        if ns != 'cssc':
            raise _csscerror(
                detail=f'#DEFINE: only `cssc::*` calls evaluate at compile '
                       f'time (got {ns}::{fn})',
                line=line,
            )
        if fn == 'time':
            if args: raise _csscerror(
                detail='cssc::time() takes no arguments', line=line)
            return int(_time.time())
        if fn == 'tick':
            if args: raise _csscerror(
                detail='cssc::tick() takes no arguments', line=line)
            return int(_time.time() * 1000)
        if fn == 'date':
            if args: raise _csscerror(
                detail='cssc::date() takes no arguments', line=line)
            return _dt.datetime.now().strftime('%Y-%m-%d')
        if fn == 'datetime':
            if args: raise _csscerror(
                detail='cssc::datetime() takes no arguments', line=line)
            return _dt.datetime.now().strftime('%Y-%m-%dT%H:%M:%S')
        if fn == 'detime':
            # Local time as decimal-hour float: HH + MM/100.
            # 14:32 → 14.32, 09:05 → 9.05. Matches the runtime semantics
            # described in Doc §10.5f (cssc::detime() returns HH.MM).
            if args: raise _csscerror(
                detail='cssc::detime() takes no arguments', line=line)
            now = _dt.datetime.now()
            return float(now.hour) + (now.minute / 100.0)
        if fn == 'sdetime':
            # Local time with seconds: HH + MM/100 + SS/10000.
            # 14:32:45 → 14.3245. Matches Doc §10.5f.
            if args: raise _csscerror(
                detail='cssc::sdetime() takes no arguments', line=line)
            now = _dt.datetime.now()
            return (float(now.hour)
                    + (now.minute / 100.0)
                    + (now.second / 10000.0))
        if fn == 'timestamp':
            # Alias for cssc::time() — Unix epoch seconds. Some CSSC
            # programs reach for `cssc::timestamp()` reflexively; we
            # accept both spellings at compile time.
            if args: raise _csscerror(
                detail='cssc::timestamp() takes no arguments', line=line)
            return int(_time.time())
        if fn == 'uptime':
            return 0.0
        if fn == 'env':
            if len(args) != 1 or not isinstance(args[0], str):
                raise _csscerror(
                    detail='cssc::env(name) expects 1 string argument',
                    line=line)
            return _os.environ.get(args[0], '')
        if fn == 'int':
            if len(args) != 1:
                raise _csscerror(detail='cssc::int(x) expects 1 argument',
                                 line=line)
            return int(args[0])
        if fn == 'float':
            if len(args) != 1:
                raise _csscerror(detail='cssc::float(x) expects 1 argument',
                                 line=line)
            return float(args[0])
        if fn == 'to_string':
            if len(args) != 1:
                raise _csscerror(detail='cssc::to_string(x) expects 1 argument',
                                 line=line)
            return str(args[0])
        if fn == 'abs':
            if len(args) != 1:
                raise _csscerror(detail='cssc::abs(x) expects 1 argument',
                                 line=line)
            return abs(args[0])
        if fn == 'min':
            return min(args)
        if fn == 'max':
            return max(args)
        raise _csscerror(
            detail=f'#DEFINE: cssc::{fn}() not evaluable at compile time',
            hint='supported: time, timestamp, tick, date, datetime, '
                 'detime, sdetime, uptime, env, int, float, to_string, '
                 'abs, min, max',
            line=line,
        )
    if t == 'ns_access':
        ns = node.get('namespace', '')
        mem = node.get('member', '')
        if ns == 'cssc':
            if mem in ('PI', 'pi'): return _math.pi
            if mem == 'TAU':        return _math.tau
            if mem == 'E':          return _math.e
            if mem == 'SQRT2':      return _math.sqrt(2.0)
            if mem == 'LN2':        return _math.log(2.0)
            if mem == 'LN10':       return _math.log(10.0)
            if mem == 'EPSILON':    return 2.220446049250313e-16
            if mem == 'INFINITY':   return float('inf')
        raise _csscerror(
            detail=f'#DEFINE: {ns}::{mem} is not a compile-time constant',
            line=line,
        )
    raise _csscerror(
        detail=f'#DEFINE: expression node {t!r} not supported at compile time',
        hint='use literals, cssc::time/date/env, or arithmetic on those',
        line=line,
    )


def _lower_free_directive(b: CIRBuilder, node: dict) -> None:
    """Lower `#free[Sector];` — run the sector's free block.

    Phase 4a: looks up the sector in `_SECTORS`; if found, lowers each
    statement in the recorded free_body at the current insertion point.
    The free_body's `#delete[member]` statements only work when those
    members are visible in the current scope (top-level sectors with
    pure-function bodies have no per-instance slots, so the typical
    free block is empty in Phase 4a).
    """
    line = node.get('line')
    name = (node.get('arg') or node.get('var') or '').strip()
    if not name:
        raise _csscerror(detail='#free requires a target name',
                         hint='Usage: #free[Sector];', line=line)
    # Resolve target: sector name, object instance handle, or included
    # module alias. `#free[name]` on a bare object TYPE is not allowed —
    # use `#free[instance]` for that.
    target_kind = None     # 'sector' | 'instance' | 'module'
    target_name = None
    if name in _SECTORS:
        target_kind, target_name = 'sector', name
    elif name in _INSTANCES:
        target_kind, target_name = 'instance', name
    elif name in _INCLUDED_MODULES:
        target_kind, target_name = 'module', name
    elif name in _OBJECTS:
        raise _csscerror(
            detail=f"#free[{name}]: {name!r} is an object type, not an instance",
            hint=f"declare an instance: `{name}() my_inst;` and `#free[my_inst];`",
            line=line,
        )
    else:
        raise _csscerror(
            detail=f'#free: {name!r} is not a known sector / instance / module alias',
            hint=f'sectors: {sorted(_SECTORS.keys())}, '
                 f'instances: {sorted(_INSTANCES.keys())}, '
                 f'modules: {sorted(_INCLUDED_MODULES.keys())}',
            line=line,
        )
    if target_kind == 'module':
        # v6 native modules don't carry per-instance heap state — the
        # cssc:: namespace is provided by the runtime, which is shared
        # across the whole program. `#free[alias]` just unbinds the
        # alias from the lowerer's registry; no runtime call needed.
        _INCLUDED_MODULES.pop(target_name, None)
        return

    # Member bindings are scoped; save + restore so #free's auxiliary
    # name bindings don't leak into user_main.
    saved_slots = dict(b._slots)         # noqa: SLF001
    saved_kinds = dict(b._slot_kinds)    # noqa: SLF001
    try:
        if target_kind == 'sector':
            _bind_sector_members(b, target_name)
            free_body = _SECTORS[target_name].get('free_body', []) or []
            for stmt in free_body:
                _lower_stmt(b, stmt)
        else:
            obj_type = _INSTANCES[target_name]
            handle = saved_slots.get(target_name)
            if handle is None:
                raise _csscerror(
                    detail=f'instance handle {target_name!r} not in scope',
                    line=line,
                )
            inst_ptr = b.slot_load(handle, 'object_handle')
            _bind_object_members(b, obj_type, inst_ptr)
            free_body = _OBJECTS[obj_type].get('free_body', []) or []
            for stmt in free_body:
                _lower_stmt(b, stmt)
            # A.3.14: automatically release every heap-typed member the
            # user didn't explicitly `#delete` in the free block. Without
            # this, an object whose user forgot to write a free body (or
            # whose free body skipped a member) would leak its string /
            # vector / map heap data. We do this AFTER the user free
            # block so user code can still grab member values before
            # they're released. The release dispatches per-kind through
            # the runtime release symbols (string → cssc_release with
            # refcount cascade; vector → cssc_vector_free_*; etc.).
            obj_info = _OBJECTS[obj_type]
            for mname, meta in obj_info.get('slots', {}).items():
                mkind = meta.get('kind', '')
                if not _is_heap_kind(mkind):
                    continue
                field_addr = b.member_addr(inst_ptr,
                                           obj_info['struct_ty'],
                                           meta['field_idx'])
                # The slot release path handles per-kind dispatch — we
                # just have to feed it a slot ptr.
                b.slot_release(field_addr, mkind)
            # Finally hand the heap block back to the runtime allocator.
            b.call('cssc_obj_free', [inst_ptr], [PTR],
                   return_type=VOID, external=True)
    finally:
        b._slots = saved_slots           # noqa: SLF001
        b._slot_kinds = saved_kinds      # noqa: SLF001
    if target_kind == 'instance':
        # A.3.13: drop the instance from the current function's
        # _INSTANCES scope only — _instance_stack(b) ensures a stale
        # entry in an outer frame doesn't bleed into a sibling function.
        _instance_unbind(target_name)
        # The handle slot itself stays alloca'd; we just unbind the name.
        b.scope_unbind(target_name)


def _lower_slot_decl(b: CIRBuilder, node: dict) -> None:
    directive = node['directive']
    name = node['var']
    line = node.get('line')

    if directive == 'auto':
        # `#auto[type]` — bits defaults to 64
        vtype = node['arg'].strip()
        bits = 64
    else:
        vtype, bits = _parse_slot_arg(node['arg'])

    # Capture the strict element constraint of a typed bind
    # (`bind<int>` → 'int') BEFORE normalisation collapses it to the
    # generic `bind_entry` kind. `bind<auto>` / bare `bind` → None.
    bind_elem = _bind_declared_elem(vtype)
    vtype = _normalise_slot_type(vtype)

    # Float bit-width policy: CSSC v6 native uses double-precision (i64-
    # backed float64) throughout the pipeline — arithmetic, compare,
    # print, the bind-cell tag for FLOAT all expect 8-byte storage.
    # Declaring `#stack[float, N]` with N<64 used to silently allocate
    # an i32-backed float32 slot, but downstream `slot_load` reads it
    # back as float64 and gets a tiny denormal (≈5e-315), which then
    # mis-compares against any sane runtime value (e.g. uptime > 0
    # always evaluates as `True ≥ denormal` → instant loop break, see
    # videodriver.cssc shutdownAt-after-1s bug). Reject it explicitly
    # so the user sees a clear migration hint instead of mysteriously-
    # short loops.
    if vtype == 'float' and bits < 64:
        raise _csscerror(
            detail=f'#{directive}[float, {bits}] {name}: float slots must '
                   f'be ≥ 64 bits',
            hint=(f'CSSC v6 native uses double-precision (64-bit) floats '
                  f'throughout — arithmetic, compare, print all expect '
                  f'8-byte storage. A narrower slot is stored as float32 '
                  f'but loaded as float64, producing a denormal value. '
                  f'Change to:  #{directive}[float, 64] {name} = …;'),
            line=line,
        )

    if vtype == 'auto':
        vtype = 'int'
        bits = 64 if bits <= 0 else bits

    if vtype not in SUPPORTED_SLOT_TYPES:
        hint = f"Currently supported: {', '.join(sorted(SUPPORTED_SLOT_TYPES))}"
        if vtype.startswith('map<'):
            hint = (
                f"Supported maps: map<int,int>, map<int,float>, "
                f"map<int,string>, map<string,int>, map<string,float>, "
                f"map<string,string> (plus single-arg map<int> / map<string> "
                f"and map<auto>). Float-/bool-keyed maps are not supported "
                f"natively.\n"
                f"For `array<map<K, V>>` Buffer storage, push pairs "
                f"directly:\n"
                f"  #stack[array<bind>, N] Buffer = {{}};\n"
                f"  Buffer.push_back({{key, value}});\n"
                f"No intermediate `#heap[map<…>, …] m = {{k, v}}; "
                f"Buffer.push_back(m);` needed."
            )
        raise _csscerror(
            detail=f"slot type {vtype!r} not yet supported by v6 native",
            hint=hint,
            line=line,
        )

    if not name:
        raise _csscerror(detail='slot declaration requires a name',
                         hint=f'Usage: #{directive}[{vtype}, {bits}] my_var = ...;',
                         line=line)

    # `Obj->Member` slot decls inside a label body are not yet
    # supported on native (the member needs to be a struct field
    # declared at object-construction time, but this directive
    # appears mid-body). Surface a clear migration hint instead of
    # silently allocating a local slot whose lifetime/visibility
    # doesn't match the user's intent.
    if '->' in name and b._current_fn is not None:                    # noqa: SLF001
        fn_name = b._current_fn.name                                   # noqa: SLF001
        # Detect "inside an object label body": label functions are
        # named `cssc_obj_<Type>_<labelname>` per `_emit_label_function`.
        if fn_name.startswith('cssc_obj_'):
            obj_prefix, _, member_part = name.partition('->')
            raise _csscerror(
                detail=(f'#{directive}[{vtype}, {bits}] {name}: '
                        f'member slot declarations inside label bodies '
                        f'are not yet supported on native'),
                hint=(f'Declare `{name}` as an object member at the '
                      f'top of `object {obj_prefix} {{ … }}` and '
                      f'assign to it from inside the label:\n\n'
                      f'  object {obj_prefix} {{ \n'
                      f'      #{directive}[{vtype}, {bits}] '
                      f'{obj_prefix}->{member_part} = …;\n'
                      f'      _label: {obj_prefix}->{member_part} = '
                      f'"new value";\n'
                      f'  }}'),
                line=line,
            )

    # Top-level slot promotion: if a `#define`/`#cdefine` body `#req`s
    # this name (detected by `_collect_req_targets` at lower_program
    # entry), allocate it as a module global instead of a main-local
    # alloca so the function body can resolve it through `global_addr`.
    # Restricted to POD kinds for now — heap kinds need a separate
    # init/teardown strategy at module-init time.
    cur_fn = b._current_fn                                   # noqa: SLF001
    at_main = cur_fn is not None and cur_fn.name == 'cssc_user_main'
    promoted = (at_main and name in _PROMOTED_GLOBALS)
    if promoted:
        if vtype not in _SECTOR_MEMBER_KINDS:
            raise _csscerror(
                detail=f"#req on slot {name!r}: kind {vtype!r} can't be "
                       f"promoted to a module global",
                hint=f'allowed kinds: {sorted(_SECTOR_MEMBER_KINDS)}',
                line=line,
            )
        info = _PROMOTED_GLOBALS[name]
        info['kind'] = vtype
        info['bits'] = bits
        sym = info['sym']
        b.register_module_global(sym, _kind_to_storage_ty(vtype))
        slot = b.global_addr(sym)
        b.scope_bind(name, slot, vtype)
    else:
        slot = b.slot_alloc(vtype, bits)
        b.scope_bind(name, slot, vtype)

    init = node.get('value')
    _is_vec = vtype in ('vector_int', 'vector_float', 'array_int',
                         'array_float', 'array_string',
                         'vector_bool',                # Phase A.1
                         'vector_string',              # Phase A.2
                         'array_bool')                 # Phase A.3
    if init is not None:
        _init_t = init.get('type') if isinstance(init, dict) else None
        if (vtype in _CONTAINER_PARAM_KINDS and _init_t not in (
                'array', 'array_literal', 'map_literal', 'bind_literal')):
            # Container slot initialised from an EXPRESSION rather than a
            # literal — a `&copy`, a function return, or another container
            # slot. Lower it to a heap container ptr and adopt it directly
            # (fresh slot → no old value to release; a `&copy`/call return
            # is already a single owner).
            val_id, val_type = _lower_expr(b, init, expected_kind=vtype)
            if val_type.kind not in ('ptr', 'string_ptr'):
                raise _csscerror(
                    detail=(f'{vtype} slot init: expression of kind '
                            f'{val_type.kind!r} is not a container pointer'),
                    line=line)
            b.slot_store(slot, val_id, PTR)
        elif _is_vec:
            _init_vector(b, slot, vtype, init, bits, line)
        elif vtype == 'string':
            _init_string(b, slot, init, line)
        elif vtype == 'map_si':
            _init_map_si(b, slot, init, bits, line)
        elif vtype == 'map_ss':
            _init_map_ss(b, slot, init, bits, line)
        elif vtype == 'map_is':
            _init_map_is(b, slot, init, bits, line)
        elif vtype == 'map_ii':
            _init_map_ii(b, slot, init, bits, line)
        elif vtype == 'map_sf':
            _init_map_sf(b, slot, init, bits, line)
        elif vtype == 'map_if':
            _init_map_if(b, slot, init, bits, line)
        elif vtype == 'bind_ss':
            _init_bind_ss(b, slot, init, bits, line)
        elif vtype == 'bind_entry':
            _init_bind_entry(b, slot, init, bits, line,
                             declared_elem=bind_elem)
        elif vtype == 'array_bind':
            _init_array_bind(b, slot, init, bits, line)
        else:
            val_id, val_type = _lower_expr(b, init, expected_kind=vtype)
            _store_to_slot(b, slot, vtype, val_id, val_type, line)
    elif _is_vec:
        # No initialiser: still need a runtime new() so the slot holds a
        # valid ptr (slot_release would otherwise free garbage).
        _init_vector(b, slot, vtype, {'type': 'array', 'elements': []}, bits, line)
    elif vtype == 'map_si':
        # Empty default — allocate a runtime map with min capacity.
        _init_map_si(b, slot, {'type': 'map_literal', 'pairs': []}, bits, line)
    elif vtype == 'map_ss':
        _init_map_ss(b, slot, {'type': 'map_literal', 'pairs': []}, bits, line)
    elif vtype == 'map_is':
        _init_map_is(b, slot, {'type': 'map_literal', 'pairs': []}, bits, line)
    elif vtype == 'map_ii':
        _init_map_ii(b, slot, {'type': 'map_literal', 'pairs': []}, bits, line)
    elif vtype == 'map_sf':
        _init_map_sf(b, slot, {'type': 'map_literal', 'pairs': []}, bits, line)
    elif vtype == 'map_if':
        _init_map_if(b, slot, {'type': 'map_literal', 'pairs': []}, bits, line)
    elif vtype == 'bind_ss':
        _init_bind_ss(b, slot, {'type': 'bind_literal', 'pairs': []}, bits, line)
    elif vtype == 'bind_entry':
        _init_bind_entry(b, slot, {'type': 'array_literal', 'items': []},
                         bits, line, declared_elem=bind_elem)
    elif vtype == 'array_bind':
        _init_array_bind(b, slot, {'type': 'array_literal', 'items': []},
                         bits, line)
    elif vtype == 'string':
        # Empty default — store a heap-allocated empty cssc_str so release
        # is safe even if the user never assigns. cssc_string_lit handles
        # zero-length input by allocating a 1-byte data buffer.
        _init_string(b, slot, {'type': 'string', 'value': ''}, line)


# A string-typed RHS expression either BORROWS a live owner (another
# slot, a string member, or a vector<string>/array<string> element) or is
# a fresh TRANSIENT (literal, concat, deep-copy, or a call/ns-call return
# which — after the mirror deep-copy/retain fix — always yields a fresh
# refcount=1 buffer). A borrow must be retained on adoption so the source
# owner's later release only decrements the shared refcount instead of
# freeing a buffer the new slot still points at (the item_name/item_asset
# per-frame use-after-free). A transient is already refcount=1 with no
# other owner, so retaining it would leak. These are the exact borrow node
# shapes the read-side lowering can produce for a `string_ptr` value.
_STRING_ALIAS_NODE_TYPES = frozenset({
    'identifier',       # another string slot
    'arrow_access',     # Obj->member reading a string member
    'dot_access',       # obj.member reading a string member
    'index',            # container[i] reading a vector<string>/array<string> elem
})


def _rhs_is_string_alias(node: Optional[dict]) -> bool:
    """True iff `node` borrows a live string owner (needs retain-on-adopt).

    Only meaningful once the value is already known to be `string_ptr`;
    the caller gates on that, so an `index` that byte-indexes a string
    (which lowers to an int, never reaching here) is not a false positive.
    """
    return isinstance(node, dict) and node.get('type') in _STRING_ALIAS_NODE_TYPES


def _init_string(b: CIRBuilder, slot_id: int, init_node: dict,
                 line: Optional[int]) -> None:
    """Initialise a string slot from any string-typed expression.

    Accepts:
      * `{type: 'string', value: '...'}` — literal, materialised via
        cssc_string_lit (heap copy of the bytes).
      * `{type: 'binary', op: '+', ...}` with string operands — the
        concat result returns a fresh heap cssc_str the slot adopts.
      * `{type: 'copy_of', operand}` — deep-copies the source string.
      * Any other expression whose lowering yields STRING_PTR (e.g.
        another string slot via identifier-lookup) — the slot takes
        the heap pointer as-is (caller is expected to use `&` if
        independence is needed).

    Empty strings still allocate a header so `#delete` always has a
    valid heap pointer to free.
    """
    init_t = init_node.get('type')
    if init_t == 'string':
        text = init_node.get('value', '')
        heap_ptr = b.string_from_lit(text)
        b.slot_store(slot_id, heap_ptr, PTR)
        return

    # General path: lower the expression; the result must be a heap
    # cssc_str pointer (STRING_PTR) — anything else is a type error.
    val_id, val_ty = _lower_expr(b, init_node)
    if val_ty.kind != 'string_ptr':
        # Tolerate raw ptr from a literal that escaped string-promotion.
        if val_ty.kind == 'ptr' and init_t == 'string':
            heap_ptr = b.string_from_lit(init_node.get('value', ''))
            b.slot_store(slot_id, heap_ptr, PTR)
            return
        raise _csscerror(
            detail=f'string slot init: expression of kind {val_ty.kind!r} '
                   f'is not a string',
            hint='use a string literal, another string slot, or s + " ..."',
            line=line,
        )
    b.slot_store(slot_id, val_id, PTR)
    # A.3.4: if the RHS BORROWS a live owner — another string slot
    # (`identifier`), a string member (`Obj->m`), or a vector<string> /
    # array<string> element (`Vec[i]`) — bump the refcount so the source
    # owner's release only decrements the shared count instead of freeing
    # the buffer this slot still points at. This is the item_name /
    # item_asset per-frame use-after-free: `#stack[string] r =
    # ItemDb->_name[idx]` is an `index` read that previously skipped the
    # retain, so `#delete[r]` (or scope exit) freed the catalog's own
    # string. Fresh allocations (cssc_string_lit / cssc_string_concat /
    # cssc_*_to_str / cssc_string_copy / call returns) already own
    # refcount=1 with no other owner, so they must NOT be retained (leak).
    if _rhs_is_string_alias(init_node):
        b.slot_retain(slot_id, 'string')


def _init_vector(b: CIRBuilder, slot_id: int, slot_kind: str,
                 init_node: dict, bits_hint: int,
                 line: Optional[int]) -> None:
    """Initialise a vector<T> / array<T> slot from a literal or empty default.

    Dispatches on `slot_kind` ∈ {'vector_int', 'vector_float',
    'array_int', 'array_float'} to call the matching runtime symbols
    (`cssc_vector_new_int` / `_new_float`, push variants, …). Element
    type is taken from `_VECTOR_TRAITS`. Both AST literal shapes are
    accepted — `array` (for `[a,b,c]`) and `array_literal` (for
    `{a,b,c}`).
    """
    init_t = init_node.get('type')
    if init_t == 'array':
        elements = init_node.get('elements', []) or []
    elif init_t == 'array_literal':
        elements = init_node.get('items', []) or []
    elif (init_t == 'map_literal'
            and not (init_node.get('pairs') or [])):
        # Empty `{}` is structurally ambiguous (map / array / bind all
        # share that surface syntax), so the parser routes it to
        # `map_literal` with no pairs. Accept it here as the
        # canonical "empty container of THIS kind" — what the user
        # typed for `#stack[array<int>, N] x = {};`. Non-empty
        # `{k: v, …}` still rejects, because that has unambiguous
        # map-shape and would silently drop the keys here.
        elements = []
    else:
        raise _csscerror(
            detail=f'{slot_kind} initialiser must be an array/list literal',
            hint=f'use:  #stack[{slot_kind.replace("_", "<") + ">"}, N] x = [..];  or  = {{..}};',
            line=line,
        )

    traits = _vector_traits(slot_kind)
    elem_ty = traits['elem']
    rt = traits['rt']
    expected = traits['expected']
    cap_hint = b.const_int(max(len(elements), 4))
    vec_ptr = b.call(f'cssc_vector_new_{rt}', [cap_hint], [INT64],
                     return_type=PTR, external=True)
    b.slot_store(slot_id, vec_ptr, PTR)
    for elem in elements:
        val_id, val_type = _lower_expr(b, elem, expected_kind=expected)
        # Phase 5b + A.2: for array<string> / vector<string>, accept any
        # string-shaped value:
        #   * `string_ptr` — fresh cssc_str* from concat / *_to_str
        #   * `ptr`        — raw literal needing string_from_lit promotion
        # The runtime push (`cssc_vector_push_string`) adopts the cssc_str*
        # ref, so promotion is mandatory for raw literals.
        if slot_kind in ('array_string', 'vector_string'):
            if val_type.kind == 'ptr':
                # Raw literal in expression position — parser returned a
                # ptr to the literal pool. Promote to a heap cssc_str so
                # the container owns a real refcount-managed entry.
                raw_text = elem.get('value', '') if elem.get('type') == 'string' else ''
                val_id = b.string_from_lit(raw_text)
            elif val_type.kind != 'string_ptr':
                raise _csscerror(
                    detail=f'{slot_kind}: element must be a string '
                           f'(got {val_type.kind})',
                    line=line,
                )
        elif val_type.kind != elem_ty.kind:
            raise _csscerror(
                detail=f'{slot_kind}: element must be {expected} '
                       f'(got {val_type.kind})',
                line=line,
            )
        # Reload ptr — we don't trust SSA reuse across multiple pushes.
        cur_ptr = b.slot_load(slot_id, slot_kind)
        # For array_string / vector_string, push takes a `ptr` (cssc_str*).
        # For numeric vectors, push takes the elem_ty (i64 / double / i1).
        push_arg_ty = (PTR if slot_kind in ('array_string', 'vector_string')
                       else elem_ty)
        b.call(f'cssc_vector_push_{rt}', [cur_ptr, val_id], [PTR, push_arg_ty],
               return_type=VOID, external=True)


# Back-compat alias — `_init_vector_int` was a stable callable name during
# Phase 3.0. Keep it as a thin wrapper so any external caller doesn't break.
def _init_vector_int(b: CIRBuilder, slot_id: int, init_node: dict,
                     bits_hint: int, line: Optional[int]) -> None:
    _init_vector(b, slot_id, 'vector_int', init_node, bits_hint, line)


def _init_container_slot(b: CIRBuilder, slot_id: int, kind: str,
                          init_node: dict, bits_hint: int,
                          line: Optional[int]) -> bool:
    """Materialise a container literal into an already-allocated ptr slot.

    Dispatches to the per-kind runtime constructor (`cssc_vector_new_*`,
    `cssc_map_new_*`, `cssc_bind_*`, …) exactly as the `#stack`/`#heap`
    slot-declaration path does — this is the single source of truth for
    "build container `kind` from `init_node`", reused by both the slot
    initialiser and the `#define` call-argument path so a container
    literal produces byte-identical runtime state whether it lands in a
    named slot or a transient call-arg temp.

    Returns True when `kind` was a recognised container and built; False
    otherwise (so callers can fall through to their scalar handling).
    """
    if kind in _VECTOR_INITABLE_KINDS:
        _init_vector(b, slot_id, kind, init_node, bits_hint, line)
    elif kind == 'map_si':
        _init_map_si(b, slot_id, init_node, bits_hint, line)
    elif kind == 'map_ss':
        _init_map_ss(b, slot_id, init_node, bits_hint, line)
    elif kind == 'map_is':
        _init_map_is(b, slot_id, init_node, bits_hint, line)
    elif kind == 'map_ii':
        _init_map_ii(b, slot_id, init_node, bits_hint, line)
    elif kind == 'map_sf':
        _init_map_sf(b, slot_id, init_node, bits_hint, line)
    elif kind == 'map_if':
        _init_map_if(b, slot_id, init_node, bits_hint, line)
    elif kind == 'bind_ss':
        _init_bind_ss(b, slot_id, init_node, bits_hint, line)
    elif kind == 'bind_entry':
        _init_bind_entry(b, slot_id, init_node, bits_hint, line)
    elif kind == 'array_bind':
        _init_array_bind(b, slot_id, init_node, bits_hint, line)
    else:
        return False
    return True


def _empty_container_init_node(kind: str) -> dict:
    """The canonical empty-literal AST node for a container `kind` — used
    when a call passes fewer args than a container `#scanp` position needs
    (OOB → empty container, never a null deref)."""
    if kind in ('bind_ss',):
        return {'type': 'bind_literal', 'pairs': []}
    if kind in ('bind_entry', 'array_bind'):
        return {'type': 'array_literal', 'items': []}
    if kind.startswith('map_'):
        return {'type': 'map_literal', 'pairs': []}
    return {'type': 'array', 'elements': []}


# ---------------------------------------------------------------------------
# Phase 3: map<string, int> lowering.
# ---------------------------------------------------------------------------
def _string_lit_ptr_len(b: CIRBuilder, text: str) -> Tuple[int, int]:
    """Emit `(ptr_to_literal_global, i64_byte_length)` for a string literal.

    Used for map keys: the runtime takes (data, len) and copies the bytes
    internally, so the caller never owns a transient heap cssc_str just
    for lookup.
    """
    encoded_len = len(text.encode('utf-8'))
    ptr_id = b.const_str(text)
    len_id = b.const_int(encoded_len)
    return ptr_id, len_id


def _string_key_ptr_len(b: CIRBuilder, key_node: dict,
                        line: Optional[int]) -> Tuple[int, int]:
    """Resolve a string-typed key expression to (data_ptr_ssa, len_ssa).

    Two shapes are accepted:
      * `{type: 'string', value: '...'}` — parser literal: pull from global
      * `{type: 'identifier', name: 's'}` referring to a string slot:
        load the cssc_str* + call cssc_string_data / cssc_string_size

    The runtime takes raw (data, len) pairs and copies the bytes
    internally on insert, so the caller never juggles heap-string
    ownership for keys.
    """
    t = key_node.get('type')
    if t == 'string':
        return _string_lit_ptr_len(b, key_node.get('value', ''))
    if t == 'identifier':
        name = key_node.get('name', '')
        if not b.scope_has(name) or b.scope_kind(name) != 'string':
            raise _csscerror(
                detail=f"map key must be a string literal or string slot "
                       f"(got identifier {name!r})",
                line=line,
            )
        slot = b.scope_lookup(name)
        s_ptr = b.slot_load(slot, 'string')
        data_id = b.call('cssc_string_data', [s_ptr], [PTR],
                         return_type=PTR, external=True)
        len_id = b.call('cssc_string_size', [s_ptr], [PTR],
                        return_type=INT64, external=True)
        return data_id, len_id
    raise _csscerror(
        detail=f"map key expression of type {t!r} not supported in Phase 3",
        hint='use a string literal or a #stack[string, N] variable',
        line=line,
    )


def _init_map_si(b: CIRBuilder, slot_id: int, init_node: dict,
                 bits_hint: int, line: Optional[int]) -> None:
    """Initialise a map<string, int> slot from a map_literal or empty default."""
    init_t = init_node.get('type')
    if init_t != 'map_literal':
        raise _csscerror(
            detail='map<string, int> initialiser must be a map literal',
            hint="use:  #stack[map<string, int>, N] m = {'k': v, ...};",
            line=line,
        )
    pairs = init_node.get('pairs', []) or []
    # Parser pairs are [(str_key, value_expr), ...] — key is a plain str,
    # not an AST node.
    cap_hint = b.const_int(max(len(pairs) * 2, 8))
    map_ptr = b.call('cssc_map_si_new', [cap_hint], [INT64],
                     return_type=PTR, external=True)
    b.slot_store(slot_id, map_ptr, PTR)

    for key, val_expr in pairs:
        if not isinstance(key, str):
            raise _csscerror(
                detail='map<string, int> key must be a string literal',
                line=line,
            )
        val_id, val_ty = _lower_expr(b, val_expr, expected_kind='int')
        if val_ty.kind != 'i64':
            raise _csscerror(
                detail=f'map<string, int>: value must be int (got {val_ty.kind})',
                line=line,
            )
        cur_ptr = b.slot_load(slot_id, 'map_si')
        kp, kl = _string_lit_ptr_len(b, key)
        b.call('cssc_map_si_set',
               [cur_ptr, kp, kl, val_id],
               [PTR, PTR, INT64, INT64],
               return_type=VOID, external=True)


def _lower_map_si_index_read(b: CIRBuilder, slot_id: int, idx_node: dict,
                             line: Optional[int]) -> Tuple[int, CIRType]:
    map_ptr = b.slot_load(slot_id, 'map_si')
    kp, kl = _string_key_ptr_len(b, idx_node, line)
    result = b.call('cssc_map_si_get', [map_ptr, kp, kl],
                    [PTR, PTR, INT64],
                    return_type=INT64, external=True)
    return result, INT64


def _lower_map_si_index_assign(b: CIRBuilder, slot_id: int,
                               idx_node: dict, val_node: dict,
                               line: Optional[int]) -> None:
    val_id, val_ty = _lower_expr(b, val_node, expected_kind='int')
    if val_ty.kind != 'i64':
        raise _csscerror(
            detail=f'map<string, int>[k] = v: value must be int (got {val_ty.kind})',
            line=line,
        )
    map_ptr = b.slot_load(slot_id, 'map_si')
    kp, kl = _string_key_ptr_len(b, idx_node, line)
    b.call('cssc_map_si_set',
           [map_ptr, kp, kl, val_id],
           [PTR, PTR, INT64, INT64],
           return_type=VOID, external=True)


# ---------------------------------------------------------------------------
# Phase A.4-A.6: 5 new map<K,V> variants (ss, is, ii, sf, if).
# ---------------------------------------------------------------------------
def _int_key_arg(b: CIRBuilder, key_node: dict,
                 line: Optional[int]) -> int:
    """Lower a key expression with int-kind expectation; return the i64 SSA.

    Used by int-keyed map variants (map_is, map_ii, map_if). The runtime
    accepts the raw i64 directly; no widening / cast is needed.
    """
    val_id, val_ty = _lower_expr(b, key_node, expected_kind='int')
    if val_ty.kind != 'i64':
        raise _csscerror(
            detail=f'int-keyed map: key must be int (got {val_ty.kind})',
            hint='use an integer literal or an in-scope int slot',
            line=line,
        )
    return val_id


def _coerce_float_arg(b: CIRBuilder, val_id: int, val_ty: 'CIRType',
                      line: Optional[int]) -> int:
    """Coerce an f32 SSA to f64 for the float-valued map variants.

    The runtime's set/get use `double` for float values, so a 32-bit
    operand from a narrowed slot needs `__extendsfdf2` before the call.
    """
    if val_ty.kind == 'f64':
        return val_id
    if val_ty.kind == 'f32':
        return b.call('__extendsfdf2', [val_id], [FLOAT32],
                      return_type=FLOAT64, external=True)
    raise _csscerror(
        detail=f'float-valued map: value must be float (got {val_ty.kind})',
        line=line,
    )


def _string_value_arg(b: CIRBuilder, val_node: dict,
                      line: Optional[int]) -> int:
    """Lower a string-typed value expression to a cssc_str* SSA.

    Raw ptr from a literal in expression position is promoted via
    cssc_string_lit (mirrors the vector_string pattern). String slots
    already hold a cssc_str* — no promotion needed.
    """
    val_id, val_ty = _lower_expr(b, val_node, expected_kind='string')
    if val_ty.kind == 'ptr':
        raw_text = (val_node.get('value', '')
                    if isinstance(val_node, dict)
                       and val_node.get('type') == 'string'
                    else '')
        return b.string_from_lit(raw_text)
    if val_ty.kind != 'string_ptr':
        raise _csscerror(
            detail=f'string-valued map: value must be string '
                   f'(got {val_ty.kind})',
            line=line,
        )
    return val_id


# -------- map<string, string> --------
def _init_map_ss(b: CIRBuilder, slot_id: int, init_node: dict,
                 bits_hint: int, line: Optional[int]) -> None:
    init_t = init_node.get('type')
    if init_t != 'map_literal':
        raise _csscerror(
            detail='map<string, string> initialiser must be a map literal',
            hint="use:  #stack[map<string, string>, N] m = {'k': 'v', ...};",
            line=line,
        )
    pairs = init_node.get('pairs', []) or []
    cap_hint = b.const_int(max(len(pairs) * 2, 8))
    map_ptr = b.call('cssc_map_ss_new', [cap_hint], [INT64],
                     return_type=PTR, external=True)
    b.slot_store(slot_id, map_ptr, PTR)
    for key, val_expr in pairs:
        if not isinstance(key, str):
            raise _csscerror(
                detail='map<string, string> key must be a string literal',
                line=line,
            )
        cur_ptr = b.slot_load(slot_id, 'map_ss')
        kp, kl = _string_lit_ptr_len(b, key)
        val_id = _string_value_arg(b, val_expr, line)
        b.call('cssc_map_ss_set',
               [cur_ptr, kp, kl, val_id],
               [PTR, PTR, INT64, PTR],
               return_type=VOID, external=True)


def _lower_map_ss_index_read(b: CIRBuilder, slot_id: int, idx_node: dict,
                             line: Optional[int]) -> Tuple[int, CIRType]:
    map_ptr = b.slot_load(slot_id, 'map_ss')
    kp, kl = _string_key_ptr_len(b, idx_node, line)
    result = b.call('cssc_map_ss_get', [map_ptr, kp, kl],
                    [PTR, PTR, INT64],
                    return_type=STRING_PTR, external=True)
    return result, STRING_PTR


def _lower_map_ss_index_assign(b: CIRBuilder, slot_id: int,
                               idx_node: dict, val_node: dict,
                               line: Optional[int]) -> None:
    val_id = _string_value_arg(b, val_node, line)
    map_ptr = b.slot_load(slot_id, 'map_ss')
    kp, kl = _string_key_ptr_len(b, idx_node, line)
    b.call('cssc_map_ss_set',
           [map_ptr, kp, kl, val_id],
           [PTR, PTR, INT64, PTR],
           return_type=VOID, external=True)


# -------- map<int, string> --------
def _init_map_is(b: CIRBuilder, slot_id: int, init_node: dict,
                 bits_hint: int, line: Optional[int]) -> None:
    init_t = init_node.get('type')
    if init_t != 'map_literal':
        raise _csscerror(
            detail='map<int, string> initialiser must be a map literal',
            hint="use:  #stack[map<int, string>, N] m = {0: 'a', ...};",
            line=line,
        )
    pairs = init_node.get('pairs', []) or []
    cap_hint = b.const_int(max(len(pairs) * 2, 8))
    map_ptr = b.call('cssc_map_is_new', [cap_hint], [INT64],
                     return_type=PTR, external=True)
    b.slot_store(slot_id, map_ptr, PTR)
    for key_node, val_expr in pairs:
        # Parser may hand back a bare int (legacy shape) or an AST node
        # for the int-keyed map literal. Normalise both into an SSA via
        # _int_key_arg.
        if isinstance(key_node, int):
            key_node = {'type': 'int_lit', 'value': key_node}
        cur_ptr = b.slot_load(slot_id, 'map_is')
        k_id = _int_key_arg(b, key_node, line)
        val_id = _string_value_arg(b, val_expr, line)
        b.call('cssc_map_is_set',
               [cur_ptr, k_id, val_id],
               [PTR, INT64, PTR],
               return_type=VOID, external=True)


def _lower_map_is_index_read(b: CIRBuilder, slot_id: int, idx_node: dict,
                             line: Optional[int]) -> Tuple[int, CIRType]:
    map_ptr = b.slot_load(slot_id, 'map_is')
    k_id = _int_key_arg(b, idx_node, line)
    result = b.call('cssc_map_is_get', [map_ptr, k_id],
                    [PTR, INT64],
                    return_type=STRING_PTR, external=True)
    return result, STRING_PTR


def _lower_map_is_index_assign(b: CIRBuilder, slot_id: int,
                               idx_node: dict, val_node: dict,
                               line: Optional[int]) -> None:
    val_id = _string_value_arg(b, val_node, line)
    map_ptr = b.slot_load(slot_id, 'map_is')
    k_id = _int_key_arg(b, idx_node, line)
    b.call('cssc_map_is_set',
           [map_ptr, k_id, val_id],
           [PTR, INT64, PTR],
           return_type=VOID, external=True)


