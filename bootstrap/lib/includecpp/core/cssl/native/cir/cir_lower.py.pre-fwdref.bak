    # ---- mouse (global-default surface) ------------------------------
    # `mouse::method(...)` calls address a lazily-created global mouse
    # handle; the runtime routes them through cssc_mouse_default_*. For
    # window-bound calls, `#stack[auto] mc = mouse::client(video);` binds
    # a PTR-holding int slot and `mc.method(...)` dispatches through the
    # int-slot fallback in `_lower_dot_call` directly to cssc_mouse_*.
    ('mouse', 'create'):            _DispatchSpec('cssc_mouse_new',
                                                   [PTR], PTR, 'both'),
    ('mouse', 'new'):               _DispatchSpec('cssc_mouse_new',
