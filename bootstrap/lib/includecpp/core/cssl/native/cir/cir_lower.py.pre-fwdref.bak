# ---------------------------------------------------------------------------
# Phase 3: bind (string -> string pair list) lowering.
# ---------------------------------------------------------------------------
def _string_arg_to_heap(b: CIRBuilder, node: dict,
                        line: Optional[int]) -> int:
    """Materialise a string AST node (literal or identifier-of-string-slot)
    as a heap-allocated cssc_str* via cssc_string_lit.

    For literals: emit cssc_string_lit(global_ptr, len) which mallocs a
    fresh cssc_str with copied bytes.

    For variables: we have to duplicate the slot's cssc_str so the bind
    ends up owning a distinct heap buffer (otherwise the slot's release
    would free a buffer the bind still references).
    """
    t = node.get('type')
    if t == 'string':
        text = node.get('value', '')
        kp, kl = _string_lit_ptr_len(b, text)
        return b.call('cssc_string_lit', [kp, kl], [PTR, INT64],
                      return_type=PTR, external=True)
    if t == 'identifier':
        name = node.get('name', '')
        if not b.scope_has(name) or b.scope_kind(name) != 'string':
            raise _csscerror(
                detail=f"bind argument must be a string literal or string slot "
                       f"(got identifier {name!r})",
                line=line,
            )
        slot = b.scope_lookup(name)
        src_ptr = b.slot_load(slot, 'string')
        data_id = b.call('cssc_string_data', [src_ptr], [PTR],
                         return_type=PTR, external=True)
        len_id = b.call('cssc_string_size', [src_ptr], [PTR],
                        return_type=INT64, external=True)
        return b.call('cssc_string_lit', [data_id, len_id], [PTR, INT64],
                      return_type=PTR, external=True)
    raise _csscerror(
        detail=f"bind argument of type {t!r} not supported in Phase 3",
        hint='Phase 3 only accepts string literals or string slots',
        line=line,
    )


def _init_bind_ss(b: CIRBuilder, slot_id: int, init_node: dict,
                  bits_hint: int, line: Optional[int]) -> None:
    """Initialise a bind slot from a literal.

    Accepts three literal shapes, all collapsing to `[(k, v), ...]`:
      * `bind_literal`  — canonical `{k1, v1; k2, v2}` form.
      * `array_literal` — `{k1, v1, k2, v2}` flat list; even-length
        required, alternating elements pair up.
      * `map_literal`   — when empty, treated as an empty bind. (The
        parser sometimes produces this for `{}` because both empty-
        bind and empty-map look the same.)
    """
    init_t = init_node.get('type')
    pairs: List[Tuple[dict, dict]] = []
    if init_t == 'bind_literal':
        pairs = list(init_node.get('pairs', []) or [])
    elif init_t in ('array_literal', 'array'):
        items = list(init_node.get('items') or
                     init_node.get('elements') or [])
        if len(items) % 2 != 0:
            raise _csscerror(
                detail='bind initialiser with array-literal shape '
                       'requires an EVEN number of items (alternating '
                       'key, value)',
                hint='write `{k1, v1, k2, v2}` (no trailing odd token)',
                line=line,
            )
        for i in range(0, len(items), 2):
            pairs.append((items[i], items[i + 1]))
    elif init_t == 'map_literal' and not (init_node.get('pairs') or []):
        pairs = []
    else:
        raise _csscerror(
            detail='bind initialiser must be a bind literal '
                   '`{k, v; k, v; ...}` or flat array `{k, v}`',
            line=line,
        )
    # `bind_ss` is the explicit string-string variant — bind<string,
    # string>. Standalone `bind` now routes to the heterogeneous
    # `bind_entry` kind instead (see `_normalise_slot_type`), so no
    # type-mismatch guard is needed here; users who pick bind_ss
    # explicitly opted into the string-only contract.
    cap_hint = b.const_int(max(len(pairs), 4))
    bind_ptr = b.call('cssc_bind_ss_new', [cap_hint], [INT64],
                      return_type=PTR, external=True)
    b.slot_store(slot_id, bind_ptr, PTR)
    for k_node, v_node in pairs:
        k_str = _string_arg_to_heap(b, k_node, line)
        v_str = _string_arg_to_heap(b, v_node, line)
        cur = b.slot_load(slot_id, 'bind_ss')
        b.call('cssc_bind_ss_push_back', [cur, k_str, v_str],
               [PTR, PTR, PTR], return_type=VOID, external=True)


def _lower_bind_ss_method(b: CIRBuilder, slot_id: int, method: str,
                          args: list,
                          line: Optional[int]) -> Tuple[int, CIRType]:
    bind_ptr = b.slot_load(slot_id, 'bind_ss')
    if method == 'size':
        if args:
            raise _csscerror(detail='bind.size() takes no arguments', line=line)
        r = b.call('cssc_bind_ss_size', [bind_ptr], [PTR],
                   return_type=INT64, external=True)
        return r, INT64
    if method in ('push_back', 'push', 'add'):
        if len(args) != 2:
            raise _csscerror(
                detail=f'bind.{method}(key, value) expects exactly 2 arguments',
                line=line,
            )
        k_str = _string_arg_to_heap(b, args[0], line)
        v_str = _string_arg_to_heap(b, args[1], line)
        b.call('cssc_bind_ss_push_back', [bind_ptr, k_str, v_str],
               [PTR, PTR, PTR], return_type=VOID, external=True)
        return -1, VOID
    raise _csscerror(
        detail=f'bind.{method}() not yet implemented in Phase 3',
        hint='supported: size, push_back(k, v)',
        line=line,
    )


def _init_bind_entry(b: CIRBuilder, slot_id: int, init_node: dict,
                     bits_hint: int, line: Optional[int],
                     declared_elem: Optional[str] = None) -> None:
    """Initialise a `bind` slot — a single record of cells.

    Accepts the same literal shapes as `_emit_array_bind_push` (one
    record's worth of cells). Lowers each cell to its (val, tag) pair
    via `_lower_bind_cell`, fills a builder buffer, and calls the
    runtime `cssc_bind_entry_from_buf` to materialise the record. The
    slot then holds a `ptr` to the entry.

    `declared_elem` carries the strict element constraint of a typed bind
    (`bind<int>` → 'int', …). When set, EVERY cell must match it — CSSC
    is type-strict (a `bind<string>` holds only strings). `bind<auto>` /
    bare `bind` pass None and keep the heterogeneous record semantics.
    """
    cells, pair_width = _bind_entry_cells_with_width(init_node, line)
    # Parity with the interpreter's flat-bind model: a flat `{a, b, c, d}`
    # literal is 2-column-paired, so `b[row][col]` addresses the right cell
    # (`b[0][1]` is the second cell, not a col-ignored repeat of `b[0][0]`).
    # A structured `{a,b; c,d}` bind_literal already carries its own width
    # (>0 here) and is left untouched; empty binds stay 0.
    if pair_width == 0 and cells:
        pair_width = 2
    if not cells:
        # Empty bind — allocate an empty record so the slot has a
        # valid ptr and #delete[bind] later can call _free safely.
        n_id = b.const_int(0)
        empty_buf = b.call('cssc_array_bind_cells_new', [n_id], [INT64],
                           return_type=PTR, external=True)
        ent_ptr = b.call('cssc_bind_entry_from_buf', [n_id, empty_buf],
                         [INT64, PTR], return_type=PTR, external=True)
        b.slot_store(slot_id, ent_ptr, PTR)
        return
    ncells = len(cells)
    n_id = b.const_int(ncells)
    buf_ptr = b.call('cssc_array_bind_cells_new', [n_id], [INT64],
                     return_type=PTR, external=True)
    # When the source was a structured `{k, v; k, v}` literal, record the
    # cells-per-pair on the builder buffer so the runtime entry inherits
    # it and `cssc_bind_entry_pair_cell_*` can compute structured
    # `i[row][col]` accesses. The flat `array_literal` path leaves
    # pair_width at the cells_new default (0).
    if pair_width > 0:
        pw_id = b.const_int(pair_width)
        b.call('cssc_array_bind_cells_set_pair_width',
               [buf_ptr, pw_id], [PTR, INT64],
               return_type=VOID, external=True)
    cell_src_kinds: List[str] = []
    for i, cell_node in enumerate(cells):
        val_id, tag_id, _src = _lower_bind_cell(b, cell_node, line)
        cell_src_kinds.append(_src)
        idx_id = b.const_int(i)
        b.call('cssc_array_bind_cells_set_val',
               [buf_ptr, idx_id, val_id], [PTR, INT64, INT64],
               return_type=VOID, external=True)
        b.call('cssc_array_bind_cells_set_tag',
               [buf_ptr, idx_id, tag_id], [PTR, INT64, INT64],
               return_type=VOID, external=True)
    # Type-strict enforcement for a typed bind (`bind<int>` etc.): every
    # cell must be the declared element kind. A `vector`/`map`/`bind`
    # value lands as src_kind 'ptr'; any scalar mismatch is caught the
    # same way. `bind<auto>` (declared_elem=None) skips this and keeps the
    # heterogeneous record — the deterministic escape hatch.
    if declared_elem is not None:
        _pretty = {'int': 'int', 'float': 'float', 'bool': 'bool',
                   'string': 'string', 'ptr': 'container/pointer',
                   'auto': 'auto'}
        for i, ck in enumerate(cell_src_kinds):
            if ck and ck != 'auto' and ck != declared_elem:
                raise _csscerror(
                    detail=(f'bind<{declared_elem}> cell #{i} holds a '
                            f'{_pretty.get(ck, ck)} value — a typed bind is '
                            f'strict: every cell must be {declared_elem}'),
                    hint=(f'use bind<auto> for a heterogeneous record, or '
                          f'put a matching {declared_elem} value in this '
                          f'cell'),
                    line=line,
                )
    ent_ptr = b.call('cssc_bind_entry_from_buf', [n_id, buf_ptr],
                     [INT64, PTR], return_type=PTR, external=True)
    b.slot_store(slot_id, ent_ptr, PTR)
    # Track the cell kind so reads/writes dispatch to the right typed
    # access pattern. A typed bind records its declared element; an
    # untyped `bind<auto>` records the detected homogeneous kind, or
    # 'mixed' when the cells genuinely differ.
    if declared_elem is not None:
        _BIND_CELL_KIND[slot_id] = declared_elem
    else:
        homogeneous = set(k for k in cell_src_kinds if k and k != 'auto')
        if len(homogeneous) == 1:
            _BIND_CELL_KIND[slot_id] = next(iter(homogeneous))
        else:
            _BIND_CELL_KIND[slot_id] = 'mixed'


def _lower_bind_cell(b: CIRBuilder, node: dict,
                     line: Optional[int]) -> Tuple[int, int, str]:
    """Lower a single bind-tuple cell expression.

    Returns `(val_id_as_i64, tag_const_id_as_i32, src_kind)`:
      * `val_id_as_i64` is an SSA id whose value, interpreted as the raw
        64 bits, encodes the cell (heap-pointer for string, sign-extended
        for int, bit-cast for float, zero-extended for bool).
      * `tag_const_id_as_i32` is the matching tag (1=int, 2=float,
        3=string, 4=bool).
      * `src_kind` is the CSSC kind name driving the tag — useful for
        error reporting.

    For `auto:` label params, the scope binding is
        ('__auto_pair__', val_ssa_id, tag_ssa_id)
    rather than the usual slot id, so the raw (val, tag) pair forwards
    untouched without re-tagging.
    """
    # Auto-param identifier? Pass through the pair the label took.
    if isinstance(node, dict) and node.get('type') == 'identifier':
        ident = node.get('name', '')
        pair = _AUTO_PARAM_BINDINGS[-1].get(ident) if _AUTO_PARAM_BINDINGS else None
        if pair is not None:
            val_id, tag_id = pair
            return val_id, tag_id, 'auto'

    val_id, val_ty = _lower_expr(b, node)
    kind = val_ty.kind
    if kind == 'i64' or kind == 'int':
        # already i64 — tag = INT
        tag_id = b.const_int(_BIND_TAG_INT)
        return val_id, tag_id, 'int'
    if kind == 'i32':
        # extend i32 to i64
        ext = b.call('__cssc_zext_i32_i64', [val_id], [INT64],
                     return_type=INT64, external=True)
        tag_id = b.const_int(_BIND_TAG_INT)
        return ext, tag_id, 'int'
    if kind == 'f64' or kind == 'float':
        # bit-cast float to i64
        bits_id = b.call('__cssc_bitcast_f64_i64', [val_id], [FLOAT64],
                         return_type=INT64, external=True)
        tag_id = b.const_int(_BIND_TAG_FLOAT)
        return bits_id, tag_id, 'float'
    if kind == 'f32':
        # promote f32 -> f64 -> bits
        promoted = b.call('__extendsfdf2', [val_id], [FLOAT32],
                          return_type=FLOAT64, external=True)
        bits_id = b.call('__cssc_bitcast_f64_i64', [promoted], [FLOAT64],
                         return_type=INT64, external=True)
        tag_id = b.const_int(_BIND_TAG_FLOAT)
        return bits_id, tag_id, 'float'
    if kind == 'i1' or kind == 'bool':
        # zext bool -> i64
        ext = b.call('__cssc_zext_i1_i64', [val_id], [BOOL],
                     return_type=INT64, external=True)
        tag_id = b.const_int(_BIND_TAG_BOOL)
        return ext, tag_id, 'bool'
    if kind in ('ptr', 'string_ptr'):
        # Strings + arbitrary pointers — keep as ptr-via-i64; treat ptrs
        # as strings if the source was a string literal/identifier, else
        # opaque ptr. Determine from the AST when possible.
        node_t = node.get('type') if isinstance(node, dict) else None
        is_string = node_t == 'string' or kind == 'string_ptr'
        if not is_string and node_t == 'identifier':
            ident = node.get('name', '')
            if b.scope_has(ident) and b.scope_kind(ident) == 'string':
                is_string = True
        if is_string and node_t == 'string' and kind == 'ptr':
            # Raw .rodata string-literal ptr → promote to a fresh heap
            # cssc_str (refcount 1). The bind adopts that ref directly, so
            # it must NOT be retained again — and retaining a rodata ptr
            # would corrupt read-only memory (the segfault this fixes when
            # the cell is later stringified / released).
            val_id = b.string_from_lit(node.get('value', ''))
            bits_id = b.call('__cssc_bitcast_ptr_i64', [val_id], [PTR],
                             return_type=INT64, external=True)
            return bits_id, b.const_int(_BIND_TAG_STRING), 'string'
        bits_id = b.call('__cssc_bitcast_ptr_i64', [val_id], [PTR],
                         return_type=INT64, external=True)
        if is_string:
            # Borrowing another slot's cssc_str — retain so the bind entry
            # owns its own reference (release-on-entry-free cancels this).
            b.call('cssc_retain', [val_id], [PTR],
                   return_type=VOID, external=True)
        tag_id = b.const_int(_BIND_TAG_STRING if is_string else _BIND_TAG_PTR)
        return bits_id, tag_id, 'string' if is_string else 'ptr'
    raise _csscerror(
        detail=f'bind cell of CIR kind {kind!r} cannot be stored — '
               f'supported: int, float, bool, string',
        line=line,
    )


def _init_array_bind(b: CIRBuilder, slot_id: int, init_node: dict,
                     bits_hint: int, line: Optional[int]) -> None:
    """Initialise an `array<bind>` slot.

    Accepts an outer literal whose items each describe one bind entry.
    Each inner literal can be either an `array_literal` (positional
    cells, e.g. `{0, 19, ltxt}`) or a `bind_literal` (pair groups
    separated by `;`, e.g. `{x, y; txt, dur}` — flattened to four
    cells).

    An empty `{}` parses as either `array_literal`, `array`, or
    `map_literal` (the parser disambiguates by lookahead; with no
    tokens to disambiguate against, it falls back to map_literal).
    We accept all three shapes as the "empty container" case so
    `#stack[array<bind>, N] buf = {};` works regardless of which
    shape the parser produced. Same accommodation for
    `array<map<…>>` (which collapses to array_bind in
    `_normalise_slot_type`).
    """
    init_t = init_node.get('type')
    items: List[dict] = []
    if init_t in ('array_literal', 'array'):
        items = list(init_node.get('items') or
                     init_node.get('elements') or [])
    elif init_t == 'map_literal' and not (init_node.get('pairs') or []):
        # Empty `{}` parsed as map — treat as empty array<bind>.
        items = []
    elif init_t == 'bind_literal' and not (init_node.get('pairs') or []):
        items = []
    else:
        raise _csscerror(
            detail='array<bind> initialiser must be a literal of the form '
                   '{{cell1, cell2, ...}, {cell1, cell2, ...}, ...} '
                   'or empty {}',
            line=line,
        )
    cap_hint = b.const_int(max(len(items), 4))
    arr_ptr = b.call('cssc_array_bind_new', [cap_hint], [INT64],
                     return_type=PTR, external=True)
    b.slot_store(slot_id, arr_ptr, PTR)
    for entry in items:
        cells, pw = _bind_entry_cells_with_width(entry, line)
        _emit_array_bind_push(b, slot_id, cells, line, pair_width=pw)


def _bind_entry_cells(entry: dict, line: Optional[int]) -> List[dict]:
    """Flatten one bind-entry literal into a list of cell expression nodes.

    Accepts:
      * `array_literal({a, b, c})`   → cells [a, b, c]
      * `bind_literal({k1, v1; k2, v2})` → cells [k1, v1, k2, v2]

    Use `_bind_entry_cells_with_width` when you also need the cells-per-
    pair count (required for the chained `i[row][col]` indexing path
    which translates to `vals[row * pair_width + col]` at runtime).
    """
    cells, _pw = _bind_entry_cells_with_width(entry, line)
    return cells


def _bind_entry_cells_with_width(entry: dict, line: Optional[int]
                                   ) -> Tuple[List[dict], int]:
    """Flatten a bind-entry literal AND report the cells-per-pair.

    Returns `(cells, pair_width)`:
      * For `array_literal({a, b, c})` the literal carries no structural
        information; pair_width = 0 (flat). Chained `i[row][col]` reads
        against such a source degrade to `i[row]` semantics at runtime
        (the `cssc_bind_entry_pair_cell_*` helpers handle that path).
      * For `bind_literal({k1, v1; k2, v2})` the structural intent is
        recorded as pair_width = len(pairs[0]). Every pair must contribute
        the same number of cells — a literal like `{a, b; c, d, e}` would
        leave `row * pair_width + col` ambiguous and is rejected here
        with a clear error.
    """
    et = entry.get('type')
    if et in ('array_literal', 'array'):
        cells = list(entry.get('items') or entry.get('elements') or [])
        return cells, 0
    if et == 'map_literal' and not (entry.get('pairs') or []):
        # Empty `{}` parses as `map_literal` because the brace syntax is
        # structurally ambiguous (map / array / bind all share it).
        # Accept it as the canonical "empty bind" with pair_width=0.
        return [], 0
    if et == 'bind_literal':
        pairs = entry.get('pairs') or []
        if not pairs:
            return [], 0
        widths = [len(pair) for pair in pairs]
        if any(w != widths[0] for w in widths):
            raise _csscerror(
                detail=(
                    'bind literal has uneven pair widths '
                    f'({widths}) — every `;`-separated group must '
                    'carry the same number of comma-separated cells '
                    'so that `i[row][col]` can address a uniform '
                    f'`vals[row * {widths[0]} + col]`'),
                hint=(
                    'Pad the shorter pair with `0x0` placeholders, or '
                    'switch to the flat `{a, b, c, …}` form if the '
                    'pairs were not structurally meaningful.'),
                line=line,
            )
        cells: List[dict] = []
        for pair in pairs:
            for cell in pair:
                cells.append(cell)
        return cells, widths[0]
    raise _csscerror(
        detail=f'array<bind> entry literal must be {{a, b, …}} or '
               f'{{k1, v1; k2, v2}} — got {et!r}',
        line=line,
    )


def _emit_array_bind_push(b: CIRBuilder, slot_id: int,
                          cell_nodes: List[dict],
                          line: Optional[int],
                          pair_width: int = 0) -> None:
    """Build a fresh (vals[], tags[]) pair for one bind entry and call
    `cssc_array_bind_push_back`.

    The (vals, tags) arrays are allocated by `cssc_array_bind_cells_new`,
    which returns two parallel buffers the runtime takes ownership of.
    The runtime copies them into the entry; we never read them again.

    `pair_width` records the cells-per-pair of the source literal:
    0 (default) = flat array_literal, N>0 = structured bind_literal.
    When >0 we call `cssc_array_bind_cells_set_pair_width` so the
    runtime entry inherits the layout; that's what makes
    `i[row][col]` translate to `vals[row * N + col]` at read time.
    """
    ncells = len(cell_nodes)
    if ncells == 0:
        raise _csscerror(
            detail='array<bind> entry must have at least one cell',
            line=line,
        )
    n_id = b.const_int(ncells)
    buf_pair_ptr = b.call('cssc_array_bind_cells_new', [n_id], [INT64],
                          return_type=PTR, external=True)
    if pair_width > 0:
        pw_id = b.const_int(pair_width)
        b.call('cssc_array_bind_cells_set_pair_width',
               [buf_pair_ptr, pw_id], [PTR, INT64],
               return_type=VOID, external=True)
    # The buffer is laid out as `ncells × i64 vals` followed by
    # `ncells × i8 tags`; runtime helpers `cssc_array_bind_cells_set_val`
    # / `_set_tag` write into the correct offset.
    for i, cell_node in enumerate(cell_nodes):
        val_id, tag_id, _src_kind = _lower_bind_cell(b, cell_node, line)
        idx_id = b.const_int(i)
        b.call('cssc_array_bind_cells_set_val',
               [buf_pair_ptr, idx_id, val_id], [PTR, INT64, INT64],
               return_type=VOID, external=True)
        b.call('cssc_array_bind_cells_set_tag',
               [buf_pair_ptr, idx_id, tag_id], [PTR, INT64, INT64],
               return_type=VOID, external=True)
    arr_ptr = b.slot_load(slot_id, 'array_bind')
    b.call('cssc_array_bind_push_back',
           [arr_ptr, n_id, buf_pair_ptr],
           [PTR, INT64, PTR],
           return_type=VOID, external=True)


def _lower_array_bind_method(b: CIRBuilder, slot_id: int, method: str,
                             args: list,
                             line: Optional[int]) -> Tuple[int, CIRType]:
    """Method dispatch for `array<bind>` slots."""
    if method == 'size':
        if args:
            raise _csscerror(
                detail='array<bind>.size() takes no arguments', line=line)
        arr_ptr = b.slot_load(slot_id, 'array_bind')
        r = b.call('cssc_array_bind_size', [arr_ptr], [PTR],
                   return_type=INT64, external=True)
        return r, INT64
    if method in ('push_back', 'push', 'add'):
        if len(args) != 1:
            raise _csscerror(
                detail=f'array<bind>.{method}(entry) expects exactly '
                       f'one entry literal or bind handle',
                line=line,
            )
        arg = args[0]
        # Unwrap a leading `&` (copy_of). For a bind handle the `&`
        # is redundant — push_entry already clones the entry, so
        # `arr.push_back(m)` and `arr.push_back(&m)` produce
        # identical output. Strip the wrapper here so handle-detection
        # below sees the inner identifier.
        unwrapped = arg
        if (isinstance(arg, dict) and arg.get('type') == 'copy_of'
                and isinstance(arg.get('operand'), dict)
                and arg.get('operand', {}).get('type') == 'identifier'):
            unwrapped = arg.get('operand') or arg
        # When the user pushes a `bind` slot (handle path), splice the
        # entry into the array — runtime clones the cells so the bind
        # slot stays valid for #delete. Detect this by the AST shape
        # (`identifier` with scope kind `bind_entry`).
        if isinstance(unwrapped, dict) and unwrapped.get('type') == 'identifier':
            ident = unwrapped.get('name', '')
            if b.scope_has(ident) and b.scope_kind(ident) == 'bind_entry':
                bind_slot = b.scope_lookup(ident)
                bind_ptr = b.slot_load(bind_slot, 'bind_entry')
                arr_ptr = b.slot_load(slot_id, 'array_bind')
                b.call('cssc_array_bind_push_entry',
                       [arr_ptr, bind_ptr], [PTR, PTR],
                       return_type=VOID, external=True)
                return -1, VOID
        cells, pw = _bind_entry_cells_with_width(unwrapped, line)
        _emit_array_bind_push(b, slot_id, cells, line, pair_width=pw)
        return -1, VOID
    if method == 'clear':
        if args:
            raise _csscerror(
                detail='array<bind>.clear() takes no arguments', line=line)
        arr_ptr = b.slot_load(slot_id, 'array_bind')
        b.call('cssc_array_bind_clear', [arr_ptr], [PTR],
               return_type=VOID, external=True)
        return -1, VOID
    if method == 'empty':
        if args:
            raise _csscerror(
                detail='array<bind>.empty() takes no arguments', line=line)
        arr_ptr = b.slot_load(slot_id, 'array_bind')
        sz = b.call('cssc_array_bind_size', [arr_ptr], [PTR],
                    return_type=INT64, external=True)
        zero = b.const_int(0)
        is_empty = b.cmp_int('==', sz, zero)
        return is_empty, BOOL
    raise _csscerror(
        detail=f'array<bind>.{method}() not yet implemented',
        hint='supported: size, push_back(entry), clear, empty',
        line=line,
    )


# Per-function stack of auto-param bindings. Pushed when entering a
# label/ctor whose signature includes `auto:` params, popped on exit.
_AUTO_PARAM_BINDINGS: List[Dict[str, Tuple[int, int]]] = []


def _auto_param_scope_enter() -> None:
    _AUTO_PARAM_BINDINGS.append({})


def _auto_param_scope_exit() -> None:
    if _AUTO_PARAM_BINDINGS:
        _AUTO_PARAM_BINDINGS.pop()


def _auto_param_bind(name: str, val_id: int, tag_id: int) -> None:
    if not _AUTO_PARAM_BINDINGS:
        raise _csscerror(
            detail=f'_auto_param_bind({name!r}): no auto-param scope active',
        )
    _AUTO_PARAM_BINDINGS[-1][name] = (val_id, tag_id)


def _lower_map_si_method(b: CIRBuilder, slot_id: int, method: str,
                         args: list,
                         line: Optional[int]) -> Tuple[int, CIRType]:
    map_ptr = b.slot_load(slot_id, 'map_si')
    if method == 'size':
        if args:
            raise _csscerror(detail='map.size() takes no arguments', line=line)
        r = b.call('cssc_map_si_size', [map_ptr], [PTR],
                   return_type=INT64, external=True)
        return r, INT64
    if method == 'has':
        if len(args) != 1:
            raise _csscerror(detail='map.has(key) expects exactly 1 argument',
                             line=line)
        kp, kl = _string_key_ptr_len(b, args[0], line)
        r = b.call('cssc_map_si_has', [map_ptr, kp, kl],
                   [PTR, PTR, INT64],
                   return_type=BOOL, external=True)
        return r, BOOL
    raise _csscerror(
        detail=f'map<string, int>.{method}() not yet implemented',
        hint='supported: size, has',
        line=line,
    )


def _lower_map_skey_method(b: CIRBuilder, slot_id: int, slot_kind: str,
                           method: str, args: list,
                           line: Optional[int]) -> Tuple[int, CIRType]:
    """Shared dispatcher for string-keyed map variants (map_ss, map_sf).

    .size() → i64. .has("k") → i1. Symbols are derived from `slot_kind`.
    """
    map_ptr = b.slot_load(slot_id, slot_kind)
    if method == 'size':
        if args:
            raise _csscerror(detail=f'{slot_kind}.size() takes no arguments',
                             line=line)
        r = b.call(f'cssc_{slot_kind}_size', [map_ptr], [PTR],
                   return_type=INT64, external=True)
        return r, INT64
    if method == 'has':
        if len(args) != 1:
            raise _csscerror(
                detail=f'{slot_kind}.has(key) expects exactly 1 argument',
                line=line)
        kp, kl = _string_key_ptr_len(b, args[0], line)
        r = b.call(f'cssc_{slot_kind}_has', [map_ptr, kp, kl],
                   [PTR, PTR, INT64],
                   return_type=BOOL, external=True)
        return r, BOOL
    raise _csscerror(
        detail=f'{slot_kind}.{method}() not yet implemented',
        hint='supported: size, has',
        line=line,
    )


def _lower_map_ikey_method(b: CIRBuilder, slot_id: int, slot_kind: str,
                           method: str, args: list,
                           line: Optional[int]) -> Tuple[int, CIRType]:
    """Shared dispatcher for int-keyed map variants (map_is, map_ii, map_if).

    .size() → i64. .has(k) → i1, with int-typed key.
    """
    map_ptr = b.slot_load(slot_id, slot_kind)
    if method == 'size':
        if args:
            raise _csscerror(detail=f'{slot_kind}.size() takes no arguments',
                             line=line)
        r = b.call(f'cssc_{slot_kind}_size', [map_ptr], [PTR],
                   return_type=INT64, external=True)
        return r, INT64
    if method == 'has':
        if len(args) != 1:
            raise _csscerror(
                detail=f'{slot_kind}.has(key) expects exactly 1 argument',
                line=line)
        k_id = _int_key_arg(b, args[0], line)
        r = b.call(f'cssc_{slot_kind}_has', [map_ptr, k_id],
                   [PTR, INT64],
                   return_type=BOOL, external=True)
        return r, BOOL
    raise _csscerror(
        detail=f'{slot_kind}.{method}() not yet implemented',
        hint='supported: size, has',
        line=line,
    )


def _lower_map_ss_method(b, slot_id, method, args, line):
    return _lower_map_skey_method(b, slot_id, 'map_ss', method, args, line)


def _lower_map_sf_method(b, slot_id, method, args, line):
    return _lower_map_skey_method(b, slot_id, 'map_sf', method, args, line)


def _lower_map_is_method(b, slot_id, method, args, line):
    return _lower_map_ikey_method(b, slot_id, 'map_is', method, args, line)


def _lower_map_ii_method(b, slot_id, method, args, line):
    return _lower_map_ikey_method(b, slot_id, 'map_ii', method, args, line)


def _lower_map_if_method(b, slot_id, method, args, line):
    return _lower_map_ikey_method(b, slot_id, 'map_if', method, args, line)


def _lower_delete(b: CIRBuilder, node: dict) -> None:
    name = node.get('arg', '').strip()
    line = node.get('line')
    if not name:
        raise _csscerror(detail='#delete requires a variable name',
                         hint='Usage: #delete[x];', line=line)
    # `#DEFINE name <expr>;` constants live in their own registry and
    # are removed via `#delete[name]` exactly like slot variables. The
    # bake-and-forget model means there's no runtime cleanup needed —
    # we just drop the entry so further identifier references fail.
    if name in _CT_CONSTS:
        del _CT_CONSTS[name]
        return
    if not b.scope_has(name):
        # `#delete[<missing>]` is FATAL by design. CSSC's lifetime
        # contract is explicit: the user owns the alloc, the user owns
        # the delete. If the slot's gone (out of scope, never declared,
        # typo, ctor-body local referenced from a free block), we won't
        # silently no-op — that would mask real bugs.
        #
        # Idiomatic guard for the "might not exist" case:
        #     #stack[int, 64] tmp;
        #     #adress[name] tmp;
        #     if (tmp != 0x0) { #delete[name]; }
        # `#adress[var] dst;` writes the slot address (or 0x0 if
        # unbound) into `dst`. The LSP also surfaces this as a
        # missing-`#delete` diagnostic before the build, so this
        # error should be rare in practice.
        raise _csscerror(
            detail=f'#delete[{name}]: variable {name!r} not in scope',
            hint=(
                f'Either declare it first with `#stack[<type>, <bits>] '
                f'{name} = …;` or guard the delete with '
                f'`#stack[int, 64] _a; #adress[{name}] _a; '
                f'if (_a != 0x0) {{ #delete[{name}]; }}`. '
                f'If this fires from inside an object `free {{ … }}` '
                f'block, the named variable is probably a ctor-body '
                f'local whose lifetime ended when the ctor returned — '
                f'move it to a member (`{name} → Obj->{name}`) or '
                f'drop the `#delete`.'),
            line=line,
        )
    kind = b.scope_kind(name)
    # `#delete[<instance>]` on an object handle is treated as the full
    # tear-down: the object's `free { … }` block runs (so user code like
    # `display.text("VideoDriver shutdown")` actually appears on screen),
    # auto-release runs over every heap-typed member, then the heap
    # block returns to the allocator. This matches the user-visible
    # expectation that "deleting" an instance shuts it down cleanly —
    # the same as `#free[<instance>]`. Previously `#delete` only
    # released the slot's ptr; the free body was silently skipped and
    # the chip exited main with the OLED frozen on the last tick frame.
    if kind == 'object_handle' and name in _INSTANCES:
        free_node = {
            'type':       'directive',
            'directive':  'free',
            'arg':        name,
            'line':       line,
        }
        _lower_free_directive(b, free_node)
        return
    slot = b.scope_lookup(name)
    b.slot_release(slot, kind)
    b.scope_unbind(name)
    # v6 ref-by-default cross-frame propagation (spec §2.5):
    # `#delete[param]` inside a `#define` body might be deleting a
    # ref-aliased param whose source slot lives in the caller's
    # frame. Emit `cssc_scope_delete_aliased(stack, "name")` so the
    # runtime checks the top frame's alias table; if `name` is
    # aliased to a caller-side slot, that slot is nulled too.
    # When `name` isn't aliased the helper falls through to a no-op
    # plain delete, so this is safe to emit unconditionally — only
    # the per-call cost of one extern call per `#delete[]`.
    #
    # A4 (perf): skip the call entirely in functions whose alias
    # frame is provably empty. The runtime alias frame is opened by
    # `cssc_alias_open_frame` (inside `cssc_scope_push`) which
    # consumes pending links registered by the CALLER's
    # `cssc_arg_link`. A function's alias frame can be non-empty
    # ONLY if its caller routed args through `_emit_arg_link`.
    # For provably empty frames the runtime call is pure overhead.
    # Only a `#delete` of a ref-aliasable PARAM can cascade to a caller's
    # slot. A local — a receiver-binding result, `#stack`/`#heap`/`#auto`
    # — is never a cross-frame alias, so it never needs the alias-table
    # walk. Skipping the call for locals is what lets a pure-POD leaf
    # function that only `#delete`s locals (e.g. recursive `fib`, which
    # deletes its `fib(n-1)`/`fib(n-2)` result locals) drop the runtime
    # scope frame entirely — `cssc_scope_delete_aliased` is in
    # `_SCOPE_TRIGGER_SYMBOLS`, so emitting it forces `needs_scope`.
    if _current_fn_may_have_aliases(b) and _name_is_param(b, name):
        _emit_scope_delete_aliased(b, name)


def _name_is_param(b: 'CIRBuilder', name: str) -> bool:
    """True iff `name` is a PARAMETER of the current function (so a
    `#delete[name]` might be a ref-alias to a caller slot). Locals return
    False. Conservatively True when the function/param metadata can't be
    resolved (keeps the pre-existing always-emit behaviour for anything
    unexpected)."""
    fn = getattr(b, '_current_fn', None)
    if fn is None:
        return True
    info = next((i for i in _DEFINES.values()
                 if i.get('sym') == getattr(fn, 'name', None)), None)
    if info is None:
        return True
    return name in (info.get('arg_param_names') or [])


def _current_fn_may_have_aliases(b: 'CIRBuilder') -> bool:
    """Return True iff THIS function might have a non-empty alias
    frame at runtime. Conservatively True for user `#define`-emitted
    functions (`cssc_user_<name>` except main); False for entry-point
    main, object methods/ctors, and sector functions whose call paths
    don't go through `_emit_arg_link`.

    If the label-call ABI is later extended to honor the bit-pack
    (HANDOFF Bug 3), the `cssc_obj_*` prefix check should be
    relaxed accordingly. Adding new aliasing call paths means
    revisiting this function — keep it as the single source of
    truth for the optimization.
    """
    fn = getattr(b, '_current_fn', None)
    if fn is None:
        return True   # conservative
    name = fn.name
    if name == 'cssc_user_main':
        # The entry point has only one caller (`_cssc_user_entry`)
        # which doesn't go through `_emit_arg_link`. Alias frame
        # always empty here.
        return False
    # NOTE: `cssc_obj_*` (object methods) WERE in this skip-list, but
    # Bug 3 fix added `_emit_arg_link` calls at the method call sites
    # (`_lower_dot_call_expr` + `_emit_self_label_call`) so object
    # methods can now have non-empty alias frames. We must emit the
    # `cssc_scope_delete_aliased` call from inside the method body
    # for cross-frame deletes to fire. Per-#delete cost: one extern
    # call (no-op when no aliases). Acceptable for the correctness win.
    if name.startswith('cssc_sec_'):
        # Sector functions are called via `Sec::fn(args)` which goes
        # through `_lower_member_ns_call_expr` (line ~641). That path
        # does NOT yet emit `_emit_arg_link`. If a future Bug-3-style
        # fix adds it for sector calls, remove this skip too. Until
        # then, sector functions can't have aliases → safe to skip.
        return False
    return True


def _emit_scope_delete_aliased(b: 'CIRBuilder', name: str) -> None:
    """Emit `cssc_scope_delete_aliased(name)` so the runtime can null
    the caller's slot when `name` is an alias entry. No-op fast-path
    when no alias exists, so safe to call after every `#delete[]`.

    CRITICAL: must use `const_str` (linker-deduped global) — NOT
    `string_from_lit` — so the name pointer matches the one passed
    by `_emit_arg_link` at the call site. See `_emit_arg_link`
    docstring for the full rationale.
    """
    n_id = b.const_str(name)
    b.call('cssc_scope_delete_aliased', [n_id], [PTR],
           return_type=VOID, external=True)


def _lower_reserve_directive(b: CIRBuilder, node: dict) -> None:
    """Instantiate a deferred sector previously declared with
    `sector Name … ?label { … };` (CSSC spec §6.5).

    Looks up `_DEFERRED_SECTORS[label]`, removes the entry (a sector
    can only be reserved once), and recursively lowers the stored
    node via `_lower_sector`. Globals + init store sequence land at
    THIS directive's program-order position — that's the whole point
    of deferral (one `?label` declaration up top, multiple
    `#reserve[label]` sites pick the moment of construction).

    Cross-module `#reserve[mod.label]` is not yet supported (would
    need a global registry across CIR modules + inter-module symbol
    coordination); we emit a clear error pointing the user at the
    same-module workaround.
    """
    line = node.get('line')
    label = (node.get('arg') or '').strip()
    if not label:
        raise _csscerror(
            detail='#reserve requires a label name',
            hint='Usage: `#reserve[label]` where the sector was '
                 'declared as `sector Name … ?label { … };`',
            line=line,
        )
    if '.' in label or '::' in label:
        raise _csscerror(
            detail=f'#reserve[{label}]: cross-module deferred sectors '
                   f'not yet supported',
            hint='Declare and reserve in the same module. The deferred '
                 'sector registry is currently per-CIR-module; cross-'
                 'module coordination lands in a future session.',
            line=line,
        )
    deferred = _DEFERRED_SECTORS.pop(label, None)
    if deferred is None:
        raise _csscerror(
            detail=f'#reserve[{label}]: no deferred sector with label '
                   f'{label!r}',
            hint='Declare the sector first with `sector Name … '
                 f'?{label} {{ … }};` — the `?label` MUST match the '
                 '#reserve argument.',
            line=line,
        )
    # Recurse into `_lower_sector` to do the actual emission. The
    # stored node already has `reserve_label=''` so the recursion
    # falls through to the normal sector-emission path.
    _lower_sector(b, deferred)


# Runtime symbol map for `#delmember[target]` per container kind. The
# two columns mirror the two syntactic forms:
#   * `null_at(self, i)` — wipe one entry's heap content; size/cap stay.
#   * `null_all(self)`   — same for every entry; size/cap stay.
# When `null_at` is absent the kind doesn't support indexed wipe
# (e.g. plain string — `#delmember[s[i]]` makes no sense), and when
# `null_all` is absent the kind doesn't have a meaningful "wipe every
# member" operation either (only the indexed form is allowed).
_DELMEMBER_RUNTIME = {
    'array_bind':   ('cssc_array_bind_null_at',   'cssc_array_bind_null_all'),
    'vector_int':   ('cssc_vector_int_null_at',   'cssc_vector_int_null_all'),
    'vector_float': ('cssc_vector_float_null_at', 'cssc_vector_float_null_all'),
    'array_int':    ('cssc_vector_int_null_at',   'cssc_vector_int_null_all'),
    'array_float':  ('cssc_vector_float_null_at', 'cssc_vector_float_null_all'),
    'array_string': ('cssc_vector_null_at_string', 'cssc_vector_null_all_string'),
    'map_si':       ('cssc_map_si_null_at',       'cssc_map_si_null_all'),
    'map_ss':       ('cssc_map_ss_null_at',       'cssc_map_ss_null_all'),
    'map_is':       ('cssc_map_is_null_at',       'cssc_map_is_null_all'),
    'map_ii':       ('cssc_map_ii_null_at',       'cssc_map_ii_null_all'),
    'map_sf':       ('cssc_map_sf_null_at',       'cssc_map_sf_null_all'),
    'map_if':       ('cssc_map_if_null_at',       'cssc_map_if_null_all'),
    'bind_ss':      ('cssc_bind_ss_null_at',      'cssc_bind_ss_null_all'),
}


def _lower_delmember(b: CIRBuilder, node: dict) -> None:
    """Lower `#delmember[target]` and `#delmember[target[i]]`.

    Indexed form wipes one entry's heap content and nulls the slot
    (POD elements get zeroed, heap elements get released and replaced
    with the appropriate empty/null value). Container-form runs the
    same per-entry wipe across every entry; size/cap are preserved.

    The container handle itself stays alive afterwards — `#delmember`
    is the soft-wipe counterpart of `#free` / `#delete`. Re-use of the
    container is supported (push_back / set works as if the entry had
    never been there).
    """
    line = node.get('line')
    target = node.get('target') or {}
    index = node.get('index')

    # Resolve target → (kind, slot_id). Two shapes:
    #   identifier      — local container slot
    #   arrow_access    — Obj->member (bound via _bind_object_members)
    tt = target.get('type')
    if tt == 'identifier':
        name = target.get('name', '')
        if not b.scope_has(name):
            raise _csscerror(
                detail=f'#delmember[{name}]: variable not declared',
                hint='Declare with #stack[<container>, …] name = ... first',
                line=line)
        slot_id = b.scope_lookup(name)
        kind = b.scope_kind(name)
    elif tt == 'arrow_access':
        inner = target.get('object', {})
        if inner.get('type') != 'identifier':
            raise _csscerror(
                detail='#delmember: arrow target requires a simple '
                       'object identifier',
                line=line)
        obj_name = inner.get('name', '')
        key = target.get('key', '')
        qualified = f'{obj_name}->{key}'
        if not b.scope_has(qualified):
            raise _csscerror(
                detail=f'#delmember[{qualified}]: member not bound in '
                       f'the current scope (call from inside a label body)',
                line=line)
        slot_id = b.scope_lookup(qualified)
        kind = b.scope_kind(qualified)
    else:
        raise _csscerror(
            detail=f'#delmember: target must be an identifier or '
                   f'Obj->member (got {tt!r})',
            line=line)

    rt = _DELMEMBER_RUNTIME.get(kind)
    if rt is None:
        raise _csscerror(
            detail=f'#delmember on slot of kind {kind!r} is not '
                   f'supported',
            hint='supported: array<bind>, vector<int|float>, '
                 'array<int|float>, map<string,int>, bind',
            line=line)
    sym_at, sym_all = rt

    self_ptr = b.slot_load(slot_id, kind)
    if index is not None:
        idx_id, idx_ty = _lower_expr(b, index, expected_kind='int')
        if idx_ty.kind != 'i64':
            raise _csscerror(
                detail=f'#delmember[{kind} at index]: index must be '
                       f'an int (got {idx_ty.kind!r})',
                line=line)
        b.call(sym_at, [self_ptr, idx_id], [PTR, INT64],
               return_type=VOID, external=True)
    else:
        b.call(sym_all, [self_ptr], [PTR],
               return_type=VOID, external=True)


# ---------------------------------------------------------------------------
# Game-namespace runtime dispatch table.
#
# Every entry maps `(module, method)` — where `module` is the canonical
# module name registered in `_KNOWN_MODULES` (NOT the user-picked alias) —
# to a `DispatchSpec` describing the runtime symbol, its argument LLVM
# types (excluding string demotion, which is applied at dispatch time),
# its return type, and whether it may be used as a statement, an
# expression, or both.
#
# `position` values:
#   'stmt' — void-returning side-effect symbol (e.g. sprite::draw).
#   'expr' — value-producing (e.g. sprite::create, mouse::getX).
#   'both' — legal in either context (create/new dual-purpose).
#
# `arg_types` for string parameters use the CSTR sentinel below — the
# dispatcher lowers the incoming expression to a cssc_str*, then extracts
# `cssc_string_data` (const char*) to match the C ABI (`const char*`).
# ---------------------------------------------------------------------------
CSTR = ('__cstr__',)   # sentinel — replaced with PTR when the emitter
                        # writes the call. Kept as a distinct object so the
                        # dispatcher can tell "string arg" from "raw ptr".


class _DispatchSpec:
    """Per-call metadata used by `_dispatch_ns_call_runtime`.

    `trailing_optional` — number of extra args at the tail the caller
    may supply and which are ignored at emit time (matches
    `_GPIO_METHODS`'s `begin(...)` short-form tolerance). Used by
    `sprite::create(w, h [, keyArgb])` where the interpreter also
    documents the third arg as optional (Doc §video.sprite).
    """
    __slots__ = ('symbol', 'arg_types', 'ret_type', 'position',
                 'trailing_optional')

    def __init__(self, symbol: str, arg_types: list, ret_type: CIRType,
                 position: str, trailing_optional: int = 0) -> None:
        self.symbol    = symbol
        self.arg_types = arg_types
        self.ret_type  = ret_type
        self.position  = position
        self.trailing_optional = trailing_optional


# Table-driven dispatch — the row order groups families for scanability.
# All symbols exist in cssc_host_game.c and are declared by the transembly
# emitters in x86_64.py's _emit_cssc_{keyboard,mouse,sound,sprite,tm,font}
# families.
_NS_CALL_RUNTIME: Dict[Tuple[str, str], _DispatchSpec] = {
    # ---- CCOS freestanding intrinsics (x86-64 bare-metal kernel) ----
    # Port I/O, raw MMIO poke/peek, and privileged CPU instructions.
    # Every symbol resolves to a tiny wrapper emitted ONLY by the
    # `freestanding` runtime profile (transembly/x86_freestanding.py):
    # `poke`/`peek` are pure volatile load/store; the rest carry an
    # `asm sideeffect` body. All operands are i64 (widths are truncated
    # inside the wrapper), so the generic dispatch coercion applies
    # unchanged. Using any of these on a non-freestanding target fails
    # at link (the host runtime never defines them) — the interpreter
    # rejects them up front for engine parity.
    ('cssc', 'outb'):       _DispatchSpec('cssc_outb', [INT64, INT64], VOID, 'stmt'),
    ('cssc', 'outw'):       _DispatchSpec('cssc_outw', [INT64, INT64], VOID, 'stmt'),
    ('cssc', 'outl'):       _DispatchSpec('cssc_outl', [INT64, INT64], VOID, 'stmt'),
    ('cssc', 'inb'):        _DispatchSpec('cssc_inb', [INT64], INT64, 'expr'),
    ('cssc', 'inw'):        _DispatchSpec('cssc_inw', [INT64], INT64, 'expr'),
    ('cssc', 'inl'):        _DispatchSpec('cssc_inl', [INT64], INT64, 'expr'),
    ('cssc', 'poke8'):      _DispatchSpec('cssc_poke8', [INT64, INT64], VOID, 'stmt'),
    ('cssc', 'poke16'):     _DispatchSpec('cssc_poke16', [INT64, INT64], VOID, 'stmt'),
    ('cssc', 'poke32'):     _DispatchSpec('cssc_poke32', [INT64, INT64], VOID, 'stmt'),
    ('cssc', 'poke64'):     _DispatchSpec('cssc_poke64', [INT64, INT64], VOID, 'stmt'),
    ('cssc', 'memfill32'):  _DispatchSpec('cssc_memfill32', [INT64, INT64, INT64], VOID, 'stmt'),
    ('cssc', 'memcopy'):    _DispatchSpec('cssc_memcopy', [INT64, INT64, INT64], VOID, 'stmt'),
    ('cssc', 'alloc'):      _DispatchSpec('cssc_alloc_raw', [INT64], INT64, 'expr'),
    ('cssc', 'free'):       _DispatchSpec('cssc_free_raw', [INT64], VOID, 'stmt'),
    # ---- Host test-harness I/O (host-only; provided by cssc_host_extras.c) ----
    # Exact-byte stdin/stdout so the CSSC-written interpreter can be unit-tested
    # on the host: read the program under test in, stream its output out, with no
    # framebuffer/terminal. Unused (and undefined) on the freestanding kernel.
    ('cssc', 'hostRead'):   _DispatchSpec('cssc_host_read', [INT64, INT64], INT64, 'expr'),
    ('cssc', 'printRaw'):   _DispatchSpec('cssc_host_write', [INT64, INT64], VOID, 'stmt'),
    ('cssc', 'readCs'):     _DispatchSpec('cssc_read_cs', [], INT64, 'expr'),
    ('cssc', 'fontRow'):    _DispatchSpec('cssc_font_row', [INT64, INT64], INT64, 'expr'),
    # Bit primitives (CSSC's parser has no bitwise/shift operators; `&` is
    # the copy operator). `shr` is a logical (unsigned) shift.
    ('cssc', 'shl'):        _DispatchSpec('cssc_shl', [INT64, INT64], INT64, 'expr'),
    ('cssc', 'shr'):        _DispatchSpec('cssc_shr', [INT64, INT64], INT64, 'expr'),
    ('cssc', 'band'):       _DispatchSpec('cssc_band', [INT64, INT64], INT64, 'expr'),
