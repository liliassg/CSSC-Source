def _resolve_ns(ns: str) -> str:
    """Return the canonical module name for `ns`.

    `ns` may be a user-picked `#include('mod') alias;` alias OR the raw
    module name. The dispatch table (`_NS_CALL_RUNTIME`) is keyed by the
    canonical module name, so we consult `_INCLUDED_MODULES` first and
    fall back to `ns` unchanged if it isn't a registered alias.
    """
    meta = _INCLUDED_MODULES.get(ns)
    if meta is None:
        return ns
    return meta.get('module') or ns


# `cssc::` value builtins whose return kind the return-kind prescan must
# know. This mirrors the hardcoded lowering in `_lower_ns_call_expr` so a
# receiver-bound `cssc::to_string(x) v;` / `mirror cssc::concat(...)` types
# `v` / the function correctly instead of falling back to i64.
_CSSC_BUILTIN_RETURN_KIND: Dict[str, str] = {
    'to_str': 'string', 'to_string': 'string', 'string': 'string',
    'concat': 'string',
    'to_int': 'int', 'int': 'int', 'tick': 'int',
    'to_float': 'float', 'float': 'float', 'uptime': 'float',
    'to_bool': 'bool', 'bool': 'bool',
}

# Map a `_DispatchSpec.ret_type.kind` (the runtime dispatch table's return
# type) to a CSSC value-kind string. `ptr` is a raw string handle (e.g.
# `kb::getKey` returns a char* the caller adopts as a string).
_DISPATCH_KIND_TO_CSSC: Dict[str, str] = {
    'i64': 'int', 'i1': 'bool', 'f64': 'float', 'f32': 'float',
    'string_ptr': 'string', 'ptr': 'string',
}


def _ns_call_return_kind(ns: str, func: str) -> Optional[str]:
    """The CSSC value-kind ('int'/'bool'/'float'/'string') that a
    `ns::func(...)` call yields, or None if the (module, func) pair is
    unknown to the compiler.

    Consults exactly the authorities the lowering does — the hardcoded
    `cssc::` builtins and the `_NS_CALL_RUNTIME` dispatch table (via
    `_resolve_ns`, so an `#include('cssc.ini') ini;` alias resolves to its
    canonical module). This is the single source of truth for the
    return-kind prescan, replacing the previous dead branch that read
    non-existent `path`/`name` node keys and defaulted every ns-call to
    i64 — which mis-typed e.g. `ini::read(...) v;` and produced the cryptic
    'mirror kind string_ptr cannot satisfy declared return kind i64'.
    """
    if ns == 'cssc':
        return _CSSC_BUILTIN_RETURN_KIND.get(func)
    mod = _resolve_ns(ns)
    spec = _NS_CALL_RUNTIME.get((mod, func))
    if spec is None:
        return None
    return _DISPATCH_KIND_TO_CSSC.get(spec.ret_type.kind)


def _dispatch_ns_call_runtime(
    b: CIRBuilder,
    ns: str,
    func: str,
    args: list,
    line: Optional[int],
    *,
    context: str,
) -> Optional[Tuple[int, CIRType]]:
    """Try to lower `ns::func(args)` through `_NS_CALL_RUNTIME`.

    Returns `None` if the (module, func) pair isn't in the table, so the
    caller can fall through to its legacy code path. Returns
    `(value_id, type)` for expression calls and `(-1, VOID)` for
    statement calls that produced a side-effect only.

    `context` is 'stmt' or 'expr' — used to gate position-restricted
    entries so a user who writes `sprite::draw(...)` at the statement
    level gets a targeted diagnostic instead of the terminal raise, and
    similarly a bare `sprite::draw(...)` inside an expression fails with
    a clear "no value" message.
    """
    mod = _resolve_ns(ns)
    spec = _NS_CALL_RUNTIME.get((mod, func))
    if spec is None:
        return None
    if context == 'stmt' and spec.position == 'expr':
        raise _csscerror(
            detail=f'{ns}::{func}(...) produces a value and cannot be '
                   f'called as a bare statement',
            hint=f'assign the result: `#stack[int,64] r = {ns}::{func}(...);`'
                 if spec.ret_type.kind == 'i64'
                 else f'capture the returned handle in a slot',
            line=line,
        )
    if context == 'expr' and spec.position == 'stmt':
        raise _csscerror(
            detail=f'{ns}::{func}(...) is a void side-effect call and '
                   f'yields no value',
            hint='call it as a statement (its own line, no assignment)',
            line=line,
        )
    total_arity = len(spec.arg_types)
    required_arity = total_arity - spec.trailing_optional
    if len(args) < required_arity or len(args) > total_arity:
        if spec.trailing_optional:
            detail = (f'{ns}::{func} takes {required_arity}..{total_arity} '
                      f'arg(s), got {len(args)}')
        else:
            detail = (f'{ns}::{func} takes {required_arity} arg(s), '
                      f'got {len(args)}')
        raise _csscerror(detail=detail, line=line)
    # Consume all supplied args; pad any missing trailing_optional with
    # explicit zero literals so the C runtime always sees the full
    # signature. Runtime bodies that treat 0 as "use the default"
    # (e.g. cssc_video_draw_text: `if (scale < 1) scale = 1;`) work
    # transparently.
    consumed: list = list(args)
    while len(consumed) < total_arity:
        consumed.append({'type': 'literal', 'value': 0,
                          'is_hex': False, 'line': line})
    arg_ids: List[int] = []
    llvm_arg_tys: List[CIRType] = []
    for a, ty in zip(consumed, spec.arg_types):
        if ty is CSTR:
            v_id, v_ty = _lower_expr(b, a, expected_kind='string')
            if v_ty.kind in ('i64', 'i1'):
                v_id = b.call('cssc_int_to_str', [v_id], [INT64],
                              return_type=STRING_PTR, external=True)
                v_ty = STRING_PTR
            elif v_ty.kind == 'f64':
                v_id = b.call('cssc_float_to_str', [v_id], [FLOAT64],
                              return_type=STRING_PTR, external=True)
                v_ty = STRING_PTR
            if v_ty.kind not in ('string_ptr', 'ptr'):
                raise _csscerror(
                    detail=f'{ns}::{func}: string arg required '
                           f'(got {v_ty.kind!r})',
                    line=line,
                )
            # CRITICAL: only call cssc_string_data when the pointer is a
            # heap cssc_str* (kind == 'string_ptr'). For a raw string
            # LITERAL (kind == 'ptr' from b.const_str), the pointer
            # already points at the first NUL-terminated byte of the
            # `[N x i8] c"..."` global — GEP'ing +8 into it (which is
            # what cssc_string_data does on a cssc_str layout) skips 8
            # bytes and reads whatever adjacent .rodata constant follows.
            # Symptom: `mouse::isClicked("left")` was received as
            # "aster Volume" in the C runtime because "left" is 5 bytes
            # (incl NUL) and offset 8 landed in the next literal.
            if v_ty.kind == 'string_ptr':
                data_id = b.call('cssc_string_data', [v_id], [PTR],
                                 return_type=PTR, external=True)
                arg_ids.append(data_id)
            else:
                arg_ids.append(v_id)
            llvm_arg_tys.append(PTR)
            continue
        if ty.kind == 'i64':
            v_id, v_ty = _lower_expr(b, a, expected_kind='int')
            if v_ty.kind == 'i1':
                v_id = b.zext_bool_to_int(v_id)
                v_ty = INT64
            elif v_ty.kind == 'f64':
                v_id = b.fptosi_to_int(v_id)
                v_ty = INT64
            elif v_ty.kind == 'f32':
                ext_id = b.call('__extendsfdf2', [v_id], [FLOAT32],
                                return_type=FLOAT64, external=True)
                v_id = b.fptosi_to_int(ext_id)
                v_ty = INT64
            elif v_ty.kind in ('ptr', 'string_ptr'):
                v_id = b.ptr_to_int(v_id)
                v_ty = INT64
            if v_ty.kind != 'i64':
                raise _csscerror(
                    detail=f'{ns}::{func}: int arg required '
                           f'(got {v_ty.kind!r})',
                    line=line,
                )
            arg_ids.append(v_id)
            llvm_arg_tys.append(INT64)
            continue
        if ty.kind == 'ptr':
            v_id, v_ty = _lower_expr(b, a)
            if v_ty.kind == 'i64':
                v_id = b.int_to_ptr(v_id)
                v_ty = PTR
            elif v_ty.kind not in ('ptr', 'string_ptr'):
                raise _csscerror(
                    detail=f'{ns}::{func}: handle/pointer arg required '
                           f'(got {v_ty.kind!r})',
                    line=line,
                )
            arg_ids.append(v_id)
            llvm_arg_tys.append(PTR)
            continue
        if ty.kind in ('f64', 'f32'):
            v_id, v_ty = _lower_expr(b, a, expected_kind='float')
            if v_ty.kind == 'i64':
                v_id = b.sitofp_to_double(v_id)
                v_ty = FLOAT64
            elif v_ty.kind == 'i1':
                zext = b.zext_bool_to_int(v_id)
                v_id = b.sitofp_to_double(zext)
                v_ty = FLOAT64
            elif v_ty.kind == 'f32' and ty.kind == 'f64':
                v_id = b.call('__extendsfdf2', [v_id], [FLOAT32],
                              return_type=FLOAT64, external=True)
                v_ty = FLOAT64
            if v_ty.kind not in ('f64', 'f32'):
                raise _csscerror(
                    detail=f'{ns}::{func}: float arg required '
                           f'(got {v_ty.kind!r})',
                    line=line,
                )
            arg_ids.append(v_id)
            llvm_arg_tys.append(ty)
            continue
        raise _csscerror(
            detail=f'{ns}::{func}: unsupported arg LLVM type '
                   f'{ty.kind!r}',
            line=line,
        )
    if spec.ret_type.is_void():
        b.call(spec.symbol, arg_ids, llvm_arg_tys,
               return_type=VOID, external=True)
        return (-1, VOID)
    rid = b.call(spec.symbol, arg_ids, llvm_arg_tys,
                 return_type=spec.ret_type, external=True)
    return (rid, spec.ret_type)


# ---------------------------------------------------------------------------
# Calls.
# ---------------------------------------------------------------------------
def _lower_ns_call(b: CIRBuilder, node: dict) -> int:
    ns = node.get('namespace')
    func = node.get('func')
    args = node.get('args', [])
    line = node.get('line')

    # Sector isolation (before any resolution): inside a sector body a
    # ns-call may only reach cssc::, the sector itself, its own functions,
    # or an injected <dep>. This runs FIRST so a leaked file-level include
    # alias can't silently resolve.
    _check_sector_isolation(ns, func, line)

    _alias_meta = _INCLUDED_MODULES.get(ns)
    if _alias_meta is not None and _alias_meta.get('transparent'):
        if func in _DEFINES:
            _lower_call(b, {
                'type': 'call', 'name': func, 'args': args, 'line': line,
            })
            return -1

    if ns == 'cssc' and func == 'outln':
        return _lower_outln(b, args, line, newline=True)
    if ns == 'cssc' and func == 'out':
        return _lower_outln(b, args, line, newline=False)

    # `cssc::*` value-producing builtins called as a statement — lower
    # via the expression path then discard the result.
    if ns == 'cssc' and func in ('abs', 'min', 'max', 'uptime'):
        _lower_ns_call_expr(b, node)
        return -1

    # `cssc::sleep(ms)` — block for the requested milliseconds. Routed
    # through a runtime call so the host (libc usleep / Sleep) and
    # embedded targets (vTaskDelay / wfi loop) can each pick their
    # idiomatic wait primitive.
    if ns == 'cssc' and func == 'sleep':
        if len(args) != 1:
            raise _csscerror(
                detail=f'cssc::sleep takes 1 arg (ms), got {len(args)}',
                line=line,
            )
        ms_id, ms_ty = _lower_expr(b, args[0], expected_kind='int')
        if ms_ty.kind != 'i64':
            raise _csscerror(
                detail=f'cssc::sleep: arg must be int (ms); got {ms_ty.kind!r}',
                line=line,
            )
        b.call('cssc_sleep_ms', [ms_id], [INT64],
               return_type=VOID, external=True)
        return -1

    # Phase 4b: Sector::func(args) — sector-scoped functions with parameters.
    # Sector-body #define/#cdefine registers `_DEFINES['Sec::func']` with
    # the sector-emitted symbol + full param metadata, so we can route
    # through _lower_call by synthesizing a bare-call node whose name is
    # the sector-qualified key.
    if ns in _SECTORS:
        qualified = f'{ns}::{func}'
        if qualified in _DEFINES:
            _lower_call(b, {
                'type': 'call', 'name': qualified,
                'args': args, 'line': line,
            })
            return -1
        if func not in _SECTORS[ns].get('functions', {}):
            raise _csscerror(
                detail=f"sector {ns} has no public function {func!r}",
                hint=f"declared: {sorted(_SECTORS[ns].get('functions', {}).keys())}",
                line=line,
            )
        sym = _SECTORS[ns]['functions'][func]
        if args:
            raise _csscerror(
                detail=(f'{ns}::{func}() takes 0 args (declared without a '
                        f'`#scanp({func}, …)` prologue)'),
                hint=('either drop the args, or add '
                      '`#scanp(func, TYPE, POS) name;` at the top of the '
                      'sector-body #define'),
                line=line,
            )
        b.call(sym, [], [], return_type=VOID, external=False)
        return -1

    # Diagnostic statement builtins — silent no-op in non-diagnostic
    # builds so user code stays portable across `cssc build` (skip)
    # and `cssc diagnostics` (where the legacy gcc pipeline emits the
    # actual marker). Native v6 hasn't wired the diagnostics injection
    # path yet; suppressing the call is correct (the diagnostic data
    # just doesn't surface) and unblocks programs that pepper their
    # source with `cssc::diag_mem("…")` checkpoints.
    if ns == 'cssc' and func in ('diag_mem', 'diag_trace', 'diag_heap',
                                   'diag_stack', 'diag_op'):
        return -1

    if ns == 'cssc' and func == 'panic':
        # Optional 1-arg string form: stringify + forward as a panic.
        # Without args this is a bare abort.
        if not args:
            b.call('cssc_panic', [], [], return_type=VOID, external=True)
            return -1
        msg_id, msg_ty = _lower_expr(b, args[0])
        if msg_ty.kind in ('ptr', 'string_ptr'):
            b.call('cssc_panic_msg', [msg_id], [PTR],
                   return_type=VOID, external=True)
        else:
            b.call('cssc_panic', [], [], return_type=VOID, external=True)
        return -1

    if ns == 'cssc' and func == 'reboot':
        # Hard reset on chip, exit(0) on host. Implemented via the
        # existing `cssc_runtime_shutdown` path on host; on Xtensa the
        # legacy `cssc_reboot` symbol resets the SoC. Forward both
        # behind a single CIR call so user code is portable.
        b.call('cssc_reboot', [], [], return_type=VOID, external=True)
        return -1

    # Game-namespace runtime dispatch — sprite/tm/font/keyboard/mouse/sound.
    # Uses `_resolve_ns` so both `#include('video.sprite') sprite;` and
    # `#include('video.sprite') sp;` reach the same runtime symbol via the
    # alias-resolution step. Statement-context: side-effect calls return
    # -1, value-producing calls are rejected with a targeted hint here.
    dispatched = _dispatch_ns_call_runtime(
        b, ns, func, args, line, context='stmt',
    )
    if dispatched is not None:
        return -1

    raise _csscerror(
        detail=f"{ns}::{func} not yet supported in v6 native",
        hint="Phase 1-3 supports cssc::outln; Phase 4 adds <Sector>::func()",
        line=line,
    )


# ---------------------------------------------------------------------------
# Phase 4a: sector lowering — namespaced #define functions.
# ---------------------------------------------------------------------------
def _sector_function_name(sector: str, func: str) -> str:
    """Map a CSSC sector function (e.g. `Cfg->show`) to its LLVM symbol."""
    return f'cssc_sec_{sector}_{func}'


def _lower_sector(b: CIRBuilder, node: dict) -> None:
    """Phase 4a/b — top-level `sector Name { … } free { … };` declaration.

    Walks the public/private body and emits:
      * For each `#stack[<int|bool|float>, N] m = expr;` member: an LLVM
        internal global `@cssc_sec_<Name>_<m>` + an init store emitted at
        the *current* insertion point (so member init runs in the order
        the sector appears in user_main).
      * For each `#define(Name->func) { body }` member: a CIR function
        `cssc_sec_<Name>_<func>`. Sector members are pre-bound in the
        function's scope via GlobalAddr.

    The free_body is stored in `_SECTORS` for later execution by
    `#free[Name];` at the user-code level. Member kinds are recorded so
    each `#delete[member]` in the free block resolves correctly.
    """
    line = node.get('line')
    name = node.get('name', '')
    if not name:
        raise _csscerror(detail='sector requires a name', line=line)
    # `sector Name<*params> ?label { … }` — deferred-init form
    # (CSSC spec §6.5). Register the sector node for later
    # instantiation by `#reserve[label]`; don't emit globals/funcs
    # now. Same-module only this session — cross-module
    # `#reserve[mod.label]` would need a global registry across
    # CIR modules + inter-module symbol coordination.
    reserve_label = (node.get('reserve_label') or '').strip()
    if reserve_label:
        if reserve_label in _DEFERRED_SECTORS:
            raise _csscerror(
                detail=f'sector deferred-init label '
                       f'{reserve_label!r} reused (previously by '
                       f'{_DEFERRED_SECTORS[reserve_label]["name"]!r})',
                hint='each `?label` must be unique in the module',
                line=line,
            )
        # Stash a shallow copy with reserve_label cleared so the
        # eventual recursion through `_lower_sector` doesn't loop.
        deferred_node = dict(node)
        deferred_node['reserve_label'] = ''
        _DEFERRED_SECTORS[reserve_label] = deferred_node
        return
    # Sector params (CSSC v6 spec §6.3):
    #
    # Sectors are SINGLETONS — they don't get instantiated like
    # objects. Their `<param_list>` exists purely to bring outer
    # names into the sector's lexical scope. The parser emits each
    # param as `{source_var, param_name, is_ref}`. Two shapes:
    #
    #   * Ref-capture: `<*outer>` or `<*outer_alias>` — `source_var`
    #     and `param_name` are BOTH the outer name. Pulls the outer
    #     alias into the body so `outer::func()` / `outer->m` /
    #     `#reserve[outer]` resolve. Lexical-only — no runtime
    #     allocation. Resolves against `_SECTORS` /
    #     `_DEFERRED_SECTORS` / `_INCLUDED_MODULES` / `_OBJECTS`.
    #
    #   * Type-annotated alias: `<Type: alias>` — `source_var` is a
    #     known type name (`int`, `string`, `vector<...>`, …) and
    #     `param_name` differs. Currently emitted by the parser but
    #     unused at runtime because sectors are singletons; we
    #     accept the shape but emit a soft INFO via the LSP and
    #     bind nothing here. Same behaviour as the interpreter.
    raw_params = node.get('params') or []
    sector_ref_captures: List[str] = []
    for p in raw_params:
        if not isinstance(p, dict):
            continue
        src = (p.get('source_var') or '').strip()
        pname = (p.get('param_name') or '').strip()
        if not src or not pname:
            continue
        if src == pname:
            # Ref-capture form. Verify the outer name is reachable
            # via the known global registries; if missing, raise a
            # clear error so the user fixes the typo BEFORE
            # downstream `_lower_ns_call` / `_lower_reserve_directive`
            # fails with a confusing "unknown sector" message.
            if (src in _SECTORS
                    or src in _DEFERRED_SECTORS
                    or src in _INCLUDED_MODULES
                    or src in _OBJECTS):
                sector_ref_captures.append(src)
            else:
                # Tolerant: maybe the outer was declared later in the
                # same module (forward reference) — e.g. user writes
                # `sector __main__<*app>` BEFORE `sector App ?app {…}`
                # appears textually. Don't error here; downstream
                # resolution (`_lower_reserve_directive`) will fire a
                # precise error if the name actually never lands.
                sector_ref_captures.append(src)
        # Type-annotated alias form is accepted but emits no runtime
        # binding. Sectors are singletons; the type annotation is
        # documentation-only in this context.
    # Ref-captures are lexical only — the body resolves them by name
    # against the existing global registries. No emission needed.
    if name in _SECTORS:
        raise _csscerror(
            detail=f'sector {name!r} redeclared', line=line,
        )

    members = (node.get('private_body', []) or []) + (node.get('public_body', []) or [])
    functions: Dict[str, str] = {}
    sector_slots: Dict[str, dict] = {}    # member-name → {'sym':..., 'kind':..., 'bits':...}
    define_members: List[dict] = []
    slot_member_inits: List[dict] = []    # AST nodes for #stack init in user_main

    # Phase B.4: pre-register the sector with its (initially empty) slots
    # dict BEFORE walking members. This way, when a nested sector/object's
    # lowering refers to `<this_sector>::member`, the lookup succeeds via
    # the live `sector_slots` dict (which is mutated by
    # `_register_sector_member` as the walk progresses — so a forward
    # reference from `object Inner { ... ThisSec::later_slot ... }` to a
    # slot declared LATER in this sector still resolves IF the slot has
    # been declared by the time the inner object's label body lowers.
    # Source-order discipline still applies for value-init dependencies.
    _SECTORS[name] = {
        'functions': functions,
        'free_body': node.get('free_body', []) or [],
        'slots':     sector_slots,
        # Injected dependency aliases from `sector Name<dep1, dep2>`. A
        # ns-call inside this sector's body may only target `cssc::`, this
        # sector itself, this sector's own functions, or one of these
        # injected deps — enforced by `_check_sector_isolation`.
        'deps':      set(sector_ref_captures),
    }

    # Pre-pass: collect every name that ANY `#define(target)` in this
    # sector body binds. A matching `#stack/#heap/#auto <name>;` before
    # such a `#define` is a FUNCTION-BINDING RESERVATION (Spec §6.1 /
    # MentalDiary-style `#stack[int, 32] run; #define(run) { … }`), NOT
    # Pre-scan sector-body #param directives so their type info is
    # visible to the sector-body cdefine desugar (which reads from
    # `_PARAM_TYPES` when synthesising scanp prologues).
    for _pm in members:
        if isinstance(_pm, dict) and _pm.get('type') == 'directive' \
                and _pm.get('directive') == 'param':
            _pname_s = (_pm.get('var') or '').strip()
            _ptype_s = (_pm.get('arg') or _pm.get('vtype')
                         or _pm.get('kind') or 'int')
            if isinstance(_ptype_s, str):
                _ptype_s = _ptype_s.strip()
            else:
                _ptype_s = 'int'
            if _pname_s:
                _PARAM_TYPES[_pname_s] = (_normalise_slot_type(_ptype_s)
                                            or _ptype_s)

    # a data slot — skip its sector-member registration to avoid emitting
    # both a global slot AND a function with the same `cssc_sec_<Sec>_<f>`
    # symbol (clang rejects the double-define).
    define_targets: set = set()
    for m in members:
        if m.get('type') == 'define':
            t = (m.get('target') or '').strip()
            if t:
                # Strip whichever qualifier is in use (`::` is canonical
                # per the access-operator rule; `->` was a doc mistake
                # that some older corpora still use and we still accept
                # as a legacy alias with a clear migration error at the
                # site below).
                if '::' in t:
                    define_targets.add(t.partition('::')[2])
                elif '->' in t:
                    define_targets.add(t.partition('->')[2])
                else:
                    define_targets.add(t)

    for member in members:
        m_type = member.get('type')
        if m_type == 'cdefine':
            _cd_name = member.get('target', '')
            _cd_params = member.get('params', []) or []
            _cd_body = member.get('body', []) or []
            _cd_line = member.get('line', line)
            _body_scanp_types_sec = {}
            def _cd_visit(nn):
                if isinstance(nn, dict):
                    if nn.get('type') == 'scanp' and nn.get('source', '') == _cd_name:
                        try:
                            _pp = int(nn.get('pos', 0))
                        except (TypeError, ValueError):
                            _pp = -1
                        if _pp >= 0:
                            _vt = (nn.get('vtype') or 'int')
                            if _vt.startswith('*'):
                                _vt = _vt[1:]
                            _body_scanp_types_sec.setdefault(_pp, _vt.strip())
                    for _v in nn.values():
                        if isinstance(_v, (dict, list)):
                            _cd_visit(_v)
                elif isinstance(nn, list):
                    for _e in nn:
                        _cd_visit(_e)
            for _b in _cd_body:
                _cd_visit(_b)
            _synth_scanps = [{
                'type':       'scanp',
                'source':     _cd_name,
                'vtype':      (_body_scanp_types_sec.get(i)
                               or _PARAM_TYPES.get(pname)
                               or 'int'),
                'pos':        i,
                'var':        pname,
                'var_prefix': '',
                'is_copy':    False,
                'default':    None,
                'optional':   False,
                'line':       _cd_line,
            } for i, pname in enumerate(_cd_params)]
            member = dict(member)
            member['type'] = 'define'
            member['body'] = _synth_scanps + _cd_body
            m_type = 'define'
        if m_type == 'define':
            target = member.get('target', '')
            # CSSC access-operator rule (per implementation, the doc
            # was wrong about this):
            #   `::` — sector-scoped (functions AND members). The
            #          canonical form for `#define(Sec::func)`.
            #   `->` — object-scoped (member declarations / accesses
            #          on object instances). NOT valid for sectors.
            #   `.`  — object-label call on an instance.
            #
            # Accepted shapes for a sector-body `#define`:
            #   bare      `#define(func)`        — inside a sector body
            #                                       the sector IS the
            #                                       lexical scope, so a
            #                                       bare name is the
            #                                       idiomatic v6 form.
            #   qualified `#define(Sec::func)`   — explicit form, must
            #                                       match the enclosing
            #                                       sector.
            #
            # `Sec->func` is rejected with a migration error — quietly
            # accepting it produced silent-no-op codegen on Xtensa for
            # multi-member sectors (particle_world.cssc's chip hang).
            if '::' in target:
                sec_part, _, func_part = target.partition('::')
                if sec_part != name:
                    raise _csscerror(
                        detail=f"#define in sector {name!r} cannot "
                               f"target {sec_part!r}",
                        line=member.get('line', line),
                    )
            elif '->' in target:
                sec_part, _, func_part = target.partition('->')
                raise _csscerror(
                    detail=(f"#define({target}): `->` is for object "
                            f"member access, NOT sector function "
                            f"declaration. Sectors use `::`."),
                    hint=(f"change `#define({sec_part}->{func_part})` "
                          f"to `#define({sec_part}::{func_part})`. "
                          f"CSSC access operators: `::` for sectors, "
                          f"`->` for object members, `.` for object "
                          f"label calls."),
                    line=member.get('line', line),
                )
            else:
                func_part = target
                # Normalise the AST so downstream lowering paths that
                # inspect `target` see the canonical qualified form
                # with `::` (matches the access-operator rule).
                member = dict(member)
                member['target'] = f'{name}::{func_part}'
            functions[func_part] = _sector_function_name(name, func_part)
            define_members.append(member)
            continue
        if m_type == 'directive':
            d = member.get('directive')
            if d in ('stack', 'heap', 'auto'):
                slot_name = (member.get('var') or '').strip()
                # Function-binding reservation — `#stack[…] run;`
                # immediately followed by `#define(run)` in this body.
                # The slot exists only to reserve the name for the
                # function; the `#define` provides the actual code.
                # Skip emission to avoid the double-define collision.
                if slot_name and slot_name in define_targets:
                    continue
                _register_sector_member(b, name, member, sector_slots, line)
                slot_member_inits.append(member)
                continue
            # `#delete[member]` in the sector body is treated as
            # "release this sector member NOW, mid-init" — useful when
            # the body uses a slot to set up something (e.g. iterate an
            # array, push its contents into a peripheral) then doesn't
            # need it anymore. The slot global stays declared (so a
            # later `Sec::member` access reads null), and the runtime
            # release path frees the heap content. The `free {}` block
            # remains the canonical place for end-of-life cleanup, but
            # body-level `#delete` is now allowed for fine-grained
            # lifecycle control.
            # Other directives (`#reserve`, `#include`, `#req`, …) and
            # plain expression statements are accepted as sector-init
            # code — they execute when the sector's body is reached
            # (or when `#reserve[label]` fires for deferred sectors).
            # Recorded for emission AFTER the slot-member inits so
            # storage is allocated before any code reads it.
            slot_member_inits.append(member)
            continue
        # Executable statements (`cssc::outln(...)`, `obj.label()`,
        # `app::run()`, etc.) at sector body level become sector-init
        # code, emitted inline at the current insertion point. This
        # supports the canonical `sector __main__` pattern where the
        # program's entry point lives in the sector body without
        # needing a wrapping `#define(__main__->run) { … }`.
        if m_type in ('expr_stmt', 'call', 'ns_call', 'method_call',
                       'dot_call', 'assign', 'arrow_assign',
                       'dot_assign', 'if', 'for', 'while', 'select',
                       'block', 'private_scope', 'hex_scope',
                       'return', 'mirror', 'break', 'continue',
                       'jump', 'select_jump',
                       'call_label', 'destruct',
                       # Phase 5: result-capture forms `obj.method() r;`
                       # and direct ctor calls `Cls() inst;` inside a
                       # sector body's init region. These already work at
                       # top level via _lower_result_capture / object
                       # ctor lowering; the sector init region delegates
                       # to the same dispatcher (`_lower_stmt`) when
                       # `_emit_sector_member_init` runs them.
                       'result_capture', 'object_ctor', 'inst_decl'):
            slot_member_inits.append(member)
            continue
        # Phase 5: `object <Name> <...> { ... } free { ... }` declared
        # inside a sector body. The object's ctor / labels / free become
        # module-global symbols (registered via `_lower_object`), and the
        # sector's binding context is pushed so any `<sector_name>`
        # template-arg the inner object references resolves against the
        # already-declared sector (caro's `object Display<display,
        # tftlib, std>` references the `std` sector + `display`/`tftlib`
        # imports). Instance creation (`Display() dp;`) and method calls
        # (`dp.run();`) that follow in the sector body land in the
        # `expr_stmt` / `method_call` arms above as init statements —
        # they run at sector-init time, the canonical place.
        if m_type == 'object':
            _owning_sector_push(name)
            try:
                _lower_object(b, member)
            finally:
                _owning_sector_pop()
            continue
        # Phase B.1: sector-inside-sector. The inner sector lowers as a
        # sibling top-level symbol (its slots use the standard
        # `cssc_sec_<Inner>_<member>` naming), but the outer sector's
        # binding context is pushed so the inner can resolve
        # `<outer_member>` template-arg references against the
        # already-declared outer slots. Inner sector's ctor + free run
        # at the same program-order position as the outer's other
        # init items.
        if m_type == 'sector':
            _owning_sector_push(name)
            try:
                _lower_sector(b, member)
            finally:
                _owning_sector_pop()
            continue
        raise _csscerror(
            detail=f'Phase 4b: sector member of type {m_type!r} not supported',
            hint='supported: #stack/#heap/#auto/#define for storage, '
                 'object declarations, and arbitrary executable '
                 'statements (cssc::outln, method calls, control flow) '
                 'for the sector init body. Use `#define(<Sector>-><func>) '
                 '{ … }` to declare a callable that can be invoked later '
                 'via `<Sector>::<func>()`.',
            line=member.get('line', line),
        )

    # (Sector already registered at top of function — Phase B.4. The
    # `functions` / `slots` dicts were captured by reference, so the
    # writes above are already visible via `_SECTORS[name]`.)

    # Run member-init stores at the current insertion point (which is
    # whatever user_main is processing right now). This makes init order
    # follow the source order of the sectors at the top level.
    #
    # Before walking the inits, bind every just-registered sector member
    # into the current scope so bare-name references INSIDE the init
    # body (e.g. `select (arr) ?i { ... }` where `arr` is `Sec->arr`)
    # resolve via the standard slot machinery. Without this binding,
    # `arr` looks unbound and the lowering errors with
    # "undefined identifier 'arr'". Symmetric to `_bind_sector_members`
    # which the sector's #define-function path uses.
    _owning_sector_push(name)
    _bind_sector_members(b, name)
    try:
        for member in slot_member_inits:
            _emit_sector_member_init(b, name, member, sector_slots)
    finally:
        # Unbind members so the surrounding scope (user_main) doesn't
        # see them after the sector's init region ends. Sector members
        # remain accessible via `Sec::member` from any subsequent code;
        # the scope binding only matters during the sector's own init.
        for mname in sector_slots:
            try:
                b.scope_unbind(mname)
                b.scope_unbind(f'{name}->{mname}')
            except Exception:
                pass
        _owning_sector_pop()

    # Pass 2: emit each #define function body with sector members bound.
    # Phase 4b: sector functions accept args via the same ABI as top-level
    # #defines. The body's #scanp(func, TYPE, POS) prescan drives arity +
    # per-position kinds; each arg is spilled to a stack slot; #scanp
    # reads from param_slots via the temporary `_DEFINES[func_part]`
    # metadata we install during body lowering.
    for member in define_members:
        target = member['target']
        func_part = target.partition('::')[2]
        sym = functions[func_part]
        body_stmts = member.get('body', []) or []

        arity, arg_kinds, arg_param_names = _prescan_define_args(
            body_stmts, func_part)
        arg_kinds = ['int' if k == 'auto' else k for k in arg_kinds]
        for i, k in enumerate(arg_kinds):
            if (k not in _NATIVE_PARAM_SCALAR_KINDS
                    and k not in _CONTAINER_PARAM_KINDS):
                raise _csscerror(
                    detail=(f'#define({name}::{func_part}): param #{i} '
                            f'kind {k!r} not supported'),
                    hint=('supported native param kinds: int, string, '
                          'float, bool, and container kinds (vector<T>, '
                          'array<T>, map<K,V>, bind<T>)'),
                    line=member.get('line', line),
                )

        return_kind_sec = _prescan_define_returns(body_stmts)
        if return_kind_sec == 'int':
            return_ty_sec = INT64
        elif return_kind_sec == 'bool':
            return_ty_sec = BOOL
        elif return_kind_sec == 'float':
            return_ty_sec = FLOAT64
        elif return_kind_sec == 'string':
            return_ty_sec = STRING_PTR
        else:
            return_ty_sec = VOID

        params_sec = ([('__nargs', INT64)]
                       + [(f'__arg{i}', INT64) for i in range(arity)])

        qualified = f'{name}::{func_part}'
        info_sec = {
            'sym': sym,
            'arity': arity,
            'arg_kinds': arg_kinds,
            'arg_param_names': arg_param_names,
            'param_slots': [],
            'n_args_slot': -1,
            'return_kind': return_kind_sec,
            'return_ty': return_ty_sec,
            'mirror_value_slot': -1,
            'mirror_ref_slot':   -1,
            'mirror_used':       False,
            'is_sector_func':    True,
        }
        _DEFINES[qualified] = info_sec
        prior_bare = _DEFINES.get(func_part)
        _DEFINES[func_part] = info_sec

        _instance_scope_enter()
        _owning_sector_push(name)
        _callable_alias_push()
        try:
            with b.function(sym, return_ty_sec, params_sec):
                _bind_sector_members(b, name)
                n_args_slot_sec = b.slot_alloc('int', 64)
                b.slot_store(n_args_slot_sec, 0, INT64)
                param_slots_sec: List[int] = []
                for i in range(arity):
                    slot = b.slot_alloc('int', 64)
                    b.slot_store(slot, i + 1, INT64)
                    param_slots_sec.append(slot)
                b._slots.pop('__nargs', None)                  # noqa: SLF001
                b._slot_kinds.pop('__nargs', None)             # noqa: SLF001
                for i in range(arity):
                    b._slots.pop(f'__arg{i}', None)            # noqa: SLF001
                    b._slot_kinds.pop(f'__arg{i}', None)       # noqa: SLF001
                info_sec['param_slots'] = param_slots_sec
                info_sec['n_args_slot'] = n_args_slot_sec

                mirror_kind_sec = (return_kind_sec
                                    if return_kind_sec in ('int', 'bool',
                                                             'float') else 'int')
                mirror_value_slot_sec = b.slot_alloc(mirror_kind_sec, 64)
                if return_kind_sec == 'bool':
                    b.slot_store(mirror_value_slot_sec, b.const_bool(False),
                                 BOOL)
                elif return_kind_sec == 'float':
                    b.slot_store(mirror_value_slot_sec, b.const_float(0.0),
                                 FLOAT64)
                else:
                    b.slot_store(mirror_value_slot_sec, b.const_int(0),
                                 INT64)
                mirror_ref_slot_sec = b.slot_alloc('int', 64)
                b.slot_store(mirror_ref_slot_sec, b.const_int(0), INT64)
                info_sec['mirror_value_slot'] = mirror_value_slot_sec
                info_sec['mirror_ref_slot']   = mirror_ref_slot_sec
                info_sec['mirror_used']       = False

                try:
                    for stmt in body_stmts:
                        _lower_stmt(b, stmt)
                    if (return_kind_sec in ('int', 'bool', 'float', 'string')
                            and not _current_block_terminates(b)):
                        _emit_mirror_epilogue_ret(
                            b, mirror_value_slot_sec, mirror_ref_slot_sec,
                            return_kind=return_kind_sec)
                finally:
                    info_sec['param_slots'] = []
                    info_sec['n_args_slot'] = -1
                    info_sec['mirror_value_slot'] = -1
                    info_sec['mirror_ref_slot']   = -1
                    info_sec['mirror_used']       = False
        finally:
            if prior_bare is not None:
                _DEFINES[func_part] = prior_bare
            else:
                _DEFINES.pop(func_part, None)
            _callable_alias_pop()
            _owning_sector_pop()
            _instance_scope_exit()


# Phase 4b: sector member kinds that map to module globals.
# POD kinds get a direct slot_store of the value; heap kinds get a
# ptr-typed module global whose init runs the matching `_init_*` helper
# (the container's heap allocation) at sector-init time and whose
# `#free[Sector]` block releases via the standard slot_release dispatch.
_SECTOR_MEMBER_POD = frozenset({'int', 'bool', 'float'})
_SECTOR_MEMBER_KINDS = frozenset({
    'int', 'bool', 'float',
    'string',
    'vector_int', 'vector_float', 'vector_bool', 'vector_string',
    'array_int', 'array_float', 'array_bool', 'array_string',
    'map_si', 'map_ss', 'map_is', 'map_ii', 'map_sf', 'map_if',
    'bind_ss', 'bind_entry', 'array_bind',
})

# Phase 4f/g: object members can be POD or heap-typed.
_OBJECT_MEMBER_KINDS = frozenset({
    'int', 'bool', 'float',
    'string',
    'vector_int', 'vector_float',
    'vector_bool',    # Phase A.1
    'vector_string',  # Phase A.2
    'array_int', 'array_float',
    'array_bool',     # Phase A.3
    # Phase 5b: array<string> — caro.cssc's `Display->caro_letters` pattern.
    # Each entry is a refcount-managed cssc_str* (4-byte ptr on Xtensa,
    # 8-byte ptr on host). Iteration via `select` + element-delete via
    # `#delmember[arr[i]]` mirror array_bind semantics; storage mirrors
    # array_int / array_float (header + flat ptr table).
    'array_string',
    'map_si', 'map_ss', 'map_is', 'map_ii', 'map_sf', 'map_if',
    'bind_ss', 'bind_entry', 'array_bind',
})

# Field storage type per object-member kind. All entries are 8 bytes so
# `sizeof = 8 * num_fields` holds and the per-instance malloc math stays
# trivial.
_OBJECT_FIELD_STORAGE = {
    'int':           'i64',
    'bool':          'i64',   # i1 padded to i64 for uniform 8-byte field layout
    'float':         'double',
    'string':        'ptr',
    'vector_int':    'ptr',
    'vector_float':  'ptr',
    'vector_bool':   'ptr',   # Phase A.1
    'vector_string': 'ptr',   # Phase A.2
    'array_int':     'ptr',
    'array_float':   'ptr',
    'array_bool':    'ptr',   # Phase A.3
    'array_string':  'ptr',
    'map_si':        'ptr',
    'map_ss':        'ptr',
    'map_is':        'ptr',
    'map_ii':        'ptr',
    'map_sf':        'ptr',
    'map_if':        'ptr',
    'bind_ss':       'ptr',
    'bind_entry':    'ptr',
    'array_bind':    'ptr',
}


def _sector_member_symbol(sector: str, member: str) -> str:
    return f'cssc_sec_{sector}_{member}'


def _kind_to_storage_ty(kind: str) -> str:
    """Map a CSSC slot kind to its LLVM storage type for a module global."""
    if kind == 'int':   return 'i64'
    if kind == 'bool':  return 'i1'
    if kind == 'float': return 'double'
    return 'ptr'   # vector/map/bind/string — heap-pointer globals (Phase 4c)


def _register_sector_member(b: CIRBuilder, sector: str, member: dict,
                            sector_slots: dict, line: Optional[int]) -> None:
    """Allocate a module-level global for a sector slot member."""
    directive = member['directive']
    mname = member.get('var', '')
    if not mname:
        raise _csscerror(detail=f'#{directive} sector member requires a name',
                         line=member.get('line', line))
    if directive == 'auto':
        kind = member.get('arg', '').strip()
        bits = 64
    else:
        kind_raw, bits = _parse_slot_arg(member.get('arg', ''))
        kind = _normalise_slot_type(kind_raw)
    if kind not in _SECTOR_MEMBER_KINDS:
        raise _csscerror(
            detail=f'sector slot {sector}::{mname}: kind {kind!r} '
                   f'not supported as a sector member',
            hint=f'allowed kinds: {sorted(_SECTOR_MEMBER_KINDS)}',
            line=member.get('line', line),
        )
    sym = _sector_member_symbol(sector, mname)
    sector_slots[mname] = {'sym': sym, 'kind': kind, 'bits': bits}
    storage = _kind_to_storage_ty(kind)
    b.register_module_global(sym, storage)


def _emit_sector_member_init(b: CIRBuilder, sector: str, member: dict,
                             sector_slots: dict) -> None:
    """Emit the runtime init for ONE sector body item at the current
    insertion point (typically inside `cssc_user_main`).

    Three shapes:
      * `#stack/#heap/#auto Name = init;` → store the init value into
        the module global allocated for the member.
      * Other directives (`#reserve`, `#include`, `#req`, etc.) → route
        through the regular `_lower_directive` path so they execute
        in the sector's program-order position.
      * Plain executable statements (expr_stmt, call, if, for, etc.)
        → route through `_lower_stmt` so the sector body acts like an
        auto-running ctor. Used by the canonical `sector __main__ { … }`
        pattern where the program's entry point lives at sector-body
        level without a wrapping `#define`.
    """
    m_type = member.get('type')
    if m_type == 'directive':
        directive = member.get('directive')
        if directive in ('stack', 'heap', 'auto'):
            return _emit_sector_slot_init(b, sector, member, sector_slots)
        # Any other directive — route via the standard handler. The
        # sector's scope-walk has already registered slot members, so
        # `#req[member]` / `#delete[member]` / `#reserve[label]` /
        # `#include('mod') alias;` etc. all resolve correctly here.
        return _lower_directive(b, member)
    # Plain executable statement → lower as a normal stmt.
    return _lower_stmt(b, member)


def _emit_sector_slot_init(b: CIRBuilder, sector: str, member: dict,
                            sector_slots: dict) -> None:
    """Emit the init store for a `#stack/#heap/#auto` sector slot
    member at the current insertion point. Extracted from
    `_emit_sector_member_init` so the dispatcher there can stay
    focused on routing.

    Phase 4c: heap-kind sector members (string, vector_*, array_*,
    map_*, bind_*) route through their dedicated init helpers
    (`_init_string`, `_init_vector`, `_init_map_si`, `_init_bind_ss`,
    `_init_array_bind`) — same machinery the per-instance object
    member init uses. The module global is a `ptr` that gets the
    heap allocation's address; downstream loads via `Sec::member`
    pick that up via slot_load.
    """
    line = member.get('line')
    mname = member['var']
    meta = sector_slots[mname]
    kind = meta['kind']
    init = member.get('value')
    addr = b.global_addr(meta['sym'])

    # Heap kinds: even when no init expression is given, we must run the
    # container's `_init_*` so the global ptr holds a real (empty)
    # container — release at #free time then wouldn't dereference null.
    if kind == 'string':
        init_node = init if init is not None else {'type': 'string', 'value': ''}
        _init_string(b, addr, init_node, line)
        return
    if kind in ('vector_int', 'vector_float', 'vector_bool',
                'vector_string',
                'array_int', 'array_float', 'array_bool', 'array_string'):
        init_node = (init if init is not None
                     else {'type': 'array', 'elements': []})
        _init_vector(b, addr, kind, init_node, meta.get('bits', 64), line)
        return
    if kind == 'map_si':
        init_node = (init if init is not None
                     else {'type': 'map_literal', 'pairs': []})
        _init_map_si(b, addr, init_node, meta.get('bits', 64), line)
        return
    if kind == 'map_ss':
        init_node = (init if init is not None
                     else {'type': 'map_literal', 'pairs': []})
        _init_map_ss(b, addr, init_node, meta.get('bits', 64), line)
        return
    if kind == 'map_is':
        init_node = (init if init is not None
                     else {'type': 'map_literal', 'pairs': []})
        _init_map_is(b, addr, init_node, meta.get('bits', 64), line)
        return
    if kind == 'map_ii':
        init_node = (init if init is not None
                     else {'type': 'map_literal', 'pairs': []})
        _init_map_ii(b, addr, init_node, meta.get('bits', 64), line)
        return
    if kind == 'map_sf':
        init_node = (init if init is not None
                     else {'type': 'map_literal', 'pairs': []})
        _init_map_sf(b, addr, init_node, meta.get('bits', 64), line)
        return
    if kind == 'map_if':
        init_node = (init if init is not None
                     else {'type': 'map_literal', 'pairs': []})
        _init_map_if(b, addr, init_node, meta.get('bits', 64), line)
        return
    if kind == 'bind_ss':
        init_node = (init if init is not None
                     else {'type': 'bind_literal', 'pairs': []})
        _init_bind_ss(b, addr, init_node, meta.get('bits', 64), line)
        return
    if kind == 'bind_entry':
        init_node = (init if init is not None
                     else {'type': 'array_literal', 'items': []})
        _init_bind_entry(b, addr, init_node, meta.get('bits', 64), line)
        # Copy the inferred cell kind onto the sector slot's metadata
        # so subsequent `_bind_sector_members` calls (one per sector
        # function entry — each producing a FRESH `addr` SSA id) can
        # re-register the cell kind under the new id.
        meta['cell_kind'] = _BIND_CELL_KIND.get(addr)
        return
    if kind == 'array_bind':
        init_node = (init if init is not None
                     else {'type': 'array_literal', 'items': []})
        _init_array_bind(b, addr, init_node, meta.get('bits', 64), line)
        return

    # POD path (int / bool / float).
    if init is None:
        return  # global is zero-initialised, no extra store needed.
    val_id, val_ty = _lower_expr(b, init, expected_kind=kind)
    val_cir = {'int': INT64, 'bool': BOOL, 'float': FLOAT64}[kind]
    if not _slot_kinds_compatible(val_ty.kind, val_cir.kind):
        raise _csscerror(
            detail=f'sector {sector}::{mname}: init value of kind '
                   f'{val_ty.kind!r} cannot be stored in {kind!r} slot',
            line=line,
        )
    b.slot_store(addr, val_id, val_cir)


def _bind_sector_members(b: CIRBuilder, sector: str) -> None:
    """Inside a sector function body (or `#free[Sector]`), bind every
    sector member's name to a GlobalAddr SSA id so subsequent identifier
    references resolve to the global storage via the slot machinery.

    Each member is bound under both its bare name (`_ltk`) and the
    sector-qualified arrow form (`Loot->_ltk`) — the parser produces
    arrow_access nodes for `Sec->member` even when accessed from within
    the sector's own body, so both must resolve.
    """
    info = _SECTORS.get(sector, {})
    for mname, meta in info.get('slots', {}).items():
        addr = b.global_addr(meta['sym'])
        b.scope_bind(mname, addr, elem_kind=meta['kind'])
        qualified_name = f'{sector}->{mname}'
        b.scope_bind(qualified_name, addr, elem_kind=meta['kind'])
        b._slot_bits[addr] = meta.get('bits', 64)   # noqa: SLF001
        ck = meta.get('cell_kind')
        if ck:
            _BIND_CELL_KIND[addr] = ck


# ---------------------------------------------------------------------------
# Phase 4d: objects with labels — per-instance heap state.
# Each `Object()` mallocs a fresh `%cssc_obj_<Type>` struct; instances are
# independent. Label functions take a `ptr %self` parameter and access
# members via getelementptr on %self.
# ---------------------------------------------------------------------------
def _object_label_name(obj: str, label: str) -> str:
    return f'cssc_obj_{obj}_{label}'


def _object_struct_name(obj: str) -> str:
    return f'cssc_obj_{obj}'


def _bind_object_members(b: CIRBuilder, obj: str, self_ssa: int) -> None:
    """Inside an object label body / `#free[inst]`, bind each member
    name (and arrow-qualified form `Object->m`) to a MemberAddr SSA id
    computed off the given `self_ssa`.

    Also binds any ref-captures the object declared. Peripheral captures
    bind the LOADED ptr (as a real handle slot the GPIO method lowering
    can consume); module-alias captures rely on `_INCLUDED_MODULES`
    staying populated across the object's body lowering, so no binding
    is needed — `<alias>::*` resolution looks there directly.
    """
    info = _OBJECTS.get(obj, {})
    struct_ty = _object_struct_name(obj)
    for mname, meta in info.get('slots', {}).items():
        field_p = b.member_addr(self_ssa, struct_ty, meta['field_idx'])
        b.scope_bind(mname, field_p, elem_kind=meta['kind'])
        b.scope_bind(f'{obj}->{mname}', field_p, elem_kind=meta['kind'])
        # Propagate the declared bit-width so slot_load on this member
        # picks FLOAT32 for `#stack[float, 32]` members. Without this
        # the load defaults to FLOAT64 and downstream arithmetic
        # against another f32 value triggers a mixed-type type error.
        b._slot_bits[field_p] = meta.get('bits', 64)   # noqa: SLF001
    for cap in info.get('ref_captures', []) or []:
        if cap['field_idx'] < 0:
            continue   # module alias / ct-const — lexical only
        # Load the captured ptr from its struct field, then alloca a
        # one-slot wrapper holding the same ptr so identifier lookup
        # works the same way as for normal peripheral slots (slot_load
        # → ptr; method dispatch does GEP-less calls).
        field_p = b.member_addr(self_ssa, struct_ty, cap['field_idx'])
        loaded_ptr = b.slot_load(field_p, cap['kind'])
        wrap = b.slot_alloc(cap['kind'], 64)
        b.slot_store(wrap, loaded_ptr, PTR)
        b.scope_bind(cap['param_name'], wrap, elem_kind=cap['kind'])
        # Ref-captured object handles also need to register on the
        # _INSTANCES stack of the current function frame — otherwise
        # `vd.label_method()` calls inside the body fail the
        # inst-dispatch lookup. The cap['kind'] tells us the source
        # was an `object_handle` (from `b.scope_kind(src)` at decl
        # time); we record the cap's class so `inst.label()` dispatch
        # can find the matching `cssc_obj_<Type>_<label>` symbol.
        if cap['kind'] == 'object_handle':
            src_var = cap.get('source_var', '')
            # The source ref points at an outer instance; look up its
            # object type from the global _INSTANCES_GLOBAL_TYPES if
            # we tracked it, otherwise from the parent frame's stack.
            obj_type_of_src = _instance_lookup_type(src_var)
            if obj_type_of_src:
                _instance_bind(cap['param_name'], obj_type_of_src)


def _walk_ast(nodes, visit_fn) -> None:
    """A.3.11: universal AST walker for prescan-style passes.

    Visits every dict node reachable from `nodes`, calling `visit_fn(node)`
    on each. After the visit, every dict-valued AND list-of-dict-valued
    field is descended into automatically — no static key allow-list to
    forget about. The four prescan helpers (mirror-kind, define-returns,
    define-args, req-targets) all need to see `#scanp`/`return`/`mirror`/
    `#req` references inside arbitrary nesting (conditions, iterables,
    call args, indexing keys, binary operands, …); a static key list
    historically missed `condition`/`iterable`/`args`/`index`/`left`/
    `right`/`operand` and silently dropped subnodes.

    The visitor must return False to skip recursing into a node's
    children (used by mirror-prescan once a mirror is found so the same
    mirror isn't double-counted through `mirror.value`).
    """
    if nodes is None:
        return
    if isinstance(nodes, dict):
        stack = [nodes]
    elif isinstance(nodes, (list, tuple)):
        stack = [n for n in nodes if isinstance(n, dict)]
    else:
        return
    while stack:
        n = stack.pop()
        if not isinstance(n, dict):
            continue
        result = visit_fn(n)
        if result is False:
            continue
        for v in n.values():
            if isinstance(v, dict):
                stack.append(v)
            elif isinstance(v, list):
                for it in v:
                    if isinstance(it, dict):
                        stack.append(it)
                    elif isinstance(it, (list, tuple)):
                        # Nested list (e.g. bind_literal pairs); flatten.
                        for sub in it:
                            if isinstance(sub, dict):
                                stack.append(sub)


def _prescan_label_mirror_kind(body: list,
                                  obj_slots: Optional[Dict[str, dict]] = None,
                                  obj_name: Optional[str] = None
                                  ) -> Optional[str]:
    """Find the kind of value `mirror X;` returns inside a label body.

    A label that mirrors any value becomes a value-returning function;
    if multiple mirrors are present they must agree on kind. Returns
    None if the label never mirrors.

    Inference rules (best-effort static):
      * `mirror <intLit>` / `<boolLit>` / `<floatLit>` → that POD kind
      * `mirror <string>` → 'string'
      * `mirror <identifier>` → look up the slot kind in `obj_slots`
        (object members) when the name matches; otherwise default
      * `mirror <obj>->member` / `mirror <obj>.member` → same lookup
      * `mirror <obj>[i]` where obj is a container member → reduce
        one level (`vector<int>` → 'int', `vector<vector<X>>` →
        `vector<X>`)
      * `mirror <call>(…)` / `mirror <ns>::<call>(…)` → look up the
        callee's `return_kind` from `_DEFINES`/`_OBJECTS` when known
      * any other shape → default 'int'

    Multiple `mirror` exprs with disagreeing inferred kinds → hard
    error (the function can have ONE return type). When inference
    yields the SAME default for both, no conflict is flagged — only
    explicit-disagreement triggers.
    """
    seen_kind: Optional[str] = None
    seen_explicit: bool = False
    obj_slots = obj_slots or {}

    def infer(value_node) -> Tuple[str, bool]:
        """Return (kind, is_explicit). `is_explicit=True` means we
        confidently inferred from the AST shape; False means we
        fell back to 'int'."""
        if not isinstance(value_node, dict):
            return ('int', False)
        t = value_node.get('type')
        if t == 'literal':
            v = value_node.get('value')
            if isinstance(v, bool):
                return ('bool', True)
            if isinstance(v, int):
                return ('int', True)
            if isinstance(v, float):
                return ('float', True)
            return ('int', False)
        if t == 'string':
            return ('string', True)
        if t == 'identifier':
            nm = (value_node.get('name') or '').strip()
            slot_meta = obj_slots.get(nm)
            if slot_meta:
                return (slot_meta.get('kind', 'int'), True)
            return ('int', False)
        if t in ('arrow_access', 'dot_access'):
            obj = value_node.get('object') or {}
            key = (value_node.get('key') or '').strip()
            if (isinstance(obj, dict)
                    and obj.get('type') == 'identifier'
                    and obj_name is not None
                    and ((obj.get('name') == obj_name) or (obj.get('name') == 'self'))):
                slot_meta = obj_slots.get(key)
                if slot_meta:
                    return (slot_meta.get('kind', 'int'), True)
            return ('int', False)
        if t == 'index':
            inner_kind, inner_explicit = infer(value_node.get('object'))
            if not inner_explicit:
                return ('int', False)
            # Reduce one level. Same rules as the LSP's
            # `_resolve_receiver_element_kind`.
            if inner_kind.startswith('vector_vec_'):
                return ('vector_' + inner_kind[len('vector_vec_'):], True)
            if inner_kind.startswith('vector_'):
                return (inner_kind[len('vector_'):], True)
            if inner_kind.startswith('array_bind'):
                return ('bind_entry', True)
            if inner_kind.startswith('array_'):
                return (inner_kind[len('array_'):], True)
            if inner_kind == 'string':
                return ('int', True)   # byte index
            return ('int', False)
        if t == 'call':
            cname = (value_node.get('name') or '').strip()
            info = _DEFINES.get(cname)
            if info:
                rk = info.get('return_kind')
                if rk:
                    return (rk, True)
            return ('int', False)
        if t == 'ns_call':
            # Resolve through the shared ns-call return-kind registry
            # (cssc:: builtins + _NS_CALL_RUNTIME) so an object label that
            # mirrors e.g. `ini::read(...)` or `cssc::to_string(...)` is
            # typed correctly instead of defaulting to int.
            k = _ns_call_return_kind(value_node.get('namespace') or '',
                                     value_node.get('func') or '')
            if k is not None:
                return (k, True)
            return ('int', False)
        return ('int', False)

    def visit(n: dict):
        nonlocal seen_kind, seen_explicit
        if n.get('type') == 'mirror':
            kind, explicit = infer(n.get('value'))
            if seen_kind is None:
                seen_kind = kind
                seen_explicit = explicit
            elif explicit and seen_explicit and seen_kind != kind:
                raise _csscerror(
                    detail=(f'label body has multiple `mirror` exprs '
                            f'with disagreeing inferred kinds '
                            f'({seen_kind!r} vs {kind!r}). A label '
                            f'can only return ONE type.'),
                    hint='ensure every mirror in this label returns the '
                         'same kind, or split into separate labels.',
                    line=n.get('line'),
                )
            elif explicit and not seen_explicit:
                # Upgrade from a default-inferred kind to an explicit one.
                seen_kind = kind
                seen_explicit = True
            return False  # don't recurse into mirror.value (already counted)
        return None

    _walk_ast(body, visit)
    return seen_kind


def _lower_object(b: CIRBuilder, node: dict) -> None:
    """Lower a top-level `object Name<…> { … } free { … };` declaration.

    Phase 4e+f: per-instance heap state with two ctor-param forms:
      * **Typed POD** (`<int: count>`) — pass a value into the ctor.
        Stored as a real field; available inside labels by name.
      * **Untyped ref** (`<*display>`) — capture an outside binding by
        name. If the outside name is a peripheral slot we store its
        loaded ptr as a `ptr` field (label bodies see it as the same
        peripheral kind). If the outside name is a module alias
        (`#include`d), the capture is purely lexical — we don't add a
        struct field, only ensure the alias stays visible during label
        lowering so `tft::WHITE`-style access keeps working.

    Each `Object(args...)` instantiation mallocs a fresh `%cssc_obj_<Type>`
    struct and calls `cssc_obj_<Type>_ctor(self, …)` to initialise. The
    ctor signature matches: typed params first, then captured-ref ptrs.
    """
    line = node.get('line')
    name = node.get('name', '')
    if not name:
        raise _csscerror(detail='object requires a name', line=line)
    if name in _OBJECTS or name in _SECTORS:
        raise _csscerror(detail=f'identifier {name!r} redeclared', line=line)

    # ---- Parse ctor params ----
    # Separate into typed POD params vs ref captures. Both end up as
    # ctor function parameters; only typed POD ones become explicit
    # caller args (ref captures are auto-resolved at construction site).
    ctor_params: List[Tuple[str, str]] = []         # (name, cssc_kind) typed args
    ref_captures: List[Tuple[str, str, str]] = []   # (param_name, source_var, captured_kind)
    for p in node.get('params', []) or []:
        pname = p.get('param_name', '')
        if p.get('is_typed', True):
            ptype = _normalise_slot_type(p.get('source_var', ''))
            if ptype == 'auto':
                ctor_params.append((pname, 'auto'))
                continue
            if ptype in ('int', 'bool', 'float'):
                ctor_params.append((pname, ptype))
                continue
            if (ptype == 'string'
                    or ptype == 'array_string'
                    or ptype in ('vector_int', 'vector_float',
                                 'array_int', 'array_float',
                                 'map_si', 'map_ss', 'map_is', 'map_ii',
                                 'map_sf', 'map_if',
                                 'bind_ss', 'array_bind')):
                # Heap-kind ctor params: pass as ptr, wrap in a member-
                # mirrored slot inside the ctor body so the init code
                # can treat them like normal heap locals.
                ctor_params.append((pname, ptype))
                continue
            # `object: *name` / `sector: *name` — TYPED ref-capture.
            # These aren't ctor args (no value flows through the call
            # site); they're a documentation-bearing form of the
            # untyped `<*name>` capture. The `object` / `sector`
            # marker just tells the reader (and future static
            # checkers) which kind of capture this is. Route through
            # the same ref-capture pipeline as `<*name>` so the body
            # resolves `name.method()` / `name::member` via the
            # existing lookup rules.
            if ptype in ('object', 'sector'):
                src = pname
                if b.scope_has(src):
                    captured_kind = b.scope_kind(src)
                    ref_captures.append((pname, src, captured_kind))
                elif src in _SECTORS or src in _INCLUDED_MODULES:
                    # Sector / module alias — lexical only.
                    ref_captures.append((pname, src, '__module_alias__'))
                elif src in _OBJECTS:
                    # Object TYPE name as capture source — e.g. user
                    # wrote `object: *Counter` to capture the Counter
                    # type for default-instantiating. Not yet wired,
                    # but accept here so a future implementation can
                    # consume it.
                    ref_captures.append((pname, src, 'object_handle'))
                elif src in _CT_CONSTS:
                    ref_captures.append((pname, src, '__ct_const__'))
                else:
                    raise _csscerror(
                        detail=(f"object {name!r}: typed ref-capture "
                                f"`{ptype}: *{src}` — no slot, instance, "
                                f"sector, module, or #DEFINE named "
                                f"{src!r} in scope"),
                        hint=('declare the source in outer scope first, '
                              'or drop the `:` to use the bare '
                              '`<*name>` form.'),
                        line=line,
                    )
                continue
            raise _csscerror(
                detail=f"object {name!r}: typed ctor param {pname!r} "
                       f"kind {ptype!r} not yet supported",
                hint='supported: int, bool, float, auto, string, '
                     'object, sector, vector<int|float>, '
                     'array<int|float|string|bind>, '
                     'map<string,int>, bind',
                line=line,
            )
            continue
        # Untyped ref capture — `<*name>` form.
        src = p.get('source_var', pname)
        if b.scope_has(src):
            captured_kind = b.scope_kind(src)
            ref_captures.append((pname, src, captured_kind))
        elif src in _INCLUDED_MODULES:
            # Module alias — lexical only. Record so label lowering
            # keeps the alias visible (for `<alias>::*` resolution).
            ref_captures.append((pname, src, '__module_alias__'))
        elif src in _SECTORS:
            # Phase 5: sector reference. `object Foo<*sec>` captures a
            # previously-declared sector by name. Sectors live in
            # `_SECTORS` (not in slot scope or module imports); they
            # have no runtime ptr (their globals/functions are module-
            # global symbols already), so we record them as lexical
            # aliases — the object's label-body identifier lookup
            # resolves `<sec>::member` against `_SECTORS[sec]['slots']`
            # the same way top-level code does.
            ref_captures.append((pname, src, '__module_alias__'))
        elif src in _CT_CONSTS:
            # #DEFINE compile-time constant — there's no runtime slot
            # to ref-capture, but the constant is already globally
            # available via the _CT_CONSTS registry. Record it as a
            # CT-const "alias" so the body's identifier-lookup still
            # finds the value via the compile-time path.
            ref_captures.append((pname, src, '__ct_const__'))
        else:
            raise _csscerror(
                detail=f"object {name!r}: ref-capture <*{src}> — no slot "
                       f"or module alias named {src!r} in scope",
                hint='Available: declared slots, included modules, '
                     'previously-declared sectors, '
                     '#DEFINE compile-time constants.',
                line=line,
            )

    # ---- Pass 1: walk body in source order. Each entry is tagged as
    # 'member' (persistent struct field, prefixed `Foo->name`) or
    # 'stmt' (ctor-body action — unprefixed slot decl, #delete, call,
    # expr_stmt, …). The ctor lowering then walks `ctor_program` in
    # order, so a ctor-local declared BEFORE a member-init can be
    # read by that member-init (e.g.
    #   #stack[string, 256] ltxt = 'foo';
    #   #stack[array<bind>, …] Foo->Buffer = {{0, 19, ltxt}};
    # ). Member fields are still allocated up front at field-table
    # build time — only the *initialisation* is order-dependent.
    obj_slots: Dict[str, dict] = {}
    field_tys: List[str] = []
    field_counter = 0
    ctor_program: List[Tuple[str, dict]] = []
    for member in node.get('top_level', []) or []:
        mtype = member.get('type')
        if mtype != 'directive':
            ctor_program.append(('stmt', member))
            continue
        d = member.get('directive')
        if d in ('stack', 'heap', 'auto'):
            full_var = member.get('var', '')
            if '->' not in full_var:
                ctor_program.append(('stmt', member))
                continue
            obj_part, _, mname = full_var.partition('->')
            if obj_part != name:
                raise _csscerror(
                    detail=f"object {name!r} member name targets "
                           f"{obj_part!r}",
                    line=member.get('line', line),
                )
            if d == 'auto':
                kind = member.get('arg', '').strip()
                bits = 64
            else:
                kind_raw, bits = _parse_slot_arg(member.get('arg', ''))
                kind = _normalise_slot_type(kind_raw)
            # Float bit-width policy mirrors `_lower_slot_decl`: object
            # members of `float` kind must be ≥64-bit. A 32-bit slot
            # produces a denormal-read bug downstream because the rest
            # of the pipeline assumes float64.
            if kind == 'float' and bits < 64:
                raise _csscerror(
                    detail=f'object {name} member #{d}[float, {bits}] '
                           f'{name}->{mname}: float slots must be ≥ 64 '
                           f'bits',
                    hint=(f'CSSC v6 native uses double-precision (64-bit) '
                          f'floats throughout. A narrower slot is stored '
                          f'as float32 but loaded as float64, producing '
                          f'a denormal value (≈5e-315). Change to:  '
                          f'#{d}[float, 64] {name}->{mname} = …;'),
                    line=member.get('line', line),
                )
            if kind not in _OBJECT_MEMBER_KINDS:
                raise _csscerror(
                    detail=f'Phase 4f: object slot {name}::{mname} kind '
                           f'{kind!r} not yet supported',
                    hint=f'currently supported: {sorted(_OBJECT_MEMBER_KINDS)}',
                    line=member.get('line', line),
                )
            storage = _OBJECT_FIELD_STORAGE.get(kind, 'i64')
            obj_slots[mname] = {
                'kind':      kind,
                'bits':      bits,
                'field_idx': field_counter,
                'storage':   storage,
            }
            field_tys.append(storage)
            field_counter += 1
            ctor_program.append(('member', member))
            continue
        # Peripheral / GPIO-style directives targeting a qualified
        # `Obj->name` (e.g. `#pin[N] Foo->LED;`) make the handle a
        # PERSISTENT object member — without this, the directive
        # falls through to the 'stmt' bucket and the member never
        # gets a struct field, so labels can't access `Obj->LED.write`.
        # All these kinds store as a `ptr` (the runtime allocates the
        # peripheral handle struct; the field holds the pointer).
        if (d in ('pin', 'i2c', 'spi', 'uart', 'adc', 'pwm', 'timer',
                   'tft', 'oled', 'video', 'matrix',
                   'framebuffer', 'console')):
            full_var = member.get('var', '')
            if '->' in full_var:
                obj_part, _, mname = full_var.partition('->')
                if obj_part != name:
                    raise _csscerror(
                        detail=f"object {name!r} member name targets "
                               f"{obj_part!r}",
                        line=member.get('line', line),
                    )
                # Peripheral handles tagged with their directive kind
                # so _bind_object_members can dispatch method-style
                # `Obj->LED.write(…)` against the matching `cssc_<kind>_*`
                # runtime symbols.
                obj_slots[mname] = {
                    'kind':      d,
                    'bits':      64,
                    'field_idx': field_counter,
                    'storage':   'ptr',
                }
                field_tys.append('ptr')
                field_counter += 1
                ctor_program.append(('peripheral_member', member))
                continue
        ctor_program.append(('stmt', member))
    init_member_nodes = [m for kind_tag, m in ctor_program
                         if kind_tag == 'member']

    ctorParamMemberFields: List[Tuple[str, str, int]] = []
    for pname, pkind in ctor_params:
        if pkind not in ('int', 'bool', 'float', 'string'):
            continue
        if pname in obj_slots:
            continue
        storage = ('ptr' if pkind == 'string'
                   else 'f64' if pkind == 'float'
                   else 'i1' if pkind == 'bool'
                   else 'i64')
        obj_slots[pname] = {
            'kind':      pkind,
            'bits':      64,
            'field_idx': field_counter,
            'storage':   storage,
        }
        field_tys.append(storage)
        ctorParamMemberFields.append((pname, pkind, field_counter))
        field_counter += 1

    for pname, pkind in ctor_params:
        if pkind == 'auto':
            continue
        if pkind in ('int', 'bool', 'float', 'string'):
            continue
        if pname in obj_slots:
            continue
        obj_slots[pname] = {
            'kind':      pkind,
            'bits':      64,
            'field_idx': field_counter,
            'storage':   'ptr',
        }
        field_tys.append('ptr')
        ctorParamMemberFields.append((pname, pkind, field_counter))
        field_counter += 1

    for pname, pkind, fidx in ctorParamMemberFields:
        ctor_program.insert(0, ('ctor_param_store',
                                 {'name': pname, 'kind': pkind,
                                  'field_idx': fidx}))


    # Each captured peripheral handle gets a `ptr` field after the
    # declared members so the ctor can store the outside ptr and the
    # label bodies can load it back. Module aliases stay lexical-only
    # and don't get a field.
    ref_capture_meta: List[dict] = []
    for pname, src, captured_kind in ref_captures:
        if captured_kind in ('__module_alias__', '__ct_const__'):
            ref_capture_meta.append({
                'param_name':  pname,
                'source_var':  src,
                'kind':        captured_kind,
                'field_idx':   -1,        # no field — lexical only
            })
            continue
        ref_capture_meta.append({
            'param_name':  pname,
            'source_var':  src,
            'kind':        captured_kind,
            'field_idx':   len(field_tys),
        })
        field_tys.append('ptr')

    # Register the named struct type for this object so MemberAddr GEPs
    # resolve at emit time. Note: a 0-member object still gets a struct
    # so its `cssc_obj_alloc` call has a positive size.
    if not field_tys:
        field_tys.append('i8')   # placeholder so malloc has non-zero size
    struct_ty = _object_struct_name(name)
    b.register_struct_type(struct_ty, field_tys)

    # ---- Pass 2: enumerate labels → LLVM symbol names + per-label params. ----
    instr_map = node.get('instructions', {}) or {}
    labels: Dict[str, str] = {}
    label_params: Dict[str, List[Tuple[str, str]]] = {}
    # Label-overload expansion: if `<name>__overloads` is present and
    # non-empty, replace the single (`<name>`, `<name>__params`) pair
    # with one synthetic label per overload, named `<name>__a<arity>`.
    # The original `<name>` keeps pointing at the 0-arg overload (if
    # any) so back-compat 0-arg callers still resolve. Each synthetic
    # entry gets its own params + body, so the rest of the lowering
    # treats overloads as ordinary distinct labels — no special-casing
    # below Pass 2.
    overload_aliases: Dict[str, List[Tuple[int, str]]] = {}
    expanded_instr: Dict[str, list] = {}
    for k, v in instr_map.items():
        if k.endswith('__overloads'):
            base = k[:-len('__overloads')]
            arities_present: List[Tuple[int, str]] = []
            for ov_idx, ov in enumerate(v or []):
                ov_params = ov.get('params', []) or []
                ov_body = ov.get('body', []) or []
                arity = len(ov_params)
                # First overload of each arity wins a clean symbol;
                # subsequent same-arity overloads get an index suffix
                # (no real arity-overloading semantic, just to keep
                # symbol names unique).
                already = sum(1 for (a, _) in arities_present if a == arity)
                sym_suffix = f'a{arity}' if already == 0 else f'a{arity}_{already}'
                ov_name = f'{base}__{sym_suffix}'
                expanded_instr[ov_name] = ov_body
                expanded_instr[f'{ov_name}__params'] = ov_params
                arities_present.append((arity, ov_name))
            overload_aliases[base] = arities_present
            continue
        expanded_instr[k] = v
    # Now drop the base `<name>` and `<name>__params` entries that
    # were replaced by overload aliases — they're empty stubs the
    # parser left behind.
    for base in overload_aliases.keys():
        expanded_instr.pop(base, None)
        expanded_instr.pop(f'{base}__params', None)
    instr_map = expanded_instr

    for label_name in instr_map.keys():
        # Parser stores label parameters under `<label>__params` and
        # any extra-arity overloads under `<label>__overloads`. We only
        # iterate the canonical label names here; overloads have already
        # been expanded to synthetic `<base>__a<arity>` entries above.
        if label_name.endswith('__params') or label_name.endswith('__overloads'):
            continue
        labels[label_name] = _object_label_name(name, label_name)
        params_meta = instr_map.get(f'{label_name}__params', []) or []
        lparams: List[Tuple[str, str]] = []
        for p in params_meta:
            pname = p.get('name', '')
            ptype = _normalise_slot_type(p.get('type', ''))
            if ptype == 'auto':
                # `auto:` param: a heterogeneous (val, tag) cell pair.
                # Each auto param consumes two physical CIR params, the
                # raw 64-bit value and the 1-byte type tag widened to i32
                # for ABI uniformity. Encoded in the param tuple as the
                # internal kind 'auto'; the ctor/label body emits two
                # slots via _promote_value_params_to_slots and the inst
                # call path mirrors the same two-arg shape.
                lparams.append((pname, 'auto'))
                continue
            # POD scalars (int/bool/float) pass by value; every heap kind
            # (string, vector<T>, array<T>, map<S,I>, bind<S,S>, array<bind>)
            # passes a `ptr` to the heap header. The label body wraps
            # heap-typed params in a fresh ptr-storing slot so existing
            # method dispatch (which expects a slot id) sees them
            # identically to a locally-declared #stack[bind, …].
            if ptype in ('int', 'bool', 'float'):
                lparams.append((pname, ptype))
                continue
            if (ptype == 'string'
                    or ptype in _OBJECT_MEMBER_KINDS
                    or ptype in ('vector_int', 'vector_float',
                                 'array_int', 'array_float',
                                 'map_si', 'map_ss', 'map_is', 'map_ii',
                                 'map_sf', 'map_if',
                                 'bind_ss', 'array_bind')):
                lparams.append((pname, ptype))
                continue
            raise _csscerror(
                detail=f"label {name}::{label_name} param {pname!r} kind "
                       f"{ptype!r} not yet supported",
                hint='supported: int, bool, float, auto, string, '
                     'vector<int|float>, array<int|float|bind>, '
                     'map<string,int>, bind',
                line=line,
            )
        label_params[label_name] = lparams

    # Pre-compute each label's return shape — `mirror <expr>;` makes a
    # label value-returning so `inst.label() r;` can capture it.
    # Pass `obj_slots` and `name` so the prescan can infer types from
    # `mirror obj->member` / `mirror obj->vec[i]` / `mirror self->m`
    # expressions instead of always defaulting to `int`.
    label_return_kinds: Dict[str, Optional[str]] = {}
    for label_name in instr_map.keys():
        if label_name.endswith('__params') or label_name.endswith('__overloads'):
            continue
        label_return_kinds[label_name] = _prescan_label_mirror_kind(
            instr_map.get(label_name) or [],
            obj_slots=obj_slots,
            obj_name=name,
        )

    ctor_sym = f'cssc_obj_{name}_ctor'
    _OBJECTS[name] = {
        'slots':       obj_slots,
        'labels':      labels,
        'label_params': label_params,
        'label_returns': label_return_kinds,
        'overload_aliases': overload_aliases,  # base → [(arity, synth_name)]
        'struct_ty':   struct_ty,
        'free_body':   node.get('free_body', []) or [],
        'init_member_nodes': init_member_nodes,
        'ctor_program': ctor_program,
        'ctor_sym':    ctor_sym,
        'ctor_params': ctor_params,
        'ref_captures': ref_capture_meta,
    }

    # ---- Pass 3: emit constructor. ABI:
    #   void cssc_obj_<Name>_ctor(ptr self,
    #                             <typed-ctor-args>...,
    #                             <ref-capture ptrs>...)
    # Ref captures come last so a script that passes only the typed
    # args keeps its existing positional shape. ---------------------
    ctor_fn_params: List[Tuple[str, CIRType]] = [('self', PTR)]
    ctor_auto_param_indices: List[Tuple[str, int, int]] = []
    ctor_heap_param_indices: List[Tuple[str, int, str]] = []
    for pname, pkind in ctor_params:
        if pkind == 'auto':
            val_idx = len(ctor_fn_params)
            ctor_fn_params.append((f'{pname}__val', INT64))
            tag_idx = len(ctor_fn_params)
            ctor_fn_params.append((f'{pname}__tag', INT64))
            ctor_auto_param_indices.append((pname, val_idx, tag_idx))
            continue
        if pkind in ('int', 'bool', 'float'):
            ctor_fn_params.append((pname, _cssc_kind_to_cirtype(pkind)))
            continue
        # heap-kind ctor param — same wrapping pattern as label heap params
        ctor_heap_param_indices.append((pname, len(ctor_fn_params), pkind))
        ctor_fn_params.append((pname, PTR))
    for cap in ref_capture_meta:
        if cap['field_idx'] < 0:
            continue   # module alias — no ctor arg
        ctor_fn_params.append((f"__cap_{cap['param_name']}", PTR))
    # A.3.13: ctor body gets its own _INSTANCES frame (matched by an
    # _instance_scope_exit() after the `with` block below).
    _instance_scope_enter()
    _auto_param_scope_enter()
    with b.function(ctor_sym, VOID, ctor_fn_params):
        _promote_value_params_to_slots(b, ctor_fn_params)
        # CRITICAL ordering: ref-capture ptrs must be stored into their
        # struct fields BEFORE `_bind_object_members` runs. The bind
        # step reads the cap field via `slot_load` and wraps the
        # result in a name-bound slot; if the field still holds the
        # zero-init garbage from `cssc_obj_alloc` at that point, every
        # later `cap.method(…)` call dispatches through a NULL self
        # pointer and faults on the first member-load (excvaddr=0,
        # cause-28 LoadProhibited inside the called label's prologue).
        #
        # Heap-kind ctor params (string / vector / map) wrap their ptr
        # in a fresh slot — they don't go through the struct so they
        # can stay where they are, but moving them up keeps the order
        # consistent: every cap-shaped binding happens first.
        # Store ref-capture ptrs into their fields. The ctor param's
        # SSA id is its index in ctor_fn_params — auto params consume two
        # slots each, heap params one, so step accordingly.
        _cap_arg_idx = 1
        for _pn, _pk in ctor_params:
            _cap_arg_idx += 2 if _pk == 'auto' else 1
        for cap in ref_capture_meta:
            if cap['field_idx'] < 0:
                continue
            ptr_addr = b.member_addr(0, struct_ty, cap['field_idx'])
            b.slot_store(ptr_addr, _cap_arg_idx, PTR)
            _cap_arg_idx += 1
        # NOW bind object members + ref-captures — the cap fields are
        # populated, so the bind's slot_load picks up the real ptrs.
        ctorParamLocalSlots: Dict[str, int] = {}
        for _pn, _pk in ctor_params:
            if _pk == 'auto':
                continue
            try:
                ctorParamLocalSlots[_pn] = b.scope_lookup(_pn)
            except Exception:
                pass

        _bind_object_members(b, name, 0)
        for pname, pkind in ctor_params:
            if pkind in ('int', 'bool', 'float', 'string'):
                if pname in ctorParamLocalSlots:
                    b.scope_bind(pname, ctorParamLocalSlots[pname],
                                 elem_kind=pkind)
        for pname, ssa_idx, hkind in ctor_heap_param_indices:
            hslot = b.slot_alloc(hkind, 64)
            b.slot_store(hslot, ssa_idx, PTR)
            b.scope_unbind(pname)
            b.scope_bind(pname, hslot, elem_kind=hkind)
        # Bind auto ctor-params (val_ssa, tag_ssa) for bind-cell forward.
        for pname, val_idx, tag_idx in ctor_auto_param_indices:
            _auto_param_bind(pname, val_idx, tag_idx)
        # Walk the ctor program in source order so a ctor-local that
        # appears before a `Foo->member = …` init is in scope when the
        # init evaluates its RHS. Each entry is either a persistent
        # member-init or a ctor-body statement (#stack[T,N] local,
        # `call label;`, `#delete[local];`, expression, …).
        for kind_tag, item in ctor_program:
            if kind_tag == 'ctor_param_store':
                pname = item['name']
                pkind = item['kind']
                memberAddr = b.scope_lookup(f'{name}->{pname}')
                localSlot = ctorParamLocalSlots.get(pname)
                if memberAddr is None or localSlot is None or localSlot == memberAddr:
                    continue
                if pkind == 'int':
                    val = b.slot_load(localSlot, 'int')
                    b.slot_store(memberAddr, val, INT64)
                elif pkind == 'bool':
                    val = b.slot_load(localSlot, 'bool')
                    b.slot_store(memberAddr, val, BOOL)
                elif pkind == 'float':
                    val = b.slot_load(localSlot, 'float')
                    b.slot_store(memberAddr, val, FLOAT64)
                elif pkind == 'string':
                    val = b.slot_load(localSlot, 'string')
                    b.slot_store(memberAddr, val, PTR)
                    b.call('cssc_retain', [val], [PTR],
                           return_type=VOID, external=True)
                else:
                    val = b.slot_load(localSlot, pkind)
                    b.slot_store(memberAddr, val, PTR)
                continue
            if kind_tag == 'peripheral_member':
                d = item.get('directive', '')
                mname = item.get('var', '').partition('->')[2]
                parts = item.get('arg_parts') or []
                arity = _GPIO_NEW_ARITY.get(d, 0)
                effectiveD = d
                if d == 'tft' and len(parts) >= 6:
                    effectiveD = 'oled'
                    arity = _GPIO_NEW_ARITY['oled']
                argIds: List[int] = []
                for i in range(arity):
                    raw = parts[i] if i < len(parts) else ''
                    if i == 0 and effectiveD in ('tft', 'oled'):
                        stripped = (raw or '').strip().strip('"').strip("'")
                        ctrlId = _TFT_CTRL_IDS.get(stripped.lower(),
                                                    _TFT_CTRL_IDS.get(stripped))
                        if ctrlId is None and not stripped:
                            ctrlId = 1
                        if ctrlId is None:
                            raise _csscerror(
                                detail=(f'#{effectiveD}: unknown controller '
                                        f'name {stripped!r}'),
                                line=item.get('line', line),
                            )
                        argIds.append(b.const_int(ctrlId))
                        continue
                    argIds.append(_gpio_resolve_int_arg(
                        b, raw, 0, item.get('line', line)))
                handle = b.call(
                    f'cssc_{effectiveD}_new', argIds,
                    [INT64] * arity, return_type=PTR, external=True,
                )
                memberAddr = b.scope_lookup(f'{name}->{mname}')
                if memberAddr is not None:
                    b.slot_store(memberAddr, handle, PTR)
                continue
            if kind_tag == 'member':
                mname = item['var'].partition('->')[2]
                meta = obj_slots[mname]
                init = item.get('value')
                if init is None:
                    continue
                slot = b.scope_lookup(f'{name}->{mname}')
                kind = meta['kind']
                if kind == 'string':
                    _init_string(b, slot, init, item.get('line', line))
                elif kind in ('vector_int', 'vector_float',
                              'array_int', 'array_float',
                              'array_string'):
                    _init_vector(b, slot, kind, init,
                                 meta.get('bits', 64),
                                 item.get('line', line))
                elif kind == 'map_si':
                    _init_map_si(b, slot, init,
                                 meta.get('bits', 64),
                                 item.get('line', line))
                elif kind == 'map_ss':
                    _init_map_ss(b, slot, init,
                                 meta.get('bits', 64),
                                 item.get('line', line))
                elif kind == 'map_is':
                    _init_map_is(b, slot, init,
                                 meta.get('bits', 64),
                                 item.get('line', line))
                elif kind == 'map_ii':
                    _init_map_ii(b, slot, init,
                                 meta.get('bits', 64),
                                 item.get('line', line))
                elif kind == 'map_sf':
                    _init_map_sf(b, slot, init,
                                 meta.get('bits', 64),
                                 item.get('line', line))
                elif kind == 'map_if':
                    _init_map_if(b, slot, init,
                                 meta.get('bits', 64),
                                 item.get('line', line))
                elif kind == 'bind_ss':
                    _init_bind_ss(b, slot, init,
                                  meta.get('bits', 64),
                                  item.get('line', line))
                elif kind == 'array_bind':
                    _init_array_bind(b, slot, init,
                                     meta.get('bits', 64),
                                     item.get('line', line))
                else:
                    val_id, val_ty = _lower_expr(b, init, expected_kind=kind)
                    val_cir = _cssc_kind_to_cirtype(kind)
                    if kind == 'float':
                        member_bits = meta.get('bits', 64)
                        if member_bits == 32 and val_ty.kind == 'f64':
                            val_id = b.call('__truncdfsf2', [val_id],
                                            [FLOAT64], return_type=FLOAT32,
                                            external=True)
                            val_ty = FLOAT32
                        elif member_bits == 64 and val_ty.kind == 'f32':
                            val_id = b.call('__extendsfdf2', [val_id],
                                            [FLOAT32], return_type=FLOAT64,
                                            external=True)
                            val_ty = FLOAT64
                        val_cir = FLOAT32 if member_bits == 32 else FLOAT64
                    if val_ty.kind != val_cir.kind:
                        raise _csscerror(
                            detail=f'object {name}::{mname}: init kind '
                                   f'mismatch ({val_ty.kind} vs {kind})',
                            line=item.get('line', line),
                        )
                    b.slot_store(slot, val_id, val_cir)
                continue
            # kind_tag == 'stmt' — ctor-body action.
            t_stmt = item.get('type')
            d_stmt = item.get('directive')
            if t_stmt == 'call_label' or (
                    t_stmt == 'directive' and d_stmt == 'call'):
                _emit_self_label_call(b, item, name, labels,
                                      label_params, label_return_kinds,
                                      line)
                continue
            _lower_stmt(b, item)
    # A.3.13: close the ctor's _INSTANCES frame.
    _auto_param_scope_exit()
    _instance_scope_exit()

    # ---- Pass 4: emit each label as
    #   void cssc_obj_<Name>_<label>(ptr %self, ...label params)
    # or, if the label `mirror`s a value, returning the mirrored kind.
    # The pre-scan in `label_return_kinds` decides each label's shape.
    for label_name, body in instr_map.items():
        if label_name.endswith('__params') or label_name.endswith('__overloads'):
            continue
        sym = labels[label_name]
        lparams = label_params[label_name]
        fn_params: List[Tuple[str, CIRType]] = [('self', PTR)]
        # Track which CIR-param-index pairs belong to each `auto:` param,
        # so the function body can bind them as (val, tag) pairs.
        auto_param_indices: List[Tuple[str, int, int]] = []
        # Heap-kind params: their ptr arrives as a raw SSA, but the
        # body's container-method dispatch expects a slot. After the
        # function opens we alloca a ptr-slot and store the SSA into
        # it, then rebind the name to the slot.
        heap_param_indices: List[Tuple[str, int, str]] = []
        for pname, pkind in lparams:
            if pkind == 'auto':
                # Two physical params: val (i64), tag (i32).
                val_idx = len(fn_params)
                fn_params.append((f'{pname}__val', INT64))
                tag_idx = len(fn_params)
                fn_params.append((f'{pname}__tag', INT64))
                auto_param_indices.append((pname, val_idx, tag_idx))
                continue
            if pkind in ('int', 'bool', 'float'):
                fn_params.append((pname, _cssc_kind_to_cirtype(pkind)))
                continue
            # heap kind — pass as ptr, slot-wrap in the body
            heap_param_indices.append((pname, len(fn_params), pkind))
            fn_params.append((pname, PTR))
        ret_kind = label_return_kinds.get(label_name)
        ret_ty = (_cssc_kind_to_cirtype(ret_kind)
                  if ret_kind in ('int', 'bool', 'float')
                  else (_kind_to_cir_storage(ret_kind)
                        if ret_kind else VOID))
        # A.3.13: each label method gets its own _INSTANCES frame too,
        # so a sibling label that declares the same handle name doesn't
        # see the prior label's stale entry.
        _instance_scope_enter()
        _auto_param_scope_enter()
        try:
            with b.function(sym, ret_ty, fn_params):
                _promote_value_params_to_slots(b, fn_params)
                _bind_object_members(b, name, 0)
                # Wrap each heap-kind label param in a fresh slot so the
                # body's existing container-method dispatch (which goes
                # through scope_lookup → slot_load) finds them the same
                # way it finds locally-declared containers.
                for pname, ssa_idx, hkind in heap_param_indices:
                    hslot = b.slot_alloc(hkind, 64)
                    b.slot_store(hslot, ssa_idx, PTR)
                    b.scope_unbind(pname)
                    b.scope_bind(pname, hslot, elem_kind=hkind)
                # Bind each auto-param name to its (val_ssa, tag_ssa)
                # pair so `_lower_bind_cell` can forward them when the
                # name appears in a bind-tuple literal.
                for pname, val_idx, tag_idx in auto_param_indices:
                    _auto_param_bind(pname, val_idx, tag_idx)
                # Push the object-owner frame so nested control-flow
                # bodies (if / select / while) can resolve self-directed
                # `call <other_label>(args);` against this object's
                # label table. Without this push, `_lower_stmt` would
                # reject `call_label` as "unsupported top-level node".
                _owning_object_push({
                    'name': name,
                    'labels': labels,
                    'label_params': label_params,
                    'label_return_kinds': label_return_kinds,
                    'line': line,
                })
                try:
                    for stmt in body or []:
                        t_lbl = stmt.get('type') if isinstance(stmt, dict) else None
                        d_lbl = (stmt.get('directive')
                                 if isinstance(stmt, dict) else None)
                        if t_lbl == 'call_label' or (
                                t_lbl == 'directive' and d_lbl == 'call'):
                            _emit_self_label_call(b, stmt, name, labels,
                                                  label_params,
                                                  label_return_kinds, line)
                            continue
                        _lower_stmt(b, stmt)
                    # Implicit fall-through: void labels auto-emit `ret void`,
                    # value-returning labels need a sentinel return when the
                    # body's last block hasn't already mirrored.
                    if ret_kind and not _current_block_terminates(b):
                        zero = b.const_int(0)
                        b.ret(zero, INT64)
                finally:
                    _owning_object_pop()
        finally:
            _auto_param_scope_exit()
            _instance_scope_exit()


def _emit_self_destruct(b: CIRBuilder, obj_name: str,
                         line: Optional[int]) -> None:
    info = _OBJECTS.get(obj_name)
    if info is None:
        raise _csscerror(
            detail=f'`destruct;` from inside object {obj_name!r}: '
                   f'object metadata missing',
            line=line,
        )
    inst_ptr = 0
    saved_slots = dict(b._slots)         # noqa: SLF001
    saved_kinds = dict(b._slot_kinds)    # noqa: SLF001
    try:
        _bind_object_members(b, obj_name, inst_ptr)
        for stmt in info.get('free_body', []) or []:
            _lower_stmt(b, stmt)
        struct_ty = info['struct_ty']
        for mname, meta in info.get('slots', {}).items():
            mkind = meta.get('kind', '')
            if not _is_heap_kind(mkind):
                continue
            field_addr = b.member_addr(inst_ptr, struct_ty,
                                        meta['field_idx'])
            b.slot_release(field_addr, mkind)
        b.call('cssc_obj_free', [inst_ptr], [PTR],
               return_type=VOID, external=True)
    finally:
        b._slots = saved_slots           # noqa: SLF001
        b._slot_kinds = saved_kinds      # noqa: SLF001
    cur_fn = b._current_fn               # noqa: SLF001
    if cur_fn is not None and not cur_fn.return_type.is_void():
        b.ret(b.const_int(0), cur_fn.return_type)
    else:
        b.ret()


def _emit_self_label_call(b: CIRBuilder, item: dict, obj_name: str,
                          labels: Dict[str, str],
                          label_params: Dict[str, List[Tuple[str, str]]],
                          label_return_kinds: Dict[str, Optional[str]],
                          line: int) -> None:
    """Emit a self-directed `call <label>(args);` from inside the same
    object's ctor or another label body.

    The current function's first SSA id (0) is always `self`, so we
    forward that as the receiver and lower each positional arg with the
    label's declared kind from `label_params`. `call_label` AST shape:
        {'type': 'call_label', 'label': str, 'args': [...], 'capture': ?}
    `directive+call` shape (legacy):
        {'type': 'directive', 'directive': 'call',
         'var'|'arg': '<label>'}   # no args supported in this form
    """
    t = item.get('type')
    if t == 'call_label':
        label_target = (item.get('label') or '').strip()
        arg_nodes = item.get('args') or []
    else:
        label_target = (item.get('var') or item.get('arg') or '').strip()
        arg_nodes = []
    if not label_target:
        raise _csscerror(
            detail=f"object {obj_name}: `call` directive with empty label",
            line=item.get('line', line),
        )
    if label_target not in labels:
        raise _csscerror(
            detail=f"object {obj_name}: `call {label_target};` references "
                   f"unknown label",
            hint=f'declared labels: {sorted(labels.keys())}',
            line=item.get('line', line),
        )
    target_sym = labels[label_target]
    lparams = label_params.get(label_target, []) or []
    if len(arg_nodes) != len(lparams):
        raise _csscerror(
            detail=f"object {obj_name}: `call {label_target}` expects "
                   f"{len(lparams)} arg(s), got {len(arg_nodes)}",
            line=item.get('line', line),
        )
    call_arg_ids: List[int] = [0]
    call_arg_tys: List[CIRType] = [PTR]
    for (pname, pkind), arg_node in zip(lparams, arg_nodes):
        if pkind == 'auto':
            v_id, t_id, _src = _lower_bind_cell(
                b, arg_node, item.get('line', line))
            call_arg_ids.append(v_id)
            call_arg_tys.append(INT64)
            call_arg_ids.append(t_id)
            call_arg_tys.append(INT64)
            continue
        # `*name` transfer-ref syntax — legacy explicit ref marker.
        # In v6 native, label args are ref-by-default, so the explicit
        # `*` produces the same call code as a bare identifier. Unwrap
        # the AST node here so `_lower_expr` (which doesn't know about
        # `transfer_ref`) sees a plain identifier.
        if (isinstance(arg_node, dict)
                and arg_node.get('type') == 'transfer_ref'):
            arg_node = {
                'type': 'identifier',
                'name': arg_node.get('name', ''),
                'line': arg_node.get('line', item.get('line', line)),
            }
        # Transient array literal as call arg: materialise into a
        # local slot, init from the literal, pass the slot's ptr.
        # Without this, `call write<{0, 0, 0, 0, 1}>;` hits the bare-
        # literal-in-expression-position error from _lower_expr. The
        # transient slot is anonymous; it stays alive until the function
        # epilogue's scope_pop frees it — exactly the v6 §2.5 transient-
        # temp contract.
        if (isinstance(arg_node, dict)
                and arg_node.get('type') in ('array', 'array_literal')
                and pkind in ('array_int', 'array_float', 'array_bool',
                              'array_string', 'array_bind',
                              'vector_int', 'vector_float',
                              'vector_bool', 'vector_string')):
            items = (arg_node.get('items')
                     or arg_node.get('elements') or [])
            cap_bytes = max(len(items) * 16, 256)
            tmp_slot = b.slot_alloc(pkind, cap_bytes)
            _init_vector(b, tmp_slot, pkind, arg_node, cap_bytes,
                         item.get('line', line))
            val_id = b.slot_load(tmp_slot, pkind)
            val_ty = PTR
            call_arg_ids.append(val_id)
            call_arg_tys.append(PTR)
            continue
        val_id, val_ty = _lower_expr(b, arg_node, expected_kind=pkind)
        expected_ty = _kind_to_cir_storage(pkind)
        if not _slot_kinds_compatible(val_ty.kind, expected_ty.kind):
            raise _csscerror(
                detail=f"object {obj_name}: `call {label_target}` arg "
                       f"{pname!r}: kind mismatch ({val_ty.kind} vs "
                       f"{expected_ty.kind})",
                line=item.get('line', line),
            )
        call_arg_ids.append(val_id)
        call_arg_tys.append(expected_ty)
        # v6 ref-by-default (Bug 3 fix): bare-identifier args registered
        # via `_emit_arg_link` so the callee's `#delete[arg]` propagates
        # back to the caller's slot through the runtime alias table.
        if (isinstance(arg_node, dict)
                and arg_node.get('type') == 'identifier'):
            src_name = (arg_node.get('name') or '').strip()
            if src_name and b.scope_has(src_name):
                src_slot = b.scope_lookup(src_name)
                _emit_arg_link(b, pname, src_slot)
    ret_kind = label_return_kinds.get(label_target)
    ret_ty = _kind_to_cir_storage(ret_kind) if ret_kind else VOID
    b.call(target_sym, call_arg_ids, call_arg_tys,
           return_type=ret_ty, external=False)


def _cssc_kind_to_cirtype(kind: str) -> CIRType:
    """Map a CSSC POD kind name to its CIRType singleton."""
    return {
        'int': INT64,
        'bool': BOOL,
        'float': FLOAT64,
    }[kind]


def _promote_value_params_to_slots(b: CIRBuilder,
                                   params: List[Tuple[str, CIRType]]) -> None:
    """For each value-typed function parameter (int/bool/float), allocate
    a stack slot, store the param's SSA value into it, and rebind the
    name to that slot. This lets identifier-lookup in the body's
    statements use the regular slot-load machinery without special-casing
    function-parameter SSA ids.

    `self`-style ptr params are left as direct SSA values — the lowering
    accesses them via `b.scope_lookup(name)` returning the SSA id.
    """
    _LLVM_TO_CSSC = {'i64': 'int', 'i1': 'bool', 'f64': 'float'}
    for i, (pname, ptype) in enumerate(params):
        if ptype.kind not in _LLVM_TO_CSSC:
            continue
        cssc_kind = _LLVM_TO_CSSC[ptype.kind]
        # The builder already bound pname → SSA id `i`. Re-bind to a fresh
        # slot that holds a copy of the value.
        slot = b.slot_alloc(cssc_kind, 64)
        b.slot_store(slot, i, ptype)
        b.scope_unbind(pname)
        b.scope_bind(pname, slot, elem_kind=cssc_kind)


def _lower_result_capture(b: CIRBuilder, node: dict) -> None:
    """Handle `Counter() c;` (Phase 4d object instantiation) **and**
    `f(args) r;` (free-function result capture).

    Resolution order:
      1. If `expr.name` matches a declared object → malloc-backed
         construction (existing Phase 4d path).
      2. Else if it matches a declared free function → lower as a call
         expression, alloca an `i64` slot for the result, store, bind.
      3. Else → error.

    Object path: allocates the struct, runs the ctor, stores the
    instance handle. Free-function path: just captures the return
    value (synthesises `i64 0` if the callee is void, matching the
    "no-return yields null/0" rule).
    """
    line = node.get('line')
    expr = node.get('expr', {})
    var = node.get('var', '')
    if not var:
        raise _csscerror(detail='result_capture requires a target name',
                         line=line)

    # A.3.10: capture from any RHS that yields a value — dot_call,
    # method_call (arrow form), ns_call (`cssc::uptime() seconds;`),
    # member_ns_call (`Sector::compute() r;`). Each lowers to (id, ty);
    # we wrap in a slot whose kind matches the value's CIR type.
    expr_t = expr.get('type')

    # Phase C.2: `Sec::Class(args) inst;` — sector-prefixed object
    # instantiation. The sector prefix is just a namespace indicator —
    # objects live at module scope in `_OBJECTS`. We detect the form
    # here and rewrite to the canonical `Class(args)` call shape so
    # the standard object-ctor path below handles it. The sector lookup
    # is verified so a typo (`Toolkit::Conuter()`) still errors clearly
    # rather than silently dropping the prefix.
    #
    # The parser uses TWO node shapes for `Sec::Class(args)`:
    #   * `ns_call`         — `{type:'ns_call', namespace:'Sec',
    #                          func:'Class', args:[...]}` when the LHS
    #                         is a bare identifier (most common).
    #   * `member_ns_call`  — `{type:'member_ns_call',
    #                          object:{...}, func:'Class', args:[...]}`
    #                         when the LHS is itself an expression
    #                         (chained `::` like `A::B::Class()`).
    if expr_t in ('ns_call', 'member_ns_call'):
        if expr_t == 'ns_call':
            sec_name = expr.get('namespace', '')
        else:
            receiver = expr.get('object', {}) or {}
            sec_name = (receiver.get('name', '')
                        if isinstance(receiver, dict)
                        and receiver.get('type') == 'identifier'
                        else '')
        cls_name = expr.get('func', '')
        if sec_name and cls_name in _OBJECTS:
            if sec_name not in _SECTORS:
                raise _csscerror(
                    detail=f"`{sec_name}::{cls_name}()`: "
                           f"sector {sec_name!r} not declared",
                    hint=f"known sectors: {sorted(_SECTORS.keys())}",
                    line=line,
                )
            # Rewrite to the canonical ctor shape and fall through.
            expr = {
                'type': 'call',
                'name': cls_name,
                'args': expr.get('args', []) or [],
                'line': line,
            }
            expr_t = 'call'
            # `var` and the rest of the result-capture machinery handle
            # it from here.

    if expr_t in ('dot_call', 'method_call', 'ns_call', 'member_ns_call'):
        if expr_t == 'method_call':
            val_id, val_ty = _lower_method_call_expr(b, expr)
        elif expr_t == 'dot_call':
            val_id, val_ty = _lower_dot_call_expr(b, expr)
        elif expr_t == 'ns_call':
            val_id, val_ty = _lower_ns_call_expr(b, expr)
        else:  # member_ns_call
            val_id, val_ty = _lower_member_ns_call_expr(b, expr)
        # Pick the slot kind from the value's CIR type. cssc::uptime
        # returns f64 → `float` slot; cssc::tick returns i64 → `int`;
        # label calls returning bool → `bool`; string-returning helpers
        # → `string` slot (refcount=1 from the helper, slot adopts it).
        slot_kind = {
            'i64':        'int',
            'i1':         'bool',
            'f64':        'float',
            'f32':        'float',
            'string_ptr': 'string',
            'ptr':        'string',   # raw ptr from string-returning fn
        }.get(val_ty.kind)
        if slot_kind is None:
            raise _csscerror(
                detail=f'result_capture: cannot bind {expr_t} result of '
                       f'kind {val_ty.kind!r} to a slot',
                line=line,
            )
        bits = 32 if val_ty.kind == 'f32' else 64
        slot = b.slot_alloc(slot_kind, bits)
        b.slot_store(slot, val_id, val_ty)
        b.scope_bind(var, slot, elem_kind=slot_kind)
        return

    if expr.get('type') != 'call':
        raise _csscerror(
            detail='result_capture: only call-expression captures are supported',
            hint='`Object() name;` or `f(args) r;` or `inst.label() r;` or '
                 '`cssc::uptime() t;` or `Sector::f() r;`',
            line=line,
        )
    callee = expr.get('name', '')

    # Free-function path: `f(args) r;` — capture the int return value
    # into a freshly-declared stack slot. The interpreter side derives
    # the slot's allocation size from the function's return-value cap;
    # native is i64-only for now, so a plain 64-bit slot suffices.
    if callee in _DEFINES:
        val_id, val_ty = _lower_call_expr(b, expr)
        # Container return: the callee handed back a heap container ptr
        # (its CIR return type is a bare PTR). Adopt it into a matching
        # container slot — a single-owner move: the callee's `#stack`
        # container escaped without being freed, so the caller's slot now
        # owns it (its own scope-exit / `#delete` reclaims it).
        _cret = (_DEFINES.get(callee) or {}).get('return_kind')
        if val_ty.kind == 'ptr' and _cret in _CONTAINER_PARAM_KINDS:
            slot = b.slot_alloc(_cret, 64)
            b.slot_store(slot, val_id, PTR)
            b.scope_bind(var, slot, elem_kind=_cret)
            return
        # Phase A.5: accept int / bool / float / string return kinds and
        # create a matching slot. The string path adopts the callee's
        # cssc_str* refcount=1 directly — slot_release at scope-pop
        # frees it.
        _LLVM_TO_CSSC = {'i64': ('int', INT64), 'i1': ('bool', BOOL),
                         'f64': ('float', FLOAT64),
                         'f32': ('float', FLOAT32),
                         'string_ptr': ('string', STRING_PTR)}
        binding = _LLVM_TO_CSSC.get(val_ty.kind)
        if binding is None:
            raise _csscerror(
                detail=f'result_capture: {callee}() returns kind '
                       f'{val_ty.kind!r}, which is not supported as a '
                       f'free-function return yet',
                hint='supported return kinds: int / bool / float / '
                     'string / container (vector/array/map/bind).',
                line=line,
            )
        slot_kind, slot_ty = binding
        bits = 32 if val_ty.kind == 'f32' else 64
        slot = b.slot_alloc(slot_kind, bits)
        b.slot_store(slot, val_id, slot_ty)
        b.scope_bind(var, slot, elem_kind=slot_kind)
        return

    if callee not in _OBJECTS:
        raise _csscerror(
            detail=f"result_capture: {callee!r} is not a declared object "
                   f"or #define function",
            hint=f"declare it first: `#define({callee}) {{ … }}` or "
                 f"`object {callee} {{ … }}`",
            line=line,
        )

    info = _OBJECTS[callee]
    ctor_params = info.get('ctor_params', []) or []
    ctor_args = expr.get('args', []) or []
    if len(ctor_args) != len(ctor_params):
        raise _csscerror(
            detail=f'{callee}() ctor expects {len(ctor_params)} arg(s), '
                   f'got {len(ctor_args)}',
            line=line,
        )

    # Lower each ctor argument *before* the malloc so any side-effect math
    # runs before allocation, and so we have the values ready to pass.
    arg_ssa: List[int] = []
    arg_tys: List[CIRType] = []
    for arg_node, (pname, pkind) in zip(ctor_args, ctor_params):
        if pkind == 'auto':
            v_id, t_id, _src = _lower_bind_cell(b, arg_node, line)
            arg_ssa.append(v_id)
            arg_tys.append(INT64)
            arg_ssa.append(t_id)
            arg_tys.append(INT64)
            continue
        v_id, v_ty = _lower_expr(b, arg_node, expected_kind=pkind)
        want_ty = _kind_to_cir_storage(pkind)
        if not _slot_kinds_compatible(v_ty.kind, want_ty.kind):
            raise _csscerror(
                detail=f'{callee}() ctor arg {pname!r}: kind {v_ty.kind!r} '
                       f'cannot satisfy {pkind!r}',
                line=line,
            )
        arg_ssa.append(v_id)
        arg_tys.append(want_ty)

    # Auto-fill ref captures: for every `<*src>` template param the
    # object declared, look up `src` in the current scope and pass its
    # loaded ptr as a trailing ctor arg. Module aliases (no field)
    # contribute nothing — they're lexical-only.
    for cap in info.get('ref_captures', []) or []:
        if cap['field_idx'] < 0:
            continue
        src = cap['source_var']
        if not b.scope_has(src):
            raise _csscerror(
                detail=f'{callee}(): ref-capture <*{src}> — outside slot '
                       f'{src!r} not in scope at construction site',
                hint='declare the source peripheral before this object '
                     'instantiation, e.g. `#tft[…] display;` before '
                     '`VideoDriver() vd;`',
                line=line,
            )
        cap_slot = b.scope_lookup(src)
        cap_kind = b.scope_kind(src)
        loaded = b.slot_load(cap_slot, cap_kind)
        arg_ssa.append(loaded)
        arg_tys.append(PTR)

    # Allocate the heap struct; cssc_obj_alloc zero-initialises so members
    # with no explicit init arrive as 0 / false / 0.0. The struct size
    # has to cover both declared members AND ref-capture ptr fields.
    n_fields = len(info['slots']) + sum(1 for c in info.get('ref_captures', [])
                                        if c['field_idx'] >= 0)
    size_bytes = max(n_fields, 1) * 8
    size_id = b.const_int(size_bytes)
    new_inst = b.call('cssc_obj_alloc', [size_id], [INT64],
                      return_type=PTR, external=True)

    # Run the constructor — it owns the member-init lowering.
    # The ctor signature is (ptr self, typed-args..., ref-capture-ptrs...).
    ctor_arg_tys = [PTR] + arg_tys
    b.call(info['ctor_sym'], [new_inst] + arg_ssa,
           ctor_arg_tys, return_type=VOID, external=False)

    # Stack-alloca a `ptr` handle and store the new instance pointer.
    handle = b.slot_alloc('object_handle', 64)
    b.slot_store(handle, new_inst, PTR)
    b.scope_bind(var, handle, elem_kind='object_handle')
    _INSTANCES[var] = callee


def _kind_to_cir_storage(kind: str) -> CIRType:
    """A.3.3: full kind→CIR-storage-type table for member assigns.

    Centralised so arrow_assign / dot_assign / index_assign / sector
    member assigns all use the same mapping. Returns the CIR type used
    in the `slot_store` call — for heap kinds it's `PTR` (the slot
    holds a pointer to the heap value).
    """
    if kind == 'int':    return INT64
    if kind == 'bool':   return BOOL
    if kind == 'float':  return FLOAT64
    if kind == 'string': return PTR
    if kind in ('vector_int', 'vector_float',
                'vector_bool',                 # Phase A.1
                'vector_string',               # Phase A.2
                'array_int', 'array_float',
                'array_bool',                  # Phase A.3
                'array_string',
                'map_si', 'map_ss', 'map_is', 'map_ii',
                'map_sf', 'map_if',
                'bind_ss', 'bind_entry', 'array_bind',
                'object_handle',
                'pin', 'i2c', 'spi', 'uart',
                'adc', 'pwm', 'timer',
                'tft', 'oled', 'video', 'matrix',
                'framebuffer', 'console'):
        return PTR
    raise _csscerror(
        detail=f'_kind_to_cir_storage: kind {kind!r} not recognised',
        hint='add an entry to _kind_to_cir_storage in cir_lower.py',
    )


def _is_heap_kind(kind: str) -> bool:
    """True if the kind is heap-allocated (i.e., the slot holds a ptr).

    A.3.3+A.3.5: heap kinds require release-old + retain-new on overwrite
    (refcount cascade for strings) and slot_release on deletion.
    """
    return kind not in ('int', 'bool', 'float')


def _slot_kinds_compatible(value_kind: str, slot_storage_kind: str) -> bool:
    """A.3.3: shared kind-equivalence rule used by every slot-store site
    (`#stack`/`#heap`/`#auto` slot init, object arrow-assign, sector
    `Sec::m = v`, `inst.label(arg)`, `call label<arg>`, indexed assigns,
    container `.push_back(v)`).

    The value's CIR kind (`val_ty.kind`) and the slot's storage CIR kind
    (`_kind_to_cir_storage(slot_kind).kind`) usually match exactly. The
    one structural exception is `string`: its storage type is plain `PTR`
    (the slot holds a `cssc_str*`), but a slot-LOAD or string-producing
    helper hands back the marker variant `STRING_PTR` so that `cssc_outln`
    and similar dispatch on string-vs-raw-ptr. The two are the same LLVM
    type — accepting one for the other is correct and required for the
    obvious `slot_kind == 'string'` assignment to type-check.

    Anything else is a real mismatch (e.g. storing an `i64` into a `ptr`
    slot would be a use-after-bug-cascade waiting to happen).
    """
    if value_kind == slot_storage_kind:
        return True
    return {value_kind, slot_storage_kind} == {'ptr', 'string_ptr'}


def _lower_arrow_assign(b: CIRBuilder, node: dict) -> None:
    """Lower `Object->member = value;` as a statement.

    Same resolution order as arrow_access: prefer the scope binding
    (per-instance MemberAddr from `_bind_object_members`), fall back to
    a sector module global. A.3.3: handles heap kinds (string, vector,
    map, bind, peripherals) via the unified `_kind_to_cir_storage`
    helper — the previous dict lookup blew up with KeyError for any
    non-POD member.
    """
    line = node.get('line')
    obj_node = node.get('object', {})
    if obj_node.get('type') != 'identifier':
        raise _csscerror(
            detail='Phase 4d: arrow assignment requires a simple object identifier',
            line=line,
        )
    obj_name = obj_node.get('name', '')
    key = node.get('key', '')
    qualified = f'{obj_name}->{key}'

    def _store_member(slot_addr: int, kind: str) -> None:
        val_id, val_ty = _lower_expr(b, node['value'], expected_kind=kind)
        val_cir = _kind_to_cir_storage(kind)
        if not _slot_kinds_compatible(val_ty.kind, val_cir.kind):
            raise _csscerror(
                detail=f'{qualified}: value of kind {val_ty.kind!r} cannot '
                       f'be stored in {kind!r} slot',
                line=line,
            )
        # A.3.5: heap kinds release-old + retain-new (already-handled by
        # _store_to_slot for `string` slots; do the equivalent inline
        # here for member slots — they don't go through _store_to_slot).
        if _is_heap_kind(kind) and kind == 'string':
            # Decrement the previous value's refcount before overwriting.
            b.slot_release(slot_addr, 'string')
        b.slot_store(slot_addr, val_id, val_cir)
        # If the value came from another slot adoption (identifier-load),
        # bump the new value's refcount so the old owner doesn't free it
        # when its own scope ends. Covers borrows from another slot
        # (`identifier`), a string member (`Obj->m`), or a vector<string>
        # element (`Vec[i]`) — the `Sec->_m = Other->_v[i]` sibling of the
        # item_name use-after-free. Transients (concat / call returns) are
        # already refcount=1 and must not be retained.
        if kind == 'string' and _rhs_is_string_alias(node.get('value', {})):
            b.slot_retain(slot_addr, 'string')

    if b.scope_has(qualified):
        slot = b.scope_lookup(qualified)
        kind = b.scope_kind(qualified)
        _store_member(slot, kind)
        return

    # Per-instance object members reached via `inst->field = ...` from
    # outside the label body: load the instance ptr, GEP to the field,
    # store. Mirrors the read-side dispatch in arrow_access.
    if obj_name in _INSTANCES:
        obj_type = _INSTANCES[obj_name]
        obj_info = _OBJECTS.get(obj_type, {})
        slots = obj_info.get('slots', {})
        if key in slots:
            if not b.scope_has(obj_name):
                raise _csscerror(
                    detail=f'instance handle {obj_name!r} is out of scope',
                    line=line,
                )
            handle = b.scope_lookup(obj_name)
            inst_ptr = b.slot_load(handle, 'object_handle')
            meta = slots[key]
            field_addr = b.member_addr(inst_ptr,
                                       obj_info['struct_ty'],
                                       meta['field_idx'])
            _store_member(field_addr, meta['kind'])
            return

    meta = _resolve_member_global(obj_name, key, line)
    if 'sym' not in meta:
        raise _csscerror(
            detail=f'{qualified} is a per-instance object member; '
                   f'assign from inside a label/free body',
            line=line,
        )
    addr = b.global_addr(meta['sym'])
    _store_member(addr, meta['kind'])


def _lower_dot_assign(b: CIRBuilder, node: dict) -> None:
    """A.3.9: `inst.field = value;` — adapt to arrow_assign.

    In v6 native, every object lives on the heap so dot- and arrow-
    assignment carry identical semantics. The parser already emits
    `(object, key, value)` in the same shape, so a node-type swap is
    enough.
    """
    adapted = dict(node)
    adapted['type'] = 'arrow_assign'
    _lower_arrow_assign(b, adapted)


def _lower_ns_assign(b: CIRBuilder, node: dict) -> None:
    """A.3.9: `Sector::member = value;` — write a sector module global.

    The sector's member must be declared as a slot in the sector body;
    `_resolve_member_global` returns its symbol name. Heap kinds use the
    refcount cascade (release-old + retain-on-adopt) for consistency
    with arrow_assign.
    """
    line = node.get('line')
    # AST format (current parser):
    #   {type: 'ns_assign',
    #    target: {type: 'ns_access', namespace: 'Sec', member: 'M'},
    #    value: <expr>}
    # Older parser forms used direct 'object'/'namespace'+'member' fields;
    # accept either shape so this lowerer doesn't regress.
    target = node.get('target')
    if isinstance(target, dict):
        sector = target.get('namespace', '') or ''
        member = target.get('member', '') or target.get('key', '') or ''
    else:
        receiver = node.get('object') or node.get('namespace')
        member = node.get('member') or node.get('key', '')
        if isinstance(receiver, dict):
            if receiver.get('type') != 'identifier':
                raise _csscerror(
                    detail='ns-assign requires a sector identifier on the LHS',
                    line=line,
                )
            sector = receiver.get('name', '')
        else:
            sector = receiver or ''
    if not sector or sector not in _SECTORS:
        raise _csscerror(
            detail=f'ns-assign: sector {sector!r} not in scope',
            hint=f'known sectors: {sorted(_SECTORS.keys())}',
            line=line,
        )
    meta = _SECTORS[sector].get('slots', {}).get(member)
    if not meta or 'sym' not in meta:
        raise _csscerror(
            detail=f'{sector}::{member} is not a writable sector member',
            line=line,
        )
    addr = b.global_addr(meta['sym'])
    kind = meta['kind']
    val_id, val_ty = _lower_expr(b, node['value'], expected_kind=kind)
    val_cir = _kind_to_cir_storage(kind)
    if not _slot_kinds_compatible(val_ty.kind, val_cir.kind):
        raise _csscerror(
            detail=f'{sector}::{member}: kind {val_ty.kind!r} cannot be '
                   f'stored in {kind!r} slot',
            line=line,
        )
    if kind == 'string':
        b.slot_release(addr, 'string')
    b.slot_store(addr, val_id, val_cir)
    # Retain when the RHS borrows a live owner (slot / member / element);
    # transients are already refcount=1. Same rule as _rhs_is_string_alias.
    if kind == 'string' and _rhs_is_string_alias(node.get('value', {})):
        b.slot_retain(addr, 'string')


def _lower_deref_assign(b: CIRBuilder, node: dict) -> None:
    """A.3.9: `*ptr = value;` — store through a raw pointer.

    Used for low-level pointer manipulation (mostly inside `#cdefine`
    bodies). The target must be an expression yielding a ptr SSA id;
    the value's CIR type drives the storage shape.
    """
    line = node.get('line')
    target_node = node.get('target') or node.get('operand') or node.get('object')
    if target_node is None:
        raise _csscerror(detail='deref-assign: missing target', line=line)
    ptr_id, ptr_ty = _lower_expr(b, target_node)
    if ptr_ty.kind != 'ptr' and ptr_ty.kind != 'string_ptr':
        raise _csscerror(
            detail=f'deref-assign: target is not a pointer (got {ptr_ty.kind})',
            hint='use `*&x = ...` only on a raw ptr from a low-level helper',
            line=line,
        )
    val_id, val_ty = _lower_expr(b, node['value'])
    b.slot_store(ptr_id, val_id, val_ty)


def _resolve_member_global(name: str, key: str, line: Optional[int]) -> dict:
    """Resolve `<Name>->member` to the member metadata dict from either
    a sector or an object. Raises if the symbol is unknown."""
    if name in _SECTORS:
        slots = _SECTORS[name].get('slots', {})
        if key in slots:
            return slots[key]
    if name in _OBJECTS:
        slots = _OBJECTS[name].get('slots', {})
        if key in slots:
            return slots[key]
    raise _csscerror(
        detail=f'no member {key!r} on {name!r}',
        hint=f'declared: sectors {sorted(_SECTORS.keys())}; '
             f'objects {sorted(_OBJECTS.keys())}',
        line=line,
    )


def _lower_outln(b: CIRBuilder, args: List[dict], line: Optional[int],
                 newline: bool = True) -> int:
    """Lower `cssc::outln(...)` (with newline) or `cssc::out(...)` (no
    newline). Both accept any number of value-producing args; each is
    printed using the kind-appropriate runtime print symbol.
    """
    if not args:
        if newline:
            # A.3.17: `cssc::outln()` with no args prints exactly one
            # newline. The previous implementation passed `0` to
            # `cssc_print_int`, which produced "0\n" instead of "\n".
            b.call('cssc_print_newline', [], [],
                   return_type=VOID, external=True)
        return -1
    for arg in args:
        # Container identifier / expr → stringify to `{e0, e1, …}` first.
        # A bare container ptr handed straight to `cssc_outln` would be
        # printed as a raw string of length 0 (blank); route it through
        # the same `_emit_container_to_str` the `"…" + vec` concat uses.
        ck = _recover_container_kind(b, arg)
        if ck is not None:
            ptr_id, _pty = _lower_expr(b, arg, expected_kind=ck)
            str_id, str_ty = _emit_container_to_str(b, ptr_id, ck, line)
            if newline:
                b.cssc_outln(str_id, str_ty)
            else:
                b.cssc_out(str_id, str_ty)
            continue
        val_id, val_type = _lower_expr(b, arg, expected_kind=None)
        if newline:
            b.cssc_outln(val_id, val_type)
        else:
            b.cssc_out(val_id, val_type)
    return -1


def _lower_call(b: CIRBuilder, node: dict) -> int:
    """Lower a free-function call statement `f(arg0, arg1, …)`.

    Only resolves names registered by a prior top-level `#define(name) { … }`.
    Args are lowered as ints (v6 native parameter surface is int-only for
    now); the call is padded with `i64 0` for any positional slot the
    body's `#scanp` references but the caller didn't supply.

    ABI: every `#define`d function takes a leading `i64 n_args` followed
    by `arity` `i64` positional slots. The body's `#scanp` uses `n_args`
    to distinguish "actually passed 0" from "missing" (the latter
    triggers the silent-null / default-expression branch — see
    [_lower_scanp]).
    """
    name = node.get('name', '')
    args = node.get('args', []) or []
    line = node.get('line')
    info = _DEFINES.get(name)
    if info is None:
        # `#req[realFn] local;` inside this function body might have
        # registered `local → realFn`. Check the per-function alias
        # stack BEFORE raising the disambiguation error. The alias
        # is resolved into the canonical `_DEFINES` entry so all
        # downstream lowering (arg meta, RefArg emit, etc.) sees
        # the real function's signature.
        aliased = _callable_alias_resolve(name)
        if aliased is not None and aliased in _DEFINES:
            name = aliased
            info = _DEFINES[name]
    if info is None:
        # Hint disambiguation: did the user actually mean to instantiate
        # a declared `object`? `Trash();` is a common syntax slip — the
        # intent is `Trash() <name>;` (i.e. construct an instance and
        # bind it to a local). We detect that case here so the error
        # routes them to the right syntax instead of the generic "free
        # function not defined" mystery.
        if name in _OBJECTS:
            raise _csscerror(
                detail=(
                    f"`{name}()` is missing the instance name — `{name}` "
                    f"is declared as an `object`, not a free function."),
                hint=(
                    f"To instantiate the object, give it a local name: "
                    f"`{name}() my_{name.lower()};` — then call methods "
                    f"on `my_{name.lower()}.label()`. To clean up the "
                    f"instance later, write `#delete[my_{name.lower()}];` "
                    f"(runs the object's `free {{ … }}` block + releases "
                    f"the heap)."),
                line=line,
            )
        if name in _SECTORS:
            raise _csscerror(
                detail=(
                    f"`{name}()` is not callable — `{name}` is declared "
                    f"as a `sector`."),
                hint=(
                    f"Sectors are namespaces, not constructors. Call "
                    f"one of their members: `{name}::function_name();`."),
                line=line,
            )
        raise _csscerror(
            detail=f"free function {name!r} not defined",
            hint=f"declare it first: `#define({name}) {{ … }}`. "
                 f"Built-ins like cssc::outln go through cssc::*. "
                 f"#cdefine requires `#include('def');`.",
            line=line,
        )
    arity = info['arity']
    arg_kinds = info.get('arg_kinds') or []
    arg_param_names = info.get('arg_param_names') or []
    # Capture the *actual* caller arg count before truncation/padding —
    # this is what #scanp uses for OOB detection at runtime.
    n_args_actual = len(args)
    arg_ids: List[int] = []
    # v6 ref-by-default ABI (Spec §2.5; plan §P2):
    #
    #   Per-arg, decide REF (caller passes slot ADDRESS, callee writes
    #   through to caller's storage) vs COPY (caller passes VALUE,
    #   callee allocates a local). The decision is encoded as one bit
    #   per positional arg, packed into the HIGH 32 bits of __nargs:
    #
    #       __nargs_payload = (count_low32) | (refcopy_bits_high32 << 32)
    #       bit i = 1  →  arg i is REF (i64 carries a slot ptr)
    #       bit i = 0  →  arg i is COPY/literal (i64 carries a value)
    #
    #   The callee's prologue (in `_lower_define`) extracts the bit per
    #   scanp position and branches the param binding accordingly. The
    #   call-site decision is a SOURCE-LEVEL property — a bare identifier
    #   bound to an in-scope slot = REF; `&x` (copy_of), literals,
    #   expression results, or out-of-scope idents = COPY.
    refcopy_bits = 0
    for i, a in enumerate(args):
        is_ref = False
        if isinstance(a, dict) and a.get('type') == 'identifier':
            caller_slot = (a.get('name') or '').strip()
            if caller_slot and b.scope_has(caller_slot):
                is_ref = True
        if is_ref and i < 32:
            refcopy_bits |= (1 << i)
        # Lower the arg value. For REF we pass the SLOT ADDRESS (cast
        # to i64 via ptrtoint); for COPY we pass the value as today.
        if is_ref:
            caller_slot = a.get('name', '').strip()
            slot_ptr = b.scope_lookup(caller_slot)
            slot_addr_i64 = b.ptr_to_int(slot_ptr)
            arg_ids.append(slot_addr_i64)
            # Also enqueue an alias-table entry for heap-typed ref
            # propagation (the bit-pack only handles same-frame zero
            # via store; the alias-table backs through-chain deletes
            # and string/vector ref-params where the body needs a
            # cssc_release before zeroing).
            if i < len(arg_param_names) and arg_param_names[i]:
                _emit_arg_link(b, arg_param_names[i], slot_ptr)
        else:
            expected_kind = (arg_kinds[i] if i < len(arg_kinds) else 'int')
            v_id, v_ty = _lower_arg_for_call(b, a, expected_kind, name, line)
            arg_ids.append(v_id)
    # Truncate extras the body can't observe. The truncated args are
    # still counted in n_args so `#scanp_opt` (if/when it lands) can
    # introspect the real arity if it wants to.
    arg_ids = arg_ids[:arity]
    while len(arg_ids) < arity:
        arg_ids.append(b.const_int(0))
    # Pack count + refcopy bits into the i64 __nargs payload.
    payload = (n_args_actual & 0xFFFFFFFF) | ((refcopy_bits & 0xFFFFFFFF) << 32)
    n_args_id = b.const_int(payload)
    ret_ty = info.get('return_ty', VOID)
    b.call(info['sym'], [n_args_id] + arg_ids,
           [INT64] + [INT64] * arity,
           return_type=ret_ty, external=False)
    return -1


def _emit_arg_link(b: 'CIRBuilder', param_name: str,
                     caller_slot_addr: int) -> None:
    """Emit `cssc_arg_link(param_name, caller_slot_addr)` so the runtime
    records (param → caller_slot_address) for the upcoming call. When
    the callee runs `#delete[param]`, the runtime's
    `cssc_scope_delete_aliased(param)` looks up the address and zeroes
    8 bytes there, invalidating the caller's slot per Spec §2.5.

    CRITICAL: `param_name` is materialised via `const_str` (NOT
    `string_from_lit`). The runtime's alias-table lookup compares
    name pointers via `icmp eq ptr` (zero per-call cost; matches
    CSSC's no-GC philosophy). `const_str` produces a global
    `@.str.N` constant — LLVM/clang+linker dedupe identical
    constants across the module, so two emission sites with the
    same literal land at the SAME pointer. `string_from_lit` calls
    `cssc_string_lit(ptr, len)` which `malloc`s a fresh `cssc_str*`
    each call — two distinct pointers → alias lookup silently
    fails → cross-frame delete never fires. Past bug: see plan
    §P1.1.

    Args:
      param_name        — the callee's `#scanp` slot name. Compile-
                          time literal; emitted as a linker-deduped
                          global constant.
      caller_slot_addr  — the SSA id of the caller's slot pointer
                          (from `scope_lookup`). Passed as ptr.
    """
    p_id = b.const_str(param_name)
    b.call('cssc_arg_link', [p_id, caller_slot_addr], [PTR, PTR],
           return_type=VOID, external=True)


def _lower_arg_for_call(b: 'CIRBuilder', arg: dict, expected_kind: str,
                          callee: str, line) -> Tuple[int, 'CIRType']:
    """Lower a single call argument to an i64 SSA id matching the
    function's ABI slot. Handles both int and string args; for string
    args the value is materialised as a heap `cssc_str*` (via
    `cssc_string_lit` for literals or directly via the slot's stored
    ptr for identifiers) and passed by the pointer's i64 bit-pattern
    through the same ABI slot.

    Per spec §2.5 "Untyped Temps in Argument-Positionen — Auto-Cleanup-
    Regel": transient string literals live in the caller's `scope_push`
    frame and are bulk-freed at the caller's `scope_pop`. The callee
    inherits a borrowed pointer; no retain/release dance needed for
    the call itself.
    """
    if expected_kind in _CONTAINER_PARAM_KINDS:
        # Container argument passed by COPY — a literal (`setCH({1,2,3})`)
        # or an expression that yields a container pointer. Bare in-scope
        # identifiers never reach here: `_lower_call` routes them through
        # the REF path (slot address + arg-link), so this branch only
        # handles values that must be materialised on the spot.
        #
        # A literal is built into an anonymous transient slot — freed at
        # the caller's `scope_pop` per §2.5 — via the same per-kind
        # constructor the slot-declaration path uses (`_init_container_slot`).
        # The heap pointer's i64 bit-pattern then travels the ABI slot,
        # exactly like a string `cssc_str*`.
        a_t = arg.get('type') if isinstance(arg, dict) else None
        if a_t in ('array', 'array_literal', 'map_literal', 'bind_literal'):
            n_items = len(arg.get('items') or arg.get('elements')
                          or arg.get('pairs') or [])
            cap_bytes = max(n_items * 16, 256)
            tmp_slot = b.slot_alloc(expected_kind, cap_bytes)
            # `_init_container_slot` dispatches by kind and validates the
            # literal's node shape per-kind, raising a precise error on a
            # mismatch (e.g. a map literal handed to a vector param).
            _init_container_slot(b, tmp_slot, expected_kind, arg,
                                 cap_bytes, line)
            ptr = b.slot_load(tmp_slot, expected_kind)
            return b.ptr_to_int(ptr), INT64
        v_id, v_ty = _lower_expr(b, arg, expected_kind=expected_kind)
        if v_ty.kind in ('ptr', 'string_ptr', 'cssc_str_ptr'):
            return b.ptr_to_int(v_id), INT64
        if v_ty.kind == 'i64':
            return v_id, INT64
        raise _csscerror(
            detail=f"{callee}(): {expected_kind} param expected (kind "
                   f"{v_ty.kind!r} doesn't fit the ABI ptr slot)",
            hint='pass a container literal, a matching container slot, '
                 'or a function returning that container kind',
            line=line,
        )
    if expected_kind == 'string':
        if arg.get('type') == 'string':
            ptr_id = b.string_from_lit(arg.get('value', ''))
            return b.ptr_to_int(ptr_id), INT64
        v_id, v_ty = _lower_expr(b, arg, expected_kind='string')
        if v_ty.kind in ('ptr', 'string_ptr', 'cssc_str_ptr'):
            return b.ptr_to_int(v_id), INT64
        if v_ty.kind == 'i64':
            return v_id, INT64
        raise _csscerror(
            detail=f"{callee}(): string param expected (kind "
                   f"{v_ty.kind!r} doesn't fit the ABI ptr slot)",
            hint='pass a string literal, a `#stack[string, N]` '
                 'slot, or a function returning string',
            line=line,
        )
    if expected_kind == 'float':
        v_id, v_ty = _lower_expr(b, arg, expected_kind='float')
        if v_ty.kind == 'f64':
            payload = b.bitcast_float_to_int(v_id)
            return payload, INT64
        if v_ty.kind == 'f32':
            ext_id = b.call('__extendsfdf2', [v_id], [FLOAT32],
                            return_type=FLOAT64, external=True)
            payload = b.bitcast_float_to_int(ext_id)
            return payload, INT64
        if v_ty.kind == 'i64':
            f64_id = b.sitofp_to_double(v_id)
            payload = b.bitcast_float_to_int(f64_id)
            return payload, INT64
        if v_ty.kind == 'i1':
            zx = b.zext_bool_to_int(v_id)
            f64_id = b.sitofp_to_double(zx)
            payload = b.bitcast_float_to_int(f64_id)
            return payload, INT64
        raise _csscerror(
            detail=f"{callee}(): float param expected (got kind "
                   f"{v_ty.kind!r})",
            line=line,
        )
    if expected_kind == 'bool':
        v_id, v_ty = _lower_expr(b, arg, expected_kind='bool')
        if v_ty.kind == 'i1':
            payload = b.zext_bool_to_int(v_id)
            return payload, INT64
        if v_ty.kind == 'i64':
            return v_id, INT64
        raise _csscerror(
            detail=f"{callee}(): bool param expected (got kind "
                   f"{v_ty.kind!r})",
            line=line,
        )
    # Int (default) path — with best-effort NUMERIC coercion for i1 /
    # ptr / f32 / f64 so any single-value type fits the i64 ABI slot.
    # CRITICAL: for float→int the coercion MUST be `fptosi` (truncate to
    # the numeric integer value 3.14 → 3), NOT `bitcast_float_to_int`
    # (which would hand the IEEE-754 bit pattern 4614253070214989087 to
    # the callee — silent-garbage bug). `_dispatch_ns_call_runtime`
    # already uses fptosi for the same coercion at line ~4130; this path
    # was inconsistent for user-defined #define calls.
    v_id, v_ty = _lower_expr(b, arg, expected_kind='int')
    if v_ty.kind == 'i1':
        return b.zext_bool_to_int(v_id), INT64
    if v_ty.kind in ('ptr', 'string_ptr', 'cssc_str_ptr'):
        return b.ptr_to_int(v_id), INT64
    if v_ty.kind == 'f64':
        return b.fptosi_to_int(v_id), INT64
    if v_ty.kind == 'f32':
        ext_id = b.call('__extendsfdf2', [v_id], [FLOAT32],
                        return_type=FLOAT64, external=True)
        return b.fptosi_to_int(ext_id), INT64
    if v_ty.kind != 'i64':
        raise _csscerror(
            detail=f"{callee}(): int param expected (got kind "
                   f"{v_ty.kind!r})",
            hint='declare the param as string in `#scanp(…, string, '
                 'pos) name;` to accept a heap-string argument',
            line=line,
        )
    return v_id, INT64


def _lower_call_expr(b: CIRBuilder, node: dict) -> Tuple[int, CIRType]:
    """Lower a free-function call as an expression. Returns (id, type).

    Same ABI as `_lower_call` (statement form). For void-returning
    callees we synthesise a fresh `i64 0` so call-as-expression always
    produces a usable value, matching the interpreter's "no-return
    function yields null/0" semantics.
    """
    name = node.get('name', '')
    args = node.get('args', []) or []
    line = node.get('line')
    info = _DEFINES.get(name)
    if info is None:
        if name in _OBJECTS:
            raise _csscerror(
                detail=(
                    f"`{name}()` used in an expression but `{name}` is "
                    f"an `object`, not a function — and ctor-result "
                    f"capture isn't a value expression."),
                hint=(
                    f"Instantiate with a name first: `{name}() inst;` "
                    f"as a separate statement, then refer to `inst` "
                    f"from the expression."),
                line=line,
            )
        if name in _SECTORS:
            raise _csscerror(
                detail=(
                    f"`{name}()` is not callable — `{name}` is a "
                    f"`sector` namespace, not a function."),
                hint=f"call one of its members: `{name}::function_name()`",
                line=line,
            )
        raise _csscerror(
            detail=f"free function {name!r} not defined",
            hint=f"declare it first: `#define({name}) {{ … }}`",
            line=line,
        )
    arity = info['arity']
    arg_kinds = info.get('arg_kinds') or []
    ret_ty = info.get('return_ty', VOID)
    n_args_actual = len(args)
    arg_ids: List[int] = []
    for i, a in enumerate(args):
        expected_kind = (arg_kinds[i] if i < len(arg_kinds) else 'int')
        v_id, _v_ty = _lower_arg_for_call(b, a, expected_kind, name, line)
        arg_ids.append(v_id)
    arg_ids = arg_ids[:arity]
    while len(arg_ids) < arity:
        arg_ids.append(b.const_int(0))
    n_args_id = b.const_int(n_args_actual)
    call_id = b.call(info['sym'], [n_args_id] + arg_ids,
                     [INT64] + [INT64] * arity,
                     return_type=ret_ty, external=False)
    if ret_ty.is_void():
        return b.const_int(0), INT64
    return call_id, ret_ty


def _prescan_define_returns(body: List[dict]) -> str:
    """Walk a `#define` body collecting every value-shape that exits
    via `return …;` OR `mirror …;`.

    Returns one of:
      * `'void'`  — body has no value-producing exit.
      * `'int'`   — at least one return/mirror sees an int-shaped expr.
      * `'bool'`  — first value-returning exit carries a bool literal
                    or `==`/`<`/`>` comparison shape.
      * `'float'` — first value-returning exit carries a float literal
                    or arithmetic involving a float operand.

    Phase A.5: extends the original int-only inference by peeking at
    the value expression's STRUCTURAL shape. Literal types resolve
    unambiguously; binary expressions look at their `op` (`+`/`-`/
    `*`/`/`/`%` keeps the dominant operand kind; `==`/`!=`/`<`/`<=`/
    `>`/`>=`/`&&`/`||` → bool). Identifiers / nested calls fall back
    to `int` — covering them needs a real type inference pass that
    threads through `_lower_expr`, which is deferred.

    Mixed value/no-value returns raise an error. Mixed VALUE kinds
    (e.g. `mirror 5;` and `mirror 3.14;` in the same function) also
    raise so the function's return type is unambiguous.

    A.3.11: backed by the universal walker so a `return` / `mirror`
    nested inside `if (cond) { … }` (where `cond` historically wasn't
    descended) is still observed.
    """
    saw_void_return = False
    saw_value_return = False
    inferred_kind: Optional[str] = None

    # Phase A.5: pre-walk the body to harvest each `#stack[T, N] name;`
    # / `#heap[T, N] name;` declaration. The map lets `_kind_of_value`
    # resolve a bare identifier (`mirror greeting;`) to the slot's
    # declared kind without threading a full type checker through the
    # prescan. Only `string` / `bool` / `float` are tracked for return-
    # type inference; everything else falls back to `int` (the existing
    # default) so the downstream kind-check still surfaces a clear
    # error if the user returns an unsupported kind.
    slot_kinds: Dict[str, str] = {}

    def _collect_slot_kinds(stmts):
        for s in stmts or []:
            if not isinstance(s, dict):
                continue
            t = s.get('type')
            if t == 'directive' and s.get('directive') in ('stack', 'heap', 'auto'):
                nm = (s.get('var') or '').strip()
                arg = s.get('arg') or ''
                if nm and arg:
                    try:
                        slot_t, _bits = _parse_slot_arg(arg)
                    except Exception:
                        slot_t = ''
                    slot_t = _normalise_slot_type((slot_t or '').strip())
                    if (slot_t in ('string', 'bool', 'float')
                            or slot_t in _CONTAINER_PARAM_KINDS):
                        slot_kinds[nm] = slot_t
            elif t == 'result_capture':
                # `expr v;` receiver-binding — record v's kind from the
                # bound expression so a later `mirror &v` / `mirror v`
                # types the function return correctly (the i18n
                # `ini::read(...) v; mirror &v;` case). ns-calls resolve
                # through the shared return-kind registry; user calls
                # through _DEFINES; string literals are string.
                nm = (s.get('var') or '').strip()
                expr = s.get('expr') or {}
                ek = None
                if isinstance(expr, dict):
                    et = expr.get('type')
                    if et == 'ns_call':
                        ek = _ns_call_return_kind(expr.get('namespace') or '',
                                                  expr.get('func') or '')
                    elif et == 'call':
                        info = _DEFINES.get((expr.get('name') or '').strip())
                        if info:
                            ek = _DISPATCH_KIND_TO_CSSC.get(
                                info.get('return_kind'), info.get('return_kind'))
                    elif et == 'string':
                        ek = 'string'
                if nm and (ek in ('string', 'bool', 'float')
                           or ek in _CONTAINER_PARAM_KINDS):
                    slot_kinds[nm] = ek
            # Recurse into block bodies / control structures so a
            # `#stack[string, N]` declared inside `if { ... }` is also
            # picked up.
            for key in ('body', 'then', 'else_', 'else', 'children',
                         'consequent', 'alternate'):
                child = s.get(key)
                if isinstance(child, list):
                    _collect_slot_kinds(child)
                elif isinstance(child, dict):
                    _collect_slot_kinds([child])
    _collect_slot_kinds(body)

    def _kind_of_value(v: Optional[dict]) -> str:
        if v is None or not isinstance(v, dict):
            return 'int'
        t = v.get('type')
        # Identifier referring to a declared slot — look it up.
        if t in ('identifier', 'name', 'var_ref'):
            nm = (v.get('name') or '').strip()
            return slot_kinds.get(nm, 'int')
        # The CSSC parser emits unified `literal` nodes for numeric AND
        # bool primitives; only the Python `value`'s type disambiguates.
        # bool MUST be checked BEFORE int (Python's `bool` is a subclass
        # of `int`; `isinstance(True, int)` returns True).
        if t == 'literal':
            val = v.get('value')
            if isinstance(val, bool):
                return 'bool'
            if isinstance(val, float):
                return 'float'
            if isinstance(val, int):
                return 'int'
            if isinstance(val, str):
                return 'string'
            return 'int'
        if t == 'bool':
            return 'bool'
        if t == 'float':
            return 'float'
        if t == 'integer' or t == 'int':
            return 'int'
        if t == 'string':
            return 'string'
        if t == 'unary' and v.get('op') == '!':
            return 'bool'
        if t == 'cmp':
            return 'bool'
        if t == 'binary':
            op = v.get('op', '')
            if op in ('==', '!=', '<', '<=', '>', '>=', '&&', '||'):
                return 'bool'
            # arithmetic: float wins if either operand is float-shaped;
            # `+` with any string operand is concat (cssc_string_concat
            # produces a fresh cssc_str*) so the result is `string`.
            left = _kind_of_value(v.get('left'))
            right = _kind_of_value(v.get('right'))
            if op == '+' and 'string' in (left, right):
                return 'string'
            if 'float' in (left, right):
                return 'float'
            if 'bool' in (left, right) and op in ('&&', '||'):
                return 'bool'
            return 'int'
        # `ns_call` — resolve the return kind through the shared registry
        # (`cssc::` builtins + `_NS_CALL_RUNTIME`) using the ACTUAL parser
        # node keys `namespace`/`func`. The previous code read non-existent
        # `path`/`name` keys, so the branch was dead and EVERY ns-call fell
        # through to the i64 default below — mis-typing string returns like
        # `ini::read(...)` and producing the cryptic 'string_ptr cannot
        # satisfy declared return kind i64'.
        if t == 'ns_call':
            k = _ns_call_return_kind(v.get('namespace') or '',
                                     v.get('func') or '')
            if k is not None:
                return k
        # Identifier / chained expr — can't infer cheaply here.
        # Default to int; if the user actually returns a non-int kind
        # the downstream kind-check raises a clear error so they know
        # to switch to explicit bool/float/string literals (or break
        # the expression into intermediate slots whose kinds the
        # ref-by-default scope already knows).
        return 'int'

    def _unify(new: str) -> None:
        nonlocal inferred_kind
        if inferred_kind is None:
            inferred_kind = new
            return
        if inferred_kind != new:
            # Heterogeneous returns — surface a hard error.
            raise _csscerror(
                detail=f'#define body has mixed return kinds '
                       f'({inferred_kind} and {new})',
                hint='all return/mirror exits in one function must '
                     'agree on kind (int / bool / float). String + '
                     'container returns land in a later phase.',
            )

    def visit(n: dict):
        nonlocal saw_void_return, saw_value_return
        t = n.get('type')
        if t == 'return':
            if n.get('value') is None:
                saw_void_return = True
            else:
                saw_value_return = True
                _unify(_kind_of_value(n.get('value')))
            return False
        if t == 'mirror':
            saw_value_return = True
            _unify(_kind_of_value(n.get('value')))
            return False
        return None

    _walk_ast(body, visit)
    if saw_value_return and saw_void_return:
        raise _csscerror(
            detail='#define body mixes value-returning '
                   '(`return <expr>;` / `mirror <expr>;`) and bare '
                   '`return;`',
            hint='make all returns value-bearing, or all void',
        )
    if not saw_value_return:
        return 'void'
    return inferred_kind or 'int'


def _prescan_define_args(body: List[dict], self_name: str
                           ) -> Tuple[int, List[str], List[str]]:
    """Walk a `#define` body and collect every `#scanp(<self_name>, type, pos)`
    reference. Returns `(arity, [kind_per_pos], [name_per_pos])`.

    Positions not referenced are filled with kind `'int'` and an empty
    name so the LLVM signature still type-checks; the body cannot
    observe them.

    The `name_per_pos` list — populated from each `#scanp(…) varname;`
    — feeds the v6 ref-by-default alias mechanism: when the call site
    passes a bare identifier, `_lower_arg_for_call` emits
    `cssc_arg_link(stack, name_per_pos[i], caller_slot_name)` so the
    callee's `#delete[varname]` can cascade into the caller's slot
    (spec §2.5).

    A.3.11: uses the universal walker so a `#scanp` nested inside a
    `while (#scanp(f, int, 0) > 0)` condition is found correctly.
    """
    max_pos = -1
    kinds_by_pos: Dict[int, str] = {}
    names_by_pos: Dict[int, str] = {}

    def visit(n: dict):
        nonlocal max_pos
        if n.get('type') == 'scanp' and n.get('source', '') == self_name:
            try:
                pos = int(n.get('pos', 0))
            except (TypeError, ValueError):
                raise _csscerror(
                    detail=f'#scanp: positional index must be an integer '
                           f'(got {n.get("pos")!r})',
                    line=n.get('line'),
                )
            if pos < 0:
                raise _csscerror(
                    detail=f'#scanp: positional index must be >= 0 '
                           f'(got {pos})',
                    line=n.get('line'),
                )
            vtype = (n.get('vtype') or 'int')
            if vtype.startswith('*'):
                vtype = vtype[1:]
            kind = _normalise_slot_type(vtype.strip())
            prior = kinds_by_pos.get(pos)
            if prior is not None and prior != kind:
                raise _csscerror(
                    detail=f'#scanp({self_name}, …, {pos}): '
                           f'conflicting types {prior!r} vs {kind!r}',
                    hint='all #scanp on the same position must agree '
                         'on type',
                    line=n.get('line'),
                )
            kinds_by_pos[pos] = kind
            # First-binding wins for the param name. Multiple #scanp
            # on the same position with different names is unusual but
            # legal — we report the first encountered (matches the
            # arity/kind reporting policy).
            varname = (n.get('var') or '').strip()
            if varname and pos not in names_by_pos:
                names_by_pos[pos] = varname
            if pos > max_pos:
                max_pos = pos
        return None

    _walk_ast(body, visit)
    arity = max_pos + 1 if max_pos >= 0 else 0
    kinds = [kinds_by_pos.get(i, 'int') for i in range(arity)]
    names = [names_by_pos.get(i, '') for i in range(arity)]
    return arity, kinds, names


def _collect_req_targets(ast: List[dict]) -> set:
    """Walk the full AST and collect every name referenced by a
    `#req[name] …;` directive inside a `#define`/`#cdefine` body.

    Those top-level slots get promoted to module globals at decl time,
    so the function body can bind a local through `b.global_addr`.
    Sector-member refs (`#req[Sec->m]`) are recorded under the
    qualified name and intentionally not promoted — that path resolves
    against the already-existing sector global at #req time.

    A.3.11: uses the universal walker so a `#req` directive declared
    inside a deeply-nested block (e.g. inside an object's label body)
    is still observed.
    """
    out: set = set()

    def visit(n: dict):
        if n.get('type') == 'directive' and n.get('directive') == 'req':
            gv = (n.get('global_var') or '').strip()
            # Skip sector-member refs (`Sec->m`); only simple names
            # need promotion.
            if gv and '->' not in gv:
                out.add(gv)
        return None

    _walk_ast(ast, visit)
    return out


# ---------------------------------------------------------------------------
# Trivial 1-runtime-call directives + peripheral declarations.
# ---------------------------------------------------------------------------
_GPIO_NEW_ARITY = {
    # Number of i64 args each `cssc_<kind>_new` takes. Pins are the
    # simplest (just a pin number); buses need clock + data lines etc.
    'pin':   1,
    'i2c':   3,    # bus_id, sda, scl
    'spi':   4,    # bus_id, sck, miso, mosi
    'uart':  3,    # bus_id, tx, rx
    'adc':   1,    # pin
    'pwm':   3,    # pin, freq, resolution
    'timer': 2,    # slot, hz
    # Display / framebuffer. `#oled[ctrl, w, h, sda, scl, addr] d;` and
    # `#tft[ctrl, w, h] d;` are the two shapes the legacy parser
    # produces — the parser injects `ssd1306` as the controller name
    # for `#oled` when the user omits one. The controller is passed as
    # an integer enum from `_TFT_CTRL_IDS` so the runtime can dispatch
    # to chip-specific init sequences.
    'tft':         3,    # ctrl_id, w, h
    'oled':        6,    # ctrl_id, w, h, sda, scl, addr
    'video':       3,    # width, height, fps
    'matrix':      3,    # width, height, scale
    'framebuffer': 2,    # width, height
    'console':     2,    # width, height
}


# Display-controller name → integer enum. The runtime uses this id to
# dispatch chip-specific init sequences (SSD1306 vs SH1106 vs ILI9341
# all differ in command set + display geometry).
_TFT_CTRL_IDS: Dict[str, int] = {
    'ssd1306':       1,
    'sh1106':        2,
    'ili9341':       3,
    'st7735':        4,
    'st7789':        5,
    'epaper':        6,
    # Allow the `tft::<NAME>` namespaced spelling too — the legacy
    # parser sometimes emits these via the namespace-access path.
    'tft::SSD1306':  1,
    'tft::SH1106':   2,
    'tft::ILI9341':  3,
    'tft::ST7735':   4,
    'tft::ST7789':   5,
    'tft::EPAPER':   6,
}


def _gpio_resolve_int_arg(b: CIRBuilder, raw: str,
                          default: int, line: Optional[int]) -> int:
    """Resolve a single `#pin[…]` bracket part to an i64 SSA id.

    Accepts: hex literal (`0x10`), decimal literal (`13`), or an
    identifier of an in-scope int slot whose value flows in at runtime.
    """
    s = (raw or '').strip()
    if not s:
        return b.const_int(default)
    # Hex / decimal literal — bake at compile time.
    try:
        if s.startswith(('0x', '0X')):
            return b.const_int(int(s, 16))
        return b.const_int(int(s))
    except ValueError:
        pass
    # Identifier of an int slot — runtime-load.
    if b.scope_has(s):
        return b.slot_load(b.scope_lookup(s), 'int')
    raise _csscerror(
        detail=f'#pin/#i2c/…: bracket argument {s!r} is neither a '
               f'literal nor an in-scope int slot',
        line=line,
    )


def _lower_gpio_directive(b: CIRBuilder, node: dict) -> None:
    """`#pin[…] var;` / `#i2c[…] bus;` / … — allocate a peripheral
    handle.

    Emits `cssc_<kind>_new(i64, …)` whose return is a heap pointer to
    the runtime's per-target peripheral struct. The handle is stored
    in a stack slot bound to `var`; method dispatch (`var.write(x)`,
    `var.read()`, …) is wired through `_lower_dot_call_expr` based on
    the slot's kind, and `slot_release` calls the matching
    `cssc_<kind>_free` on scope exit.

    Tree-shaken: the runtime emitter only materialises the symbols
    actually called by the user module — declare a `#pin` but never
    write to it and the firmware ships without the digital-write path.
    """
    line = node.get('line')
    directive = node['directive']
    var = node.get('var', '')
    parts = node.get('arg_parts') or []
    if not parts:
        _KIND_BRACKET_KEYS = {
            'video':       ('video_width', 'video_height', 'video_fps'),
            'matrix':      ('matrix_width', 'matrix_height', 'matrix_scale'),
            'framebuffer': ('fb_width', 'fb_height'),
            'console':     ('console_width', 'console_height'),
        }
        _keys = _KIND_BRACKET_KEYS.get(directive)
        if _keys:
            _reconstructed = [str(node.get(k, '')).strip() for k in _keys]
            if any(_reconstructed):
                parts = _reconstructed
    if not var:
        raise _csscerror(
            detail=f'#{directive} requires a target name: '
                   f'`#{directive}[…] my_handle;`',
            line=line,
        )
    # The parser rewrites `#oled[…]` to directive='tft' (both share
    # the same dispatch table downstream), but `#oled` carries three
    # extra bracket parts (sda, scl, addr) that `cssc_tft_new` does
    # NOT consume. We have to detect that case here and dispatch to
    # `cssc_oled_new` with all 6 args — otherwise the runtime
    # initialises sda=0/scl=0 and bit-bangs I2C on GPIO 0, leaving
    # the actual OLED on whatever pins the user picked silent.
    effective_directive = directive
    effective_arity = _GPIO_NEW_ARITY[directive]
    if directive == 'tft' and len(parts) >= 6:
        effective_directive = 'oled'
        effective_arity = _GPIO_NEW_ARITY['oled']
    arg_ids: List[int] = []
    for i in range(effective_arity):
        raw = parts[i] if i < len(parts) else ''
        # tft / oled: first bracket part is the controller name string.
        # Convert it to its integer enum so the runtime can dispatch.
        if i == 0 and effective_directive in ('tft', 'oled'):
            stripped = (raw or '').strip().strip('"').strip("'")
            ctrl_id = _TFT_CTRL_IDS.get(stripped.lower(),
                                        _TFT_CTRL_IDS.get(stripped))
            if ctrl_id is None and not stripped:
                ctrl_id = 1   # default: SSD1306
            if ctrl_id is None:
                raise _csscerror(
                    detail=f'#{effective_directive}: unknown controller name '
                           f'{stripped!r}',
                    hint=f'known controllers: '
                         f'{sorted(set(k for k in _TFT_CTRL_IDS if "::" not in k))}',
                    line=line,
                )
            arg_ids.append(b.const_int(ctrl_id))
            continue
        arg_ids.append(_gpio_resolve_int_arg(b, raw, 0, line))
    handle = b.call(f'cssc_{effective_directive}_new', arg_ids,
                    [INT64] * effective_arity, return_type=PTR, external=True)
    # Peripheral promotion: when the prescan saw a `#req[var]` inside
    # some downstream `#define` body, the handle slot must live as a
    # MODULE GLOBAL so the function body can resolve it through
    # `global_addr`. Top-level `cssc_user_main` is the canonical place
    # this happens. Promoted peripherals are stored as ptr-typed module
    # globals; the kind tag stays the peripheral kind so #req's caller-
    # side scope_bind threads through `cssc_<kind>_*` dispatch correctly.
    cur_fn = b._current_fn   # noqa: SLF001
    at_main = cur_fn is not None and cur_fn.name == 'cssc_user_main'
    promoted = at_main and var in _PROMOTED_GLOBALS
    if promoted:
        info = _PROMOTED_GLOBALS[var]
        info['kind'] = effective_directive
        info['bits'] = 64
        sym = info['sym']
        b.register_module_global(sym, 'ptr')
        slot = b.global_addr(sym)
        b.slot_store(slot, handle, PTR)
        b.scope_bind(var, slot, elem_kind=effective_directive)
        return
    slot = b.slot_alloc(effective_directive, 64)
    b.slot_store(slot, handle, PTR)
    b.scope_bind(var, slot, elem_kind=effective_directive)


def _lower_panic(b: CIRBuilder, node: dict) -> None:
    """`#panic("message");` — abort the program with a fixed message.

    Emits `cssc_panic(ptr msg, i64 len)` then a CIR `Unreachable`
    terminator. The host runtime impl writes to stderr and `exit(1)`s;
    the embedded variant prints over UART and halts the CPU. The
    Unreachable terminator (A.3.12) is the correct shape regardless of
    the enclosing function's return type — `b.ret()` was wrong because
    it folds to `ret void`, which the LLVM verifier rejects when the
    function's declared return type is non-void.
    """
    msg = (node.get('arg') or '').strip()
    ptr_id = b.const_str(msg)
    len_id = b.const_int(len(msg.encode('utf-8')))
    b.call('cssc_panic', [ptr_id, len_id], [PTR, INT64],
           return_type=VOID, external=True)
    b.unreachable()


def _lower_sysout(b: CIRBuilder, node: dict) -> None:
    """`#sysout(expr);` — set the program exit code.

    The runtime stores the value in a module-level i32 that `main`
    reads on shutdown (after `cssc_user_main` returns).
    """
    line = node.get('line')
    val_ast = node.get('value')
    if val_ast is None:
        # Bare `#sysout;` — equivalent to sysout(0).
        val_id = b.const_int(0)
    else:
        val_id, val_ty = _lower_expr(b, val_ast, expected_kind='int')
        if val_ty.kind != 'i64':
            raise _csscerror(
                detail=f'#sysout: expected int (got {val_ty.kind!r})',
                line=line,
            )
    b.call('cssc_sysout', [val_id], [INT64],
           return_type=VOID, external=True)


def _lower_adress(b: CIRBuilder, node: dict) -> None:
    """`#adress[var] dst;` — write the slot address of `var` into the
    declared int slot `dst`.

    Forms:
      * `#adress[var] dst;`        — GET: implemented here.
      * `#adress[var] = 0xABC;`    — ALIAS / runtime-rebind:
                                     interpreter-only, rejected here.

    Semantics on native:
      * `var` in scope → `dst = ptrtoint(slot_addr(var))`. A non-zero
        runtime address inside the function frame's spill area (or the
        bump arena for heap-typed slots).
      * `var` NOT in scope → `dst = 0`. This makes the guard idiom
        `if (dst != 0x0) { #delete[var]; }` work as the escape hatch
        for the otherwise-fatal `#delete[<missing>]` — at compile time
        we know `var` is unbound, so we bake the zero in. The user's
        if-block will then read 0 at runtime and skip the delete.

    The destination `dst` must be a declared int slot of any width;
    we store the address as i64 (truncation to the dst's width happens
    via the standard slot_store path).
    """
    line = node.get('line')
    if node.get('value') is not None:
        raise _csscerror(
            detail=('`#adress[var] = 0xABC;` (alias form) is interpreter-only — '
                    'native CSSC binds names to static SSA slots at lower time, '
                    'so a runtime rebind would invalidate every prior use of '
                    'the name. Drop the alias form or use the interpreter '
                    '(`cssc run`).'),
            hint=('The GET form `#adress[var] dst;` works on native and is '
                  'the only form the v6 native pipeline supports.'),
            line=line,
        )
    source_name = (node.get('arg') or '').strip()
    dest_name = (node.get('var') or '').strip()
    if not source_name:
        raise _csscerror(detail='#adress[<var>] requires a source variable name',
                         line=line)
    if not dest_name:
        raise _csscerror(
            detail='#adress[var] requires a destination name',
            hint=('Use `#adress[<source>] <dest_int_slot>;`. The '
                  'destination slot must be declared first, e.g. '
                  '`#stack[int, 64] addr; #adress[x] addr;`.'),
            line=line,
        )
    if not b.scope_has(dest_name):
        raise _csscerror(
            detail=f'#adress: destination {dest_name!r} not declared',
            hint=(f'Declare it first with `#stack[int, 64] {dest_name};` '
                  f'(any int width works; the address is stored as i64).'),
            line=line,
        )
    dest_kind = b.scope_kind(dest_name)
    if dest_kind not in ('int',):
        raise _csscerror(
            detail=(f'#adress: destination {dest_name!r} must be an int '
                    f'slot (got {dest_kind!r})'),
            hint='use `#stack[int, 64] addr;` (or 32-bit) as the target',
            line=line,
        )
    dest_slot = b.scope_lookup(dest_name)
    if source_name in _INTERRUPTS:
        # `#adress[isrName] dst;` — take the address of a `#interrupt`
        # handler so CSSC can poke it into an IDT entry. Resolve the
        # ISR symbol to a ptr, then to i64.
        fn_ptr = b.global_addr(_INTERRUPTS[source_name]['sym'])
        addr_int = b.ptr_to_int(fn_ptr)
        b.slot_store(dest_slot, addr_int, INT64)
        return
    if b.scope_has(source_name):
        # In scope at lower time → its slot is a known SSA. Convert the
        # ptr to i64 via the existing bitcast helper and store.
        src_slot = b.scope_lookup(source_name)
        addr_int = b.call('__cssc_bitcast_ptr_i64', [src_slot], [PTR],
                          return_type=INT64, external=True)
        b.slot_store(dest_slot, addr_int, INT64)
    else:
        # Not in scope → bake `0x0`. The guard idiom
        # `if (dest != 0x0) { #delete[source]; }` then evaluates the
        # branch as false at runtime; the `#delete` inside the body
        # still has to lower (we don't constant-fold dead branches
        # yet), so the source name MUST be in scope at the use site.
        # This zero-bake is correct for the case where the user is
        # checking a name they expect to be live in some paths and
        # NOT live here — but they still have to write the name in a
        # syntactically-valid position.
        zero = b.const_int(0)
        b.slot_store(dest_slot, zero, INT64)


def _lower_sysarg(b: CIRBuilder, node: dict) -> None:
    """`#sysarg[type, idx] var;` — capture argv[idx] into a fresh int slot.

    Native v6 supports `type=int` only for now (int parse of the
    argument string). Bool/float/string variants need their own
    runtime parsers — they land alongside the wider scanp surface.
    """
    line = node.get('line')
    typ = (node.get('sysarg_type') or 'int').strip()
    idx_raw = (node.get('sysarg_index') or '0').strip()
    var = node.get('var', '')
    if not var:
        raise _csscerror(detail='#sysarg requires a target name', line=line)
    if typ != 'int':
        raise _csscerror(
            detail=f'#sysarg: native lowering supports `int` only '
                   f'(got {typ!r})',
            hint='bool/float/string variants need extra runtime parsers',
            line=line,
        )
    try:
        idx = int(idx_raw)
    except ValueError:
        raise _csscerror(
            detail=f'#sysarg: index must be an integer literal (got '
                   f'{idx_raw!r})',
            line=line,
        )
    idx_id = b.const_int(idx)
    val = b.call('cssc_sysarg_int', [idx_id], [INT64],
                 return_type=INT64, external=True)
    slot = b.slot_alloc('int', 64)
    b.slot_store(slot, val, INT64)
    b.scope_bind(var, slot, elem_kind='int')


def _lower_qvar(b: CIRBuilder, node: dict) -> None:
    """`#qvar(type, expr) varname;` — quick variable from a string-form
    expression.

    The parser captures the expression as a literal string (since
    qvar's body is read inside the directive's `arg` parens). We
    re-parse it here into an AST node, then desugar to a regular
    `#stack[type, 64] varname = <ast>;` and route through
    `_lower_slot_decl` so the int-only restrictions, slot allocation,
    and init machinery all work uniformly.
    """
    line = node.get('line')
    vtype = (node.get('vtype') or 'int').strip()
    expr_str = (node.get('expr_str') or '').strip()
    varname = node.get('var', '')
    if not varname:
        raise _csscerror(detail='#qvar requires a target name', line=line)
    if not expr_str:
        raise _csscerror(
            detail='#qvar requires an expression: `#qvar(type, expr) name;`',
            line=line,
        )
    # Re-parse the expression string into an AST node. Using the same
    # lexer/parser as the rest of CSSC ensures the qvar surface stays
    # in sync with whatever the parser accepts elsewhere.
    from ...cssl_cssc import CsscLexer, CsscParser, CsscError
    # A.3.19: catch only the lexer/parser's structured CsscError. Anything
    # else (KeyError, AttributeError, ...) is a real bug in the lower
    # and must propagate so it surfaces in development instead of being
    # silently wrapped in a misleading #qvar error.
    try:
        toks = CsscLexer(expr_str, '<qvar>').tokenize()
        parser = CsscParser(toks, '<qvar>')
        expr_ast = parser._parse_expression()    # noqa: SLF001
    except CsscError as e:
        raise _csscerror(
            detail=f'#qvar: could not parse expression {expr_str!r}: {e}',
            line=line,
        )
    synth = {
        'type':      'directive',
        'directive': 'stack',
        'arg':       f'{vtype}, 64',
        'var':       varname,
        'value':     expr_ast,
        'line':      line,
    }
    _lower_slot_decl(b, synth)


# Kinds the runtime exposes a refcount-retain symbol for. Currently only
# `string` is refcount-managed at the unified `cssc_retain` level;
# containers (vector_*/array_*/map_*/bind*) have their own per-element
# refcount cascade but no whole-container retain symbol — so a `&local`
# snapshot of a container global is rejected with a clear migration
# hint instead of silently emitting code that would double-free at
# teardown.
_PROMOTED_SNAPSHOT_RETAIN = {'string'}


def _snapshot_promoted_into(b: CIRBuilder, snap_slot: int, loaded_val: int,
                            kind: str, line: Optional[int]) -> None:
    """Implements the `&local` snapshot path for `#req[outer] &local;`.

    * POD kinds (int/bool/float) — store the loaded value with the
      matching CIR type. No retain needed.
    * `string` — store the heap ptr and bump the refcount via
      `cssc_retain`. The snap slot becomes an independent owner, so
      `#delete[outer]` and `#delete[local]` each drop one reference;
      the underlying cssc_str frees on the second.
    * Other heap kinds (containers / binds) — not yet supported at the
      snapshot site. Plain ref-binding (`#req[outer] local;` without
      `&`) is the correct form for these; the user can drop the `&`.
    """
    if kind in ('int', 'bool', 'float'):
        val_ty = {'int': INT64, 'bool': BOOL, 'float': FLOAT64}[kind]
        b.slot_store(snap_slot, loaded_val, val_ty)
        return
    if kind == 'string':
        b.slot_store(snap_slot, loaded_val, PTR)
        b.call('cssc_retain', [loaded_val], [PTR],
               return_type=VOID, external=True)
        return
    if kind in _PROMOTED_SNAPSHOT_RETAIN:
        b.slot_store(snap_slot, loaded_val, PTR)
        return
    raise _csscerror(
        detail=(f"#req[..] &local: kind {kind!r} can't be snapshotted "
                f"via `&` yet"),
        hint=("drop the `&` to ref-bind the global instead — writes "
              "and `#delete` flow back through the same heap object; "
              "or call `&` after declaring a fresh container slot and "
              "copy-construct it explicitly"),
        line=line,
    )


def _lower_req(b: CIRBuilder, node: dict) -> None:
    """`#req[<globalVar>] [&|*]<localVar>;` — bind a top-level global
    into the current function's scope.

    Resolution:
      * Plain name → look up in `_PROMOTED_GLOBALS`, which the prescan
        in `lower_program` populated. The top-level slot decl emitted
        the matching module global.
      * `Sec->member` → resolve against the sector's global symbol
        registered by `_register_sector_member`.

    Binding mode (v5):
      * no prefix on localname (default) → ref. Bind the local name
        directly to the global's `ptr` SSA id so reads/writes pass
        straight through. `is_ref=True` from the parser.
      * `&localname` (explicit copy) → alloca a fresh stack slot, load
        the global once, store into the slot. No write-back.
        `is_ref=False` from the parser.
      * legacy `*localname` (deprecated marker) → ref. Same as default.

    Sector globals reuse the same logic via `_SECTORS[…]['slots']`.
    """
    line = node.get('line')
    gv = (node.get('global_var') or '').strip()
    local = (node.get('var') or '').strip()
    is_ref = bool(node.get('is_ref', True))   # v5 default
    if not gv:
        raise _csscerror(detail='#req requires a global-var name', line=line)
    if not local:
        raise _csscerror(detail='#req requires a target local name', line=line)

    # Callable alias: `#req[fnName] local;` — when `gv` resolves to a
    # known #define'd function, register `local` as a per-function
    # alias so `local(arg)` calls inside this body lower to the
    # underlying `cssc_user_<fnName>`. No runtime store needed; the
    # binding is pure metadata consumed by `_lower_call`.
    if '->' not in gv and gv in _DEFINES:
        _callable_alias_bind(local, gv)
        return

    # Module-alias re-binding: `#req[gp] gp;` (or `#req[gp] g;` to
    # rename). Modules registered via `#include('mod') gp;` live in
    # `_INCLUDED_MODULES` keyed by their alias. They are NOT slots —
    # there is no runtime address to bind — so the canonical handling
    # is to register `local` as a SECOND alias of the same module so
    # any `local::Symbol` reference downstream resolves identically.
    # This makes `#req[gp] gp;` inside a `#define` body a clean
    # no-runtime-cost import that mirrors what `#req` does for slots.
    if '->' not in gv and gv in _INCLUDED_MODULES:
        # Copy the include-meta under the new local alias. The
        # downstream `_lower_ns_call_expr` / `_lower_ns_access` read
        # `_INCLUDED_MODULES[ns]` to resolve `local::Symbol`, so this
        # makes both `gp::HIGH` and `local::HIGH` work.
        _INCLUDED_MODULES[local] = dict(_INCLUDED_MODULES[gv])
        return

    # Bare-name member ref inside a sector function body: when we're
    # emitting code for `cssc_sec_<Sector>_<func>`, an unqualified
    # `#req[member]` resolves against the OWNING sector's slots dict.
    # This is the Spec §6.1 contract — inside a sector you address
    # members bare, even when the body is a private `#define` scope
    # that needs explicit imports.
    owning_sec = _owning_sector_current()
    if '->' not in gv and owning_sec is not None:
        owner_info = _SECTORS.get(owning_sec, {})
        owner_slots = owner_info.get('slots', {})
        if gv in owner_slots:
            meta = owner_slots[gv]
            sym = meta['sym']
            kind = meta['kind']
            g_addr = b.global_addr(sym)
            if is_ref:
                b.scope_bind(local, g_addr, elem_kind=kind)
                return
            # `&local` — explicit copy snapshot.
            bits = meta.get('bits') or 64
            snap = b.slot_alloc(kind, bits)
            val = b.slot_load(g_addr, kind)
            _snapshot_promoted_into(b, snap, val, kind, line)
            b.scope_bind(local, snap, elem_kind=kind)
            return

    # Resolve symbol + kind.
    if '->' in gv:
        sec, _, mem = gv.partition('->')
        sec_info = _SECTORS.get(sec)
        if sec_info is None or mem not in sec_info.get('slots', {}):
            raise _csscerror(
                detail=f"#req[{gv}]: sector member not found",
                hint=f'sectors: {sorted(_SECTORS.keys())}',
                line=line,
            )
        meta = sec_info['slots'][mem]
        sym = meta['sym']
        kind = meta['kind']
    else:
        info = _PROMOTED_GLOBALS.get(gv)
        if info is None:
            raise _csscerror(
                detail=f"#req[{gv}]: no matching top-level slot found "
                       f"(or its kind isn't promotable yet)",
                hint='declare it first: `#stack[int,32] {gv} = …;` at '
                     'top level before any #define that #reqs it',
                line=line,
            )
        if not info.get('kind'):
            # Promoted but never actually decl'd at top level — the
            # prescan saw the #req but no matching slot appeared.
            raise _csscerror(
                detail=f"#req[{gv}]: no top-level slot {gv!r} declared",
                line=line,
            )
        sym = info['sym']
        kind = info['kind']

    g_addr = b.global_addr(sym)

    if is_ref:
        # Ref binding: local name aliases the global. Reads load, writes
        # store, both through the same ptr.
        b.scope_bind(local, g_addr, elem_kind=kind)
        return

    # `&local` (explicit copy): snapshot the global once into a fresh
    # stack slot; no write-back.
    bits = _PROMOTED_GLOBALS.get(gv, {}).get('bits') or 64
    snap = b.slot_alloc(kind, bits)
    val = b.slot_load(g_addr, kind)
    _snapshot_promoted_into(b, snap, val, kind, line)
    b.scope_bind(local, snap, elem_kind=kind)


def _lower_interrupt(b: CIRBuilder, node: dict) -> None:
    """Top-level `#interrupt(name) { body }` — a CCOS hardware ISR.

    Emits a CIR function `cssc_isr_<name>` marked `is_interrupt`, so
    `cir_to_llvm` gives it the LLVM `x86_intrcc` calling convention (the
    CPU-pushed frame + `iretq`). The body takes no CSSC params and is
    integer-only in v1 (uses `cssc::outb`/`poke`/… intrinsics). The
    handler address is taken via `#adress[name]` to fill an IDT entry.
    """
    name = node.get('target', '')
    body = node.get('body', []) or []
    line = node.get('line')
    if not name:
        raise _csscerror(detail='#interrupt requires a handler name', line=line)
    if name in _INTERRUPTS:
        raise _csscerror(detail=f'#interrupt {name!r} redeclared', line=line)
    if name in _DEFINES or name in _SECTORS or name in _OBJECTS:
        raise _csscerror(
            detail=f'#interrupt {name!r} collides with an existing '
                   f'define/sector/object of the same name',
            line=line,
        )
    sym = f'cssc_isr_{name}'
    _INTERRUPTS[name] = {'sym': sym}
    _instance_scope_enter()
    _callable_alias_push()
    try:
        with b.function(sym, VOID, []):
            # Mark for x86_intrcc emission (the frame param is emitted by
            # cir_to_llvm; the body ignores it in v1).
            b._current_fn.is_interrupt = True          # noqa: SLF001
            # Handlers named `<name>_ec` are error-code exception handlers:
            # emit the x86_intrcc signature WITH the trailing i64 error-code
            # param so LLVM aligns the stack + skips the error code on iretq
            # (vectors 8,10-14,17,21). Without this an error-code fault (#PF,
            # #GP) double-faults inside the handler -> triple fault -> reset.
            if name.endswith('_ec'):
                b._current_fn.is_interrupt_err = True  # noqa: SLF001
            # A leaf integer ISR needs no scope frame (no heap temps / no
            # cross-frame delete); eliding it keeps the handler minimal.
            b._current_fn.needs_scope = False          # noqa: SLF001
            for stmt in body:
                _lower_stmt(b, stmt)
            # b.function auto-emits `ret void` if the block is unterminated.
    finally:
        _callable_alias_pop()
        _instance_scope_exit()


def _lower_define(b: CIRBuilder, node: dict) -> None:
    """Top-level `#define(name) { body }`.

    Pre-scans the body for `#scanp(name, …)` references to discover the
    function's arity, then emits a CIR function `cssc_user_<name>` with
    that many `i64` parameters. Each parameter is spilled into a stack
    slot at function entry so `#scanp` can produce a normal mutable
    binding. The synthetic parameter names (`__arg0`, `__arg1`, …) are
    unbound from scope before the body lowers, so user code can never
    see them as identifiers.
    """
    name = node.get('target', '')
    body = node.get('body', []) or []
    line = node.get('line')
    if not name:
        raise _csscerror(detail='#define requires a target name', line=line)
    if name in _DEFINES:
        raise _csscerror(detail=f'#define {name!r} redeclared', line=line)
    if name in _SECTORS or name in _OBJECTS:
        raise _csscerror(
            detail=f'#define {name!r} collides with a sector/object of the '
                   f'same name',
            line=line,
        )

    arity, arg_kinds, arg_param_names = _prescan_define_args(body, name)
    arg_kinds = ['int' if k == 'auto' else k for k in arg_kinds]
    for i, k in enumerate(arg_kinds):
        if k not in _NATIVE_PARAM_SCALAR_KINDS and k not in _CONTAINER_PARAM_KINDS:
            raise _csscerror(
                detail=f'#define({name}): param #{i} kind {k!r} not '
                       f'supported',
                hint='supported native param kinds: int, string, float, '
                     'bool, and container kinds (vector<T>, array<T>, '
                     'map<K,V>, bind<T>) — all carried by heap pointer',
                line=line,
            )

    sym = f'cssc_user_{name}'
    # ABI: leading `__nargs` (i64) carries the *actual* caller arg
    # count; the positional `__argN` slots follow. The body never sees
    # these names — they're unbound from scope before the body lowers.
    # Every positional slot is i64-shaped; string args carry their
    # `cssc_str*` heap pointer in the i64 slot (ptr fits in 8 bytes on
    # every supported target).
    params = [('__nargs', INT64)] + [(f'__arg{i}', INT64) for i in range(arity)]
    return_kind = _prescan_define_returns(body)
    # Phase A.5: map the pre-scanned kind to its CIR return type.
    # `void` stays VOID; the value-returning kinds get the matching
    # primitive (i64 / i1 / f64) or `STRING_PTR` for heap-string
    # returns (the cssc_str* carries refcount=1 on entry; the caller
    # adopts the ref via the call expression's result kind).
    if return_kind == 'int':
        return_ty = INT64
    elif return_kind == 'bool':
        return_ty = BOOL
    elif return_kind == 'float':
        return_ty = FLOAT64
    elif return_kind == 'string':
        return_ty = STRING_PTR
    elif return_kind in _CONTAINER_PARAM_KINDS:
        # Container return — a heap pointer the caller's slot adopts
        # (single-owner move). A `#stack` container isn't bulk-freed at
        # function exit, so it escapes cleanly through the return; the
        # exact element kind is recovered by `_lower_return` /
        # `result_capture` from `_DEFINES[name]['return_kind']`.
        return_ty = PTR
    else:
        return_ty = VOID
    _DEFINES[name] = {
        'sym': sym,
        'arity': arity,
        'arg_kinds': arg_kinds,
        # v6 ref-by-default (spec §2.5): per-position user-visible
        # param names from `#scanp(…) varname;`. Used by
        # `_lower_arg_for_call` to emit `cssc_arg_link(stack, param,
        # caller_slot)` when the caller passes a bare identifier.
        'arg_param_names': arg_param_names,
        'param_slots': [],
        'n_args_slot': -1,
        'return_kind': return_kind,
        'return_ty': return_ty,
        # Mirror v6 semantics — hidden function-local i64 slots
        # populated by the body's `mirror` (if any). At the function
        # epilogue we read `mirror_value_slot` (snapshot path) OR
        # follow `mirror_ref_slot` (live-ref re-fetch path) to
        # produce the final ret value. Filled in inside the
        # `b.function(...)` context below.
        'mirror_value_slot': -1,
        'mirror_ref_slot':   -1,
        'mirror_used':       False,
    }

    # A.3.13: #define body gets its own _INSTANCES frame too.
    _instance_scope_enter()
    # Open a fresh callable-alias frame so `#req[callable] alias;`
    # inside the body stays scoped to this function (Spec §5.4 —
    # `#define` is a strictly isolated private scope).
    _callable_alias_push()
    try:
        with b.function(sym, return_ty, params):
            # Record the exact CSSC return kind on the CIR function so
            # `_lower_return` can recover a container return's element kind
            # (the CIR return type is a bare PTR for every container).
            b._current_fn.cssc_return_kind = return_kind   # noqa: SLF001
            # Spill `__nargs` into a stack slot for the scanp runtime check.
            n_args_slot = b.slot_alloc('int', 64)
            b.slot_store(n_args_slot, 0, INT64)   # SSA id 0 is __nargs
            # Spill each positional param. Param i has SSA id (i + 1) since
            # __nargs occupies id 0. The stored type is INT64 regardless
            # of declared kind — string args carry their `cssc_str*` in
            # the same i64 register.
            param_slots: List[int] = []
            for i in range(arity):
                slot = b.slot_alloc('int', 64)
                b.slot_store(slot, i + 1, INT64)
                param_slots.append(slot)
            # Hide every synthetic param name from user scope.
            b._slots.pop('__nargs', None)                  # noqa: SLF001
            b._slot_kinds.pop('__nargs', None)             # noqa: SLF001
            for i in range(arity):
                b._slots.pop(f'__arg{i}', None)            # noqa: SLF001
                b._slot_kinds.pop(f'__arg{i}', None)       # noqa: SLF001
            _DEFINES[name]['param_slots'] = param_slots
            _DEFINES[name]['n_args_slot'] = n_args_slot
            # v6 mirror epilogue infrastructure — two hidden slots.
            # `mirror_value_slot` is the snapshot capture (deep-copy
            # path or expression mirror); typed per the function's
            # declared return kind so float/bool returns store at the
            # right precision. `mirror_ref_slot` carries the ADDRESS
            # of the source slot for live-ref mirrors; zero means
            # "no live-ref" and the epilogue uses the snapshot. Both
            # default to 0 / false / 0.0 so a body without any
            # `mirror;` produces the existing "missing return → 0"
            # behaviour.
            mirror_value_slot = b.slot_alloc(
                return_kind if return_kind in ('int', 'bool', 'float') else 'int',
                64)
            if return_kind == 'bool':
                b.slot_store(mirror_value_slot, b.const_bool(False), BOOL)
            elif return_kind == 'float':
                b.slot_store(mirror_value_slot, b.const_float(0.0), FLOAT64)
            else:
                # Phase A.5: for string returns the slot is int-typed so
                # its auto-release at function exit is a no-op — the heap
                # cssc_str* survives until the caller's slot adopts it.
                # Mirror time stores via ptr→i64 bitcast; epilogue inverts.
                b.slot_store(mirror_value_slot, b.const_int(0), INT64)
            mirror_ref_slot = b.slot_alloc('int', 64)
            b.slot_store(mirror_ref_slot, b.const_int(0), INT64)
            _DEFINES[name]['mirror_value_slot'] = mirror_value_slot
            _DEFINES[name]['mirror_ref_slot']   = mirror_ref_slot
            _DEFINES[name]['mirror_used']       = False
            try:
                for stmt in body:
                    _lower_stmt(b, stmt)
                # ── Function epilogue ───────────────────────────────
                # Two reasons we might be here without a terminator:
                # (a) the body ran straight to the end (no explicit
                #     `return` / `mirror` along this path), or
                # (b) the body had `mirror x;` somewhere — mirror
                #     stores the value into `mirror_value_slot` and
                #     does NOT terminate, so execution always falls
                #     through to here.
                # Resolve the return value per v6 spec:
                #   - mirror used + ref source live  → re-fetch from
                #     ref'd slot's address (gives 0 if `#delete`d
                #     during cleanup; current value otherwise).
                #   - mirror used + no ref source    → use snapshot
                #     value (the deep-copy path or expression mirror).
                #   - mirror NOT used                → 0 (matches
                #     interpreter "missing return → null" rule).
                # Emitted only for value-returning functions; void
                # functions fall through to the builder's implicit
                # `ret void`.
                if (return_kind in ('int', 'bool', 'float', 'string')
                        and not _current_block_terminates(b)):
                    _emit_mirror_epilogue_ret(
                        b, mirror_value_slot, mirror_ref_slot,
                        return_kind=return_kind)
            finally:
                # Clear so a stray scanp outside the body doesn't latch onto
                # these stack slots from another function's frame.
                _DEFINES[name]['param_slots'] = []
                _DEFINES[name]['n_args_slot'] = -1
                _DEFINES[name]['mirror_value_slot'] = -1
                _DEFINES[name]['mirror_ref_slot']   = -1
                _DEFINES[name]['mirror_used']       = False
    finally:
        _callable_alias_pop()
        _instance_scope_exit()


def _emit_mirror_epilogue_ret(b: 'CIRBuilder',
                                mirror_value_slot: int,
                                mirror_ref_slot: int,
                                return_kind: str = 'int') -> None:
    """Emit the value-returning function epilogue per v6 mirror semantics.

    For `int` returns, branches between a live-ref re-fetch path (via
    `cssc_load_i64_at`) and a snapshot path. For `bool` / `float`
    returns (Phase A.5), only the snapshot path is used — adding
    per-kind `cssc_load_<kind>_at` helpers across three backends would
    quadruple the runtime surface for marginal gain. The semantic
    difference: a bool/float function whose body does `mirror x; #delete[x];`
    returns the value `x` had AT THE MIRROR POINT, not the post-delete
    zero. This matches typical user intent and lets us skip the
    cross-backend runtime work; the int path's re-fetch behaviour
    stays unchanged for back-compat.
    """
    if return_kind == 'int':
        # Original int path — re-fetch live ref or snapshot.
        result_slot = b.slot_alloc('int', 64)
        b.slot_store(result_slot, b.const_int(0), INT64)
        ref_val = b.slot_load(mirror_ref_slot, 'int')
        zero = b.const_int(0)
        cnd = b.cmp_int('!=', ref_val, zero)
        refetch_blk = b.new_block('mirror.refetch')
        snapshot_blk = b.new_block('mirror.snapshot')
        join_blk     = b.new_block('mirror.join')
        b.br_cond(cnd, refetch_blk, snapshot_blk)
        b.set_block(refetch_blk)
        fetched = b.call(
            'cssc_load_i64_at', [ref_val], [INT64],
            return_type=INT64, external=True,
        )
        b.slot_store(result_slot, fetched, INT64)
        b.br(join_blk)
        b.set_block(snapshot_blk)
        snap = b.slot_load(mirror_value_slot, 'int')
        b.slot_store(result_slot, snap, INT64)
        b.br(join_blk)
        b.set_block(join_blk)
        final_val = b.slot_load(result_slot, 'int')
        b.ret(final_val, INT64)
        return

    # bool / float — snapshot-only path. Reads the kind-typed slot
    # directly and returns. The mirror's `mirror &x;` already stored
    # the snapshot at mirror time; live-ref semantics for these kinds
    # would require per-type runtime helpers we haven't added yet.
    if return_kind == 'bool':
        snap = b.slot_load(mirror_value_slot, 'bool')
        b.ret(snap, BOOL)
        return
    if return_kind == 'float':
        snap = b.slot_load(mirror_value_slot, 'float')
        b.ret(snap, FLOAT64)
        return
    if return_kind == 'string':
        # Phase A.5: string returns. The mirror_value_slot is int-typed
        # holding the ptr's bit pattern (via ptr_to_int at store time).
        # Convert back to ptr via int_to_ptr for the LLVM `ret ptr` form.
        # `b.ret(ssa, STRING_PTR)` emits the matching ret-type token, so
        # the caller's call-site sees a ptr-shaped return.
        snap_i64 = b.slot_load(mirror_value_slot, 'int')
        snap_ptr = b.int_to_ptr(snap_i64)
        b.ret(snap_ptr, STRING_PTR)
        return
    # Should not reach here — caller's gate restricts to int/bool/float/string.
    raise _csscerror(
        detail=f'mirror epilogue: unsupported return kind {return_kind!r}',
    )


def _lower_cdefine(b: CIRBuilder, node: dict) -> None:
    """Top-level `#cdefine(name, p1, p2) { body }` — named-parameter
    callback.

    Mirrors the interpreter's [_exec_cdefine] semantics: each named
    parameter binds the matching positional argument from the call.
    The interpreter requires `#include('def');` first; we enforce the
    same gate here for parity, so users can't drift between paths.

    Implementation: desugar to `#define(name) { ... }` with synthesized
    `#scanp(name, int, k) <pk>;` directives prepended for each named
    parameter, then delegate to `_lower_define`. The synthesized
    scanps share the same source and `int`-only kind discipline as
    the rest of the v6 native parameter surface.
    """
    line = node.get('line')
    name = node.get('target', '')
    params = node.get('params', []) or []
    body = node.get('body', []) or []
    if not name:
        raise _csscerror(detail='#cdefine requires a target name', line=line)
    if 'def' not in _INCLUDED_MODULES:
        raise _csscerror(
            detail='#cdefine requires `#include(\'def\');` at the top of '
                   'the file',
            hint="add `#include('def');` before any #cdefine. Core CSSC "
                 "takes parameters via #define + #scanp.",
            line=line,
        )
    # Reject param shadowing (two params with the same name) — same
    # check the interpreter implicitly does (last name wins, but that
    # silently breaks ref linking).
    seen: set = set()
    for p in params:
        if p in seen:
            raise _csscerror(
                detail=f'#cdefine({name}, …): duplicate parameter {p!r}',
                line=line,
            )
        seen.add(p)
    body_scanp_types: Dict[int, str] = {}

    def _pt_visit(nn):
        if isinstance(nn, dict):
            if nn.get('type') == 'scanp' and nn.get('source', '') == name:
                try:
                    _pp = int(nn.get('pos', 0))
                except (TypeError, ValueError):
                    _pp = -1
                if _pp >= 0:
                    _vt = (nn.get('vtype') or 'int')
                    if _vt.startswith('*'):
                        _vt = _vt[1:]
                    body_scanp_types.setdefault(_pp, _vt.strip())
            for _v in nn.values():
                if isinstance(_v, (dict, list)):
                    _pt_visit(_v)
        elif isinstance(nn, list):
            for _e in nn:
                _pt_visit(_e)

    for _b in body:
        _pt_visit(_b)

    synth_scanps = [{
        'type':       'scanp',
        'source':     name,
        'vtype':      (body_scanp_types.get(i)
                       or _PARAM_TYPES.get(pname)
                       or 'int'),
        'pos':        i,
        'var':        pname,
        'var_prefix': '',
        'is_copy':    False,
        'default':    None,
        'optional':   False,
        'line':       line,
    } for i, pname in enumerate(params)]
    synth_define = {
        'type':   'define',
        'target': name,
        'body':   synth_scanps + body,
        'line':   line,
    }
    _lower_define(b, synth_define)


def _lower_scanp(b: CIRBuilder, node: dict) -> None:
    """`#scanp(source, type, pos) [&|*]varname [= default];`

    Core CSSC parameter-binding directive — fetches the caller's
    positional argument by index and binds it to a stack slot.

    Semantics (mirror of the interpreter side, [cssl_cssc.py:7002]):
      * no prefix on varname  → ref (v5 default; shared object). For
        the v6 native int-only parameter surface, ref and copy are
        observationally identical, so we just copy the i64 value.
      * `&varname`            → explicit deep-copy snapshot.
      * `*varname`            → deprecated ref marker; same as default.
      * legacy `*type`        → also ref; the leading `*` is stripped
        by the prescan and parser alike.
      * pos beyond the source's arity → silent `i64 0` (classic
        nullptr), no crash. A `= defaultExpr` overrides the zero.
    """
    line = node.get('line')
    src = node.get('source', '')
    varname = node.get('var', '')
    vtype = (node.get('vtype') or 'int')
    if vtype.startswith('*'):
        vtype = vtype[1:]
    kind = _normalise_slot_type(vtype.strip()) or 'int'
    try:
        pos = int(node.get('pos', 0))
    except (TypeError, ValueError):
        raise _csscerror(
            detail=f'#scanp: positional index must be an integer '
                   f'(got {node.get("pos")!r})',
            line=line,
        )

    if not varname:
        raise _csscerror(detail='#scanp requires a target variable name',
                         line=line)
    if kind == 'auto':
        kind = 'int'
    if (kind not in _NATIVE_PARAM_SCALAR_KINDS
            and kind not in _CONTAINER_PARAM_KINDS):
        raise _csscerror(
            detail=f'#scanp: unsupported param kind {kind!r}',
            hint='supported: int, string, float, bool, and container '
                 'kinds (vector<T>, array<T>, map<K,V>, bind<T>)',
            line=line,
        )

    info = _DEFINES.get(src)
    if info is None:
        raise _csscerror(
            detail=f'#scanp: source {src!r} is not a known #define',
            hint=f'declare it first: `#define({src}) {{ … }}`',
            line=line,
        )

    # The matching define's param_slots is populated only while *its*
    # body is being lowered. If it's empty here, the scanp escaped its
    # define — that's a bug in user code, not a missing-feature.
    param_slots = info.get('param_slots') or []
    n_args_slot = info.get('n_args_slot', -1)
    if not param_slots or n_args_slot < 0:
        raise _csscerror(
            detail=f'#scanp({src}, …, {pos}): only valid inside the '
                   f'`#define({src}) {{ … }}` body',
            line=line,
        )
    if pos >= len(param_slots):
        # The prescan computed arity from the max pos seen — this branch
        # would mean the prescan missed this node. Defensive only.
        raise _csscerror(
            detail=f'#scanp({src}, …, {pos}): position outside prescanned '
                   f'arity {len(param_slots)}',
            line=line,
        )

    # ── v6 ref-by-default scanp lowering (Spec §2.5; plan §P2) ──────
    #
    # The CALLER packs per-arg ref/copy bits into the HIGH 32 bits of
    # __nargs (see `_lower_call`). Each scanp must runtime-branch on
    # its position's bit:
    #
    #   bit=1 (REF):   __arg[pos] holds the caller's slot ADDRESS as
    #                  i64. The param's "slot" IS that address —
    #                  cast i64→ptr and bind. Reads/writes go through
    #                  the caller's storage automatically; `#delete[p]`
    #                  zeroes 8 B at caller's slot (no extra runtime
    #                  helper needed for the primitive case).
    #
    #   bit=0 (COPY):  __arg[pos] holds the value. Allocate a fresh
    #                  local slot, store the value, bind the param
    #                  to that local. Existing behaviour.
    #
    # OOB (n_args <= pos): use default expr or i64 0 in a fresh local
    # slot. Same as before.
    #
    # The param-pointer is computed in two branches + a join block,
    # then loaded from a holder slot. The holder is `alloca ptr`
    # (allocated via slot_alloc('string',64) which maps to ptr in
    # _slot_type). Single load at the join; subsequent body accesses
    # use the bound ptr directly with no extra indirection.
    payload = b.slot_load(n_args_slot, 'int')
    nargs_actual = b.bit_and(payload, b.const_int(0xFFFFFFFF))
    pos_const = b.const_int(pos)
    have_cnd = b.cmp_int('>', nargs_actual, pos_const)

    have_blk = b.new_block('scanp.have')
    miss_blk = b.new_block('scanp.miss')
    end_blk  = b.new_block('scanp.end')

    # ptr_holder lives in the entry block (slot_alloc emits in the
    # current block; the LLVM optimizer will hoist).
    ptr_holder = b.slot_alloc('string', 64)   # 'string' kind → alloca ptr

    b.br_cond(have_cnd, have_blk, miss_blk)

    # ── have: caller passed an arg at this pos ──────────────────────
    b.set_block(have_blk)
    have_val = b.slot_load(param_slots[pos], 'int')   # i64 carrying addr OR value
    # Extract the ref-bit for this position from payload's high half.
    bit_pos_shift = b.const_int(32 + pos)
    bits_high = b.binop('lshr', payload, bit_pos_shift)
    is_ref_val = b.bit_and(bits_high, b.const_int(1))
    is_ref = b.cmp_int('!=', is_ref_val, b.const_int(0))

    ref_blk = b.new_block('scanp.ref')
    copy_blk = b.new_block('scanp.copy')
    have_end_blk = b.new_block('scanp.have_end')
    b.br_cond(is_ref, ref_blk, copy_blk)

    # REF: have_val IS the caller's slot address. Cast to ptr; bind.
    b.set_block(ref_blk)
    caller_ptr = b.int_to_ptr(have_val)
    b.slot_store(ptr_holder, caller_ptr, PTR)
    b.br(have_end_blk)

    # COPY: have_val is a value; spill to a local slot, bind ptr to local.
    b.set_block(copy_blk)
    local_copy = b.slot_alloc(kind, 64)
    if kind == 'float':
        f_val = b.bitcast_int_to_float(have_val)
        b.slot_store(local_copy, f_val, FLOAT64)
    elif kind == 'bool':
        bl_val = b.trunc_int_to_bool(have_val)
        b.slot_store(local_copy, bl_val, BOOL)
    elif _is_heap_kind(kind):
        # string + every container kind: `have_val` carries the heap
        # object pointer (cssc_str* / cssc_vec_int* / cssc_map_* /
        # cssc_bind_*) in the i64 register. Reinterpret it as a ptr and
        # stash it in the ptr-typed local slot; the slot's storage kind
        # (all containers → 'ptr') makes downstream loads/method dispatch
        # see the right object.
        ptr_val = b.int_to_ptr(have_val)
        b.slot_store(local_copy, ptr_val, PTR)
    else:
        b.slot_store(local_copy, have_val, INT64)
    b.slot_store(ptr_holder, local_copy, PTR)
    b.br(have_end_blk)

    b.set_block(have_end_blk)
    b.br(end_blk)

    # ── miss: OOB — default expr, empty container, or zero. ─────────
    b.set_block(miss_blk)
    default = node.get('default')
    miss_local = b.slot_alloc(kind, 64)
    if default is not None:
        miss_val, miss_ty = _lower_expr(b, default, expected_kind=kind)
        _expected_llvm = {
            'int': 'i64', 'bool': 'i1', 'float': 'f64', 'string': 'ptr',
        }.get(kind, 'ptr' if kind in _CONTAINER_PARAM_KINDS else 'i64')
        if miss_ty.kind not in (_expected_llvm, 'i64', 'ptr', 'string_ptr',
                                'cssc_str_ptr', 'f32'):
            raise _csscerror(
                detail=f'#scanp default: kind {miss_ty.kind!r} cannot '
                       f'satisfy {kind} slot',
                line=line,
            )
        if kind == 'float':
            b.slot_store(miss_local, miss_val, FLOAT64)
        elif kind == 'bool':
            b.slot_store(miss_local, miss_val, BOOL)
        elif _is_heap_kind(kind):
            # string / container default: the value is (or must become) a
            # heap pointer stored in the ptr-typed local slot.
            pv = (miss_val
                  if miss_ty.kind in ('ptr', 'string_ptr', 'cssc_str_ptr')
                  else b.int_to_ptr(miss_val))
            b.slot_store(miss_local, pv, PTR)
        else:
            b.slot_store(miss_local, miss_val, INT64)
    elif kind in _CONTAINER_PARAM_KINDS:
        # OOB container arg → a fresh EMPTY container, never a null ptr,
        # so the body's `.push()` / iteration / indexing stay safe. This
        # mirrors the interpreter's empty-collection default for a
        # missing argument.
        _init_container_slot(b, miss_local, kind,
                             _empty_container_init_node(kind), 64, line)
    elif kind == 'float':
        b.slot_store(miss_local, b.const_float(0.0), FLOAT64)
    elif kind == 'bool':
        b.slot_store(miss_local, b.const_bool(False), BOOL)
    else:
        # int / string: unchanged — string missing → i64 0 (null cssc_str*,
        # read as 0x0), matching the pre-container behaviour.
        b.slot_store(miss_local, b.const_int(0), INT64)
    b.slot_store(ptr_holder, miss_local, PTR)
    b.br(end_blk)

    # ── end: load the active param-ptr; bind. ──────────────────────
    b.set_block(end_blk)
    param_ptr = b.slot_load(ptr_holder, 'string')   # 'string' kind → load ptr
    b.scope_bind(varname, param_ptr, kind)


# ---------------------------------------------------------------------------
# Expressions.
# ---------------------------------------------------------------------------
def _lower_expr(b: CIRBuilder, node: dict,
                expected_kind: Optional[str] = None) -> Tuple[int, CIRType]:
    """Lower an expression. Returns (SSA id, CIRType)."""
    t = node.get('type')
    line = node.get('line')

    if t == 'literal':
        value = node.get('value')
        if isinstance(value, bool):
            return b.const_bool(value), BOOL
        if isinstance(value, int):
            return b.const_int(value), INT64
        if isinstance(value, float):
            return b.const_float(value), FLOAT64
        raise _csscerror(detail=f'unsupported literal kind {type(value).__name__}',
                         line=line)

    if t == 'string':
        text = node.get('value', '')
        ptr = b.const_str(text)
        # String values flow as (ptr, length) pair; Phase 1 uses the ptr as
        # the SSA id and the LLVM emitter pulls the length from the global.
        return ptr, PTR

    if t == 'null':
        zero = b.const_int(0)
        return zero, INT64

    if t == 'identifier':
        name = node.get('name', '')
        # Compile-time constants from `#DEFINE name <expr>;` win over
        # runtime slots. The Python value is baked directly into the
        # IR as a const_int / const_float / const_str — no runtime
        # call, no slot read.
        if name in _CT_CONSTS:
            return _emit_ct_constant(b, _CT_CONSTS[name], line)
        if not b.scope_has(name):
            # Spec §5.4 bare-block fallback. The user referenced an
            # outer slot name from inside a `{ … }` without importing
            # it via `#req[outer] local;`. Per spec the outer name is
            # NOT in scope; rather than aborting the build, we emit a
            # one-shot warning and return a zero/null sentinel of the
            # outer slot's kind so the program keeps building. Writes
            # still error (no slot to store into); reads see 0/null.
            if _BARE_BLOCK_OUTER_SCOPES:
                outer_snapshot = _BARE_BLOCK_OUTER_SCOPES[-1]
                if name in outer_snapshot:
                    key = (line, name)
                    if key not in _BARE_BLOCK_WARN_SEEN:
                        _BARE_BLOCK_WARN_SEEN.add(key)
                        _csscwarn(
                            detail=(f'bare-block read of outer name '
                                    f'{name!r} without `#req[{name}] '
                                    f'<local>;` — value resolves to '
                                    f'0x0 per spec §5.4'),
                            line=line,
                            hint=(f'add `#req[{name}] {name};` at the '
                                  f'top of this block to import the '
                                  f'outer slot, or drop the reference'),
                        )
                    outer_kind = outer_snapshot[name]
                    if outer_kind == 'int':
                        return b.const_int(0), INT64
                    if outer_kind == 'bool':
                        return b.const_bool(False), BOOL
                    if outer_kind == 'float':
                        return b.const_float(0.0), FLOAT64
                    # All other kinds load as a ptr-typed value at the
                    # call site (string_ptr / ptr / etc.). The 0x0
                    # sentinel must be emitted with the correct LLVM
                    # type (`ptr null`) — not as a raw `i64 0`, which
                    # the LLVM verifier rejects against a ptr-typed
                    # call argument. `int_to_ptr` emits the explicit
                    # `inttoptr i64 0 to ptr` cast.
                    null_ptr = b.int_to_ptr(b.const_int(0))
                    if outer_kind == 'string':
                        return null_ptr, STRING_PTR
                    return null_ptr, PTR
            raise _csscerror(detail=f'undefined identifier {name!r}',
                             hint='declare it with #stack/#heap first, '
                                  'or bake at compile time with '
                                  '#DEFINE name <expr>;',
                             line=line)
        slot = b.scope_lookup(name)
        kind = b.scope_kind(name)
        loaded = b.slot_load(slot, kind)
        if kind == 'int':
            return loaded, INT64
        if kind == 'bool':
            return loaded, BOOL
        if kind == 'float':
            # Honor the slot's declared bit width — `#stack[float, 32]`
            # produces an f32 load that downstream arithmetic / outln
            # paths can keep narrow if they want the FPU on ESP32.
            slot_bits = b._slot_bits.get(slot, 64)   # noqa: SLF001
            return loaded, (FLOAT32 if slot_bits == 32 else FLOAT64)
        if kind == 'string':
            # STRING_PTR is a marker variant of `ptr` so cssc_outln picks
            # cssc_print_string (heap-aware) over cssc_print_str (raw ptr+len).
            return loaded, STRING_PTR
        # All other heap kinds (vector_*, array_*, map_si, bind_ss,
        # array_bind, object_handle, peripherals) load as a raw ptr —
        # matches `CIRBuilder._kind_to_load_type` so call-site type
        # checks against PTR succeed. Falling back to CSSCVAL here was
        # the bug that broke `vd.foo(bind_slot)` arg passing.
        if kind in _CONTAINER_PARAM_KINDS or kind in (
                    'object_handle',
                    'pin', 'i2c', 'spi', 'uart',
                    'adc', 'pwm', 'timer',
                    'tft', 'oled', 'video', 'matrix',
                    'framebuffer', 'console'):
            # Every container kind (incl. vector_string / vector_bool /
            # array_string / array_bool, previously missing here) plus
            # peripheral/object handles hold a raw heap ptr — load as PTR
            # so call-site / return type checks against PTR succeed.
            return loaded, PTR
        return loaded, CSSCVAL

    if t == 'binary':
        return _lower_binary(b, node)

    if t == 'unary':
        return _lower_unary(b, node)

    if t == 'logical':
        return _lower_logical(b, node)

    if t == 'copy_of':
        return _lower_copy_of(b, node)

    if t == 'ns_call':
        return _lower_ns_call_expr(b, node)

    if t == 'ns_access':
        return _lower_ns_access(b, node)

    if t == 'call':
        return _lower_call_expr(b, node)

    if t == 'arrow_access':
        # `Object->member` read. Resolution order:
        #   1. If the qualified name `Object->member` is in the current
        #      scope (set up by _bind_object_members / _bind_sector_members
        #      at function entry), use the bound slot directly.
        #   2. Otherwise resolve as a sector module global.
        obj_node = node.get('object', {})
        if obj_node.get('type') != 'identifier':
            raise _csscerror(
                detail='Phase 4d: arrow-access requires a simple object identifier',
                line=line,
            )
        obj_name = obj_node.get('name', '')
        key = node.get('key', '')
        qualified = f'{obj_name}->{key}'
        # Helper: pick the CIR type for a loaded value of `kind`,
        # widening floats based on the slot's declared bits. f32 slots
        # produce FLOAT32 values that downstream binary ops keep narrow.
        def _kind_ty_for(kind: str, slot_id: int = -1, bits_hint: int = 64):
            if kind == 'int':    return INT64
            if kind == 'bool':   return BOOL
            if kind == 'string': return STRING_PTR
            if kind == 'float':
                if slot_id >= 0:
                    bits = b._slot_bits.get(slot_id, bits_hint)   # noqa: SLF001
                else:
                    bits = bits_hint
                return FLOAT32 if bits == 32 else FLOAT64
            return CSSCVAL
        if b.scope_has(qualified):
            slot = b.scope_lookup(qualified)
            kind = b.scope_kind(qualified)
            loaded = b.slot_load(slot, kind)
            return loaded, _kind_ty_for(kind, slot_id=slot)
        # 3. Instance-handle arrow_access from outside the label body:
        #    `inst->member` where `inst` was created by `Object() inst;`.
        #    Load the instance ptr, GEP to the requested field, load the
        #    field's value, return it with the field's kind.
        if obj_name in _INSTANCES:
            obj_type = _INSTANCES[obj_name]
            obj_info = _OBJECTS.get(obj_type, {})
            slots = obj_info.get('slots', {})
            if key not in slots:
                raise _csscerror(
                    detail=f'{obj_name}->{key}: object {obj_type!r} has no '
                           f'member {key!r}',
                    hint=f'members: {sorted(slots.keys())}',
                    line=line,
                )
            if not b.scope_has(obj_name):
                raise _csscerror(
                    detail=f'instance handle {obj_name!r} is out of scope',
                    line=line,
                )
            handle = b.scope_lookup(obj_name)
            inst_ptr = b.slot_load(handle, 'object_handle')
            meta = slots[key]
            field_addr = b.member_addr(inst_ptr,
                                       obj_info['struct_ty'],
                                       meta['field_idx'])
            loaded = b.slot_load(field_addr, meta['kind'])
            # Object struct fields use a uniform-width layout (float
            # members live in 8-byte slots stored as `double`, regardless
            # of the user's declared bit-width — see
            # `_OBJECT_FIELD_STORAGE`). The load IR therefore emits
            # `load double`; report FLOAT64 to the caller so the rest of
            # the binary-expression dispatch sees a consistent type and
            # doesn't fcmp a `float` SSA against a `double` SSA.
            kind = meta['kind']
            if kind == 'float':
                return loaded, FLOAT64
            return loaded, _kind_ty_for(kind,
                                        bits_hint=meta.get('bits', 64))
        meta = _resolve_member_global(obj_name, key, line)
        if 'sym' not in meta:
            raise _csscerror(
                detail=f'{obj_name}->{key} is a per-instance object member; '
                       f'access from outside a label/free body is not allowed',
                hint='access object members from inside a label body, or '
                     'via `instance.method()` from user_main',
                line=line,
            )
        addr = b.global_addr(meta['sym'])
        loaded = b.slot_load(addr, meta['kind'])
        # Sector globals follow the same uniform layout — float-typed
        # sector members are stored as `double` regardless of declared
        # bits (see `_kind_to_storage_ty`). Keep the returned CIR type
        # in lockstep with the actual load so binary ops don't mismatch.
        kind = meta['kind']
        if kind == 'float':
            return loaded, FLOAT64
        return loaded, _kind_ty_for(kind,
                                    bits_hint=meta.get('bits', 64))

    if t == 'index':
        return _lower_index_read(b, node, expected_kind=expected_kind)

    if t == 'dot_call':
        return _lower_dot_call_expr(b, node)

    if t == 'method_call':
        # A.3.7: arrow-form method call `obj->method(args)`. In v6 native
        # all objects are heap-allocated so the dispatch surface is the
        # same as the dot form — adapt the AST and forward.
        return _lower_dot_call_expr(b, node)

    if t == 'member_ns_call':
        # A.3.7: `Sector::func(args)` — module-namespaced call resolved
        # via the sector's symbol table.
        return _lower_member_ns_call_expr(b, node)

    if t == 'dot_access':
        # A.3.8: `inst.field` mirrors `inst->field` in v6 (every object is
        # heap-allocated) — forward through the arrow_access path.
        return _lower_dot_access_as_arrow(b, node)

    # Container literals in expression position (bare arg of
    # `cssc::outln(…)` etc.) — the native backend doesn't yet have
    # a one-shot stringify for ad-hoc container expressions, so emit
    # a clear hint pointing at the slot-allocate-then-print pattern.
    if t in ('array', 'array_literal', 'map_literal', 'bind_literal'):
        raise _csscerror(
            detail=f'bare {t!r} in expression position not yet '
                   f'lowered natively',
            hint=('declare a slot first and print it: '
                   '`#stack[array<int>, 64] x = {1, 2}; '
                   'cssc::outln(x);` — or pass each element '
                   'individually: `cssc::outln(1); cssc::outln(2);`. '
                   'Container-aware print at expression position is '
                   'on the v6.1 native roadmap.'),
            line=line)
    raise _csscerror(detail=f'unsupported expression node {t!r}',
                     hint='Phase 2: literals, identifiers, binary, unary, '
                          'logical short-circuit, dot_call, method_call, '
                          'dot_access, member_ns_call',
                     line=line)


def _lower_dot_access_as_arrow(b: CIRBuilder, node: dict) -> Tuple[int, CIRType]:
    """A.3.8: adapt a `dot_access` AST node to the arrow_access dispatch.

    The parser emits the same `(object, key)` shape for both forms, so the
    only thing this helper does is rename the node type before forwarding.
    Done as a separate function so the dispatch is greppable.
    """
    adapted = dict(node)
    adapted['type'] = 'arrow_access'
    return _lower_expr(b, adapted)


# ---------------------------------------------------------------------------
# Phase 2: binary expression lowering.
# ---------------------------------------------------------------------------
_ARITH_OPS = frozenset(['+', '-', '*', '/', '%'])
_COMPARISON_OPS = frozenset(['==', '!=', '<', '>', '<=', '>='])


def _lower_binary(b: CIRBuilder, node: dict) -> Tuple[int, CIRType]:
    """Lower `{type:'binary', op, left, right}`.

    Supported operand combinations:
      * int  <op>  int   → i64 arithmetic / i1 comparison
      * float <op> float → f64 arithmetic / i1 comparison
      * string + string  → heap-allocated cssc_string_concat
      * string == string → cssc_string_eq (byte-equal)
      * string != string → not(cssc_string_eq)

    String literals on either side are materialised to heap cssc_str via
    `cssc_string_lit` so the runtime helpers can take a uniform pair of
    cssc_str pointers.
    """
    line = node.get('line')
    op = node.get('op', '')

    lhs_id, lhs_ty = _lower_expr(b, node['left'])
    rhs_id, rhs_ty = _lower_expr(b, node['right'])

    # ---- String-operand promotion ----
    # If either side carries a heap cssc_str (kind='string_ptr') and the
    # other is a raw literal ptr, materialise the literal via
    # cssc_string_lit so both inputs share the cssc_str layout.
    def _promote_string_lit(node_side, id_, ty_):
        if ty_.kind == 'ptr' and node_side.get('type') == 'string':
            text = node_side.get('value', '')
            return b.string_from_lit(text), STRING_PTR
        return id_, ty_

    # A raw string literal on either side counts as string-typed for
    # the concat dispatch — promote it eagerly so the auto-stringify
    # path sees a `string_ptr` operand and triggers correctly.
    if node['left'].get('type') == 'string' and lhs_ty.kind == 'ptr':
        lhs_id, lhs_ty = _promote_string_lit(node['left'], lhs_id, lhs_ty)
    if node['right'].get('type') == 'string' and rhs_ty.kind == 'ptr':
        rhs_id, rhs_ty = _promote_string_lit(node['right'], rhs_id, rhs_ty)

    # Phase 5b: null-pointer comparison for string_ptr vs literal 0 /
    # 0x0. Used by `select` over `array<string>` to test for entries
    # nulled by `#delmember[arr[i]]` (`if (letter == 0x0) break;`).
    # Resolved here BEFORE the string-stringify path, which would
    # otherwise convert the 0 to the literal string "0" and yield a
    # `cssc_string_eq` comparison — wrong semantic for the null check.
    # Convert both sides to raw `ptr` and route through the regular
    # ptr-equality branch (which bitcasts to i64 + emits an icmp eq).
    if op in ('==', '!=') and (
            (lhs_ty.kind == 'string_ptr' and rhs_ty.kind == 'i64')
            or (lhs_ty.kind == 'i64' and rhs_ty.kind == 'string_ptr')):
        if lhs_ty.kind == 'i64':
            lhs_id = b.call('__cssc_int_to_ptr', [lhs_id], [INT64],
                             return_type=PTR, external=True)
            lhs_ty = PTR
            # The other side is `string_ptr`; collapse to raw `ptr` so
            # the kinds match for the downstream ptr-eq path. The
            # underlying SSA already IS a ptr; this is just the CIRType
            # tag — no IR emitted.
            rhs_ty = PTR
        else:
            rhs_id = b.call('__cssc_int_to_ptr', [rhs_id], [INT64],
                             return_type=PTR, external=True)
            rhs_ty = PTR
            lhs_ty = PTR
        # Both sides are now `ptr`; fall through so the standard
        # `lhs_ty.kind == 'ptr'` arm (further down) handles the
        # actual comparison (bitcast to i64 + icmp eq/ne).

    is_string = (lhs_ty.kind == 'string_ptr') or (rhs_ty.kind == 'string_ptr')
    if is_string:
        lhs_id, lhs_ty = _promote_string_lit(node['left'], lhs_id, lhs_ty)
        rhs_id, rhs_ty = _promote_string_lit(node['right'], rhs_id, rhs_ty)
        # String + non-string operand → auto-stringify the non-string
        # side. Only valid for `+` (concat). The runtime exposes
        # `cssc_int_to_str` / `cssc_float_to_str` / `cssc_bool_to_str`
        # which return a fresh heap cssc_str caller owns.
        if op == '+':
            def _stringify(idv, tyv, side_node):
                if tyv.kind == 'i64':
                    return b.call('cssc_int_to_str', [idv], [INT64],
                                  return_type=STRING_PTR, external=True), STRING_PTR
                if tyv.kind == 'f32':
                    # Promote f32 → f64 via __extendsfdf2 so the runtime
                    # uses a single cssc_float_to_str symbol regardless
                    # of declared float precision.
                    promoted = b.call('__extendsfdf2', [idv], [FLOAT32],
                                       return_type=FLOAT64, external=True)
                    return b.call('cssc_float_to_str', [promoted], [FLOAT64],
                                  return_type=STRING_PTR, external=True), STRING_PTR
                if tyv.kind == 'f64':
                    return b.call('cssc_float_to_str', [idv], [FLOAT64],
                                  return_type=STRING_PTR, external=True), STRING_PTR
                if tyv.kind == 'i1':
                    return b.call('cssc_bool_to_str', [idv], [BOOL],
                                  return_type=STRING_PTR, external=True), STRING_PTR
                if tyv.kind == 'ptr':
                    # A container operand (`"x=" + vec`) lowered to a bare
                    # ptr — recover its kind and format `{e0, e1, …}` to
                    # match the interpreter's list stringify.
                    ck = _recover_container_kind(b, side_node)
                    if ck is not None:
                        return _emit_container_to_str(b, idv, ck, line)
                return idv, tyv
            if lhs_ty.kind != 'string_ptr':
                lhs_id, lhs_ty = _stringify(lhs_id, lhs_ty, node['left'])
            if rhs_ty.kind != 'string_ptr':
                rhs_id, rhs_ty = _stringify(rhs_id, rhs_ty, node['right'])
        if lhs_ty.kind == 'string_ptr' and rhs_ty.kind == 'string_ptr':
            if op == '+':
                # concat — caller owns the resulting heap cssc_str.
                # B4 note: a variadic `cssc_string_concat_n(parts, n)`
                # runtime is available (x86_64.py / xtensa_lx106.py)
                # but the CIR-side chain-detection lands separately.
                # To use it, the chain must be detected at the AST
                # level (BEFORE lowering operands, which already
                # emits intermediate concat calls). See
                # `_lower_string_concat_chain` (when added).
                result = b.call('cssc_string_concat', [lhs_id, rhs_id],
                                [PTR, PTR],
                                return_type=STRING_PTR, external=True)
                return result, STRING_PTR
            if op == '==':
                result = b.call('cssc_string_eq', [lhs_id, rhs_id],
                                [PTR, PTR],
                                return_type=BOOL, external=True)
                return result, BOOL
            if op == '!=':
                eq_id = b.call('cssc_string_eq', [lhs_id, rhs_id],
                               [PTR, PTR],
                               return_type=BOOL, external=True)
                return b.logical_not(eq_id), BOOL
            raise _csscerror(
                detail=f"string binary op {op!r} not supported "
                       f"(use '+', '==', '!=')",
                line=line,
            )
        # Promotion failed (e.g. ptr on one side that isn't a literal).
        raise _csscerror(
            detail=f'mixed-type binary op {op!r}: cannot pair '
                   f'{lhs_ty.kind!r} with {rhs_ty.kind!r}',
            line=line,
        )

    if {lhs_ty.kind, rhs_ty.kind} == {'f32', 'f64'}:
        if lhs_ty.kind == 'f32':
            lhs_id = b.call('__extendsfdf2', [lhs_id], [FLOAT32],
                            return_type=FLOAT64, external=True)
            lhs_ty = FLOAT64
        else:
            rhs_id = b.call('__extendsfdf2', [rhs_id], [FLOAT32],
                            return_type=FLOAT64, external=True)
            rhs_ty = FLOAT64

    if {lhs_ty.kind, rhs_ty.kind} & {'f64', 'f32'} and 'i64' in {lhs_ty.kind, rhs_ty.kind}:
        if lhs_ty.kind == 'i64':
            lhs_id = b.sitofp_to_double(lhs_id)
            lhs_ty = FLOAT64
            if rhs_ty.kind == 'f32':
                rhs_id = b.call('__extendsfdf2', [rhs_id], [FLOAT32],
                                return_type=FLOAT64, external=True)
                rhs_ty = FLOAT64
        else:
            rhs_id = b.sitofp_to_double(rhs_id)
            rhs_ty = FLOAT64
            if lhs_ty.kind == 'f32':
                lhs_id = b.call('__extendsfdf2', [lhs_id], [FLOAT32],
                                return_type=FLOAT64, external=True)
                lhs_ty = FLOAT64

    if lhs_ty.kind != rhs_ty.kind:
        # Null-pointer comparison: `ptr == 0` / `ptr != 0` / `ptr ==
        # 0x0`. Used for `if (entry == 0x0) break;` patterns in
        # `select` over array<bind> where wiped entries come through
        # as NULL. Cast the int side to ptr for the comparison.
        if op in ('==', '!=') and (
                (lhs_ty.kind in ('ptr', 'string_ptr')
                    and rhs_ty.kind == 'i64')
                or (lhs_ty.kind == 'i64'
                    and rhs_ty.kind in ('ptr', 'string_ptr'))):
            if lhs_ty.kind == 'i64':
                lhs_id = b.call('__cssc_int_to_ptr', [lhs_id], [INT64],
                                return_type=PTR, external=True)
                lhs_ty = PTR
            else:
                rhs_id = b.call('__cssc_int_to_ptr', [rhs_id], [INT64],
                                return_type=PTR, external=True)
                rhs_ty = PTR
        else:
            raise _csscerror(
                detail=f"mixed-type binary op {op!r} not supported "
                       f"({lhs_ty.kind} and {rhs_ty.kind})",
                hint='explicit conversion: cssc::float(x), cssc::int(y)',
                line=line,
            )

    if lhs_ty.kind == 'i64':
        if op in _ARITH_OPS:
            return b.bin_int(op, lhs_id, rhs_id), INT64
        if op in _COMPARISON_OPS:
            return b.cmp_int(op, lhs_id, rhs_id), BOOL
        raise _csscerror(detail=f"int binary op {op!r} not supported",
                         line=line)

    if lhs_ty.kind in ('f32', 'f64'):
        bits = 32 if lhs_ty.kind == 'f32' else 64
        result_ty = FLOAT32 if bits == 32 else FLOAT64
        if op in _ARITH_OPS:
            return b.bin_float(op, lhs_id, rhs_id, bits=bits), result_ty
        if op in _COMPARISON_OPS:
            return b.cmp_float(op, lhs_id, rhs_id, bits=bits), BOOL
        raise _csscerror(detail=f"float binary op {op!r} not supported",
                         line=line)

    if lhs_ty.kind == 'ptr':
        # Pointer-equality only — used for `entry == NULL` checks
        # after `#delmember[arr[i]]`. The runtime helper converts ptr
        # to i64 so the existing int-compare lowering applies.
        if op in ('==', '!='):
            lhs_int = b.call('__cssc_bitcast_ptr_i64', [lhs_id], [PTR],
                             return_type=INT64, external=True)
            rhs_int = b.call('__cssc_bitcast_ptr_i64', [rhs_id], [PTR],
                             return_type=INT64, external=True)
            return b.cmp_int(op, lhs_int, rhs_int), BOOL
        raise _csscerror(
            detail=f"ptr binary op {op!r} not supported (only ==/!=)",
            line=line,
        )

    raise _csscerror(
        detail=f"binary op {op!r} on {lhs_ty.kind} not supported",
        line=line,
    )


# ---------------------------------------------------------------------------
# Module loading: #include / #depend / #require.
#
# `_MODULES` is the registry of recognised CSSC stdlib modules. Each entry
# maps the on-disk module name (the string the user passes to `#include`)
# to a `_ModuleSpec` describing the namespace it injects and the set of
# `<ns>::<func>` symbols it provides. The lowerer registers the alias
# against the spec at `#include` time; ns-call dispatch later checks
# whether the requested function is in the module's provided set.
#
# `#depend['path.obj'] alias` and `#require['path.obj'] alias` are the
# build-system module forms (pre-compiled CSSC bundles and Arduino
# libraries respectively). Phase 5+ resolves the bundle file and merges
# its compiled symbols into the build; for now we register the alias and
# treat call attempts as resolved-at-link-time.
# ---------------------------------------------------------------------------
# Each spec is a plain dict — `provides` is the set of `<ns>::<func>`
# calls that resolve against this module, `ns` overrides the resolution
# namespace when not None (otherwise the alias chosen at `#include` time
# is used as the call-namespace).
_KNOWN_MODULES: Dict[str, dict] = {
    # CSSC stdlib core — every `cssc::*` builtin lives under this name.
    'cssc.math':  {'provides': {'sqrt', 'sin', 'cos', 'tan', 'pow',
                                'log', 'exp', 'floor', 'ceil', 'abs',
                                'min', 'max', 'random', 'random_int'},
                   'ns': 'cssc'},
    'cssc.sys':   {'provides': {'args', 'argc', 'arg', 'has_arg',
                                'arg_int', 'arg_float', 'arg_bool',
                                'exit', 'reboot', 'getenv'},
                   'ns': 'cssc'},
    'cssc.io':    {'provides': {'read', 'write', 'exists', 'mkdir'},
                   'ns': 'cssc'},
    'cssc.env':   {'provides': {'getenv', 'setenv'}, 'ns': 'cssc'},
    'cssc.paths': {'provides': {'join', 'dirname', 'basename',
                                'absolute', 'extension'}, 'ns': 'cssc'},
    'cssc.binary':{'provides': {'read_file', 'write_file'}, 'ns': 'cssc'},
    'cssc.peek':  {'provides': set(), 'ns': 'cssc'},
    'cssc.dll':   {'provides': {'load', 'call'}, 'ns': 'cssc'},
    'cssc.ini':   {'provides': {'load', 'save', 'get', 'set',
                                  'read', 'write', 'has_key',
                                  'delete', 'exists'},
                   'ns': None},
    'cssc.fastif':{'provides': set(), 'ns': 'cssc'},

    # Built-in modules with their own namespaces — the user picks the
    # alias name in the `#include('mod') alias;` form.
    'os':         {'provides': {'time', 'getenv', 'exec', 'exit',
                                'platform', 'pid'}, 'ns': None},
    'sys':        {'provides': {'argc', 'arg', 'has_arg', 'args',
                                'arg_int', 'arg_float', 'arg_bool'},
                   'ns': None},
    'sys.console':{'provides': {'sync', 'desync'}, 'ns': 'console'},
    'console':    {'provides': {'sync', 'desync'}, 'ns': 'console'},
    'stdio':      {'provides': {'open', 'close', 'read', 'write'},
                   'ns': None},
    'sizes':      {'provides': set(), 'ns': None},
    'def':        {'provides': set(), 'ns': None},
    'cssl':       {'provides': set(), 'ns': None},
    'matrix':     {'provides': set(), 'ns': None},
    'math.accel': {'provides': {
                        'fade', 'lerpf', 'clampf', 'smoothstep', 'smootherstep',
                        'floorf', 'floori', 'ceilf', 'roundf', 'absf',
                        'sqrtf', 'sinf', 'cosf', 'tanf', 'atan2f',
                        'powf', 'expf', 'logf', 'minf', 'maxf',
                        'hash2', 'hash3', 'hash4', 'hashUnit', 'hashUnit3',
                        'valueNoise2', 'fbm2', 'perlin2', 'perlinFbm2',
                        'fbm2_grid', 'perlinFbm2_grid',
                        'worldgen_tile_at', 'worldgen_tile_grid',
                        'worldgen_is_solid_at', 'worldgen_collide_aabb',
                        'lerp_array', 'clamp_array',
                        'threshold_array', 'distance_array', 'available',
                   },
                   'ns': None},
    'mathaccel':  {'provides': set(),  'ns': None, 'alias_of': 'math.accel'},
    'accel.math': {'provides': set(),  'ns': None, 'alias_of': 'math.accel'},
    'video':      {'provides': {'open', 'begin', 'close',
                                  'clear', 'present',
                                  'isOpen', 'is_open',
                                  'pixel', 'getPixel', 'get_pixel',
                                  'hwnd',
                                  'fillrect', 'fill_rect',
                                  'drawRect', 'draw_rect',
                                  'darken',
                                  'drawText', 'draw_text'},
                    'ns': None},
    'video.sprite':  {'provides': {'create', 'new', 'load',
                                    'width', 'height',
                                    'setPixel', 'set_pixel',
                                    'getPixel', 'get_pixel',
                                    'draw',
                                    'drawScaled', 'draw_scaled',
                                    'drawTinted', 'draw_tinted',
                                    'drawAlpha',  'draw_alpha',
                                    'sheetLoadBmp', 'sheet_load_bmp',
                                    'sheetDrawFrame', 'sheet_draw_frame',
                                    'sheetFree',
                                    'free'},
                        'ns': None},
    'video.tilemap': {'provides': {'create', 'new', 'setTile', 'set_tile',
                                    'set', 'get', 'cols', 'rows',
                                    'draw', 'free',
                                    'tilesetLoadBmp', 'tileset_load_bmp',
                                    'createFromTileset', 'create_from_tileset',
                                    'cameraCreate', 'camera_create',
                                    'cameraSetBounds', 'camera_set_bounds',
                                    'cameraFollow', 'camera_follow',
                                    'cameraX', 'camera_x',
                                    'cameraY', 'camera_y',
                                    'drawCam', 'draw_cam'},
                        'ns': None},
    'video.font':    {'provides': {'create', 'new', 'load', 'builtin',
                                    'height', 'measure', 'draw', 'free'},
                        'ns': None},
    'keyboard':   {'provides': {'create', 'new', 'update', 'free',
                                 'isPressed', 'is_pressed',
                                 'isDown',    'is_down',
                                 'isReleased','is_released',
                                 'getKey',    'get_key'},
                    'ns': None},
    'mouse':      {'provides': {'create', 'new', 'update', 'free',
                                 'getX', 'get_x', 'getY', 'get_y',
                                 'getPos', 'get_pos',
                                 'isClicked', 'is_clicked',
                                 'isHeld',    'is_held',
                                 'isReleased','is_released',
                                 'isOver',    'is_over',
                                 'client', 'attach',
                                 'sync', 'clamp',
                                 'clampX', 'clampY'},
                    'ns': None},
    'sound':      {'provides': {'create', 'new', 'load', 'play',
                                 'stop', 'stopAll', 'stop_all',
                                 'setVolume', 'set_volume',
                                 'isPlaying', 'is_playing', 'free',
                                 'loop', 'pause', 'resume'},
                    'ns': None},
    'asyncthreads':       {'provides': set(), 'ns': None},
    'serialcommunication':{'provides': set(), 'ns': None},
    'openai':     {'provides': set(), 'ns': None},
    'retrogadgets':       {'provides': set(), 'ns': None},
    'devdebug':   {'provides': {'push', 'stdout'}, 'ns': None},
    'dev':        {'provides': {'stdout'}, 'ns': None, 'alias_of': 'devdebug'},
    'stdgrace':   {'provides': set(), 'ns': None},
    'gipeo':      {'provides': set(), 'ns': None},
    'allocwatcher':       {'provides': set(), 'ns': None},
    'tft':        {'provides': set(), 'ns': None},
    'network.http':       {'provides': set(), 'ns': None},
    'cssc.sidepackagetools': {'provides': set(), 'ns': None},
}

# Runtime registry per CSSC compilation — tracks which modules have been
# imported and under what alias. Reset at the start of every `lower()`
# call alongside _SECTORS / _OBJECTS.
_INCLUDED_MODULES: Dict[str, dict] = {}


def _lower_include(b: CIRBuilder, node: dict) -> None:
    """`#include('mod_name') alias;` — bind `alias` to the module spec
    so subsequent `alias::func()` calls resolve against the recognised
    provider set."""
    line = node.get('line')
    mod = node.get('module', '')
    alias = node.get('var', '') or mod
    if mod not in _KNOWN_MODULES:
        raise _csscerror(
            detail=f"#include('{mod}'): module not recognised by the v6 "
                   f"native backend",
            hint=f'recognised modules: {sorted(_KNOWN_MODULES.keys())}',
            line=line,
        )
    spec = _KNOWN_MODULES[mod]
    _INCLUDED_MODULES[alias] = dict(spec, module=mod, alias=alias)


_LOADED_FILES: Dict[str, str] = {}


def _lower_load(b: CIRBuilder, node: dict) -> None:
    """`#load['path/to/file.cssc'] alias;` — compile-time module bundling.

    Static equivalent to the interpreter's runtime dynamic-load: the referenced
    file is parsed at build time and its top-level declarations are wrapped in
    a synthetic `sector <alias> { … }` and lowered. `alias::method(...)` calls
    in the parent then resolve through the standard sector-namespace machinery.

    Semantic differences from the interpreter:
      * The load is resolved at COMPILE time, not runtime. Paths must be
        available at build time (they usually are — game modules are sibling
        `.cssc` files).
      * Top-level EXECUTABLE statements inside the loaded file are lowered too,
        so any side-effecting `cssc::outln("loading…");` runs when the parent's
        module-init sequence reaches the sector's globals. To avoid this, put
        the loaded file's top-level in `#define` bodies or sectors.
      * `#unload` becomes a compile-time no-op (there's no runtime handle to
        release; the alias is unbound in the local lowering-registry).

    Circular loads are detected by canonicalised path; a file is only lowered
    once per compilation, subsequent loads reuse the same alias registration.
    """
    line = node.get('line')
    load_path = (node.get('load_path')
                 or node.get('arg')
                 or '').strip().strip('"').strip("'")
    alias = (node.get('var') or '').strip()
    if not alias:
        raise _csscerror(
            detail='#load requires an alias name',
            hint='Usage: #load[\'path/to/file.cssc\'] aliasname;',
            line=line,
        )
    if not load_path:
        raise _csscerror(
            detail='#load requires a file path in [\'…\']',
            hint='Usage: #load[\'path/to/file.cssc\'] aliasname;',
            line=line,
        )

    import os as _os
    mod = getattr(b, 'module', None)
    src_file = getattr(mod, 'source_filename', None) if mod else None
    base_dir = _os.path.dirname(_os.path.abspath(src_file)) if src_file else _os.getcwd()

    if _os.path.isabs(load_path):
        resolved = load_path
    else:
        resolved = _os.path.join(base_dir, load_path)
    resolved = _os.path.normpath(_os.path.abspath(resolved))

    if not _os.path.isfile(resolved):
        raise _csscerror(
            detail=f'#load: file not found: {load_path}',
            hint=f'Resolved path: {resolved}',
            line=line,
        )

    if resolved in _LOADED_FILES:
        prev_alias = _LOADED_FILES[resolved]
        if alias == prev_alias:
            return
        _INCLUDED_MODULES[alias] = dict(_INCLUDED_MODULES.get(prev_alias, {}))
        _INCLUDED_MODULES[alias]['alias'] = alias
        _INCLUDED_MODULES[alias]['ns'] = alias
        return

    from ...cssl_cssc import CsscLexer, CsscParser, CsscError
    try:
        with open(resolved, 'r', encoding='utf-8') as _f:
            code = _f.read()
    except OSError as _e:
        raise _csscerror(
            detail=f'#load: cannot read {resolved}: {_e}',
            line=line,
        )
    try:
        tokens = CsscLexer(code, str(resolved)).tokenize()
        loaded_ast = CsscParser(tokens, str(resolved)).parse(strict_literals=True)
    except CsscError as _pe:
        raise _csscerror(
            detail=f'#load: parse error in {resolved}: {_pe}',
            hint=f'Fix the syntax in the loaded file first.',
            line=line,
        )

    _LOADED_FILES[resolved] = alias

    _INCLUDED_MODULES[alias] = {
        'module':   resolved,
        'alias':    alias,
        'kind':     'load',
        'transparent': True,
        'provides': set(),
        'ns':       alias,
        'bundle_path': resolved,
    }

    for _nm in _collect_req_targets(loaded_ast):
        _PROMOTED_GLOBALS.setdefault(
            _nm, {'sym': f'cssc_g_{_nm}', 'kind': '', 'bits': 0})

    from ...cssl_cssc import CsscError as _CsscError
    _LOWER_ACTIVE_FILE.append(resolved)
    try:
        for _stmt in loaded_ast:
            _lower_stmt(b, _stmt)
    except _CsscError:
        raise
    except Exception as _err:
        raise _csscerror(
            detail=f'#load: lowering of {resolved} failed: {_err}',
            hint=(f"The loaded file is compiled as if it were included "
                  f"at top-level; `{alias}::name(...)` calls resolve to "
                  f"its top-level `#define`/`#cdefine` bodies, and "
                  f"`{alias}::var` reads its promoted globals. Top-level "
                  f"names collide across modules — pick unique names."),
            line=line,
        )
    finally:
        if _LOWER_ACTIVE_FILE and _LOWER_ACTIVE_FILE[-1] == resolved:
            _LOWER_ACTIVE_FILE.pop()


def _lower_unload(b: CIRBuilder, node: dict) -> None:
    """`#unload[alias];` — v6 native compile-time no-op.

    The interpreter unbinds the runtime module handle here. With compile-time
    bundling there's no runtime handle to release; the loaded declarations are
    already inlined. Silently drop the alias from `_INCLUDED_MODULES` so any
    subsequent `alias::x` in the same compile unit surfaces as unknown-namespace
    (matches the interpreter's behaviour of losing access after unload).
    """
    alias = (node.get('arg') or node.get('var') or '').strip()
    if alias and alias in _INCLUDED_MODULES:
        _INCLUDED_MODULES.pop(alias, None)


def _lower_depend(b: CIRBuilder, node: dict) -> None:
    """`#depend['path.obj'] alias;` — pre-compiled CSSC bundle.

    The .obj is produced by `cssc build src.cssc --obj [--esp8266 |
    --esp32 | --arduino]` (or its older alias `cssc install`). For
    v6 native we:

      1. Register the alias in `_INCLUDED_MODULES` so the rest of
         the lowering pass resolves `alias::*` qualifications.
      2. Record the bundle path on the CIR module's external-deps
         list so the build orchestrator (v6_driver) can hand them
         to clang/lld at link time. The link integration unpacks
         the .obj container, retrieves the embedded ELF / object
         bytes for the active target, and emits them as additional
         linker inputs.

    Accepts any of: `depend_path` (the parser's canonical key),
    `arg`, or `module` — older AST shapes used the latter two.
    Surfaces a clear error on missing alias OR bundle path so the
    user knows which detail to add.
    """
    line = node.get('line')
    bundle = (node.get('depend_path')
              or node.get('arg')
              or node.get('module')
              or '').strip()
    alias = (node.get('var') or '').strip()
    if not alias:
        raise _csscerror(
            detail='#depend requires an alias name',
            hint='Usage: #depend[\'path/to/X.obj\'] aliasname;',
            line=line,
        )
    if not bundle:
        raise _csscerror(
            detail='#depend requires a bundle path in [\'…\']',
            hint='Usage: #depend[\'path/to/X.obj\'] aliasname;',
            line=line,
        )
    _INCLUDED_MODULES[alias] = {
        'module':   bundle,
        'alias':    alias,
        'kind':     'depend',
        # `provides` is filled in once the linker indexes the .obj's
        # exported symbol table; until then any user-side reference
        # to `alias::sym` succeeds at lower time, and the link step
        # surfaces an "undefined reference" if the bundle doesn't
        # actually provide it.
        'provides': set(),
        'ns':       alias,
        'bundle_path': bundle,
    }
    # Stash the dep on the CIR module so v6_driver picks it up at
    # link time. The orchestrator iterates module.deps and feeds
    # each bundle into the appropriate per-target unpacker
    # (host: DLL load on demand; ESP/AVR: extract embedded .o and
    # add as a linker input).
    mod = getattr(b, 'module', None)
    if mod is not None:
        deps = getattr(mod, 'deps', None)
        if deps is None:
            try:
                mod.deps = []
                deps = mod.deps
            except Exception:
                deps = None
        if deps is not None:
            deps.append({
                'kind':  'depend',
                'alias': alias,
                'path':  bundle,
            })


def _lower_require(b: CIRBuilder, node: dict) -> None:
    """`#require['lib.obj'] alias;` — Arduino-library bundle. Same
    treatment as #depend in v6 native: register alias, defer link
    integration to the build system."""
    return _lower_depend(b, node)


def _lower_private_scope(b: CIRBuilder, node: dict) -> None:
    """Bare `{ … }` blocks — an isolated CSSC scope.

    Per spec (Doc §5.4) bare blocks open a fresh variable frame: slots
    declared inside are released at `}` AND outer slot names are NOT
    implicitly visible — they must be re-imported via `#req[outer] x;`
    inside the block. Module-level names (function `#define`s,
    `#DEFINE` constants, sector members reached through `Sec::name`,
    namespace constants like `cssc::PI`) remain visible because they
    don't live in the per-function slot table; only local slot bindings
    are masked.

    Implementation: snapshot the outer slot map on entry, CLEAR it so
    the body sees an empty local scope, lower the body (where `#req`
    re-binds anything that's needed), then on exit release any new
    locals and restore the outer slot map.
    """
    saved_slots = dict(b._slots)            # noqa: SLF001
    saved_kinds = dict(b._slot_kinds)       # noqa: SLF001
    # Spec §5.4 — block opens a fresh frame. Strip outer slot bindings
    # so reads of `outer` from inside the block resolve via the
    # bare-block fallback path (warning + 0x0 sentinel) rather than
    # silently leaking the outer slot. `#req[outer] x;` is the
    # explicit import path that rebinds an outer name into the local
    # frame as a proper alias.
    b._slots = {}                            # noqa: SLF001
    b._slot_kinds = {}                       # noqa: SLF001
    # Push the outer scope snapshot so identifier resolution can see
    # which names were shadowed by the block entry (for the warning
    # + null-sentinel fallback). Stored as (name -> kind) only — the
    # outer slot's SSA id is intentionally NOT carried in: the spec
    # says the outer slot is not in scope, so the body must not be
    # able to read or write its value.
    _BARE_BLOCK_OUTER_SCOPES.append(dict(saved_kinds))
    try:
        for stmt in node.get('body', []) or []:
            _lower_stmt(b, stmt)
    finally:
        # Collect everything the block declared / `#req`-imported so
        # we can release locally-owned heap slots. `#req` bindings
        # alias the outer global ptr; releasing them via slot_release
        # against the saved-snapshot would double-free. So we restrict
        # the auto-release to slot ids that were freshly allocated
        # inside the block — ids the outer scope never owned.
        outer_slot_ids = set(saved_slots.values())
        new_locals = [(name, kind)
                      for name, kind in b._slot_kinds.items()   # noqa: SLF001
                      if b._slots.get(name) not in outer_slot_ids]   # noqa: SLF001
        # A.3.15: if the body already terminated the block (return /
        # panic / unreachable inside the scope), skip the trailing
        # release ops — appending them past a terminator produces
        # invalid IR (LLVM verifier rejects "instruction after
        # terminator"). The block-level release of slots inside that
        # path is the caller's job (the Ret-handling emit is what
        # closes the frame).
        if not _current_block_terminates(b):
            for name, kind in new_locals:
                slot = b._slots.get(name)                        # noqa: SLF001
                if slot is None:
                    continue
                b.slot_release(slot, kind)
        b._slots = saved_slots                                    # noqa: SLF001
        b._slot_kinds = saved_kinds                               # noqa: SLF001
        _BARE_BLOCK_OUTER_SCOPES.pop()


# ---------------------------------------------------------------------------
# Namespaced constants — `tft::WHITE`, `gipeo::OUTPUT`, etc. The legacy
# C-codegen folds these at codegen-time to keep the runtime symbol set
# minimal; the v6 native backend mirrors that by emitting a const_int
# directly. Keep this table in sync with [cssc_compiler.py:_ns_consts]
# so the two pipelines produce identical color codes for the same
# source.
# ---------------------------------------------------------------------------
_NS_CONSTS: Dict[Tuple[str, str], int] = {
    # tft (also used by oled, which is an SSD1306-typed alias for #tft).
    ('tft', 'BLACK'):   0x0000,
    ('tft', 'WHITE'):   0xFFFF,
    ('tft', 'RED'):     0xF800,
    ('tft', 'GREEN'):   0x07E0,
    ('tft', 'BLUE'):    0x001F,
    ('tft', 'CYAN'):    0x07FF,
    ('tft', 'MAGENTA'): 0xF81F,
    ('tft', 'YELLOW'):  0xFFE0,
    # gipeo pin modes + edge specifiers.
    ('gipeo', 'INPUT'):          0,
    ('gipeo', 'OUTPUT'):         1,
    ('gipeo', 'INPUT_PULLUP'):   2,
    ('gipeo', 'INPUT_PULLDOWN'): 3,
    ('gipeo', 'LOW'):  0,
    ('gipeo', 'HIGH'): 1,
    ('gipeo', 'RISING'):  1,
    ('gipeo', 'FALLING'): 2,
    ('gipeo', 'CHANGE'):  3,
}

# A.3.16: float-typed namespace constants. Resolved by _lower_ns_access via
# a separate lookup so the int-bias of `_NS_CONSTS` doesn't accidentally
# truncate PI / E / TAU to integer zero.
_NS_FLOAT_CONSTS: Dict[Tuple[str, str], float] = {
    ('cssc', 'PI'):       3.141592653589793,
    ('cssc', 'TAU'):      6.283185307179586,
    ('cssc', 'E'):        2.718281828459045,
    ('cssc', 'SQRT2'):    1.4142135623730951,
    ('cssc', 'LN2'):      0.6931471805599453,
    ('cssc', 'LN10'):     2.302585092994046,
    ('cssc', 'EPSILON'):  2.220446049250313e-16,
    ('cssc', 'INFINITY'): float('inf'),
}


def _lower_ns_access(b: CIRBuilder, node: dict) -> Tuple[int, CIRType]:
    """Lower `tft::WHITE`, `gipeo::OUTPUT`, `cssc::PI`, etc. — namespace-
    scoped constants that compile to a plain integer or float literal.

    Phase C.1: also handles multi-segment chains like
    `OuterSec::InnerSec::value`. The parser emits these as nested
    `ns_access` nodes where the `namespace` field of the outer node
    is itself a `ns_access` dict. We collapse the chain into a flat
    list of segments (e.g. ['OuterSec', 'InnerSec', 'value']), then
    walk it: each segment but the last resolves to a sector, and the
    final segment is the member read off the inner-most sector.

    For unknown (namespace, member) pairs we surface a clear error so
    typos don't silently become `0`. The legacy pipeline allowed
    arbitrary lookups via sector-get; the v6 native backend keeps the
    runtime symbol set minimal by folding known constants here and
    rejecting unknowns at compile time.
    """
    line = node.get('line')

    # Collapse a possibly-nested ns_access chain into a flat segment list.
    # The parser uses TWO field names depending on the LHS shape:
    #   * Leaf:    `{type:'ns_access', namespace: 'Outer', member: 'X'}`
    #              — used when LHS is a bare identifier.
    #   * Nested:  `{type:'ns_access', namespace_expr: <inner_node>,
    #                member: 'X'}` — used when LHS is an expression
    #              (e.g. another ns_access from a prior `::` step).
    # We walk both forms.
    def _flatten_chain(n: dict) -> List[str]:
        segs: List[str] = []
        cur = n
        while isinstance(cur, dict) and cur.get('type') == 'ns_access':
            segs.append(cur.get('member', ''))
            # Prefer the nested form if present; fall through to leaf.
            if 'namespace_expr' in cur:
                cur = cur.get('namespace_expr')
            else:
                cur = cur.get('namespace', '')
        # `cur` is now the head — either a string (leaf-namespace name)
        # or an identifier wrapper. Anything else short-circuits with the
        # segments we collected so the outer error handler still fires
        # with a useful message.
        if isinstance(cur, str):
            segs.append(cur)
        elif isinstance(cur, dict) and cur.get('type') == 'identifier':
            segs.append(cur.get('name', ''))
        segs.reverse()
        return [s for s in segs if s]

    chain = _flatten_chain(node)
    if len(chain) > 2:
        # Multi-segment chain — walk every-but-last as sector hops.
        # The last segment is the leaf member.
        leaf_member = chain[-1]
        # The directly-owning sector is the second-to-last segment.
        # We don't currently model "sector inside sector" as a true
        # nesting at lookup time — every sector is registered at module
        # scope in `_SECTORS`. So an `A::B::value` lookup means
        # "find sector B (declared inside A or at module level), then
        # read its `value` slot". The intermediate `A` is essentially
        # advisory in v6 — we just verify each step resolves to a
        # registered sector so typos error cleanly.
        for seg in chain[:-2]:
            if seg not in _SECTORS:
                raise _csscerror(
                    detail=f"{seg!r} is not a declared sector in chain "
                           f"{'::'.join(chain)}",
                    hint=f"known sectors: {sorted(_SECTORS.keys())}",
                    line=line,
                )
        ns = chain[-2]
        mem = leaf_member
    else:
        ns = chain[0] if chain else node.get('namespace', '')
        mem = node.get('member', '')
    # Phase 5b: namespace alias resolution. `#include('tft') tftlib;`
    # registers `tftlib` in _INCLUDED_MODULES as an alias for the
    # module 'tft'. The constants table is keyed by the raw module
    # name, so `tftlib::BLUE` won't match unless we resolve the alias
    # first. caro.cssc uses this pattern; without it `tftlib::BLUE`
    # would surface as "not a known namespace constant".
    inc_meta = _INCLUDED_MODULES.get(ns)
    resolved_ns = ns
    if inc_meta is not None:
        canonical = inc_meta.get('module') or ns
        if canonical and canonical != ns:
            resolved_ns = canonical
    fval = _NS_FLOAT_CONSTS.get((resolved_ns, mem))
    if fval is not None:
        return b.const_float(fval), FLOAT64
    val = _NS_CONSTS.get((resolved_ns, mem))
    if val is not None:
        return b.const_int(val), INT64
    # Fall back to the raw namespace name in case the alias resolution
    # widened too eagerly (e.g. user re-uses a real module name as a
    # sector). Keeps prior behaviour for the canonical-name case.
    if resolved_ns != ns:
        fval = _NS_FLOAT_CONSTS.get((ns, mem))
        if fval is not None:
            return b.const_float(fval), FLOAT64
        val = _NS_CONSTS.get((ns, mem))
        if val is not None:
            return b.const_int(val), INT64
    # User sector member access: `Greeter::greetings` resolves against
    # the sector's slot dict registered by `_register_sector_member`.
    # Loads the member's value from the module global. Private members
    # read as `0x0` per Spec §6.2.
    sec_info = _SECTORS.get(ns)
    if sec_info is not None:
        slots = sec_info.get('slots') or {}
        meta = slots.get(mem)
        if meta is not None:
            sym = meta['sym']
            kind = meta['kind']
            g_addr = b.global_addr(sym)
            v_id = b.slot_load(g_addr, kind)
            v_ty = {'int': INT64, 'bool': BOOL,
                     'float': FLOAT64}.get(kind, INT64)
            return v_id, v_ty
        # Member not found in this sector — fall through to error.
        known_members = sorted(slots.keys())
        raise _csscerror(
            detail=f'{ns}::{mem} is not a member of sector {ns!r}',
            hint=f'known members: {known_members}',
            line=line,
        )
    # Nullary-call fallback: `<ns>::<mem>` used as a value where the
    # runtime dispatch table exposes a no-arg expression call for that
    # pair — e.g. `dev::stdout` reads the current live devdebug log by
    # calling `cssc_devdebug_stdout()`. Applies to both the original
    # namespace and its resolved canonical form.
    for _try_ns in (ns, resolved_ns):
        _spec = _NS_CALL_RUNTIME.get((_try_ns, mem))
        if (_spec is not None
                and _spec.position in ('expr', 'both')
                and len(_spec.arg_types) == 0
                and _spec.trailing_optional == 0):
            rid = b.call(_spec.symbol, [], [],
                         return_type=_spec.ret_type, external=True)
            return rid, _spec.ret_type

    lookup_ns = resolved_ns
    known_int = sorted(m for (n, m) in _NS_CONSTS if n == lookup_ns)
    known_float = sorted(m for (n, m) in _NS_FLOAT_CONSTS if n == lookup_ns)
    all_known = sorted(set(known_int) | set(known_float))
    alias_note = ''
    if lookup_ns != ns:
        alias_note = f' (alias {ns!r} → module {lookup_ns!r})'
    raise _csscerror(
        detail=f'{ns}::{mem} is not a known namespace constant{alias_note}',
        hint=f'known {lookup_ns}:: members: {all_known}',
        line=line,
    )


def _promote_to_f64(b: CIRBuilder, val_id: int, val_ty: CIRType) -> int:
    """Promote an int / f32 SSA value to f64. f64 passes through
    unchanged. Used by the inlined lerp / clamp / distance builtins
    (perf-opt #8) to reach a canonical operand precision without a
    scattered `if val_ty.kind == …` per composition step.
    """
    if val_ty.kind == 'f64':
        return val_id
    if val_ty.kind == 'f32':
        return b.call('__extendsfdf2', [val_id], [FLOAT32],
                      return_type=FLOAT64, external=True)
    if val_ty.kind == 'i64':
        return b.call('__floatsidf', [val_id], [INT64],
                      return_type=FLOAT64, external=True)
    if val_ty.kind == 'i1':
        # Promote bool to i64 first, then to f64.
        zero = b.const_int(0)
        as_int = b.bin_int('+', zero, val_id)
        return b.call('__floatsidf', [as_int], [INT64],
                      return_type=FLOAT64, external=True)
    raise ValueError(
        f'_promote_to_f64: unsupported source kind {val_ty.kind!r}'
    )


def _lower_ns_call_expr(b: CIRBuilder, node: dict) -> Tuple[int, CIRType]:
    """Lower `cssc::<func>(args)` as a value-producing expression.

    Wires the CSSC builtin namespace (Doc §12) that produces a usable
    value — `cssc::abs`, `cssc::min`, `cssc::max`, `cssc::to_int`,
    `cssc::to_string` so far. Void / side-effect builtins (outln, out,
    sleep, …) still route through `_lower_ns_call` from a statement
    context.
    """
    line = node.get('line')
    ns = node.get('namespace', '')
    func = node.get('func', '')
    args = node.get('args', []) or []

    # Sector isolation — same rule as the statement path, before resolution.
    _check_sector_isolation(ns, func, line)

    _alias_meta = _INCLUDED_MODULES.get(ns)
    if _alias_meta is not None and _alias_meta.get('transparent'):
        if func in _DEFINES:
            return _lower_call_expr(b, {
                'type': 'call', 'name': func, 'args': args, 'line': line,
            })

    if ns in _SECTORS:
        qualified = f'{ns}::{func}'
        if qualified in _DEFINES:
            return _lower_call_expr(b, {
                'type': 'call', 'name': qualified,
                'args': args, 'line': line,
            })

    if ns != 'cssc':
        # Game-namespace dispatch — try the (sprite/tm/font/keyboard/
        # mouse/sound) runtime table before falling through to
        # depend/legacy handling. Returns None if the pair isn't in the
        # table, so non-game aliases keep the depend-diagnostic path.
        dispatched = _dispatch_ns_call_runtime(
            b, ns, func, args, line, context='expr',
        )
        if dispatched is not None:
            return dispatched

        # Honest diagnostic for depend-aliased cross-bundle calls.
        # `#depend['…obj'] alias;` currently only REGISTERS the alias;
        # the link-time integration (extract bundle's .o for the active
        # target, feed to clang/lld, agree on a symbol-mangling
        # convention) is a separate multi-step feature that v6_driver
        # doesn't yet drive. Emitting an external call with a guessed
        # mangling here would only push the error to link time where
        # the diagnostic is far worse ("undefined reference to
        # cssc_dep_sprite_CharSprite — possibly a typo?"), so refuse
        # cleanly with a pointer at the actionable workaround.
        inc_meta = _INCLUDED_MODULES.get(ns)
        if (inc_meta is not None
                and inc_meta.get('kind') in ('depend', 'require')):
            raise _csscerror(
                detail=(f"`{ns}::{func}(...)` — `{ns}` is a `#depend` "
                        f"alias, but cross-bundle calls aren't yet "
                        f"wired into the v6 native link path."),
                hint=(
                    f"The .obj bundle is built and registered, but the "
                    f"build orchestrator doesn't yet extract its "
                    f"target-specific object code and feed it to the "
                    f"linker. Until that lands, use the legacy "
                    f"`cssc build … --gcc --esp8266` path (which "
                    f"resolves bundles via the PlatformIO project), "
                    f"or inline the depended-on code directly."),
                line=line,
            )
        raise _csscerror(
            detail=f'{ns}::{func} not yet supported as a sub-expression '
                   f'in v6 native',
            line=line,
        )

    # CCOS freestanding value-intrinsics (`cssc::inb`, `peek*`, `readCr*`,
    # `rdmsr`, `rdtsc`, and the Limine `fb*`/`hhdmOffset`/`memmap*`
    # accessors) are table-driven — consult the shared runtime dispatch
    # before the hardcoded builtin chain. Returns None for every
    # non-intrinsic cssc builtin (abs/min/max/to_int/…), so their
    # dedicated handling below is unaffected.
    _intrin = _dispatch_ns_call_runtime(b, ns, func, args, line, context='expr')
    if _intrin is not None:
        return _intrin

    if func == 'abs':
        if len(args) != 1:
            raise _csscerror(detail='cssc::abs(x) expects 1 argument',
                             line=line)
        v_id, v_ty = _lower_expr(b, args[0])
        if v_ty.kind == 'i64':
            zero = b.const_int(0)
            neg = b.bin_int('-', zero, v_id)
            cond = b.cmp_int('<', v_id, zero)
            res_slot = b.slot_alloc('int', 64)
            true_blk = b.new_block('abs.neg')
            false_blk = b.new_block('abs.pos')
            end_blk = b.new_block('abs.end')
            b.br_cond(cond, true_blk, false_blk)
            b.set_block(true_blk)
            b.slot_store(res_slot, neg, INT64)
            b.br(end_blk)
            b.set_block(false_blk)
            b.slot_store(res_slot, v_id, INT64)
            b.br(end_blk)
            b.set_block(end_blk)
            return b.slot_load(res_slot, 'int'), INT64
        if v_ty.kind == 'f64':
            r_id = b.call('cssc_ma_absf', [v_id], [FLOAT64],
                          return_type=FLOAT64, external=True)
            return r_id, FLOAT64
        if v_ty.kind == 'f32':
            ext_id = b.call('__extendsfdf2', [v_id], [FLOAT32],
                            return_type=FLOAT64, external=True)
            r_id = b.call('cssc_ma_absf', [ext_id], [FLOAT64],
                          return_type=FLOAT64, external=True)
            return r_id, FLOAT64
        raise _csscerror(
            detail=f'cssc::abs on {v_ty.kind} not yet supported',
            line=line,
        )

    if func == 'min' or func == 'max':
        if len(args) != 2:
            raise _csscerror(detail=f'cssc::{func}(a, b) expects 2 arguments',
                             line=line)
        a_id, a_ty = _lower_expr(b, args[0])
        c_id, c_ty = _lower_expr(b, args[1])
        if {a_ty.kind, c_ty.kind} & {'f64', 'f32'}:
            if a_ty.kind == 'i64':
                a_id = b.sitofp_to_double(a_id); a_ty = FLOAT64
            elif a_ty.kind == 'f32':
                a_id = b.call('__extendsfdf2', [a_id], [FLOAT32],
                              return_type=FLOAT64, external=True); a_ty = FLOAT64
            if c_ty.kind == 'i64':
                c_id = b.sitofp_to_double(c_id); c_ty = FLOAT64
            elif c_ty.kind == 'f32':
                c_id = b.call('__extendsfdf2', [c_id], [FLOAT32],
                              return_type=FLOAT64, external=True); c_ty = FLOAT64
            sym = 'cssc_ma_minf' if func == 'min' else 'cssc_ma_maxf'
            r_id = b.call(sym, [a_id, c_id], [FLOAT64, FLOAT64],
                          return_type=FLOAT64, external=True)
            return r_id, FLOAT64
        if a_ty.kind != c_ty.kind or a_ty.kind != 'i64':
            raise _csscerror(
                detail=f'cssc::{func}: both arguments must be int or float '
                       f'(got {a_ty.kind} and {c_ty.kind})',
                line=line,
            )
        cmp = b.cmp_int('<' if func == 'min' else '>', a_id, c_id)
        res_slot = b.slot_alloc('int', 64)
        pick_a = b.new_block(f'{func}.a')
        pick_b = b.new_block(f'{func}.b')
        end_blk = b.new_block(f'{func}.end')
        b.br_cond(cmp, pick_a, pick_b)
        b.set_block(pick_a)
        b.slot_store(res_slot, a_id, INT64)
        b.br(end_blk)
        b.set_block(pick_b)
        b.slot_store(res_slot, c_id, INT64)
        b.br(end_blk)
        b.set_block(end_blk)
        return b.slot_load(res_slot, 'int'), INT64

    if func == 'uptime':
        # Monotonic seconds since program start. Float for sub-second
        # precision; the runtime returns a `double` from a per-target
        # clock source (QueryPerformanceCounter on Win32, clock_gettime
        # on POSIX, micros() / 1e6 on embedded).
        if args:
            raise _csscerror(detail='cssc::uptime() takes no arguments',
                             line=line)
        sec = b.call('cssc_uptime', [], [],
                     return_type=FLOAT64, external=True)
        return sec, FLOAT64

    if func == 'tick':
        # Monotonic tick counter (per-tick on embedded; ms on host).
        if args:
            raise _csscerror(detail='cssc::tick() takes no arguments',
                             line=line)
        t = b.call('cssc_tick', [], [],
                   return_type=INT64, external=True)
        return t, INT64

    # A.3.16: type conversion + to_string surface.
    # `to_int` / `to_float` / `to_bool` aliases match the spec's
    # canonical naming (parallel to `to_string`). The short `int` /
    # `float` / `bool` forms are kept for back-compat with code
    # written against the earlier v6 patches.
    if func == 'to_int':
        func = 'int'
    elif func == 'to_float':
        func = 'float'
    elif func == 'to_bool':
        func = 'bool'
    elif func == 'to_str':
        # Short alias used in pitch material and example code; the
        # canonical name remains `to_string` per Doc §12.
        func = 'to_string'

    if func == 'int':
        if len(args) != 1:
            raise _csscerror(detail='cssc::int(x) expects 1 argument',
                             line=line)
        v_id, v_ty = _lower_expr(b, args[0])
        if v_ty.kind == 'i64':
            return v_id, INT64
        if v_ty.kind == 'i1':
            # zext i1 → i64 via add 0 trick already encoded by const_bool;
            # safer to emit an explicit branchless conversion.
            zero = b.const_int(0)
            one = b.const_int(1)
            res = b.slot_alloc('int', 64)
            tb = b.new_block('toi.t')
            fb = b.new_block('toi.f')
            end = b.new_block('toi.end')
            b.br_cond(v_id, tb, fb)
            b.set_block(tb)
            b.slot_store(res, one, INT64); b.br(end)
            b.set_block(fb)
            b.slot_store(res, zero, INT64); b.br(end)
            b.set_block(end)
            return b.slot_load(res, 'int'), INT64
        if v_ty.kind == 'f32':
            promoted = b.call('__extendsfdf2', [v_id], [FLOAT32],
                              return_type=FLOAT64, external=True)
            iv = b.fptosi_to_int(promoted)
            return iv, INT64
        if v_ty.kind == 'f64':
            # `fptosi double -> i64` (single native instruction, matches C).
            # The old `__fixdfsi` libcall converts to a 32-bit signed int, so
            # any float >= 2^31 overflowed (9.99e9 -> garbage / INT32-range).
            iv = b.fptosi_to_int(v_id)
            return iv, INT64
        if v_ty.kind in ('string_ptr', 'ptr'):
            iv = b.call('cssc_string_to_int', [v_id], [PTR],
                        return_type=INT64, external=True)
            return iv, INT64
        raise _csscerror(detail=f'cssc::int({v_ty.kind}) not supported',
                         line=line)

    if func == 'float':
        if len(args) != 1:
            raise _csscerror(detail='cssc::float(x) expects 1 argument',
                             line=line)
        v_id, v_ty = _lower_expr(b, args[0])
        if v_ty.kind == 'f64':
            return v_id, FLOAT64
        if v_ty.kind == 'f32':
            fv = b.call('__extendsfdf2', [v_id], [FLOAT32],
                        return_type=FLOAT64, external=True)
            return fv, FLOAT64
        if v_ty.kind == 'i64':
            fv = b.call('__floatsidf', [v_id], [INT64],
                        return_type=FLOAT64, external=True)
            return fv, FLOAT64
        if v_ty.kind == 'i1':
            # bool → 1.0 or 0.0 via select-on-i1 done in IR.
            zero = b.const_int(0)
            ext = b.bin_int('+', zero, v_id)  # promote i1→i64 conservatively
            fv = b.call('__floatsidf', [ext], [INT64],
                        return_type=FLOAT64, external=True)
            return fv, FLOAT64
        if v_ty.kind in ('string_ptr', 'ptr'):
            fv = b.call('cssc_string_to_float', [v_id], [PTR],
                        return_type=FLOAT64, external=True)
            return fv, FLOAT64
        raise _csscerror(detail=f'cssc::float({v_ty.kind}) not supported',
                         line=line)

    if func == 'to_string':
        if len(args) != 1:
            raise _csscerror(detail='cssc::to_string(x) expects 1 argument',
                             line=line)
        v_id, v_ty = _lower_expr(b, args[0])
        if v_ty.kind == 'i64':
            s = b.call('cssc_int_to_str', [v_id], [INT64],
                       return_type=STRING_PTR, external=True)
            return s, STRING_PTR
        if v_ty.kind == 'i1':
            s = b.call('cssc_bool_to_str', [v_id], [BOOL],
                       return_type=STRING_PTR, external=True)
            return s, STRING_PTR
        if v_ty.kind == 'f64':
            s = b.call('cssc_float_to_str', [v_id], [FLOAT64],
                       return_type=STRING_PTR, external=True)
            return s, STRING_PTR
        if v_ty.kind == 'f32':
            promoted = b.call('__extendsfdf2', [v_id], [FLOAT32],
                              return_type=FLOAT64, external=True)
            s = b.call('cssc_float_to_str', [promoted], [FLOAT64],
                       return_type=STRING_PTR, external=True)
            return s, STRING_PTR
        if v_ty.kind in ('string_ptr', 'ptr'):
            # Already a string; cssc::to_string(s) is idempotent.
            return v_id, STRING_PTR
        raise _csscerror(detail=f'cssc::to_string({v_ty.kind}) not supported',
                         line=line)

    if func == 'bool':
        # Doc §12: cssc::to_bool(val) — coerce to i1. Int → (x != 0).
        # Float → (x != 0.0). String → (length > 0). Bool → identity.
        if len(args) != 1:
            raise _csscerror(detail='cssc::to_bool(x) expects 1 argument',
                             line=line)
        v_id, v_ty = _lower_expr(b, args[0])
        if v_ty.kind == 'i1':
            return v_id, BOOL
        if v_ty.kind == 'i64':
            zero = b.const_int(0)
            return b.cmp_int('!=', v_id, zero), BOOL
        if v_ty.kind == 'f64':
            zero = b.const_float(0.0)
            return b.cmp_float('!=', v_id, zero), BOOL
        if v_ty.kind == 'f32':
            promoted = b.call('__extendsfdf2', [v_id], [FLOAT32],
                              return_type=FLOAT64, external=True)
            zero = b.const_float(0.0)
            return b.cmp_float('!=', promoted, zero), BOOL
        if v_ty.kind in ('string_ptr', 'ptr'):
            sz = b.call('cssc_string_size', [v_id], [PTR],
                        return_type=INT64, external=True)
            zero = b.const_int(0)
            return b.cmp_int('!=', sz, zero), BOOL
        raise _csscerror(detail=f'cssc::to_bool({v_ty.kind}) not supported',
                         line=line)

    if func == 'sqrt':
        # Doc §12: cssc::sqrt(x). All three backends ship `sqrt`/`__sqrtdf2`
        # via softfloat (esp/avr) or libm (host). Promote int → double
        # for ergonomic call shape: cssc::sqrt(16) returns 4.0.
        if len(args) != 1:
            raise _csscerror(detail='cssc::sqrt(x) expects 1 argument',
                             line=line)
        v_id, v_ty = _lower_expr(b, args[0])
        if v_ty.kind == 'i64':
            v_id = b.call('__floatsidf', [v_id], [INT64],
                          return_type=FLOAT64, external=True)
            v_ty = FLOAT64
        elif v_ty.kind == 'f32':
            v_id = b.call('__extendsfdf2', [v_id], [FLOAT32],
                          return_type=FLOAT64, external=True)
            v_ty = FLOAT64
        elif v_ty.kind != 'f64':
            raise _csscerror(
                detail=f'cssc::sqrt on {v_ty.kind} not supported',
                line=line,
            )
        r = b.call('cssc_sqrt', [v_id], [FLOAT64],
                   return_type=FLOAT64, external=True)
        return r, FLOAT64

    if func == 'random':
        # Doc §12: cssc::random() → f64 in [0, 1). No args.
        if args:
            raise _csscerror(detail='cssc::random() takes no arguments',
                             line=line)
        r = b.call('cssc_random', [], [],
                   return_type=FLOAT64, external=True)
        return r, FLOAT64

    if func == 'lerp':
        # Perf-opt #8: inline `cssc::lerp(a, b, t)` as `a + (b - a) * t`
        # (three IR ops — sub, mul, fadd). Emits no runtime symbol so
        # there is no call overhead and LLVM can constant-fold across
        # compositions like `lerp(0, 1, t)` → `t`.
        if len(args) != 3:
            raise _csscerror(
                detail='cssc::lerp(a, b, t) expects 3 arguments',
                line=line,
            )
        a_id, a_ty = _lower_expr(b, args[0])
        c_id, c_ty = _lower_expr(b, args[1])
        t_id, t_ty = _lower_expr(b, args[2])
        # Promote everything to f64 so the compose result is a single
        # canonical type across mixed-precision call sites.
        a_id = _promote_to_f64(b, a_id, a_ty)
        c_id = _promote_to_f64(b, c_id, c_ty)
        t_id = _promote_to_f64(b, t_id, t_ty)
        diff = b.bin_float('-', c_id, a_id)
        scaled = b.bin_float('*', diff, t_id)
        return b.bin_float('+', a_id, scaled), FLOAT64

    if func == 'clamp':
        # Perf-opt #8: inline `cssc::clamp(x, lo, hi)` as
        # `fmax(lo, fmin(x, hi))`. Uses llvm.minnum/maxnum intrinsics —
        # both are branchless SSE min/max on host, and the composition
        # collapses to two ops that LLVM further folds through when
        # constants are involved.
        if len(args) != 3:
            raise _csscerror(
                detail='cssc::clamp(x, lo, hi) expects 3 arguments',
                line=line,
            )
        x_id, x_ty = _lower_expr(b, args[0])
        lo_id, lo_ty = _lower_expr(b, args[1])
        hi_id, hi_ty = _lower_expr(b, args[2])
        # All-int case: use integer min/max via cmp+select-style
        # branching to avoid f64 round-trip for pure-int calls.
        if (x_ty.kind == 'i64' and lo_ty.kind == 'i64'
                and hi_ty.kind == 'i64'):
            # min(x, hi)
            cmp1 = b.cmp_int('<', x_id, hi_id)
            m_slot = b.slot_alloc('int', 64)
            true1 = b.new_block('clamp.min.lt')
            false1 = b.new_block('clamp.min.ge')
            join1 = b.new_block('clamp.min.end')
            b.br_cond(cmp1, true1, false1)
            b.set_block(true1); b.slot_store(m_slot, x_id, INT64); b.br(join1)
            b.set_block(false1); b.slot_store(m_slot, hi_id, INT64); b.br(join1)
            b.set_block(join1)
            m_val = b.slot_load(m_slot, 'int')
            # max(lo, m_val)
            cmp2 = b.cmp_int('>', m_val, lo_id)
            r_slot = b.slot_alloc('int', 64)
            true2 = b.new_block('clamp.max.gt')
            false2 = b.new_block('clamp.max.le')
            join2 = b.new_block('clamp.max.end')
            b.br_cond(cmp2, true2, false2)
            b.set_block(true2); b.slot_store(r_slot, m_val, INT64); b.br(join2)
            b.set_block(false2); b.slot_store(r_slot, lo_id, INT64); b.br(join2)
            b.set_block(join2)
            return b.slot_load(r_slot, 'int'), INT64
        # Mixed / float: promote to f64 and emit two branchy compare-
        # and-select sequences. LLVM's InstCombine / SimplifyCFG lower
        # these to `minsd` / `maxsd` on x86_64 SSE at any O-level ≥ 1,
        # so the branchy source form still folds to the branchless
        # target instructions — no need to introduce a runtime helper.
        x_id = _promote_to_f64(b, x_id, x_ty)
        lo_id = _promote_to_f64(b, lo_id, lo_ty)
        hi_id = _promote_to_f64(b, hi_id, hi_ty)
        # min(x, hi)
        cmp1 = b.cmp_float('<', x_id, hi_id)
        m_slot = b.slot_alloc('float', 64)
        true1 = b.new_block('clamp.fmin.lt')
        false1 = b.new_block('clamp.fmin.ge')
        join1 = b.new_block('clamp.fmin.end')
        b.br_cond(cmp1, true1, false1)
        b.set_block(true1); b.slot_store(m_slot, x_id, FLOAT64); b.br(join1)
        b.set_block(false1); b.slot_store(m_slot, hi_id, FLOAT64); b.br(join1)
        b.set_block(join1)
        m_val = b.slot_load(m_slot, 'float')
        # max(lo, m_val)
        cmp2 = b.cmp_float('>', m_val, lo_id)
        r_slot = b.slot_alloc('float', 64)
        true2 = b.new_block('clamp.fmax.gt')
        false2 = b.new_block('clamp.fmax.le')
        join2 = b.new_block('clamp.fmax.end')
        b.br_cond(cmp2, true2, false2)
        b.set_block(true2); b.slot_store(r_slot, m_val, FLOAT64); b.br(join2)
        b.set_block(false2); b.slot_store(r_slot, lo_id, FLOAT64); b.br(join2)
        b.set_block(join2)
        return b.slot_load(r_slot, 'float'), FLOAT64

    if func == 'distance':
        # Perf-opt #8: inline `cssc::distance(x1, y1, x2, y2)` as
        # `sqrt((x2-x1)*(x2-x1) + (y2-y1)*(y2-y1))`. Uses cssc_sqrt
        # (which itself is a pure-math `readnone` declare after
        # perf-opt #1). LLVM constant-folds across pure-int inputs
        # and vectorises across tight-loop calls.
        if len(args) != 4:
            raise _csscerror(
                detail=('cssc::distance(x1, y1, x2, y2) expects 4 '
                        'arguments'),
                line=line,
            )
        x1_id, x1_ty = _lower_expr(b, args[0])
        y1_id, y1_ty = _lower_expr(b, args[1])
        x2_id, x2_ty = _lower_expr(b, args[2])
        y2_id, y2_ty = _lower_expr(b, args[3])
        x1_id = _promote_to_f64(b, x1_id, x1_ty)
        y1_id = _promote_to_f64(b, y1_id, y1_ty)
        x2_id = _promote_to_f64(b, x2_id, x2_ty)
        y2_id = _promote_to_f64(b, y2_id, y2_ty)
        dx = b.bin_float('-', x2_id, x1_id)
        dy = b.bin_float('-', y2_id, y1_id)
        dx2 = b.bin_float('*', dx, dx)
        dy2 = b.bin_float('*', dy, dy)
        s = b.bin_float('+', dx2, dy2)
        r = b.call('cssc_sqrt', [s], [FLOAT64],
                   return_type=FLOAT64, external=True)
        return r, FLOAT64

    if func == 'random_int':
        # Doc §12: cssc::random_int(a, b) → i64 in [a, b]. Half-open
        # would surprise users coming from other languages; the
        # interpreter chose inclusive-inclusive — native matches.
        if len(args) != 2:
            raise _csscerror(
                detail='cssc::random_int(a, b) expects 2 arguments',
                line=line,
            )
        a_id, a_ty = _lower_expr(b, args[0])
        b_id, b_ty = _lower_expr(b, args[1])
        if a_ty.kind != 'i64' or b_ty.kind != 'i64':
            raise _csscerror(
                detail=(f'cssc::random_int: both arguments must be int '
                        f'(got {a_ty.kind} and {b_ty.kind})'),
                line=line,
            )
        r = b.call('cssc_random_int', [a_id, b_id], [INT64, INT64],
                   return_type=INT64, external=True)
        return r, INT64

    if func == 'len':
        # Doc §12: cssc::len(val) — generic length.
        #   string  → byte count via cssc_string_size
        #   vector/array (any elem kind) → cssc_vector_size_<elem>
        #   map_si  → cssc_map_si_size
        #   bind_ss → cssc_bind_ss_size
        # Returns i64.
        if len(args) != 1:
            raise _csscerror(detail='cssc::len(x) expects 1 argument',
                             line=line)
        a = args[0]
        # If the arg is an in-scope identifier, dispatch on its kind.
        if isinstance(a, dict) and a.get('type') == 'identifier':
            nm = a.get('name', '')
            if b.scope_has(nm):
                k = b.scope_kind(nm)
                slot = b.scope_lookup(nm)
                ptr = b.slot_load(slot, k)
                size_sym_map = {
                    'string':         'cssc_string_size',
                    'vector_int':     'cssc_vector_size_int',
                    'vector_float':   'cssc_vector_size_float',
                    'vector_bool':    'cssc_vector_size_bool',
                    'vector_string':  'cssc_vector_size_string',
                    'array_int':      'cssc_vector_size_int',
                    'array_float':    'cssc_vector_size_float',
                    'array_bool':     'cssc_vector_size_bool',
                    'array_string':   'cssc_array_string_size',
                    'map_si':         'cssc_map_si_size',
                    'map_ss':         'cssc_map_ss_size',
                    'map_is':         'cssc_map_is_size',
                    'map_ii':         'cssc_map_ii_size',
                    'map_sf':         'cssc_map_sf_size',
                    'map_if':         'cssc_map_if_size',
                    'bind_ss':        'cssc_bind_ss_size',
                    'array_bind':     'cssc_array_bind_size',
                }
                sym = size_sym_map.get(k)
                if sym is None:
                    raise _csscerror(
                        detail=(f'cssc::len: kind {k!r} has no length '
                                f'operation'),
                        line=line,
                    )
                r = b.call(sym, [ptr], [PTR],
                           return_type=INT64, external=True)
                return r, INT64
        # General path — lower the expression; only string-typed and
        # ptr-typed results have a runtime length operation we can
        # call here.
        v_id, v_ty = _lower_expr(b, a)
        if v_ty.kind in ('string_ptr', 'ptr'):
            r = b.call('cssc_string_size', [v_id], [PTR],
                       return_type=INT64, external=True)
            return r, INT64
        raise _csscerror(
            detail=(f'cssc::len({v_ty.kind}) not yet supported as a '
                    f'sub-expression'),
            hint=('declare the container as a named #stack/#heap '
                  'slot and call cssc::len on the slot identifier'),
            line=line,
        )

    if func == 'typeof':
        # Doc §12: cssc::typeof(val) → string of the value's compile-
        # time kind. In v6 native types are static, so this folds
        # to a string literal at codegen time (no runtime call).
        if len(args) != 1:
            raise _csscerror(detail='cssc::typeof(x) expects 1 argument',
                             line=line)
        # For a named slot the CIR type is erased to a bare `ptr` for every
        # heap container (vector/array/map/bind/string all load as ptr), so
        # fold from the SLOT KIND instead — otherwise `typeof(map)` would
        # wrongly report 'string'. Byte-identical to the interpreter's
        # `_b_typeof` (vector→'vector', array→'array', map→'map',
        # bind→'bind').
        arg0 = args[0]
        if (isinstance(arg0, dict) and arg0.get('type') == 'identifier'
                and arg0.get('name') and b.scope_has(arg0.get('name'))):
            _sk = b.scope_kind(arg0.get('name'))
            _ts = _KIND_TYPEOF_STR.get(_sk)
            if _ts is not None:
                return b.string_from_lit(_ts), STRING_PTR
        # Non-identifier / scalar expr: fold the CIR type kind.
        v_id, v_ty = _lower_expr(b, args[0])
        kind_str = {
            'i64':         'int',
            'i1':          'bool',
            'f64':         'float',
            'f32':         'float',
            'string_ptr':  'string',
            'ptr':         'string',
        }.get(v_ty.kind, v_ty.kind)
        return b.string_from_lit(kind_str), STRING_PTR

    if func == 'is_string':
        # Doc §12: cssc::is_string(val) → bool. Folds at compile time
        # since types are static in v6 native.
        if len(args) != 1:
            raise _csscerror(detail='cssc::is_string(x) expects 1 argument',
                             line=line)
        v_id, v_ty = _lower_expr(b, args[0])
        is_str = v_ty.kind in ('string_ptr', 'ptr')
        return b.const_bool(is_str), BOOL

    if func == 'input':
        if len(args) == 0:
            prompt_id = b.string_from_lit('')
        elif len(args) == 1:
            v_id, v_ty = _lower_expr(b, args[0], expected_kind='string')
            if v_ty.kind == 'ptr':
                prompt_id = v_id
            elif v_ty.kind in ('string_ptr', 'cssc_str_ptr'):
                prompt_id = v_id
            else:
                raise _csscerror(
                    detail=f'cssc::input(prompt): prompt must be a string '
                           f'(got {v_ty.kind!r})',
                    line=line,
                )
        else:
            raise _csscerror(
                detail='cssc::input takes 0 or 1 args (prompt)',
                line=line,
            )
        rid = b.call('cssc_input', [prompt_id], [PTR],
                     return_type=STRING_PTR, external=True)
        return rid, STRING_PTR

    raise _csscerror(
        detail=f'cssc::{func}() not yet supported as a sub-expression '
               f'in v6 native',
        hint=('supported: abs, min, max, uptime, tick, int, float, '
              'bool, to_int, to_float, to_bool, to_string, sqrt, '
              'random, random_int, lerp, clamp, distance, len, '
              'typeof, is_string. Other builtins land in a later patch.'),
        line=line,
    )


def _emit_container_copy(b: CIRBuilder, src_id: int, kind: str,
                          line: Optional[int]) -> Tuple[int, CIRType]:
    """Emit an inline element-for-element deep copy of a heap container.

    Returns `(new_ptr, PTR)` for a fresh, independent container built via
    the tested vector runtime (`cssc_vector_new/size/get/push_<rt>`) — no
    hand-written per-kind copy symbol, so the copy stays byte-identical to
    what the constructor path produces. String elements are themselves
    deep-copied (`cssc_string_copy`) so source and copy share no heap
    string. This mirrors the interpreter's `copy.deepcopy` for
    `&<container>` (Doc §2.5).
    """
    if kind == 'bind_entry':
        return _emit_bind_copy(b, src_id, line)
    if kind.startswith('map_'):
        return _emit_map_copy(b, src_id, kind, line)
    if kind not in _VECTOR_INITABLE_KINDS:
        raise _csscerror(
            detail=f'&-operator: deep-copy of {kind!r} not yet supported '
                   f'in v6 native',
            hint='vector<T> / array<T> / bind / map deep-copy is implemented',
            line=line,
        )
    traits = _vector_traits(kind)
    rt = traits['rt']
    elem_ty = traits['elem']
    size = b.call(f'cssc_vector_size_{rt}', [src_id], [PTR],
                  return_type=INT64, external=True)
    dst = b.call(f'cssc_vector_new_{rt}', [size], [INT64],
                 return_type=PTR, external=True)
    i_slot = b.slot_alloc('int', 64)
    b.slot_store(i_slot, b.const_int(0), INT64)
    head = b.new_block('ccopy.head')
    body = b.new_block('ccopy.body')
    end = b.new_block('ccopy.end')
    b.br(head)
    b.set_block(head)
    i_val = b.slot_load(i_slot, 'int')
    cnd = b.cmp_int('<', i_val, size)
    b.br_cond(cnd, body, end)
    b.set_block(body)
    i_cur = b.slot_load(i_slot, 'int')
    elem = b.call(f'cssc_vector_get_{rt}', [src_id, i_cur], [PTR, INT64],
                  return_type=elem_ty, external=True)
    push_ty = elem_ty
    if rt == 'string':
        # Each element is a refcounted cssc_str* — deep-copy so the new
        # vector owns independent strings (never a borrowed/aliased ref).
        elem = b.call('cssc_string_copy', [elem], [PTR],
                      return_type=STRING_PTR, external=True)
        push_ty = PTR
    b.call(f'cssc_vector_push_{rt}', [dst, elem], [PTR, push_ty],
           return_type=VOID, external=True)
    nxt = b.binop('+', i_cur, b.const_int(1))
    b.slot_store(i_slot, nxt, INT64)
    b.br(head)
    b.set_block(end)
    return dst, PTR


# (key_kind, val_kind) per map variant — drives both stringify and copy.
# key_kind/val_kind ∈ {'int', 'float', 'string'}.
_MAP_KV_KINDS = {
    'map_ii': ('int', 'int'),
    'map_if': ('int', 'float'),
    'map_is': ('int', 'string'),
    'map_si': ('string', 'int'),
    'map_sf': ('string', 'float'),
    'map_ss': ('string', 'string'),
}


def _emit_map_bkey_str(b: CIRBuilder, ptr_id: int, kind: str, kkind: str,
                        i_cur: int) -> int:
    """Read bucket `i_cur`'s key and return a `cssc_str*` of its display
    form — int keys via `cssc_int_to_str`, string keys rebuilt from the
    stored raw (ptr,len) via `cssc_string_lit` (no quotes, matching the
    interpreter's `f'{k}: …'`)."""
    if kkind == 'string':
        kptr = b.call(f'cssc_{kind}_bkeyptr', [ptr_id, i_cur], [PTR, INT64],
                      return_type=PTR, external=True)
        klen = b.call(f'cssc_{kind}_bkeylen', [ptr_id, i_cur], [PTR, INT64],
                      return_type=INT64, external=True)
        return b.call('cssc_string_lit', [kptr, klen], [PTR, INT64],
                      return_type=STRING_PTR, external=True)
    kraw = b.call(f'cssc_{kind}_bkey', [ptr_id, i_cur], [PTR, INT64],
                  return_type=INT64, external=True)
    return b.call('cssc_int_to_str', [kraw], [INT64],
                  return_type=STRING_PTR, external=True)


def _emit_scalar_val_str(b: CIRBuilder, val_id: int, vkind: str) -> int:
    """Stringify a raw map value (already loaded) to a `cssc_str*` — int →
    `cssc_int_to_str`, float → `cssc_float_to_str` (%g), string → the value
    IS a `cssc_str*`, used directly (concat borrows, never frees)."""
    if vkind == 'string':
        return val_id
    if vkind == 'float':
        return b.call('cssc_float_to_str', [val_id], [FLOAT64],
                      return_type=STRING_PTR, external=True)
    return b.call('cssc_int_to_str', [val_id], [INT64],
                  return_type=STRING_PTR, external=True)


def _emit_map_bval_str(b: CIRBuilder, ptr_id: int, kind: str, vkind: str,
                        i_cur: int) -> int:
    """Read bucket `i_cur`'s value and return a `cssc_str*` of its display
    form (see `_emit_scalar_val_str`)."""
    rt = STRING_PTR if vkind == 'string' else (
        FLOAT64 if vkind == 'float' else INT64)
    vraw = b.call(f'cssc_{kind}_bval', [ptr_id, i_cur], [PTR, INT64],
                  return_type=rt, external=True)
    return _emit_scalar_val_str(b, vraw, vkind)


def _emit_map_append_entry(b: CIRBuilder, result_slot: int, first_slot: int,
                            ks: Optional[int], vs: int) -> None:
    """Append one entry to the running result string: `, ` separator before
    every entry except the first, then `k: v` (or just `v` when `ks` is
    None — the array-display form)."""
    nosep = b.new_block('mstr.nosep')
    dosep = b.new_block('mstr.dosep')
    b.br_cond(b.cmp_int('!=', b.slot_load(first_slot, 'int'),
                        b.const_int(0)), nosep, dosep)
    b.set_block(dosep)
    cur = b.slot_load(result_slot, 'string')
    b.slot_store(result_slot,
                 b.call('cssc_string_concat', [cur, b.string_from_lit(', ')],
                        [PTR, PTR], return_type=STRING_PTR, external=True), PTR)
    b.br(nosep)
    b.set_block(nosep)
    b.slot_store(first_slot, b.const_int(0), INT64)
    cur = b.slot_load(result_slot, 'string')
    if ks is not None:
        cur = b.call('cssc_string_concat', [cur, ks], [PTR, PTR],
                     return_type=STRING_PTR, external=True)
        cur = b.call('cssc_string_concat', [cur, b.string_from_lit(': ')],
                     [PTR, PTR], return_type=STRING_PTR, external=True)
    cur = b.call('cssc_string_concat', [cur, vs], [PTR, PTR],
                 return_type=STRING_PTR, external=True)
    b.slot_store(result_slot, cur, PTR)


def _emit_map_kv_body(b: CIRBuilder, ptr_id: int, kind: str, kkind: str,
                       vkind: str, result_slot: int, first_slot: int) -> None:
    """Bucket-walk the open-addressing table (state==1 → occupied) appending
    `k: v` entries. Leaves `b` at the loop-exit block (not terminated)."""
    cap = b.call(f'cssc_{kind}_cap', [ptr_id], [PTR],
                 return_type=INT64, external=True)
    i_slot = b.slot_alloc('int', 64)
    b.slot_store(i_slot, b.const_int(0), INT64)
    head = b.new_block('mkv.head')
    body = b.new_block('mkv.body')
    skip = b.new_block('mkv.skip')
    end = b.new_block('mkv.end')
    b.br(head)
    b.set_block(head)
    b.br_cond(b.cmp_int('<', b.slot_load(i_slot, 'int'), cap), body, end)
    b.set_block(body)
    i_cur = b.slot_load(i_slot, 'int')
    st = b.call(f'cssc_{kind}_bstate', [ptr_id, i_cur], [PTR, INT64],
                return_type=INT64, external=True)
    emit = b.new_block('mkv.emit')
    b.br_cond(b.cmp_int('==', st, b.const_int(1)), emit, skip)
    b.set_block(emit)
    ks = _emit_map_bkey_str(b, ptr_id, kind, kkind, i_cur)
    vs = _emit_map_bval_str(b, ptr_id, kind, vkind, i_cur)
    _emit_map_append_entry(b, result_slot, first_slot, ks, vs)
    b.br(skip)
    b.set_block(skip)
    b.slot_store(i_slot, b.binop('+', i_cur, b.const_int(1)), INT64)
    b.br(head)
    b.set_block(end)


def _emit_map_indexed_body(b: CIRBuilder, ptr_id: int, kind: str, vkind: str,
                            size: int, result_slot: int,
                            first_slot: int) -> None:
    """Array-display form for a dense 0-based int-key map: emit values only
    (no keys) in key order 0..size-1 via `cssc_<kind>_get`, matching the
    interpreter's is_indexed branch. Leaves `b` at the loop-exit block."""
    j_slot = b.slot_alloc('int', 64)
    b.slot_store(j_slot, b.const_int(0), INT64)
    vrt = STRING_PTR if vkind == 'string' else (
        FLOAT64 if vkind == 'float' else INT64)
    head = b.new_block('midxb.head')
    body = b.new_block('midxb.body')
    end = b.new_block('midxb.end')
    b.br(head)
    b.set_block(head)
    b.br_cond(b.cmp_int('<', b.slot_load(j_slot, 'int'), size), body, end)
    b.set_block(body)
    jv = b.slot_load(j_slot, 'int')
    vraw = b.call(f'cssc_{kind}_get', [ptr_id, jv], [PTR, INT64],
                  return_type=vrt, external=True)
    vs = _emit_scalar_val_str(b, vraw, vkind)
    _emit_map_append_entry(b, result_slot, first_slot, None, vs)
    b.slot_store(j_slot, b.binop('+', jv, b.const_int(1)), INT64)
    b.br(head)
    b.set_block(end)


def _emit_map_indexed_flag(b: CIRBuilder, ptr_id: int, kind: str,
                            size: int) -> int:
    """Return an i1 that is true iff the int-key map is dense 0-based —
    every key in {0 … size-1} present and size>0. Mirrors the interpreter's
    `is_indexed = all(k == i for i,k in enumerate(keys)) and keys`, but by
    key-set membership (native maps have no insertion order; out-of-order
    dense insertion is the documented divergence)."""
    flag_slot = b.slot_alloc('int', 64)
    pos = b.cmp_int('>', size, b.const_int(0))
    b.slot_store(flag_slot, b.zext_bool_to_int(pos), INT64)
    j_slot = b.slot_alloc('int', 64)
    b.slot_store(j_slot, b.const_int(0), INT64)
    head = b.new_block('midxf.head')
    body = b.new_block('midxf.body')
    cont = b.new_block('midxf.cont')
    miss = b.new_block('midxf.miss')
    end = b.new_block('midxf.end')
    b.br(head)
    b.set_block(head)
    b.br_cond(b.cmp_int('<', b.slot_load(j_slot, 'int'), size), body, end)
    b.set_block(body)
    jv = b.slot_load(j_slot, 'int')
    has = b.call(f'cssc_{kind}_has', [ptr_id, jv], [PTR, INT64],
                 return_type=BOOL, external=True)
    b.br_cond(has, cont, miss)
    b.set_block(miss)
    b.slot_store(flag_slot, b.const_int(0), INT64)
    b.br(end)
    b.set_block(cont)
    b.slot_store(j_slot, b.binop('+', jv, b.const_int(1)), INT64)
    b.br(head)
    b.set_block(end)
    return b.cmp_int('!=', b.slot_load(flag_slot, 'int'), b.const_int(0))


def _emit_map_to_str(b: CIRBuilder, ptr_id: int, kind: str,
                      line: Optional[int]) -> Tuple[int, CIRType]:
    """Inline stringify of a `map`, byte-identical to the interpreter's
    `_format_value` for a dict. String-key maps always render `{k: v, …}`.
    Int-key maps that are dense 0-based ({0 … size-1}) render as an array
    `{v0, v1, …}` (the interpreter's is_indexed branch); otherwise
    `{k: v, …}`. Keys/values are un-quoted, `: ` between k/v, `, ` between
    entries. Multi-entry `{k: v}` order is bucket order — it may differ from
    the interpreter's insertion order (documented hash-map caveat)."""
    spec = _MAP_KV_KINDS.get(kind)
    if spec is None:
        raise _csscerror(
            detail=f'map stringify for {kind!r} not yet implemented in '
                   f'v6 native',
            hint='map<int,int|float|string> and map<string,int|float|string> '
                 'stringify are implemented',
            line=line)
    kkind, vkind = spec
    result_slot = b.slot_alloc('string', 64)
    b.slot_store(result_slot, b.string_from_lit('{'), PTR)
    first_slot = b.slot_alloc('int', 64)
    b.slot_store(first_slot, b.const_int(1), INT64)

    if kkind == 'int':
        # Runtime dispatch: dense 0-based → array display, else key:value.
        size = b.call(f'cssc_{kind}_size', [ptr_id], [PTR],
                      return_type=INT64, external=True)
        indexed = _emit_map_indexed_flag(b, ptr_id, kind, size)
        idx_arm = b.new_block('mstr.idx')
        kv_arm = b.new_block('mstr.kv')
        join = b.new_block('mstr.join')
        b.br_cond(indexed, idx_arm, kv_arm)
        b.set_block(idx_arm)
        _emit_map_indexed_body(b, ptr_id, kind, vkind, size,
                               result_slot, first_slot)
        b.br(join)
        b.set_block(kv_arm)
        _emit_map_kv_body(b, ptr_id, kind, kkind, vkind,
                          result_slot, first_slot)
        b.br(join)
        b.set_block(join)
    else:
        _emit_map_kv_body(b, ptr_id, kind, kkind, vkind,
                          result_slot, first_slot)

    cur = b.slot_load(result_slot, 'string')
    final = b.call('cssc_string_concat', [cur, b.string_from_lit('}')],
                   [PTR, PTR], return_type=STRING_PTR, external=True)
    return final, STRING_PTR


def _emit_bind_copy(b: CIRBuilder, src_id: int,
                     line: Optional[int]) -> Tuple[int, CIRType]:
    """Emit an inline deep copy of a `bind_entry`. Rebuilds a fresh cells
    buffer (val+tag per cell, preserving pair_width) via the same
    constructor path `_init_bind_entry` uses, so the copy is structurally
    identical. String cells are `cssc_string_copy`-ed so the copy owns
    independent heap strings; int/float/bool cells copy their raw bits."""
    ncells = b.call('cssc_bind_entry_ncells', [src_id], [PTR],
                    return_type=INT64, external=True)
    pw = b.call('cssc_bind_entry_pair_width', [src_id], [PTR],
                return_type=INT64, external=True)
    buf = b.call('cssc_array_bind_cells_new', [ncells], [INT64],
                 return_type=PTR, external=True)
    i_slot = b.slot_alloc('int', 64)
    b.slot_store(i_slot, b.const_int(0), INT64)
    val_slot = b.slot_alloc('int', 64)
    head = b.new_block('bcopy.head')
    body = b.new_block('bcopy.body')
    end = b.new_block('bcopy.end')
    b.br(head)
    b.set_block(head)
    b.br_cond(b.cmp_int('<', b.slot_load(i_slot, 'int'), ncells), body, end)
    b.set_block(body)
    i_cur = b.slot_load(i_slot, 'int')
    tag = b.call('cssc_bind_entry_cell_tag', [src_id, i_cur], [PTR, INT64],
                 return_type=INT64, external=True)
    raw = b.call('cssc_bind_entry_cell_int', [src_id, i_cur], [PTR, INT64],
                 return_type=INT64, external=True)
    b.slot_store(val_slot, raw, INT64)
    scopy = b.new_block('bcopy.scopy')
    after = b.new_block('bcopy.after')
    b.br_cond(b.cmp_int('==', tag, b.const_int(_BIND_TAG_STRING)),
              scopy, after)
    b.set_block(scopy)
    cp = b.call('cssc_string_copy', [b.int_to_ptr(raw)], [PTR],
                return_type=STRING_PTR, external=True)
    b.slot_store(val_slot, b.ptr_to_int(cp), INT64)
    b.br(after)
    b.set_block(after)
    v = b.slot_load(val_slot, 'int')
    b.call('cssc_array_bind_cells_set_val', [buf, i_cur, v],
           [PTR, INT64, INT64], return_type=VOID, external=True)
    b.call('cssc_array_bind_cells_set_tag', [buf, i_cur, tag],
           [PTR, INT64, INT64], return_type=VOID, external=True)
    b.slot_store(i_slot, b.binop('+', i_cur, b.const_int(1)), INT64)
    b.br(head)
    b.set_block(end)
    b.call('cssc_array_bind_cells_set_pair_width', [buf, pw], [PTR, INT64],
           return_type=VOID, external=True)
    dst = b.call('cssc_bind_entry_from_buf', [ncells, buf], [INT64, PTR],
                 return_type=PTR, external=True)
    return dst, PTR


def _emit_map_copy(b: CIRBuilder, src_id: int, kind: str,
                    line: Optional[int]) -> Tuple[int, CIRType]:
    """Emit an inline deep copy of a `map` — allocate a fresh table sized
    to the source's bucket count (so bucket placement, and therefore the
    copy's stringify order, matches the source) and re-`set` every occupied
    bucket. String keys are re-duplicated by `set`; string values are
    `cssc_string_copy`-ed so the copy owns independent heap strings. Mirrors
    the interpreter's `copy.deepcopy` for `&<map>` (Doc §2.5)."""
    kkind, vkind = _MAP_KV_KINDS[kind]
    val_ty = STRING_PTR if vkind == 'string' else (
        FLOAT64 if vkind == 'float' else INT64)
    cap = b.call(f'cssc_{kind}_cap', [src_id], [PTR],
                 return_type=INT64, external=True)
    dst = b.call(f'cssc_{kind}_new', [cap], [INT64],
                 return_type=PTR, external=True)
    i_slot = b.slot_alloc('int', 64)
    b.slot_store(i_slot, b.const_int(0), INT64)
    head = b.new_block('mcopy.head')
    body = b.new_block('mcopy.body')
    doins = b.new_block('mcopy.ins')
    step = b.new_block('mcopy.step')
    end = b.new_block('mcopy.end')
    b.br(head)
    b.set_block(head)
    b.br_cond(b.cmp_int('<', b.slot_load(i_slot, 'int'), cap), body, end)
    b.set_block(body)
    i_cur = b.slot_load(i_slot, 'int')
    st = b.call(f'cssc_{kind}_bstate', [src_id, i_cur], [PTR, INT64],
                return_type=INT64, external=True)
    b.br_cond(b.cmp_int('==', st, b.const_int(1)), doins, step)
    b.set_block(doins)
    if vkind == 'string':
        vraw = b.call(f'cssc_{kind}_bval', [src_id, i_cur], [PTR, INT64],
                      return_type=STRING_PTR, external=True)
        val_arg = b.call('cssc_string_copy', [vraw], [PTR],
                         return_type=STRING_PTR, external=True)
    elif vkind == 'float':
        val_arg = b.call(f'cssc_{kind}_bval', [src_id, i_cur], [PTR, INT64],
                         return_type=FLOAT64, external=True)
    else:
        val_arg = b.call(f'cssc_{kind}_bval', [src_id, i_cur], [PTR, INT64],
                         return_type=INT64, external=True)
    if kkind == 'string':
        kptr = b.call(f'cssc_{kind}_bkeyptr', [src_id, i_cur], [PTR, INT64],
                      return_type=PTR, external=True)
        klen = b.call(f'cssc_{kind}_bkeylen', [src_id, i_cur], [PTR, INT64],
                      return_type=INT64, external=True)
        b.call(f'cssc_{kind}_set', [dst, kptr, klen, val_arg],
               [PTR, PTR, INT64, val_ty], return_type=VOID, external=True)
    else:
        kraw = b.call(f'cssc_{kind}_bkey', [src_id, i_cur], [PTR, INT64],
                      return_type=INT64, external=True)
        b.call(f'cssc_{kind}_set', [dst, kraw, val_arg],
               [PTR, INT64, val_ty], return_type=VOID, external=True)
    b.br(step)
    b.set_block(step)
    b.slot_store(i_slot, b.binop('+', i_cur, b.const_int(1)), INT64)
    b.br(head)
    b.set_block(end)
    return dst, PTR


def _emit_bind_to_str(b: CIRBuilder, ptr_id: int,
                       line: Optional[int]) -> Tuple[int, CIRType]:
    """Inline stringify of a `bind` — `{a, b; c, d}` (pair-structured) or
    `{a, b, c}` (flat), byte-identical to the interpreter's CsscBind
    format. Each cell is tag-dispatched (int / float / string / bool) via
    the runtime `cssc_bind_entry_cell_tag` reader; pairs are joined by
    `; ` and cells within a pair by `, ` using the entry's pair_width."""
    result_slot = b.slot_alloc('string', 64)
    b.slot_store(result_slot, b.string_from_lit('{'), PTR)
    cell_str_slot = b.slot_alloc('string', 64)
    ncells = b.call('cssc_bind_entry_ncells', [ptr_id], [PTR],
                    return_type=INT64, external=True)
    pw = b.call('cssc_bind_entry_pair_width', [ptr_id], [PTR],
                return_type=INT64, external=True)
    i_slot = b.slot_alloc('int', 64)
    b.slot_store(i_slot, b.const_int(0), INT64)

    head = b.new_block('bstr.head')
    body = b.new_block('bstr.body')
    end = b.new_block('bstr.end')
    b.br(head)
    b.set_block(head)
    b.br_cond(b.cmp_int('<', b.slot_load(i_slot, 'int'), ncells), body, end)

    b.set_block(body)
    i_cur = b.slot_load(i_slot, 'int')
    # ── separator: none for the first cell; `; ` at every pair boundary
    #    (i % pair_width == 0), `, ` otherwise. ──
    sep = b.new_block('bstr.sep')
    cell = b.new_block('bstr.cell')
    b.br_cond(b.cmp_int('==', i_cur, b.const_int(0)), cell, sep)

    b.set_block(sep)
    sep_semi = b.new_block('bstr.sep_semi')
    sep_comma = b.new_block('bstr.sep_comma')
    sep_mod = b.new_block('bstr.sep_mod')
    b.br_cond(b.cmp_int('>', pw, b.const_int(0)), sep_mod, sep_comma)
    b.set_block(sep_mod)
    rem = b.binop('%', i_cur, pw)
    b.br_cond(b.cmp_int('==', rem, b.const_int(0)), sep_semi, sep_comma)
    b.set_block(sep_semi)
    cur = b.slot_load(result_slot, 'string')
    b.slot_store(result_slot,
                 b.call('cssc_string_concat', [cur, b.string_from_lit('; ')],
                        [PTR, PTR], return_type=STRING_PTR, external=True), PTR)
    b.br(cell)
    b.set_block(sep_comma)
    cur = b.slot_load(result_slot, 'string')
    b.slot_store(result_slot,
                 b.call('cssc_string_concat', [cur, b.string_from_lit(', ')],
                        [PTR, PTR], return_type=STRING_PTR, external=True), PTR)
    b.br(cell)

    # ── cell tag dispatch → cell_str_slot ──
    b.set_block(cell)
    i_c2 = b.slot_load(i_slot, 'int')
    tag = b.call('cssc_bind_entry_cell_tag', [ptr_id, i_c2], [PTR, INT64],
                 return_type=INT64, external=True)
    c_str = b.new_block('bstr.c_str')
    c_notstr = b.new_block('bstr.c_notstr')
    c_join = b.new_block('bstr.c_join')
    b.br_cond(b.cmp_int('==', tag, b.const_int(_BIND_TAG_STRING)),
              c_str, c_notstr)

    b.set_block(c_str)
    sv = b.call('cssc_bind_entry_cell_val', [ptr_id, i_c2], [PTR, INT64],
                return_type=STRING_PTR, external=True)
    # copy so the result string owns its own ref (the cell keeps its own).
    sv = b.call('cssc_string_copy', [sv], [PTR],
                return_type=STRING_PTR, external=True)
    b.slot_store(cell_str_slot, sv, PTR)
    b.br(c_join)

    b.set_block(c_notstr)
    c_float = b.new_block('bstr.c_float')
    c_notfloat = b.new_block('bstr.c_notfloat')
    b.br_cond(b.cmp_int('==', tag, b.const_int(_BIND_TAG_FLOAT)),
              c_float, c_notfloat)
    b.set_block(c_float)
    fraw = b.call('cssc_bind_entry_cell_int', [ptr_id, i_c2], [PTR, INT64],
                  return_type=INT64, external=True)
    fv = b.call('__cssc_bitcast_i64_f64', [fraw], [INT64],
                return_type=FLOAT64, external=True)
    b.slot_store(cell_str_slot,
                 b.call('cssc_float_to_str', [fv], [FLOAT64],
                        return_type=STRING_PTR, external=True), PTR)
    b.br(c_join)

    b.set_block(c_notfloat)
    c_bool = b.new_block('bstr.c_bool')
    c_int = b.new_block('bstr.c_int')
    b.br_cond(b.cmp_int('==', tag, b.const_int(_BIND_TAG_BOOL)),
              c_bool, c_int)
    b.set_block(c_bool)
    braw = b.call('cssc_bind_entry_cell_int', [ptr_id, i_c2], [PTR, INT64],
                  return_type=INT64, external=True)
    blv = b.cmp_int('!=', braw, b.const_int(0))
    b.slot_store(cell_str_slot,
                 b.call('cssc_bool_to_str', [blv], [BOOL],
                        return_type=STRING_PTR, external=True), PTR)
    b.br(c_join)
    b.set_block(c_int)
    # tag INT (1) — and any ptr/unknown cell — render as the raw i64
    # decimal (a nested container cell can't be re-typed here).
    iraw = b.call('cssc_bind_entry_cell_int', [ptr_id, i_c2], [PTR, INT64],
                  return_type=INT64, external=True)
    b.slot_store(cell_str_slot,
                 b.call('cssc_int_to_str', [iraw], [INT64],
                        return_type=STRING_PTR, external=True), PTR)
    b.br(c_join)

    b.set_block(c_join)
    cs = b.slot_load(cell_str_slot, 'string')
    cur = b.slot_load(result_slot, 'string')
    b.slot_store(result_slot,
                 b.call('cssc_string_concat', [cur, cs], [PTR, PTR],
                        return_type=STRING_PTR, external=True), PTR)
    b.slot_store(i_slot, b.binop('+', i_c2, b.const_int(1)), INT64)
    b.br(head)

    b.set_block(end)
    cur = b.slot_load(result_slot, 'string')
    final = b.call('cssc_string_concat', [cur, b.string_from_lit('}')],
                   [PTR, PTR], return_type=STRING_PTR, external=True)
    return final, STRING_PTR


def _emit_container_to_str(b: CIRBuilder, ptr_id: int, kind: str,
                            line: Optional[int]) -> Tuple[int, CIRType]:
    """Emit an inline `{e0, e1, …}` stringification of a heap container.

    Byte-identical to the interpreter's `_format_value` for a list
    (`'{' + ', '.join(...) + '}'`), built from the existing string +
    vector runtime (`cssc_string_lit`, `cssc_string_concat`, per-element
    `cssc_<rt>_to_str`, `cssc_vector_size/get_<rt>`). Returns
    `(cssc_str*, STRING_PTR)`. Used by string `+` concat so
    `"x=" + vec` matches `cssc run` exactly.
    """
    if kind == 'bind_entry':
        return _emit_bind_to_str(b, ptr_id, line)
    if kind.startswith('map_'):
        return _emit_map_to_str(b, ptr_id, kind, line)
    if kind not in _VECTOR_INITABLE_KINDS:
        raise _csscerror(
            detail=f'string concat with {kind!r} not supported in v6 native',
            hint='vector<T> / array<T> / bind stringify is implemented; '
                 'map / bind<string,string> land in a later patch',
            line=line,
        )
    traits = _vector_traits(kind)
    rt = traits['rt']
    elem_ty = traits['elem']
    # Accumulate the growing cssc_str* across loop iterations in a slot
    # (SSA ids don't survive block edges).
    result_slot = b.slot_alloc('string', 64)
    b.slot_store(result_slot, b.string_from_lit('{'), PTR)
    size = b.call(f'cssc_vector_size_{rt}', [ptr_id], [PTR],
                  return_type=INT64, external=True)
    i_slot = b.slot_alloc('int', 64)
    b.slot_store(i_slot, b.const_int(0), INT64)
    head = b.new_block('tostr.head')
    body = b.new_block('tostr.body')
    end = b.new_block('tostr.end')
    b.br(head)
    b.set_block(head)
    i_val = b.slot_load(i_slot, 'int')
    cnd = b.cmp_int('<', i_val, size)
    b.br_cond(cnd, body, end)
    b.set_block(body)
    i_cur = b.slot_load(i_slot, 'int')
    # ", " separator before every element except the first.
    sep_blk = b.new_block('tostr.sep')
    elem_blk = b.new_block('tostr.elem')
    is_first = b.cmp_int('==', i_cur, b.const_int(0))
    b.br_cond(is_first, elem_blk, sep_blk)
    b.set_block(sep_blk)
    cur = b.slot_load(result_slot, 'string')
    joined = b.call('cssc_string_concat', [cur, b.string_from_lit(', ')],
                    [PTR, PTR], return_type=STRING_PTR, external=True)
    b.slot_store(result_slot, joined, PTR)
    b.br(elem_blk)
    b.set_block(elem_blk)
    elem = b.call(f'cssc_vector_get_{rt}', [ptr_id, i_cur], [PTR, INT64],
                  return_type=elem_ty, external=True)
    if rt == 'int':
        elem_str = b.call('cssc_int_to_str', [elem], [INT64],
                          return_type=STRING_PTR, external=True)
    elif rt == 'float':
        elem_str = b.call('cssc_float_to_str', [elem], [FLOAT64],
                          return_type=STRING_PTR, external=True)
    elif rt == 'bool':
        elem_str = b.call('cssc_bool_to_str', [elem], [BOOL],
                          return_type=STRING_PTR, external=True)
    else:  # string — element is already a cssc_str*
        elem_str = elem
    cur2 = b.slot_load(result_slot, 'string')
    appended = b.call('cssc_string_concat', [cur2, elem_str], [PTR, PTR],
                      return_type=STRING_PTR, external=True)
    b.slot_store(result_slot, appended, PTR)
    b.slot_store(i_slot, b.binop('+', i_cur, b.const_int(1)), INT64)
    b.br(head)
    b.set_block(end)
    cur_final = b.slot_load(result_slot, 'string')
    final = b.call('cssc_string_concat', [cur_final, b.string_from_lit('}')],
                   [PTR, PTR], return_type=STRING_PTR, external=True)
    return final, STRING_PTR


def _recover_container_kind(b: CIRBuilder, node: dict) -> Optional[str]:
    """Best-effort recovery of a container element kind for an operand
    that lowered to a bare `ptr` (the kind is erased at load time). Only
    a bare in-scope identifier is resolvable today — that covers the
    `"…" + vec` / `&vec` idioms; richer operand shapes return None so the
    caller keeps its existing type-mismatch diagnostic."""
    if isinstance(node, dict) and node.get('type') == 'identifier':
        name = node.get('name', '')
        if name and b.scope_has(name):
            k = b.scope_kind(name)
            if (k in _VECTOR_INITABLE_KINDS or k == 'bind_entry'
                    or k.startswith('map_')):
                return k
    return None


def _lower_copy_of(b: CIRBuilder, node: dict) -> Tuple[int, CIRType]:
    """Lower the `&expr` deep-copy operator.

    Semantics per CSSC v5 (Doc §2.5):
      * For value-types (int, bool, float): `&x` is identical to `x` —
        the value is already passed by-value; we return it unchanged.
      * For heap-allocated cssc_str / vector / map / bind: allocate a
        fresh heap object containing a deep copy of the contents. The
        caller owns the new pointer.

    Used at slot-init / argument / assignment sites where the user wants
    an independent snapshot rather than the shared-reference default.
    """
    line = node.get('line')
    operand = node.get('operand', {})
    # Container deep-copy: a container identifier lowers to a bare `ptr`,
    # losing the element kind — recover it from the scope binding and emit
    # an element-for-element copy before the generic ptr handling below
    # would (wrongly) reject it as an "unknown raw pointer".
    if isinstance(operand, dict) and operand.get('type') == 'identifier':
        _opname = operand.get('name', '')
        if _opname and b.scope_has(_opname):
            _opkind = b.scope_kind(_opname)
            if (_opkind in _VECTOR_INITABLE_KINDS or _opkind == 'bind_entry'
                    or _opkind.startswith('map_')):
                src_ptr, _ = _lower_expr(b, operand)
                return _emit_container_copy(b, src_ptr, _opkind, line)
    src_id, src_ty = _lower_expr(b, operand)

    if src_ty.kind in ('i64', 'i1', 'f32', 'f64'):
        # POD value: pass-by-value already, no copy needed. f32 fits
        # in one register and gets the same identity treatment as
        # i64/f64/bool — the user can't observe a difference between
        # `&x` and `x` for value kinds.
        return src_id, src_ty

    if src_ty.kind == 'string_ptr':
        result = b.call('cssc_string_copy', [src_id], [PTR],
                        return_type=STRING_PTR, external=True)
        return result, STRING_PTR

    if src_ty.kind == 'ptr':
        # A raw global string-literal ptr — materialise via cssc_string_lit,
        # which is itself a copy. (Equivalent to making a heap snapshot.)
        if operand.get('type') == 'string':
            heap = b.string_from_lit(operand.get('value', ''))
            return heap, STRING_PTR
        raise _csscerror(
            detail='&-operator: cannot deep-copy a raw pointer of unknown type',
            line=line,
        )

    raise _csscerror(
        detail=f'&-operator: deep-copy of {src_ty.kind!r} not yet '
               f'supported in v6 native',
        hint='POD types are pass-by-value; string/vector/map are heap-copied. '
             'Other kinds land in a later v6 patch.',
        line=line,
    )


def _lower_unary(b: CIRBuilder, node: dict) -> Tuple[int, CIRType]:
    """Lower `{type:'unary', op, operand}`. Phase 2: '-' on int/float, '!' on bool."""
    line = node.get('line')
    op = node.get('op', '')
    src_id, src_ty = _lower_expr(b, node['operand'])

    if op == '-':
        if src_ty.kind == 'i64':
            return b.neg_int(src_id), INT64
        if src_ty.kind in ('f32', 'f64'):
            # Float negate: 0 - x. The bin_float builder picks the
            # right precision from the bits arg.
            bits = 32 if src_ty.kind == 'f32' else 64
            zero = b.const_float(0.0, bits=bits)
            return b.bin_float('-', zero, src_id, bits=bits), src_ty
        raise _csscerror(
            detail=f"Phase 2: unary '-' on {src_ty.kind} not supported",
            line=line,
        )

    if op == '+':
        # A.3.18: `+x` only makes sense on numeric operands; silently
        # accepting it for strings was a footgun that produced a
        # STRING_PTR with no visible operation, confusing later type
        # checks. Reject anything that isn't int or float.
        if src_ty.kind not in ('i64', 'f32', 'f64'):
            raise _csscerror(
                detail=f"unary '+' requires int or float operand "
                       f"(got {src_ty.kind!r})",
                hint='for string promotion use cssc::to_string(x), not +x',
                line=line,
            )
        return src_id, src_ty

    if op == '!':
        if src_ty.kind != 'i1':
            raise _csscerror(
                detail=f"Phase 2: '!' requires a boolean operand (got {src_ty.kind})",
                hint='wrap with an explicit comparison: (x == 0) instead of !x',
                line=line,
            )
        return b.logical_not(src_id), BOOL

    if op == '*':
        if src_ty.kind in ('ptr', 'string_ptr'):
            return src_id, src_ty
        if src_ty.kind == 'i64':
            return b.int_to_ptr(src_id), PTR
        raise _csscerror(
            detail=(f"unary '*' requires a pointer or int operand "
                    f"(got {src_ty.kind!r})"),
            line=line,
        )

    raise _csscerror(detail=f"Phase 2: unary op {op!r} not supported",
                     line=line)


def _lower_logical(b: CIRBuilder, node: dict) -> Tuple[int, CIRType]:
    """Lower `{type:'logical', op:'&&'|'||', left, right}` with short-circuit.

    Uses a 1-byte alloca to carry the result across branches — avoids LLVM
    `phi` (cleaner to emit textually). The LLVM backend optimises both
    forms identically.

    Layout for `lhs && rhs`:
        lhs_val = lower(left)
        store lhs_val into result_slot           ; default: result = lhs
        br i1 lhs_val, label rhs_eval, label end
        rhs_eval:
          rhs_val = lower(right)
          store rhs_val into result_slot
          br end
        end:
          result = load result_slot

    For `lhs || rhs`: same shape with branch targets swapped.
    """
    line = node.get('line')
    op = node.get('op', '')
    if op not in ('&&', '||'):
        raise _csscerror(detail=f"unknown logical op {op!r}", line=line)

    # Reserve a stack slot for the result.
    result_slot = b.slot_alloc('bool', 8)

    lhs_id, lhs_ty = _lower_expr(b, node['left'])
    if lhs_ty.kind != 'i1':
        raise _csscerror(
            detail=f"logical {op}: lhs must be boolean (got {lhs_ty.kind})",
            line=line,
        )
    b.slot_store(result_slot, lhs_id, BOOL)

    rhs_blk = b.new_block('logic.rhs')
    end_blk = b.new_block('logic.end')

    if op == '&&':
        # Evaluate rhs only if lhs is true; else result stays = lhs (false).
        b.br_cond(lhs_id, rhs_blk, end_blk)
    else:  # '||'
        # Evaluate rhs only if lhs is false; else result stays = lhs (true).
        b.br_cond(lhs_id, end_blk, rhs_blk)

    b.set_block(rhs_blk)
    rhs_id, rhs_ty = _lower_expr(b, node['right'])
    if rhs_ty.kind != 'i1':
        raise _csscerror(
            detail=f"logical {op}: rhs must be boolean (got {rhs_ty.kind})",
            line=line,
        )
    b.slot_store(result_slot, rhs_id, BOOL)
    b.br(end_blk)

    b.set_block(end_blk)
    result = b.slot_load(result_slot, 'bool')
    return result, BOOL


# ---------------------------------------------------------------------------
# Phase 3: container ops — vector<int> via runtime calls.
# ---------------------------------------------------------------------------
def _resolve_container_target(b: CIRBuilder, obj_node: dict,
                              line: Optional[int]) -> Tuple[str, int]:
    """Resolve a container expression to (kind, slot_id).

    Two receivers are recognised:
      * a simple identifier — must name a container-typed slot;
      * an `Obj->member` arrow-access — must resolve via the scope-bound
        member slot (set up by `_bind_object_members` at function entry).
        This lets `Obj->buf.push_back(x)` work inside object label bodies.
    """
    t = obj_node.get('type')
    if t == 'identifier':
        name = obj_node.get('name', '')
        if not b.scope_has(name):
            raise _csscerror(detail=f'undefined identifier {name!r}', line=line)
        return b.scope_kind(name), b.scope_lookup(name)
    if t == 'arrow_access':
        inner = obj_node.get('object', {})
        if inner.get('type') != 'identifier':
            raise _csscerror(
                detail='container method on arrow-access requires a simple '
                       'object identifier',
                line=line,
            )
        obj_name = inner.get('name', '')
        key = obj_node.get('key', '')
        qualified = f'{obj_name}->{key}'
        if not b.scope_has(qualified):
            raise _csscerror(
                detail=f'container access on {qualified!r}: not bound in the '
                       f'current scope (call this from inside a label body)',
                line=line,
            )
        return b.scope_kind(qualified), b.scope_lookup(qualified)
    # The receiver is something else — most commonly another `index`
    # node (the user wrote a chained `i[1][0]` or `i[1].field`), or a
    # call expression, or a literal. We don't support chained container
    # ops in v6 native because the inner expression has no stable
    # slot identity to thread through the runtime's slot-load surface
    # (the runtime helpers `cssc_vector_get_*` / `cssc_bind_entry_*`
    # take a *handle*, not a generic SSA value). Emit a specific,
    # actionable error naming what the user wrote.
    t = obj_node.get('type')
    if t in ('index', 'index_access'):
        inner_obj = obj_node.get('object') or {}
        inner_name = (inner_obj.get('name')
                       if isinstance(inner_obj, dict) else None)
        inner_idx = obj_node.get('index') or {}
        inner_idx_val = None
        if isinstance(inner_idx, dict):
            inner_idx_val = inner_idx.get('value', inner_idx.get('int'))
        if inner_name is not None and inner_idx_val is not None:
            raise _csscerror(
                detail=(
                    f'chained indexing `{inner_name}[{inner_idx_val}][…]` '
                    f'is not supported — the inner `{inner_name}'
                    f'[{inner_idx_val}]` returns a value, not a slot, so '
                    f'the outer `[…]` has no container to read from.'),
                hint=(
                    f'If you\'re reading a single cell from a bind/array, '
                    f'`bind` cells are stored flat. A bind literal like '
                    f'`{{a, b; c, d}}` becomes cells [a, b, c, d] indexed '
                    f'0..3, NOT nested pairs. Read the cell directly '
                    f'(e.g. `{inner_name}[2]` for the third cell instead '
                    f'of `{inner_name}[1][0]`). For byte-level access into '
                    f'a string cell, copy it into a `#stack[string, N] '
                    f'tmp = {inner_name}[1];` first, then index `tmp[0]`.'),
                line=line,
            )
        raise _csscerror(
            detail=(
                'chained container access (`<expr>[idx]` where <expr> is '
                'itself an index or call) is not supported — the inner '
                'expression returns a value, not a slot, so the outer '
                '`[…]` has no container to read from.'),
            hint=(
                'Copy the inner value into a named slot first: '
                '`#stack[<kind>, N] tmp = <expr>;` then index `tmp[idx]`.'),
            line=line,
        )
    if t == 'arrow_access':
        # We get here when arrow_access's object isn't a simple
        # identifier (e.g. someone wrote `(call())->member.push_back()`).
        # The inner branch above handles the simple case; this is the
        # fall-through for complex receivers.
        raise _csscerror(
            detail=(
                'container access via arrow-access requires a simple '
                'object identifier on the left of `->` — got a complex '
                'expression.'),
            hint=(
                'Bind the intermediate result to a name first: '
                '`<obj_kind> tmp = <complex-expr>;` then '
                '`tmp->member.push_back(...)`.'),
            line=line,
        )
    if t in ('ns_call', 'method_call', 'dot_call', 'call'):
        callee_name = (obj_node.get('method') or obj_node.get('name')
                        or obj_node.get('callee') or '<call>')
        raise _csscerror(
            detail=(
                f'cannot call a container method on the result of '
                f'`{callee_name}(...)` directly — the call returns a '
                f'value, not a container handle.'),
            hint=(
                'Capture the return into a named slot: '
                f'`<kind> tmp = {callee_name}(...);` then '
                '`tmp.<method>(...)`.'),
            line=line,
        )
    raise _csscerror(
        detail=(
            f'container ops require a named slot or arrow-access '
            f'receiver — got a {t!r} expression.'),
        hint=(
            'Container methods (`.push_back`, `.empty`, `.size`, `[i]`) '
            'must be called on a slot you declared with `#stack[...]` '
            'or `#heap[...]`, or on an object member reached via '
            '`Object->member`. Copy the intermediate value into such a '
            'slot first.'),
        line=line,
    )


def _lower_index_read(b: CIRBuilder, node: dict,
                      expected_kind: Optional[str] = None) -> Tuple[int, CIRType]:
    """Lower `obj[idx]` as an rvalue.

    Supports:
      * `vector<T>[i]`, `array<T>[i]` — POD-element lookup.
      * `bind_entry[i]` — flat-cell access (i-th cell of the entry).
      * `bind_entry[row][col]` — structured-pair access. When the
        inner `[row]` reads from a bind_entry, the outer `[col]`
        translates to `vals[row * pair_width + col]` via the runtime
        helper `cssc_bind_entry_pair_cell_{val,int}`. The literal
        `{a, b; c, d; e, f}` (pair_width=2) gives
        `i[1][0] == i[2] == c`, matching the textual layout. Against
        a flat `array_literal` source (pair_width=0) the runtime
        helper degrades to `i[row]` semantics so chained access on a
        flat bind doesn't corrupt.

    For polymorphic bind cells the caller's `expected_kind` selects the
    return CIRType: 'int' → INT64 (raw cell bits), anything else →
    PTR/STRING_PTR (cssc_str* for string cells, opaque ptr otherwise).
    """
    line = node.get('line')
    # Chained `<bind_entry>[row][col]` — recognise BEFORE the general
    # container resolution so we don't go through the "container ops
    # require a named slot" rejection path. The structural check: the
    # outer index's object is itself an `index` (or `index_access`)
    # node, AND the inner receiver resolves to a bind_entry slot.
    inner = node.get('object') or {}
    if isinstance(inner, dict) and inner.get('type') in ('index',
                                                            'index_access'):
        innermost = inner.get('object') or {}
        # Use _resolve_container_target on the innermost. If it raises
        # we let the chained path bail and fall through to the regular
        # error in the outer call (which gives a uniform message).
        try:
            inner_kind, inner_slot = _resolve_container_target(
                b, innermost, line)
        except Exception:
            inner_kind = None
            inner_slot = None
        if inner_kind == 'bind_entry':
            # Materialise the bind_entry handle and the (row, col) ints.
            ent_ptr = b.slot_load(inner_slot, 'bind_entry')
            row_id, row_ty = _lower_expr(b, inner.get('index'),
                                          expected_kind='int')
            if row_ty.kind != 'i64':
                raise _csscerror(
                    detail=(
                        f'bind row index must be int '
                        f'(got {row_ty.kind})'),
                    line=line,
                )
            col_id, col_ty = _lower_expr(b, node.get('index'),
                                          expected_kind='int')
            if col_ty.kind != 'i64':
                raise _csscerror(
                    detail=(
                        f'bind column index must be int '
                        f'(got {col_ty.kind})'),
                    line=line,
                )
            # Pick the typed return path based on the slot's tracked
            # homogeneous cell kind (set by `_init_bind_entry` from the
            # literal). The caller's `expected_kind` overrides when set
            # — useful for explicit casts like
            # `cssc::to_int(particles[0][i])` where the user wants the
            # raw int even for a float-typed cell.
            cell_kind = _BIND_CELL_KIND.get(inner_slot, 'mixed')
            effective_kind = expected_kind or cell_kind
            if effective_kind == 'int' or effective_kind == 'bool':
                result = b.call(
                    'cssc_bind_entry_pair_cell_int',
                    [ent_ptr, row_id, col_id],
                    [PTR, INT64, INT64],
                    return_type=INT64, external=True,
                )
                if effective_kind == 'bool':
                    zero = b.const_int(0)
                    return b.cmp_int('!=', result, zero), BOOL
                return result, INT64
            if effective_kind == 'float':
                # Cell stores the i64 bit-pattern of a double. Fetch
                # raw bits then bitcast to f64 via the existing helper.
                raw = b.call(
                    'cssc_bind_entry_pair_cell_int',
                    [ent_ptr, row_id, col_id],
                    [PTR, INT64, INT64],
                    return_type=INT64, external=True,
                )
                f = b.call('__cssc_bitcast_i64_f64', [raw], [INT64],
                            return_type=FLOAT64, external=True)
                return f, FLOAT64
            # Default / mixed / string: return STRING_PTR so cssc::outln
            # / display.text dispatch to the cssc_str-aware printers.
            result = b.call(
                'cssc_bind_entry_pair_cell_val',
                [ent_ptr, row_id, col_id],
                [PTR, INT64, INT64],
                return_type=STRING_PTR, external=True,
            )
            return result, STRING_PTR
    kind, slot_id = _resolve_container_target(b, node.get('object', {}), line)
    if kind == 'map_si':
        return _lower_map_si_index_read(b, slot_id, node['index'], line)
    if kind == 'map_ss':
        return _lower_map_ss_index_read(b, slot_id, node['index'], line)
    if kind == 'map_is':
        return _lower_map_is_index_read(b, slot_id, node['index'], line)
    if kind == 'map_ii':
        return _lower_map_ii_index_read(b, slot_id, node['index'], line)
    if kind == 'map_sf':
        return _lower_map_sf_index_read(b, slot_id, node['index'], line)
    if kind == 'map_if':
        return _lower_map_if_index_read(b, slot_id, node['index'], line)
    if kind == 'bind_entry':
        ent_ptr = b.slot_load(slot_id, 'bind_entry')
        idx_id, idx_ty = _lower_expr(b, node['index'], expected_kind='int')
        if idx_ty.kind != 'i64':
            raise _csscerror(
                detail=f'bind cell index must be int (got {idx_ty.kind})',
                line=line,
            )
        cell_kind = _BIND_CELL_KIND.get(slot_id, 'mixed')
        effective_kind = expected_kind or cell_kind
        if effective_kind == 'int' or effective_kind == 'bool':
            # Return raw 64-bit cell bits as INT64 (int / bool cells
            # are stored sign-extended; the caller takes the value
            # as-is). String / ptr cells would yield the ptr cast to
            # i64 — meaningless for an int-typed sink, so the caller
            # must be sure the cell is numeric.
            result = b.call('cssc_bind_entry_cell_int',
                            [ent_ptr, idx_id], [PTR, INT64],
                            return_type=INT64, external=True)
            if effective_kind == 'bool':
                zero = b.const_int(0)
                return b.cmp_int('!=', result, zero), BOOL
            return result, INT64
        if effective_kind == 'float':
            raw = b.call('cssc_bind_entry_cell_int',
                          [ent_ptr, idx_id], [PTR, INT64],
                          return_type=INT64, external=True)
            f = b.call('__cssc_bitcast_i64_f64', [raw], [INT64],
                        return_type=FLOAT64, external=True)
            return f, FLOAT64
        # Default: return as STRING_PTR (suitable for string cells —
        # cssc_str* — which is by far the most common heap-cell shape
        # users push into binds). The wrapper `cssc_bind_entry_cell_val`
        # returns the cell's raw 64-bit value cast to ptr; for string
        # cells that's a real cssc_str pointer. Tagging it STRING_PTR
        # (not bare PTR) drives downstream dispatch (e.g.
        # `_outln_runtime_symbol`) to `cssc_print_string` — a 1-arg
        # cssc_str-aware printer — instead of `cssc_print_str(ptr, len)`
        # which would treat the cssc_str header as raw bytes and
        # garble output. Non-string ptr cells are a niche case the
        # user can disambiguate by an explicit cast (TODO: dedicated
        # tag-dispatching cell-getter for true heterogeneous reads).
        result = b.call('cssc_bind_entry_cell_val',
                        [ent_ptr, idx_id], [PTR, INT64],
                        return_type=STRING_PTR, external=True)
        return result, STRING_PTR
    if kind == 'string':
        s_ptr = b.slot_load(slot_id, 'string')
        idx_id, idx_ty = _lower_expr(b, node['index'], expected_kind='int')
        if idx_ty.kind != 'i64':
            raise _csscerror(
                detail=f'string[i]: index must be int (got {idx_ty.kind})',
                line=line,
            )
        r = b.call('cssc_string_get_byte', [s_ptr, idx_id], [PTR, INT64],
                   return_type=INT64, external=True)
        return r, INT64
    if kind not in ('vector_int', 'vector_float', 'array_int', 'array_float',
                    'vector_bool', 'array_bool',
                    'vector_string', 'array_string'):
        raise _csscerror(
            detail=f"Phase 3: indexed read on {kind!r} not supported",
            hint='vector<T>[i], array<T>[i], map<string,int>["k"], '
                 'bind_entry[i], string[i] are implemented',
            line=line,
        )
    traits = _vector_traits(kind)
    vec_ptr = b.slot_load(slot_id, kind)
    idx_id, idx_ty = _lower_expr(b, node['index'], expected_kind='int')
    if idx_ty.kind != 'i64':
        raise _csscerror(
            detail=f'index must be int (got {idx_ty.kind})', line=line,
        )
    result = b.call(f'cssc_vector_get_{traits["rt"]}',
                    [vec_ptr, idx_id], [PTR, INT64],
                    return_type=traits['elem'], external=True)
    return result, traits['elem']


def _bind_value_to_i64(b: CIRBuilder, value_node: dict,
                       expected_cell_kind: str,
                       line: Optional[int]) -> int:
    """Lower a value expression and convert it to the raw i64 bit
    pattern bind cells store.

    `expected_cell_kind` is the slot's tracked homogeneous cell kind
    ('int', 'float', 'string', 'bool', 'mixed'); used as a hint when
    the value's lowering needs guidance (e.g. a string literal in
    arg-position is normally parser-rejected, but here we accept the
    cell-typed flow). The returned SSA id has CIR type INT64 and is
    safe to pass to `cssc_bind_entry_*_set`.
    """
    val_id, val_ty = _lower_expr(b, value_node,
                                  expected_kind=expected_cell_kind)
    if val_ty.kind == 'i64':
        return val_id
    if val_ty.kind == 'i1':
        # Zext i1 → i64 via the existing helper. Bool cells store 0/1
        # in the cell bits.
        return b.call('__cssc_zext_i1_i64', [val_id], [BOOL],
                       return_type=INT64, external=True)
    if val_ty.kind == 'f64':
        return b.call('__cssc_bitcast_f64_i64', [val_id], [FLOAT64],
                       return_type=INT64, external=True)
    if val_ty.kind == 'f32':
        promoted = b.call('__extendsfdf2', [val_id], [FLOAT32],
                           return_type=FLOAT64, external=True)
        return b.call('__cssc_bitcast_f64_i64', [promoted], [FLOAT64],
                       return_type=INT64, external=True)
    if val_ty.kind in ('string_ptr', 'ptr'):
        return b.call('__cssc_bitcast_ptr_i64', [val_id], [PTR],
                       return_type=INT64, external=True)
    raise _csscerror(
        detail=(f'bind cell write: value kind {val_ty.kind!r} '
                f'can\'t be stored in a bind cell yet'),
        line=line,
    )


def _lower_index_assign(b: CIRBuilder, node: dict) -> None:
    """Lower `obj[idx] = value;` as a statement."""
    line = node.get('line')
    # Chained bind write: `particles[row][col] = value;`. Detect BEFORE
    # the regular slot resolution so we don't go through the "container
    # target must be a slot" rejection path.
    outer_obj = node.get('object') or {}
    if isinstance(outer_obj, dict) and outer_obj.get('type') in ('index',
                                                                   'index_access'):
        innermost = outer_obj.get('object') or {}
        try:
            inner_kind, inner_slot = _resolve_container_target(b, innermost, line)
        except Exception:
            inner_kind = None
            inner_slot = None
        if inner_kind == 'bind_entry':
            ent_ptr = b.slot_load(inner_slot, 'bind_entry')
            row_id, row_ty = _lower_expr(b, outer_obj.get('index'),
                                          expected_kind='int')
            if row_ty.kind != 'i64':
                raise _csscerror(
                    detail=f'bind row index must be int (got {row_ty.kind})',
                    line=line,
                )
            col_id, col_ty = _lower_expr(b, node.get('index'),
                                          expected_kind='int')
            if col_ty.kind != 'i64':
                raise _csscerror(
                    detail=f'bind column index must be int (got {col_ty.kind})',
                    line=line,
                )
            cell_kind = _BIND_CELL_KIND.get(inner_slot, 'mixed')
            val_id_i64 = _bind_value_to_i64(b, node['value'], cell_kind, line)
            b.call('cssc_bind_entry_pair_cell_set',
                   [ent_ptr, row_id, col_id, val_id_i64],
                   [PTR, INT64, INT64, INT64],
                   return_type=VOID, external=True)
            return
    kind, slot_id = _resolve_container_target(b, node.get('object', {}), line)
    if kind == 'map_si':
        _lower_map_si_index_assign(b, slot_id, node['index'], node['value'], line)
        return
    if kind == 'map_ss':
        _lower_map_ss_index_assign(b, slot_id, node['index'], node['value'], line)
        return
    if kind == 'map_is':
        _lower_map_is_index_assign(b, slot_id, node['index'], node['value'], line)
        return
    if kind == 'map_ii':
        _lower_map_ii_index_assign(b, slot_id, node['index'], node['value'], line)
        return
    if kind == 'map_sf':
        _lower_map_sf_index_assign(b, slot_id, node['index'], node['value'], line)
        return
    if kind == 'map_if':
        _lower_map_if_index_assign(b, slot_id, node['index'], node['value'], line)
        return
    if kind == 'bind_entry':
        # Flat single-index bind write: `particles[i] = value;`.
        ent_ptr = b.slot_load(slot_id, 'bind_entry')
        idx_id, idx_ty = _lower_expr(b, node['index'], expected_kind='int')
        if idx_ty.kind != 'i64':
            raise _csscerror(
                detail=f'bind cell index must be int (got {idx_ty.kind})',
                line=line,
            )
        cell_kind = _BIND_CELL_KIND.get(slot_id, 'mixed')
        val_id_i64 = _bind_value_to_i64(b, node['value'], cell_kind, line)
        b.call('cssc_bind_entry_cell_set',
               [ent_ptr, idx_id, val_id_i64],
               [PTR, INT64, INT64],
               return_type=VOID, external=True)
        return
    if kind == 'string':
        # Doc §3.3: `s[i] = 'c';` byte-level mutation of a string slot.
        # Loads the cssc_str* from the slot, evaluates the index + char,
        # and writes one byte via the runtime helper.
        str_ptr = b.slot_load(slot_id, 'string')
        idx_id, idx_ty = _lower_expr(b, node['index'], expected_kind='int')
        if idx_ty.kind != 'i64':
            raise _csscerror(
                detail=f'string[i] = c: index must be int '
                       f'(got {idx_ty.kind})',
                line=line,
            )
        # Char-literal shortcut: `'o'` parses as a 1-byte string AST
        # node. In an `s[i] = …` context we treat its first byte as
        # an i64 (char code) — matching the spec's char-mutation
        # ergonomics. Multi-byte literals fall through to the
        # type-mismatch error below.
        val_node = node['value']
        if (isinstance(val_node, dict) and val_node.get('type') == 'string'
                and len(val_node.get('value', '').encode('utf-8')) == 1):
            byte_val = val_node['value'].encode('utf-8')[0]
            val_id = b.const_int(byte_val)
            val_ty = INT64
        else:
            val_id, val_ty = _lower_expr(b, val_node, expected_kind='int')
        if val_ty.kind != 'i64':
            raise _csscerror(
                detail=(f"string[i] = c: value must be a char/int "
                        f"(got {val_ty.kind}). Use a single-char "
                        f"literal like 'o' or an int in 0..255."),
                line=line,
            )
        b.call('cssc_string_set_byte',
               [str_ptr, idx_id, val_id],
               [PTR, INT64, INT64],
               return_type=VOID, external=True)
        return
    if kind not in ('vector_int', 'vector_float',
                    'vector_bool',     # Phase A.1
                    'vector_string',   # Phase A.2 (refcount cascade on set)
                    'array_int', 'array_float',
                    'array_bool', 'array_string'):  # array shares vector set()
        raise _csscerror(
            detail=f"Phase 3: indexed write on {kind!r} not supported",
            hint='vector<T>[i] = v and map<string,int>["k"] = v are implemented',
            line=line,
        )
    traits = _vector_traits(kind)
    elem_ty = traits['elem']
    expected = traits['expected']

    vec_ptr = b.slot_load(slot_id, kind)
    idx_id, idx_ty = _lower_expr(b, node['index'], expected_kind='int')
    val_id, val_ty = _lower_expr(b, node['value'], expected_kind=expected)
    if idx_ty.kind != 'i64':
        raise _csscerror(
            detail=f'{kind}[i] = v: index must be int (got {idx_ty.kind})',
            line=line,
        )
    # Phase A.2: vector_string[i] = v accepts string-shaped values
    # (string_ptr from slot loads, ptr from raw literals — promoted).
    if kind == 'vector_string':
        if val_ty.kind == 'ptr':
            raw_text = (node['value'].get('value', '')
                        if isinstance(node.get('value'), dict)
                            and node['value'].get('type') == 'string'
                        else '')
            val_id = b.string_from_lit(raw_text)
        elif val_ty.kind != 'string_ptr':
            raise _csscerror(
                detail=f'vector<string>[i] = v: value must be a string '
                       f'(got {val_ty.kind})',
                line=line,
            )
        set_arg_ty = PTR
    elif not _slot_kinds_compatible(val_ty.kind, elem_ty.kind):
        raise _csscerror(
            detail=f'{kind}[i] = v: value must be {expected} '
                   f'(got {val_ty.kind})',
            line=line,
        )
    else:
        set_arg_ty = elem_ty
    b.call(f'cssc_vector_set_{traits["rt"]}',
           [vec_ptr, idx_id, val_id], [PTR, INT64, set_arg_ty],
           return_type=VOID, external=True)


def _lower_dot_call_expr(b: CIRBuilder, node: dict) -> Tuple[int, CIRType]:
    """Lower a method call: `obj.method(args)`.

    Three dispatch families:
      * Select-label `.pos()` — `?i.pos()` returns the current cursor.
      * Container methods: `xs.size()`, `m.has(k)`, `b.push_back(k, v)`,
        etc. The object must be a known slot of a container kind.
      * Object-instance methods (Phase 4c): `inst.label()` where `inst`
        is a handle returned by `Object() inst;`. Dispatches to the
        object's `cssc_obj_<Object>_<label>` function.
    """
    line = node.get('line')
    method = node.get('method', '')
    obj_node = node.get('object', {})

    # `?label.pos()` — resolves to the cursor of the enclosing select.
    if (obj_node.get('type') == 'identifier'
            and method == 'pos'
            and not (node.get('args') or [])):
        ident = obj_node.get('name', '')
        cursor_slot = _select_pos_lookup(b, ident)
        if cursor_slot is not None:
            cur_val = b.slot_load(cursor_slot, 'int')
            return cur_val, INT64

    # Phase 4d/e: object-instance dispatch — load %inst from the handle
    # slot and pass it as `self`, plus any label arguments after.
    if obj_node.get('type') == 'identifier':
        inst_name = obj_node.get('name', '')
        if inst_name in _INSTANCES:
            obj_type = _INSTANCES[inst_name]
            obj_info = _OBJECTS.get(obj_type, {})
            labels = obj_info.get('labels', {})
            # Arity-based overload resolution: if the user wrote
            # `inst.tick(args)` and `tick` was declared with multiple
            # arities (`tick:` + `tick<int: dur>:`), pick the synthetic
            # `<method>__a<arity>` symbol matching the call arity.
            call_args_count = len(node.get('args') or [])
            overload_aliases = obj_info.get('overload_aliases', {})
            if method in overload_aliases:
                for (a, synth_name) in overload_aliases[method]:
                    if a == call_args_count:
                        method = synth_name
                        break
                else:
                    available = sorted({a for (a, _) in overload_aliases[method]})
                    raise _csscerror(
                        detail=f"object {obj_type}.{method}({call_args_count} "
                               f"arg{'s' if call_args_count != 1 else ''}): "
                               f"no overload with that arity",
                        hint=f'available arities: {available}',
                        line=line,
                    )
            if method not in labels:
                raise _csscerror(
                    detail=f"object {obj_type} has no label {method!r}",
                    hint=f'declared labels: {sorted(labels.keys())}',
                    line=line,
                )
            if not b.scope_has(inst_name):
                raise _csscerror(
                    detail=f'object handle {inst_name!r} not bound (was it freed?)',
                    line=line,
                )
            handle = b.scope_lookup(inst_name)
            inst_ptr = b.slot_load(handle, 'object_handle')

            # Resolve label params + lower each call arg with its expected kind.
            label_params = obj_info.get('label_params', {}).get(method, []) or []
            call_args = node.get('args', []) or []
            if len(call_args) != len(label_params):
                raise _csscerror(
                    detail=f'{inst_name}.{method}() expects {len(label_params)} '
                           f'arg(s), got {len(call_args)}',
                    line=line,
                )
            arg_ssa: List[int] = []
            arg_tys: List[CIRType] = []
            for arg_node, (pname, pkind) in zip(call_args, label_params):
                if pkind == 'auto':
                    # auto: ABI is (val: i64, tag: i64). Lower the call
                    # arg via the bind-cell helper to get the right tag,
                    # then forward both as the two physical args.
                    v_id, t_id, _src = _lower_bind_cell(b, arg_node, line)
                    arg_ssa.append(v_id)
                    arg_tys.append(INT64)
                    arg_ssa.append(t_id)
                    arg_tys.append(INT64)
                    continue
                if (isinstance(arg_node, dict)
                        and arg_node.get('type') in ('array', 'array_literal')
                        and pkind in ('array_int', 'array_float',
                                      'array_bool', 'array_string',
                                      'array_bind',
                                      'vector_int', 'vector_float',
                                      'vector_bool', 'vector_string')):
                    items = (arg_node.get('items')
                             or arg_node.get('elements') or [])
                    capBytes = max(len(items) * 16, 256)
                    tmpSlot = b.slot_alloc(pkind, capBytes)
                    _init_vector(b, tmpSlot, pkind, arg_node, capBytes, line)
                    arg_ssa.append(b.slot_load(tmpSlot, pkind))
                    arg_tys.append(PTR)
                    continue
                v_id, v_ty = _lower_expr(b, arg_node, expected_kind=pkind)
                want_ty = _kind_to_cir_storage(pkind)
                if not _slot_kinds_compatible(v_ty.kind, want_ty.kind):
                    raise _csscerror(
                        detail=f'{inst_name}.{method}() arg {pname!r}: kind '
                               f'{v_ty.kind!r} cannot satisfy {pkind!r}',
                        line=line,
                    )
                arg_ssa.append(v_id)
                arg_tys.append(want_ty)
                # v6 ref-by-default (Bug 3 fix): if the caller-side arg
                # is a bare identifier bound to an in-scope slot, register
                # the alias so `#delete[arg]` inside the method body
                # propagates back to the caller's slot via the runtime
                # alias table.
                if (isinstance(arg_node, dict)
                        and arg_node.get('type') == 'identifier'):
                    src_name = (arg_node.get('name') or '').strip()
                    if src_name and b.scope_has(src_name):
                        src_slot = b.scope_lookup(src_name)
                        _emit_arg_link(b, pname, src_slot)

            # Use the label's pre-scanned return kind so `inst.tick() r;`
            # captures whatever the label `mirror`s. Void labels still
            # return -1/VOID; value-returning labels surface their kind.
            label_returns = obj_info.get('label_returns', {})
            ret_kind = label_returns.get(method)
            ret_ty = _kind_to_cir_storage(ret_kind) if ret_kind else VOID
            result_id = b.call(labels[method], [inst_ptr] + arg_ssa,
                               [PTR] + arg_tys,
                               return_type=ret_ty, external=False)
            if ret_ty.is_void():
                return b.const_int(0), INT64
            return result_id, ret_ty

    kind, slot_id = _resolve_container_target(b, obj_node, line)

    if kind in ('vector_int', 'vector_float', 'array_int', 'array_float',
                 'array_string',
                 'vector_bool',     # Phase A.1
                 'vector_string',   # Phase A.2
                 'array_bool'):     # Phase A.3
        return _lower_vector_method(b, slot_id, kind, method,
                                    node.get('args', []) or [], line)

    if kind == 'map_si':
        return _lower_map_si_method(b, slot_id, method,
                                    node.get('args', []) or [], line)

    if kind == 'map_ss':
        return _lower_map_ss_method(b, slot_id, method,
                                    node.get('args', []) or [], line)

    if kind == 'map_is':
        return _lower_map_is_method(b, slot_id, method,
                                    node.get('args', []) or [], line)

    if kind == 'map_ii':
        return _lower_map_ii_method(b, slot_id, method,
                                    node.get('args', []) or [], line)

    if kind == 'map_sf':
        return _lower_map_sf_method(b, slot_id, method,
                                    node.get('args', []) or [], line)

    if kind == 'map_if':
        return _lower_map_if_method(b, slot_id, method,
                                    node.get('args', []) or [], line)

    if kind == 'bind_ss':
        return _lower_bind_ss_method(b, slot_id, method,
                                     node.get('args', []) or [], line)

    if kind == 'array_bind':
        return _lower_array_bind_method(b, slot_id, method,
                                        node.get('args', []) or [], line)

    if kind in ('pin', 'i2c', 'spi', 'uart', 'adc', 'pwm', 'timer',
                'tft', 'oled', 'video', 'matrix',
                'framebuffer', 'console'):
        return _lower_gpio_method(b, slot_id, kind, method,
                                  node.get('args', []) or [], line)

    if kind == 'string':
        return _lower_string_method(b, slot_id, method,
                                    node.get('args', []) or [], line)

    if kind == 'int':
        _MOUSE_METHOD_MAP = {
            'isOver': 'cssc_mouse_is_over',
            'is_over': 'cssc_mouse_is_over',
            'isClicked': 'cssc_mouse_is_clicked',
            'is_clicked': 'cssc_mouse_is_clicked',
            'isHeld': 'cssc_mouse_is_held',
            'is_held': 'cssc_mouse_is_held',
            'isReleased': 'cssc_mouse_is_released',
            'is_released': 'cssc_mouse_is_released',
            'getX': 'cssc_mouse_get_x',
            'get_x': 'cssc_mouse_get_x',
            'getY': 'cssc_mouse_get_y',
            'get_y': 'cssc_mouse_get_y',
            'getPos': 'cssc_mouse_get_pos',
            'get_pos': 'cssc_mouse_get_pos',
            'update': 'cssc_mouse_update',
            'sync': 'cssc_mouse_update',
            'clamp': 'cssc_mouse_update',
            'clampX': 'cssc_mouse_get_x',
            'clampY': 'cssc_mouse_get_y',
        }
        if method in _MOUSE_METHOD_MAP:
            slot_i64 = b.slot_load(slot_id, 'int')
            slot_ptr = b.int_to_ptr(slot_i64)
            m_args = node.get('args', []) or []
            arg_ids = [slot_ptr]
            llvm_arg_tys = [PTR]
            for a in m_args:
                v_id, v_ty = _lower_expr(b, a, expected_kind='int')
                if v_ty.kind == 'i1':
                    v_id = b.zext_bool_to_int(v_id)
                    v_ty = INT64
                if v_ty.kind != 'i64':
                    raise _csscerror(
                        detail=f'.{method}(): int arg required '
                               f'(got {v_ty.kind!r})',
                        line=line,
                    )
                arg_ids.append(v_id)
                llvm_arg_tys.append(INT64)
            sym = _MOUSE_METHOD_MAP[method]
            _MOUSE_VOID = {'cssc_mouse_update'}
            _MOUSE_RETURNS_PTR = {'cssc_mouse_get_pos'}
            if sym in _MOUSE_VOID:
                b.call(sym, arg_ids, llvm_arg_tys,
                       return_type=VOID, external=True)
                return (-1, VOID)
            if sym in _MOUSE_RETURNS_PTR:
                rid = b.call(sym, arg_ids, llvm_arg_tys,
                             return_type=PTR, external=True)
                return (rid, PTR)
            rid = b.call(sym, arg_ids, llvm_arg_tys,
                         return_type=INT64, external=True)
            return (rid, INT64)

    raise _csscerror(
        detail=f"dot-method on {kind!r} not supported in v6 native",
        hint='currently implemented: vector<T>, array<T>, map<string,int>, '
             'bind<string,string>, array<bind>, strings (length/size/empty/'
             'at), and peripherals (pin/i2c/spi/uart/adc/pwm/timer/tft/oled/'
             'video/matrix/framebuffer/console)',
        line=line,
    )


def _lower_string_method(b: CIRBuilder, slot_id: int, method: str,
                          args: list,
                          line: Optional[int]) -> Tuple[int, CIRType]:
    s_ptr = b.slot_load(slot_id, 'string')
    if method in ('length', 'size'):
        if args:
            raise _csscerror(
                detail=f'string.{method}() takes no arguments', line=line)
        r = b.call('cssc_string_size', [s_ptr], [PTR],
                   return_type=INT64, external=True)
        return r, INT64
    if method == 'empty':
        if args:
            raise _csscerror(
                detail='string.empty() takes no arguments', line=line)
        sz = b.call('cssc_string_size', [s_ptr], [PTR],
                    return_type=INT64, external=True)
        return b.cmp_int('==', sz, b.const_int(0)), BOOL
    if method == 'at':
        if len(args) != 1:
            raise _csscerror(
                detail='string.at(i) expects 1 int argument', line=line)
        idx_id, idx_ty = _lower_expr(b, args[0], expected_kind='int')
        if idx_ty.kind != 'i64':
            raise _csscerror(
                detail=f'string.at(i): index must be int (got {idx_ty.kind})',
                line=line)
        r = b.call('cssc_string_get_byte', [s_ptr, idx_id], [PTR, INT64],
                   return_type=INT64, external=True)
        return r, INT64
    raise _csscerror(
        detail=f"string.{method}() not yet supported",
        hint='available: .length() / .size() / .empty() / .at(i)',
        line=line,
    )


# Per-peripheral method table. Keyed by (kind, method) → (call args (i64 ids
# in order), runtime return type, runtime arg-types for the LLVM call).
# Only the methods the user code touches turn into runtime symbols, so a
# `#pin` that's never read costs zero bytes of read-path code on the chip.
_GPIO_METHODS = {
    # `pin`: digital I/O + edge-detection helpers.
    ('pin', 'write'):    (1, VOID, [PTR, INT64]),
    ('pin', 'read'):     (0, INT64, [PTR]),
    ('pin', 'mode'):     (1, VOID, [PTR, INT64]),
    ('pin', 'toggle'):   (0, VOID, [PTR]),
    ('pin', 'pullup'):   (1, VOID, [PTR, INT64]),
    # `i2c`: master-mode transfer surface. `begin(freq)` configures the
    # bus clock frequency in Hz; `freq=0` means "use the chip default"
    # (100 kHz on most parts). Variable-arity is encoded as a tuple of
    # accepted arities in `_GPIO_VARIADIC_METHODS` below.
    ('i2c', 'begin'):    (1, VOID, [PTR, INT64]),
    ('i2c', 'write'):    (2, INT64, [PTR, INT64, INT64]),  # addr, byte
    ('i2c', 'read'):     (1, INT64, [PTR, INT64]),          # addr
    # `spi`: byte-oriented transfer. `begin(freq)` sets SCK frequency.
    ('spi', 'begin'):    (1, VOID, [PTR, INT64]),
    ('spi', 'transfer'): (1, INT64, [PTR, INT64]),
    # `uart`: byte-stream.
    ('uart', 'begin'):   (1, VOID, [PTR, INT64]),     # baud
    ('uart', 'write'):   (1, VOID, [PTR, INT64]),     # byte
    ('uart', 'read'):    (0, INT64, [PTR]),
    # `adc`: 10/12-bit sample.
    ('adc', 'read'):     (0, INT64, [PTR]),
    # `pwm`: duty-cycle.
    ('pwm', 'duty'):     (1, VOID, [PTR, INT64]),
    # `timer`: arm + read.
    ('timer', 'start'):  (0, VOID, [PTR]),
    ('timer', 'stop'):   (0, VOID, [PTR]),
    ('timer', 'read'):   (0, INT64, [PTR]),
    # `tft` / `oled` displays — drawing primitives + framebuffer flush.
    # String-typed args (the `text` call's body) come through as STRING_PTR;
    # _lower_gpio_method dispatches on the runtime arg type to call
    # _lower_expr with the right expected_kind.
    ('tft',  'begin'):     (0, VOID,  [PTR]),
    ('tft',  'close'):     (0, VOID,  [PTR]),
    ('tft',  'fill'):      (1, VOID,  [PTR, INT64]),
    ('tft',  'show'):      (0, VOID,  [PTR]),
    ('tft',  'line'):      (5, VOID,  [PTR, INT64, INT64, INT64, INT64, INT64]),
    ('tft',  'rect'):      (5, VOID,  [PTR, INT64, INT64, INT64, INT64, INT64]),
    ('tft',  'fillrect'):  (5, VOID,  [PTR, INT64, INT64, INT64, INT64, INT64]),
    ('tft',  'circle'):    (4, VOID,  [PTR, INT64, INT64, INT64, INT64]),
    ('tft',  'pixel'):     (3, VOID,  [PTR, INT64, INT64, INT64]),
    ('tft',  'text'):      (5, VOID,  [PTR, INT64, INT64, STRING_PTR, INT64, INT64]),
    # `oled` is the same runtime as `tft` — alias every method.
    ('oled', 'begin'):     (0, VOID,  [PTR]),
    ('oled', 'close'):     (0, VOID,  [PTR]),
    ('oled', 'fill'):      (1, VOID,  [PTR, INT64]),
    ('oled', 'show'):      (0, VOID,  [PTR]),
    ('oled', 'line'):      (5, VOID,  [PTR, INT64, INT64, INT64, INT64, INT64]),
    ('oled', 'rect'):      (5, VOID,  [PTR, INT64, INT64, INT64, INT64, INT64]),
    ('oled', 'fillrect'):  (5, VOID,  [PTR, INT64, INT64, INT64, INT64, INT64]),
    ('oled', 'circle'):    (4, VOID,  [PTR, INT64, INT64, INT64, INT64]),
    ('oled', 'pixel'):     (3, VOID,  [PTR, INT64, INT64, INT64]),
    ('oled', 'text'):      (5, VOID,  [PTR, INT64, INT64, STRING_PTR, INT64, INT64]),
    # `video` — host-window backend (Win32) / no-op elsewhere.
    ('video', 'begin'):    (0, VOID,  [PTR]),
    ('video', 'close'):    (0, VOID,  [PTR]),
    ('video', 'clear'):    (1, VOID,  [PTR, INT64]),
    ('video', 'present'):  (0, VOID,  [PTR]),
    ('video', 'is_open'):  (0, INT64, [PTR]),
    # `matrix` — uniform pixel buffer w/ blit-style ops.
    ('matrix', 'fill'):    (1, VOID,  [PTR, INT64]),
    ('matrix', 'pixel'):   (3, VOID,  [PTR, INT64, INT64, INT64]),
    ('matrix', 'show'):    (0, VOID,  [PTR]),
    # `framebuffer` — pixel buffer for software rendering.
    ('framebuffer', 'fill'):   (1, VOID, [PTR, INT64]),
    ('framebuffer', 'pixel'):  (3, VOID, [PTR, INT64, INT64, INT64]),
    ('framebuffer', 'present'):(0, VOID, [PTR]),
    # `console` — native console window on Windows / stderr elsewhere.
    ('console', 'write'):  (1, VOID, [PTR, STRING_PTR]),
    ('console', 'out'):    (1, VOID, [PTR, STRING_PTR]),
    ('console', 'clear'):  (0, VOID, [PTR]),
    ('console', 'close'):  (0, VOID, [PTR]),
    ('console', 'sync'):   (2, VOID, [PTR, STRING_PTR, PTR]),
    ('console', 'desync'): (1, VOID, [PTR, STRING_PTR]),
    ('video', 'pixel'):    (3, VOID, [PTR, INT64, INT64, INT64]),
    ('video', 'getPixel'): (2, INT64, [PTR, INT64, INT64]),
    ('video', 'get_pixel'):(2, INT64, [PTR, INT64, INT64]),
    ('video', 'hwnd'):     (0, PTR,  [PTR]),
}


def _lower_gpio_method(b: CIRBuilder, slot_id: int, kind: str,
                       method: str, args: list,
                       line: Optional[int]) -> Tuple[int, CIRType]:
    """Lower a peripheral method (`pin.write(1)`, `adc.read()`, …).

    Looks up `(kind, method)` in `_GPIO_METHODS` to find the expected
    arity and runtime signature, lowers each arg as int, then emits
    `cssc_<kind>_<method>(handle, args…)`. The handle is loaded from
    the slot at every method call so concurrent writes to the slot
    (rare but legal) are observed.
    """
    entry = _GPIO_METHODS.get((kind, method))
    if entry is None:
        known = sorted({m for k, m in _GPIO_METHODS if k == kind})
        raise _csscerror(
            detail=f'.{method}() not implemented for #{kind} handles',
            hint=f'known methods for #{kind}: {known}',
            line=line,
        )
    arity, ret_ty, arg_tys = entry
    # `begin()` accepts 0 OR `arity` arguments — missing trailing args
    # default to 0 (which the host runtime interprets as "chip default
    # configuration"). For every other method the caller must supply
    # the exact arity.
    accepts_short = method == 'begin'
    if len(args) > arity or (len(args) != arity and not accepts_short):
        raise _csscerror(
            detail=f'#{kind}.{method}() takes {arity} arg(s), got {len(args)}',
            line=line,
        )
    handle = b.slot_load(slot_id, kind)
    arg_ids: List[int] = [handle]
    # `arg_tys[0]` is always PTR for the handle; per-arg types follow.
    for i, a in enumerate(args):
        expected_llvm = arg_tys[i + 1] if i + 1 < len(arg_tys) else INT64
        if expected_llvm.kind == 'i64':
            v_id, v_ty = _lower_expr(b, a, expected_kind='int')
            if v_ty.kind != 'i64':
                raise _csscerror(
                    detail=f'#{kind}.{method}: arg {i+1} must be int '
                           f'(got {v_ty.kind!r})',
                    line=line,
                )
        elif expected_llvm.kind == 'string_ptr':
            v_id, v_ty = _lower_expr(b, a, expected_kind='string')
            # Auto-stringify primitive values in a string slot — matches
            # the binary-op auto-stringify in `_lower_binary`. Lets the
            # user pass `cssc::uptime()` or a tick counter where the
            # method signature expects a string.
            if v_ty.kind == 'i64':
                v_id = b.call('cssc_int_to_str', [v_id], [INT64],
                              return_type=STRING_PTR, external=True)
                v_ty = STRING_PTR
            elif v_ty.kind == 'f64':
                v_id = b.call('cssc_float_to_str', [v_id], [FLOAT64],
                              return_type=STRING_PTR, external=True)
                v_ty = STRING_PTR
            elif v_ty.kind == 'i1':
                v_id = b.call('cssc_bool_to_str', [v_id], [BOOL],
                              return_type=STRING_PTR, external=True)
                v_ty = STRING_PTR
            elif v_ty.kind == 'ptr':
                # A raw `ptr` likely came from a bare string literal that
                # escaped promotion; materialise it as a heap cssc_str.
                if a.get('type') == 'string':
                    v_id = b.string_from_lit(a.get('value', ''))
                    v_ty = STRING_PTR
                else:
                    # A `ptr` value pulled from a heterogeneous source
                    # (most commonly `bind_entry[i]` cell access where
                    # the cell holds a cssc_str* with tag=STRING). The
                    # underlying bits ARE a cssc_str*; just relabel the
                    # type so the call-site check is happy. If the cell
                    # actually holds an int/ptr-of-something-else the
                    # display routine will misinterpret it — that's a
                    # user-side type-discipline problem.
                    v_ty = STRING_PTR
            if v_ty.kind not in ('string_ptr',):
                raise _csscerror(
                    detail=f'#{kind}.{method}: arg {i+1} must be a string '
                           f'(got {v_ty.kind!r})',
                    line=line,
                )
            v_id = b.call('cssc_string_data', [v_id], [PTR],
                          return_type=PTR, external=True)
            v_ty = PTR
        elif expected_llvm.kind == 'ptr':
            v_id, v_ty = _lower_expr(b, a)
            if v_ty.kind == 'i64':
                v_id = b.int_to_ptr(v_id)
                v_ty = PTR
            elif v_ty.kind not in ('ptr', 'string_ptr', 'cssc_str_ptr'):
                raise _csscerror(
                    detail=(f'#{kind}.{method}: arg {i+1} must be a handle/'
                            f'pointer (got {v_ty.kind!r})'),
                    line=line,
                )
        else:
            raise _csscerror(
                detail=f'#{kind}.{method}: arg {i+1} kind '
                       f'{expected_llvm.kind!r} not supported in v6 native',
                line=line,
            )
        arg_ids.append(v_id)
    # Pad missing trailing args with `i64 0` so the runtime sees a stable
    # signature regardless of how many the caller supplied. Only meaningful
    # when `accepts_short` is true (currently: `begin`).
    while len(arg_ids) < len(arg_tys):
        arg_ids.append(b.const_int(0))
    sym = f'cssc_{kind}_{method}'
    result = b.call(sym, arg_ids, arg_tys,
                    return_type=ret_ty, external=True)
    if ret_ty.is_void():
        # Method-as-expression callers always need a usable value.
        return b.const_int(0), INT64
    return result, ret_ty


def _lower_vector_method(b: CIRBuilder, slot_id: int, slot_kind: str,
                         method: str, args: list,
                         line: Optional[int]) -> Tuple[int, CIRType]:
    """Lower a `vec.<method>(args)` call for vector<T> / array<T>.

    The runtime symbol names share a common shape: `cssc_vector_<verb>_<rt>`
    where `<rt>` ∈ {'int', 'float', 'bool', 'string'}. `array_*` slots
    share the runtime AND the full mutable method surface (push/pop/
    clear/set) — they differ from `vector_*` only nominally.
    """
    traits = _vector_traits(slot_kind)
    elem_ty = traits['elem']
    rt = traits['rt']
    expected = traits['expected']

    vec_ptr = b.slot_load(slot_id, slot_kind)

    if method == 'size':
        if args:
            raise _csscerror(detail='vector.size() takes no arguments', line=line)
        r = b.call(f'cssc_vector_size_{rt}', [vec_ptr], [PTR],
                   return_type=INT64, external=True)
        return r, INT64

    if method in ('push_back', 'push', 'add'):
        if len(args) != 1:
            raise _csscerror(
                detail=f'vector.{method}(value) expects exactly 1 argument',
                line=line,
            )
        val_id, val_ty = _lower_expr(b, args[0], expected_kind=expected)
        # Phase A.2: vector<string>.push_back accepts both string_ptr
        # (heap cssc_str* from concat / *_to_str) and raw ptr (literal-
        # pool address from a parser-level `"…"` string literal). The
        # runtime push adopts a refcount-managed entry, so raw literals
        # must be promoted via `string_from_lit` first — otherwise the
        # container stores a non-heap ptr and `cssc_print_string` later
        # reads the literal-pool bytes as a cssc_str header (garbage).
        # The bare-literal-init path (`_init_vector`) already does this;
        # the method path needs the same shim.
        if slot_kind == 'vector_string' and val_ty.kind == 'ptr':
            raw_text = (args[0].get('value', '')
                        if args[0].get('type') == 'string' else '')
            val_id = b.string_from_lit(raw_text)
            val_ty = STRING_PTR
        if not _slot_kinds_compatible(val_ty.kind, elem_ty.kind):
            raise _csscerror(
                detail=f'vector<{expected}>.{method}: value must be {expected} '
                       f'(got {val_ty.kind})',
                line=line,
            )
        # Container-ownership: cssc_vector_push_string ADOPTS the ptr (takes
        # ownership without retaining). When the pushed value BORROWS a live
        # owner — a named string slot / member / element (e.g. the itemdb
        # `#stack[string] nm = ini::read(...); _name.push_back(nm); ...;
        # #delete[nm];` load loop) — the vector must take its OWN reference,
        # else the caller's later `#delete` frees the vector's entry and it
        # dangles (reads back garbage / crashes). Transients (string
        # literals / concat / call results) are already refcount=1 with no
        # other owner, so they must NOT be retained (that would leak). Same
        # borrow-vs-transient rule as _rhs_is_string_alias for string slots.
        if slot_kind == 'vector_string' and _rhs_is_string_alias(args[0]):
            b.call('cssc_retain', [val_id], [PTR],
                   return_type=VOID, external=True)
        # The runtime sig is `cssc_vector_push_string(ptr, ptr)` — pass
        # PTR (not STRING_PTR, which is a builder-side dispatch marker
        # the LLVM emitter doesn't recognise as a distinct arg shape).
        push_arg_ty = (PTR if slot_kind == 'vector_string' else elem_ty)
        b.call(f'cssc_vector_push_{rt}', [vec_ptr, val_id],
               [PTR, push_arg_ty], return_type=VOID, external=True)
        return -1, VOID

    if method in ('pop_back', 'pop'):
        if args:
            raise _csscerror(detail=f'vector.{method}() takes no arguments',
                             line=line)
        r = b.call(f'cssc_vector_pop_back_{rt}', [vec_ptr], [PTR],
                   return_type=elem_ty, external=True)
        return r, elem_ty

    if method == 'clear':
        if args:
            raise _csscerror(detail='vector.clear() takes no arguments',
                             line=line)
        b.call(f'cssc_vector_clear_{rt}', [vec_ptr], [PTR],
               return_type=VOID, external=True)
        return -1, VOID

    raise _csscerror(
        detail=f"Phase 3: vector<{expected}> method {method!r} not yet "
               f"implemented",
        hint='supported: size, push_back/push/add, pop_back/pop, clear',
        line=line,
    )


# Back-compat alias for the previous, mono-int helper name.
def _lower_vector_int_method(b: CIRBuilder, slot_id: int, method: str,
                             args: list,
                             line: Optional[int]) -> Tuple[int, CIRType]:
    return _lower_vector_method(b, slot_id, 'vector_int', method, args, line)


def _store_to_slot(b: CIRBuilder, slot_id: int, slot_kind: str,
                   value_id: int, value_type: CIRType,
                   line: Optional[int],
                   rhs_node: Optional[dict] = None) -> None:
    """Adapt the value to the slot's storage shape and emit slot_store.

    For float slots we look up the slot's declared bit width to decide
    between f32 and f64 storage. Cross-precision stores insert the
    matching libgcc conversion thunk (`__truncdfsf2` for f64→f32 and
    `__extendsfdf2` for f32→f64) so the user can write
    `#stack[float, 32] x = 1.5 + 2.5;` and the binary's f64 result gets
    truncated to the slot's f32 storage automatically.
    """
    if slot_kind == 'int':
        if value_type.kind == 'i64':
            b.slot_store(slot_id, value_id, INT64)
            return
        if value_type.kind == 'i1':
            zext_id = b.zext_bool_to_int(value_id)
            b.slot_store(slot_id, zext_id, INT64)
            return
        if value_type.kind == 'f64':
            i64_id = b.fptosi_to_int(value_id)
            b.slot_store(slot_id, i64_id, INT64)
            return
        if value_type.kind == 'f32':
            ext_id = b.call('__extendsfdf2', [value_id], [FLOAT32],
                            return_type=FLOAT64, external=True)
            i64_id = b.fptosi_to_int(ext_id)
            b.slot_store(slot_id, i64_id, INT64)
            return
        if value_type.kind in ('ptr', 'string_ptr'):
            i64_id = b.ptr_to_int(value_id)
            b.slot_store(slot_id, i64_id, INT64)
            return
        raise _csscerror(detail=f'int slot cannot adopt a {value_type.kind} value',
                         line=line)
    if slot_kind == 'bool':
        if value_type.kind == 'i1':
            b.slot_store(slot_id, value_id, BOOL)
            return
        if value_type.kind == 'i64':
            zero = b.const_int(0)
            nonzero = b.cmp_int('!=', value_id, zero)
            b.slot_store(slot_id, nonzero, BOOL)
            return
        raise _csscerror(detail=f'bool slot cannot adopt a {value_type.kind} value',
                         line=line)
    if slot_kind == 'float':
        # noqa: SLF001 — the slot_bits side-table is owned by the builder
        # and intentionally exposed to lowering passes.
        slot_bits = b._slot_bits.get(slot_id, 64)   # noqa: SLF001
        slot_ty_kind = 'f32' if slot_bits == 32 else 'f64'
        if value_type.kind == slot_ty_kind:
            b.slot_store(slot_id, value_id,
                         FLOAT32 if slot_bits == 32 else FLOAT64)
            return
        if value_type.kind == 'f64' and slot_ty_kind == 'f32':
            trunc_id = b.call('__truncdfsf2', [value_id], [FLOAT64],
                              return_type=FLOAT32, external=True)
            b.slot_store(slot_id, trunc_id, FLOAT32)
            return
        if value_type.kind == 'f32' and slot_ty_kind == 'f64':
            ext_id = b.call('__extendsfdf2', [value_id], [FLOAT32],
                            return_type=FLOAT64, external=True)
            b.slot_store(slot_id, ext_id, FLOAT64)
            return
        if value_type.kind == 'i64':
            f64_id = b.sitofp_to_double(value_id)
            if slot_ty_kind == 'f32':
                trunc_id = b.call('__truncdfsf2', [f64_id], [FLOAT64],
                                  return_type=FLOAT32, external=True)
                b.slot_store(slot_id, trunc_id, FLOAT32)
            else:
                b.slot_store(slot_id, f64_id, FLOAT64)
            return
        if value_type.kind == 'i1':
            zext_id = b.zext_bool_to_int(value_id)
            f64_id = b.sitofp_to_double(zext_id)
            if slot_ty_kind == 'f32':
                trunc_id = b.call('__truncdfsf2', [f64_id], [FLOAT64],
                                  return_type=FLOAT32, external=True)
                b.slot_store(slot_id, trunc_id, FLOAT32)
            else:
                b.slot_store(slot_id, f64_id, FLOAT64)
            return
        raise _csscerror(detail=f'float slot cannot adopt a {value_type.kind} value',
                         line=line)
    if slot_kind == 'string':
        if value_type.kind not in ('ptr', 'string_ptr'):
            raise _csscerror(
                detail=(f'string slot cannot adopt a {value_type.kind} '
                        f'value — assignment expects a string literal, '
                        f'another string slot, or a concat expression'),
                line=line,
            )
        # A raw `ptr`-kind string value is a literal-pool pointer (a bare
        # `s = "literal";` reassignment) — it has NO cssc_str header, so
        # storing it and later cssc_release-ing it would decrement a
        # "refcount" living in .rodata (heap corruption) and reading it
        # via cssc_string_data would GEP+8 past the literal's bytes. Promote
        # it to a fresh heap cssc_str (refcount=1) so the slot always holds
        # a releasable heap string — the same promotion _init_string does
        # for declarations, and byte-for-byte what the interpreter stores.
        if value_type.kind == 'ptr':
            raw_text = (rhs_node.get('value', '')
                        if isinstance(rhs_node, dict)
                            and rhs_node.get('type') == 'string' else '')
            value_id = b.string_from_lit(raw_text)
        # A.3.5: release the old value before overwriting the slot so
        # we don't leak the previous cssc_str. The refcount cascade
        # handles aliased ptrs (other slots holding the same heap value
        # see only refcount -= 1; the actual free only happens when
        # this was the last owner).
        b.slot_release(slot_id, 'string')
        b.slot_store(slot_id, value_id, PTR)
        # Reassignment from a borrow (`r = Sec->_vec[i]`, `r = other`)
        # must retain — same rule as _init_string / member-assign. A
        # transient RHS (concat / call return / freshly-promoted literal)
        # is already refcount=1 and must NOT be retained.
        if _rhs_is_string_alias(rhs_node):
            b.slot_retain(slot_id, 'string')
        return
    if slot_kind in _CONTAINER_PARAM_KINDS:
        # Container reassignment (`vec = &otherVec`, `ch = &newCH`, …).
        # The RHS is a heap container pointer. Free the slot's current
        # container first (single-owner free via `cssc_<kind>_free` — the
        # release symbol table maps every container kind), then adopt the
        # new pointer. A borrowed RHS (bare identifier / member / index)
        # is retained the same way strings are; the retain is a runtime
        # no-op for non-refcounted containers (their `_retain_symbol` is
        # None) but keeps the emit path uniform, and a transient RHS
        # (a `&`-copy, a call return, a fresh literal) is NOT retained.
        if value_type.kind not in ('ptr', 'string_ptr'):
            raise _csscerror(
                detail=(f'{slot_kind} slot cannot adopt a '
                        f'{value_type.kind!r} value — assignment expects '
                        f'a matching container, a `&`-copy, or a function '
                        f'returning that container kind'),
                line=line,
            )
        b.slot_release(slot_id, slot_kind)
        b.slot_store(slot_id, value_id, PTR)
        if _rhs_is_string_alias(rhs_node):
            b.slot_retain(slot_id, slot_kind)
        return
    raise _csscerror(detail=f'slot kind {slot_kind!r} not yet handled by Phase 1 lowering',
                     line=line)


# ---------------------------------------------------------------------------
# Phase 3: select / jump cursor iteration + return.
# ---------------------------------------------------------------------------
def _select_stack(b: CIRBuilder) -> list:
    """Return (creating if absent) the per-builder select context stack.

    Each entry is a tuple (cursor_slot_id, cond_block, label_name) describing
    one enclosing `select` block. `_lower_select_jump` reads the innermost
    entry; nested selects work without further plumbing.
    """
    if not hasattr(b, '_cir_select_stack'):
        b._cir_select_stack = []  # noqa: SLF001
    return b._cir_select_stack  # noqa: SLF001


def _loop_stack(b: CIRBuilder) -> list:
    """Per-function stack of (continue_block, end_block) for break/continue."""
    if not hasattr(b, '_cir_loop_stack'):
        b._cir_loop_stack = []   # noqa: SLF001
    return b._cir_loop_stack     # noqa: SLF001


def _lower_break(b: CIRBuilder, node: dict) -> None:
    """`break;` — branch to the innermost loop's end block."""
    stack = _loop_stack(b)
    if not stack:
        raise _csscerror(
            detail='`break;` outside of a loop',
            line=node.get('line'),
        )
    _cont, end_blk = stack[-1]
    b.br(end_blk)


def _lower_continue(b: CIRBuilder, node: dict) -> None:
    """`continue;` — branch to the innermost loop's continue/step block."""
    stack = _loop_stack(b)
    if not stack:
        raise _csscerror(
            detail='`continue;` outside of a loop',
            line=node.get('line'),
        )
    cont_blk, _end = stack[-1]
    b.br(cont_blk)


def _lower_mirror(b: CIRBuilder, node: dict) -> None:
    """`mirror <expr>;` — v6 semantics: capture the return value but DON'T
    terminate the basic block. Execution falls through to the next
    statement so trailing cleanup (`#delete[copied]`, `#free[X]`, …)
    in the function body still runs. The function's epilogue (see
    `_emit_mirror_epilogue_ret` in `_lower_define`) reads the captured
    value at function exit.

    Three sub-cases:

      * `mirror x;`  (default, bare-identifier value)
            → REF semantic. Stores `x`'s current value into the
              hidden `mirror_value_slot` AND saves `&x` (the slot's
              address) into `mirror_ref_slot`. At epilogue the
              re-fetch picks up `x`'s latest value — including a
              fresh 0 if `x` was `#delete`d in the cleanup tail.

      * `mirror &x;`  (explicit copy prefix from the parser)
            → SNAPSHOT semantic. Stores the value into
              `mirror_value_slot`; `mirror_ref_slot` stays 0 so the
              epilogue uses the snapshot path. Subsequent body
              deletes can't affect the captured value.

      * `mirror <expr>;`  (any non-identifier expression)
            → SNAPSHOT semantic (no slot to live-ref against).

    Tracking is per-function via the `_DEFINES[name]` map populated
    in `_lower_define`; we resolve the current function by walking
    that map for the entry whose `sym` matches the current function's
    symbol.
    """
    line = node.get('line')
    value = node.get('value')
    if value is None:
        raise _csscerror(
            detail='`mirror;` without a value — pass an expression: `mirror X;`',
            line=line,
        )
    cur_fn = b._current_fn   # noqa: SLF001
    if cur_fn is None:
        raise _csscerror(detail='mirror: no current function', line=line)
    fn_ret = cur_fn.return_type
    if fn_ret.is_void():
        raise _csscerror(
            detail=f'`mirror` used in {cur_fn.name!r} which has no '
                   f'value-return shape',
            hint='label / function pre-scan saw no mirror earlier — this '
                 'one is unreachable from a typed call-site',
            line=line,
        )
    # Phase A.5: pre-scan picked the function's return kind from the
    # FIRST mirror/return expression. The expected_kind hint here mirrors
    # that decision so identifier loads / arithmetic produce the right
    # element type. `_LLVM_KIND_TO_CSSC` maps the LLVM kind back to the
    # CSSC name `_lower_expr` accepts.
    _LLVM_KIND_TO_CSSC = {'i64': 'int', 'i1': 'bool',
                          'f64': 'float', 'f32': 'float',
                          'string_ptr': 'string'}
    expected_cssc = _LLVM_KIND_TO_CSSC.get(fn_ret.kind, 'int')
    val_id, val_ty = _lower_expr(b, value, expected_kind=expected_cssc)
    # Phase A.5 string returns: a string literal in expression position
    # lowers to `ptr` (raw literal-pool address). Promote to a heap
    # cssc_str* so the caller adopts a refcount-managed entry — same
    # shim the vector_string push path uses.
    if fn_ret.kind == 'string_ptr' and val_ty.kind == 'ptr':
        raw_text = (value.get('value', '')
                    if isinstance(value, dict)
                        and value.get('type') == 'string' else '')
        val_id = b.string_from_lit(raw_text)
        val_ty = STRING_PTR
    if val_ty.kind != fn_ret.kind:
        if fn_ret.kind == 'i64' and val_ty.kind == 'f64':
            val_id = b.fptosi_to_int(val_id); val_ty = INT64
        elif fn_ret.kind == 'i64' and val_ty.kind == 'f32':
            ext_id = b.call('__extendsfdf2', [val_id], [FLOAT32],
                            return_type=FLOAT64, external=True)
            val_id = b.fptosi_to_int(ext_id); val_ty = INT64
        elif fn_ret.kind == 'i64' and val_ty.kind == 'i1':
            val_id = b.zext_bool_to_int(val_id); val_ty = INT64
        elif fn_ret.kind == 'f64' and val_ty.kind == 'i64':
            val_id = b.sitofp_to_double(val_id); val_ty = FLOAT64
        elif fn_ret.kind == 'f64' and val_ty.kind == 'i1':
            zx = b.zext_bool_to_int(val_id)
            val_id = b.sitofp_to_double(zx); val_ty = FLOAT64
        elif fn_ret.kind == 'f64' and val_ty.kind == 'f32':
            val_id = b.call('__extendsfdf2', [val_id], [FLOAT32],
                            return_type=FLOAT64, external=True); val_ty = FLOAT64
        elif fn_ret.kind == 'f32' and val_ty.kind == 'f64':
            val_id = b.call('__truncdfsf2', [val_id], [FLOAT64],
                            return_type=FLOAT32, external=True); val_ty = FLOAT32
        elif fn_ret.kind == 'i1' and val_ty.kind == 'i64':
            zero = b.const_int(0)
            val_id = b.cmp_int('!=', val_id, zero); val_ty = BOOL
        else:
            raise _csscerror(
                detail=f'mirror kind {val_ty.kind!r} cannot satisfy declared '
                       f'return kind {fn_ret.kind!r}',
                line=line,
            )
    cur_sym = cur_fn.name
    fn_info = next(
        (info for info in _DEFINES.values()
         if info.get('sym') == cur_sym),
        None,
    )
    if fn_info is None:
        # Falls back to the legacy short-circuit when mirror is used
        # inside a non-user-function (e.g. an object label whose
        # epilogue lives elsewhere). The legacy behaviour is "hard
        # return" — same as `return value;`.
        b.ret(val_id, fn_ret)
        return
    mirror_value_slot = fn_info.get('mirror_value_slot', -1)
    mirror_ref_slot   = fn_info.get('mirror_ref_slot', -1)
    if mirror_value_slot < 0 or mirror_ref_slot < 0:
        # Same legacy fallback when the function wasn't wired with
        # mirror slots (e.g. a non-define callable).
        b.ret(val_id, fn_ret)
        return
    # Live-ref tracking: when `value` is a bare identifier AND the
    # parser didn't tag this as `is_copy=True`, capture the source
    # slot's address. `_resolve_ref_source_slot` returns the slot id
    # (a PTR-typed SSA value) for the named slot, or -1 if the value
    # isn't a bare identifier or doesn't resolve to a slot.
    is_copy = bool(node.get('is_copy'))
    ref_slot_id = (-1 if is_copy
                   else _resolve_ref_source_slot(b, value))
    # Phase A.5 string-return refcount: when the source is slot-bound,
    # the source slot's release at function-end would free the heap
    # string before the caller can adopt it. Retain to keep it alive
    # past the source's release; the caller's slot then adopts the
    # single remaining ref. For transient sources (literals, concat
    # results) the SSA value already owns refcount=1 with no other
    # owner — no retain needed; transfer ownership via plain store.
    # A string return must OUTLIVE the source slot's release — either the
    # explicit `#delete[v]` in the body or the auto-release at scope exit.
    # If it doesn't, the caller adopts a freed/dangling cssc_str* (the
    # use-after-free that produced the `(1)   (1)` menu doubling plus the
    # double-free that progressively corrupts the allocator free-list).
    # Two cases, matching the parser's documented `&` semantics and the
    # interpreter's value capture EXACTLY:
    #   * `mirror &v` (is_copy=True): `&` is a DEEP COPY. Emit
    #     cssc_string_copy so the caller owns an independent refcount=1
    #     buffer that the source slot's later `#delete[v]` cannot reach.
    #     The interpreter captures the string VALUE at the mirror point,
    #     so a deep copy is byte-for-byte identical to it.
    #   * `mirror v` (bare identifier, ref_slot_id>=0): retain so the
    #     source's release only decrements the shared refcount; the caller
    #     adopts the last remaining ref.
    #   * transient sources (literals / concat results / call returns,
    #     ref_slot_id<0 and is_copy=False) already own refcount=1 with no
    #     other owner — transfer ownership via the plain store.
    # The string snapshot is bitcast ptr→i64 because mirror_value_slot is
    # int-typed, which sidesteps the auto-release at function exit — the
    # cssc_str* must survive to reach the caller's slot.
    if fn_ret.kind == 'string_ptr':
        if is_copy:
            val_id = b.call('cssc_string_copy', [val_id], [PTR],
                            return_type=STRING_PTR, external=True)
        elif ref_slot_id >= 0:
            b.call('cssc_retain', [val_id], [PTR],
                   return_type=VOID, external=True)
        as_int = b.ptr_to_int(val_id)
        b.slot_store(mirror_value_slot, as_int, INT64)
    else:
        # POD scalar snapshot — store with the kind-matching CIR type so
        # a bool / float function's mirror_value_slot keeps correct storage.
        b.slot_store(mirror_value_slot, val_id, fn_ret)
    # Perf-opt #4: `mirror_ref_slot` is only consulted by the epilogue
    # for `return_kind == 'int'` (see `_emit_mirror_epilogue_ret` — the
    # bool/float/string paths take the snapshot-only branch and never
    # read the ref slot). Storing the ptrtoint address into it in those
    # cases escapes the caller's alloca into the runtime frame for no
    # observable effect, which blocks mem2reg from promoting the
    # caller's slot to a register. Emit the ptrtoint + store only when
    # `_emit_mirror_epilogue_ret` will actually re-fetch it.
    if fn_ret.kind == 'i64' and ref_slot_id >= 0:
        # The slot id is a PTR SSA value (slot addresses are ptr in
        # LLVM). Cast to i64 via `ptrtoint` so the i64-typed
        # mirror_ref_slot accepts it — opaque-pointer LLVM rejects
        # storing a ptr-typed value through an i64-typed store. The
        # bit pattern survives unchanged; the epilogue reads back
        # an i64 and `cssc_load_i64_at(uint64_t addr)` interprets
        # it as the slot address.
        ref_as_int = b.ptr_to_int(ref_slot_id)
        b.slot_store(mirror_ref_slot, ref_as_int, INT64)
    elif fn_ret.kind == 'i64':
        b.slot_store(mirror_ref_slot, b.const_int(0), INT64)
    fn_info['mirror_used'] = True
    # NO `b.ret(...)` here — body keeps emitting.


def _resolve_ref_source_slot(b: 'CIRBuilder', value_node) -> int:
    """If `value_node` is a bare identifier referencing a declared
    slot in the current scope, return the slot's SSA id (PTR-typed).
    Else `-1`.

    The check is conservative: only `type='identifier'` /
    `type='name'` /`type='var_ref'` nodes count. Anything fancier
    (member access, index, expression) falls back to snapshot
    semantics — there's no single slot to re-fetch from.
    """
    if not isinstance(value_node, dict):
        return -1
    if value_node.get('type') not in ('identifier', 'name', 'var_ref'):
        return -1
    nm = (value_node.get('name') or '').strip()
    if not nm:
        return -1
    return b._slots.get(nm, -1)             # noqa: SLF001


def _lower_return(b: CIRBuilder, node: dict) -> None:
    """Lower `return;` or `return <expr>;` at statement position.

    The current function's CIR return type was set by `_lower_define`
    based on a pre-scan of the body's `return` shapes. Value-bearing
    returns must match (int-only for v6 native); bare returns are only
    valid inside void functions.

    Inside `cssc_user_main` (the implicit top-level), bare `return;` is
    accepted as an early-exit; value-bearing `return X;` is rejected
    because main has no caller to receive the value.
    """
    line = node.get('line')
    value = node.get('value')
    cur_fn = b._current_fn       # noqa: SLF001
    fn_name = cur_fn.name if cur_fn is not None else ''
    fn_ret = cur_fn.return_type if cur_fn is not None else VOID

    if value is None:
        if not fn_ret.is_void():
            raise _csscerror(
                detail=f"bare `return;` in {fn_name!r} which declares a "
                       f"value return (kind {fn_ret.kind!r})",
                hint='supply an expression: `return <expr>;`',
                line=line,
            )
        b.ret()
        return

    # Value-bearing return.
    if fn_name == 'cssc_user_main':
        raise _csscerror(
            detail='top-level `return <expr>;` is not allowed in main',
            hint='use `cssc::exit(code)` to return a non-zero exit status',
            line=line,
        )
    if fn_ret.is_void():
        raise _csscerror(
            detail=f"`return <expr>;` in {fn_name!r} which has no return "
                   f"type — add at least one value-bearing return at the "
                   f"top of the body, or drop the value here",
            line=line,
        )
    # Phase A.5: mirror the expected_kind to the function's declared
    # return CIR type so identifier loads / binary ops produce the
    # matching element kind. Same _LLVM_KIND_TO_CSSC mapping the mirror
    # lowering uses.
    _RETURN_LLVM_KIND_TO_CSSC = {'i64': 'int', 'i1': 'bool',
                                  'f64': 'float', 'f32': 'float',
                                  'string_ptr': 'string'}
    expected_cssc = _RETURN_LLVM_KIND_TO_CSSC.get(fn_ret.kind, 'int')
    # Container return: the CIR return type is a bare PTR, so recover the
    # exact element kind stashed on the function to lower the value as the
    # right container (its load hands back a matching `ptr`).
    _cret = getattr(cur_fn, 'cssc_return_kind', None)
    if _cret in _CONTAINER_PARAM_KINDS:
        expected_cssc = _cret
    val_id, val_ty = _lower_expr(b, value, expected_kind=expected_cssc)
    # Phase A.5 string returns: promote a raw literal-pool ptr to a heap
    # cssc_str* so the caller adopts a refcount-managed entry.
    if fn_ret.kind == 'string_ptr' and val_ty.kind == 'ptr':
        raw_text = (value.get('value', '')
                    if isinstance(value, dict)
                        and value.get('type') == 'string' else '')
        val_id = b.string_from_lit(raw_text)
        val_ty = STRING_PTR
    if val_ty.kind != fn_ret.kind:
        if fn_ret.kind == 'i64' and val_ty.kind == 'f64':
            val_id = b.fptosi_to_int(val_id)
            val_ty = INT64
        elif fn_ret.kind == 'i64' and val_ty.kind == 'f32':
            ext_id = b.call('__extendsfdf2', [val_id], [FLOAT32],
                            return_type=FLOAT64, external=True)
            val_id = b.fptosi_to_int(ext_id)
            val_ty = INT64
        elif fn_ret.kind == 'i64' and val_ty.kind == 'i1':
            val_id = b.zext_bool_to_int(val_id)
            val_ty = INT64
        elif fn_ret.kind == 'f64' and val_ty.kind == 'i64':
            val_id = b.sitofp_to_double(val_id)
            val_ty = FLOAT64
        elif fn_ret.kind == 'f64' and val_ty.kind == 'i1':
            zext_id = b.zext_bool_to_int(val_id)
            val_id = b.sitofp_to_double(zext_id)
            val_ty = FLOAT64
        elif fn_ret.kind == 'f64' and val_ty.kind == 'f32':
            val_id = b.call('__extendsfdf2', [val_id], [FLOAT32],
                            return_type=FLOAT64, external=True)
            val_ty = FLOAT64
        elif fn_ret.kind == 'f32' and val_ty.kind == 'f64':
            val_id = b.call('__truncdfsf2', [val_id], [FLOAT64],
                            return_type=FLOAT32, external=True)
            val_ty = FLOAT32
        elif fn_ret.kind == 'i1' and val_ty.kind == 'i64':
            zero = b.const_int(0)
            val_id = b.cmp_int('!=', val_id, zero)
            val_ty = BOOL
        else:
            raise _csscerror(
                detail=f"return kind {val_ty.kind!r} cannot satisfy declared "
                       f"return {fn_ret.kind!r} in {fn_name!r}",
                hint='v6 native return surface supports int / bool / float / '
                     'string — container returns land later',
                line=line,
            )
    b.ret(val_id, fn_ret)


def _emit_map_values_snapshot(b: CIRBuilder, map_slot: int, kind: str,
                               line: Optional[int]) -> Tuple[str, int, str]:
    """Snapshot a map's values into a fresh temp vector so
    `select (map) ?v { … }` iterates the values as a static snapshot taken
    once at select-entry (immune to cursor jumps), like the interpreter's
    `items = list(map.values())`. Values are collected in bucket order; for
    a single-entry map (or any map where bucket order coincides with the
    interpreter's insertion order) the two match byte-for-byte — multi-entry
    maps carry the same insertion-vs-bucket order caveat as `{k: v}`
    stringify (native maps track no insertion order). String values are
    `cssc_string_copy`-ed so the snapshot owns independent heap strings (the
    caller frees the snapshot at select-end). Returns
    `(vec_kind, vec_slot, rt)`."""
    _kk, vkind = _MAP_KV_KINDS[kind]
    rt = 'int' if vkind == 'int' else ('float' if vkind == 'float'
                                       else 'string')
    vec_kind = 'vector_' + rt
    map_ptr0 = b.slot_load(map_slot, kind)
    cap = b.call(f'cssc_{kind}_cap', [map_ptr0], [PTR],
                 return_type=INT64, external=True)
    vec0 = b.call(f'cssc_vector_new_{rt}', [b.const_int(0)], [INT64],
                  return_type=PTR, external=True)
    vec_slot = b.slot_alloc(vec_kind, 64)
    b.slot_store(vec_slot, vec0, PTR)
    i_slot = b.slot_alloc('int', 64)
    b.slot_store(i_slot, b.const_int(0), INT64)
    head = b.new_block('msnap.head')
    body = b.new_block('msnap.body')
    push = b.new_block('msnap.push')
    step = b.new_block('msnap.step')
    end = b.new_block('msnap.end')
    b.br(head)
    b.set_block(head)
    b.br_cond(b.cmp_int('<', b.slot_load(i_slot, 'int'), cap), body, end)
    b.set_block(body)
    i_cur = b.slot_load(i_slot, 'int')
    mp = b.slot_load(map_slot, kind)
    st = b.call(f'cssc_{kind}_bstate', [mp, i_cur], [PTR, INT64],
                return_type=INT64, external=True)
    b.br_cond(b.cmp_int('==', st, b.const_int(1)), push, step)
    b.set_block(push)
    mp2 = b.slot_load(map_slot, kind)
    vec = b.slot_load(vec_slot, vec_kind)
    if vkind == 'string':
        raw = b.call(f'cssc_{kind}_bval', [mp2, i_cur], [PTR, INT64],
                     return_type=STRING_PTR, external=True)
        val = b.call('cssc_string_copy', [raw], [PTR],
                     return_type=STRING_PTR, external=True)
        b.call('cssc_vector_push_string', [vec, val], [PTR, PTR],
               return_type=VOID, external=True)
    elif vkind == 'float':
        val = b.call(f'cssc_{kind}_bval', [mp2, i_cur], [PTR, INT64],
                     return_type=FLOAT64, external=True)
        b.call('cssc_vector_push_float', [vec, val], [PTR, FLOAT64],
               return_type=VOID, external=True)
    else:
        val = b.call(f'cssc_{kind}_bval', [mp2, i_cur], [PTR, INT64],
                     return_type=INT64, external=True)
        b.call('cssc_vector_push_int', [vec, val], [PTR, INT64],
               return_type=VOID, external=True)
    b.br(step)
    b.set_block(step)
    b.slot_store(i_slot, b.binop('+', i_cur, b.const_int(1)), INT64)
    b.br(head)
    b.set_block(end)
    return vec_kind, vec_slot, rt


def _lower_select(b: CIRBuilder, node: dict) -> None:
    """Lower `select (iterable) ?label { body }` cursor-driven iteration.

    Phase A.6 supports every iterable kind that has a runtime get/size
    helper: vector<int|float|bool|string>, array<int|float|bool|string>,
    array<bind>. The cursor advances by `jump;` (delta=1), `jump++;`
    (delta=2), `!jump;` (-1), `!jump++;` (-2). A body that falls through
    without an explicit `jump` terminates the loop — that's the CSSC
    contract.

    Dispatch uses `_vector_traits` for vector/array kinds (uniform
    cssc_vector_size_<rt> / cssc_vector_get_<rt>) and falls back to
    bespoke runtime symbols for `array_bind`.
    """
    line = node.get('line')
    label = node.get('label', '')
    if not label:
        raise _csscerror(detail='select: missing ?label', line=line)

    iterable_node = node.get('iterable', {})
    kind, vec_slot = _resolve_container_target(b, iterable_node, line)
    # select over a map iterates its VALUES (interpreter: list(map.values()))
    # — snapshot them into a temp vector once at entry, then run the normal
    # vector-select machinery over the snapshot. Freed at select-end.
    _map_snapshot_rt = None
    if kind.startswith('map_'):
        kind, vec_slot, _map_snapshot_rt = _emit_map_values_snapshot(
            b, vec_slot, kind, line)
    _SELECT_VEC_KINDS = ('vector_int', 'vector_float', 'vector_bool',
                          'vector_string',
                          'array_int', 'array_float', 'array_bool',
                          'array_string')
    if kind not in _SELECT_VEC_KINDS + ('array_bind',):
        raise _csscerror(
            detail=f"select iterable {kind!r} not yet supported",
            hint='supported: vector<int|float|bool|string>, '
                 'array<int|float|bool|string>, array<bind>, '
                 'map<K,V> (iterates values)',
            line=line,
        )
    if b.scope_has(label):
        raise _csscerror(
            detail=f"select: ?{label} shadows outer variable",
            line=line,
        )

    # Cursor slot (int, hidden) + per-iteration value slot (?label bind).
    # The label slot's CSSC kind matches the iterated element so the body
    # can use `?label` as if it were a declared slot of that kind.
    cursor_slot = b.slot_alloc('int', 64)
    zero = b.const_int(0)
    b.slot_store(cursor_slot, zero, INT64)

    # Map iterable kind → (size_sym, get_sym, label_kind, get_ret_ty).
    if kind == 'array_bind':
        size_sym   = 'cssc_array_bind_size'
        get_sym    = 'cssc_array_bind_get_entry'
        label_kind = 'bind_entry'
        get_ret_ty = PTR
    else:
        traits = _vector_traits(kind)
        rt = traits['rt']
        size_sym = f'cssc_vector_size_{rt}'
        get_sym  = f'cssc_vector_get_{rt}'
        # Label slot binds to the element's CSSC type — int / float /
        # bool / string. The string variant gets the same borrowed-ptr
        # semantics as array_string had: no refcount retain on iteration,
        # release on scope-pop is a no-op while container holds the ref.
        label_kind = traits['expected']
        # The get_<rt> helper returns elem_ty for numeric kinds; for
        # string it returns PTR (the entry's cssc_str* without retain).
        if rt == 'string':
            get_ret_ty = PTR
        else:
            get_ret_ty = traits['elem']

    label_slot = b.slot_alloc(label_kind, 64)
    b.scope_bind(label, label_slot, label_kind)

    cond_neg_blk   = b.new_block('sel.cond')        # %cur >= 0 ?
    cond_range_blk = b.new_block('sel.in_range')    # %cur < size ?
    body_blk       = b.new_block('sel.body')
    end_blk        = b.new_block('sel.end')

    b.br(cond_neg_blk)

    # cond_neg: nonneg = cur >= 0
    b.set_block(cond_neg_blk)
    cur1 = b.slot_load(cursor_slot, 'int')
    zero1 = b.const_int(0)
    nonneg = b.cmp_int('>=', cur1, zero1)
    b.br_cond(nonneg, cond_range_blk, end_blk)

    # cond_range: in_range = cur < size
    b.set_block(cond_range_blk)
    cur2 = b.slot_load(cursor_slot, 'int')
    vec_ptr2 = b.slot_load(vec_slot, kind)
    size_id = b.call(size_sym, [vec_ptr2], [PTR],
                     return_type=INT64, external=True)
    in_range = b.cmp_int('<', cur2, size_id)
    b.br_cond(in_range, body_blk, end_blk)

    # body: load element into label_slot, then run user statements.
    b.set_block(body_blk)
    cur3 = b.slot_load(cursor_slot, 'int')
    vec_ptr3 = b.slot_load(vec_slot, kind)
    elem = b.call(get_sym, [vec_ptr3, cur3], [PTR, INT64],
                  return_type=get_ret_ty, external=True)
    # Store element with the runtime's return type — slot_store sees the
    # PTR/INT64/BOOL/FLOAT64 matching `_kind_to_load_type(label_kind)`.
    b.slot_store(label_slot, elem, get_ret_ty)
    # Track current position so `?label.pos()` resolves to cur in the
    # body without re-reading the cursor slot.
    _select_pos_stack(b).append((label, cursor_slot))

    # Push select context so `jump`/`!jump`/etc. can find this loop's pivot.
    _select_stack(b).append((cursor_slot, cond_neg_blk, label))
    # Also register on the generic loop stack so plain `break;`
    # (without a target label) terminates the select cleanly.
    _loop_stack(b).append((cond_neg_blk, end_blk))
    try:
        for stmt in node.get('body', []) or []:
            if _current_block_terminates(b):
                break
            _lower_stmt(b, stmt)
        # Fallthrough without jump → loop terminates per CSSC spec.
        if not _current_block_terminates(b):
            b.br(end_blk)
    finally:
        _loop_stack(b).pop()
        _select_stack(b).pop()
        _select_pos_stack(b).pop()

    b.set_block(end_blk)
    # Release ?label binding + cursor slot. POD label kinds (int / bool /
    # float) — slot_release is just a zero-store, harmless. Heap-kind
    # labels (string / bind_entry) hold a BORROWED ptr (the container
    # still owns the refcount); calling cssc_release on them would
    # double-decrement, so skip the release and let scope_pop reclaim
    # the frame slot itself.
    if label_kind in ('int', 'bool', 'float'):
        b.slot_release(label_slot, label_kind)
    b.scope_unbind(label)
    b.slot_release(cursor_slot, 'int')
    # Reclaim the map-values snapshot (frees the owned string copies too).
    if _map_snapshot_rt is not None:
        snap = b.slot_load(vec_slot, kind)
        b.call(f'cssc_vector_free_{_map_snapshot_rt}', [snap], [PTR],
               return_type=VOID, external=True)


# Per-builder stack of (select-label-name, cursor_slot) tuples so the
# label.pos() expression can resolve to the current cursor without
# re-scanning the IR. Pushed on select-entry, popped on select-exit.
_SELECT_POS_STACKS: Dict[int, list] = {}


def _select_pos_stack(b: CIRBuilder) -> list:
    key = id(b)
    if key not in _SELECT_POS_STACKS:
        _SELECT_POS_STACKS[key] = []
    return _SELECT_POS_STACKS[key]


def _select_pos_lookup(b: CIRBuilder, label: str) -> Optional[int]:
    for lbl, cursor_slot in reversed(_select_pos_stack(b)):
        if lbl == label:
            return cursor_slot
    return None


def _lower_select_jump(b: CIRBuilder, node: dict) -> None:
    """Lower `jump;` / `jump++;` / `!jump;` / `!jump++;`.

    Each form is a terminator: advances the cursor by the parser-supplied
    delta, then unconditionally branches back to the enclosing select's
    condition block.
    """
    line = node.get('line')
    stack = _select_stack(b)
    if not stack:
        raise _csscerror(detail='jump used outside a select', line=line)
    cursor_slot, cond_blk, _label = stack[-1]
    delta = int(node.get('delta', 1))
    cur = b.slot_load(cursor_slot, 'int')
    d = b.const_int(delta)
    new_cur = b.bin_int('+', cur, d)
    b.slot_store(cursor_slot, new_cur, INT64)
    b.br(cond_blk)


__all__ = ['lower']
