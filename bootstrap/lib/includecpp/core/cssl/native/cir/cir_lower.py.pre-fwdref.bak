        cur_ptr = b.slot_load(slot_id, 'map_sf')
        kp, kl = _string_lit_ptr_len(b, key)
        v_id, v_ty = _lower_expr(b, val_expr, expected_kind='float')
        v_id = _coerce_float_arg(b, v_id, v_ty, line)
        b.call('cssc_map_sf_set',
               [cur_ptr, kp, kl, v_id],
               [PTR, PTR, INT64, FLOAT64],
               return_type=VOID, external=True)


