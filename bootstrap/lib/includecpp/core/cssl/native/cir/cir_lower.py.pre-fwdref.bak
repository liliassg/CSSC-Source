                 bits_hint: int, line: Optional[int]) -> None:
    init_t = init_node.get('type')
    if init_t != 'map_literal':
        raise _csscerror(
            detail='map<string, float> initialiser must be a map literal',
            hint="use:  #stack[map<string, float>, N] m = {'k': 1.0, ...};",
            line=line,
