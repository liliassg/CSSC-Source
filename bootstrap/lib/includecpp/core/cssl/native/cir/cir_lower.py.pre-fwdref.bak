    # ---- video base ns-form ns-call surface -----------------------------
    # In addition to the dot-method form (`w.clear()`), users call the base
    # video ops as `vid::clear(w)` etc. — expose the same runtime with an
    # explicit handle arg.
    ('video', 'open'):              _DispatchSpec('cssc_video_open_titled',
                                                   [PTR, CSTR], VOID, 'stmt',
                                                   trailing_optional=1),
