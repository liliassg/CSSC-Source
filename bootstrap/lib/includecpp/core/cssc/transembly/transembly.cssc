

#stack[int, 64] txSrc = 0;
#stack[int, 64] txSrcLen = 0;
#stack[int, 64] txPos = 0;
#stack[int, 64] txCur = 0;
#stack[int, 64] txTokNum = 0;
#stack[int, 64] txTokFloat = 0;
#stack[int, 64] txTokOff = 0;
#stack[int, 64] txTokLen = 0;

#stack[int, 64] txTokCode = 0;
#stack[int, 64] txTokNumA = 0;
#stack[int, 64] txTokFlag = 0;
#stack[int, 64] txTokOffA = 0;
#stack[int, 64] txTokLenA = 0;
#stack[int, 64] txTokCount = 0;
#stack[int, 64] txTokCap = 0;

#define(txLexRaw) {
    #req[txSrc] txSrc;
    #req[txSrcLen] txSrcLen;
    #req[txPos] txPos;
    #req[txCur] txCur;
    #req[txTokNum] txTokNum;
    #req[txTokFloat] txTokFloat;
    #req[txTokOff] txTokOff;
    #req[txTokLen] txTokLen;
    txTokFloat = 0;
    #stack[int, 32] skipping = 1;
    while (skipping == 1) {
        if (txPos >= txSrcLen) {
            skipping = 0;
        }
        if (skipping == 1) {
            #stack[int, 64] c = cssc::peek8(txSrc + txPos);
            #stack[int, 32] isws = 0;
            if (c == 32) { isws = 1; }
            if (c == 10) { isws = 1; }
            if (c == 13) { isws = 1; }
            if (c == 9) { isws = 1; }
            if (isws == 1) {
                txPos = txPos + 1;
            }
            if (isws == 0) {
                #stack[int, 32] iscomment = 0;
                if (c == 47) {
                    if (txPos + 1 < txSrcLen) {
                        #stack[int, 64] c2 = cssc::peek8(txSrc + txPos + 1);
                        if (c2 == 47) {
                            iscomment = 1;
                        }
                        #delete[c2];
                    }
                }
                if (iscomment == 1) {
                    #stack[int, 32] cs = 1;
                    while (cs == 1) {
                        if (txPos >= txSrcLen) { cs = 0; }
                        if (cs == 1) {
                            #stack[int, 64] cc = cssc::peek8(txSrc + txPos);
                            if (cc == 10) { cs = 0; }
                            if (cc != 10) { txPos = txPos + 1; }
                            #delete[cc];
                        }
                    }
                    #delete[cs];
                }
                if (iscomment == 0) {
                    skipping = 0;
                }
                #delete[iscomment];
            }
            #delete[isws];
            #delete[c];
        }
    }
    #delete[skipping];
    if (txPos >= txSrcLen) {
        txCur = 0;
    }
    if (txPos < txSrcLen) {
        #stack[int, 64] c = cssc::peek8(txSrc + txPos);
        #stack[int, 32] done = 0;

        if (c >= 48) {
            if (c <= 57) {

                #stack[int, 32] ishex = 0;
                if (c == 48) {
                    if (txPos + 1 < txSrcLen) {
                        #stack[int, 64] cx = cssc::peek8(txSrc + txPos + 1);
                        if (cx == 120) { ishex = 1; }
                        if (cx == 88) { ishex = 1; }
                        #delete[cx];
                    }
                }
                if (ishex == 1) {

                    txPos = txPos + 2;
                    #stack[int, 64] hv = 0;
                    #stack[int, 32] rd = 1;
                    while (rd == 1) {
                        if (txPos >= txSrcLen) { rd = 0; }
                        if (rd == 1) {
                            #stack[int, 64] d = cssc::peek8(txSrc + txPos);
                            #stack[int, 64] hd = 0 - 1;
                            if (d >= 48) { if (d <= 57) { hd = d - 48; } }
                            if (d >= 97) { if (d <= 102) { hd = d - 87; } }
                            if (d >= 65) { if (d <= 70) { hd = d - 55; } }
                            if (hd >= 0) {
                                hv = hv * 16 + hd;
                                txPos = txPos + 1;
                            }
                            if (hd < 0) { rd = 0; }
                            #delete[hd];
                            #delete[d];
                        }
                    }
                    #delete[rd];
                    txTokNum = hv;
                    txCur = 1;
                    done = 1;
                    #delete[hv];
                }
                if (ishex == 0) {

                    #stack[int, 64] numStart = txPos;
                    #stack[int, 64] v = 0;
                    #stack[int, 32] rd = 1;
                    while (rd == 1) {
                        if (txPos >= txSrcLen) { rd = 0; }
                        if (rd == 1) {
                            #stack[int, 64] d = cssc::peek8(txSrc + txPos);
                            #stack[int, 32] dig = 0;
                            if (d >= 48) { if (d <= 57) { dig = 1; } }
                            if (dig == 1) {
                                v = v * 10 + (d - 48);
                                txPos = txPos + 1;
                            }
                            if (dig == 0) { rd = 0; }
                            #delete[dig];
                            #delete[d];
                        }
                    }
                    #delete[rd];
                    #stack[int, 32] isFloat = 0;
                    if (txPos + 1 < txSrcLen) {
                        if (cssc::peek8(txSrc + txPos) == 46) {
                            #stack[int, 64] nd = cssc::peek8(txSrc + txPos + 1);
                            if (nd >= 48) { if (nd <= 57) { isFloat = 1; } }
                            #delete[nd];
                        }
                    }
                    if (isFloat == 1) {
                        txPos = txPos + 1;

                        #stack[int, 64] mant = v;
                        #stack[int, 64] fdc = 0;
                        #stack[int, 32] moflow = 0;
                        if (v > 900719925474098) { moflow = 1; }
                        #stack[int, 32] fd = 1;
                        while (fd == 1) {
                            if (txPos >= txSrcLen) { fd = 0; }
                            if (fd == 1) {
                                #stack[int, 64] d2 = cssc::peek8(txSrc + txPos);
                                #stack[int, 32] isd = 0;
                                if (d2 >= 48) { if (d2 <= 57) { isd = 1; } }
                                if (isd == 1) {
                                    if (mant > 900719925474098) { moflow = 1; }
                                    if (moflow == 0) { mant = mant * 10 + (d2 - 48); fdc = fdc + 1; }
                                    txPos = txPos + 1;
                                }
                                if (isd == 0) { fd = 0; }
                                #delete[isd];
                                #delete[d2];
                            }
                        }
                        #delete[fd];
                        if (fdc > 15) { moflow = 1; }
                        if (moflow == 0) {
                            #stack[int, 64] p10 = 1;
                            #stack[int, 64] pi = 0;
                            while (pi < fdc) { p10 = p10 * 10; pi = pi + 1; }
                            #delete[pi];
                            cssc::fDiv(cssc::iToF(mant), cssc::iToF(p10)) fv2;
                            txTokNum = fv2;
                            #delete[fv2];
                            #delete[p10];
                        }
                        if (moflow == 1) {
                            cssc::strToF(txSrc + numStart, txPos - numStart) fb;
                            txTokNum = fb;
                            #delete[fb];
                        }
                        txTokFloat = 1;
                        #delete[mant];
                        #delete[fdc];
                        #delete[moflow];
                    }
                    if (isFloat == 0) { txTokNum = v; }
                    txCur = 1;
                    done = 1;
                    #delete[isFloat];
                    #delete[numStart];
                    #delete[v];
                }
                #delete[ishex];
            }
        }
        if (done == 0) {
            #stack[int, 32] isletter = 0;
            if (c >= 65) { if (c <= 90) { isletter = 1; } }
            if (c >= 97) { if (c <= 122) { isletter = 1; } }
            if (c == 95) { isletter = 1; }
            if (isletter == 1) {
                #stack[int, 64] start = txPos;
                #stack[int, 32] rd = 1;
                while (rd == 1) {
                    if (txPos >= txSrcLen) { rd = 0; }
                    if (rd == 1) {
                        #stack[int, 64] d = cssc::peek8(txSrc + txPos);
                        #stack[int, 32] idc = 0;
                        if (d >= 65) { if (d <= 90) { idc = 1; } }
                        if (d >= 97) { if (d <= 122) { idc = 1; } }
                        if (d >= 48) { if (d <= 57) { idc = 1; } }
                        if (d == 95) { idc = 1; }

                        if (d == 58) {
                            if (txPos + 1 < txSrcLen) {
                                #stack[int, 64] d2 = cssc::peek8(txSrc + txPos + 1);
                                if (d2 == 58) { idc = 2; }
                                #delete[d2];
                            }
                        }
                        if (idc == 1) { txPos = txPos + 1; }
                        if (idc == 2) { txPos = txPos + 2; }
                        if (idc == 0) { rd = 0; }
                        #delete[idc];
                        #delete[d];
                    }
                }
                #delete[rd];
                txTokOff = start;
                txTokLen = txPos - start;
                txCur = 2;
                done = 1;
                #delete[start];
            }
            #delete[isletter];
        }
        if (done == 0) {
            if (c == 34) {
                txPos = txPos + 1;
                #stack[int, 64] start = txPos;
                #stack[int, 32] rd = 1;
                while (rd == 1) {
                    if (txPos >= txSrcLen) { rd = 0; }
                    if (rd == 1) {
                        #stack[int, 64] d = cssc::peek8(txSrc + txPos);
                        if (d == 34) { rd = 0; }
                        if (d != 34) { txPos = txPos + 1; }
                        #delete[d];
                    }
                }
                #delete[rd];
                txTokOff = start;
                txTokLen = txPos - start;
                if (txPos < txSrcLen) { txPos = txPos + 1; }
                txCur = 3;
                done = 1;
                #delete[start];
            }
        }
        if (done == 0) {
            if (c == 39) {

                #stack[int, 64] qstart = txPos + 1;
                #stack[int, 64] sp = txPos + 1;
                #stack[int, 64] nch = 0;
                #stack[int, 64] first = 0;
                #stack[int, 32] qs = 1;
                while (qs == 1) {
                    if (sp >= txSrcLen) { qs = 0; }
                    if (qs == 1) {
                        #stack[int, 64] d = cssc::peek8(txSrc + sp);
                        if (d == 39) { qs = 0; }
                        if (d != 39) {
                            if (d == 92) {
                                #stack[int, 64] e = 0;
                                if (sp + 1 < txSrcLen) { e = cssc::peek8(txSrc + sp + 1); }
                                #stack[int, 64] ev = e;
                                if (e == 110) { ev = 10; }
                                if (e == 116) { ev = 9; }
                                if (e == 114) { ev = 13; }
                                if (e == 48) { ev = 0; }
                                if (e == 92) { ev = 92; }
                                if (e == 39) { ev = 39; }
                                if (e == 34) { ev = 34; }
                                if (nch == 0) { first = ev; }
                                sp = sp + 2;
                                nch = nch + 1;
                                #delete[ev];
                                #delete[e];
                            }
                            if (d != 92) {
                                if (nch == 0) { first = d; }
                                sp = sp + 1;
                                nch = nch + 1;
                            }
                        }
                        #delete[d];
                    }
                }
                #delete[qs];
                if (nch == 1) {
                    txTokNum = first;
                    txCur = 1;
                }
                if (nch != 1) {
                    txTokOff = qstart;
                    txTokLen = sp - qstart;
                    txCur = 3;
                }
                txPos = sp;
                if (txPos < txSrcLen) { if (cssc::peek8(txSrc + txPos) == 39) { txPos = txPos + 1; } }
                done = 1;
                #delete[first];
                #delete[nch];
                #delete[sp];
                #delete[qstart];
            }
        }
        if (done == 0) {
            if (c == 61) {
                #stack[int, 64] c2 = 0;
                if (txPos + 1 < txSrcLen) { c2 = cssc::peek8(txSrc + txPos + 1); }
                if (c2 == 61) { txCur = 15; txPos = txPos + 2; }
                if (c2 != 61) { txCur = 14; txPos = txPos + 1; }
                done = 1;
                #delete[c2];
            }
        }
        if (done == 0) {
            if (c == 33) {

                #stack[int, 64] c2 = 0;
                if (txPos + 1 < txSrcLen) { c2 = cssc::peek8(txSrc + txPos + 1); }
                if (c2 == 61) { txCur = 16; txPos = txPos + 2; }
                if (c2 != 61) { txCur = 27; txPos = txPos + 1; }
                done = 1;
                #delete[c2];
            }
        }
        if (done == 0) {
            if (c == 60) {
                #stack[int, 64] c2 = 0;
                if (txPos + 1 < txSrcLen) { c2 = cssc::peek8(txSrc + txPos + 1); }
                if (c2 == 61) { txCur = 19; txPos = txPos + 2; }
                if (c2 != 61) { txCur = 17; txPos = txPos + 1; }
                done = 1;
                #delete[c2];
            }
        }
        if (done == 0) {
            if (c == 62) {
                #stack[int, 64] c2 = 0;
                if (txPos + 1 < txSrcLen) { c2 = cssc::peek8(txSrc + txPos + 1); }
                if (c2 == 61) { txCur = 20; txPos = txPos + 2; }
                if (c2 != 61) { txCur = 18; txPos = txPos + 1; }
                done = 1;
                #delete[c2];
            }
        }
        if (done == 0) {
            if (c == 38) {

                #stack[int, 64] c2 = 0;
                if (txPos + 1 < txSrcLen) { c2 = cssc::peek8(txSrc + txPos + 1); }
                if (c2 == 38) { txCur = 25; txPos = txPos + 2; }
                if (c2 != 38) { txCur = 30; txPos = txPos + 1; }
                done = 1;
                #delete[c2];
            }
        }
        if (done == 0) {
            if (c == 124) {

                #stack[int, 64] c2 = 0;
                if (txPos + 1 < txSrcLen) { c2 = cssc::peek8(txSrc + txPos + 1); }
                if (c2 == 124) { txCur = 26; txPos = txPos + 2; }
                if (c2 != 124) { txCur = 99; txPos = txPos + 1; }
                done = 1;
                #delete[c2];
            }
        }
        if (done == 0) {
            if (c == 45) {

                #stack[int, 64] c2 = 0;
                if (txPos + 1 < txSrcLen) { c2 = cssc::peek8(txSrc + txPos + 1); }
                if (c2 == 62) { txCur = 34; txPos = txPos + 2; }
                if (c2 != 62) { txCur = 5; txPos = txPos + 1; }
                done = 1;
                #delete[c2];
            }
        }
        if (done == 0) {
            #stack[int, 64] t = 99;
            if (c == 43) { t = 4; }
            if (c == 42) { t = 6; }
            if (c == 47) { t = 7; }
            if (c == 37) { t = 8; }
            if (c == 40) { t = 9; }
            if (c == 41) { t = 10; }
            if (c == 123) { t = 11; }
            if (c == 125) { t = 12; }
            if (c == 59) { t = 13; }
            if (c == 44) { t = 21; }
            if (c == 35) { t = 22; }
            if (c == 91) { t = 23; }
            if (c == 93) { t = 24; }

            if (c == 58) { t = 31; }
            if (c == 63) { t = 32; }

            if (c == 46) { t = 33; }
            txCur = t;
            txPos = txPos + 1;
            done = 1;
            #delete[t];
        }
        #delete[done];
        #delete[c];
    }
}

#define(txTokenize) {
    #req[txLexRaw] txLexRaw;
    #req[txPos] txPos;
    #req[txSrcLen] txSrcLen;
    #req[txTokCount] txTokCount;
    #req[txTokCap] txTokCap;
    #req[txTokCode] txTokCode;
    #req[txTokNumA] txTokNumA;
    #req[txTokFlag] txTokFlag;
    #req[txTokOffA] txTokOffA;
    #req[txTokLenA] txTokLenA;
    #req[txCur] txCur;
    #req[txTokNum] txTokNum;
    #req[txTokFloat] txTokFloat;
    #req[txTokOff] txTokOff;
    #req[txTokLen] txTokLen;
    #stack[int, 32] go = 1;
    while (go == 1) {
        if (txPos >= txSrcLen) { go = 0; }
        if (go == 1) {
            txLexRaw();
            if (txCur == 0) { go = 0; }
            if (go == 1) {
                if (txTokCount < txTokCap) {
                    cssc::poke8(txTokCode + txTokCount, txCur);
                    cssc::poke64(txTokNumA + txTokCount * 8, txTokNum);
                    cssc::poke8(txTokFlag + txTokCount, txTokFloat);
                    cssc::poke32(txTokOffA + txTokCount * 4, txTokOff);
                    cssc::poke32(txTokLenA + txTokCount * 4, txTokLen);
                    txTokCount = txTokCount + 1;
                }
            }
        }
    }
    #delete[go];
}

#define(txAdvance) {
    #req[txPos] txPos;
    #req[txTokCount] txTokCount;
    #req[txTokCode] txTokCode;
    #req[txTokNumA] txTokNumA;
    #req[txTokFlag] txTokFlag;
    #req[txTokOffA] txTokOffA;
    #req[txTokLenA] txTokLenA;
    #req[txCur] txCur;
    #req[txTokNum] txTokNum;
    #req[txTokFloat] txTokFloat;
    #req[txTokOff] txTokOff;
    #req[txTokLen] txTokLen;
    if (txPos >= txTokCount) {
        txCur = 0;
    }
    if (txPos < txTokCount) {
        txCur = cssc::peek8(txTokCode + txPos);
        txTokNum = cssc::peek64(txTokNumA + txPos * 8);
        txTokFloat = cssc::peek8(txTokFlag + txPos);
        txTokOff = cssc::peek32(txTokOffA + txPos * 4);
        txTokLen = cssc::peek32(txTokLenA + txPos * 4);
        txPos = txPos + 1;
    }
}

#define(txLexInit) {
    #req[txTokCap] txTokCap;
    #req[txTokCode] txTokCode;
    #req[txTokNumA] txTokNumA;
    #req[txTokFlag] txTokFlag;
    #req[txTokOffA] txTokOffA;
    #req[txTokLenA] txTokLenA;
    #req[txTokCount] txTokCount;
    #req[txPos] txPos;
    #req[txCur] txCur;
    #req[txSrc] txSrc;
    #req[txSrcLen] txSrcLen;
    #req[txTokNum] txTokNum;
    #req[txTokFloat] txTokFloat;
    #req[txTokOff] txTokOff;
    #req[txTokLen] txTokLen;

    txTokCap = 131072;
    txTokCode = cssc::alloc(txTokCap);
    txTokNumA = cssc::alloc(txTokCap * 8);
    txTokFlag = cssc::alloc(txTokCap);
    txTokOffA = cssc::alloc(txTokCap * 4);
    txTokLenA = cssc::alloc(txTokCap * 4);
    txTokCount = 0;
    txPos = 0;
    txCur = 0;
    txSrc = 0;
    txSrcLen = 0;
    txTokNum = 0;
    txTokFloat = 0;
    txTokOff = 0;
    txTokLen = 0;
}

#define(txTokenizeSrc) {
    #scanp(txTokenizeSrc, int, 0) srcAddr;
    #scanp(txTokenizeSrc, int, 1) srcLen;
    #req[txSrc] txSrc;
    #req[txSrcLen] txSrcLen;
    #req[txPos] txPos;
    #req[txTokCount] txTokCount;
    #req[txTokenize] txTokenize;
    txSrc = srcAddr;
    txSrcLen = srcLen;
    txPos = 0;
    txTokCount = 0;
    txTokenize();
    txPos = 0;
}

#stack[int, 64] txAstKind = 0;
#stack[int, 64] txAstA = 0;
#stack[int, 64] txAstB = 0;
#stack[int, 64] txAstC = 0;
#stack[int, 64] txAstNum = 0;
#stack[int, 64] txAstOff = 0;
#stack[int, 64] txAstLen = 0;
#stack[int, 64] txAstNext = 0;
#stack[int, 64] txDeclTrap = 0;

#stack[int, 64] txAstCount = 0;
#stack[int, 64] txAstCap = 0;

#stack[int, 64] txAstInit;
#define(txAstInit) {
    #req[txAstKind] txAstKind;
    #req[txAstA] txAstA;
    #req[txAstB] txAstB;
    #req[txAstC] txAstC;
    #req[txAstNum] txAstNum;
    #req[txAstOff] txAstOff;
    #req[txAstLen] txAstLen;
    #req[txAstNext] txAstNext;
    #req[txDeclTrap] txDeclTrap;
    #req[txAstCount] txAstCount;
    #req[txAstCap] txAstCap;
    txAstCap = 65536;
    txAstKind = cssc::alloc(txAstCap * 8);
    txAstA = cssc::alloc(txAstCap * 8);
    txAstB = cssc::alloc(txAstCap * 8);
    txAstC = cssc::alloc(txAstCap * 8);
    txAstNum = cssc::alloc(txAstCap * 8);
    txAstOff = cssc::alloc(txAstCap * 8);
    txAstLen = cssc::alloc(txAstCap * 8);
    txAstNext = cssc::alloc(txAstCap * 8);
    txDeclTrap = cssc::alloc(txAstCap * 8);
    cssc::memfill32(txDeclTrap, 0, txAstCap * 2);
    cssc::memfill32(txAstKind, 0, txAstCap * 2);
    cssc::memfill32(txAstA, 0, txAstCap * 2);
    cssc::memfill32(txAstB, 0, txAstCap * 2);
    cssc::memfill32(txAstC, 0, txAstCap * 2);
    cssc::memfill32(txAstNum, 0, txAstCap * 2);
    cssc::memfill32(txAstOff, 0, txAstCap * 2);
    cssc::memfill32(txAstLen, 0, txAstCap * 2);
    cssc::memfill32(txAstNext, 0, txAstCap * 2);

    txAstCount = 1;
}

#stack[int, 64] txAstNew;
#define(txAstNew) {
    #scanp(txAstNew, int, 0) kind;
    #req[txAstKind] txAstKind;
    #req[txAstA] txAstA;
    #req[txAstB] txAstB;
    #req[txAstC] txAstC;
    #req[txAstNum] txAstNum;
    #req[txAstOff] txAstOff;
    #req[txAstLen] txAstLen;
    #req[txAstNext] txAstNext;
    #req[txAstCount] txAstCount;
    #req[txAstCap] txAstCap;
    #stack[int, 64] id = txAstCount;
    if (id >= txAstCap) { id = txAstCap - 1; }
    if (id == txAstCount) { txAstCount = txAstCount + 1; }
    #stack[int, 64] o = id * 8;
    cssc::poke64(txAstKind + o, kind);
    cssc::poke64(txAstA + o, 0);
    cssc::poke64(txAstB + o, 0);
    cssc::poke64(txAstC + o, 0);
    cssc::poke64(txAstNum + o, 0);
    cssc::poke64(txAstOff + o, 0);
    cssc::poke64(txAstLen + o, 0);
    cssc::poke64(txAstNext + o, 0);
    #delete[o];
    return id;
}

#stack[int, 64] txParseCallArgs;
#define(txParseCallArgs) {
    #scanp(txParseCallArgs, int, 0) callNode;
    #req[txCur] txCur;
    #req[txAdvance] txAdvance;
    #req[txParseExpr] txParseExpr;
    #req[txAstA] txAstA;
    #req[txAstNext] txAstNext;
    #stack[int, 64] last = 0;
    #stack[int, 32] go = 1;
    if (txCur == 10) { go = 0; }
    if (txCur == 0) { go = 0; }
    while (go == 1) {
        txParseExpr() a;
        if (a != 0) {
            if (last == 0) { cssc::poke64(txAstA + callNode * 8, a); }
            if (last != 0) { cssc::poke64(txAstNext + last * 8, a); }
            last = a;
        }
        #delete[a];

        if (txCur == 21) { txAdvance(); } else { go = 0; }
    }
    #delete[go];
    #delete[last];
}

#stack[int, 64] txParsePrimary;
