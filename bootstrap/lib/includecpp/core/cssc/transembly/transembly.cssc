            if (did == 0) { if (kBrk == 1) { txAdvance(); txAstNew(28) s; node = s; did = 1; #delete[s]; if (txCur == 13) { txAdvance(); } } }
            if (did == 0) { if (kCont == 1) { txAdvance(); txAstNew(29) s; node = s; did = 1; #delete[s]; if (txCur == 13) { txAdvance(); } } }
            if (did == 0) { if (kMir == 1) { txParseMirror() s; node = s; did = 1; #delete[s]; } }
            if (did == 0) { if (kDes == 1) { txAdvance(); txAstNew(33) s; node = s; did = 1; #delete[s]; if (txCur == 13) { txAdvance(); } } }
            if (did == 0) { if (kObj == 1) { txParseObject() s; node = s; did = 1; #delete[s]; } }
