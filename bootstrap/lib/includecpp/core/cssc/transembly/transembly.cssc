    txBrPLen = cssc::alloc(64);
    txBrPIdx = cssc::alloc(64);
    #stack[int, 32] rounds = 1;
    while (rounds == 1) {
        txBrChanged = 0;
        #stack[int, 64] fi = 1;
        while (fi < txFuncCount) {
            #stack[int, 64] astNode = cssc::peek64(txFuncAstNode + fi * 8);
            #stack[int, 64] body = cssc::peek64(txAstA + astNode * 8);
            #stack[int, 64] first = cssc::peek64(txAstA + body * 8);

            txBrPCount = 0;
            #stack[int, 64] p = first;
            #stack[int, 32] pgo = 1;
            while (pgo == 1) {
                if (p == 0) { pgo = 0; }
                if (pgo == 1) {
                    if (cssc::peek64(txAstKind + p * 8) == 18) {
                        if (txBrPCount < 8) {
                            cssc::poke64(txBrPOff + txBrPCount * 8, cssc::peek64(txAstOff + p * 8));
                            cssc::poke64(txBrPLen + txBrPCount * 8, cssc::peek64(txAstLen + p * 8));
                            cssc::poke64(txBrPIdx + txBrPCount * 8, cssc::peek64(txAstNum + p * 8));
                            txBrPCount = txBrPCount + 1;
                        }
