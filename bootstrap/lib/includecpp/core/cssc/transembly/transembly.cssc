            if (did == 0) { if (kFor == 1) { txParseFor() s; node = s; did = 1; #delete[s]; } }
            if (did == 0) { if (kRet == 1) { txParseReturn() s; node = s; did = 1; #delete[s]; } }
            if (did == 0) { if (kSel == 1) { txParseSelect() s; node = s; did = 1; #delete[s]; } }
