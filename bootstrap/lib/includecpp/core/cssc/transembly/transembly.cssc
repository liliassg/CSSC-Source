            #delete[nxIsJump];
            #delete[nxCode];
            #delete[nx];
        }
    }
    if (did == 0) {
        if (txCur == 2) {
            #stack[int, 64] o = txTokOff;
            #stack[int, 64] l = txTokLen;
            txSpanIs(o, l, "if") kIf;
            txSpanIs(o, l, "while") kWh;
            txSpanIs(o, l, "for") kFor;
            txSpanIs(o, l, "return") kRet;
            txSpanIs(o, l, "select") kSel;
            txSpanIs(o, l, "jump") kJmp;
            txSpanIs(o, l, "break") kBrk;
            txSpanIs(o, l, "continue") kCont;
            txSpanIs(o, l, "mirror") kMir;
            txSpanIs(o, l, "destruct") kDes;
            txSpanIs(o, l, "object") kObj;
            txSpanIs(o, l, "sector") kSec;
            txSpanIs(o, l, "call") kCall;
            if (kIf == 1) { txParseIf() s; node = s; did = 1; #delete[s]; }
