                #stack[int, 32] pgo = 1;
                while (pgo == 1) {
                    if (pj < 6) { pgo = 0; }
                    if (pgo == 1) {
                        #stack[int, 64] psid = cssc::peek64(txCallArg + (argStart + pj) * 8);
                        txSsaOff(psid) pso;
                        txLoadRbp(0, pso);
                        txEmitByte(0x50);
                        #delete[pso];
                        pj = pj - 1;
                    }
                }
                #delete[pgo];
                #delete[pj];
            }

            #stack[int, 64] nload = argCount;
            if (nload > 6) { nload = 6; }
            #stack[int, 64] ai = 0;
            while (ai < nload) {
                #stack[int, 64] sid = cssc::peek64(txCallArg + (argStart + ai) * 8);
                txArgReg(ai) areg;
                txSsaOff(sid) aso;
                txLoadRbp(areg, aso);
                #delete[aso];
                #delete[areg];
                #delete[sid];
                ai = ai + 1;
            }
            #delete[ai];

            #stack[int, 64] nfill = calleeArity;
            if (nfill > 6) { nfill = 6; }
            #stack[int, 64] zi = argCount;
            while (zi < nfill) {
                txArgReg(zi) zreg;
                txZeroReg(zreg);
                #delete[zreg];
                zi = zi + 1;
            }
            #delete[zi];
            #delete[nfill];
            #delete[nload];

            txEmitByte(0xE8);
            cssc::poke64(txCallFixOff + txCallFixCount * 8, txCodeLen);
            cssc::poke64(txCallFixFunc + txCallFixCount * 8, funcIdx);
            txCallFixCount = txCallFixCount + 1;
            txEmitLE(0, 4);

            if (res >= 0) { txSsaOff(res) rso; txStoreRbp(0, rso); #delete[rso]; }

            if (nstack > 0) {
                #stack[int, 64] cleanup = (nstack + pad) * 8;
                if (cleanup < 128) { txEmitByte(0x48); txEmitByte(0x83); txEmitByte(0xC4); txEmitByte(cssc::band(cleanup, 255)); }
                if (cleanup >= 128) { txEmitByte(0x48); txEmitByte(0x81); txEmitByte(0xC4); txEmitLE(cleanup, 4); }
                #delete[cleanup];
            }
            #delete[pad];
            #delete[nstack];
            #delete[calleeArity];
            #delete[argCount];
            #delete[argStart];
            #delete[res];
            #delete[funcIdx];
        }
        #delete[op];
        #delete[o];
        r = r + 1;
    }
    #delete[r];
    #delete[rend];
    #delete[frame];
    #delete[cells];
    #delete[arity];
}

#stack[int, 64] txX86Emit;
#define(txX86Emit) {
    #req[txFuncCount] txFuncCount;
    #req[txEmitFunc] txEmitFunc;
    #req[txX86Fixup] txX86Fixup;
    #stack[int, 64] i = 0;
    while (i < txFuncCount) {
        txEmitFunc(i);
        i = i + 1;
    }
    #delete[i];
    txX86Fixup();
}

#stack[int, 64] txX86Fixup;
#define(txX86Fixup) {
    #req[txCode] txCode;
    #req[txCodeLen] txCodeLen;
    #req[txLeaOff] txLeaOff;
    #req[txLeaStr] txLeaStr;
    #req[txLeaCount] txLeaCount;
    #req[txLabelOff] txLabelOff;
    #req[txBrOff] txBrOff;
    #req[txBrLabel] txBrLabel;
    #req[txBrCount] txBrCount;
    #req[txCallFixOff] txCallFixOff;
    #req[txCallFixFunc] txCallFixFunc;
    #req[txCallFixCount] txCallFixCount;
    #req[txGlobFixOff] txGlobFixOff;
    #req[txGlobFixIdx] txGlobFixIdx;
    #req[txGlobFixCount] txGlobFixCount;
    #req[txStrDataLen] txStrDataLen;
    #req[txFuncEntryOff] txFuncEntryOff;

    #stack[int, 64] codeEnd = txCodeLen;
    #stack[int, 64] li = 0;
    while (li < txLeaCount) {
        #stack[int, 64] operandOff = cssc::peek64(txLeaOff + li * 8);
        #stack[int, 64] strOff = cssc::peek64(txLeaStr + li * 8);
        #stack[int, 64] disp = (codeEnd + strOff) - (operandOff + 4);
        cssc::poke8(txCode + operandOff, cssc::band(disp, 255));
        cssc::poke8(txCode + operandOff + 1, cssc::band(cssc::shr(disp, 8), 255));
        cssc::poke8(txCode + operandOff + 2, cssc::band(cssc::shr(disp, 16), 255));
        cssc::poke8(txCode + operandOff + 3, cssc::band(cssc::shr(disp, 24), 255));
        #delete[operandOff];
        #delete[strOff];
        #delete[disp];
        li = li + 1;
    }
    #delete[li];
    #delete[codeEnd];

    #stack[int, 64] bi = 0;
    while (bi < txBrCount) {
        #stack[int, 64] boff = cssc::peek64(txBrOff + bi * 8);
        #stack[int, 64] blab = cssc::peek64(txBrLabel + bi * 8);
        #stack[int, 64] target = cssc::peek64(txLabelOff + blab * 8);
        #stack[int, 64] bdisp = target - (boff + 4);
        cssc::poke8(txCode + boff, cssc::band(bdisp, 255));
        cssc::poke8(txCode + boff + 1, cssc::band(cssc::shr(bdisp, 8), 255));
        cssc::poke8(txCode + boff + 2, cssc::band(cssc::shr(bdisp, 16), 255));
        cssc::poke8(txCode + boff + 3, cssc::band(cssc::shr(bdisp, 24), 255));
        #delete[boff];
        #delete[blab];
        #delete[target];
        #delete[bdisp];
        bi = bi + 1;
    }
    #delete[bi];

    #stack[int, 64] ci = 0;
    while (ci < txCallFixCount) {
        #stack[int, 64] coff = cssc::peek64(txCallFixOff + ci * 8);
        #stack[int, 64] cfn = cssc::peek64(txCallFixFunc + ci * 8);
        #stack[int, 64] ctarget = cssc::peek64(txFuncEntryOff + cfn * 8);
        #stack[int, 64] cdisp = ctarget - (coff + 4);
        cssc::poke8(txCode + coff, cssc::band(cdisp, 255));
        cssc::poke8(txCode + coff + 1, cssc::band(cssc::shr(cdisp, 8), 255));
        cssc::poke8(txCode + coff + 2, cssc::band(cssc::shr(cdisp, 16), 255));
        cssc::poke8(txCode + coff + 3, cssc::band(cssc::shr(cdisp, 24), 255));
        #delete[coff];
        #delete[cfn];
        #delete[ctarget];
        #delete[cdisp];
        ci = ci + 1;
    }
    #delete[ci];

    #stack[int, 64] gbase = txCodeLen + txStrDataLen;
    #stack[int, 64] gi2 = 0;
    while (gi2 < txGlobFixCount) {
        #stack[int, 64] goff = cssc::peek64(txGlobFixOff + gi2 * 8);
        #stack[int, 64] gidx = cssc::peek64(txGlobFixIdx + gi2 * 8);
        #stack[int, 64] gdisp = (gbase + gidx) - (goff + 4);
        cssc::poke8(txCode + goff, cssc::band(gdisp, 255));
        cssc::poke8(txCode + goff + 1, cssc::band(cssc::shr(gdisp, 8), 255));
        cssc::poke8(txCode + goff + 2, cssc::band(cssc::shr(gdisp, 16), 255));
        cssc::poke8(txCode + goff + 3, cssc::band(cssc::shr(gdisp, 24), 255));
        #delete[goff];
        #delete[gidx];
        #delete[gdisp];
        gi2 = gi2 + 1;
    }
    #delete[gi2];
    #delete[gbase];
}

#stack[int, 64] txPutLit;
#define(txPutLit) {
    #scanp(txPutLit, string, 0) s;
    #stack[int, 64] sa = 0;
    #adress[s] sa;
    #stack[int, 64] hdr = cssc::peek64(sa);
    #stack[int, 64] len = cssc::peek32(hdr + 4);
    cssc::printRaw(hdr + 8, len);
    #delete[len];
    #delete[hdr];
    #delete[sa];
}

#stack[int, 64] txHexChar;
#define(txHexChar) {
    #scanp(txHexChar, int, 0) n;
    #stack[int, 64] c = 48 + n;
    if (n >= 10) { c = 87 + n; }
    #stack[int, 64] r = c;
    #delete[c];
    return r;
}

#stack[int, 64] txHexDump;
#define(txHexDump) {
    #scanp(txHexDump, int, 0) src;
    #scanp(txHexDump, int, 1) len;
    #req[txHexChar] txHexChar;
    #stack[int, 64] hb = cssc::alloc(len * 2 + 2);
    #stack[int, 64] i = 0;
    while (i < len) {
        #stack[int, 64] byte = cssc::band(cssc::peek8(src + i), 255);
        txHexChar(cssc::band(cssc::shr(byte, 4), 15)) hi;
        txHexChar(cssc::band(byte, 15)) lo;
        cssc::poke8(hb + i * 2, hi);
        cssc::poke8(hb + i * 2 + 1, lo);
        #delete[hi];
        #delete[lo];
        #delete[byte];
        i = i + 1;
    }
    cssc::printRaw(hb, len * 2);
    cssc::free(hb);
    #delete[i];
    #delete[hb];
}

#stack[int, 64] txEmitContainer;
#define(txEmitContainer) {
    #scanp(txEmitContainer, int, 0) entryOff;
    #req[txPutLit] txPutLit;
    #req[txHexDump] txHexDump;
    #req[txCode] txCode;
    #req[txCodeLen] txCodeLen;
    #req[txStrData] txStrData;
    #req[txStrDataLen] txStrDataLen;
    #req[txRelocOff] txRelocOff;
    #req[txRelocSym] txRelocSym;
    #req[txRelocCount] txRelocCount;
    #req[txGlobCount] txGlobCount;
    txPutLit("ENTRY ");
    cssc::out(entryOff);
    cssc::outln();
    txPutLit("CODE ");
    txHexDump(txCode, txCodeLen);
    cssc::outln();
    #stack[int, 64] i = 0;
    while (i < txRelocCount) {
        txPutLit("RELOC ");
        cssc::out(cssc::peek64(txRelocOff + i * 8));
        txPutLit(" ");
        cssc::out(cssc::peek64(txRelocSym + i * 8));
        cssc::outln();
        i = i + 1;
    }
    #delete[i];
    txPutLit("DATA ");
    txHexDump(txStrData, txStrDataLen);

    #stack[int, 64] gi3 = 0;
    while (gi3 < txGlobCount) {
        #stack[int, 64] zi = 0;
        while (zi < 8) { txPutLit("00"); zi = zi + 1; }
        txPutLit("01");
        #stack[int, 64] zj = 0;
        while (zj < 7) { txPutLit("00"); zj = zj + 1; }
        #delete[zj];
        #delete[zi];
        gi3 = gi3 + 1;
    }
    #delete[gi3];
    cssc::outln();
}

#stack[int, 64] txLoadModules;
#define(txLoadModules) {
    #scanp(txLoadModules, int, 0) mainBuf;
    #scanp(txLoadModules, int, 1) mainLen;
    #scanp(txLoadModules, int, 2) comb;
    #req[txTokCount] txTokCount;
    #req[txTokCode] txTokCode;
    #req[txTokOffA] txTokOffA;
    #req[txTokLenA] txTokLenA;
    #req[txSrc] txSrc;
    #req[txSpanIs] txSpanIs;
    #stack[int, 64] cn = 0;
    #stack[int, 64] ti = 0;
    #stack[int, 32] go = 1;
    while (go == 1) {
        if (ti + 3 >= txTokCount) { go = 0; }
        if (go == 1) {
            if (cssc::peek8(txTokCode + ti) == 22) {
                #stack[int, 64] koff = cssc::peek32(txTokOffA + (ti + 1) * 4);
                #stack[int, 64] klen = cssc::peek32(txTokLenA + (ti + 1) * 4);
                txSpanIs(koff, klen, "include") isInc;
                txSpanIs(koff, klen, "load") isLoad;
                #stack[int, 64] soff = cssc::peek32(txTokOffA + (ti + 3) * 4);
                #stack[int, 64] slen = cssc::peek32(txTokLenA + (ti + 3) * 4);
                if (isInc == 1) { cssc::modPathInc(txSrc + soff, slen); }
                if (isLoad == 1) { cssc::modPath(txSrc + soff, slen); }
                if (isInc + isLoad > 0) {
                    #stack[int, 64] nr = cssc::modRead(comb + cn, 1000000);
                    if (nr > 0) { cn = cn + nr; cssc::poke8(comb + cn, 10); cn = cn + 1; }
                    #delete[nr];
                }
                #delete[slen]; #delete[soff];
                #delete[isLoad]; #delete[isInc]; #delete[klen]; #delete[koff];
            }
            ti = ti + 1;
        }
    }
    #delete[go];
    #delete[ti];
    #stack[int, 64] mi = 0;
    #stack[int, 32] mg = 1;
    while (mg == 1) {
        if (mi >= mainLen) { mg = 0; }
        if (mg == 1) { cssc::poke8(comb + cn + mi, cssc::peek8(mainBuf + mi)); mi = mi + 1; }
    }
    #delete[mg];
    cn = cn + mainLen;
    #delete[mi];
    return cn;
}

#stack[int, 64] buf = cssc::alloc(1048576);
#stack[int, 64] n = cssc::hostRead(buf, 1000000);

txLexInit();
txTokenizeSrc(buf, n);

#stack[int, 64] comb = cssc::alloc(4194304);
#stack[int, 64] cn = txLoadModules(buf, n, comb);
txTokenizeSrc(comb, cn);

txAstInit();
txParseProgram() prog;

txValidateLits(prog) litBad;
if (litBad == 0) {
    txCirInit();
    txLower(prog);

    if (txIsoBad == 0) {
        txX86Init();
        txX86Emit();
        txEmitContainer(0);
    }
}
if (litBad != 0) {
    #stack[string, 256] e020 = "E020: Bare-Heap-Literal in Argument-/Operand-Position hat keinen besitzenden Slot. CSSC v5 fordert, dass jeder Heap-Wert in einem deklarierten Slot lebt.";
    cssc::outln(e020);
    #delete[e020];
}

#delete[litBad];
#delete[prog];
#delete[n];
#delete[buf];
