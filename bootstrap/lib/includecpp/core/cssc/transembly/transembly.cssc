#stack[int, 64] txParseStmt;
#define(txParseStmt) {
    #req[txCur] txCur;
    #req[txTokOff] txTokOff;
    #req[txTokLen] txTokLen;
    #req[txAdvance] txAdvance;
    #req[txParseHash] txParseHash;
    #req[txParseIf] txParseIf;
    #req[txParseWhile] txParseWhile;
    #req[txParseFor] txParseFor;
    #req[txParseReturn] txParseReturn;
    #req[txParseBlock] txParseBlock;
    #req[txParseIdentStmt] txParseIdentStmt;
    #req[txParseSelect] txParseSelect;
    #req[txParseJump] txParseJump;
    #req[txParseMirror] txParseMirror;
    #req[txParseObject] txParseObject;
    #req[txParseSector] txParseSector;
    #req[txParseCall] txParseCall;
    #req[txSpanIs] txSpanIs;
    #req[txAstNew] txAstNew;
    #req[txPos] txPos;
    #req[txTokCode] txTokCode;
    #req[txTokOffA] txTokOffA;
    #req[txTokLenA] txTokLenA;
    #stack[int, 64] node = 0;
    #stack[int, 64] before = txPos;
    #stack[int, 32] did = 0;
    if (txCur == 22) { txParseHash() d; node = d; did = 1; #delete[d]; }
    if (did == 0) { if (txCur == 11) { txParseBlock() b; node = b; did = 1; #delete[b]; } }

    if (did == 0) {
        if (txCur == 27) {
            #stack[int, 64] nx = txPos;
            #stack[int, 64] nxCode = cssc::peek8(txTokCode + nx);
