                    p = cssc::peek64(txAstNext + p * 8);
                }
            }
            #delete[pgo];
            #delete[p];
            txBrScanStmts(first, fi);
            #delete[first];
            #delete[body];
            #delete[astNode];
            fi = fi + 1;
        }
        #delete[fi];
        if (txBrChanged == 0) { rounds = 0; }
    }
    #delete[rounds];
}

