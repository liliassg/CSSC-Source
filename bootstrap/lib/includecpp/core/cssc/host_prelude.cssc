

#stack[int, 64] cfgLang = 0;
#stack[int, 64] cfgLayout = 0;

#stack[int, 64] fsIdx = 0;
#stack[int, 64] fsCount = 0;
#stack[int, 64] fsNames = 0;
#stack[int, 64] fsLens = 0;
#stack[int, 64] fsData = 0;
#stack[int, 64] fsSizes = 0;

#stack[int, 64] keyBufAddr = 0;
#stack[int, 64] keyHead = 0;

#stack[int, 64] tickCount = 0;
#stack[int, 64] mouseX = 0;
#stack[int, 64] mouseY = 0;
#stack[int, 64] mouseFlags = 0;

#stack[int, 64] sdInit;
#define(sdInit) { return 0; }
#stack[int, 64] sdWriteRange;
#define(sdWriteRange) {
    #scanp(sdWriteRange, int, 0) a;
    #scanp(sdWriteRange, int, 1) b;
    #scanp(sdWriteRange, int, 2) c;
    return 0;
}
