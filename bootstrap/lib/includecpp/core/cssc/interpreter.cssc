                }
                if (ct != 1) {
                    #stack[int, 32] anyF = 0;
                    if (ct == 2) { anyF = 1; }
                    if (rt == 2) { anyF = 1; }
                    if (anyF == 1) {
                        #stack[int, 64] la = cur;
                        #stack[int, 64] ra = rhs;
                        if (ct != 2) { cssc::iToF(cur) t; la = t; #delete[t]; }
                        if (rt != 2) { cssc::iToF(rhs) t; ra = t; #delete[t]; }
                        nv = cssc::fAdd(la, ra); nt = 2;
                        #delete[la];
                        #delete[ra];
                    }
                    if (anyF == 0) { nv = cur + rhs; nt = 0; }
                    #delete[anyF];
                }
                ciVarSet(o, l, nv, nt, no);
                #delete[nv];
                #delete[nt];
                #delete[no];
                #delete[ct];
                #delete[cur];
            }
            if (ciExec == 0) { if (ro == 1) { if (rt == 1) { cssc::free(rhs); } } }
            #delete[rhs];
            #delete[rt];
            #delete[ro];
        }
    }

    if (ciCur == 5) {
        ciAdvance();
        if (ciCur == 5) {
            ciAdvance();
            if (ciExec == 1) {
                ciVarGet(o, l) cur;
                #stack[int, 64] ct = ciEvalType;
                #stack[int, 64] nv = cur - 1;
                if (ct == 2) { nv = cssc::fSub(cur, cssc::iToF(1)); }
                ciVarSet(o, l, nv, ct, 0);
                #delete[nv];
                #delete[ct];
                #delete[cur];
            }
        }
        if (ciCur == 14) {
            ciAdvance();
            ciExpr(0) rhs;
            #stack[int, 64] rt = ciEvalType;
            #stack[int, 64] ro = ciEvalOwns;
            if (ciExec == 1) {
                ciVarGet(o, l) cur;
                #stack[int, 64] ct = ciEvalType;
                #stack[int, 64] nv = 0;
                #stack[int, 64] nt = 0;
                #stack[int, 32] anyF = 0;
                if (ct == 2) { anyF = 1; }
                if (rt == 2) { anyF = 1; }
                if (anyF == 1) {
                    #stack[int, 64] la = cur;
                    #stack[int, 64] ra = rhs;
                    if (ct != 2) { cssc::iToF(cur) t; la = t; #delete[t]; }
                    if (rt != 2) { cssc::iToF(rhs) t; ra = t; #delete[t]; }
                    nv = cssc::fSub(la, ra); nt = 2;
                    #delete[la];
                    #delete[ra];
                }
                if (anyF == 0) { nv = cur - rhs; nt = 0; }
                #delete[anyF];
                ciVarSet(o, l, nv, nt, 0);
                #delete[nv];
                #delete[nt];
                #delete[ct];
                #delete[cur];
            }
            if (ciExec == 0) { if (ro == 1) { if (rt == 1) { cssc::free(rhs); } } }
            #delete[rhs];
            #delete[rt];
            #delete[ro];
        }
    }
    if (ciCur == 13) {
        ciAdvance();
    }
}

#define(ciDoDecl) {
    #req[ciCur] ciCur;
    #req[ciTokOff] ciTokOff;
    #req[ciTokLen] ciTokLen;
    #req[ciTokNum] ciTokNum;
    #req[ciPos] ciPos;
    #req[ciSrc] ciSrc;
    #req[ciExec] ciExec;
    #req[ciEvalType] ciEvalType;
    #req[ciEvalOwns] ciEvalOwns;
    #req[ciScopeBase] ciScopeBase;
    #req[ciArgVals] ciArgVals;
    #req[ciArgTypes] ciArgTypes;
    #req[ciVVals] ciVVals;
    #req[ciVTypes] ciVTypes;
    #req[ciSecInit] ciSecInit;
    #req[ciSecVis] ciSecVis;
    #req[ciBindVis] ciBindVis;
    #req[ciBindBits] ciBindBits;
    #req[ciRegSecOff] ciRegSecOff;
    #req[ciRegSecLen] ciRegSecLen;
    #req[ciCurSecOff] ciCurSecOff;
    #req[ciCurSecLen] ciCurSecLen;
    #req[ciQualBuf] ciQualBuf;
    #req[ciAdvance] ciAdvance;
    #req[ciIdentIs] ciIdentIs;
    #req[ciQualify] ciQualify;
    #req[ciTokHasCC] ciTokHasCC;
    #req[ciVarFindGlobal] ciVarFindGlobal;
    #req[ciVarFind] ciVarFind;
    #req[ciVReq] ciVReq;
    #req[ciExpr] ciExpr;
    #req[ciVarSet] ciVarSet;
    #req[ciVarGet] ciVarGet;
    #req[ciVarDrop] ciVarDrop;
    #req[ciVecNew] ciVecNew;
    #req[ciStrNew] ciStrNew;
    #req[ciVecPush] ciVecPush;
    #req[ciVecFree] ciVecFree;
    #req[ciMapNew] ciMapNew;
    #req[ciBindNew] ciBindNew;
    #req[ciBindRawSet] ciBindRawSet;
    #req[ciBindFree] ciBindFree;
    #req[ciModConsole] ciModConsole;
    #req[ciConNew] ciConNew;
    #req[ciFnRegister] ciFnRegister;
    #req[ciCdOff] ciCdOff;
    #req[ciCdLen] ciCdLen;
    #req[ciFnParCnt] ciFnParCnt;
    #req[ciFnParOff] ciFnParOff;
    #req[ciFnParLen] ciFnParLen;
    #req[ciCurInst] ciCurInst;
    #req[ciInstMemFind] ciInstMemFind;
    #req[ciInstMemSet] ciInstMemSet;
    #req[ciInstFree] ciInstFree;

    #stack[int, 64] o = ciTokOff;
    #stack[int, 64] l = ciTokLen;
    ciIdentIs(o, l, "delete") isdel;
    ciIdentIs(o, l, "define") isdef;
    ciIdentIs(o, l, "scanp") isscan;
    ciIdentIs(o, l, "req") isreq;

    ciIdentIs(o, l, "cdefine") iscdef;
    ciIdentIs(o, l, "param") isparam;
    ciIdentIs(o, l, "fvar") isfvar;
    ciIdentIs(o, l, "qvar") isqvar;

    ciIdentIs(o, l, "vector") isvec;
    ciIdentIs(o, l, "map") ismap;

    ciIdentIs(o, l, "array") isarr;

    ciIdentIs(o, l, "video") isvid;

    ciIdentIs(o, l, "console") iscons;
    #stack[int, 32] ctag = 0;
    if (isvec == 1) { ctag = 4; }
    if (ismap == 1) { ctag = 5; }
    if (isarr == 1) { ctag = 4; }
    ciAdvance();

    if (isvid == 1) {
        #stack[int, 64] vw = 0;
        #stack[int, 64] vh = 0;
        #stack[int, 64] vfps = 0;
        if (ciCur == 23) {
            ciAdvance();
            ciExpr(0) e0;
            vw = e0;
            #delete[e0];
            if (ciCur == 21) { ciAdvance(); }
            ciExpr(0) e1;
            vh = e1;
            #delete[e1];
            if (ciCur == 21) { ciAdvance(); }
            ciExpr(0) e2;
            vfps = e2;
            #delete[e2];
            if (ciCur == 24) { ciAdvance(); }
        }
        #stack[int, 64] vno = ciTokOff;
        #stack[int, 64] vnl = ciTokLen;
        ciAdvance();
        if (ciCur == 13) { ciAdvance(); }
        if (ciExec == 1) {
            if (vw < 1) { vw = 1; }
            if (vh < 1) { vh = 1; }
            if (vfps <= 0) { vfps = 60; }
            #stack[int, 64] hd = cssc::alloc(24);
            #stack[int, 64] buf = cssc::alloc(vw * vh * 4);
            cssc::memfill32(buf, 0, vw * vh);
            cssc::poke32(hd, vw);
            cssc::poke32(hd + 4, vh);
            cssc::poke32(hd + 8, vfps);
            cssc::poke32(hd + 12, 1);
            cssc::poke64(hd + 16, buf);
            ciVarSet(vno, vnl, hd, 0, 0);
            #delete[hd];
            #delete[buf];
        }
        #delete[vw];
        #delete[vh];
        #delete[vfps];
        #delete[vno];
        #delete[vnl];
    }

    if (iscons == 1) {
        #stack[int, 64] cw = 80;
        #stack[int, 64] cvh = 25;
        if (ciCur == 23) {
            ciAdvance();
            ciExpr(0) e0;
            cw = e0;
            #delete[e0];
            if (ciCur == 21) { ciAdvance(); }
            ciExpr(0) e1;
            cvh = e1;
            #delete[e1];
            if (ciCur == 24) { ciAdvance(); }
        }
        #stack[int, 64] cno = ciTokOff;
        #stack[int, 64] cnl = ciTokLen;
        ciAdvance();
        if (ciCur == 13) { ciAdvance(); }
        if (ciExec == 1) {
            if (ciModConsole == 1) {
                if (cw < 1) { cw = 1; }
                if (cvh < 1) { cvh = 1; }
                ciConNew(cw, cvh) hd;
                ciVarSet(cno, cnl, hd, 6, 1);
                #delete[hd];
            }
        }
        #delete[cw];
        #delete[cvh];
        #delete[cno];
        #delete[cnl];
    }

    if (isdef == 1) {
        if (ciCur == 9) { ciAdvance(); }
        #stack[int, 64] dno = ciTokOff;
        #stack[int, 64] dnl = ciTokLen;
        ciAdvance();
        if (ciCur == 10) { ciAdvance(); }

        #stack[int, 64] bstart = ciPos;
        #stack[int, 32] depth = 1;
        #stack[int, 32] scan = 1;
        while (scan == 1) {
            ciAdvance();
            if (ciCur == 0) { scan = 0; }
            if (ciCur == 11) { depth = depth + 1; }
            if (ciCur == 12) {
                depth = depth - 1;
                if (depth == 0) { scan = 0; }
            }
        }
        #delete[scan];
        #delete[depth];
        #stack[int, 64] bend = ciPos;

        if (ciExec == 1) {
            ciTokHasCC(dno, dnl) dcc;
            ciRegSecOff = 0;
            ciRegSecLen = 0;
            ciBindVis = 1;
            #stack[int, 64] rno = dno;
            #stack[int, 64] rnl = dnl;
            if (ciSecInit == 1) {
                if (dcc < 0) {

                    ciQualify(ciCurSecOff, ciCurSecLen, dno, dnl) ql;
                    rno = ciQualBuf - ciSrc;
                    rnl = ql;
                    #delete[ql];
                    ciRegSecOff = ciCurSecOff;
                    ciRegSecLen = ciCurSecLen;
                    ciBindVis = ciSecVis;
                }
            }
            if (dcc >= 0) {

                ciRegSecOff = dno;
                ciRegSecLen = dcc;
            }
            ciFnRegister(rno, rnl, bstart, bend);
            ciRegSecOff = 0;
            ciRegSecLen = 0;
            ciBindVis = 1;
            #delete[rno];
            #delete[rnl];
            #delete[dcc];
        }
        if (ciCur == 12) { ciAdvance(); }
        #delete[bstart];
        #delete[bend];
        #delete[dno];
        #delete[dnl];
    }

    if (iscdef == 1) {
        if (ciCur == 9) { ciAdvance(); }
        #stack[int, 64] dno = ciTokOff;
        #stack[int, 64] dnl = ciTokLen;
        ciAdvance();

        #stack[int, 64] pcnt = 0;
        #stack[int, 32] pc = 1;
        while (pc == 1) {
            if (ciCur == 21) {
                ciAdvance();
                if (ciCur == 2) {
                    if (pcnt < 8) {
                        cssc::poke64(ciCdOff + pcnt * 8, ciTokOff);
                        cssc::poke64(ciCdLen + pcnt * 8, ciTokLen);
                        pcnt = pcnt + 1;
                    }
                    ciAdvance();
                }
            }
            if (ciCur != 21) { pc = 0; }
        }
        #delete[pc];
        if (ciCur == 10) { ciAdvance(); }

        #stack[int, 64] bstart = ciPos;
        #stack[int, 32] depth = 1;
        #stack[int, 32] scan = 1;
        while (scan == 1) {
            ciAdvance();
            if (ciCur == 0) { scan = 0; }
            if (ciCur == 11) { depth = depth + 1; }
            if (ciCur == 12) {
                depth = depth - 1;
                if (depth == 0) { scan = 0; }
            }
        }
        #delete[scan];
        #delete[depth];
        #stack[int, 64] bend = ciPos;
        if (ciExec == 1) {
            ciTokHasCC(dno, dnl) dcc;
            ciRegSecOff = 0;
            ciRegSecLen = 0;
            ciBindVis = 1;
            #stack[int, 64] rno = dno;
            #stack[int, 64] rnl = dnl;
            if (ciSecInit == 1) {
                if (dcc < 0) {
                    ciQualify(ciCurSecOff, ciCurSecLen, dno, dnl) ql;
                    rno = ciQualBuf - ciSrc;
                    rnl = ql;
                    #delete[ql];
                    ciRegSecOff = ciCurSecOff;
                    ciRegSecLen = ciCurSecLen;
                    ciBindVis = ciSecVis;
                }
            }
            if (dcc >= 0) {
                ciRegSecOff = dno;
                ciRegSecLen = dcc;
            }
            ciFnRegister(rno, rnl, bstart, bend) frow;
            if (frow >= 0) {
                cssc::poke64(ciFnParCnt + frow * 8, pcnt);
                #stack[int, 32] cpi = 0;
                while (cpi < pcnt) {
                    cssc::poke64(ciFnParOff + (frow * 8 + cpi) * 8, cssc::peek64(ciCdOff + cpi * 8));
                    cssc::poke64(ciFnParLen + (frow * 8 + cpi) * 8, cssc::peek64(ciCdLen + cpi * 8));
                    cpi = cpi + 1;
                }
                #delete[cpi];
            }
            ciRegSecOff = 0;
            ciRegSecLen = 0;
            ciBindVis = 1;
            #delete[frow];
            #delete[rno];
            #delete[rnl];
            #delete[dcc];
        }
        if (ciCur == 12) { ciAdvance(); }
        #delete[bstart];
        #delete[bend];
        #delete[pcnt];
        #delete[dno];
        #delete[dnl];
    }

    if (isparam == 1) {
        if (ciCur == 23) {
            #stack[int, 32] pd = 1;
            while (pd > 0) {
                ciAdvance();
                if (ciCur == 23) { pd = pd + 1; }
                if (ciCur == 24) { pd = pd - 1; }
                if (ciCur == 0) { pd = 0; }
            }
            #delete[pd];
            if (ciCur == 24) { ciAdvance(); }
        }
        if (ciCur == 2) { ciAdvance(); }
        if (ciCur == 13) { ciAdvance(); }
    }

    if (isfvar == 1) {
        if (ciCur == 9) {
            #stack[int, 32] fd = 1;
            while (fd > 0) {
                ciAdvance();
                if (ciCur == 9) { fd = fd + 1; }
                if (ciCur == 10) { fd = fd - 1; }
                if (ciCur == 0) { fd = 0; }
            }
            #delete[fd];
            if (ciCur == 10) { ciAdvance(); }
        }
        #stack[int, 64] fno = ciTokOff;
        #stack[int, 64] fnl = ciTokLen;
        ciAdvance();
        if (ciExec == 1) { ciVarSet(fno, fnl, 0, 0, 0); }
        if (ciCur == 13) { ciAdvance(); }
        #delete[fno];
        #delete[fnl];
    }

    if (isqvar == 1) {
        #stack[int, 64] qv = 0;
        #stack[int, 64] qt = 0;
        if (ciCur == 9) {
            ciAdvance();
            if (ciCur == 2) { ciAdvance(); }
            if (ciCur == 21) { ciAdvance(); }
            ciExpr(0) qe;
            qv = qe;
            qt = ciEvalType;
            #delete[qe];
            if (ciCur == 10) { ciAdvance(); }
        }
        #stack[int, 64] qno = ciTokOff;
        #stack[int, 64] qnl = ciTokLen;
        ciAdvance();
        if (ciExec == 1) { ciVarSet(qno, qnl, qv, qt, 0); }
        if (ciCur == 13) { ciAdvance(); }
        #delete[qv];
        #delete[qt];
        #delete[qno];
        #delete[qnl];
    }

    if (isscan == 1) {
        if (ciCur == 9) { ciAdvance(); }
        if (ciCur == 2) { ciAdvance(); }
        if (ciCur == 21) { ciAdvance(); }
        if (ciCur == 2) { ciAdvance(); }

        if (ciCur == 17) {
            #stack[int, 32] gd = 1;
            while (gd > 0) {
                ciAdvance();
                if (ciCur == 17) { gd = gd + 1; }
                if (ciCur == 18) { gd = gd - 1; }
                if (ciCur == 0) { gd = 0; }
            }
            #delete[gd];
            if (ciCur == 18) { ciAdvance(); }
        }
        if (ciCur == 21) { ciAdvance(); }
        #stack[int, 64] apos = 0;
        if (ciCur == 1) { apos = ciTokNum; ciAdvance(); }
        if (ciCur == 10) { ciAdvance(); }

        if (ciCur == 30) { ciAdvance(); }
        if (ciCur == 6) { ciAdvance(); }
        #stack[int, 64] sno = ciTokOff;
        #stack[int, 64] snl = ciTokLen;
        ciAdvance();
        #stack[int, 64] av = cssc::peek64(ciArgVals + apos * 8);
        #stack[int, 64] at = cssc::peek64(ciArgTypes + apos * 8);

        if (ciExec == 1) { ciVarSet(sno, snl, av, at, 0); }
        if (ciCur == 13) { ciAdvance(); }
        #delete[apos];
        #delete[av];
        #delete[at];
        #delete[sno];
        #delete[snl];
    }

    if (isreq == 1) {
        if (ciCur == 23) { ciAdvance(); }
        #stack[int, 64] gno = ciTokOff;
        #stack[int, 64] gnl = ciTokLen;
        ciAdvance();
        if (ciCur == 24) { ciAdvance(); }
        if (ciCur == 30) { ciAdvance(); }
        if (ciCur == 6) { ciAdvance(); }
        #stack[int, 64] ano = ciTokOff;
        #stack[int, 64] anl = ciTokLen;
        ciAdvance();

        #stack[int, 64] gv = 0;
        #stack[int, 64] gt = 0;
        #stack[int, 32] got = 0;
        #stack[int, 64] targetRow = 0 - 1;
        if (ciCurSecLen > 0) {
            ciQualify(ciCurSecOff, ciCurSecLen, gno, gnl) ql;
            ciVarFindGlobal(ciQualBuf - ciSrc, ql) qi;
            if (qi >= 0) {
                gv = cssc::peek64(ciVVals + qi * 8);
                gt = cssc::peek64(ciVTypes + qi * 8);
                got = 1;
                targetRow = qi;
            }
            #delete[qi];
            #delete[ql];
        }
        if (got == 0) {

            #stack[int, 64] savedBase = ciScopeBase;
            ciScopeBase = 0;
            ciVarGet(gno, gnl) g2;
            gv = g2;
            gt = ciEvalType;
            ciScopeBase = savedBase;
            #delete[g2];
            #delete[savedBase];
            ciVarFindGlobal(gno, gnl) tr;
            targetRow = tr;
            #delete[tr];
        }

        if (ciExec == 1) {
            ciVarSet(ano, anl, gv, gt, 0);
            if (targetRow >= 0) {
                ciVarFind(ano, anl) arow;
                if (arow >= 0) { cssc::poke64(ciVReq + arow * 8, targetRow + 1); }
                #delete[arow];
            }
        }
        if (ciCur == 13) { ciAdvance(); }
        #delete[targetRow];
        #delete[got];
        #delete[gv];
        #delete[gt];
        #delete[gno];
        #delete[gnl];
        #delete[ano];
        #delete[anl];
    }

    #stack[int, 32] isvar = 0;
    if (isdel == 0) { if (isdef == 0) { if (isscan == 0) { if (isreq == 0) { if (isvid == 0) { if (iscons == 0) {
    if (iscdef == 0) { if (isparam == 0) { if (isfvar == 0) { if (isqvar == 0) { isvar = 1; } } } } } } } } } }

    if (isdel == 1) {
        if (ciCur == 23) { ciAdvance(); }

        #stack[int, 64] dno = ciTokOff;
        #stack[int, 64] dnl = ciTokLen;
        #stack[int, 32] hasName = 0;
        if (ciCur == 2) { hasName = 1; ciAdvance(); }

        #stack[int, 32] isArrow = 0;
        #stack[int, 64] dmo = 0;
        #stack[int, 64] dml = 0;
        if (ciCur == 34) {
            ciAdvance();
            dmo = ciTokOff;
            dml = ciTokLen;
            isArrow = 1;
            if (ciCur == 2) { ciAdvance(); }
        }

        #stack[int, 32] dsk = 1;
        while (dsk == 1) {
            if (ciCur == 24) { dsk = 0; }
            if (ciCur == 0) { dsk = 0; }
            if (dsk == 1) { ciAdvance(); }
        }
        if (ciCur == 24) { ciAdvance(); }
        if (ciCur == 13) { ciAdvance(); }
        if (ciExec == 1) {
            if (isArrow == 1) {
                if (ciCurInst != 0) {
                    ciInstMemFind(ciCurInst, dmo, dml) mi;
                    if (mi >= 0) {
                        #stack[int, 64] mrow = ciCurInst + 24 + mi * 64;
                        #stack[int, 64] mo2 = cssc::peek64(mrow + 56);
                        #stack[int, 64] mt2 = cssc::peek64(mrow + 48);
                        #stack[int, 64] mv2 = cssc::peek64(mrow + 40);
                        if (mo2 == 1) {
                            if (mt2 == 1) { cssc::free(mv2); }
                            if (mt2 == 3) { if (mv2 != 0) { ciInstFree(mv2); } }
                        }

                        cssc::poke64(mrow + 32, 0);
                        cssc::poke64(mrow + 40, 0);
                        cssc::poke64(mrow + 48, 0);
                        cssc::poke64(mrow + 56, 0);
                        #delete[mo2];
                        #delete[mt2];
                        #delete[mv2];
                        #delete[mrow];
                    }
                    #delete[mi];
                }
            }
            if (isArrow == 0) {
                if (hasName == 1) { ciVarDrop(dno, dnl); }
            }
        }
        #delete[dsk];
        #delete[isArrow];
        #delete[dmo];
        #delete[dml];
        #delete[hasName];
        #delete[dno];
        #delete[dnl];
    }

    if (isvar == 1) {
        #stack[int, 32] declType = 0;

        #stack[int, 64] declBits = 64;
        if (ciCur == 23) {
            ciAdvance();

            if (ciCur == 2) {
                #stack[int, 64] to = ciTokOff;
                #stack[int, 64] tl = ciTokLen;
                ciIdentIs(to, tl, "string") isstr;
                ciIdentIs(to, tl, "bind") isbnd;
                ciIdentIs(to, tl, "float") isflt;

                ciIdentIs(to, tl, "vector") isvT;
                ciIdentIs(to, tl, "array") isaT;
                ciIdentIs(to, tl, "map") ismT;
                if (isstr == 1) { declType = 1; }
                if (isbnd == 1) { ctag = 7; }
                if (isflt == 1) { declType = 2; }
                if (isvT == 1) { ctag = 4; }
                if (isaT == 1) { ctag = 4; }
                if (ismT == 1) { ctag = 5; }
                #delete[ismT];
                #delete[isaT];
                #delete[isvT];
                #delete[isflt];
                #delete[isbnd];
                #delete[isstr];
                #delete[to];
                #delete[tl];
            }

            #stack[int, 32] gotBits = 0;
            #stack[int, 32] sk = 1;
            while (sk == 1) {
                if (ciCur == 24) { sk = 0; }
                if (ciCur == 0) { sk = 0; }
                if (sk == 1) {
                    if (ciCur == 1) {
                        if (gotBits == 0) {
                            declBits = ciTokNum;
                            gotBits = 1;
                        }
                    }

                    if (ctag != 0) {
                        if (ciCur == 2) {
                            ciIdentIs(ciTokOff, ciTokLen, "string") eS;
                            ciIdentIs(ciTokOff, ciTokLen, "float") eF;
                            if (eS == 1) { declType = 1; }
                            if (eF == 1) { declType = 2; }
                            #delete[eS];
                            #delete[eF];
                        }
                    }
                    ciAdvance();
