    }
    if (sn != 0) {
        #stack[int, 64] start = 0;
        #stack[int, 64] i = 0;
        while (i + sn <= hn) {
            #stack[int, 32] m = 1;
            #stack[int, 64] j = 0;
            while (j < sn) {
                if (cssc::peek8(sp + 8 + i + j) != cssc::peek8(sepp + 8 + j)) { m = 0; j = sn; }
                if (m == 1) { j = j + 1; }
