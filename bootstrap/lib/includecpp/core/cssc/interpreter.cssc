#define(ciConAttr) {
    #scanp(ciConAttr, int, 0) color;
    #stack[int, 64] col = color;
    if (col < 0) { col = 13421772; }
    #stack[int, 64] r = cssc::band(cssc::shr(col, 16), 255);
    #stack[int, 64] g = cssc::band(cssc::shr(col, 8), 255);
    #stack[int, 64] b = cssc::band(col, 255);
    #stack[int, 64] mx = r;
    if (g > mx) { mx = g; }
    if (b > mx) { mx = b; }
    #stack[int, 64] hi = 0;
    if (mx >= 160) { hi = 8; }
    #stack[int, 64] attr = 0;
    if (r >= 128) { attr = attr + 4; }
    if (g >= 128) { attr = attr + 2; }
    if (b >= 128) { attr = attr + 1; }
    if (attr == 0) { attr = 7; }
    #stack[int, 64] res = attr + hi;
    #delete[col];
    #delete[r];
    #delete[g];
    #delete[b];
    #delete[mx];
    #delete[hi];
    #delete[attr];
    return res;
}

#define(ciConNew) {
    #scanp(ciConNew, int, 0) w;
    #scanp(ciConNew, int, 1) h;
    #stack[int, 64] hd = cssc::alloc(64);
    #stack[int, 64] cells = cssc::alloc(w * h * 2);
    #stack[int, 64] st = cssc::alloc(64);
    #stack[int, 64] sl = cssc::alloc(64);
    #stack[int, 64] sn = cssc::alloc(64);
    cssc::poke32(hd, w);
    cssc::poke32(hd + 4, h);
    cssc::poke32(hd + 8, 0);
    cssc::poke32(hd + 12, 0);
    cssc::poke32(hd + 16, 7);
    cssc::poke32(hd + 20, 7);
    cssc::poke32(hd + 24, 0);
    cssc::poke32(hd + 28, 0);
    cssc::poke64(hd + 32, cells);
    cssc::poke64(hd + 40, st);
    cssc::poke64(hd + 48, sl);
    cssc::poke64(hd + 56, sn);
    cssc::memfill32(st, 0, 16);
    cssc::memfill32(sl, 0, 16);
    cssc::memfill32(sn, 0, 16);
    #stack[int, 64] i = 0;
    #stack[int, 64] total = w * h;
    while (i < total) {
        cssc::poke8(cells + i * 2, 32);
        cssc::poke8(cells + i * 2 + 1, 7);
        i = i + 1;
    }
    #delete[i];
    #delete[total];
    #delete[cells];
    #delete[st];
    #delete[sl];
    #delete[sn];
    return hd;
}

#define(ciConScroll) {
    #scanp(ciConScroll, int, 0) ch;
    #stack[int, 64] w = cssc::peek32(ch);
    #stack[int, 64] h = cssc::peek32(ch + 4);
    #stack[int, 64] da = cssc::peek32(ch + 20);
    #stack[int, 64] cells = cssc::peek64(ch + 32);
    if (h > 1) {
        cssc::memcopy(cells, cells + w * 2, (h - 1) * w * 2);
    }
    #stack[int, 64] base = (h - 1) * w;
    #stack[int, 64] c = 0;
    while (c < w) {
        cssc::poke8(cells + (base + c) * 2, 32);
        cssc::poke8(cells + (base + c) * 2 + 1, da);
        c = c + 1;
    }
    #delete[c];
    #delete[base];
    #delete[w];
    #delete[h];
    #delete[da];
    #delete[cells];
}

#define(ciConPutc) {
    #scanp(ciConPutc, int, 0) ch;
    #scanp(ciConPutc, int, 1) b;
    #req[ciConScroll] ciConScroll;
    #stack[int, 64] w = cssc::peek32(ch);
    #stack[int, 64] h = cssc::peek32(ch + 4);
    #stack[int, 64] cl = cssc::peek32(ch + 8);
    #stack[int, 64] cc = cssc::peek32(ch + 12);
    #stack[int, 64] at = cssc::peek32(ch + 16);
    if (b == 10) {
        cl = cl + 1;
        cc = 0;
    }
    if (b != 10) {
        if (cc >= w) { cl = cl + 1; cc = 0; }
        if (cl >= h) { ciConScroll(ch); cl = h - 1; }
        #stack[int, 64] cells = cssc::peek64(ch + 32);
        #stack[int, 64] off = (cl * w + cc) * 2;
        cssc::poke8(cells + off, b);
        cssc::poke8(cells + off + 1, at);
        cc = cc + 1;
        #delete[cells];
        #delete[off];
    }
    if (cl >= h) { ciConScroll(ch); cl = h - 1; }
    cssc::poke32(ch + 8, cl);
    cssc::poke32(ch + 12, cc);
    #delete[w];
    #delete[h];
    #delete[cl];
    #delete[cc];
    #delete[at];
}

