    if (len > 32) { len = 32; }
    ciTokHasCC(off, len) ccp;
    #stack[int, 64] idx = 0 - 1;
    if (ccp >= 0) {
        ciVarFindGlobal(off, len) gi;
        idx = gi;
        #delete[gi];
        if (idx >= 0) {
            #stack[int, 64] vis = cssc::peek64(ciVVis + idx * 8);
            if (vis == 0) {

                ciSecPrefixIs(off, ccp) same;
                if (same == 0) { idx = 0 - 1; }
                #delete[same];
            }
            #delete[vis];
        }
    }
    if (ccp < 0) {
        ciVarFind(off, len) fi;
        idx = fi;
        #delete[fi];
        if (idx < 0) {
            if (ciCurSecLen > 0) {
                ciQualify(ciCurSecOff, ciCurSecLen, off, len) ql;
                ciVarFindGlobal(ciQualBuf - ciSrc, ql) qi;
                idx = qi;
                #delete[qi];
                #delete[ql];
            }
        }
    }
    #stack[int, 64] r = 0;
    ciEvalType = 0;
    if (idx >= 0) {
        r = cssc::peek64(ciVVals + idx * 8);
        ciEvalType = cssc::peek64(ciVTypes + idx * 8);
    }
    #delete[idx];
    #delete[ccp];
    return r;
}

#define(ciVarSet) {
    #scanp(ciVarSet, int, 0) off;
    #scanp(ciVarSet, int, 1) len;
    #scanp(ciVarSet, int, 2) val;
    #scanp(ciVarSet, int, 3) vtype;
    #scanp(ciVarSet, int, 4) owns;
    #req[ciSrc] ciSrc;
    #req[ciVNames] ciVNames;
    #req[ciVLens] ciVLens;
    #req[ciVVals] ciVVals;
    #req[ciVTypes] ciVTypes;
    #req[ciVOwns] ciVOwns;
    #req[ciVVis] ciVVis;
    #req[ciVCount] ciVCount;
    #req[ciBindVis] ciBindVis;
    #req[ciSetMode] ciSetMode;
    #req[ciCurSecOff] ciCurSecOff;
    #req[ciCurSecLen] ciCurSecLen;
    #req[ciQualBuf] ciQualBuf;
    #req[ciQualify] ciQualify;
    #req[ciTokHasCC] ciTokHasCC;
    #req[ciSecPrefixIs] ciSecPrefixIs;
    #req[ciVarFind] ciVarFind;
    #req[ciVarFindGlobal] ciVarFindGlobal;
    #req[ciInstFree] ciInstFree;
    #req[ciValFree] ciValFree;
    #req[ciNullBorrows] ciNullBorrows;
    #req[ciBindBits] ciBindBits;
    #req[ciVBits] ciVBits;
    #req[ciVReq] ciVReq;
    #req[ciSignal] ciSignal;
    #req[termType] termType;
    #req[termNewline] termNewline;
    if (len > 32) { len = 32; }
    ciTokHasCC(off, len) ccp;
    #stack[int, 64] idx = 0 - 1;
    #stack[int, 32] blocked = 0;
    if (ccp >= 0) {
        ciVarFindGlobal(off, len) gi;
        idx = gi;
        #delete[gi];
        if (idx >= 0) {
            #stack[int, 64] vis = cssc::peek64(ciVVis + idx * 8);
            if (vis == 0) {
                ciSecPrefixIs(off, ccp) same;
                if (same == 0) { blocked = 1; }
                #delete[same];
            }
            #delete[vis];
        }
    }
    if (ccp < 0) {
        ciVarFind(off, len) fi;
        idx = fi;
        #delete[fi];
        if (idx < 0) {
            if (ciSetMode == 1) {
                if (ciCurSecLen > 0) {
                    ciQualify(ciCurSecOff, ciCurSecLen, off, len) ql;
                    ciVarFindGlobal(ciQualBuf - ciSrc, ql) qi;
                    idx = qi;
                    #delete[qi];
                    #delete[ql];
                }
            }
        }
    }

    if (blocked == 0) {
        if (vtype == 0) {
            #stack[int, 64] bw = ciBindBits;
            if (idx >= 0) { bw = cssc::peek64(ciVBits + idx * 8); }
            if (bw > 0) {
                if (bw < 64) {
                    #stack[int, 64] lim = cssc::shl(1, bw - 1);
                    #stack[int, 64] ulim = cssc::shl(1, bw);
                    #stack[int, 32] fits = 1;
                    if (val > ulim - 1) { fits = 0; }
                    if (val < 0 - lim) { fits = 0; }
                    if (fits == 0) {
                        blocked = 1;
                        #stack[string, 48] bmsg = "error: value exceeds its bit limit";
                        termType(bmsg, 14707829);
                        termNewline();
                        #delete[bmsg];

                        ciSignal = 2;
                    }
                    #delete[fits];
                    #delete[lim];
                    #delete[ulim];
                }
            }
            #delete[bw];
        }
    }
    if (blocked == 0) {
        if (idx < 0) {
            if (ciVCount < 4096) {
                #stack[int, 32] j = 0;
                while (j < len) {
                    #stack[int, 64] ch = cssc::peek8(ciSrc + off + j);
                    cssc::poke8(ciVNames + ciVCount * 32 + j, ch);
                    #delete[ch];
                    j = j + 1;
                }
                #delete[j];
                cssc::poke64(ciVLens + ciVCount * 8, len);
                cssc::poke64(ciVVals + ciVCount * 8, val);
                cssc::poke64(ciVTypes + ciVCount * 8, vtype);
                cssc::poke64(ciVOwns + ciVCount * 8, owns);
                cssc::poke64(ciVVis + ciVCount * 8, ciBindVis);
                cssc::poke64(ciVBits + ciVCount * 8, ciBindBits);
                cssc::poke64(ciVReq + ciVCount * 8, 0);
                idx = ciVCount;
                ciVCount = ciVCount + 1;
            }
            if (idx < 0) {

                if (owns == 1) { ciValFree(vtype, val); }
            }
        }
        if (idx >= 0) {
            #stack[int, 32] fresh = 0;
            if (idx == ciVCount - 1) {

                #stack[int, 64] cv = cssc::peek64(ciVVals + idx * 8);
                if (cv == val) { fresh = 1; }
                #delete[cv];
            }
            if (fresh == 0) {

                #stack[int, 64] oldOwns = cssc::peek64(ciVOwns + idx * 8);
                #stack[int, 64] oldType = cssc::peek64(ciVTypes + idx * 8);
                #stack[int, 64] oldVal = cssc::peek64(ciVVals + idx * 8);
                if (oldOwns == 1) {
                    if (oldVal != val) {

                        if (oldType == 1) { ciNullBorrows(oldVal, 1); }
                        if (oldType == 4) { ciNullBorrows(oldVal, 4); }
                        if (oldType == 5) { ciNullBorrows(oldVal, 5); }
                        if (oldType == 7) { ciNullBorrows(oldVal, 7); }
                        ciValFree(oldType, oldVal);
                    }
                }
                cssc::poke64(ciVVals + idx * 8, val);
                cssc::poke64(ciVTypes + idx * 8, vtype);
                cssc::poke64(ciVOwns + idx * 8, owns);

                #stack[int, 64] rl = cssc::peek64(ciVReq + idx * 8);
                if (rl > 0) {
                    #stack[int, 64] grow = rl - 1;
                    #stack[int, 64] goOwns = cssc::peek64(ciVOwns + grow * 8);
                    #stack[int, 64] goType = cssc::peek64(ciVTypes + grow * 8);
                    #stack[int, 64] goVal = cssc::peek64(ciVVals + grow * 8);
                    if (goOwns == 1) {
                        if (goVal != val) {

                            ciValFree(goType, goVal);
                        }
                    }
                    cssc::poke64(ciVVals + grow * 8, val);
                    cssc::poke64(ciVTypes + grow * 8, vtype);
                    cssc::poke64(ciVOwns + grow * 8, owns);
                    cssc::poke64(ciVOwns + idx * 8, 0);
                    #delete[goOwns];
                    #delete[goType];
                    #delete[goVal];
                    #delete[grow];
                }
                #delete[rl];
                #delete[oldOwns];
                #delete[oldType];
                #delete[oldVal];
            }
            #delete[fresh];
        }
    }
    if (blocked == 1) {

        if (owns == 1) {
            if (vtype == 1) { cssc::free(val); }
            if (vtype == 3) { if (val != 0) { ciInstFree(val); } }
        }
    }
    #delete[blocked];
    #delete[idx];
    #delete[ccp];
}

#define(ciCapStore) {
    #scanp(ciCapStore, int, 0) nOff;
