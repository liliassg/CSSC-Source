    }
    if (isMem == 1) {
        #stack[int, 64] tinst = 0;
        if (ciCurInst != 0) {
            ciObjNameIs(ciCurObj, nOff, nLen) isCur;
            if (isCur == 1) { tinst = ciCurInst; }
            #delete[isCur];
        }
        if (tinst == 0) {
            ciVarGet(nOff, nLen) iv;
            if (ciEvalType == 3) { tinst = iv; }
            #delete[iv];
        }
        if (tinst != 0) {
            ciInstMemSet(tinst, mOff, mLen, val, vtype, owns);
        }
        if (tinst == 0) {
            if (owns == 1) { if (vtype == 1) { cssc::free(val); } }
        }
        #delete[tinst];
    }
}

