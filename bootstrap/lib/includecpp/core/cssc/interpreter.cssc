        i = i + 1;
    }
    ciStrNew(buf, n) r;
    cssc::free(buf);
    #delete[i];
    #delete[n];
    #delete[buf];
    return r;
}

#define(ciStrTrimNew) {
    #scanp(ciStrTrimNew, int, 0) sp;
    #req[ciStrNew] ciStrNew;
    #stack[int, 64] n = cssc::peek32(sp + 4);
    #stack[int, 64] a = 0;
    #stack[int, 64] b = n;
    #stack[int, 32] g1 = 1;
    while (g1 == 1) {
        if (a >= b) { g1 = 0; }
        if (g1 == 1) {
            #stack[int, 64] c = cssc::peek8(sp + 8 + a);
            #stack[int, 32] ws = 0;
            if (c == 32) { ws = 1; }
            if (c == 9) { ws = 1; }
            if (c == 10) { ws = 1; }
            if (c == 13) { ws = 1; }
            if (ws == 0) { g1 = 0; }
            if (ws == 1) { a = a + 1; }
            #delete[c];
            #delete[ws];
        }
    }
    #delete[g1];
    #stack[int, 32] g2 = 1;
    while (g2 == 1) {
        if (b <= a) { g2 = 0; }
        if (g2 == 1) {
            #stack[int, 64] c = cssc::peek8(sp + 8 + b - 1);
            #stack[int, 32] ws = 0;
            if (c == 32) { ws = 1; }
            if (c == 9) { ws = 1; }
            if (c == 10) { ws = 1; }
            if (c == 13) { ws = 1; }
            if (ws == 0) { g2 = 0; }
            if (ws == 1) { b = b - 1; }
            #delete[c];
            #delete[ws];
        }
    }
    #delete[g2];
    ciStrNew(sp + 8 + a, b - a) r;
    #delete[n];
    #delete[a];
    #delete[b];
    return r;
}

#define(ciStrRevNew) {
