        if (i < size) {
            #stack[int, 64] d = cssc::peek64(h + 16);
            r = cssc::peek64(d + i * 8);
            #stack[int, 64] j = i;
            while (j < size - 1) {
                cssc::poke64(d + j * 8, cssc::peek64(d + (j + 1) * 8));
                j = j + 1;
            }
            cssc::poke32(h + 4, size - 1);
            #delete[j];
            #delete[d];
        }
    }
    #delete[size];
    return r;
}

