                                nch = nch + 1;
                                #delete[ev];
                                #delete[e];
                            }
                            if (d != 92) {
                                if (nch == 0) { first = d; }
                                sp = sp + 1;
                                nch = nch + 1;
                            }
                        }
                        #delete[d];
                    }
                }
                #delete[qs];
                if (nch == 1) {
                    ciTokNum = first;
                    ciCur = 1;
                }
                if (nch != 1) {
                    ciTokOff = qstart;
                    ciTokLen = sp - qstart;
                    ciCur = 3;
                }
                ciPos = sp;
                if (ciPos < ciSrcLen) { if (cssc::peek8(ciSrc + ciPos) == 39) { ciPos = ciPos + 1; } }
                done = 1;
                #delete[first];
                #delete[nch];
                #delete[sp];
                #delete[qstart];
            }
        }
        if (done == 0) {
            if (c == 61) {
                #stack[int, 64] c2 = 0;
                if (ciPos + 1 < ciSrcLen) { c2 = cssc::peek8(ciSrc + ciPos + 1); }
                if (c2 == 61) { ciCur = 15; ciPos = ciPos + 2; }
                if (c2 != 61) { ciCur = 14; ciPos = ciPos + 1; }
                done = 1;
                #delete[c2];
            }
        }
        if (done == 0) {
            if (c == 33) {

                #stack[int, 64] c2 = 0;
                if (ciPos + 1 < ciSrcLen) { c2 = cssc::peek8(ciSrc + ciPos + 1); }
                if (c2 == 61) { ciCur = 16; ciPos = ciPos + 2; }
                if (c2 != 61) { ciCur = 27; ciPos = ciPos + 1; }
                done = 1;
                #delete[c2];
            }
        }
        if (done == 0) {
            if (c == 60) {
                #stack[int, 64] c2 = 0;
                if (ciPos + 1 < ciSrcLen) { c2 = cssc::peek8(ciSrc + ciPos + 1); }
                if (c2 == 61) { ciCur = 19; ciPos = ciPos + 2; }
                if (c2 != 61) { ciCur = 17; ciPos = ciPos + 1; }
                done = 1;
                #delete[c2];
            }
        }
        if (done == 0) {
            if (c == 62) {
                #stack[int, 64] c2 = 0;
                if (ciPos + 1 < ciSrcLen) { c2 = cssc::peek8(ciSrc + ciPos + 1); }
                if (c2 == 61) { ciCur = 20; ciPos = ciPos + 2; }
                if (c2 != 61) { ciCur = 18; ciPos = ciPos + 1; }
                done = 1;
                #delete[c2];
            }
        }
        if (done == 0) {
            if (c == 38) {

                #stack[int, 64] c2 = 0;
                if (ciPos + 1 < ciSrcLen) { c2 = cssc::peek8(ciSrc + ciPos + 1); }
                if (c2 == 38) { ciCur = 25; ciPos = ciPos + 2; }
                if (c2 != 38) { ciCur = 30; ciPos = ciPos + 1; }
                done = 1;
                #delete[c2];
            }
        }
        if (done == 0) {
            if (c == 124) {

                #stack[int, 64] c2 = 0;
                if (ciPos + 1 < ciSrcLen) { c2 = cssc::peek8(ciSrc + ciPos + 1); }
                if (c2 == 124) { ciCur = 26; ciPos = ciPos + 2; }
                if (c2 != 124) { ciCur = 99; ciPos = ciPos + 1; }
                done = 1;
                #delete[c2];
            }
        }
        if (done == 0) {
            if (c == 45) {

                #stack[int, 64] c2 = 0;
                if (ciPos + 1 < ciSrcLen) { c2 = cssc::peek8(ciSrc + ciPos + 1); }
                if (c2 == 62) { ciCur = 34; ciPos = ciPos + 2; }
                if (c2 != 62) { ciCur = 5; ciPos = ciPos + 1; }
                done = 1;
                #delete[c2];
            }
        }
        if (done == 0) {
            #stack[int, 64] t = 99;
            if (c == 43) { t = 4; }
            if (c == 42) { t = 6; }
            if (c == 47) { t = 7; }
            if (c == 37) { t = 8; }
            if (c == 40) { t = 9; }
            if (c == 41) { t = 10; }
            if (c == 123) { t = 11; }
            if (c == 125) { t = 12; }
            if (c == 59) { t = 13; }
            if (c == 44) { t = 21; }
            if (c == 35) { t = 22; }
            if (c == 91) { t = 23; }
            if (c == 93) { t = 24; }

            if (c == 58) { t = 31; }
            if (c == 63) { t = 32; }

            if (c == 46) { t = 33; }
            ciCur = t;
            ciPos = ciPos + 1;
            done = 1;
            #delete[t];
        }
        #delete[done];
        #delete[c];
    }
}

#define(ciTokenize) {
    #req[ciLexRaw] ciLexRaw;
    #req[ciPos] ciPos;
    #req[ciSrcLen] ciSrcLen;
    #req[ciTokCount] ciTokCount;
    #req[ciTokCap] ciTokCap;
    #req[ciTokCode] ciTokCode;
    #req[ciTokNumA] ciTokNumA;
    #req[ciTokFlag] ciTokFlag;
    #req[ciTokOffA] ciTokOffA;
    #req[ciTokLenA] ciTokLenA;
    #req[ciCur] ciCur;
    #req[ciTokNum] ciTokNum;
    #req[ciTokFloat] ciTokFloat;
    #req[ciTokOff] ciTokOff;
    #req[ciTokLen] ciTokLen;
    #stack[int, 32] go = 1;
    while (go == 1) {
        if (ciPos >= ciSrcLen) { go = 0; }
        if (go == 1) {
            ciLexRaw();
            if (ciCur == 0) { go = 0; }
            if (go == 1) {
                if (ciTokCount < ciTokCap) {
                    cssc::poke8(ciTokCode + ciTokCount, ciCur);
                    cssc::poke64(ciTokNumA + ciTokCount * 8, ciTokNum);
                    cssc::poke8(ciTokFlag + ciTokCount, ciTokFloat);
                    cssc::poke32(ciTokOffA + ciTokCount * 4, ciTokOff);
                    cssc::poke32(ciTokLenA + ciTokCount * 4, ciTokLen);
                    ciTokCount = ciTokCount + 1;
                }
            }
        }
    }
    #delete[go];
}

#define(ciAdvance) {
    #req[ciPos] ciPos;
    #req[ciTokCount] ciTokCount;
    #req[ciTokCode] ciTokCode;
    #req[ciTokNumA] ciTokNumA;
    #req[ciTokFlag] ciTokFlag;
    #req[ciTokOffA] ciTokOffA;
    #req[ciTokLenA] ciTokLenA;
    #req[ciCur] ciCur;
    #req[ciTokNum] ciTokNum;
    #req[ciTokFloat] ciTokFloat;
    #req[ciTokOff] ciTokOff;
    #req[ciTokLen] ciTokLen;
    if (ciPos >= ciTokCount) {
        ciCur = 0;
    }
    if (ciPos < ciTokCount) {
        ciCur = cssc::peek8(ciTokCode + ciPos);
        ciTokNum = cssc::peek64(ciTokNumA + ciPos * 8);
        ciTokFloat = cssc::peek8(ciTokFlag + ciPos);
        ciTokOff = cssc::peek32(ciTokOffA + ciPos * 4);
        ciTokLen = cssc::peek32(ciTokLenA + ciPos * 4);
        ciPos = ciPos + 1;
    }
}

#define(ciIdentIs) {
    #scanp(ciIdentIs, int, 0) off;
    #scanp(ciIdentIs, int, 1) len;
    #scanp(ciIdentIs, string, 2) lit;
    #req[ciSrc] ciSrc;
    #stack[int, 64] sa = 0;
    #adress[lit] sa;
    #stack[int, 64] hdr = cssc::peek64(sa);
    #stack[int, 64] llen = cssc::peek32(hdr + 4);
    #stack[int, 64] ldata = hdr + 8;
    #stack[int, 32] ok = 1;
    if (llen != len) { ok = 0; }
    if (ok == 1) {
        #stack[int, 32] j = 0;
        while (j < len) {
            #stack[int, 64] a = cssc::peek8(ciSrc + off + j);
            #stack[int, 64] b = cssc::peek8(ldata + j);
            if (a != b) { ok = 0; }
            #delete[a];
            #delete[b];
            j = j + 1;
        }
        #delete[j];
    }
    #delete[ldata];
    #delete[llen];
    #delete[hdr];
    #delete[sa];
    return ok;
}

#define(ciQualify) {
    #scanp(ciQualify, int, 0) so;
    #scanp(ciQualify, int, 1) sl;
    #scanp(ciQualify, int, 2) no;
    #scanp(ciQualify, int, 3) nl;
    #req[ciSrc] ciSrc;
    #req[ciQualBuf] ciQualBuf;
    #stack[int, 64] q = 0;
    #stack[int, 32] i = 0;
    while (i < sl) {
        if (q < 32) {
            cssc::poke8(ciQualBuf + q, cssc::peek8(ciSrc + so + i));
            q = q + 1;
        }
        i = i + 1;
    }
    #delete[i];
    if (q < 32) { cssc::poke8(ciQualBuf + q, 58); q = q + 1; }
    if (q < 32) { cssc::poke8(ciQualBuf + q, 58); q = q + 1; }
    #stack[int, 32] j = 0;
    while (j < nl) {
        if (q < 32) {
            cssc::poke8(ciQualBuf + q, cssc::peek8(ciSrc + no + j));
            q = q + 1;
        }
        j = j + 1;
    }
    #delete[j];
    return q;
}

