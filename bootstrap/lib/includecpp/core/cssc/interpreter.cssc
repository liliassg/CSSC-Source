                    #stack[int, 64] bw = cssc::peek32(a1 + 28);
                    #stack[int, 64] bh = cssc::peek32(a1 + 32);
                    if (nx < bx) { nx = bx; }
                    if (nx > bx + bw - a4) { nx = bx + bw - a4; }
                    if (ny < by) { ny = by; }
                    if (ny > by + bh - a5) { ny = by + bh - a5; }
                    #delete[bx]; #delete[by]; #delete[bw]; #delete[bh];
                }
                cssc::poke64(a1 + 0, nx);
                cssc::poke64(a1 + 8, ny);
                #delete[nx]; #delete[ny]; #delete[hasB];
            }
            if (mCb == 1) {
                cssc::poke32(a1 + 16, 1);
                cssc::poke32(a1 + 20, a2);
                cssc::poke32(a1 + 24, a3);
                cssc::poke32(a1 + 28, a4);
                cssc::poke32(a1 + 32, a5);
            }
        }
        if (w1 == 1) { cssc::free(a1); }
        if (w2 == 1) { cssc::free(a2); }
        if (w3 == 1) { cssc::free(a3); }
        if (w4 == 1) { cssc::free(a4); }
        if (w5 == 1) { cssc::free(a5); }
        if (ciCur == 13) { ciAdvance(); }
