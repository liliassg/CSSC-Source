        #delete[c];
    }
    if (target > n) {
        #stack[int, 64] padcount = target - n;

        #stack[int, 64] cn = 0;
        if (chp != 0) { cn = cssc::peek32(chp + 4); }
        #stack[int, 64] padchar = 32;
        if (cn > 0) { padchar = cssc::peek8(chp + 8); }
        #stack[int, 64] buf = cssc::alloc(target + 1);
        #stack[int, 64] w = 0;
        if (atStart == 1) {
            #stack[int, 64] k = 0;
            while (k < padcount) { cssc::poke8(buf + w, padchar); w = w + 1; k = k + 1; }
            #delete[k];
            #stack[int, 64] j = 0;
            while (j < n) { cssc::poke8(buf + w, cssc::peek8(sp + 8 + j)); w = w + 1; j = j + 1; }
            #delete[j];
        }
        if (atStart == 0) {
            #stack[int, 64] j = 0;
            while (j < n) { cssc::poke8(buf + w, cssc::peek8(sp + 8 + j)); w = w + 1; j = j + 1; }
            #delete[j];
            #stack[int, 64] k = 0;
            while (k < padcount) { cssc::poke8(buf + w, padchar); w = w + 1; k = k + 1; }
            #delete[k];
        }
        ciStrNew(buf, target) rr;
        r = rr;
        cssc::free(buf);
        #delete[rr];
        #delete[w];
        #delete[buf];
        #delete[padcount];
        #delete[cn];
        #delete[padchar];
    }
    #delete[n];
    return r;
}

#define(ciStrToIntV) {
    #scanp(ciStrToIntV, int, 0) sp;
    #stack[int, 64] n = cssc::peek32(sp + 4);
    #stack[int, 64] i = 0;
    #stack[int, 64] sign = 1;
    #stack[int, 64] v = 0;
    if (n > 0) {
        #stack[int, 64] c0 = cssc::peek8(sp + 8);
        if (c0 == 45) { sign = 0 - 1; i = 1; }
        if (c0 == 43) { i = 1; }
        #delete[c0];
    }
    #stack[int, 32] go = 1;
    while (go == 1) {
        if (i >= n) { go = 0; }
        if (go == 1) {
            #stack[int, 64] c = cssc::peek8(sp + 8 + i);
            if (c < 48) { go = 0; }
            if (c > 57) { go = 0; }
            if (go == 1) { v = v * 10 + (c - 48); i = i + 1; }
            #delete[c];
        }
    }
    #delete[go];
    #stack[int, 64] r = v * sign;
    #delete[n];
    #delete[i];
    #delete[sign];
    #delete[v];
    return r;
}

