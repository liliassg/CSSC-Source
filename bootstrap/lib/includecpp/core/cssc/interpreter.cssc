            if (m == 0) { i = i + 1; }
            #delete[m];
        }
        ciStrNew(sp + 8 + start, hn - start) tail;
        ciVecPush(vh, tail, 1);
        cssc::free(tail);
        #delete[tail];
        #delete[start];
        #delete[i];
