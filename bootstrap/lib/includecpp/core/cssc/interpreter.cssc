    #req[ciVCount] ciVCount;
    #stack[int, 32] k = 0;
    while (k < ciVCount) {
        #stack[int, 64] bt = cssc::peek64(ciVTypes + k * 8);
        #stack[int, 64] bo = cssc::peek64(ciVOwns + k * 8);
        #stack[int, 64] bv = cssc::peek64(ciVVals + k * 8);
        if (bt == vtype) {
            if (bo == 0) {
                if (bv == ptr) {
                    cssc::poke64(ciVVals + k * 8, 0);
                    cssc::poke64(ciVTypes + k * 8, 0);
                }
            }
        }
        #delete[bt];
        #delete[bo];
        #delete[bv];
        k = k + 1;
    }
    #delete[k];
}

#define(ciInstMemFind) {
    #scanp(ciInstMemFind, int, 0) inst;
    #scanp(ciInstMemFind, int, 1) off;
    #scanp(ciInstMemFind, int, 2) len;
    #req[ciSrc] ciSrc;
    if (len > 32) { len = 32; }
    #stack[int, 64] found = 0 - 1;
    #stack[int, 64] n = cssc::peek64(inst + 16);
    #stack[int, 32] i = 0;
    while (i < n) {
        #stack[int, 64] row = inst + 24 + i * 64;
        #stack[int, 64] nl = cssc::peek64(row + 32);
        if (nl == len) {
            #stack[int, 32] m = 1;
            #stack[int, 32] j = 0;
            while (j < len) {
                #stack[int, 64] a = cssc::peek8(ciSrc + off + j);
                #stack[int, 64] b = cssc::peek8(row + j);
                if (a != b) { m = 0; }
                #delete[a];
                #delete[b];
                j = j + 1;
            }
            #delete[j];
            if (m == 1) { found = i; }
            #delete[m];
        }
        #delete[nl];
        #delete[row];
        i = i + 1;
    }
    #delete[i];
    #delete[n];
    return found;
}

#define(ciInstFree) {
    #scanp(ciInstFree, int, 0) inst;
    #req[ciInstFree] ciInstFree;
    #req[ciNullBorrows] ciNullBorrows;
    #stack[int, 64] n = cssc::peek64(inst + 16);
    #stack[int, 32] i = 0;
    while (i < n) {
        #stack[int, 64] row = inst + 24 + i * 64;
        #stack[int, 64] mo = cssc::peek64(row + 56);
        #stack[int, 64] mt = cssc::peek64(row + 48);
        #stack[int, 64] mv = cssc::peek64(row + 40);
        if (mo == 1) {
            if (mt == 1) {
                ciNullBorrows(mv, 1);
                cssc::free(mv);
            }
            if (mt == 3) { if (mv != 0) { ciInstFree(mv); } }
        }
        #delete[mo];
        #delete[mt];
        #delete[mv];
        #delete[row];
        i = i + 1;
    }
    #delete[i];
    #delete[n];
    ciNullBorrows(inst, 3);
    cssc::free(inst);
}

#define(ciValClone) {
    #scanp(ciValClone, int, 0) ty;
    #scanp(ciValClone, int, 1) vv;
    #stack[int, 64] r = vv;
    if (vv != 0) {
        if (ty == 1) {

            #stack[int, 64] sl = cssc::peek32(vv + 4);
            #stack[int, 64] nb = cssc::alloc(sl + 8);
            cssc::poke32(nb, 1);
            cssc::poke32(nb + 4, sl);
            #stack[int, 64] i = 0;
            while (i < sl) {
                cssc::poke8(nb + 8 + i, cssc::peek8(vv + 8 + i));
                i = i + 1;
            }
            #delete[i];
            r = nb;
            #delete[nb];
            #delete[sl];
        }
        if (ty == 4) {

            #stack[int, 64] sz = cssc::peek32(vv + 4);
            #stack[int, 64] et = cssc::peek32(vv + 12);
            #stack[int, 64] cap = sz;
            if (cap < 8) { cap = 8; }
            #stack[int, 64] nh = cssc::alloc(24);
            #stack[int, 64] nd = cssc::alloc(cap * 8);
            cssc::poke32(nh, 1);
            cssc::poke32(nh + 4, sz);
            cssc::poke32(nh + 8, cap);
            cssc::poke32(nh + 12, et);
            cssc::poke64(nh + 16, nd);
            #stack[int, 64] od = cssc::peek64(vv + 16);
            #stack[int, 64] i = 0;
            while (i < sz) {
                #stack[int, 64] ev = cssc::peek64(od + i * 8);
                #stack[int, 64] cev = ev;
                if (et == 1) { ciValClone(1, ev) c; cev = c; #delete[c]; }
                cssc::poke64(nd + i * 8, cev);
                #delete[cev];
                #delete[ev];
                i = i + 1;
            }
            #delete[i];
            #delete[od];
            r = nh;
            #delete[nh];
            #delete[nd];
            #delete[cap];
            #delete[et];
            #delete[sz];
        }
        if (ty == 5) {

            #stack[int, 64] sz = cssc::peek32(vv + 4);
            #stack[int, 64] cap = sz;
            if (cap < 8) { cap = 8; }
            #stack[int, 64] nh = cssc::alloc(24);
            #stack[int, 64] nd = cssc::alloc(cap * 32);
            cssc::poke32(nh, 1);
            cssc::poke32(nh + 4, sz);
            cssc::poke32(nh + 8, cap);
            cssc::poke64(nh + 16, nd);
            #stack[int, 64] od = cssc::peek64(vv + 16);
            #stack[int, 64] i = 0;
            while (i < sz) {
                #stack[int, 64] kt = cssc::peek64(od + i * 32);
                #stack[int, 64] kv = cssc::peek64(od + i * 32 + 8);
                #stack[int, 64] vt = cssc::peek64(od + i * 32 + 16);
                #stack[int, 64] vl = cssc::peek64(od + i * 32 + 24);
                #stack[int, 64] nkv = kv;
                #stack[int, 64] nvl = vl;
                if (kt == 1) { ciValClone(1, kv) c; nkv = c; #delete[c]; }
                if (vt == 1) { ciValClone(1, vl) c; nvl = c; #delete[c]; }
                cssc::poke64(nd + i * 32, kt);
                cssc::poke64(nd + i * 32 + 8, nkv);
                cssc::poke64(nd + i * 32 + 16, vt);
                cssc::poke64(nd + i * 32 + 24, nvl);
                #delete[nkv];
                #delete[nvl];
                #delete[kt];
                #delete[kv];
                #delete[vt];
                #delete[vl];
                i = i + 1;
            }
            #delete[i];
            #delete[od];
            r = nh;
            #delete[nh];
            #delete[nd];
            #delete[cap];
            #delete[sz];
        }
        if (ty == 7) {

            #stack[int, 64] sz = cssc::peek32(vv + 4);
            #stack[int, 64] pw = cssc::peek32(vv + 12);
            #stack[int, 64] cap = cssc::peek32(vv + 8);
            #stack[int, 64] used = sz * pw;
            #stack[int, 64] acells = cap * pw;
            if (acells < 1) { acells = 1; }
            #stack[int, 64] nh = cssc::alloc(24);
            #stack[int, 64] nd = cssc::alloc(acells * 16);
            cssc::poke32(nh, 1);
            cssc::poke32(nh + 4, sz);
            cssc::poke32(nh + 8, cap);
            cssc::poke32(nh + 12, pw);
            cssc::poke64(nh + 16, nd);
            #stack[int, 64] od = cssc::peek64(vv + 16);
            #stack[int, 64] i = 0;
            while (i < used) {
                #stack[int, 64] ct = cssc::peek64(od + i * 16);
                #stack[int, 64] cvl = cssc::peek64(od + i * 16 + 8);
                #stack[int, 64] ncvl = cvl;
                if (ct == 1) { ciValClone(1, cvl) c; ncvl = c; #delete[c]; }
                cssc::poke64(nd + i * 16, ct);
                cssc::poke64(nd + i * 16 + 8, ncvl);
                #delete[ncvl];
                #delete[ct];
                #delete[cvl];
                i = i + 1;
            }
            #delete[i];
            #delete[od];
            r = nh;
            #delete[nh];
            #delete[nd];
            #delete[used];
            #delete[acells];
            #delete[cap];
            #delete[pw];
            #delete[sz];
        }
    }
    return r;
}

