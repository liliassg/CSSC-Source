    }
    #delete[used];
    #delete[pw];
    #delete[size];
}
#define(ciBindAddmap) {
    #scanp(ciBindAddmap, int, 0) h;
    #scanp(ciBindAddmap, int, 1) mh;
    #req[ciBindRawSet] ciBindRawSet;
    #stack[int, 64] pw = cssc::peek32(h + 12);
    if (pw == 0) { pw = 2; cssc::poke32(h + 12, 2); }
    if (pw == 2) {
        #stack[int, 64] msize = cssc::peek32(mh + 4);
        #stack[int, 64] md = cssc::peek64(mh + 16);
        #stack[int, 64] i = 0;
        while (i < msize) {
            #stack[int, 64] base = cssc::peek32(h + 4) * 2;
            #stack[int, 64] kt = cssc::peek64(md + i * 32);
            #stack[int, 64] kv = cssc::peek64(md + i * 32 + 8);
            #stack[int, 64] vt = cssc::peek64(md + i * 32 + 16);
            #stack[int, 64] vv = cssc::peek64(md + i * 32 + 24);
            ciBindRawSet(h, base, kt, kv);
            ciBindRawSet(h, base + 1, vt, vv);
            cssc::poke32(h + 4, cssc::peek32(h + 4) + 1);
            #delete[base];
            #delete[kt];
            #delete[kv];
            #delete[vt];
            #delete[vv];
            i = i + 1;
        }
        #delete[i];
        #delete[md];
        #delete[msize];
    }
    #delete[pw];
}
#define(ciBindClear) {
    #scanp(ciBindClear, int, 0) h;
    #stack[int, 64] size = cssc::peek32(h + 4);
    #stack[int, 64] pw = cssc::peek32(h + 12);
    #stack[int, 64] used = size * pw;
    #stack[int, 64] d = cssc::peek64(h + 16);
    #stack[int, 64] i = 0;
    while (i < used) {
        if (cssc::peek64(d + i * 16) == 1) { cssc::free(cssc::peek64(d + i * 16 + 8)); }
        i = i + 1;
    }
    cssc::poke32(h + 4, 0);
    #delete[i];
    #delete[d];
    #delete[used];
    #delete[pw];
    #delete[size];
}
#define(ciBindFree) {
    #scanp(ciBindFree, int, 0) h;
    #req[ciBindClear] ciBindClear;
    ciBindClear(h);
    #stack[int, 64] d = cssc::peek64(h + 16);
    cssc::free(d);
    cssc::free(h);
    #delete[d];
}

#define(ciModOf) {
    #scanp(ciModOf, int, 0) off;
    #scanp(ciModOf, int, 1) len;
    #req[ciTokHasCC] ciTokHasCC;
    #req[ciSpanEq] ciSpanEq;
    #req[ciAlOff] ciAlOff;
    #req[ciAlLen] ciAlLen;
    #req[ciAlMod] ciAlMod;
    #req[ciAlCount] ciAlCount;
    #stack[int, 64] mod = 0;
    ciTokHasCC(off, len) ccp;
    if (ccp > 0) {
        #stack[int, 64] k = 0;
        while (k < ciAlCount) {
            if (mod == 0) {
                #stack[int, 64] ao = cssc::peek64(ciAlOff + k * 8);
                #stack[int, 64] al = cssc::peek64(ciAlLen + k * 8);
                ciSpanEq(off, ccp, ao, al) eq;
                if (eq == 1) { mod = cssc::peek64(ciAlMod + k * 8); }
                #delete[eq];
                #delete[ao];
                #delete[al];
            }
            k = k + 1;
        }
        #delete[k];
    }
    #delete[ccp];
    return mod;
}

#define(ciBgraOf) {
    #scanp(ciBgraOf, int, 0) argb;
    #stack[int, 64] a = cssc::band(cssc::shr(argb, 24), 255);
    #stack[int, 64] r = cssc::band(cssc::shr(argb, 16), 255);
    #stack[int, 64] g = cssc::band(cssc::shr(argb, 8), 255);
    #stack[int, 64] b = cssc::band(argb, 255);
    #stack[int, 64] out = cssc::bor(cssc::bor(cssc::shl(a, 24), cssc::shl(b, 16)), cssc::bor(cssc::shl(g, 8), r));
    #delete[a];
    #delete[r];
    #delete[g];
    #delete[b];
    return out;
}

#define(ciVidStore) {
    #scanp(ciVidStore, int, 0) hd;
    #scanp(ciVidStore, int, 1) x;
    #scanp(ciVidStore, int, 2) y;
    #scanp(ciVidStore, int, 3) argb;
    #req[ciBgraOf] ciBgraOf;
    #stack[int, 64] w = cssc::peek32(hd);
    #stack[int, 64] hh = cssc::peek32(hd + 4);
    #stack[int, 32] ok = 0;
    if (x >= 0) { if (y >= 0) { if (x < w) { if (y < hh) { ok = 1; } } } }
    if (ok == 1) {
        #stack[int, 64] buf = cssc::peek64(hd + 16);
        ciBgraOf(argb) sw;
        cssc::poke32(buf + (y * w + x) * 4, sw);
        #delete[sw];
        #delete[buf];
    }
    #delete[ok];
    #delete[w];
    #delete[hh];
}

#define(ciVidLoad) {
    #scanp(ciVidLoad, int, 0) hd;
    #scanp(ciVidLoad, int, 1) x;
    #scanp(ciVidLoad, int, 2) y;
    #stack[int, 64] w = cssc::peek32(hd);
    #stack[int, 64] hh = cssc::peek32(hd + 4);
    #stack[int, 64] out = 0;
    #stack[int, 32] ok = 0;
    if (x >= 0) { if (y >= 0) { if (x < w) { if (y < hh) { ok = 1; } } } }
    if (ok == 1) {
        #stack[int, 64] buf = cssc::peek64(hd + 16);
        out = cssc::peek32(buf + (y * w + x) * 4);
        #delete[buf];
    }
    #delete[ok];
    #delete[w];
    #delete[hh];
    return out;
}

#define(ciBlend) {
    #scanp(ciBlend, int, 0) src;
    #scanp(ciBlend, int, 1) dst;
    #stack[int, 64] sa = cssc::band(cssc::shr(src, 24), 255);
    #stack[int, 64] out = src;
    if (sa < 255) {
        #stack[int, 64] dr = cssc::band(dst, 255);
        #stack[int, 64] dg = cssc::band(cssc::shr(dst, 8), 255);
        #stack[int, 64] db = cssc::band(cssc::shr(dst, 16), 255);
        #stack[int, 64] aFF = cssc::shl(255, 24);
        if (sa == 0) {
            out = cssc::bor(aFF, cssc::bor(cssc::shl(dr, 16), cssc::bor(cssc::shl(dg, 8), db)));
        }
        if (sa != 0) {
            #stack[int, 64] sr = cssc::band(cssc::shr(src, 16), 255);
            #stack[int, 64] sg = cssc::band(cssc::shr(src, 8), 255);
            #stack[int, 64] sb = cssc::band(src, 255);
            #stack[int, 64] inv = 255 - sa;
            #stack[int, 64] rr = (sr * sa + dr * inv) / 255;
            #stack[int, 64] gg = (sg * sa + dg * inv) / 255;
            #stack[int, 64] bb = (sb * sa + db * inv) / 255;
            out = cssc::bor(aFF, cssc::bor(cssc::shl(rr, 16), cssc::bor(cssc::shl(gg, 8), bb)));
            #delete[sr];
            #delete[sg];
            #delete[sb];
            #delete[inv];
            #delete[rr];
            #delete[gg];
            #delete[bb];
        }
        #delete[dr];
        #delete[dg];
        #delete[db];
        #delete[aFF];
    }
    #delete[sa];
    return out;
}

#define(ciVidClear) {
    #scanp(ciVidClear, int, 0) hd;
    #scanp(ciVidClear, int, 1) argb;
    #req[ciBgraOf] ciBgraOf;
    #stack[int, 64] w = cssc::peek32(hd);
    #stack[int, 64] hh = cssc::peek32(hd + 4);
    #stack[int, 64] buf = cssc::peek64(hd + 16);
    ciBgraOf(argb) sw;
    cssc::memfill32(buf, sw, w * hh);
    #delete[sw];
    #delete[buf];
    #delete[w];
    #delete[hh];
}

#define(ciVidFill) {
    #scanp(ciVidFill, int, 0) hd;
    #scanp(ciVidFill, int, 1) x;
    #scanp(ciVidFill, int, 2) y;
    #scanp(ciVidFill, int, 3) rw;
    #scanp(ciVidFill, int, 4) rh;
    #scanp(ciVidFill, int, 5) argb;
    #req[ciVidStore] ciVidStore;
    #req[ciVidLoad] ciVidLoad;
    #req[ciBlend] ciBlend;
    #stack[int, 64] vw = cssc::peek32(hd);
    #stack[int, 64] vh = cssc::peek32(hd + 4);
    #stack[int, 64] alpha = cssc::band(cssc::shr(argb, 24), 255);
    #stack[int, 32] run = 1;
    if (rw <= 0) { run = 0; }
    if (rh <= 0) { run = 0; }
    if (alpha == 0) { run = 0; }
    if (run == 1) {
        #stack[int, 64] x0 = x;
        if (x0 < 0) { x0 = 0; }
        #stack[int, 64] y0 = y;
        if (y0 < 0) { y0 = 0; }
        #stack[int, 64] x1 = x + rw;
        if (x1 > vw) { x1 = vw; }
        #stack[int, 64] y1 = y + rh;
        if (y1 > vh) { y1 = vh; }
        #stack[int, 64] py = y0;
        while (py < y1) {
            #stack[int, 64] px = x0;
            while (px < x1) {
                if (alpha >= 255) { ciVidStore(hd, px, py, argb); }
                if (alpha < 255) {
                    ciVidLoad(hd, px, py) dv;
                    ciBlend(argb, dv) bl;
                    ciVidStore(hd, px, py, bl);
                    #delete[dv];
                    #delete[bl];
                }
                px = px + 1;
            }
            #delete[px];
            py = py + 1;
        }
        #delete[py];
        #delete[x0];
        #delete[y0];
        #delete[x1];
        #delete[y1];
    }
    #delete[run];
    #delete[vw];
    #delete[vh];
    #delete[alpha];
}

#define(ciVidRect) {
    #scanp(ciVidRect, int, 0) hd;
    #scanp(ciVidRect, int, 1) x;
    #scanp(ciVidRect, int, 2) y;
    #scanp(ciVidRect, int, 3) rw;
    #scanp(ciVidRect, int, 4) rh;
    #scanp(ciVidRect, int, 5) argb;
    #req[ciVidStore] ciVidStore;
    #stack[int, 64] vw = cssc::peek32(hd);
    #stack[int, 64] vh = cssc::peek32(hd + 4);
    #stack[int, 32] run = 1;
    if (rw <= 0) { run = 0; }
    if (rh <= 0) { run = 0; }
    if (run == 1) {
        #stack[int, 64] x0 = x;
        if (x0 < 0) { x0 = 0; }
        #stack[int, 64] y0 = y;
        if (y0 < 0) { y0 = 0; }
        #stack[int, 64] x1 = x + rw - 1;
        if (x1 > vw - 1) { x1 = vw - 1; }
        #stack[int, 64] y1 = y + rh - 1;
        if (y1 > vh - 1) { y1 = vh - 1; }
        #stack[int, 32] ok = 1;
        if (x1 < x0) { ok = 0; }
        if (y1 < y0) { ok = 0; }
        if (ok == 1) {
            #stack[int, 64] yb = y + rh - 1;
            #stack[int, 64] xr = x + rw - 1;
            #stack[int, 64] px = x0;
            while (px <= x1) {
                if (y >= 0) { if (y < vh) { ciVidStore(hd, px, y, argb); } }
                if (yb >= 0) { if (yb < vh) { ciVidStore(hd, px, yb, argb); } }
                px = px + 1;
            }
            #delete[px];
            #stack[int, 64] py = y0;
            while (py <= y1) {
                if (x >= 0) { if (x < vw) { ciVidStore(hd, x, py, argb); } }
                if (xr >= 0) { if (xr < vw) { ciVidStore(hd, xr, py, argb); } }
                py = py + 1;
            }
            #delete[py];
            #delete[yb];
            #delete[xr];
        }
        #delete[ok];
        #delete[x0];
        #delete[y0];
        #delete[x1];
        #delete[y1];
    }
    #delete[run];
    #delete[vw];
    #delete[vh];
}

#define(ciVidDark) {
    #scanp(ciVidDark, int, 0) hd;
    #scanp(ciVidDark, int, 1) amount;
    #stack[int, 64] am = amount;
    #stack[int, 32] run = 1;
    if (am <= 0) { run = 0; }
    if (am > 255) { am = 255; }
    if (run == 1) {
        #stack[int, 64] keep = 255 - am;
        #stack[int, 64] w = cssc::peek32(hd);
        #stack[int, 64] hh = cssc::peek32(hd + 4);
        #stack[int, 64] buf = cssc::peek64(hd + 16);
        #stack[int, 64] tot = w * hh;
        #stack[int, 64] i = 0;
        while (i < tot) {
            #stack[int, 64] p = cssc::peek32(buf + i * 4);
            #stack[int, 64] a = cssc::band(cssc::shr(p, 24), 255);
            #stack[int, 64] c16 = (cssc::band(cssc::shr(p, 16), 255) * keep) / 255;
            #stack[int, 64] c8 = (cssc::band(cssc::shr(p, 8), 255) * keep) / 255;
            #stack[int, 64] c0 = (cssc::band(p, 255) * keep) / 255;
            #stack[int, 64] np = cssc::bor(cssc::shl(a, 24), cssc::bor(cssc::shl(c16, 16), cssc::bor(cssc::shl(c8, 8), c0)));
            cssc::poke32(buf + i * 4, np);
            #delete[p];
            #delete[a];
            #delete[c16];
            #delete[c8];
            #delete[c0];
            #delete[np];
            i = i + 1;
        }
        #delete[i];
        #delete[tot];
        #delete[buf];
        #delete[w];
        #delete[hh];
        #delete[keep];
    }
    #delete[run];
    #delete[am];
}

#define(ciVidGlyph) {
    #scanp(ciVidGlyph, int, 0) hd;
    #scanp(ciVidGlyph, int, 1) x;
    #scanp(ciVidGlyph, int, 2) y;
    #scanp(ciVidGlyph, int, 3) ch;
    #scanp(ciVidGlyph, int, 4) argb;
    #scanp(ciVidGlyph, int, 5) scale;
    #req[ciVidStore] ciVidStore;
    #req[ciFont] ciFont;
    #stack[int, 64] sc = scale;
    if (sc < 1) { sc = 1; }
    #stack[int, 32] hollow = 0;
    if (ch < 32) { hollow = 1; }
    if (ch > 127) { hollow = 1; }
    #stack[int, 64] gy = 0;
    while (gy < 8) {
        #stack[int, 64] row = 0;
        if (hollow == 0) {
            #stack[int, 64] word = cssc::peek64(ciFont + (ch - 32) * 8);
            row = cssc::band(cssc::shr(word, gy * 8), 255);
            #delete[word];
        }
        #stack[int, 64] gx = 0;
        while (gx < 8) {
            #stack[int, 32] on = 0;
            if (hollow == 1) {
                if (gy == 0) { on = 1; }
                if (gy == 7) { on = 1; }
                if (gx == 0) { on = 1; }
                if (gx == 7) { on = 1; }
            }
            if (hollow == 0) {
                if (cssc::band(cssc::shr(row, gx), 1) == 1) { on = 1; }
            }
            if (on == 1) {
                #stack[int, 64] sy = 0;
                while (sy < sc) {
                    #stack[int, 64] sx = 0;
                    while (sx < sc) {
                        ciVidStore(hd, x + gx * sc + sx, y + gy * sc + sy, argb);
                        sx = sx + 1;
                    }
                    #delete[sx];
                    sy = sy + 1;
                }
                #delete[sy];
            }
            #delete[on];
            gx = gx + 1;
        }
        #delete[gx];
        #delete[row];
        gy = gy + 1;
    }
    #delete[gy];
    #delete[hollow];
    #delete[sc];
}

#define(ciVidText) {
    #scanp(ciVidText, int, 0) hd;
    #scanp(ciVidText, int, 1) x;
    #scanp(ciVidText, int, 2) y;
    #scanp(ciVidText, int, 3) sp;
    #scanp(ciVidText, int, 4) argb;
    #scanp(ciVidText, int, 5) scale;
    #req[ciVidGlyph] ciVidGlyph;
    #stack[int, 64] sc = scale;
    if (sc < 1) { sc = 1; }
    #stack[int, 64] slen = cssc::peek32(sp + 4);
    #stack[int, 64] cx = x;
    #stack[int, 64] cy = y;
    #stack[int, 64] i = 0;
    while (i < slen) {
        #stack[int, 64] ch = cssc::peek8(sp + 8 + i);
        #stack[int, 32] nl = 0;
        if (ch == 10) { nl = 1; }
        if (nl == 1) { cx = x; cy = cy + 10 * sc; }
        if (nl == 0) {
            ciVidGlyph(hd, cx, cy, ch, argb, sc);
            cx = cx + 8 * sc;
        }
        #delete[nl];
        #delete[ch];
        i = i + 1;
    }
    #delete[i];
    #delete[cx];
    #delete[cy];
    #delete[slen];
    #delete[sc];
}

#define(ciVidPresent) {
    #scanp(ciVidPresent, int, 0) hd;
    #stack[int, 64] w = cssc::peek32(hd);
    #stack[int, 64] hh = cssc::peek32(hd + 4);
    #stack[int, 64] buf = cssc::peek64(hd + 16);
    #stack[int, 64] fbA = cssc::fbAddr();
    #stack[int, 64] fbP = cssc::fbPitch();
    #stack[int, 64] SW = cssc::fbWidth();
    #stack[int, 64] SH = cssc::fbHeight();
    #stack[int, 64] s = SW / w;
    #stack[int, 64] s2 = SH / hh;
    if (s2 < s) { s = s2; }
    if (s < 1) { s = 1; }
    #stack[int, 64] ox = (SW - w * s) / 2;
    #stack[int, 64] oy = (SH - hh * s) / 2;

    #req[ciVidScale] ciVidScale;
    #req[ciVidOffX] ciVidOffX;
    #req[ciVidOffY] ciVidOffY;
    ciVidScale = s;
    ciVidOffX = ox;
    ciVidOffY = oy;
    #stack[int, 64] sy = 0;
    while (sy < hh) {
        #stack[int, 64] sx = 0;
        while (sx < w) {
            #stack[int, 64] stored = cssc::peek32(buf + (sy * w + sx) * 4);
            #stack[int, 64] fbWord = cssc::band(stored, 16777215);
            #stack[int, 64] dy = 0;
            while (dy < s) {
                #stack[int, 64] dx = 0;
                while (dx < s) {
                    #stack[int, 64] X = ox + sx * s + dx;
                    #stack[int, 64] Y = oy + sy * s + dy;
                    cssc::poke32(fbA + Y * fbP + X * 4, fbWord);
                    #delete[X];
                    #delete[Y];
                    dx = dx + 1;
                }
                #delete[dx];
                dy = dy + 1;
            }
            #delete[dy];
            #delete[stored];
            #delete[fbWord];
            sx = sx + 1;
        }
        #delete[sx];
        sy = sy + 1;
    }
    #delete[sy];
    #delete[s];
    #delete[s2];
    #delete[ox];
    #delete[oy];
    #delete[w];
    #delete[hh];
    #delete[buf];
    #delete[fbA];
    #delete[fbP];
    #delete[SW];
    #delete[SH];
}

#define(ciSext32) {
    #scanp(ciSext32, int, 0) v;
    #stack[int, 64] out = v;
    #stack[int, 64] hb = cssc::shl(1, 31);
    if (v >= hb) { out = v - cssc::shl(1, 32); }
    #delete[hb];
    return out;
}

#define(ciBmpLoad) {
    #scanp(ciBmpLoad, int, 0) pathPtr;
    #req[fsFind] fsFind;
    #req[fsIdx] fsIdx;
    #req[fsReadPtr] fsReadPtr;
    #req[fsReadLen] fsReadLen;
    #req[ciBmpW] ciBmpW;
    #req[ciBmpH] ciBmpH;
    #stack[int, 64] out = 0;
    #stack[int, 64] buf = 0;
    #stack[int, 64] blen = 0;
    #stack[int, 32] okmagic = 0;
    fsFind(pathPtr + 8, cssc::peek32(pathPtr + 4));
    if (fsIdx >= 0) {
        fsReadPtr(fsIdx) bp; buf = bp; #delete[bp];
        fsReadLen(fsIdx) bl; blen = bl; #delete[bl];
        if (blen >= 54) {
            if (cssc::peek8(buf) == 66) { if (cssc::peek8(buf + 1) == 77) { okmagic = 1; } }
        }
    }
    if (okmagic == 1) {
        #stack[int, 64] pixOff = cssc::peek32(buf + 10);
        #stack[int, 64] width = cssc::peek32(buf + 18);
        #stack[int, 64] hRaw = cssc::peek32(buf + 22);
        #stack[int, 64] bpp = cssc::bor(cssc::peek8(buf + 28), cssc::shl(cssc::peek8(buf + 29), 8));
        #stack[int, 32] flipped = 1;
        #stack[int, 64] height = hRaw;
        #stack[int, 64] hb = cssc::shl(1, 31);
        if (hRaw >= hb) { flipped = 0; height = cssc::shl(1, 32) - hRaw; }
        #delete[hb];
        if (width < 1) { width = 1; }
        if (height < 1) { height = 1; }
        #stack[int, 64] rowBytes = ((width * bpp + 31) / 32) * 4;
        ciBmpW = width;
        ciBmpH = height;
        out = cssc::alloc(width * height * 4);
        cssc::memfill32(out, 0, width * height);
        #stack[int, 64] row = 0;
        while (row < height) {
            #stack[int, 64] srcRow = row;
            if (flipped == 1) { srcRow = height - 1 - row; }
            #stack[int, 64] srcOff = pixOff + srcRow * rowBytes;
            #stack[int, 64] col = 0;
            while (col < width) {
                #stack[int, 64] argb = 0;
                if (bpp == 32) {
                    #stack[int, 64] b = cssc::peek8(srcOff + col * 4);
                    #stack[int, 64] g = cssc::peek8(srcOff + col * 4 + 1);
                    #stack[int, 64] r = cssc::peek8(srcOff + col * 4 + 2);
                    #stack[int, 64] a = cssc::peek8(srcOff + col * 4 + 3);
                    if (a == 0) { a = 255; }
                    argb = cssc::bor(cssc::shl(a, 24), cssc::bor(cssc::shl(r, 16), cssc::bor(cssc::shl(g, 8), b)));
                    #delete[b]; #delete[g]; #delete[r]; #delete[a];
                }
                if (bpp == 24) {
                    #stack[int, 64] b = cssc::peek8(srcOff + col * 3);
                    #stack[int, 64] g = cssc::peek8(srcOff + col * 3 + 1);
                    #stack[int, 64] r = cssc::peek8(srcOff + col * 3 + 2);
                    argb = cssc::bor(cssc::shl(255, 24), cssc::bor(cssc::shl(r, 16), cssc::bor(cssc::shl(g, 8), b)));
                    #delete[b]; #delete[g]; #delete[r];
                }
                cssc::poke32(out + (row * width + col) * 4, argb);
                #delete[argb];
                col = col + 1;
            }
            #delete[col];
            #delete[srcOff];
            #delete[srcRow];
            row = row + 1;
        }
        #delete[row];
        #delete[pixOff]; #delete[width]; #delete[hRaw]; #delete[bpp];
        #delete[flipped]; #delete[height]; #delete[rowBytes];
    }
    if (okmagic == 0) {
        ciBmpW = 1;
        ciBmpH = 1;
        out = cssc::alloc(4);
        cssc::memfill32(out, 0, 1);
    }
    #delete[okmagic];
    #delete[buf];
    #delete[blen];
    return out;
}

#define(ciSprNew) {
    #scanp(ciSprNew, int, 0) w;
    #scanp(ciSprNew, int, 1) h;
    #scanp(ciSprNew, int, 2) keyFlag;
    #scanp(ciSprNew, int, 3) key;
    #stack[int, 64] ww = w;
    #stack[int, 64] hh = h;
    if (ww < 1) { ww = 1; }
    if (hh < 1) { hh = 1; }
    #stack[int, 64] hd = cssc::alloc(24);
    #stack[int, 64] data = cssc::alloc(ww * hh * 4);
    cssc::memfill32(data, 0, ww * hh);
    cssc::poke32(hd, ww);
    cssc::poke32(hd + 4, hh);
    cssc::poke32(hd + 8, keyFlag);
    cssc::poke32(hd + 12, key);
    cssc::poke64(hd + 16, data);
    #delete[data];
    #delete[ww];
    #delete[hh];
    return hd;
}

#define(ciSheetNew) {
    #scanp(ciSheetNew, int, 0) w;
    #scanp(ciSheetNew, int, 1) h;
    #scanp(ciSheetNew, int, 2) tileW;
    #scanp(ciSheetNew, int, 3) tileH;
    #scanp(ciSheetNew, int, 4) keyFlag;
    #scanp(ciSheetNew, int, 5) key;
    #stack[int, 64] ww = w; if (ww < 1) { ww = 1; }
    #stack[int, 64] hh = h; if (hh < 1) { hh = 1; }
    #stack[int, 64] tw = tileW; if (tw < 1) { tw = 1; }
    #stack[int, 64] th = tileH; if (th < 1) { th = 1; }
    #stack[int, 64] cols = ww / tw; if (cols < 1) { cols = 1; }
    #stack[int, 64] rows = hh / th; if (rows < 1) { rows = 1; }
    #stack[int, 64] hd = cssc::alloc(40);
    #stack[int, 64] data = cssc::alloc(ww * hh * 4);
    cssc::memfill32(data, 0, ww * hh);
    cssc::poke32(hd, ww);
    cssc::poke32(hd + 4, hh);
    cssc::poke32(hd + 8, tw);
    cssc::poke32(hd + 12, th);
    cssc::poke32(hd + 16, cols);
    cssc::poke32(hd + 20, rows);
    cssc::poke32(hd + 24, keyFlag);
    cssc::poke32(hd + 28, key);
    cssc::poke64(hd + 32, data);
    #delete[data];
    #delete[ww]; #delete[hh]; #delete[tw]; #delete[th];
    #delete[cols]; #delete[rows];
    return hd;
}

#define(ciSprBlit) {
    #scanp(ciSprBlit, int, 0) spr;
    #scanp(ciSprBlit, int, 1) target;
    #scanp(ciSprBlit, int, 2) x;
    #scanp(ciSprBlit, int, 3) y;
    #req[ciVidStore] ciVidStore;
    #stack[int, 64] w = cssc::peek32(spr);
    #stack[int, 64] h = cssc::peek32(spr + 4);
    #stack[int, 64] keyFlag = cssc::peek32(spr + 8);
    #stack[int, 64] key = cssc::peek32(spr + 12);
    #stack[int, 64] data = cssc::peek64(spr + 16);
    #stack[int, 64] py = 0;
    while (py < h) {
        #stack[int, 64] px = 0;
        while (px < w) {
            #stack[int, 64] pix = cssc::peek32(data + (py * w + px) * 4);
            #stack[int, 32] skip = 0;
            if (keyFlag == 1) { if (pix == key) { skip = 1; } }
            if (skip == 0) { ciVidStore(target, x + px, y + py, pix); }
            #delete[skip];
            #delete[pix];
            px = px + 1;
        }
        #delete[px];
        py = py + 1;
    }
    #delete[py];
    #delete[w]; #delete[h]; #delete[keyFlag]; #delete[key]; #delete[data];
}

#define(ciSheetDrawFrame) {
    #scanp(ciSheetDrawFrame, int, 0) sheet;
    #scanp(ciSheetDrawFrame, int, 1) target;
    #scanp(ciSheetDrawFrame, int, 2) x;
    #scanp(ciSheetDrawFrame, int, 3) y;
    #scanp(ciSheetDrawFrame, int, 4) index;
    #req[ciVidStore] ciVidStore;
    #stack[int, 64] sw = cssc::peek32(sheet);
    #stack[int, 64] tileW = cssc::peek32(sheet + 8);
    #stack[int, 64] tileH = cssc::peek32(sheet + 12);
    #stack[int, 64] cols = cssc::peek32(sheet + 16);
    #stack[int, 64] keyFlag = cssc::peek32(sheet + 24);
    #stack[int, 64] key = cssc::peek32(sheet + 28);
    #stack[int, 64] data = cssc::peek64(sheet + 32);
    #stack[int, 64] col = index % cols;
    #stack[int, 64] row = index / cols;
    #stack[int, 64] sx0 = col * tileW;
    #stack[int, 64] sy0 = row * tileH;
    #stack[int, 64] py = 0;
    while (py < tileH) {
        #stack[int, 64] px = 0;
        while (px < tileW) {
            #stack[int, 64] pix = cssc::peek32(data + ((sy0 + py) * sw + (sx0 + px)) * 4);
            #stack[int, 32] skip = 0;
            if (keyFlag == 1) { if (pix == key) { skip = 1; } }
            if (skip == 0) { ciVidStore(target, x + px, y + py, pix); }
            #delete[skip];
            #delete[pix];
            px = px + 1;
        }
        #delete[px];
        py = py + 1;
    }
    #delete[py];
    #delete[sw]; #delete[tileW]; #delete[tileH]; #delete[cols];
    #delete[keyFlag]; #delete[key]; #delete[data];
    #delete[col]; #delete[row]; #delete[sx0]; #delete[sy0];
}

#define(ciTmDraw) {
    #scanp(ciTmDraw, int, 0) map;
    #scanp(ciTmDraw, int, 1) target;
    #scanp(ciTmDraw, int, 2) camX;
    #scanp(ciTmDraw, int, 3) camY;
    #req[ciVidStore] ciVidStore;
    #req[ciSext32] ciSext32;
    #stack[int, 64] tileset = cssc::peek64(map);
    #stack[int, 32] run = 1;
    if (tileset == 0) { run = 0; }
    if (run == 1) {
        #stack[int, 64] cols = cssc::peek32(map + 8);
        #stack[int, 64] rows = cssc::peek32(map + 12);
        #stack[int, 64] tw = cssc::peek32(map + 16);
        #stack[int, 64] th = cssc::peek32(map + 20);
        #stack[int, 64] data = cssc::peek64(map + 24);
        #stack[int, 64] tsW = cssc::peek32(tileset);
        #stack[int, 64] tsCols = cssc::peek32(tileset + 16);
        #stack[int, 64] tsKeyFlag = cssc::peek32(tileset + 24);
        #stack[int, 64] tsKey = cssc::peek32(tileset + 28);
        #stack[int, 64] tsData = cssc::peek64(tileset + 32);
        #stack[int, 64] vw = cssc::peek32(target);
        #stack[int, 64] vh = cssc::peek32(target + 4);
        #stack[int, 64] r = 0;
        while (r < rows) {
            #stack[int, 64] c = 0;
            while (c < cols) {
                ciSext32(cssc::peek32(data + (r * cols + c) * 4)) idx;
                #stack[int, 32] draw = 1;
                if (idx < 0) { draw = 0; }
                #stack[int, 64] sxp = c * tw - camX;
                #stack[int, 64] syp = r * th - camY;
                if (sxp + tw <= 0) { draw = 0; }
                if (syp + th <= 0) { draw = 0; }
                if (sxp >= vw) { draw = 0; }
                if (syp >= vh) { draw = 0; }
                if (draw == 1) {
                    #stack[int, 64] tcol = idx % tsCols;
                    #stack[int, 64] trow = idx / tsCols;
                    #stack[int, 64] ssx = tcol * tw;
                    #stack[int, 64] ssy = trow * th;
                    #stack[int, 64] py = 0;
                    while (py < th) {
                        #stack[int, 64] px = 0;
                        while (px < tw) {
                            #stack[int, 64] pix = cssc::peek32(tsData + ((ssy + py) * tsW + (ssx + px)) * 4);
                            #stack[int, 32] skip = 0;
                            if (tsKeyFlag == 1) { if (pix == tsKey) { skip = 1; } }
                            if (skip == 0) { ciVidStore(target, sxp + px, syp + py, pix); }
                            #delete[skip];
                            #delete[pix];
                            px = px + 1;
                        }
                        #delete[px];
                        py = py + 1;
                    }
                    #delete[py];
                    #delete[tcol]; #delete[trow]; #delete[ssx]; #delete[ssy];
                }
                #delete[sxp]; #delete[syp];
                #delete[draw];
                #delete[idx];
                c = c + 1;
            }
            #delete[c];
            r = r + 1;
        }
        #delete[r];
        #delete[cols]; #delete[rows]; #delete[tw]; #delete[th]; #delete[data];
        #delete[tsW]; #delete[tsCols]; #delete[tsKeyFlag]; #delete[tsKey]; #delete[tsData];
        #delete[vw]; #delete[vh];
    }
    #delete[run];
    #delete[tileset];
}

#define(ciFontMeasure) {
    #scanp(ciFontMeasure, int, 0) font;
    #scanp(ciFontMeasure, int, 1) sp;
    #stack[int, 64] glyphW = cssc::peek32(font);
    #stack[int, 64] kern = cssc::peek32(font + 12);
    #stack[int, 64] scale = cssc::peek32(font + 20);
    #stack[int, 64] advance = (glyphW + kern) * scale;
    #stack[int, 64] slen = cssc::peek32(sp + 4);
    #stack[int, 64] maxw = 0;
    #stack[int, 64] cur = 0;
    #stack[int, 64] i = 0;
    while (i < slen) {
        #stack[int, 64] ch = cssc::peek8(sp + 8 + i);
        if (ch == 10) {
            if (cur > maxw) { maxw = cur; }
            cur = 0;
        }
        if (ch != 10) { cur = cur + advance; }
        #delete[ch];
        i = i + 1;
    }
    #delete[i];
    if (cur > maxw) { maxw = cur; }
    if (maxw > 0) { maxw = maxw - kern * scale; }
    #delete[cur];
    #delete[glyphW]; #delete[kern]; #delete[scale]; #delete[advance]; #delete[slen];
    return maxw;
}

#define(ciFontBlit) {
    #scanp(ciFontBlit, int, 0) font;
    #scanp(ciFontBlit, int, 1) target;
    #scanp(ciFontBlit, int, 2) x;
    #scanp(ciFontBlit, int, 3) y;
    #scanp(ciFontBlit, int, 4) sp;
    #scanp(ciFontBlit, int, 5) argb;
    #req[ciVidStore] ciVidStore;
    #req[ciSheetDrawFrame] ciSheetDrawFrame;
    #stack[int, 64] glyphW = cssc::peek32(font);
    #stack[int, 64] glyphH = cssc::peek32(font + 4);
    #stack[int, 64] firstChar = cssc::peek32(font + 8);
    #stack[int, 64] kern = cssc::peek32(font + 12);
    #stack[int, 64] lineGap = cssc::peek32(font + 16);
    #stack[int, 64] scale = cssc::peek32(font + 20);
    #stack[int, 64] mode = cssc::peek32(font + 24);
    #stack[int, 64] glyphs = cssc::peek64(font + 28);
    #stack[int, 64] sheet = cssc::peek64(font + 36);
    #stack[int, 64] advance = (glyphW + kern) * scale;
    #stack[int, 64] lineStep = (glyphH + lineGap) * scale;
    #stack[int, 64] slen = cssc::peek32(sp + 4);
    #stack[int, 64] cx = x;
    #stack[int, 64] cy = y;
    #stack[int, 64] i = 0;
    while (i < slen) {
        #stack[int, 64] ch = cssc::peek8(sp + 8 + i);
        if (ch == 10) { cx = x; cy = cy + lineStep; }
        if (ch != 10) {
            if (mode == 0) {
                #stack[int, 64] gi = ch - firstChar;
                #stack[int, 32] okg = 1;
                if (gi < 0) { okg = 0; }
                if (gi > 94) { okg = 0; }
                if (okg == 1) {
                    #stack[int, 64] word = cssc::peek64(glyphs + gi * 8);
                    #stack[int, 64] rr = 0;
                    while (rr < glyphH) {
                        #stack[int, 64] bits = cssc::band(cssc::shr(word, rr * 8), 255);
                        #stack[int, 64] bb = 0;
                        while (bb < glyphW) {
                            #stack[int, 64] mask = cssc::shl(1, glyphW - 1 - bb);
                            if (cssc::band(bits, mask) != 0) {
                                #stack[int, 64] sy = 0;
                                while (sy < scale) {
                                    #stack[int, 64] sx = 0;
                                    while (sx < scale) {
                                        ciVidStore(target, cx + bb * scale + sx, cy + rr * scale + sy, argb);
                                        sx = sx + 1;
                                    }
                                    #delete[sx];
                                    sy = sy + 1;
                                }
                                #delete[sy];
                            }
                            #delete[mask];
                            bb = bb + 1;
                        }
                        #delete[bb];
                        #delete[bits];
                        rr = rr + 1;
                    }
                    #delete[rr];
                    #delete[word];
                }
                #delete[okg];
                #delete[gi];
            }
            if (mode != 0) {
                ciSheetDrawFrame(sheet, target, cx, cy, ch - firstChar);
            }
            cx = cx + advance;
        }
        #delete[ch];
        i = i + 1;
    }
    #delete[i];
    #delete[cx]; #delete[cy];
    #delete[glyphW]; #delete[glyphH]; #delete[firstChar]; #delete[kern];
    #delete[lineGap]; #delete[scale]; #delete[mode]; #delete[glyphs]; #delete[sheet];
    #delete[advance]; #delete[lineStep]; #delete[slen];
}

#define(ciSprBlitScaled) {
    #scanp(ciSprBlitScaled, int, 0) spr;
    #scanp(ciSprBlitScaled, int, 1) target;
    #scanp(ciSprBlitScaled, int, 2) x;
    #scanp(ciSprBlitScaled, int, 3) y;
    #scanp(ciSprBlitScaled, int, 4) outW;
    #scanp(ciSprBlitScaled, int, 5) outH;
    #req[ciVidStore] ciVidStore;
    #stack[int, 64] w = cssc::peek32(spr);
    #stack[int, 64] h = cssc::peek32(spr + 4);
    #stack[int, 64] keyFlag = cssc::peek32(spr + 8);
    #stack[int, 64] key = cssc::peek32(spr + 12);
    #stack[int, 64] data = cssc::peek64(spr + 16);
    #stack[int, 32] run = 1;
    if (outW <= 0) { run = 0; }
    if (outH <= 0) { run = 0; }
    if (run == 1) {
        #stack[int, 64] oy = 0;
        while (oy < outH) {
            #stack[int, 64] ox = 0;
            while (ox < outW) {
                #stack[int, 64] sx = ox * w / outW;
                #stack[int, 64] sy = oy * h / outH;
                #stack[int, 64] pix = cssc::peek32(data + (sy * w + sx) * 4);
                #stack[int, 32] skip = 0;
                if (keyFlag == 1) { if (pix == key) { skip = 1; } }
                if (skip == 0) { ciVidStore(target, x + ox, y + oy, pix); }
                #delete[skip]; #delete[pix]; #delete[sx]; #delete[sy];
                ox = ox + 1;
            }
            #delete[ox];
            oy = oy + 1;
        }
        #delete[oy];
    }
    #delete[run];
    #delete[w]; #delete[h]; #delete[keyFlag]; #delete[key]; #delete[data];
}

#define(ciSprBlitTinted) {
    #scanp(ciSprBlitTinted, int, 0) spr;
    #scanp(ciSprBlitTinted, int, 1) target;
    #scanp(ciSprBlitTinted, int, 2) x;
    #scanp(ciSprBlitTinted, int, 3) y;
    #scanp(ciSprBlitTinted, int, 4) tint;
    #req[ciVidStore] ciVidStore;
    #stack[int, 64] w = cssc::peek32(spr);
    #stack[int, 64] h = cssc::peek32(spr + 4);
    #stack[int, 64] keyFlag = cssc::peek32(spr + 8);
    #stack[int, 64] key = cssc::peek32(spr + 12);
    #stack[int, 64] data = cssc::peek64(spr + 16);
    #stack[int, 64] tr = cssc::band(cssc::shr(tint, 16), 255);
    #stack[int, 64] tg = cssc::band(cssc::shr(tint, 8), 255);
    #stack[int, 64] tb = cssc::band(tint, 255);
    #stack[int, 64] py = 0;
    while (py < h) {
        #stack[int, 64] px = 0;
        while (px < w) {
            #stack[int, 64] pix = cssc::peek32(data + (py * w + px) * 4);
            #stack[int, 32] skip = 0;
            if (keyFlag == 1) { if (pix == key) { skip = 1; } }
            if (skip == 0) {
                #stack[int, 64] pa = cssc::band(cssc::shr(pix, 24), 255);
                #stack[int, 64] pr = cssc::band(cssc::shr(pix, 16), 255) * tr / 255;
                #stack[int, 64] pg = cssc::band(cssc::shr(pix, 8), 255) * tg / 255;
                #stack[int, 64] pb = cssc::band(pix, 255) * tb / 255;
                #stack[int, 64] o = cssc::bor(cssc::shl(pa, 24), cssc::bor(cssc::shl(pr, 16), cssc::bor(cssc::shl(pg, 8), pb)));
                ciVidStore(target, x + px, y + py, o);
                #delete[pa]; #delete[pr]; #delete[pg]; #delete[pb]; #delete[o];
            }
            #delete[skip];
            #delete[pix];
            px = px + 1;
        }
        #delete[px];
        py = py + 1;
    }
    #delete[py];
    #delete[w]; #delete[h]; #delete[keyFlag]; #delete[key]; #delete[data];
    #delete[tr]; #delete[tg]; #delete[tb];
}

#define(ciSprBlitAlpha) {
    #scanp(ciSprBlitAlpha, int, 0) spr;
    #scanp(ciSprBlitAlpha, int, 1) target;
    #scanp(ciSprBlitAlpha, int, 2) x;
    #scanp(ciSprBlitAlpha, int, 3) y;
    #scanp(ciSprBlitAlpha, int, 4) alpha;
    #req[ciVidStore] ciVidStore;
    #req[ciVidLoad] ciVidLoad;
    #req[ciBlend] ciBlend;
    #stack[int, 64] w = cssc::peek32(spr);
    #stack[int, 64] h = cssc::peek32(spr + 4);
    #stack[int, 64] keyFlag = cssc::peek32(spr + 8);
    #stack[int, 64] key = cssc::peek32(spr + 12);
    #stack[int, 64] data = cssc::peek64(spr + 16);
    #stack[int, 64] py = 0;
    while (py < h) {
        #stack[int, 64] px = 0;
        while (px < w) {
            #stack[int, 64] pix = cssc::peek32(data + (py * w + px) * 4);
            #stack[int, 32] skip = 0;
            if (keyFlag == 1) { if (pix == key) { skip = 1; } }
            if (skip == 0) {
                #stack[int, 64] src = cssc::bor(cssc::shl(alpha, 24), cssc::band(pix, 16777215));
                ciVidLoad(target, x + px, y + py) dv;
                ciBlend(src, dv) bl;
                ciVidStore(target, x + px, y + py, bl);
                #delete[src]; #delete[dv]; #delete[bl];
            }
            #delete[skip];
            #delete[pix];
            px = px + 1;
        }
        #delete[px];
        py = py + 1;
    }
    #delete[py];
    #delete[w]; #delete[h]; #delete[keyFlag]; #delete[key]; #delete[data];
}

#define(ciSprBlitFlip) {
    #scanp(ciSprBlitFlip, int, 0) spr;
    #scanp(ciSprBlitFlip, int, 1) target;
    #scanp(ciSprBlitFlip, int, 2) x;
    #scanp(ciSprBlitFlip, int, 3) y;
    #scanp(ciSprBlitFlip, int, 4) flipX;
    #scanp(ciSprBlitFlip, int, 5) flipY;
    #req[ciVidStore] ciVidStore;
    #stack[int, 64] w = cssc::peek32(spr);
    #stack[int, 64] h = cssc::peek32(spr + 4);
    #stack[int, 64] keyFlag = cssc::peek32(spr + 8);
    #stack[int, 64] key = cssc::peek32(spr + 12);
    #stack[int, 64] data = cssc::peek64(spr + 16);
    #stack[int, 64] py = 0;
    while (py < h) {
        #stack[int, 64] px = 0;
        while (px < w) {
            #stack[int, 64] sx = px;
            if (flipX == 1) { sx = w - 1 - px; }
            #stack[int, 64] sy = py;
            if (flipY == 1) { sy = h - 1 - py; }
            #stack[int, 64] pix = cssc::peek32(data + (sy * w + sx) * 4);
            #stack[int, 32] skip = 0;
            if (keyFlag == 1) { if (pix == key) { skip = 1; } }
            if (skip == 0) { ciVidStore(target, x + px, y + py, pix); }
            #delete[skip]; #delete[pix]; #delete[sx]; #delete[sy];
            px = px + 1;
        }
        #delete[px];
        py = py + 1;
    }
    #delete[py];
    #delete[w]; #delete[h]; #delete[keyFlag]; #delete[key]; #delete[data];
}

#define(ciScanToVk) {
    #scanp(ciScanToVk, int, 0) base;
    #scanp(ciScanToVk, int, 1) ext;
    #stack[int, 64] vk = 0;
    if (ext == 1) {
        if (base == 72) { vk = 38; }
        if (base == 80) { vk = 40; }
        if (base == 75) { vk = 37; }
        if (base == 77) { vk = 39; }
        if (base == 29) { vk = 17; }
        if (base == 56) { vk = 18; }
    }
    if (ext == 0) {
        if (base == 1) { vk = 27; }
        if (base == 28) { vk = 13; }
        if (base == 14) { vk = 8; }
        if (base == 15) { vk = 9; }
        if (base == 42) { vk = 16; }
        if (base == 54) { vk = 16; }
        if (base == 29) { vk = 17; }
        if (base == 56) { vk = 18; }
        if (base == 57) { vk = 32; }
        if (base >= 59) { if (base <= 68) { vk = 112 + (base - 59); } }
        if (base == 87) { vk = 122; }
        if (base == 88) { vk = 123; }
        if (base >= 2) { if (base <= 10) { vk = 48 + (base - 1); } }
        if (base == 11) { vk = 48; }
        if (base == 16) { vk = 81; }
        if (base == 17) { vk = 87; }
        if (base == 18) { vk = 69; }
        if (base == 19) { vk = 82; }
        if (base == 20) { vk = 84; }
        if (base == 21) { vk = 89; }
        if (base == 22) { vk = 85; }
        if (base == 23) { vk = 73; }
        if (base == 24) { vk = 79; }
        if (base == 25) { vk = 80; }
        if (base == 30) { vk = 65; }
        if (base == 31) { vk = 83; }
        if (base == 32) { vk = 68; }
        if (base == 33) { vk = 70; }
        if (base == 34) { vk = 71; }
        if (base == 35) { vk = 72; }
        if (base == 36) { vk = 74; }
        if (base == 37) { vk = 75; }
        if (base == 38) { vk = 76; }
        if (base == 44) { vk = 90; }
        if (base == 45) { vk = 88; }
        if (base == 46) { vk = 67; }
        if (base == 47) { vk = 86; }
        if (base == 48) { vk = 66; }
        if (base == 49) { vk = 78; }
        if (base == 50) { vk = 77; }
    }
    return vk;
}

#define(ciNameToVk) {
    #scanp(ciNameToVk, int, 0) sp;
    #req[ciKbNames] ciKbNames;
    #stack[int, 64] vk = 0 - 1;
    #stack[int, 64] len = cssc::peek32(sp + 4);
    if (len == 1) {
        #stack[int, 64] c = cssc::peek8(sp + 8);
        #stack[int, 64] lc = c;
        if (c >= 65) { if (c <= 90) { lc = c + 32; } }
        if (lc >= 97) { if (lc <= 122) { vk = lc - 32; } }
        if (c >= 48) { if (c <= 57) { vk = c; } }
        #delete[c];
        #delete[lc];
    }
    if (len != 1) {
        #stack[int, 64] p = ciKbNames;
        #stack[int, 32] scanning = 1;
        while (scanning == 1) {
            #stack[int, 64] rlen = cssc::peek8(p);
            if (rlen == 0) { scanning = 0; }
            if (rlen != 0) {
                #stack[int, 64] rvk = cssc::peek8(p + 1);
                #stack[int, 32] match = 0;
                if (rlen == len) {
                    match = 1;
                    #stack[int, 64] j = 0;
                    while (j < len) {
                        #stack[int, 64] a = cssc::peek8(sp + 8 + j);
                        #stack[int, 64] b = cssc::peek8(p + 2 + j);
                        if (a >= 97) { if (a <= 122) { a = a - 32; } }
                        if (a != b) { match = 0; }
                        #delete[a];
                        #delete[b];
                        j = j + 1;
                    }
                    #delete[j];
                }
                if (match == 1) { vk = rvk; scanning = 0; }
                if (match == 0) { p = p + 2 + rlen; }
                #delete[match];
                #delete[rvk];
            }
            #delete[rlen];
        }
        #delete[p];
        #delete[scanning];
    }
    #delete[len];
    return vk;
}

#define(ciKbUpdate) {
    #req[ciKbCurr] ciKbCurr;
    #req[ciKbPrev] ciKbPrev;
    #req[ciKbEdge] ciKbEdge;
    #req[ciKbTail] ciKbTail;
    #req[ciKbExt] ciKbExt;
    #req[ciScanToVk] ciScanToVk;
    #req[keyBufAddr] keyBufAddr;
    #req[keyHead] keyHead;
    cssc::memcopy(ciKbPrev, ciKbCurr, 64);

    cssc::memfill32(ciKbEdge, 0, 64);
    #stack[int, 64] hd = keyHead;
    while (ciKbTail < hd) {
        #stack[int, 64] sc = cssc::peek8(keyBufAddr + ciKbTail % 256);
        ciKbTail = ciKbTail + 1;
        #stack[int, 32] consumed = 0;
        if (sc == 224) { ciKbExt = 1; consumed = 1; }
        if (consumed == 0) {
            #stack[int, 64] rel = 0;
            #stack[int, 64] base = sc;
            if (sc >= 128) { rel = 1; base = sc - 128; }
            ciScanToVk(base, ciKbExt) vk;
            if (vk > 0) {
                #stack[int, 64] v = 1;
                if (rel == 1) { v = 0; }
                cssc::poke8(ciKbCurr + vk, v);
                if (rel == 0) { cssc::poke8(ciKbEdge + vk, 1); }
                #delete[v];
            }
            ciKbExt = 0;
            #delete[vk];
            #delete[rel];
            #delete[base];
        }
        #delete[consumed];
        #delete[sc];
    }
    #delete[hd];
}

#define(ciKbGetKey) {
    #req[ciKbNames] ciKbNames;
    #req[ciKbCurr] ciKbCurr;
    #req[ciStrNew] ciStrNew;
    #stack[int, 64] outp = 0;
    #stack[int, 32] found = 0;

    #stack[int, 64] p = ciKbNames;
    #stack[int, 32] scanning = 1;
    while (scanning == 1) {
        #stack[int, 64] rlen = cssc::peek8(p);
        if (rlen == 0) { scanning = 0; }
        if (rlen != 0) {
            #stack[int, 64] rvk = cssc::peek8(p + 1);
            if (found == 0) {
                if (cssc::peek8(ciKbCurr + rvk) == 1) {
                    ciStrNew(p + 2, rlen) s;
                    outp = s;
                    found = 1;
                    #delete[s];
                }
            }
            p = p + 2 + rlen;
            #delete[rvk];
        }
        #delete[rlen];
    }
    #delete[p];
    #delete[scanning];

    #stack[int, 64] k = 65;
    while (k <= 90) {
        if (found == 0) {
            if (cssc::peek8(ciKbCurr + k) == 1) {
                #stack[int, 64] tmp = cssc::alloc(1);
                cssc::poke8(tmp, k);
                ciStrNew(tmp, 1) s;
                outp = s;
                found = 1;
                cssc::free(tmp);
                #delete[tmp];
                #delete[s];
            }
        }
        k = k + 1;
    }
    #delete[k];
    #stack[int, 64] d = 48;
    while (d <= 57) {
        if (found == 0) {
            if (cssc::peek8(ciKbCurr + d) == 1) {
                #stack[int, 64] tmp = cssc::alloc(1);
                cssc::poke8(tmp, d);
                ciStrNew(tmp, 1) s;
                outp = s;
                found = 1;
                cssc::free(tmp);
                #delete[tmp];
                #delete[s];
            }
        }
        d = d + 1;
    }
    #delete[d];
    if (found == 0) { ciStrNew(ciKbNames, 0) e; outp = e; #delete[e]; }
    #delete[found];
    return outp;
}

#define(ciSndLoad) {
    #scanp(ciSndLoad, int, 0) pathPtr;
    #req[ciSndSlots] ciSndSlots;
    #req[ciSndNextId] ciSndNextId;
    #req[ciStrNew] ciStrNew;
    #req[ciStrClone] ciStrClone;
    #req[ciItoa] ciItoa;
    #stack[int, 64] out = 0;
    #stack[int, 32] fail = 0;
    if (pathPtr == 0) { fail = 1; }
    #stack[int, 64] slot = 0 - 1;
    if (fail == 0) {
        #stack[int, 64] i = 0;
        while (i < 32) {
            if (slot < 0) {
                if (cssc::peek64(ciSndSlots + i * 16) == 0) { slot = i; }
            }
            i = i + 1;
        }
        #delete[i];
        if (slot < 0) { fail = 1; }
    }
    if (fail == 1) {
        ciStrNew(ciSndSlots, 0) e;
        out = e;
        #delete[e];
    }
    if (fail == 0) {
        ciStrClone(pathPtr) pc;
        cssc::poke64(ciSndSlots + slot * 16, pc);
        #delete[pc];
        #stack[int, 64] id = ciSndNextId;
        ciSndNextId = ciSndNextId + 1;
        #stack[int, 64] buf = cssc::alloc(24);
        cssc::poke8(buf, 99);
        cssc::poke8(buf + 1, 115);
        cssc::poke8(buf + 2, 115);
        cssc::poke8(buf + 3, 99);
        ciItoa(id, buf + 4) dn;
        ciStrNew(buf, 4 + dn) alias;
        ciStrClone(alias) ac;
        cssc::poke64(ciSndSlots + slot * 16 + 8, ac);
        out = alias;
        cssc::free(buf);
        #delete[ac];
        #delete[alias];
        #delete[dn];
        #delete[id];
        #delete[buf];
    }
    #delete[fail];
    #delete[slot];
    return out;
}

#define(ciIniWs) {
    #scanp(ciIniWs, int, 0) c;
    #stack[int, 32] w = 0;
    if (c == 32) { w = 1; }
    if (c == 9) { w = 1; }
    if (c == 10) { w = 1; }
    if (c == 11) { w = 1; }
    if (c == 12) { w = 1; }
    if (c == 13) { w = 1; }
    return w;
}

#define(ciIniSectMatch) {
    #scanp(ciIniSectMatch, int, 0) buf;
    #scanp(ciIniSectMatch, int, 1) ts;
    #scanp(ciIniSectMatch, int, 2) te;
    #scanp(ciIniSectMatch, int, 3) sctP;
    #scanp(ciIniSectMatch, int, 4) sctL;
    #stack[int, 32] ok = 0;
    #stack[int, 64] p = ts;
    #stack[int, 32] sk = 1;
    while (sk == 1) {
        sk = 0;
        if (p < te) { if (cssc::peek8(buf + p) == 32) { p = p + 1; sk = 1; } }
    }
    #delete[sk];
    if (p < te) {
        if (cssc::peek8(buf + p) == 91) {
            p = p + 1;
            #stack[int, 64] ns = p;
            #stack[int, 32] fin = 0;
            while (fin == 0) {
                if (p >= te) { fin = 1; }
                if (fin == 0) { if (cssc::peek8(buf + p) == 93) { fin = 1; } }
                if (fin == 0) { p = p + 1; }
            }
            #delete[fin];
            #stack[int, 64] nl = p - ns;
            if (nl == sctL) {
                ok = 1;
                #stack[int, 64] j = 0;
                while (j < nl) {
                    if (cssc::peek8(buf + ns + j) != cssc::peek8(sctP + j)) { ok = 0; }
                    j = j + 1;
                }
                #delete[j];
            }
            #delete[nl];
            #delete[ns];
        }
    }
    #delete[p];
    return ok;
}

#define(ciIniLookup) {
    #scanp(ciIniLookup, int, 0) buf;
    #scanp(ciIniLookup, int, 1) len;
    #scanp(ciIniLookup, int, 2) sctP;
    #scanp(ciIniLookup, int, 3) sctL;
    #scanp(ciIniLookup, int, 4) keyP;
    #scanp(ciIniLookup, int, 5) keyL;
    #req[ciIniWs] ciIniWs;
    #req[ciIniSectMatch] ciIniSectMatch;
    #req[ciIniVal] ciIniVal;
    #req[ciIniValLen] ciIniValLen;
    #stack[int, 64] pos = 0;
    #stack[int, 32] inSect = 0;
    #stack[int, 32] hit = 0;
    while (pos < len) {
        if (hit == 1) { pos = len; }
        if (hit == 0) {
            #stack[int, 64] ls = pos;
            #stack[int, 64] le = pos;
            #stack[int, 32] fe = 0;
            while (fe == 0) {
                if (le >= len) { fe = 1; }
                if (fe == 0) {
                    #stack[int, 64] ch = cssc::peek8(buf + le);
                    if (ch == 10) { fe = 1; }
                    if (ch == 0) { fe = 1; }
                    #delete[ch];
                }
                if (fe == 0) { le = le + 1; }
            }
            #delete[fe];
            #stack[int, 64] ce = ls;
            #stack[int, 32] fc = 0;
            while (fc == 0) {
                if (ce >= le) { fc = 1; }
                if (fc == 0) {
                    #stack[int, 64] ch = cssc::peek8(buf + ce);
                    if (ch == 59) { fc = 1; }
                    if (ch == 35) { fc = 1; }
                    #delete[ch];
                }
                if (fc == 0) { ce = ce + 1; }
            }
            #delete[fc];
            #stack[int, 64] ts = ls;
            #stack[int, 64] te = ce;
            #stack[int, 32] t1 = 1;
            while (t1 == 1) {
                t1 = 0;
                if (ts < te) { ciIniWs(cssc::peek8(buf + ts)) w; if (w == 1) { ts = ts + 1; t1 = 1; } #delete[w]; }
            }
            #stack[int, 32] t2 = 1;
            while (t2 == 1) {
                t2 = 0;
                if (te > ts) { ciIniWs(cssc::peek8(buf + te - 1)) w; if (w == 1) { te = te - 1; t2 = 1; } #delete[w]; }
            }
            #delete[t1];
            #delete[t2];
            if (te > ts) {
                #stack[int, 64] first = cssc::peek8(buf + ts);
                if (first == 91) {
                    ciIniSectMatch(buf, ts, te, sctP, sctL) sm;
                    inSect = sm;
                    #delete[sm];
                }
                if (first != 91) {
                    if (inSect == 1) {
                        #stack[int, 64] eq = ts;
                        #stack[int, 32] fq = 0;
                        while (fq == 0) {
                            if (eq >= te) { fq = 1; }
                            if (fq == 0) { if (cssc::peek8(buf + eq) == 61) { fq = 1; } }
                            if (fq == 0) { eq = eq + 1; }
                        }
                        #delete[fq];
                        if (eq < te) {
                            #stack[int, 64] ke = eq;
                            #stack[int, 32] kt = 1;
                            while (kt == 1) {
                                kt = 0;
                                if (ke > ts) { ciIniWs(cssc::peek8(buf + ke - 1)) w; if (w == 1) { ke = ke - 1; kt = 1; } #delete[w]; }
                            }
                            #delete[kt];
                            #stack[int, 64] kl2 = ke - ts;
                            #stack[int, 32] km = 0;
                            if (kl2 == keyL) {
                                km = 1;
                                #stack[int, 64] j = 0;
                                while (j < kl2) {
                                    if (cssc::peek8(buf + ts + j) != cssc::peek8(keyP + j)) { km = 0; }
                                    j = j + 1;
                                }
                                #delete[j];
                            }
                            if (km == 1) {
                                #stack[int, 64] vs = eq + 1;
                                #stack[int, 32] vsk = 1;
                                while (vsk == 1) {
                                    vsk = 0;
                                    if (vs < te) {
                                        #stack[int, 64] c = cssc::peek8(buf + vs);
                                        if (c == 32) { vs = vs + 1; vsk = 1; }
                                        if (c == 9) { vs = vs + 1; vsk = 1; }
                                        #delete[c];
                                    }
                                }
                                #delete[vsk];
                                #stack[int, 64] ve = te;
                                #stack[int, 32] vt = 1;
                                while (vt == 1) {
                                    vt = 0;
                                    if (ve > vs) { ciIniWs(cssc::peek8(buf + ve - 1)) w; if (w == 1) { ve = ve - 1; vt = 1; } #delete[w]; }
                                }
                                #delete[vt];
                                #stack[int, 64] vl = ve - vs;
                                if (vl > 1023) { vl = 1023; }
                                #stack[int, 64] j = 0;
                                while (j < vl) {
                                    cssc::poke8(ciIniVal + j, cssc::peek8(buf + vs + j));
                                    j = j + 1;
                                }
                                #delete[j];
                                ciIniValLen = vl;
                                hit = 1;
                                #delete[vs];
                                #delete[ve];
                                #delete[vl];
                            }
                            #delete[km];
                            #delete[kl2];
                            #delete[ke];
                        }
                        #delete[eq];
                    }
                }
                #delete[first];
            }
            #delete[ts];
            #delete[te];
            #delete[ce];
            pos = le;
            if (pos < len) { if (cssc::peek8(buf + pos) == 10) { pos = pos + 1; } }
            #delete[ls];
            #delete[le];
        }
    }
    #delete[pos];
    #delete[inSect];
    return hit;
}

#define(ciIniPut) {
    #scanp(ciIniPut, int, 0) off;
    #scanp(ciIniPut, int, 1) src;
