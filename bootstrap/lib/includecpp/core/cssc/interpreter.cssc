                    #stack[int, 64] ch = cssc::peek8(buf + ce);
                    if (ch == 59) { fc = 1; }
                    if (ch == 35) { fc = 1; }
                    #delete[ch];
                }
                if (fc == 0) { ce = ce + 1; }
            }
            #delete[fc];
            #stack[int, 64] ts = ls;
            #stack[int, 64] te = ce;
            #stack[int, 32] t1 = 1;
            while (t1 == 1) {
                t1 = 0;
                if (ts < te) { ciIniWs(cssc::peek8(buf + ts)) w; if (w == 1) { ts = ts + 1; t1 = 1; } #delete[w]; }
            }
            #stack[int, 32] t2 = 1;
            while (t2 == 1) {
                t2 = 0;
                if (te > ts) { ciIniWs(cssc::peek8(buf + te - 1)) w; if (w == 1) { te = te - 1; t2 = 1; } #delete[w]; }
            }
            #delete[t1];
            #delete[t2];
            if (te > ts) {
                if (cssc::peek8(buf + ts) == 91) {
                    ciIniSectMatch(buf, ts, te, sctP, sctL) sm;
                    if (sm == 1) { hit = 1; }
                    #delete[sm];
                }
            }
            #delete[te];
            #delete[ts];
            #delete[ce];
            #delete[ls];
            pos = le + 1;
            #delete[le];
        }
    }
    #stack[int, 32] r = hit;
    #delete[hit];
    #delete[pos];
    return r;
}

#stack[int, 64] ciIniAddSection;
#define(ciIniAddSection) {
    #scanp(ciIniAddSection, int, 0) pathStr;
    #scanp(ciIniAddSection, int, 1) sectStr;
    #req[fsFind] fsFind;
    #req[fsIdx] fsIdx;
    #req[fsCreate] fsCreate;
    #req[fsReadPtr] fsReadPtr;
    #req[fsReadLen] fsReadLen;
    #req[fsStore] fsStore;
    #req[ciIniHasSection] ciIniHasSection;
    #stack[int, 64] sctP = sectStr + 8;
    #stack[int, 64] sctL = cssc::peek32(sectStr + 4);
    fsCreate(pathStr + 8, cssc::peek32(pathStr + 4));
    #stack[int, 64] r = 0;
    if (fsIdx >= 0) {
        #stack[int, 64] idx = fsIdx;
        fsReadPtr(idx) bp;
        fsReadLen(idx) bl;
        ciIniHasSection(bp, bl, sctP, sctL) has;
        if (has == 1) { r = 1; }
        if (has == 0) {

            #stack[int, 64] nb = cssc::alloc(bl + sctL + 4);
            #stack[int, 64] w = 0;
            while (w < bl) { cssc::poke8(nb + w, cssc::peek8(bp + w)); w = w + 1; }
            if (bl > 0) {
                if (cssc::peek8(bp + bl - 1) != 10) { cssc::poke8(nb + w, 10); w = w + 1; }
            }
            cssc::poke8(nb + w, 91); w = w + 1;
            #stack[int, 64] j = 0;
            while (j < sctL) { cssc::poke8(nb + w, cssc::peek8(sctP + j)); w = w + 1; j = j + 1; }
            #delete[j];
            cssc::poke8(nb + w, 93); w = w + 1;
            cssc::poke8(nb + w, 10); w = w + 1;
            fsStore(idx, nb, w);
            cssc::free(nb);
            r = 1;
            #delete[w];
            #delete[nb];
        }
        #delete[has];
        #delete[bp];
        #delete[bl];
        #delete[idx];
    }
    #delete[sctL];
    #delete[sctP];
    return r;
}

#define(ciIniWriteKey) {
    #scanp(ciIniWriteKey, int, 0) pathStr;
