#define(ciConGetLine) {
    #scanp(ciConGetLine, int, 0) ch;
    #scanp(ciConGetLine, int, 1) line;
    #req[ciStrNew] ciStrNew;
    #stack[int, 64] w = cssc::peek32(ch);
    #stack[int, 64] h = cssc::peek32(ch + 4);
    #stack[int, 64] res = 0;
    if (line >= 0) {
        if (line < h) {
            #stack[int, 64] cells = cssc::peek64(ch + 32);
            #stack[int, 64] tmp = cssc::alloc(w + 1);
            #stack[int, 64] base = line * w;
            #stack[int, 64] c = 0;
            while (c < w) {
                cssc::poke8(tmp + c, cssc::peek8(cells + (base + c) * 2));
                c = c + 1;
            }
            #delete[c];
            #stack[int, 64] ln = w;
            #stack[int, 32] go = 1;
            while (go == 1) {
                if (ln <= 0) { go = 0; }
                if (go == 1) {
                    #stack[int, 64] bb = cssc::peek8(tmp + ln - 1);
                    #stack[int, 32] trim = 0;
                    if (bb == 32) { trim = 1; }
                    if (bb == 0) { trim = 1; }
                    if (trim == 0) { go = 0; }
                    if (trim == 1) { ln = ln - 1; }
                    #delete[bb];
                    #delete[trim];
                }
            }
            #delete[go];
            ciStrNew(tmp, ln) s;
            res = s;
            cssc::free(tmp);
            #delete[s];
            #delete[ln];
            #delete[base];
            #delete[cells];
            #delete[tmp];
        }
    }
    #delete[w];
    #delete[h];
