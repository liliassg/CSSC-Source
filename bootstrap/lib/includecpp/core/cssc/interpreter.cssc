    #req[ciMsUpdate] ciMsUpdate;
    #req[ciMsMethod] ciMsMethod;
    #req[ciVarSet] ciVarSet;
    #stack[int, 64] o = ciTokOff;
    #stack[int, 64] l = ciTokLen;
    ciTokHasCC(o, l) ccp;
    #stack[int, 64] moff = o;
    #stack[int, 64] mlen = l;
    if (ccp >= 0) { moff = o + ccp + 2; mlen = l - ccp - 2; }
    ciIdentIs(moff, mlen, "update") mupd;
    ciIdentIs(moff, mlen, "client") mcli;
    ciAdvance();
    if (ciCur == 9) { ciAdvance(); }
    #stack[int, 64] a1 = 0;
    #stack[int, 64] a2 = 0;
    #stack[int, 64] a3 = 0;
    #stack[int, 64] a4 = 0;
    #stack[int, 64] a1t = 0;
    #stack[int, 64] a1o = 0;
    #stack[int, 32] n = 0;
    #stack[int, 32] go = 1;
    if (ciCur == 10) { go = 0; }
    while (go == 1) {
        ciExpr(0) e;
        if (n == 0) { a1 = e; a1t = ciEvalType; a1o = ciEvalOwns; }
        if (n == 1) { a2 = e; }
        if (n == 2) { a3 = e; }
        if (n == 3) { a4 = e; }
        if (n > 3) { if (ciEvalOwns == 1) { if (ciEvalType == 1) { cssc::free(e); } } }
        n = n + 1;
        #delete[e];
        if (ciCur == 21) { ciAdvance(); }
        if (ciCur == 10) { go = 0; }
        if (ciCur == 0) { go = 0; }
    }
    #delete[go];
    if (ciCur == 10) { ciAdvance(); }
    #stack[int, 32] hasCap = 0;
    #stack[int, 64] capOff = 0;
    #stack[int, 64] capLen = 0;
    if (ciCur == 2) { capOff = ciTokOff; capLen = ciTokLen; hasCap = 1; ciAdvance(); }
    #stack[int, 64] rv = 0;
    #stack[int, 64] rt = 0;
    if (ciExec == 1) {
        if (mupd == 1) { ciMsUpdate(); rv = 0; rt = 0; }
        if (mupd == 0) {
            if (mcli == 1) { rv = a1; rt = 8; }
            if (mcli == 0) { ciMsMethod(moff, mlen, a1, a2, a3, a4) r; rv = r; rt = 0; #delete[r]; }
        }
        if (hasCap == 1) { ciVarSet(capOff, capLen, rv, rt, 0); }
    }
    if (a1o == 1) { if (a1t == 1) { if (a1 != 0) { cssc::free(a1); } } }
    if (ciCur == 13) { ciAdvance(); }
    #delete[rv];
    #delete[rt];
    #delete[hasCap];
    #delete[capOff];
    #delete[capLen];
    #delete[a1];
    #delete[a2];
    #delete[a3];
    #delete[a4];
    #delete[a1t];
    #delete[a1o];
    #delete[n];
    #delete[mupd];
    #delete[mcli];
    #delete[moff];
    #delete[mlen];
    #delete[ccp];
    #delete[o];
    #delete[l];
}

#define(ciDoVideo) {
    #req[ciCur] ciCur;
    #req[ciTokOff] ciTokOff;
    #req[ciTokLen] ciTokLen;
    #req[ciExec] ciExec;
    #req[ciIdentIs] ciIdentIs;
    #req[ciAdvance] ciAdvance;
    #req[ciExpr] ciExpr;
    #req[ciEvalOwns] ciEvalOwns;
    #req[ciEvalType] ciEvalType;
    #req[ciTokHasCC] ciTokHasCC;
    #req[ciVidClear] ciVidClear;
    #req[ciVidStore] ciVidStore;
    #req[ciVidFill] ciVidFill;
    #req[ciVidRect] ciVidRect;
    #req[ciVidDark] ciVidDark;
    #req[ciVidText] ciVidText;
    #req[ciVidPresent] ciVidPresent;
    #stack[int, 64] o = ciTokOff;
    #stack[int, 64] l = ciTokLen;

    ciTokHasCC(o, l) ccp;
    #stack[int, 64] moff = o;
    #stack[int, 64] mlen = l;
    if (ccp >= 0) { moff = o + ccp + 2; mlen = l - ccp - 2; }
    ciIdentIs(moff, mlen, "clear") mCl;
    ciIdentIs(moff, mlen, "pixel") mPx;
    ciIdentIs(moff, mlen, "setPixel") mPx2;
    ciIdentIs(moff, mlen, "fillRect") mFl;
    ciIdentIs(moff, mlen, "drawRect") mRc;
    ciIdentIs(moff, mlen, "darken") mDk;
    ciIdentIs(moff, mlen, "drawText") mTx;
    ciIdentIs(moff, mlen, "present") mPr;

    #stack[int, 64] mFlA = 0;
    ciIdentIs(moff, mlen, "fillrect") mFlL;
    if (mFlL == 1) { mFl = 1; }
    ciIdentIs(moff, mlen, "fillRectAlpha") mFlA1;
    if (mFlA1 == 1) { mFl = 1; mFlA = 1; }
    ciIdentIs(moff, mlen, "fillrectalpha") mFlA2;
    if (mFlA2 == 1) { mFl = 1; mFlA = 1; }
    ciIdentIs(moff, mlen, "drawrect") mRcL;
    if (mRcL == 1) { mRc = 1; }
    ciIdentIs(moff, mlen, "drawtext") mTxL;
    if (mTxL == 1) { mTx = 1; }
    ciIdentIs(moff, mlen, "setpixel") mPxL;
    if (mPxL == 1) { mPx2 = 1; }
    #delete[mFlL];
    #delete[mFlA1];
    #delete[mFlA2];
    #delete[mRcL];
    #delete[mTxL];
    #delete[mPxL];
    ciAdvance();
    if (ciCur == 9) { ciAdvance(); }
    #stack[int, 64] a1 = 0;
    #stack[int, 64] a2 = 0;
    #stack[int, 64] a3 = 0;
    #stack[int, 64] a4 = 0;
    #stack[int, 64] a5 = 0;
    #stack[int, 64] a6 = 0;
    #stack[int, 64] w1 = 0;
    #stack[int, 64] w2 = 0;
    #stack[int, 64] w3 = 0;
    #stack[int, 64] w4 = 0;
    #stack[int, 64] w5 = 0;
    #stack[int, 64] w6 = 0;

    #stack[int, 64] t1 = 0;
    #stack[int, 64] t2 = 0;
    #stack[int, 64] t3 = 0;
    #stack[int, 64] t4 = 0;
    #stack[int, 64] t5 = 0;
    #stack[int, 64] t6 = 0;
    #stack[int, 32] n = 0;
    #stack[int, 32] go = 1;
    while (go == 1) {
        if (ciCur == 10) { go = 0; }
        if (go == 1) {
            ciExpr(0) e;
            #stack[int, 64] eo = ciEvalOwns;
            #stack[int, 64] et = ciEvalType;
            if (n == 0) { a1 = e; w1 = eo; t1 = et; }
            if (n == 1) { a2 = e; w2 = eo; t2 = et; }
            if (n == 2) { a3 = e; w3 = eo; t3 = et; }
            if (n == 3) { a4 = e; w4 = eo; t4 = et; }
            if (n == 4) { a5 = e; w5 = eo; t5 = et; }
            if (n == 5) { a6 = e; w6 = eo; t6 = et; }
            n = n + 1;
            #delete[et];
            #delete[eo];
            #delete[e];
            if (ciCur == 21) { ciAdvance(); }
            if (n >= 6) { go = 0; }
        }
    }
    #delete[go];
    if (ciCur == 10) { ciAdvance(); }
    if (ciExec == 1) {
        if (mCl == 1) { ciVidClear(a1, a2); }
        if (mPx == 1) { ciVidStore(a1, a2, a3, a4); }
        if (mPx2 == 1) { ciVidStore(a1, a2, a3, a4); }
        if (mFl == 1) { ciVidFill(a1, a2, a3, a4, a5, a6); }
        if (mRc == 1) { ciVidRect(a1, a2, a3, a4, a5, a6); }
        if (mDk == 1) {

            #stack[int, 64] amt = a2;
            if (t2 == 2) {
                cssc::iToF(255) f255;
                cssc::fMul(a2, f255) fm;
                cssc::fToI(fm) ai;
                amt = ai;
                #delete[ai];
                #delete[fm];
                #delete[f255];
            }
            ciVidDark(a1, amt);
            #delete[amt];
        }
        if (mTx == 1) { ciVidText(a1, a2, a3, a4, a5, a6); }
        if (mPr == 1) { ciVidPresent(a1); }

    }

    if (w1 == 1) { cssc::free(a1); }
    if (w2 == 1) { cssc::free(a2); }
    if (w3 == 1) { cssc::free(a3); }
    if (w4 == 1) { cssc::free(a4); }
    if (w5 == 1) { cssc::free(a5); }
    if (w6 == 1) { cssc::free(a6); }
    if (ciCur == 13) { ciAdvance(); }
    #delete[a1];
    #delete[a2];
    #delete[a3];
    #delete[a4];
    #delete[a5];
    #delete[a6];
    #delete[w1];
    #delete[w2];
    #delete[w3];
    #delete[w4];
    #delete[w5];
    #delete[w6];
    #delete[t1];
    #delete[t2];
    #delete[t3];
    #delete[t4];
    #delete[t5];
    #delete[t6];
    #delete[mFlA];
    #delete[n];
    #delete[mCl];
    #delete[mPx];
    #delete[mPx2];
    #delete[mFl];
    #delete[mRc];
    #delete[mDk];
    #delete[mTx];
    #delete[mPr];
    #delete[moff];
    #delete[mlen];
    #delete[ccp];
    #delete[o];
    #delete[l];
}

#define(ciDoSprite) {
    #req[ciCur] ciCur;
    #req[ciTokOff] ciTokOff;
    #req[ciTokLen] ciTokLen;
    #req[ciExec] ciExec;
    #req[ciIdentIs] ciIdentIs;
    #req[ciAdvance] ciAdvance;
    #req[ciExpr] ciExpr;
    #req[ciEvalOwns] ciEvalOwns;
    #req[ciEvalType] ciEvalType;
    #req[ciTokHasCC] ciTokHasCC;
    #req[ciVarSet] ciVarSet;
    #req[ciValFree] ciValFree;
    #req[ciSprBlit] ciSprBlit;
    #req[ciSprBlitScaled] ciSprBlitScaled;
    #req[ciSprBlitTinted] ciSprBlitTinted;
    #req[ciSprBlitAlpha] ciSprBlitAlpha;
    #req[ciSprBlitFlip] ciSprBlitFlip;
    #req[ciSheetDrawFrame] ciSheetDrawFrame;
    #stack[int, 64] o = ciTokOff;
    #stack[int, 64] l = ciTokLen;
    ciTokHasCC(o, l) ccp;
    #stack[int, 64] moff = o;
    #stack[int, 64] mlen = l;
    if (ccp >= 0) { moff = o + ccp + 2; mlen = l - ccp - 2; }
    ciIdentIs(moff, mlen, "setPixel") mSp;
    ciIdentIs(moff, mlen, "setKey") mSk;
    ciIdentIs(moff, mlen, "clear") mCl;
    ciIdentIs(moff, mlen, "draw") mDr;
    ciIdentIs(moff, mlen, "drawScaled") mDs;
    ciIdentIs(moff, mlen, "drawTinted") mDt;
    ciIdentIs(moff, mlen, "drawAlpha") mDa;
    ciIdentIs(moff, mlen, "drawFlipped") mDf;
    ciIdentIs(moff, mlen, "sheetDrawFrame") mSd;
    ciIdentIs(moff, mlen, "animUpdate") mAu;
    ciIdentIs(moff, mlen, "animDraw") mAd;
    ciIdentIs(moff, mlen, "animReset") mAr;
    #stack[int, 32] isVoid = 0;
    if (mSp == 1) { isVoid = 1; }
    if (mSk == 1) { isVoid = 1; }
    if (mCl == 1) { isVoid = 1; }
    if (mDr == 1) { isVoid = 1; }
    if (mDs == 1) { isVoid = 1; }
    if (mDt == 1) { isVoid = 1; }
    if (mDa == 1) { isVoid = 1; }
    if (mDf == 1) { isVoid = 1; }
    if (mSd == 1) { isVoid = 1; }
    if (mAu == 1) { isVoid = 1; }
    if (mAd == 1) { isVoid = 1; }
    if (mAr == 1) { isVoid = 1; }
    if (isVoid == 1) {
        ciAdvance();
        if (ciCur == 9) { ciAdvance(); }
        #stack[int, 64] a1 = 0; #stack[int, 64] a2 = 0; #stack[int, 64] a3 = 0;
        #stack[int, 64] a4 = 0; #stack[int, 64] a5 = 0; #stack[int, 64] a6 = 0;
        #stack[int, 64] w1 = 0; #stack[int, 64] w2 = 0; #stack[int, 64] w3 = 0;
        #stack[int, 64] w4 = 0; #stack[int, 64] w5 = 0; #stack[int, 64] w6 = 0;
        #stack[int, 32] n = 0;
        #stack[int, 32] go = 1;
        while (go == 1) {
            if (ciCur == 10) { go = 0; }
            if (ciCur == 0) { go = 0; }
            if (go == 1) {
                ciExpr(0) e;
                #stack[int, 64] eo = ciEvalOwns;
                if (n == 0) { a1 = e; w1 = eo; }
                if (n == 1) { a2 = e; w2 = eo; }
                if (n == 2) { a3 = e; w3 = eo; }
                if (n == 3) { a4 = e; w4 = eo; }
                if (n == 4) { a5 = e; w5 = eo; }
                if (n == 5) { a6 = e; w6 = eo; }
                n = n + 1;
                #delete[eo]; #delete[e];
                if (ciCur == 21) { ciAdvance(); }
                if (n >= 6) { go = 0; }
            }
        }
        #delete[go];
        if (ciCur == 10) { ciAdvance(); }
        if (ciExec == 1) {
            if (mSp == 1) {
                #stack[int, 64] w = cssc::peek32(a1);
                #stack[int, 64] h = cssc::peek32(a1 + 4);
                #stack[int, 64] data = cssc::peek64(a1 + 16);
                if (a2 >= 0) { if (a3 >= 0) { if (a2 < w) { if (a3 < h) {
                    cssc::poke32(data + (a3 * w + a2) * 4, a4);
                } } } }
                #delete[w]; #delete[h]; #delete[data];
            }
            if (mSk == 1) { cssc::poke32(a1 + 8, 1); cssc::poke32(a1 + 12, a2); }
            if (mCl == 1) {
                cssc::memfill32(cssc::peek64(a1 + 16), a2, cssc::peek32(a1) * cssc::peek32(a1 + 4));
            }
            if (mDr == 1) { ciSprBlit(a1, a2, a3, a4); }
            if (mDs == 1) { ciSprBlitScaled(a1, a2, a3, a4, a5, a6); }
            if (mDt == 1) { ciSprBlitTinted(a1, a2, a3, a4, a5); }
            if (mDa == 1) { ciSprBlitAlpha(a1, a2, a3, a4, a5); }
            if (mDf == 1) { ciSprBlitFlip(a1, a2, a3, a4, a5, a6); }
            if (mSd == 1) { ciSheetDrawFrame(a1, a2, a3, a4, a5); }
            if (mAu == 1) {

                #stack[int, 64] finished = cssc::peek32(a1 + 44);
                if (finished == 0) {
                    #stack[int, 64] count = cssc::peek32(a1 + 16);
                    #stack[int, 64] fpsB = cssc::peek64(a1 + 24);
                    #stack[int, 64] accB = cssc::peek64(a1 + 32);
                    #stack[int, 64] idx = cssc::peek32(a1 + 20);
                    #stack[int, 64] looping = cssc::peek32(a1 + 40);
                    cssc::iToF(a2) dms;
                    cssc::iToF(1000) th;
                    cssc::fDiv(dms, th) dsec;
                    cssc::fAdd(accB, dsec) acc2; accB = acc2;
                    cssc::iToF(1) onef;
                    cssc::fDiv(onef, fpsB) step;
                    #stack[int, 32] loop = 1;
                    while (loop == 1) {
                        cssc::fCmp(accB, step) cmp;
                        if (cmp < 0) { loop = 0; }
                        if (cmp >= 0) {
                            cssc::fSub(accB, step) a3f; accB = a3f;
                            idx = idx + 1;
                            if (idx >= count) {
                                if (looping == 1) { idx = 0; }
                                if (looping != 1) { idx = count - 1; finished = 1; loop = 0; }
                            }
                            #delete[a3f];
                        }
                        #delete[cmp];
                    }
                    #delete[loop];
                    cssc::poke32(a1 + 20, idx);
                    cssc::poke64(a1 + 32, accB);
                    cssc::poke32(a1 + 44, finished);
                    #delete[dms]; #delete[th]; #delete[dsec]; #delete[acc2];
                    #delete[onef]; #delete[step];
                    #delete[count]; #delete[fpsB]; #delete[accB]; #delete[idx]; #delete[looping];
                }
                #delete[finished];
            }
            if (mAd == 1) {
                #stack[int, 64] sheet = cssc::peek64(a1 + 0);
                #stack[int, 64] frames = cssc::peek64(a1 + 8);
                #stack[int, 64] idx = cssc::peek32(a1 + 20);
                #stack[int, 64] fr = cssc::peek32(frames + idx * 4);
                ciSheetDrawFrame(sheet, a2, a3, a4, fr);
                #delete[sheet]; #delete[frames]; #delete[idx]; #delete[fr];
            }
            if (mAr == 1) {
                cssc::poke32(a1 + 20, 0);
                cssc::iToF(0) z;
                cssc::poke64(a1 + 32, z);
                cssc::poke32(a1 + 44, 0);
                #delete[z];
            }
        }
        if (w1 == 1) { cssc::free(a1); }
        if (w2 == 1) { cssc::free(a2); }
        if (w3 == 1) { cssc::free(a3); }
        if (w4 == 1) { cssc::free(a4); }
        if (w5 == 1) { cssc::free(a5); }
        if (w6 == 1) { cssc::free(a6); }
        if (ciCur == 13) { ciAdvance(); }
        #delete[a1]; #delete[a2]; #delete[a3]; #delete[a4]; #delete[a5]; #delete[a6];
        #delete[w1]; #delete[w2]; #delete[w3]; #delete[w4]; #delete[w5]; #delete[w6];
        #delete[n];
    }
    if (isVoid == 0) {
        ciExpr(0) r;
        #stack[int, 64] rt = ciEvalType;
        #stack[int, 64] ro = ciEvalOwns;
        #stack[int, 32] bound = 0;
        if (ciCur == 2) {
            #stack[int, 64] cno = ciTokOff;
            #stack[int, 64] cnl = ciTokLen;
            ciAdvance();
            if (ciExec == 1) { ciVarSet(cno, cnl, r, rt, ro); bound = 1; }
            #delete[cno]; #delete[cnl];
        }
        if (bound == 0) {
            if (ro == 1) { ciValFree(rt, r); }
        }
        #delete[bound]; #delete[r]; #delete[rt]; #delete[ro];
        if (ciCur == 13) { ciAdvance(); }
    }
    #delete[isVoid];
    #delete[mSp]; #delete[mSk]; #delete[mCl]; #delete[mDr]; #delete[mDs]; #delete[mDt];
    #delete[mDa]; #delete[mDf]; #delete[mSd]; #delete[mAu]; #delete[mAd]; #delete[mAr];
    #delete[moff]; #delete[mlen]; #delete[ccp]; #delete[o]; #delete[l];
}

#define(ciDoTilemap) {
    #req[ciCur] ciCur;
    #req[ciTokOff] ciTokOff;
    #req[ciTokLen] ciTokLen;
    #req[ciExec] ciExec;
    #req[ciIdentIs] ciIdentIs;
    #req[ciAdvance] ciAdvance;
    #req[ciExpr] ciExpr;
    #req[ciEvalOwns] ciEvalOwns;
    #req[ciEvalType] ciEvalType;
    #req[ciTokHasCC] ciTokHasCC;
    #req[ciVarSet] ciVarSet;
    #req[ciValFree] ciValFree;
    #req[ciTmDraw] ciTmDraw;
    #req[ciVecSize] ciVecSize;
    #req[ciVecGet] ciVecGet;
    #stack[int, 64] o = ciTokOff;
    #stack[int, 64] l = ciTokLen;
    ciTokHasCC(o, l) ccp;
    #stack[int, 64] moff = o;
    #stack[int, 64] mlen = l;
    if (ccp >= 0) { moff = o + ccp + 2; mlen = l - ccp - 2; }
    ciIdentIs(moff, mlen, "setTile") mSt;
    ciIdentIs(moff, mlen, "fill") mFi;
    ciIdentIs(moff, mlen, "setSolid") mSs;
    ciIdentIs(moff, mlen, "setLayout") mSl;
    ciIdentIs(moff, mlen, "draw") mDrw;
    ciIdentIs(moff, mlen, "cameraSet") mCs;
    ciIdentIs(moff, mlen, "cameraMove") mCm;
    ciIdentIs(moff, mlen, "cameraFollow") mCf;
    ciIdentIs(moff, mlen, "cameraSetBounds") mCb;
    #stack[int, 32] isVoid = 0;
    if (mSt == 1) { isVoid = 1; }
    if (mFi == 1) { isVoid = 1; }
    if (mSs == 1) { isVoid = 1; }
    if (mSl == 1) { isVoid = 1; }
    if (mDrw == 1) { isVoid = 1; }
    if (mCs == 1) { isVoid = 1; }
    if (mCm == 1) { isVoid = 1; }
    if (mCf == 1) { isVoid = 1; }
    if (mCb == 1) { isVoid = 1; }
    if (isVoid == 1) {
        ciAdvance();
        if (ciCur == 9) { ciAdvance(); }
        #stack[int, 64] a1 = 0; #stack[int, 64] a2 = 0; #stack[int, 64] a3 = 0;
        #stack[int, 64] a4 = 0; #stack[int, 64] a5 = 0;
        #stack[int, 64] w1 = 0; #stack[int, 64] w2 = 0; #stack[int, 64] w3 = 0;
        #stack[int, 64] w4 = 0; #stack[int, 64] w5 = 0;
        #stack[int, 32] n = 0;
        #stack[int, 32] go = 1;
        while (go == 1) {
            if (ciCur == 10) { go = 0; }
            if (ciCur == 0) { go = 0; }
            if (go == 1) {
                ciExpr(0) e;
                #stack[int, 64] eo = ciEvalOwns;
                if (n == 0) { a1 = e; w1 = eo; }
                if (n == 1) { a2 = e; w2 = eo; }
                if (n == 2) { a3 = e; w3 = eo; }
                if (n == 3) { a4 = e; w4 = eo; }
                if (n == 4) { a5 = e; w5 = eo; }
                n = n + 1;
                #delete[eo]; #delete[e];
                if (ciCur == 21) { ciAdvance(); }
                if (n >= 5) { go = 0; }
            }
        }
        #delete[go];
        if (ciCur == 10) { ciAdvance(); }
        if (ciExec == 1) {
            if (mSt == 1) {
                #stack[int, 64] cols = cssc::peek32(a1 + 8);
                #stack[int, 64] rows = cssc::peek32(a1 + 12);
                #stack[int, 64] data = cssc::peek64(a1 + 24);
                if (a2 >= 0) { if (a3 >= 0) { if (a2 < cols) { if (a3 < rows) {
                    cssc::poke32(data + (a3 * cols + a2) * 4, a4);
                } } } }
                #delete[cols]; #delete[rows]; #delete[data];
            }
            if (mFi == 1) {
                cssc::memfill32(cssc::peek64(a1 + 24), a2, cssc::peek32(a1 + 8) * cssc::peek32(a1 + 12));
            }
            if (mSs == 1) {
                #stack[int, 64] solids = cssc::peek64(a1 + 32);
                #stack[int, 64] sv = 1;
