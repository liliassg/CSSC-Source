    #delete[done];
}

#define(ciRun) {
    #scanp(ciRun, int, 0) buf;
    #scanp(ciRun, int, 1) len;
    #req[ciSrc] ciSrc;
    #req[ciSrcLen] ciSrcLen;
    #req[ciPos] ciPos;
    #req[ciCur] ciCur;
    #req[ciVCount] ciVCount;
    #req[ciVVals] ciVVals;
    #req[ciVTypes] ciVTypes;
    #req[ciVOwns] ciVOwns;
    #req[ciExec] ciExec;
    #req[ciScopeBase] ciScopeBase;
    #req[ciFnCount] ciFnCount;
    #req[ciSignal] ciSignal;
    #req[ciSecCount] ciSecCount;
    #req[ciCurSecOff] ciCurSecOff;
    #req[ciCurSecLen] ciCurSecLen;
    #req[ciSecInit] ciSecInit;
    #req[ciSecVis] ciSecVis;
    #req[ciBindVis] ciBindVis;
    #req[ciBindBits] ciBindBits;
    #req[ciSetMode] ciSetMode;
    #req[ciObjCount] ciObjCount;
    #req[ciLabCount] ciLabCount;
    #req[ciCurInst] ciCurInst;
    #req[ciCurObj] ciCurObj;
    #req[ciObjInit] ciObjInit;
    #req[ciMirrored] ciMirrored;
    #req[ciInstFree] ciInstFree;
    #req[ciValFree] ciValFree;
    #req[ciAdvance] ciAdvance;
    #req[ciStmt] ciStmt;
    #req[ciModVideo] ciModVideo;
    #req[ciModSound] ciModSound;
    #req[ciModIni] ciModIni;
    #req[ciModStdio] ciModStdio;
    #req[ciModKey] ciModKey;
    #req[ciModSprite] ciModSprite;
    #req[ciModTilemap] ciModTilemap;
    #req[ciModFont] ciModFont;
    #req[ciModMathAccel] ciModMathAccel;
    #req[ciModCsscMath] ciModCsscMath;
    #req[ciModConsole] ciModConsole;
    #req[ciModDev] ciModDev;
    #req[ciModGrace] ciModGrace;
    #req[ciModStdout] ciModStdout;
    #req[ciModMouse] ciModMouse;
    #req[ciMsCurr] ciMsCurr;
    #req[ciMsPrev] ciMsPrev;
    #req[ciDevStdout] ciDevStdout;
    #req[ciFaultMsg] ciFaultMsg;
    #req[ciFaultKind] ciFaultKind;
    #req[ciAlCount] ciAlCount;
    #req[ciDefLoaded] ciDefLoaded;
    #req[ciSndSlots] ciSndSlots;
    #req[ciSndNextId] ciSndNextId;
    #req[ciSndVolume] ciSndVolume;
    #req[ciKbCurr] ciKbCurr;
    #req[ciKbPrev] ciKbPrev;
    #req[ciKbEdge] ciKbEdge;
    #req[ciKbTail] ciKbTail;
    #req[ciKbExt] ciKbExt;
    #req[keyHead] keyHead;
    #req[ciSrcBuf] ciSrcBuf;
    #req[ciSrcUsed] ciSrcUsed;
    #req[ciMainEnd] ciMainEnd;
    #req[ciLoadCount] ciLoadCount;
    #req[ciTokOff] ciTokOff;
    #req[ciTokCount] ciTokCount;
    #req[ciTokenize] ciTokenize;

    #stack[int, 32] pi = 0;
    while (pi < ciVCount) {
        #stack[int, 64] pt = cssc::peek64(ciVTypes + pi * 8);
        #stack[int, 64] po = cssc::peek64(ciVOwns + pi * 8);
        #stack[int, 64] pv = cssc::peek64(ciVVals + pi * 8);
        if (po == 1) { ciValFree(pt, pv); }
        #delete[pt];
        #delete[po];
        #delete[pv];
        pi = pi + 1;
    }
    #delete[pi];

    #stack[int, 64] clen = len;
    if (clen > 524288) { clen = 524288; }
    #stack[int, 32] cci = 0;
    while (cci < clen) {
        cssc::poke8(ciSrcBuf + cci, cssc::peek8(buf + cci));
        cci = cci + 1;
    }
    #delete[cci];
    ciSrc = ciSrcBuf;
    ciSrcLen = clen;
    ciMainEnd = clen;
    ciSrcUsed = clen;
    ciLoadCount = 0;
    #delete[clen];

    ciTokCount = 0;
    ciPos = 0;
    ciTokenize();
    ciPos = 0;
    ciVCount = 0;
    ciExec = 1;

    ciScopeBase = 0;
    ciFnCount = 0;
    ciSignal = 0;
    ciSecCount = 0;
    ciCurSecOff = 0;
    ciCurSecLen = 0;
    ciSecInit = 0;
    ciSecVis = 0;
    ciBindVis = 1;
    ciBindBits = 64;
    ciSetMode = 0;
    ciObjCount = 0;
    ciLabCount = 0;

    ciModVideo = 0;
    ciModSound = 0;
    ciModIni = 0;
    ciModStdio = 0;
    ciModKey = 0;
    ciModSprite = 0;
    ciModTilemap = 0;
    ciModFont = 0;
    ciModMathAccel = 0;
    ciModCsscMath = 0;

    ciModConsole = 0;
    ciModDev = 0;
    ciModGrace = 0;
    ciModStdout = 0;
    ciModMouse = 0;
    ciMsCurr = 0;
    ciMsPrev = 0;
    if (ciDevStdout != 0) { ciValFree(4, ciDevStdout); ciDevStdout = 0; }
    if (ciFaultMsg != 0) { cssc::free(ciFaultMsg); ciFaultMsg = 0; }
    ciFaultKind = 0;
    ciDefLoaded = 0;
    ciAlCount = 0;

    ciSndNextId = 0;
    ciSndVolume = 100;
    cssc::memfill32(ciSndSlots, 0, 128);
    cssc::memfill32(ciKbCurr, 0, 64);
    cssc::memfill32(ciKbPrev, 0, 64);
    cssc::memfill32(ciKbEdge, 0, 64);
    ciKbTail = keyHead;
    ciKbExt = 0;
    cssc::outb(0x61, cssc::band(cssc::inb(0x61), 252));
    ciCurInst = 0;
    ciCurObj = 0;
    ciObjInit = 0;
    ciMirrored = 0;
    ciAdvance();
    #stack[int, 32] go = 1;
    while (go == 1) {
        if (ciCur == 0) { go = 0; }

        if (ciTokOff >= ciMainEnd) { go = 0; }

        if (ciSignal == 2) { go = 0; }
        if (ciSignal >= 3) { ciSignal = 0; }
        if (go == 1) {
            ciStmt();
        }
    }
    #delete[go];
}