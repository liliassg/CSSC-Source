#define(ciDoAssign) {
    #scanp(ciDoAssign, int, 0) o;
    #scanp(ciDoAssign, int, 1) l;
    #req[ciCur] ciCur;
    #req[ciExec] ciExec;
    #req[ciEvalType] ciEvalType;
    #req[ciEvalOwns] ciEvalOwns;
    #req[ciSetMode] ciSetMode;
    #req[ciAdvance] ciAdvance;
    #req[ciExpr] ciExpr;
    #req[ciVarSet] ciVarSet;
    #req[ciVarGet] ciVarGet;
    #req[ciStrConcat] ciStrConcat;

    if (ciCur == 14) {
        ciAdvance();
        ciExpr(0) v;
        #stack[int, 64] vt = ciEvalType;
        #stack[int, 64] vo = ciEvalOwns;
        if (ciExec == 1) {

            ciSetMode = 1;
            ciVarSet(o, l, v, vt, vo);
            ciSetMode = 0;
        }
        if (ciExec == 0) {

            if (vo == 1) { if (vt == 1) { cssc::free(v); } }
        }
        #delete[v];
        #delete[vt];
        #delete[vo];
    }

    if (ciCur == 4) {
        ciAdvance();
        if (ciCur == 4) {
            ciAdvance();
            if (ciExec == 1) {
                ciVarGet(o, l) cur;
                #stack[int, 64] ct = ciEvalType;
                #stack[int, 64] nv = cur + 1;
                if (ct == 2) { nv = cssc::fAdd(cur, cssc::iToF(1)); }
                ciVarSet(o, l, nv, ct, 0);
                #delete[nv];
                #delete[ct];
                #delete[cur];
            }
        }
        if (ciCur == 14) {
            ciAdvance();
            ciExpr(0) rhs;
            #stack[int, 64] rt = ciEvalType;
            #stack[int, 64] ro = ciEvalOwns;
            if (ciExec == 1) {
                ciVarGet(o, l) cur;
