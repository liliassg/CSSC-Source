            if (et == 1) {
                ciStrClone(raw) cr;
                r = cr;
                #delete[cr];
            }
            if (et != 1) { r = raw; }
            #delete[raw];
            #delete[d];
        }
    }
    #delete[et];
    #delete[size];
    return r;
}
#define(ciVecSet) {
    #scanp(ciVecSet, int, 0) h;
