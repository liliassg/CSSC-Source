                #stack[int, 64] oBodyS = 0;
                #stack[int, 64] oBodyE = 0;
                #stack[int, 64] oTopE = 0;
                if (ciCur == 11) {
                    oBodyS = ciPos;
                    #stack[int, 32] dep2 = 1;
                    #stack[int, 32] sc2 = 1;
                    while (sc2 == 1) {
                        ciAdvance();
                        if (ciCur == 0) { sc2 = 0; }
                        if (sc2 == 1) {
                            if (dep2 == 1) {
                                if (ciCur == 2) {

                                    #stack[int, 64] lo = ciTokOff;
                                    #stack[int, 64] ll = ciTokLen;
                                    ciAdvance();
                                    #stack[int, 64] lps = 0;
                                    #stack[int, 32] isLab = 0;
                                    if (ciCur == 31) { isLab = 1; }
                                    if (ciCur == 17) {

                                        lps = ciPos;
                                        ciAdvance();
                                        #stack[int, 32] lsk = 1;
                                        while (lsk == 1) {
                                            if (ciCur == 18) { lsk = 0; }
                                            if (ciCur == 0) { lsk = 0; }
                                            if (lsk == 1) {
                                                #stack[int, 32] shape = 0;
                                                if (ciCur == 2) { shape = 1; }
                                                if (ciCur == 31) { shape = 1; }
                                                if (ciCur == 21) { shape = 1; }
                                                if (ciCur == 30) { shape = 1; }
                                                if (ciCur == 6) { shape = 1; }
                                                if (shape == 0) { lsk = 0; lps = 0; }
                                                if (shape == 1) { ciAdvance(); }
                                                #delete[shape];
                                            }
                                        }
                                        if (lps > 0) {
                                            if (ciCur == 18) { ciAdvance(); }
                                            if (ciCur == 31) { isLab = 1; }
                                        }
                                        #delete[lsk];
                                    }

                                    if (isLab == 1) {
                                        ciIdentIs(lo, ll, "public") opub;
                                        ciIdentIs(lo, ll, "private") opriv;
                                        if (opub == 1) { isLab = 0; }
                                        if (opriv == 1) { isLab = 0; }
                                        #delete[opub];
                                        #delete[opriv];
                                    }
                                    if (isLab == 1) {

                                        if (lastLab >= 0) {
                                            cssc::poke64(ciLabBodyE + lastLab * 8, lo);
                                        }
                                        if (lastLab < 0) { oTopE = lo; }
                                        if (reg == 1) {
                                            if (ciLabCount < 256) {
                                                cssc::poke64(ciLabObj + ciLabCount * 8, oi);
                                                cssc::poke64(ciLabNameOff + ciLabCount * 8, lo);
                                                cssc::poke64(ciLabNameLen + ciLabCount * 8, ll);
                                                cssc::poke64(ciLabParS + ciLabCount * 8, lps);
                                                cssc::poke64(ciLabBodyS + ciLabCount * 8, ciPos);
                                                lastLab = ciLabCount;
                                                ciLabCount = ciLabCount + 1;
                                            }
                                        }
                                    }
                                    #delete[isLab];
                                    #delete[lps];
                                    #delete[lo];
                                    #delete[ll];
                                }
                            }

                            if (ciCur == 11) { dep2 = dep2 + 1; }
                            if (ciCur == 12) {
                                dep2 = dep2 - 1;
                                if (dep2 == 0) { sc2 = 0; }
                            }
                        }
                    }
                    #delete[sc2];
                    #delete[dep2];
                    oBodyE = ciPos;

                    #stack[int, 64] endOff = ciPos - 1;
                    if (lastLab >= 0) {
                        cssc::poke64(ciLabBodyE + lastLab * 8, endOff);
                    }
                    if (oTopE == 0) { oTopE = endOff; }
                    #delete[endOff];
                    if (ciCur == 12) { ciAdvance(); }
                }

                #stack[int, 64] oFreeS = 0;
                #stack[int, 64] oFreeE = 0;
                if (ciCur == 2) {
                    #stack[int, 64] fko2 = ciTokOff;
                    #stack[int, 64] fkl2 = ciTokLen;
                    ciIdentIs(fko2, fkl2, "free") isfb2;
                    if (isfb2 == 1) {
                        ciAdvance();
                        if (ciCur == 11) {
                            oFreeS = ciPos;
                            #stack[int, 32] dep4 = 1;
                            #stack[int, 32] sc4 = 1;
                            while (sc4 == 1) {
                                ciAdvance();
                                if (ciCur == 0) { sc4 = 0; }
                                if (ciCur == 11) { dep4 = dep4 + 1; }
                                if (ciCur == 12) {
                                    dep4 = dep4 - 1;
                                    if (dep4 == 0) { sc4 = 0; }
                                }
                            }
                            #delete[sc4];
                            #delete[dep4];
                            oFreeE = ciPos;
                            if (ciCur == 12) { ciAdvance(); }
                        }
                    }
                    #delete[isfb2];
                    #delete[fko2];
                    #delete[fkl2];
                }
                if (ciCur == 13) { ciAdvance(); }
                if (reg == 1) {
                    cssc::poke64(ciObjNameOff + oi * 8, ono);
                    cssc::poke64(ciObjNameLen + oi * 8, onl);
                    cssc::poke64(ciObjParS + oi * 8, oParS);
                    cssc::poke64(ciObjBodyS + oi * 8, oBodyS);
                    cssc::poke64(ciObjBodyE + oi * 8, oBodyE);
                    cssc::poke64(ciObjTopE + oi * 8, oTopE);
                    cssc::poke64(ciObjFreeS + oi * 8, oFreeS);
                    cssc::poke64(ciObjFreeE + oi * 8, oFreeE);
                    ciObjCount = ciObjCount + 1;
                }
                #delete[oFreeS];
                #delete[oFreeE];
                #delete[oBodyS];
                #delete[oBodyE];
                #delete[oTopE];
                #delete[lastLab];
                #delete[oi];
                #delete[reg];
                #delete[oParS];
                #delete[ono];
                #delete[onl];
                h = 1;
            }
        }
        if (kif == 1) {

            ciAdvance();
            if (ciCur == 9) { ciAdvance(); }
            ciExpr(0) c;
            if (ciCur == 10) { ciAdvance(); }
            #stack[int, 64] se = ciExec;

            #stack[int, 32] tookAny = 0;
            if (c != 0) { if (se == 1) { tookAny = 1; } }
            if (tookAny == 1) { ciExec = 1; }
            if (tookAny == 0) { ciExec = 0; }
            ciStmt();
            ciExec = se;

            #stack[int, 32] chaining = 1;
            while (chaining == 1) {
                #stack[int, 32] iselse = 0;
                if (ciCur == 2) {
                    #stack[int, 64] eo = ciTokOff;
                    #stack[int, 64] el = ciTokLen;
                    ciIdentIs(eo, el, "else") ie;
                    if (ie == 1) { iselse = 1; }
                    #delete[ie];
                    #delete[eo];
                    #delete[el];
                }
                if (iselse == 0) { chaining = 0; }
                if (iselse == 1) {
                    ciAdvance();

                    #stack[int, 32] iseif = 0;
                    if (ciCur == 2) {
                        #stack[int, 64] fo = ciTokOff;
                        #stack[int, 64] fl = ciTokLen;
                        ciIdentIs(fo, fl, "if") iif;
                        if (iif == 1) { iseif = 1; }
                        #delete[iif];
                        #delete[fo];
                        #delete[fl];
                    }
                    if (iseif == 1) {
                        ciAdvance();
                        if (ciCur == 9) { ciAdvance(); }
                        ciExpr(0) c2;
                        if (ciCur == 10) { ciAdvance(); }
                        #stack[int, 32] run2 = 0;
                        if (tookAny == 0) { if (c2 != 0) { if (se == 1) { run2 = 1; } } }
                        if (run2 == 1) { ciExec = 1; tookAny = 1; }
                        if (run2 == 0) { ciExec = 0; }
                        ciStmt();
                        ciExec = se;
                        #delete[run2];
                        #delete[c2];
                    }
                    if (iseif == 0) {

                        #stack[int, 32] run2 = 0;
                        if (tookAny == 0) { if (se == 1) { run2 = 1; } }
                        if (run2 == 1) { ciExec = 1; tookAny = 1; }
                        if (run2 == 0) { ciExec = 0; }
                        ciStmt();
                        ciExec = se;
                        chaining = 0;
                        #delete[run2];
                    }
                    #delete[iseif];
                }
                #delete[iselse];
            }
            #delete[chaining];
            #delete[tookAny];
            #delete[se];
            #delete[c];
            h = 1;
        }
        if (h == 0) {
            if (kwh == 1) {
                ciAdvance();
                #stack[int, 64] condPos = ciPos;
                #stack[int, 64] se = ciExec;
                #stack[int, 32] looping = 1;
                while (looping == 1) {
                    ciPos = condPos;
                    ciAdvance();
                    if (ciCur == 9) { ciAdvance(); }
                    ciExpr(0) c;
                    if (ciCur == 10) { ciAdvance(); }
                    #stack[int, 32] rb = 0;
                    if (c != 0) { if (se == 1) { rb = 1; } }
                    if (rb == 1) { ciExec = 1; ciStmt(); }
                    if (rb == 0) { ciExec = 0; ciStmt(); looping = 0; }
                    ciExec = se;

                    if (ciSignal == 4) { ciSignal = 0; looping = 0; }
                    if (ciSignal == 5) { ciSignal = 0; }
                    if (ciSignal >= 2) { looping = 0; }
                    #delete[rb];
                    #delete[c];
                }
                #delete[looping];
                #delete[se];
                #delete[condPos];
                h = 1;
            }
        }

        if (h == 0) {
            if (kfor == 1) {
                ciAdvance();
                if (ciCur == 9) { ciAdvance(); }
                #stack[int, 64] se = ciExec;

                #stack[int, 32] forDecl = 0;
                #stack[int, 64] fdType = 0;
                if (ciCur == 2) {
                    ciIdentIs(ciTokOff, ciTokLen, "int") fki;
                    ciIdentIs(ciTokOff, ciTokLen, "float") fkf;
                    ciIdentIs(ciTokOff, ciTokLen, "string") fks;
                    ciIdentIs(ciTokOff, ciTokLen, "bool") fkb;
                    ciIdentIs(ciTokOff, ciTokLen, "auto") fka;
                    if (fki == 1) { forDecl = 1; fdType = 0; }
                    if (fkf == 1) { forDecl = 1; fdType = 2; }
                    if (fks == 1) { forDecl = 1; fdType = 1; }
                    if (fkb == 1) { forDecl = 1; fdType = 0; }
                    if (fka == 1) { forDecl = 1; fdType = 0; }
                    #delete[fki];
                    #delete[fkf];
                    #delete[fks];
                    #delete[fkb];
                    #delete[fka];
                }
                if (forDecl == 1) {
                    ciAdvance();
                    #stack[int, 64] fno = ciTokOff;
                    #stack[int, 64] fnl = ciTokLen;
                    ciAdvance();
                    #stack[int, 64] fv  = 0;
                    #stack[int, 64] fvt = fdType;
                    #stack[int, 64] fvo = 0;
                    if (ciCur == 14) {
                        ciAdvance();
                        ciExpr(0) fe;
                        fv  = fe;
                        fvt = ciEvalType;
                        fvo = ciEvalOwns;
                        #delete[fe];
                    }
                    if (ciExec == 1) {
                        ciSetMode = 0;
                        ciVarSet(fno, fnl, fv, fvt, fvo);
                    }
                    if (ciExec == 0) {
                        if (fvo == 1) { if (fvt == 1) { cssc::free(fv); } }
                    }
                    if (ciCur == 13) { ciAdvance(); }
                    #delete[fv];
                    #delete[fvt];
                    #delete[fvo];
                    #delete[fno];
                    #delete[fnl];
                }
                if (forDecl == 0) {
                    ciStmt();
                }
                #delete[forDecl];
                #delete[fdType];
                #stack[int, 64] condPos = ciPos - 1;
                #stack[int, 64] svx = ciExec;
                ciExec = 0;
                ciExpr(0) cskip;
                #delete[cskip];
                ciExec = svx;
                #delete[svx];
                if (ciCur == 13) { ciAdvance(); }
                #stack[int, 64] postPos = ciPos - 1;

                #stack[int, 64] pdepth = 0;
                #stack[int, 32] psc = 1;
                while (psc == 1) {
                    if (ciCur == 0) { psc = 0; }
                    if (ciCur == 9) { pdepth = pdepth + 1; }
                    if (ciCur == 10) {
                        if (pdepth == 0) { psc = 0; }
                        if (pdepth > 0) { pdepth = pdepth - 1; }
                    }
                    if (psc == 1) { ciAdvance(); }
                }
                #delete[psc];
                #delete[pdepth];
                if (ciCur == 10) { ciAdvance(); }
                #stack[int, 64] bodyPos = ciPos - 1;
                #stack[int, 32] looping = 1;
                while (looping == 1) {
                    ciPos = condPos;
                    ciAdvance();
                    ciExpr(0) c;
                    #stack[int, 32] rb = 0;
                    if (c != 0) { if (se == 1) { rb = 1; } }
                    #delete[c];
                    if (rb == 1) {
                        ciPos = bodyPos;
                        ciAdvance();
                        ciExec = 1;
                        ciStmt();
                        #stack[int, 32] didBrk = 0;
                        if (ciSignal == 5) { ciSignal = 0; }
                        if (ciSignal == 4) { ciSignal = 0; looping = 0; didBrk = 1; }
                        if (ciSignal == 2) { looping = 0; didBrk = 1; }
                        if (ciSignal == 3) { looping = 0; didBrk = 1; }
                        if (didBrk == 0) {
                            ciPos = postPos;
                            ciAdvance();
                            ciExec = 1;
                            ciStmt();
                        }
                        #delete[didBrk];
                    }
                    if (rb == 0) {
                        ciPos = bodyPos;
                        ciAdvance();
                        ciExec = 0;
                        ciStmt();
                        looping = 0;
                    }
                    ciExec = se;
                    #delete[rb];
                }
                #delete[looping];
                #delete[bodyPos];
                #delete[postPos];
                #delete[condPos];
                #delete[se];
                h = 1;
            }
        }

        if (h == 0) {
            if (ksel == 1) {
                ciAdvance();
                if (ciCur == 9) { ciAdvance(); }
                ciExpr(0) ih;
                #stack[int, 64] it    = ciEvalType;
                #stack[int, 64] ownIt = ciEvalOwns;
                if (ciCur == 10) { ciAdvance(); }
                if (ciCur == 32) { ciAdvance(); }
                #stack[int, 64] labOff  = ciTokOff;
                #stack[int, 64] labLen  = ciTokLen;
                #stack[int, 64] bodyPos = ciPos;
                if (ciCur == 2) { ciAdvance(); }

                #stack[int, 64] count = 0;
                if (it == 4) { ciVecSize(ih) rvs; count = rvs; #delete[rvs]; }
                if (it == 5) { ciMapSize(ih) rms; count = rms; #delete[rms]; }
                if (it == 1) { count = cssc::peek32(ih + 4); }
                if (it == 7) {
                    ciBindPairs(ih) rbp;
                    ciBindWidth(ih) rbw;
                    count = rbp * rbw;
                    #delete[rbp];
                    #delete[rbw];
                }

                #stack[int, 64] svCur = ciSelCursor; #stack[int, 64] svIn = ciInSelect;
                #stack[int, 64] svLO  = ciSelLabOff; #stack[int, 64] svLL = ciSelLabLen;
                ciSelLabOff = labOff;
                ciSelLabLen = labLen;

                #stack[int, 64] se = ciExec;
                #stack[int, 64] cursor  = 0;
                #stack[int, 64] maxIter = count * 1000;
                if (maxIter < 100000) { maxIter = 100000; }
                #stack[int, 64] iters = 0;
                #stack[int, 32] looping = 1;
                if (se == 0) { looping = 0; }

                while (looping == 1) {
                    #stack[int, 32] inb = 0;
                    if (cursor >= 0) { if (cursor < count) { inb = 1; } }
                    if (inb == 0) { looping = 0; }
                    if (inb == 1) { iters = iters + 1; if (iters > maxIter) { looping = 0; } }
                    if (looping == 1) {
                        #stack[int, 64] ev = 0;
                        #stack[int, 64] et = 0;
                        #stack[int, 64] eo = 0;
                        if (it == 4) {
                            ciVecGet(ih, cursor) rvg; ev = rvg; #delete[rvg];
                            ciVecType(ih) rvt; et = rvt; #delete[rvt];
                            if (et == 1) { eo = 1; }
                        }
                        if (it == 5) {
                            #stack[int, 64] d  = cssc::peek64(ih + 16);
                            #stack[int, 64] vt = cssc::peek64(d + cursor * 32 + 16);
                            #stack[int, 64] vv = cssc::peek64(d + cursor * 32 + 24);
                            et = vt;
                            if (vt == 1) { ciStrClone(vv) cc; ev = cc; eo = 1; #delete[cc]; }
                            if (vt != 1) { ev = vv; }
                            #delete[d];
                            #delete[vt];
                            #delete[vv];
                        }
                        if (it == 7) {
                            ciBindCellGet(ih, cursor) rbc; ev = rbc; #delete[rbc];
                            et = ciBindCellRT;
                            if (et == 1) { eo = 1; }
                        }
                        if (it == 1) {
                            ciStrNew(ih + 8 + cursor, 1) rsn; ev = rsn; et = 1; eo = 1; #delete[rsn];
                        }
                        ciSelCursor = cursor;
                        ciSetMode = 0;
                        ciVarSet(labOff, labLen, ev, et, eo);
                        #delete[ev];
                        #delete[et];
                        #delete[eo];

                        ciPos = bodyPos;
                        ciAdvance();
                        ciSignal = 0;
                        ciInSelect = svIn + 1;
                        ciStmt();
                        ciInSelect = svIn;

                        #stack[int, 64] sig = ciSignal;
                        if (sig == 6) { cursor = cursor + ciSelDelta; ciSignal = 0; }
                        if (sig == 5) { cursor = cursor + 1;          ciSignal = 0; }
                        if (sig == 4) { ciSignal = 0; looping = 0; }
                        if (sig == 0) { looping = 0; }
                        if (sig == 2) { looping = 0; }
                        if (sig == 3) { looping = 0; }
                        #delete[sig];
                    }
                    #delete[inb];
                }

                if (ciSignal < 2) {
                    ciPos = bodyPos;
                    ciAdvance();
                    #stack[int, 64] se2 = ciExec;
                    ciExec = 0;
                    ciStmt();
                    ciExec = se2;
                    #delete[se2];
                }

                ciVarDrop(labOff, labLen);
                ciSelCursor = svCur;
                ciInSelect  = svIn;
                ciSelLabOff = svLO;
                ciSelLabLen = svLL;
                if (ownIt == 1) { if (it == 1) { cssc::free(ih); } }

                #delete[se];
                #delete[looping];
                #delete[iters];
                #delete[maxIter];
                #delete[cursor];
                #delete[count];
                #delete[svCur];
                #delete[svIn];
                #delete[svLO];
                #delete[svLL];
                #delete[ownIt];
                #delete[it];
                #delete[ih];
                #delete[labOff];
                #delete[labLen];
                #delete[bodyPos];
                h = 1;
            }
        }
        if (h == 0) { if (koln == 1) { ciDoPrint(); h = 1; } }
        if (h == 0) { if (kout == 1) { ciDoPrint(); h = 1; } }
        if (h == 0) { if (kp32 == 1) { ciDoPoke(); h = 1; } }
        if (h == 0) { if (kp8 == 1) { ciDoPoke(); h = 1; } }
        if (h == 0) {
            if (kkinj == 1) {
                ciAdvance();
                if (ciCur == 9) { ciAdvance(); }
                ciExpr(0) sc;
                if (ciCur == 10) { ciAdvance(); }
                if (ciExec == 1) {
                    cssc::poke8(keyBufAddr + keyHead % 256, sc);
                    keyHead = keyHead + 1;
                }
                if (ciCur == 13) { ciAdvance(); }
                #delete[sc];
                h = 1;
            }
        }
        if (h == 0) {
            if (kmset == 1) {
                ciAdvance();
                if (ciCur == 9) { ciAdvance(); }
                ciExpr(0) msx;
                if (ciCur == 21) { ciAdvance(); }
                ciExpr(0) msy;
                if (ciCur == 21) { ciAdvance(); }
                ciExpr(0) msf;
                if (ciCur == 10) { ciAdvance(); }
                if (ciExec == 1) {
                    mouseX = msx;
                    mouseY = msy;
                    mouseFlags = msf;
                }
                if (ciCur == 13) { ciAdvance(); }
                #delete[msx];
                #delete[msy];
                #delete[msf];
                h = 1;
            }
        }
        if (h == 0) {
            if (kfsw == 1) {
                ciAdvance();
                if (ciCur == 9) { ciAdvance(); }
                ciExpr(0) fwn;
                #stack[int, 64] fwno = ciEvalOwns;
                if (ciCur == 21) { ciAdvance(); }
                ciExpr(0) fwc;
                #stack[int, 64] fwco = ciEvalOwns;
                if (ciCur == 10) { ciAdvance(); }
                if (ciExec == 1) {
                    fsCreate(fwn + 8, cssc::peek32(fwn + 4));
                    if (fsIdx >= 0) {
                        fsStore(fsIdx, fwc + 8, cssc::peek32(fwc + 4));
                    }
                }
                if (fwno == 1) { cssc::free(fwn); }
                if (fwco == 1) { cssc::free(fwc); }
                if (ciCur == 13) { ciAdvance(); }
                #delete[fwn];
                #delete[fwno];
                #delete[fwc];
                #delete[fwco];
                h = 1;
            }
        }

        if (h == 0) {
            #stack[int, 32] kArr = 0;
            if (kapush == 1) { kArr = 1; }
            if (kaunsh == 1) { kArr = 1; }
            if (kapop == 1) { kArr = 1; }
            if (kashift == 1) { kArr = 1; }
            if (kasort == 1) { kArr = 1; }
            if (karev == 1) { kArr = 1; }
            if (kaslice == 1) { kArr = 1; }
            if (kaconc == 1) { kArr = 1; }
            if (kauniq == 1) { kArr = 1; }
            if (kaflat == 1) { kArr = 1; }
            if (karange == 1) { kArr = 1; }
            if (kazip == 1) { kArr = 1; }
            if (kafill == 1) { kArr = 1; }
            if (kamap == 1) { kArr = 1; }
            if (kafilt == 1) { kArr = 1; }
            if (kagidx == 1) { kArr = 1; }
            if (kafind == 1) { kArr = 1; }
            if (kacount == 1) { kArr = 1; }
            if (kasum == 1) { kArr = 1; }
            if (kaavg == 1) { kArr = 1; }
            if (kArr == 1) {
                ciExpr(0) ae;
                #stack[int, 64] aet = ciEvalType;
                #stack[int, 64] aeo = ciEvalOwns;
                if (ciCur == 13) { ciAdvance(); }
                if (aeo == 1) { ciValFree(aet, ae); }
                #delete[aet]; #delete[aeo]; #delete[ae];
                h = 1;
            }
            #delete[kArr];
        }

        if (h == 0) { if (ciModId == 1) { ciDoVideo(); h = 1; } }
        if (h == 0) { if (ciModId == 2) { ciDoSound(); h = 1; } }
        if (h == 0) { if (ciModId == 3) { ciDoKey(); h = 1; } }
        if (h == 0) { if (ciModId == 4) { ciDoIni(); h = 1; } }
        if (h == 0) { if (ciModId == 14) { ciDoStdio(); h = 1; } }
        if (h == 0) { if (ciModId == 5) { ciDoSprite(); h = 1; } }
        if (h == 0) { if (ciModId == 6) { ciDoTilemap(); h = 1; } }
        if (h == 0) { if (ciModId == 7) { ciDoFont(); h = 1; } }
        if (h == 0) { if (ciModId == 11) { ciDoMouse(); h = 1; } }

        if (h == 0) {
            if (ciModId == 10) {
                ciTokHasCC(o, l) gcc;
                #stack[int, 64] gmo = o;
                #stack[int, 64] gml = l;
                if (gcc >= 0) { gmo = o + gcc + 2; gml = l - gcc - 2; }
                ciIdentIs(gmo, gml, "catch") isCatch;
                ciAdvance();
                if (ciCur == 9) { ciAdvance(); }
                #stack[int, 64] gfn = 0 - 1;
                #stack[int, 64] gArgType = 0;
                #stack[int, 32] gCallable = 0;
