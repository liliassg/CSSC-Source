    #delete[i];
    return nv;
}
#define(ciVecSum) {
    #scanp(ciVecSum, int, 0) h;
    #stack[int, 64] et = cssc::peek32(h + 12);
    #stack[int, 64] size = cssc::peek32(h + 4);
    #stack[int, 64] d = cssc::peek64(h + 16);
    #stack[int, 64] acc = 0;
    if (et == 2) { cssc::iToF(0) z; acc = z; #delete[z]; }
    #stack[int, 64] i = 0;
    while (i < size) {
        #stack[int, 64] ev = cssc::peek64(d + i * 8);
        if (et == 2) { cssc::fAdd(acc, ev) tt; acc = tt; #delete[tt]; }
        if (et != 2) { acc = acc + ev; }
        #delete[ev]; i = i + 1;
    }
    #delete[i]; #delete[d]; #delete[size]; #delete[et];
    return acc;
}
#define(ciVecAvg) {
    #scanp(ciVecAvg, int, 0) h;
    #stack[int, 64] et = cssc::peek32(h + 12);
    #stack[int, 64] size = cssc::peek32(h + 4);
    #stack[int, 64] d = cssc::peek64(h + 16);
    #stack[int, 64] r = 0;
    if (size > 0) {
        #stack[int, 64] acc = 0;
        cssc::iToF(0) z; acc = z; #delete[z];
        #stack[int, 64] i = 0;
        while (i < size) {
            #stack[int, 64] ev = cssc::peek64(d + i * 8);
            #stack[int, 64] fv = ev;
            if (et != 2) { cssc::iToF(ev) c; fv = c; #delete[c]; }
            cssc::fAdd(acc, fv) tt; acc = tt; #delete[tt];
            #delete[fv]; #delete[ev]; i = i + 1;
        }
        cssc::iToF(size) fs;
        cssc::fDiv(acc, fs) q;
        r = q;
        #delete[q]; #delete[fs]; #delete[acc]; #delete[i];
    }
    #delete[et]; #delete[size]; #delete[d];
    return r;
}

#define(ciMapNew) {
    #stack[int, 64] cap = 8;
    #stack[int, 64] h = cssc::alloc(24);
    #stack[int, 64] d = cssc::alloc(cap * 32);
    cssc::memfill32(d, 0, cap * 8);
    cssc::poke32(h, 1);
    cssc::poke32(h + 4, 0);
    cssc::poke32(h + 8, cap);
    cssc::poke64(h + 16, d);
    #delete[d];
    #delete[cap];
    return h;
}
#define(ciMapSize) {
    #scanp(ciMapSize, int, 0) h;
    return cssc::peek32(h + 4);
}
#define(ciMapFind) {
    #scanp(ciMapFind, int, 0) h;
    #scanp(ciMapFind, int, 1) kt;
    #scanp(ciMapFind, int, 2) kv;
    #req[ciStrCmp] ciStrCmp;
    #stack[int, 64] size = cssc::peek32(h + 4);
    #stack[int, 64] d = cssc::peek64(h + 16);
    #stack[int, 64] i = 0;
    #stack[int, 64] res = 0 - 1;
    while (i < size) {
        if (res < 0) {
            #stack[int, 64] ekt = cssc::peek64(d + i * 32);
            #stack[int, 64] ekv = cssc::peek64(d + i * 32 + 8);
            #stack[int, 32] match = 0;
            if (ekt == kt) {
                if (kt == 1) {
                    ciStrCmp(ekv, kv) c;
                    if (c == 0) { match = 1; }
                    #delete[c];
                }
                if (kt != 1) {
                    if (ekv == kv) { match = 1; }
                }
            }
            if (match == 1) { res = i; }
            #delete[match];
            #delete[ekv];
            #delete[ekt];
        }
        i = i + 1;
    }
    #delete[i];
    #delete[d];
    #delete[size];
    return res;
}
#define(ciMapSet) {
    #scanp(ciMapSet, int, 0) h;
    #scanp(ciMapSet, int, 1) kt;
    #scanp(ciMapSet, int, 2) kv;
    #scanp(ciMapSet, int, 3) vt;
    #scanp(ciMapSet, int, 4) vv;
    #req[ciMapFind] ciMapFind;
    #req[ciStrClone] ciStrClone;
    ciMapFind(h, kt, kv) idx;
    #stack[int, 64] sv = vv;
    if (vt == 1) {
        ciStrClone(vv) cv;
        sv = cv;
        #delete[cv];
    }
    if (idx >= 0) {
        #stack[int, 64] d = cssc::peek64(h + 16);
        #stack[int, 64] ovt = cssc::peek64(d + idx * 32 + 16);
        if (ovt == 1) { cssc::free(cssc::peek64(d + idx * 32 + 24)); }
        cssc::poke64(d + idx * 32 + 16, vt);
        cssc::poke64(d + idx * 32 + 24, sv);
        #delete[ovt];
        #delete[d];
    }
    if (idx < 0) {
        #stack[int, 64] size = cssc::peek32(h + 4);
        #stack[int, 64] cap = cssc::peek32(h + 8);
        if (size >= cap) {
            #stack[int, 64] ncap = cap * 2;
            #stack[int, 64] nd = cssc::alloc(ncap * 32);
            #stack[int, 64] od = cssc::peek64(h + 16);
            cssc::memcopy(nd, od, size * 8);
            cssc::free(od);
            cssc::poke64(h + 16, nd);
            cssc::poke32(h + 8, ncap);
            #delete[od];
            #delete[nd];
            #delete[ncap];
        }
        #stack[int, 64] sk = kv;
        if (kt == 1) {
            ciStrClone(kv) ck;
            sk = ck;
            #delete[ck];
        }
        #stack[int, 64] d = cssc::peek64(h + 16);
        cssc::poke64(d + size * 32, kt);
        cssc::poke64(d + size * 32 + 8, sk);
        cssc::poke64(d + size * 32 + 16, vt);
        cssc::poke64(d + size * 32 + 24, sv);
        cssc::poke32(h + 4, size + 1);
        #delete[d];
        #delete[sk];
        #delete[size];
        #delete[cap];
    }
    #delete[sv];
    #delete[idx];
}
#define(ciMapGet) {
    #scanp(ciMapGet, int, 0) h;
