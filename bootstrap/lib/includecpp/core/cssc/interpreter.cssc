            if (rle < len) { if (cssc::peek8(buf + rle) == 10) { rle = rle + 1; } }
            #stack[int, 64] ce = ls;
            #stack[int, 32] fc = 0;
            while (fc == 0) {
                if (ce >= le) { fc = 1; }
                if (fc == 0) {
                    #stack[int, 64] ch = cssc::peek8(buf + ce);
                    if (ch == 59) { fc = 1; }
                    if (ch == 35) { fc = 1; }
                    #delete[ch];
                }
