        if (found < 0) {
            #stack[int, 64] a = cssc::peek8(ciSrc + off + i);
            if (a == 58) {
                #stack[int, 64] b = cssc::peek8(ciSrc + off + i + 1);
                if (b == 58) { found = i; }
                #delete[b];
            }
            #delete[a];
        }
        i = i + 1;
    }
    #delete[i];
    return found;
}

