                if (a2 >= 0) { if (a2 < 256) { cssc::poke8(solids + a2, sv); } }
                #delete[solids]; #delete[sv];
            }
            if (mSl == 1) {
                #stack[int, 64] cols = cssc::peek32(a1 + 8);
                #stack[int, 64] rows = cssc::peek32(a1 + 12);
                #stack[int, 64] data = cssc::peek64(a1 + 24);
                #stack[int, 64] cap = cols * rows;
                ciVecSize(a2) vs;
                #stack[int, 64] lim = vs;
                if (lim > cap) { lim = cap; }
                #stack[int, 64] i = 0;
                while (i < lim) {
                    ciVecGet(a2, i) gv;
                    cssc::poke32(data + i * 4, gv);
                    #delete[gv];
                    i = i + 1;
                }
                #delete[i]; #delete[lim]; #delete[vs];
