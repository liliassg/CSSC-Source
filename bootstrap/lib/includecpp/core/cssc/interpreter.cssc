            t1 = 0;
            if (ts < te) { ciIniWs(cssc::peek8(buf + ts)) w; if (w == 1) { ts = ts + 1; t1 = 1; } #delete[w]; }
        }
        #stack[int, 32] t2 = 1;
        while (t2 == 1) {
            t2 = 0;
            if (te > ts) { ciIniWs(cssc::peek8(buf + te - 1)) w; if (w == 1) { te = te - 1; t2 = 1; } #delete[w]; }
        }
        #delete[t1];
        #delete[t2];
        #stack[int, 32] isHdr = 0;
        #stack[int, 32] isTgtHdr = 0;
        #stack[int, 32] isMatchKey = 0;
        if (te > ts) {
            #stack[int, 64] first = cssc::peek8(buf + ts);
            if (first == 91) {
                isHdr = 1;
                ciIniSectMatch(buf, ts, te, sctP, sctL) sm;
                isTgtHdr = sm;
                #delete[sm];
            }
            if (first != 91) {
                if (inTarget == 1) {
                    #stack[int, 64] eq = ts;
                    #stack[int, 32] fq = 0;
                    while (fq == 0) {
                        if (eq >= te) { fq = 1; }
                        if (fq == 0) { if (cssc::peek8(buf + eq) == 61) { fq = 1; } }
                        if (fq == 0) { eq = eq + 1; }
                    }
                    #delete[fq];
                    if (eq < te) {
                        #stack[int, 64] ke = eq;
                        #stack[int, 32] kt = 1;
                        while (kt == 1) {
                            kt = 0;
                            if (ke > ts) { ciIniWs(cssc::peek8(buf + ke - 1)) w; if (w == 1) { ke = ke - 1; kt = 1; } #delete[w]; }
                        }
                        #delete[kt];
                        #stack[int, 64] kl2 = ke - ts;
                        if (kl2 == keyL) {
