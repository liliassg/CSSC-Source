    #stack[int, 64] count = cssc::peek32(ch + 28);
    #stack[int, 64] i = 0;
    while (i < count) {
        #stack[int, 64] lh = cssc::peek64(sl + i * 8);
        #stack[int, 64] tg = cssc::peek64(st + i * 8);
        #stack[int, 64] last = cssc::peek64(sn + i * 8);
        if (lh != 0) {
            #stack[int, 64] sz = cssc::peek32(lh + 4);
            #stack[int, 64] tglen = 0;
            if (tg != 0) { tglen = cssc::peek32(tg + 4); }
            #stack[int, 64] j = last;
            while (j < sz) {
                ciVecGet(lh, j) entry;
                #stack[int, 64] elen = 0;
                if (entry != 0) { elen = cssc::peek32(entry + 4); }
                #stack[int, 64] tot = tglen + elen + 4;
                #stack[int, 64] buf = cssc::alloc(tot);
                #stack[int, 64] p = 0;
                cssc::poke8(buf + p, 91);
                p = p + 1;
                #stack[int, 64] k = 0;
                while (k < tglen) {
                    cssc::poke8(buf + p, cssc::peek8(tg + 8 + k));
                    p = p + 1;
                    k = k + 1;
                }
                #delete[k];
                cssc::poke8(buf + p, 93);
                p = p + 1;
                cssc::poke8(buf + p, 32);
                p = p + 1;
                #stack[int, 64] k2 = 0;
                while (k2 < elen) {
                    cssc::poke8(buf + p, cssc::peek8(entry + 8 + k2));
                    p = p + 1;
                    k2 = k2 + 1;
                }
                #delete[k2];
                cssc::poke8(buf + p, 10);
                p = p + 1;
                ciConOut(ch, buf, p);
                cssc::free(buf);
                if (entry != 0) { cssc::free(entry); }
                #delete[p];
                #delete[buf];
                #delete[tot];
                #delete[elen];
                #delete[entry];
                j = j + 1;
            }
            #delete[j];
            cssc::poke64(sn + i * 8, sz);
            #delete[sz];
            #delete[tglen];
        }
        #delete[lh];
        #delete[tg];
        #delete[last];
        i = i + 1;
    }
    #delete[i];
    #delete[st];
    #delete[sl];
    #delete[sn];
    #delete[count];
}

