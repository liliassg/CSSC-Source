                            while (j < kl2) {
                                if (cssc::peek8(buf + ts + j) != cssc::peek8(keyP + j)) { km = 0; }
                                j = j + 1;
                            }
                            #delete[j];
                            if (km == 1) { isMatchKey = 1; }
                            #delete[km];
                        }
                        #delete[kl2];
                        #delete[ke];
                    }
                    #delete[eq];
                }
            }
            #delete[first];
        }
        if (isHdr == 1) {
            if (inTarget == 1) {
                if (wroteKey == 0) {
                    ciIniEmitKV(op, keyP, keyL, valP, valL, 1) o2;
                    op = o2;
                    wroteKey = 1;
                    #delete[o2];
                }
            }
            ciIniPut(op, buf + ls, rle - ls) o3;
            op = o3;
