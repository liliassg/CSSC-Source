    ciIdentIs(moff, mlen, "getY") mgy;
    ciIdentIs(moff, mlen, "isOver") mov;
    ciIdentIs(moff, mlen, "isClicked") mck;
    ciIdentIs(moff, mlen, "isHeld") mhl;
    ciIdentIs(moff, mlen, "isReleased") mrl;
    ciIdentIs(moff, mlen, "clampX") mcx;
    ciIdentIs(moff, mlen, "clampY") mcy;
    #stack[int, 64] res = 0;
    if (mgx == 1) { ciMsMapX() r; res = r; #delete[r]; }
    if (mgy == 1) { ciMsMapY() r; res = r; #delete[r]; }
    if (mov == 1) { ciMsOver(a1, a2, a3, a4) r; res = r; #delete[r]; }
    if (mck == 1) {
        ciMsBtnMask(a1) mask;
        #stack[int, 64] rr = 0;
        if (mask != 0) {
            #stack[int, 64] cu = cssc::band(ciMsCurr, mask);
            #stack[int, 64] pr = cssc::band(ciMsPrev, mask);
            if (cu > 0) { if (pr == 0) { rr = 1; } }
            #delete[cu];
            #delete[pr];
        }
        res = rr;
        #delete[mask];
        #delete[rr];
    }
    if (mrl == 1) {
        ciMsBtnMask(a1) mask;
        #stack[int, 64] rr = 0;
        if (mask != 0) {
            #stack[int, 64] cu = cssc::band(ciMsCurr, mask);
            #stack[int, 64] pr = cssc::band(ciMsPrev, mask);
            if (cu == 0) { if (pr > 0) { rr = 1; } }
