        #stack[int, 64] w = a2;
        if (w < 1) { w = 1; }
        #stack[int, 64] rr = mx;
        if (mx < a1) { rr = a1; }
        if (mx > a1 + w - 1) { rr = a1 + w - 1; }
        res = rr;
        #delete[mx];
        #delete[w];
        #delete[rr];
    }
    if (mcy == 1) {
        ciMsMapY() my;
        #stack[int, 64] h = a2;
        if (h < 1) { h = 1; }
        #stack[int, 64] rr = my;
        if (my < a1) { rr = a1; }
        if (my > a1 + h - 1) { rr = a1 + h - 1; }
        res = rr;
        #delete[my];
        #delete[h];
        #delete[rr];
    }
    #delete[mgx];
    #delete[mgy];
    #delete[mov];
    #delete[mck];
    #delete[mhl];
    #delete[mrl];
    #delete[mcx];
    #delete[mcy];
    return res;
}

