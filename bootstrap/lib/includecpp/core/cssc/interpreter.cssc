#define(ciBindRawSet) {
    #scanp(ciBindRawSet, int, 0) h;
    #scanp(ciBindRawSet, int, 1) idx;
    #scanp(ciBindRawSet, int, 2) type;
    #scanp(ciBindRawSet, int, 3) val;
    #req[ciStrClone] ciStrClone;
    #stack[int, 64] cap = cssc::peek32(h + 8);
    if (idx >= cap) {
        #stack[int, 64] ncap = cap * 2;
        while (ncap <= idx) { ncap = ncap * 2; }
        #stack[int, 64] nd = cssc::alloc(ncap * 16);
        #stack[int, 64] od = cssc::peek64(h + 16);
        cssc::memcopy(nd, od, cap * 4);

        cssc::memfill32(nd + cap * 16, 0, (ncap - cap) * 4);
        cssc::free(od);
        cssc::poke64(h + 16, nd);
        cssc::poke32(h + 8, ncap);
        #delete[od];
        #delete[nd];
        #delete[ncap];
    }
    #stack[int, 64] sv = val;
    if (type == 1) { ciStrClone(val) cx; sv = cx; #delete[cx]; }
    #stack[int, 64] d = cssc::peek64(h + 16);
    cssc::poke64(d + idx * 16, type);
    cssc::poke64(d + idx * 16 + 8, sv);
    #delete[d];
    #delete[sv];
    #delete[cap];
}
