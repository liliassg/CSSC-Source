    #stack[int, 32] mid = 1;
    if (p <= 0 - 1000) { cx = 0; mid = 0; }
    if (p >= 1000) { cx = w - 1; mid = 0; }
    if (mid == 1) {
        #stack[int, 64] pp = p;
        if (pp < 0) { pp = pp + 1000; }
        cx = pp * (w - 1) / 1000;
        if (cx < 0) { cx = 0; }
