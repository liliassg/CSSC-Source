}

#define(ciStrReplaceNew) {
    #scanp(ciStrReplaceNew, int, 0) sp;
    #scanp(ciStrReplaceNew, int, 1) oldp;
    #scanp(ciStrReplaceNew, int, 2) newp;
    #req[ciStrNew] ciStrNew;
    #req[ciStrClone] ciStrClone;
    #stack[int, 64] hn = cssc::peek32(sp + 4);
    #stack[int, 64] on = cssc::peek32(oldp + 4);
    #stack[int, 64] nn = cssc::peek32(newp + 4);
    #stack[int, 64] r = 0;
    if (on == 0) {
        ciStrClone(sp) c;
        r = c;
        #delete[c];
    }
    if (on != 0) {
        #stack[int, 64] cnt = 0;
        #stack[int, 64] i = 0;
        while (i + on <= hn) {
            #stack[int, 64] j = 0;
            #stack[int, 32] m = 1;
            while (j < on) {
                if (cssc::peek8(sp + 8 + i + j) != cssc::peek8(oldp + 8 + j)) { m = 0; j = on; }
                if (m == 1) { j = j + 1; }
            }
            #delete[j];
            if (m == 1) { cnt = cnt + 1; i = i + on; }
            if (m == 0) { i = i + 1; }
            #delete[m];
        }
        #delete[i];
        #stack[int, 64] total = hn + cnt * (nn - on);
        #stack[int, 64] buf = cssc::alloc(total + 1);
        #stack[int, 64] w = 0;
        #stack[int, 64] p = 0;
        while (p < hn) {
            #stack[int, 32] m2 = 0;
            if (p + on <= hn) {
                m2 = 1;
                #stack[int, 64] j2 = 0;
                while (j2 < on) {
                    if (cssc::peek8(sp + 8 + p + j2) != cssc::peek8(oldp + 8 + j2)) { m2 = 0; j2 = on; }
                    if (m2 == 1) { j2 = j2 + 1; }
                }
                #delete[j2];
            }
            if (m2 == 1) {
                #stack[int, 64] k = 0;
                while (k < nn) { cssc::poke8(buf + w, cssc::peek8(newp + 8 + k)); w = w + 1; k = k + 1; }
                #delete[k];
                p = p + on;
            }
            if (m2 == 0) {
                cssc::poke8(buf + w, cssc::peek8(sp + 8 + p));
                w = w + 1;
                p = p + 1;
            }
            #delete[m2];
        }
        #delete[p];
        ciStrNew(buf, total) rr;
        r = rr;
        cssc::free(buf);
        #delete[rr];
        #delete[w];
        #delete[total];
        #delete[buf];
        #delete[cnt];
    }
    #delete[hn];
    #delete[on];
    #delete[nn];
    return r;
}

