        #delete[isTgtHdr];
        #delete[isMatchKey];
        #delete[ts];
        #delete[te];
        #delete[ce];
        pos = rle;
        #delete[rle];
        #delete[ls];
        #delete[le];
    }
    if (sawTarget == 0) {
        if (op > 0) { if (cssc::peek8(ciIniOut + op - 1) != 10) { cssc::poke8(ciIniOut + op, 10); op = op + 1; } }
        cssc::poke8(ciIniOut + op, 91);
        op = op + 1;
        ciIniPut(op, sctP, sctL) os;
        op = os;
        #delete[os];
        cssc::poke8(ciIniOut + op, 93);
        op = op + 1;
        cssc::poke8(ciIniOut + op, 10);
        op = op + 1;
        ciIniEmitKV(op, keyP, keyL, valP, valL, 1) ok;
        op = ok;
        #delete[ok];
    }
    if (sawTarget == 1) {
        if (wroteKey == 0) {
            if (op > 0) { if (cssc::peek8(ciIniOut + op - 1) != 10) { cssc::poke8(ciIniOut + op, 10); op = op + 1; } }
            ciIniEmitKV(op, keyP, keyL, valP, valL, 1) ok;
            op = ok;
            #delete[ok];
        }
    }
    #stack[int, 64] res = 0;
    if (idx >= 0) {
        fsStore(idx, ciIniOut, op);
        res = 1;
    }
    #delete[op];
    #delete[inTarget];
    #delete[wroteKey];
    #delete[sawTarget];
    #delete[pos];
    #delete[buf];
    #delete[len];
    #delete[idx];
    #delete[sctP];
    #delete[sctL];
    #delete[keyP];
    #delete[keyL];
    #delete[valP];
    #delete[valL];
    return res;
}

#define(ciIniDeleteKey) {
