#define(ciStrIndexOf) {
    #scanp(ciStrIndexOf, int, 0) hay;
    #scanp(ciStrIndexOf, int, 1) needle;
    #stack[int, 64] hl = cssc::peek32(hay + 4);
    #stack[int, 64] nl = cssc::peek32(needle + 4);
    #stack[int, 64] res = 0 - 1;
    if (nl == 0) { res = 0; }
    if (nl != 0) {
        #stack[int, 64] i = 0;
        #stack[int, 32] go = 1;
        while (go == 1) {
            if (i + nl > hl) { go = 0; }
            if (go == 1) {
                #stack[int, 64] j = 0;
                #stack[int, 32] m = 1;
                while (j < nl) {
                    if (cssc::peek8(hay + 8 + i + j) != cssc::peek8(needle + 8 + j)) { m = 0; j = nl; }
                    if (m == 1) { j = j + 1; }
                }
                if (m == 1) { res = i; go = 0; }
                #delete[j];
                #delete[m];
            }
            if (go == 1) { i = i + 1; }
        }
        #delete[i];
        #delete[go];
    }
    #delete[hl];
    #delete[nl];
    return res;
}

#define(ciStrCaseNew) {
