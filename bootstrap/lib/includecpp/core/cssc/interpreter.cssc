}

#define(ciVecReverse) {
    #scanp(ciVecReverse, int, 0) h;
    #stack[int, 64] size = cssc::peek32(h + 4);
    #stack[int, 64] d = cssc::peek64(h + 16);
    #stack[int, 64] i = 0;
    #stack[int, 64] jj = size - 1;
    while (i < jj) {
        #stack[int, 64] a = cssc::peek64(d + i * 8);
        #stack[int, 64] b = cssc::peek64(d + jj * 8);
        cssc::poke64(d + i * 8, b);
        cssc::poke64(d + jj * 8, a);
        #delete[a];
        #delete[b];
        i = i + 1;
        jj = jj - 1;
    }
    #delete[i];
    #delete[jj];
    #delete[d];
    #delete[size];
}

#define(ciVecSort) {
    #scanp(ciVecSort, int, 0) h;
    #req[ciStrCmp] ciStrCmp;
    #stack[int, 64] size = cssc::peek32(h + 4);
    #stack[int, 64] et = cssc::peek32(h + 12);
    #stack[int, 64] d = cssc::peek64(h + 16);
    #stack[int, 64] i = 1;
    while (i < size) {
        #stack[int, 64] cur = cssc::peek64(d + i * 8);
        #stack[int, 64] j = i - 1;
        #stack[int, 32] go = 1;
        while (go == 1) {
            if (j < 0) { go = 0; }
            if (go == 1) {
                #stack[int, 64] pv = cssc::peek64(d + j * 8);
                #stack[int, 32] gt = 0;
                if (et == 1) {
                    ciStrCmp(pv, cur) c;
                    if (c > 0) { gt = 1; }
                    #delete[c];
                }
                if (et != 1) {
                    if (pv > cur) { gt = 1; }
                }
                if (gt == 1) {
                    cssc::poke64(d + (j + 1) * 8, pv);
                    j = j - 1;
                }
                if (gt == 0) { go = 0; }
                #delete[pv];
                #delete[gt];
            }
        }
        cssc::poke64(d + (j + 1) * 8, cur);
        #delete[cur];
        #delete[j];
        #delete[go];
        i = i + 1;
    }
    #delete[i];
    #delete[d];
    #delete[et];
    #delete[size];
}

#define(ciVecResize) {
    #scanp(ciVecResize, int, 0) h;
    #scanp(ciVecResize, int, 1) n;
    #stack[int, 64] size = cssc::peek32(h + 4);
    #stack[int, 64] et = cssc::peek32(h + 12);
    #stack[int, 64] nn = n;
    if (nn < 0) { nn = 0; }
    if (nn < size) {
        if (et == 1) {
            #stack[int, 64] d0 = cssc::peek64(h + 16);
            #stack[int, 64] k = nn;
            while (k < size) {
                #stack[int, 64] ev = cssc::peek64(d0 + k * 8);
                if (ev != 0) { cssc::free(ev); }
                #delete[ev];
                k = k + 1;
            }
            #delete[k];
            #delete[d0];
        }
        cssc::poke32(h + 4, nn);
    }
    if (nn > size) {
        #stack[int, 64] cap = cssc::peek32(h + 8);
        if (nn > cap) {
            #stack[int, 64] ncap = cap;
            while (ncap < nn) { ncap = ncap * 2; }
            #stack[int, 64] nd = cssc::alloc(ncap * 8);
            #stack[int, 64] od = cssc::peek64(h + 16);
            cssc::memcopy(nd, od, size * 2);
            cssc::free(od);
            cssc::poke64(h + 16, nd);
            cssc::poke32(h + 8, ncap);
            #delete[od];
            #delete[nd];
            #delete[ncap];
        }
        #stack[int, 64] d = cssc::peek64(h + 16);
        #stack[int, 64] k = size;
        while (k < nn) {
            cssc::poke64(d + k * 8, 0);
            k = k + 1;
        }
        cssc::poke32(h + 4, nn);
        #delete[k];
        #delete[d];
        #delete[cap];
    }
    #delete[nn];
    #delete[et];
    #delete[size];
}

#define(ciVecSwap) {
    #scanp(ciVecSwap, int, 0) a;
    #scanp(ciVecSwap, int, 1) b;
    #stack[int, 64] asz = cssc::peek32(a + 4);
    #stack[int, 64] acp = cssc::peek32(a + 8);
