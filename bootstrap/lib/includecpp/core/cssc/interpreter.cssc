            }
            if (mDrw == 1) {

                #stack[int, 64] cx = 0;
                #stack[int, 64] cy = 0;
                if (n == 3) { cx = cssc::peek64(a3 + 0); cy = cssc::peek64(a3 + 8); }
                if (n >= 4) { cx = a3; cy = a4; }
