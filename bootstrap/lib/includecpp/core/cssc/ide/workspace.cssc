#include("x86_64.gui") g;
#include("stdio") fs;
#include("system") sysm;
#include("cssc.ini") ini;

#stack[int, 64] lnCount;
#define(lnCount) {
    #scanp(lnCount, string, 0) s;
    #stack[int, 64] c = 0;
    #stack[int, 32] seg = 0;
    select (s) ?ch {
        if (ch == "\n") { if (seg == 1) { c = c + 1; } seg = 0; } else { seg = 1; }
        jump;
    }
    if (seg == 1) { c = c + 1; }
    #stack[int, 64] r = c;
    #delete[c];
    #delete[seg];
    return r;
}

#stack[string, 512] lnAtOut = "";
#stack[int, 64] lnAt;
#define(lnAt) {
    #scanp(lnAt, string, 0) s;
    #scanp(lnAt, int, 1) n;
    #req[lnAtOut] lnAtOut;
    lnAtOut = "";
    #stack[string, 512] cur = "";
    #stack[int, 64] idx = 0;
    #stack[int, 32] done = 0;
    select (s) ?ch {
        if (done == 0) {
            if (ch == "\n") {
                if (cur != "") {
                    if (idx == n) { lnAtOut = cur; done = 1; }
                    idx = idx + 1;
                }
                cur = "";
            } else {
                cur += &ch;
            }
        }
        jump;
    }
    if (done == 0) { if (cur != "") { if (idx == n) { lnAtOut = cur; } } }
    #delete[cur];
    #delete[idx];
    #delete[done];
    return 0;
}

#stack[string, 8192] projDir = fs::cwd();
#stack[string, 8192] dataIni = "__WORKSPACE_DATA_INI__";
#stack[string, 65536] ignoreSet = "";
#stack[string, 65536] filterOut = "";
#stack[string, 65536] lastDiags = "";
#stack[string, 65536] rawDiags = "";
#stack[string, 4096] identityOut = "";
#stack[string, 512] clipOut = "";
#stack[int, 32] semaBook = 0;
#stack[int, 32] bookOpenGuard = 0;
#stack[int, 32] bookSel = 0;

#stack[int, 64] identityOf;
#define(identityOf) {
    #scanp(identityOf, string, 0) line;
    #req[identityOut] identityOut;
    identityOut = "";
    #stack[int, 32] colons = 0;
    select (line) ?ch {
        if (colons >= 3) { identityOut += &ch; } else { if (ch == ":") { colons = colons + 1; } }
        jump;
    }
    #delete[colons];
    return 0;
}

#stack[int, 64] clipStr;
#define(clipStr) {
    #scanp(clipStr, string, 0) s;
    #scanp(clipStr, int, 1) maxc;
    #req[clipOut] clipOut;
    clipOut = "";
    #stack[int, 64] c = 0;
    select (s) ?ch {
        if (c < maxc) { clipOut += &ch; c = c + 1; }
        jump;
    }
    #delete[c];
    return 0;
}

#stack[int, 64] pkHsv;
#define(pkHsv) {
    #scanp(pkHsv, int, 0) h;
    #scanp(pkHsv, int, 1) s;
    #scanp(pkHsv, int, 2) v;
    #stack[int, 32] reg = h / 60;
    #stack[int, 32] rem = (h - reg * 60) * 255 / 60;
    #stack[int, 32] pp = v * (255 - s) / 255;
    #stack[int, 32] qq = v * (255 - s * rem / 255) / 255;
    #stack[int, 32] tt = v * (255 - s * (255 - rem) / 255) / 255;
    #stack[int, 32] rr = 0;
    #stack[int, 32] gg = 0;
    #stack[int, 32] bb = 0;
    if (reg == 0) { rr = v; gg = tt; bb = pp; }
    if (reg == 1) { rr = qq; gg = v; bb = pp; }
    if (reg == 2) { rr = pp; gg = v; bb = tt; }
    if (reg == 3) { rr = pp; gg = qq; bb = v; }
    if (reg == 4) { rr = tt; gg = pp; bb = v; }
    if (reg >= 5) { rr = v; gg = pp; bb = qq; }
    #stack[int, 64] argb = 4278190080;
    argb = argb + rr * 65536;
    argb = argb + gg * 256;
    argb = argb + bb;
    #stack[int, 64] out = argb;
    #delete[argb];
    #delete[bb]; #delete[gg]; #delete[rr];
    #delete[tt]; #delete[qq]; #delete[pp];
    #delete[rem]; #delete[reg];
    return out;
}

#stack[int, 64] pkNib;
#define(pkNib) {
    #scanp(pkNib, int, 0) nib;
    #stack[string, 256] tbl = "0123456789ABCDEF";
    #stack[string, 64] out = "";
    #stack[int, 32] idx = 0;
    select (tbl) ?ch {
        if (idx == nib) { out += &ch; }
        idx = idx + 1;
        jump;
    }
    #delete[idx];
    #delete[tbl];
    return out;
}

#stack[string, 128] pkHexStr = "";
#stack[int, 64] pkHexFmt;
#define(pkHexFmt) {
    #scanp(pkHexFmt, int, 0) argb;
    #req[pkHexStr] pkHexStr;
    #req[pkNib] pkNib;
    pkHexStr = "0x";
    #stack[int, 64] divv = 268435456;
    #stack[int, 32] go = 1;
    while (go == 1) {
        #stack[int, 32] nib = argb / divv % 16;
        pkNib(nib) c;
        pkHexStr = pkHexStr + c;
        #delete[c];
        #delete[nib];
        if (divv == 1) { go = 0; }
        if (go == 1) { divv = divv / 16; }
    }
    #delete[go];
    #delete[divv];
    return 0;
}

#stack[int, 64] pathIsCssc;
#define(pathIsCssc) {
    #scanp(pathIsCssc, string, 0) p;
    #stack[int, 64] n = p.length();
    #stack[int, 32] r = 0;
    if (n >= 5) {
        if (p[n - 5] == 46) { if (p[n - 4] == 99) { if (p[n - 3] == 115) { if (p[n - 2] == 115) { if (p[n - 1] == 99) { r = 1; } } } } }
    }
    #delete[n];
    return r;
}

#stack[int, 64] setHas;
#define(setHas) {
    #scanp(setHas, string, 0) set;
    #scanp(setHas, string, 1) item;
    #stack[int, 32] found = 0;
    #stack[string, 4096] cur = "";
    select (set) ?ch {
        if (ch == "\n") { if (cur == item) { found = 1; } cur = ""; } else { cur += &ch; }
        jump;
    }
    if (cur == item) { found = 1; }
    #stack[int, 32] r = found;
    #delete[found];
    #delete[cur];
    return r;
}

#stack[int, 64] filterDiags;
#define(filterDiags) {
    #scanp(filterDiags, string, 0) raw;
    #req[filterOut] filterOut;
    #req[ignoreSet] ignoreSet;
    #req[identityOut] identityOut;
    #req[identityOf] identityOf;
    #req[setHas] setHas;
    filterOut = "";
    #stack[string, 8] nl = "\n";
    #stack[string, 4096] cur = "";
    select (raw) ?ch {
        if (ch == "\n") {
            if (cur != "") {
                identityOf(cur);
                setHas(ignoreSet, identityOut) hit;
                if (hit == 0) { filterOut = filterOut + cur; filterOut = filterOut + nl; }
                #delete[hit];
            }
            cur = "";
        } else { cur += &ch; }
        jump;
    }
    #delete[nl];
    #delete[cur];
    return 0;
}

#stack[int, 64] loadIgnores;
#define(loadIgnores) {
    #req[ignoreSet] ignoreSet;
    #req[dataIni] dataIni;
    #req[projDir] projDir;
    ignoreSet = "";
    #stack[string, 8] nl = "\n";
    #stack[string, 8] igp = "ig";
    #stack[string, 4] emp = "";
    #stack[int, 64] k = 0;
    #stack[int, 32] go = 1;
    while (go == 1) {
        #stack[string, 64] key = igp + k;
        #stack[string, 4096] val = ini::read(dataIni, projDir, key, emp);
        if (val == "") { go = 0; } else {
            ignoreSet = ignoreSet + val;
            ignoreSet = ignoreSet + nl;
            k = k + 1;
        }
        #delete[key];
        #delete[val];
    }
    #delete[nl];
    #delete[igp];
    #delete[emp];
    #delete[k];
    #delete[go];
    return 0;
}

#stack[int, 64] saveIgnores;
#define(saveIgnores) {
    #req[ignoreSet] ignoreSet;
    #req[dataIni] dataIni;
    #req[projDir] projDir;
    #req[lnAtOut] lnAtOut;
    #req[lnAt] lnAt;
    #req[lnCount] lnCount;
    #stack[string, 8] igp = "ig";
    #stack[string, 4] emp = "";
    #stack[int, 64] oldN = 0;
    #stack[int, 32] cg = 1;
    while (cg == 1) {
        #stack[string, 64] ck = igp + oldN;
        #stack[string, 4096] cv = ini::read(dataIni, projDir, ck, emp);
        if (cv == "") { cg = 0; } else { oldN = oldN + 1; }
        #delete[ck];
        #delete[cv];
    }
    #delete[cg];
    #stack[int, 64] n = lnCount(ignoreSet);
    #stack[int, 64] k = 0;
    while (k < n) {
        lnAt(ignoreSet, k);
        #stack[string, 64] key = igp + k;
        ini::write(dataIni, projDir, key, lnAtOut);
        k = k + 1;
        #delete[key];
    }
    #delete[k];
    #stack[int, 64] d = n;
    while (d < oldN) {
        #stack[string, 64] dk = igp + d;
        ini::delete(dataIni, projDir, dk);
        d = d + 1;
        #delete[dk];
    }
    #delete[d];
    #delete[n];
    #delete[oldN];
    #delete[igp];
    #delete[emp];
    return 0;
}

#stack[int, 64] addIgnore;
#define(addIgnore) {
    #scanp(addIgnore, string, 0) ident;
    #req[ignoreSet] ignoreSet;
    #req[setHas] setHas;
    #req[saveIgnores] saveIgnores;
    if (ident != "") {
        setHas(ignoreSet, ident) has;
        if (has == 0) {
            #stack[string, 8] nl = "\n";
            ignoreSet = ignoreSet + ident;
            ignoreSet = ignoreSet + nl;
            saveIgnores();
            #delete[nl];
        }
        #delete[has];
    }
    return 0;
}

#stack[int, 64] addAllIgnores;
#define(addAllIgnores) {
    #scanp(addAllIgnores, string, 0) raw;
    #req[identityOut] identityOut;
    #req[identityOf] identityOf;
    #req[addIgnore] addIgnore;
    #stack[string, 4096] cur = "";
    select (raw) ?ch {
        if (ch == "\n") {
            if (cur != "") { identityOf(cur); addIgnore(identityOut); }
            cur = "";
        } else { cur += &ch; }
        jump;
    }
    #delete[cur];
    return 0;
}

#stack[int, 64] removeIgnoreAt;
#define(removeIgnoreAt) {
    #scanp(removeIgnoreAt, int, 0) target;
    #req[ignoreSet] ignoreSet;
    #req[saveIgnores] saveIgnores;
    #stack[string, 65536] rebuilt = "";
    #stack[string, 8] nl = "\n";
    #stack[string, 4096] cur = "";
    #stack[int, 64] idx = 0;
    select (ignoreSet) ?ch {
        if (ch == "\n") {
            if (cur != "") {
                if (idx != target) { rebuilt = rebuilt + cur; rebuilt = rebuilt + nl; }
                idx = idx + 1;
            }
            cur = "";
        } else { cur += &ch; }
        jump;
    }
    ignoreSet = rebuilt;
    saveIgnores();
    #delete[rebuilt];
    #delete[nl];
    #delete[cur];
    #delete[idx];
    return 0;
}

#stack[string, 9000] runExe = "";
#stack[string, 9000] runExeE = "";
#stack[int, 32] deriveExe;
#define(deriveExe) {
    #scanp(deriveExe, string, 0) p;
    #req[runExe] runExe;
    #req[runExeE] runExeE;
    runExe = "";
    #stack[string, 8] de = ".exe";
    #stack[string, 9000] acc = "";
    select (p) ?ch {
        if (ch == ".") { runExe = acc; }
        acc += &ch;
        jump;
    }
    if (runExe == "") { runExe = acc; }
    runExeE = runExe + de;
    #delete[de];
    #delete[acc];
    return 0;
}

