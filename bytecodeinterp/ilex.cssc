// ---- Phase A: pre-tokenized stream (PERFORMANCE FOUNDATION) ----
// The lexer (ciLexRaw) runs ONCE over the whole source (ciTokenize), storing each
// token in these parallel per-token columns. ciAdvance then just reads column[ciPos]
// and increments -- NO per-token character scan. So a loop/function body replays by
// resetting ciPos to a saved TOKEN INDEX with ZERO re-lexing (the old byte-cursor
// span-replay re-lexed the body from source every iteration -> O(bytes x iters)).
// ciPos is a TOKEN INDEX during parsing; ciLexRaw reuses it as a BYTE cursor ONLY
// during tokenization (never concurrently). ciTokOff/ciTokLen stay BYTE offsets into
// ciSrc (identifier/string text lives in the source buffer, compared byte-wise), so
// name resolution + the ciMainEnd/aend boundary checks are unchanged. Cap = ciSrcBuf
// bytes (each token consumes >=1 source byte, whitespace/comments consume 0 tokens).
#stack[int, 64] ciTokCode = 0;   // per-token: token code (poke8)
#stack[int, 64] ciTokNumA = 0;   // per-token: int value or f64 bit pattern (poke64)
#stack[int, 64] ciTokFlag = 0;   // per-token: 1 = float literal (poke8)
#stack[int, 64] ciTokOffA = 0;   // per-token: byte offset of ident/string text (poke32)
#stack[int, 64] ciTokLenA = 0;   // per-token: byte length of ident/string text (poke32)
#stack[int, 64] ciTokCount = 0;  // number of tokens currently in the stream
#stack[int, 64] ciTokCap = 0;    // capacity (entries)

#stack[int, 64] ciInit;
#stack[int, 64] ciLexRaw;
#stack[int, 64] ciTokenize;
#stack[int, 64] ciAdvance;
#stack[int, 64] ciIdentIs;
#stack[int, 64] ciQualify;
#stack[int, 64] ciTokHasCC;
#stack[int, 64] ciSecPrefixIs;
#stack[int, 64] ciSecFind;
#stack[int, 64] ciSecFindLab;
#stack[int, 64] ciObjFind;
#stack[int, 64] ciObjNameIs;
#stack[int, 64] ciNullBorrows;
#stack[int, 64] ciInstMemFind;
#stack[int, 64] ciInstFree;
#stack[int, 64] ciInstMemSet;
#stack[int, 64] ciInstMemGet;
#stack[int, 64] ciVarFind;
#stack[int, 64] ciVarFindGlobal;
#stack[int, 64] ciVarGet;
#stack[int, 64] ciVarSet;
#stack[int, 64] ciCapStore;
#stack[int, 64] ciVarDrop;
// unified value destructor: frees whatever heap a value tag owns (string 1,
// object 3, vector/array 4, map 5, bind 7; int/float own nothing). Forward slot
// so the early ciVarDrop / ciVecClear can dispatch through it and recurse into
// nested containers. THE fix for the cross-run + scope-exit container leak.
#stack[int, 64] ciValFree;
#stack[int, 64] ciEatCall;
#stack[int, 64] ciStrNew;
#stack[int, 64] ciStrClone;
#stack[int, 64] ciItoa;
#stack[int, 64] ciContFmt;
#stack[int, 64] ciStrConcat;
#stack[int, 64] ciFnFind;
#stack[int, 64] ciFnRegister;
#stack[int, 64] ciExpr;
#stack[int, 64] ciDoPrint;
#stack[int, 64] ciDoPoke;
#stack[int, 64] ciDoVideo;
#stack[int, 64] ciDoSound;
// console module (value tag 6): pure helpers + statement dispatcher
#stack[int, 64] ciDoConsole;
#stack[int, 64] ciConAttr;
#stack[int, 64] ciConNew;
#stack[int, 64] ciConScroll;
#stack[int, 64] ciConPutc;
#stack[int, 64] ciConOut;
#stack[int, 64] ciConClearAll;
#stack[int, 64] ciConClearLine;
#stack[int, 64] ciConCursorPos;
#stack[int, 64] ciConGetLine;
#stack[int, 64] ciConCursorAt;
#stack[int, 64] ciConSyncAdd;
#stack[int, 64] ciConSyncDrain;
#stack[int, 64] ciConDesync;
#stack[int, 64] ciConClose;
// mouse module (client value tag 8): pure helpers + statement dispatcher
#stack[int, 64] ciDoMouse;
#stack[int, 64] ciMsLc;
#stack[int, 64] ciMsMapX;
#stack[int, 64] ciMsMapY;
#stack[int, 64] ciMsBtnMask;
#stack[int, 64] ciMsUpdate;
#stack[int, 64] ciMsOver;
#stack[int, 64] ciMsMethod;
#stack[int, 64] ciDoSprite;
#stack[int, 64] ciDoTilemap;
#stack[int, 64] ciDoFont;
#stack[int, 64] ciSext32;
#stack[int, 64] ciBmpLoad;
#stack[int, 64] ciSprNew;
#stack[int, 64] ciSheetNew;
#stack[int, 64] ciSprBlit;
#stack[int, 64] ciSprBlitScaled;
#stack[int, 64] ciSprBlitTinted;
#stack[int, 64] ciSprBlitAlpha;
#stack[int, 64] ciSprBlitFlip;
#stack[int, 64] ciSheetDrawFrame;
#stack[int, 64] ciTmDraw;
#stack[int, 64] ciFontMeasure;
#stack[int, 64] ciFontBlit;
#stack[int, 64] ciDoAssign;
#stack[int, 64] ciDoDecl;
#stack[int, 64] ciStmt;
#stack[int, 64] ciRun;

#define(ciInit) {
    #req[ciVNames] ciVNames;
    #req[ciVLens] ciVLens;
    #req[ciVVals] ciVVals;
    #req[ciVTypes] ciVTypes;
    #req[ciVOwns] ciVOwns;
    #req[ciFnNames] ciFnNames;
    #req[ciFnLens] ciFnLens;
    #req[ciFnBodyStart] ciFnBodyStart;
    #req[ciFnInjCnt] ciFnInjCnt;
    #req[ciFnInjStart] ciFnInjStart;
    #req[ciFnInjEnd] ciFnInjEnd;
    #req[ciFnBodyEnd] ciFnBodyEnd;
    #req[ciFnParCnt] ciFnParCnt;
    #req[ciFnParOff] ciFnParOff;
    #req[ciFnParLen] ciFnParLen;
    #req[ciCdOff] ciCdOff;
    #req[ciCdLen] ciCdLen;
    #req[ciArgVals] ciArgVals;
    #req[ciArgTypes] ciArgTypes;
    #req[ciArgOwns] ciArgOwns;
    #req[ciFnSecOff] ciFnSecOff;
    #req[ciFnSecLen] ciFnSecLen;
    #req[ciFnVis] ciFnVis;
    #req[ciVVis] ciVVis;
    #req[ciVBits] ciVBits;
    #req[ciVReq] ciVReq;
    #req[ciQualBuf] ciQualBuf;
    #req[ciSecNameOff] ciSecNameOff;
    #req[ciSecNameLen] ciSecNameLen;
    #req[ciSecBodyS] ciSecBodyS;
    #req[ciSecBodyE] ciSecBodyE;
    #req[ciSecFreeS] ciSecFreeS;
    #req[ciSecFreeE] ciSecFreeE;
    #req[ciSecFreed] ciSecFreed;
    #req[ciSecDefer] ciSecDefer;
    #req[ciSecLabOff] ciSecLabOff;
    #req[ciSecLabLen] ciSecLabLen;
    #req[ciObjNameOff] ciObjNameOff;
    #req[ciObjNameLen] ciObjNameLen;
    #req[ciObjParS] ciObjParS;
    #req[ciObjBodyS] ciObjBodyS;
    #req[ciObjBodyE] ciObjBodyE;
    #req[ciObjTopE] ciObjTopE;
    #req[ciObjFreeS] ciObjFreeS;
    #req[ciObjFreeE] ciObjFreeE;
    #req[ciLabObj] ciLabObj;
    #req[ciLabNameOff] ciLabNameOff;
    #req[ciLabNameLen] ciLabNameLen;
    #req[ciLabParS] ciLabParS;
    #req[ciLabBodyS] ciLabBodyS;
    #req[ciLabBodyE] ciLabBodyE;
    #req[ciSrcBuf] ciSrcBuf;
    #req[ciLoadName] ciLoadName;
    #req[ciLoadFnS] ciLoadFnS;
    #req[ciLoadFnE] ciLoadFnE;
    #req[ciTokCode] ciTokCode;
    #req[ciTokNumA] ciTokNumA;
    #req[ciTokFlag] ciTokFlag;
    #req[ciTokOffA] ciTokOffA;
    #req[ciTokLenA] ciTokLenA;
    #req[ciTokCap] ciTokCap;
    #req[ciFont] ciFont;
    #req[ciFont5] ciFont5;
    #req[ciAlOff] ciAlOff;
    #req[ciAlLen] ciAlLen;
    #req[ciAlMod] ciAlMod;
    #req[ciKbCurr] ciKbCurr;
    #req[ciKbPrev] ciKbPrev;
    #req[ciKbEdge] ciKbEdge;
    #req[ciKbNames] ciKbNames;
    #req[ciSndSlots] ciSndSlots;
    #req[ciIniVal] ciIniVal;
    #req[ciIniOut] ciIniOut;
    // variable table: up to 4096 rows (name 32B for qualified Sector::member,
    // len/val/type/owns 8B each). BIG for firefield's 13-module global set.
    ciVNames = cssc::alloc(131072);
    ciVLens = cssc::alloc(32768);
    ciVVals = cssc::alloc(32768);
    ciVTypes = cssc::alloc(32768);
    ciVOwns = cssc::alloc(32768);
    // function table: up to 2048 defs (free functions + sector methods + the
    // alias-qualified duplicates for #load'd modules; name 32B, cols 8B each).
    ciFnNames = cssc::alloc(65536);
    ciFnLens = cssc::alloc(16384);
    ciFnBodyStart = cssc::alloc(16384);
    ciFnBodyEnd = cssc::alloc(16384);
    ciFnInjCnt = cssc::alloc(16384);
    ciFnInjStart = cssc::alloc(131072);
    ciFnInjEnd = cssc::alloc(131072);
    cssc::memfill32(ciFnInjCnt, 0, 4096);
    ciFnSecOff = cssc::alloc(16384);
    ciFnSecLen = cssc::alloc(16384);
    ciFnVis = cssc::alloc(16384);
    // argument frame: up to 8 args (value/type/owns)
    ciArgVals = cssc::alloc(64);
    ciArgTypes = cssc::alloc(64);
    ciArgOwns = cssc::alloc(64);
    // per-var visibility column + qualified-name scratch (>= 32B name + '::')
    ciVVis = cssc::alloc(32768);
    ciVBits = cssc::alloc(32768);
    ciVReq = cssc::alloc(32768);
    ciQualBuf = cssc::alloc(128);
    // sector table: 128 sectors x 8B per column
    ciSecNameOff = cssc::alloc(1024);
    ciSecNameLen = cssc::alloc(1024);
    ciSecBodyS = cssc::alloc(1024);
    ciSecBodyE = cssc::alloc(1024);
    ciSecFreeS = cssc::alloc(1024);
    ciSecFreeE = cssc::alloc(1024);
    ciSecFreed = cssc::alloc(1024);
    ciSecDefer = cssc::alloc(1024);
    ciSecLabOff = cssc::alloc(1024);
    ciSecLabLen = cssc::alloc(1024);
    // object definition table: 32 defs x 8B per column
    ciObjNameOff = cssc::alloc(256);
    ciObjNameLen = cssc::alloc(256);
    ciObjParS = cssc::alloc(256);
    ciObjBodyS = cssc::alloc(256);
    ciObjBodyE = cssc::alloc(256);
    ciObjTopE = cssc::alloc(256);
    ciObjFreeS = cssc::alloc(256);
    ciObjFreeE = cssc::alloc(256);
    // label table: 256 labels x 8B per column
    ciLabObj = cssc::alloc(2048);
    ciLabNameOff = cssc::alloc(2048);
    ciLabNameLen = cssc::alloc(2048);
    ciLabParS = cssc::alloc(2048);
    ciLabBodyS = cssc::alloc(2048);
    ciLabBodyE = cssc::alloc(2048);
    // 512KB master source buffer for the program + #load'd files; load records
    // (up to 32 loads). firefield's 13 concatenated modules are ~300KB.
    ciSrcBuf = cssc::alloc(524288);
    ciLoadName = cssc::alloc(1024);
    ciLoadFnS = cssc::alloc(256);
    ciLoadFnE = cssc::alloc(256);
    // #cdefine named-param table (2048 fns; 8 params each) + parse scratch (8 entries)
    ciFnParCnt = cssc::alloc(16384);
    ciFnParOff = cssc::alloc(131072);
    ciFnParLen = cssc::alloc(131072);
    ciCdOff = cssc::alloc(64);
    ciCdLen = cssc::alloc(64);
    // pre-tokenized stream: one slot per possible token (<= ciSrcBuf bytes). Sized
    // to the master buffer so #load's appended library code fits without a regrow.
    ciTokCap = 262144;
    ciTokCode = cssc::alloc(ciTokCap);          // 1 byte / token
    ciTokNumA = cssc::alloc(ciTokCap * 8);      // 8 bytes / token
    ciTokFlag = cssc::alloc(ciTokCap);          // 1 byte / token
    ciTokOffA = cssc::alloc(ciTokCap * 4);      // 4 bytes / token
    ciTokLenA = cssc::alloc(ciTokCap * 4);      // 4 bytes / token
    // native module state: 8x8 font table, alias->module table (64 rows),
    // keyboard curr/prev held arrays, sound slot table (32 * 16B). The verbatim
    // System-B 8x8 font (96 glyphs, each 8 row-bytes packed into one i64; byte
    // gy = (word>>(gy*8))&0xFF, bit0 = leftmost column) is loaded inline here.
    ciFont = cssc::alloc(768);
    cssc::poke64(ciFont + 0, 0x0000000000000000);
    cssc::poke64(ciFont + 8, 0x0018000018181818);
    cssc::poke64(ciFont + 16, 0x0000000000003636);
    cssc::poke64(ciFont + 24, 0x0036367F367F3636);
    cssc::poke64(ciFont + 32, 0x000C1F301E033E0C);
    cssc::poke64(ciFont + 40, 0x0063660C18336300);
    cssc::poke64(ciFont + 48, 0x006E333B6E1C361C);
    cssc::poke64(ciFont + 56, 0x0000000000030606);
    cssc::poke64(ciFont + 64, 0x00180C0606060C18);
    cssc::poke64(ciFont + 72, 0x00060C1818180C06);
    cssc::poke64(ciFont + 80, 0x0000663CFF3C6600);
    cssc::poke64(ciFont + 88, 0x00000C0C3F0C0C00);
    cssc::poke64(ciFont + 96, 0x060C0C0000000000);
    cssc::poke64(ciFont + 104, 0x000000003F000000);
    cssc::poke64(ciFont + 112, 0x000C0C0000000000);
    cssc::poke64(ciFont + 120, 0x000103060C183060);
    cssc::poke64(ciFont + 128, 0x003E676F7B73633E);
    cssc::poke64(ciFont + 136, 0x003F0C0C0C0C0E0C);
    cssc::poke64(ciFont + 144, 0x003F33061C30331E);
    cssc::poke64(ciFont + 152, 0x001E33301C30331E);
    cssc::poke64(ciFont + 160, 0x0078307F33363C38);
    cssc::poke64(ciFont + 168, 0x001E3330301F033F);
    cssc::poke64(ciFont + 176, 0x001E33331F03061C);
    cssc::poke64(ciFont + 184, 0x000C0C0C1830333F);
    cssc::poke64(ciFont + 192, 0x001E33331E33331E);
