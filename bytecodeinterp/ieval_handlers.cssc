                    if (isMem == 0) {
                        #stack[int, 64] bno = no;
                        #stack[int, 64] bnl = nl;
                        if (ciSecInit == 1) {
                            ciQualify(ciCurSecOff, ciCurSecLen, no, nl) ql2;
                            bno = ciQualBuf - ciSrc;
                            bnl = ql2;
                            #delete[ql2];
                            ciBindVis = ciSecVis;
                        }
                        ciBindBits = declBits;
                        ciVarSet(bno, bnl, e, et, eo);
                        ciBindBits = 64;
                        ciBindVis = 1;
                        #delete[bno];
                        #delete[bnl];
                    }
                    }
                    #delete[bitBad];
                }
                if (ciExec == 0) {
                    if (eo == 1) { if (et == 1) { cssc::free(e); } }
                }
                didInit = 1;
                #delete[e];
                #delete[et];
                #delete[eo];
            } } }
            #delete[isBindLit];
            #delete[isVecLit];
            #delete[isMapLit];
            #delete[vecClose];
        }
        if (didInit == 0) {
            // no initializer: bind the declared type's default (0), owns=0
            if (ciExec == 1) {
                if (isMem == 1) {
                    if (ciCurInst != 0) {
                        // uninitialized string member -> fresh empty "" object
                        // (owns=1), same rationale as the local-variable case.
                        if (declType == 1) {
                            ciStrNew(0, 0) esm;
                            ciInstMemSet(ciCurInst, mno, mnl, esm, 1, 1);
                            #delete[esm];
                        }
                        if (declType != 1) {
                            ciInstMemSet(ciCurInst, mno, mnl, 0, declType, 0);
                        }
                    }
                }
                if (isMem == 0) {
                    #stack[int, 64] bno = no;
                    #stack[int, 64] bnl = nl;
                    if (ciSecInit == 1) {
                        ciQualify(ciCurSecOff, ciCurSecLen, no, nl) ql3;
                        bno = ciQualBuf - ciSrc;
                        bnl = ql3;
                        #delete[ql3];
                        ciBindVis = ciSecVis;
                    }
                    ciBindBits = declBits;
                    if (ctag == 0) {
                        // an uninitialized string binds a fresh empty "" object
                        // (owns=1), NOT a null pointer -- exactly like the empty
                        // containers below. Every later string op then sees a valid
                        // object instead of dereferencing 0 and faulting, matching
                        // the reference (uninit string == "").
                        if (declType == 1) {
                            ciStrNew(0, 0) es0;
                            ciVarSet(bno, bnl, es0, 1, 1);
                            #delete[es0];
                        }
                        if (declType != 1) {
                            #stack[int, 32] noiBad = 0;
                            if (declBits < 64) {
                                #stack[int, 64] noiReq = 0;
                                if (declType == 2) { noiReq = 64; }
                                if (declIsInt == 1) { noiReq = 8; }
                                if (noiReq > declBits) {
                                    noiBad = 1;
                                    #stack[int, 64] nmb = cssc::alloc(128);
                                    #stack[int, 64] nmn = ciAppLit(nmb, 0, "#stack: value exceeds bit limit (");
                                    #stack[int, 64] nnbf = cssc::alloc(32);
                                    ciItoa(noiReq, nnbf) nr1;
                                    #stack[int, 32] ni1 = 0;
                                    while (ni1 < nr1) { cssc::poke8(nmb + nmn, cssc::peek8(nnbf + ni1)); nmn = nmn + 1; ni1 = ni1 + 1; }
                                    #delete[ni1];
                                    #delete[nr1];
                                    nmn = ciAppLit(nmb, nmn, " > ");
                                    ciItoa(declBits, nnbf) nr2;
                                    #stack[int, 32] ni2 = 0;
                                    while (ni2 < nr2) { cssc::poke8(nmb + nmn, cssc::peek8(nnbf + ni2)); nmn = nmn + 1; ni2 = ni2 + 1; }
                                    #delete[ni2];
                                    #delete[nr2];
                                    nmn = ciAppLit(nmb, nmn, " bits)");
                                    cssc::free(nnbf);
                                    ciRaise(nmb, nmn, ciLineAt(o), 0);
                                    cssc::free(nmb);
                                    #delete[nmn];
                                }
                                #delete[noiReq];
                            }
                            if (noiBad == 0) {
                                ciVarSet(bno, bnl, 0, declType, 0);
                            }
                            #delete[noiBad];
                        }
                    }
                    if (ctag != 0) {
                        // #vector/#map/#array/#bind with no initializer: bind a
                        // fresh empty container of the directive's tag
                        #stack[int, 64] ch = 0;
                        if (ctag == 4) { ciVecNew(declType) vh; ch = vh; #delete[vh]; }
                        if (ctag == 5) { ciMapNew() mh; ch = mh; #delete[mh]; }
                        if (ctag == 7) { ciBindNew(0) bh; ch = bh; #delete[bh]; }
                        // owns=1: this fresh empty container is solely owned by its
                        // declaring slot, so #delete/scope-exit reclaims it (was
                        // leaking every declaration -- e.g. ll/hl in test_file)
                        ciVarSet(bno, bnl, ch, ctag, 1);
                        #delete[ch];
                    }
                    ciBindBits = 64;
                    ciBindVis = 1;
                    #delete[bno];
                    #delete[bnl];
                }
            }
        }
        if (ciCur == 13) { ciAdvance(); }
        #delete[didInit];
        #delete[isMem];
        #delete[mno];
        #delete[mnl];
        #delete[no];
        #delete[nl];
        #delete[declBits];
        #delete[declType];
    }
    #delete[isdel];
    #delete[isdef];
    #delete[isredef];
    #delete[isscan];
    #delete[isreq];
    #delete[isvec];
    #delete[ismap];
    #delete[isarr];
    #delete[isvid];
    #delete[iscons];
    #delete[isadr];
    #delete[isref];
    #delete[isdelm];
    #delete[ctag];
    #delete[isvar];
    #delete[o];
    #delete[l];
}
