// grace::catch / #catch. Dormant today (the interp returns 0x0 rather than raising).
#stack[int, 64] ciFaultMsg = 0;
#stack[int, 64] ciFaultKind = 0;
#stack[int, 64] ciFaultLine = 0;
#stack[int, 64] ciSrcPath = 0;
#stack[int, 64] ciSrcPathLen = 0;
// 8x8 font table (96 glyphs * 8 row-bytes packed as one i64 each, 768 bytes).
#stack[int, 64] ciFont = 0;
// keyboard module state: curr/prev held arrays indexed by VK (256 bytes each);
// name->VK table (records [len][vk][UPPER name...], end len 0); the interp's own
