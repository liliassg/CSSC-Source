                            if (n == 1) { a2 = e; q2 = eo; y2 = et; }
                            if (n == 2) { a3 = e; q3 = eo; y3 = et; }
                            if (n == 3) { a4 = e; q4 = eo; y4 = et; }
                            if (n == 4) { a5 = e; q5 = eo; y5 = et; }
                            if (n == 5) { a6 = e; q6 = eo; y6 = et; }
