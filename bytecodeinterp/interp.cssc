// snapshot keys in insertion order -> fresh owned vector (elem type = key type;
// string keys are cloned by ciVecPush). Empty map -> empty int-vector.
#define(ciMapKeys) {
    #scanp(ciMapKeys, int, 0) h;
    #req[ciVecNew] ciVecNew;
    #req[ciVecPush] ciVecPush;
    #stack[int, 64] size = cssc::peek32(h + 4);
    #stack[int, 64] d = cssc::peek64(h + 16);
