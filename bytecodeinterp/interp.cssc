                    #delete[y1]; #delete[y2]; #delete[y3]; #delete[y4];
                    #delete[n]; #delete[r];
                    #delete[fbi]; #delete[fld]; #delete[fgw]; #delete[fgh];
                    #delete[fmw]; #delete[fmh]; #delete[flh];
                }
                // ---- math.accel value methods (modid 12) -- stateless pure fns ----
                if (mvmod == 12) {
                    ciIdentIs(mmo, mml, "hash2") mH2;
