                            #delete[gcGot];
                            #delete[grv];
                            #delete[grt];
                            #delete[gro];
                            #delete[gcBase];
                            #delete[gcCount];
                            #delete[gcSignal];
                            #delete[gcSecO];
                            #delete[gcSecL];
                            #delete[gcSecI];
                            #delete[gcSecV];
                            #delete[gcMir];
                            #delete[gcRV];
                            #delete[gcRT];
                            #delete[gcRO];
                            #delete[gcPos];
                            #delete[gcCur];
                            #delete[gcTN];
                            #delete[gcTO];
                            #delete[gcTL];
