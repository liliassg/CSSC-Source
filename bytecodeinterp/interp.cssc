                        if (ciCur == 10) { go = 0; }
                        if (ciCur == 0) { go = 0; }
                        if (go == 1) {
                            ciExpr(0) e;
                            #stack[int, 64] eo = ciEvalOwns;
                            #stack[int, 64] et = ciEvalType;
                            if (n == 0) { a1 = e; q1 = eo; y1 = et; }
                            if (n == 1) { a2 = e; q2 = eo; y2 = et; }
                            if (n == 2) { a3 = e; q3 = eo; y3 = et; }
                            if (n == 3) { a4 = e; q4 = eo; y4 = et; }
                            if (n == 4) { a5 = e; q5 = eo; y5 = et; }
                            if (n == 5) { a6 = e; q6 = eo; y6 = et; }
                            if (n == 6) { a7 = e; q7 = eo; y7 = et; }
                            if (n == 7) { a8 = e; q8 = eo; y8 = et; }
                            n = n + 1;
                            #delete[et]; #delete[eo]; #delete[e];
                            if (ciCur == 21) { ciAdvance(); }
                            if (n >= 8) { go = 0; }
                        }
                    }
                    #delete[go];
                    if (ciCur == 10) { ciAdvance(); }
                    #stack[int, 64] r = 0;
                    if (ciExec == 1) {
                        if (scr == 1) {
                            #stack[int, 64] kf = 0; #stack[int, 64] kv = 0;
                            if (n >= 3) { kf = 1; kv = a3; }
                            ciSprNew(a1, a2, kf, kv) hh; r = hh; #delete[hh];
                            #delete[kf]; #delete[kv];
                        }
                        if (sld == 1) {
                            #stack[int, 64] kf = 0; #stack[int, 64] kv = 0;
                            if (n >= 2) { kf = 1; kv = a2; }
                            ciBmpLoad(a1) bmp;
                            #stack[int, 64] hd = cssc::alloc(24);
                            cssc::poke32(hd, ciBmpW);
                            cssc::poke32(hd + 4, ciBmpH);
                            cssc::poke32(hd + 8, kf);
                            cssc::poke32(hd + 12, kv);
                            cssc::poke64(hd + 16, bmp);
                            r = hd;
                            #delete[hd]; #delete[bmp]; #delete[kf]; #delete[kv];
                        }
                        if (sgp == 1) {
                            #stack[int, 64] w = cssc::peek32(a1);
                            #stack[int, 64] h = cssc::peek32(a1 + 4);
                            #stack[int, 64] data = cssc::peek64(a1 + 16);
                            if (a2 >= 0) { if (a3 >= 0) { if (a2 < w) { if (a3 < h) {
                                r = cssc::peek32(data + (a3 * w + a2) * 4);
                            } } } }
                            #delete[w]; #delete[h]; #delete[data];
                        }
                        if (swd == 1) { r = cssc::peek32(a1); }
                        if (sht == 1) { r = cssc::peek32(a1 + 4); }
                        if (ssc == 1) {
                            #stack[int, 64] kf = 0; #stack[int, 64] kv = 0;
                            if (n >= 5) { kf = 1; kv = a5; }
                            ciSheetNew(a1, a2, a3, a4, kf, kv) hh; r = hh; #delete[hh];
                            #delete[kf]; #delete[kv];
                        }
                        if (ssl == 1) {
                            #stack[int, 64] kf = 0; #stack[int, 64] kv = 0;
                            if (n >= 4) { kf = 1; kv = a4; }
                            ciBmpLoad(a1) bmp;
                            #stack[int, 64] tw = a2; if (tw < 1) { tw = 1; }
                            #stack[int, 64] th = a3; if (th < 1) { th = 1; }
                            #stack[int, 64] cols = ciBmpW / tw; if (cols < 1) { cols = 1; }
                            #stack[int, 64] rows = ciBmpH / th; if (rows < 1) { rows = 1; }
                            #stack[int, 64] hd = cssc::alloc(40);
                            cssc::poke32(hd, ciBmpW);
                            cssc::poke32(hd + 4, ciBmpH);
                            cssc::poke32(hd + 8, tw);
                            cssc::poke32(hd + 12, th);
                            cssc::poke32(hd + 16, cols);
                            cssc::poke32(hd + 20, rows);
                            cssc::poke32(hd + 24, kf);
                            cssc::poke32(hd + 28, kv);
                            cssc::poke64(hd + 32, bmp);
                            r = hd;
                            #delete[hd]; #delete[bmp]; #delete[tw]; #delete[th];
                            #delete[cols]; #delete[rows]; #delete[kf]; #delete[kv];
                        }
                        if (ssf == 1) {
                            #stack[int, 64] sw = cssc::peek32(a1);
                            #stack[int, 64] tw = cssc::peek32(a1 + 8);
                            #stack[int, 64] th = cssc::peek32(a1 + 12);
                            #stack[int, 64] cols = cssc::peek32(a1 + 16);
                            #stack[int, 64] kf = cssc::peek32(a1 + 24);
                            #stack[int, 64] kv = cssc::peek32(a1 + 28);
                            #stack[int, 64] sdata = cssc::peek64(a1 + 32);
                            #stack[int, 64] col = a2 % cols;
                            #stack[int, 64] row = a2 / cols;
                            #stack[int, 64] sx0 = col * tw;
                            #stack[int, 64] sy0 = row * th;
                            ciSprNew(tw, th, kf, kv) hd;
                            #stack[int, 64] ddata = cssc::peek64(hd + 16);
                            #stack[int, 64] py = 0;
                            while (py < th) {
                                #stack[int, 64] px = 0;
                                while (px < tw) {
                                    #stack[int, 64] pix = cssc::peek32(sdata + ((sy0 + py) * sw + (sx0 + px)) * 4);
                                    cssc::poke32(ddata + (py * tw + px) * 4, pix);
                                    #delete[pix];
                                    px = px + 1;
                                }
                                #delete[px];
                                py = py + 1;
                            }
                            #delete[py];
                            r = hd;
                            #delete[hd]; #delete[ddata]; #delete[sw]; #delete[tw]; #delete[th];
                            #delete[cols]; #delete[kf]; #delete[kv]; #delete[sdata];
                            #delete[col]; #delete[row]; #delete[sx0]; #delete[sy0];
                        }
                        if (ssco == 1) { r = cssc::peek32(a1 + 16); }
                        if (ssro == 1) { r = cssc::peek32(a1 + 20); }
                        if (sac == 1) {
                            ciVecSize(a2) fcv;
                            #stack[int, 64] fc = fcv; #delete[fcv];
                            #stack[int, 64] fpsB = 0;
                            if (n >= 3) {
                                if (y3 == 2) { fpsB = a3; }
                                if (y3 != 2) { cssc::iToF(a3) fb; fpsB = fb; #delete[fb]; }
                            }
                            if (n < 3) { cssc::iToF(12) fb; fpsB = fb; #delete[fb]; }
                            cssc::iToF(0) zero;
                            cssc::fCmp(fpsB, zero) cmp;
                            if (cmp != 1) { cssc::iToF(1) one; fpsB = one; #delete[one]; }
                            #delete[cmp]; #delete[zero];
                            #stack[int, 64] looping = 1;
                            if (n >= 4) { looping = a4; }
                            #stack[int, 64] hd = cssc::alloc(48);
                            #stack[int, 64] fp = cssc::alloc(fc * 4);
                            #stack[int, 64] i = 0;
                            while (i < fc) {
                                ciVecGet(a2, i) gv;
                                cssc::poke32(fp + i * 4, gv);
                                #delete[gv];
                                i = i + 1;
                            }
                            #delete[i];
                            cssc::poke64(hd + 0, a1);
                            cssc::poke64(hd + 8, fp);
                            cssc::poke32(hd + 16, fc);
                            cssc::poke32(hd + 20, 0);
                            cssc::poke64(hd + 24, fpsB);
                            cssc::iToF(0) accz;
                            cssc::poke64(hd + 32, accz);
                            #delete[accz];
                            cssc::poke32(hd + 40, looping);
                            cssc::poke32(hd + 44, 0);
                            r = hd;
                            #delete[hd]; #delete[fp]; #delete[fc]; #delete[fpsB]; #delete[looping];
                        }
                        if (saf == 1) { r = cssc::peek32(a1 + 44); }
                        if (sacf == 1) {
                            #stack[int, 64] frames = cssc::peek64(a1 + 8);
                            #stack[int, 64] idx = cssc::peek32(a1 + 20);
                            r = cssc::peek32(frames + idx * 4);
                            #delete[frames]; #delete[idx];
                        }
                        if (sha == 1) {
                            #stack[int, 32] hit = 0;
                            if (a1 < a5 + a7) { if (a1 + a3 > a5) { if (a2 < a6 + a8) { if (a2 + a4 > a6) { hit = 1; } } } }
                            r = hit;
                            #delete[hit];
                        }
                        if (shp == 1) {
                            #stack[int, 32] hit = 0;
                            if (a3 <= a1) { if (a1 < a3 + a5) { if (a4 <= a2) { if (a2 < a4 + a6) { hit = 1; } } } }
                            r = hit;
                            #delete[hit];
                        }
                    }
                    left = r;
                    ciEvalType = 0;
                    leftOwns = 0;
                    handled = 1;
                    if (q1 == 1) { ciValFree(y1, a1); }
                    if (q2 == 1) { ciValFree(y2, a2); }
                    if (q3 == 1) { ciValFree(y3, a3); }
                    if (q4 == 1) { ciValFree(y4, a4); }
                    if (q5 == 1) { ciValFree(y5, a5); }
                    if (q6 == 1) { ciValFree(y6, a6); }
                    if (q7 == 1) { ciValFree(y7, a7); }
                    if (q8 == 1) { ciValFree(y8, a8); }
                    #delete[a1]; #delete[a2]; #delete[a3]; #delete[a4];
                    #delete[a5]; #delete[a6]; #delete[a7]; #delete[a8];
                    #delete[q1]; #delete[q2]; #delete[q3]; #delete[q4];
                    #delete[q5]; #delete[q6]; #delete[q7]; #delete[q8];
                    #delete[y1]; #delete[y2]; #delete[y3]; #delete[y4];
                    #delete[y5]; #delete[y6]; #delete[y7]; #delete[y8];
                    #delete[n]; #delete[r];
                    #delete[scr]; #delete[sld]; #delete[sgp]; #delete[swd]; #delete[sht];
                    #delete[ssc]; #delete[ssl]; #delete[ssf]; #delete[ssco]; #delete[ssro];
                    #delete[sac]; #delete[saf]; #delete[sacf]; #delete[sha]; #delete[shp];
                }
                // ---- video.tilemap value methods (modid 6) ----
                if (mvmod == 6) {
                    ciIdentIs(mmo, mml, "tilesetCreate") tsc;
                    ciIdentIs(mmo, mml, "tilesetLoadBmp") tsl;
                    ciIdentIs(mmo, mml, "create") tcr;
                    ciIdentIs(mmo, mml, "getTile") tgt;
                    ciIdentIs(mmo, mml, "width") twd;
                    ciIdentIs(mmo, mml, "height") tht;
                    ciIdentIs(mmo, mml, "tileWidth") ttw;
                    ciIdentIs(mmo, mml, "tileHeight") tth;
                    ciIdentIs(mmo, mml, "pixelWidth") tpw;
                    ciIdentIs(mmo, mml, "pixelHeight") tph;
                    ciIdentIs(mmo, mml, "isSolid") tis;
                    ciIdentIs(mmo, mml, "cameraCreate") tcc;
                    ciIdentIs(mmo, mml, "cameraX") tcx;
                    ciIdentIs(mmo, mml, "cameraY") tcy;
                    ciIdentIs(mmo, mml, "worldToScreen") tw2s;
                    ciIdentIs(mmo, mml, "screenToWorld") ts2w;
                    ciIdentIs(mmo, mml, "collideAabb") tca;
                    ciIdentIs(mmo, mml, "tileAtWorld") ttaw;
                    if (ciCur == 9) { ciAdvance(); }
                    #stack[int, 64] a1 = 0; #stack[int, 64] a2 = 0; #stack[int, 64] a3 = 0;
                    #stack[int, 64] a4 = 0; #stack[int, 64] a5 = 0;
                    #stack[int, 64] q1 = 0; #stack[int, 64] q2 = 0; #stack[int, 64] q3 = 0;
                    #stack[int, 64] q4 = 0; #stack[int, 64] q5 = 0;
                    #stack[int, 64] y1 = 0; #stack[int, 64] y2 = 0; #stack[int, 64] y3 = 0;
                    #stack[int, 64] y4 = 0; #stack[int, 64] y5 = 0;
                    #stack[int, 32] n = 0;
                    #stack[int, 32] go = 1;
                    while (go == 1) {
                        if (ciCur == 10) { go = 0; }
                        if (ciCur == 0) { go = 0; }
                        if (go == 1) {
                            ciExpr(0) e;
                            #stack[int, 64] eo = ciEvalOwns;
                            #stack[int, 64] et = ciEvalType;
                            if (n == 0) { a1 = e; q1 = eo; y1 = et; }
                            if (n == 1) { a2 = e; q2 = eo; y2 = et; }
                            if (n == 2) { a3 = e; q3 = eo; y3 = et; }
                            if (n == 3) { a4 = e; q4 = eo; y4 = et; }
                            if (n == 4) { a5 = e; q5 = eo; y5 = et; }
                            n = n + 1;
                            #delete[et]; #delete[eo]; #delete[e];
                            if (ciCur == 21) { ciAdvance(); }
                            if (n >= 5) { go = 0; }
                        }
                    }
                    #delete[go];
                    if (ciCur == 10) { ciAdvance(); }
                    #stack[int, 64] r = 0;
                    #stack[int, 64] rt = 0;
                    if (ciExec == 1) {
                        if (tsc == 1) {
                            #stack[int, 64] kf = 0; #stack[int, 64] kv = 0;
                            if (n >= 5) { kf = 1; kv = a5; }
                            ciSheetNew(a1, a2, a3, a4, kf, kv) hh; r = hh; #delete[hh];
                            #delete[kf]; #delete[kv];
                        }
                        if (tsl == 1) {
                            #stack[int, 64] kf = 0; #stack[int, 64] kv = 0;
                            if (n >= 4) { kf = 1; kv = a4; }
                            ciBmpLoad(a1) bmp;
                            #stack[int, 64] tw = a2; if (tw < 1) { tw = 1; }
                            #stack[int, 64] th = a3; if (th < 1) { th = 1; }
                            #stack[int, 64] cols = ciBmpW / tw; if (cols < 1) { cols = 1; }
                            #stack[int, 64] rows = ciBmpH / th; if (rows < 1) { rows = 1; }
                            #stack[int, 64] hd = cssc::alloc(40);
                            cssc::poke32(hd, ciBmpW);
                            cssc::poke32(hd + 4, ciBmpH);
                            cssc::poke32(hd + 8, tw);
                            cssc::poke32(hd + 12, th);
                            cssc::poke32(hd + 16, cols);
                            cssc::poke32(hd + 20, rows);
                            cssc::poke32(hd + 24, kf);
                            cssc::poke32(hd + 28, kv);
                            cssc::poke64(hd + 32, bmp);
                            r = hd;
                            #delete[hd]; #delete[bmp]; #delete[tw]; #delete[th];
                            #delete[cols]; #delete[rows]; #delete[kf]; #delete[kv];
                        }
                        if (tcr == 1) {
                            #stack[int, 64] cols = a2; if (cols < 1) { cols = 1; }
                            #stack[int, 64] rows = a3; if (rows < 1) { rows = 1; }
                            #stack[int, 64] tw = 16; #stack[int, 64] th = 16;
                            if (a1 != 0) { tw = cssc::peek32(a1 + 8); th = cssc::peek32(a1 + 12); }
                            #stack[int, 64] hd = cssc::alloc(48);
                            #stack[int, 64] data = cssc::alloc(cols * rows * 4);
                            cssc::memfill32(data, 0 - 1, cols * rows);
                            #stack[int, 64] solids = cssc::alloc(256);
                            cssc::memfill32(solids, 0, 64);
                            cssc::poke64(hd + 0, a1);
                            cssc::poke32(hd + 8, cols);
                            cssc::poke32(hd + 12, rows);
                            cssc::poke32(hd + 16, tw);
                            cssc::poke32(hd + 20, th);
                            cssc::poke64(hd + 24, data);
                            cssc::poke64(hd + 32, solids);
                            cssc::poke32(hd + 40, 0);
                            r = hd;
                            #delete[hd]; #delete[data]; #delete[solids];
                            #delete[cols]; #delete[rows]; #delete[tw]; #delete[th];
                        }
                        if (tgt == 1) {
                            #stack[int, 64] cols = cssc::peek32(a1 + 8);
                            #stack[int, 64] rows = cssc::peek32(a1 + 12);
                            #stack[int, 64] data = cssc::peek64(a1 + 24);
                            r = 0 - 1;
                            if (a2 >= 0) { if (a3 >= 0) { if (a2 < cols) { if (a3 < rows) {
                                ciSext32(cssc::peek32(data + (a3 * cols + a2) * 4)) v;
                                r = v;
                                #delete[v];
                            } } } }
                            #delete[cols]; #delete[rows]; #delete[data];
                        }
                        if (twd == 1) { r = cssc::peek32(a1 + 8); }
                        if (tht == 1) { r = cssc::peek32(a1 + 12); }
                        if (ttw == 1) { r = cssc::peek32(a1 + 16); }
                        if (tth == 1) { r = cssc::peek32(a1 + 20); }
                        if (tpw == 1) { r = cssc::peek32(a1 + 8) * cssc::peek32(a1 + 16); }
                        if (tph == 1) { r = cssc::peek32(a1 + 12) * cssc::peek32(a1 + 20); }
                        if (tis == 1) {
                            #stack[int, 64] solids = cssc::peek64(a1 + 32);
                            if (a2 >= 0) { if (a2 < 256) { r = cssc::peek8(solids + a2); } }
                            #delete[solids];
                        }
                        if (tcc == 1) {
                            #stack[int, 64] cx = 0; #stack[int, 64] cy = 0;
                            if (n >= 1) { cx = a1; }
                            if (n >= 2) { cy = a2; }
                            #stack[int, 64] hd = cssc::alloc(40);
                            cssc::poke64(hd + 0, cx);
                            cssc::poke64(hd + 8, cy);
                            cssc::poke32(hd + 16, 0);
                            cssc::poke32(hd + 20, 0);
                            cssc::poke32(hd + 24, 0);
                            cssc::poke32(hd + 28, 0);
                            cssc::poke32(hd + 32, 0);
                            r = hd;
                            #delete[hd]; #delete[cx]; #delete[cy];
                        }
                        if (tcx == 1) { r = cssc::peek64(a1 + 0); }
                        if (tcy == 1) { r = cssc::peek64(a1 + 8); }
                        if (tw2s == 1) {
                            #stack[int, 64] cx = cssc::peek64(a1 + 0);
                            #stack[int, 64] cy = cssc::peek64(a1 + 8);
                            ciMapNew() m;
                            ciMapSet(m, 0, 0, 0, a2 - cx);
                            ciMapSet(m, 0, 1, 0, a3 - cy);
                            r = m; rt = 5;
                            #delete[m]; #delete[cx]; #delete[cy];
                        }
                        if (ts2w == 1) {
                            #stack[int, 64] cx = cssc::peek64(a1 + 0);
                            #stack[int, 64] cy = cssc::peek64(a1 + 8);
                            ciMapNew() m;
                            ciMapSet(m, 0, 0, 0, a2 + cx);
                            ciMapSet(m, 0, 1, 0, a3 + cy);
                            r = m; rt = 5;
                            #delete[m]; #delete[cx]; #delete[cy];
                        }
                        if (tca == 1) {
                            #stack[int, 64] cols = cssc::peek32(a1 + 8);
                            #stack[int, 64] rows = cssc::peek32(a1 + 12);
                            #stack[int, 64] tw = cssc::peek32(a1 + 16);
                            #stack[int, 64] th = cssc::peek32(a1 + 20);
                            #stack[int, 64] data = cssc::peek64(a1 + 24);
                            #stack[int, 64] solids = cssc::peek64(a1 + 32);
                            #stack[int, 32] run = 1;
                            if (a4 <= 0) { run = 0; }
                            if (a5 <= 0) { run = 0; }
                            if (run == 1) {
                                #stack[int, 64] c0 = a2 / tw; if (c0 < 0) { c0 = 0; }
                                #stack[int, 64] c1 = (a2 + a4 - 1) / tw + 1; if (c1 > cols) { c1 = cols; }
                                #stack[int, 64] r0 = a3 / th; if (r0 < 0) { r0 = 0; }
                                #stack[int, 64] r1 = (a3 + a5 - 1) / th + 1; if (r1 > rows) { r1 = rows; }
                                #stack[int, 32] found = 0;
                                #stack[int, 64] rr = r0;
                                while (rr < r1) {
                                    #stack[int, 64] cc = c0;
                                    while (cc < c1) {
                                        if (found == 0) {
                                            ciSext32(cssc::peek32(data + (rr * cols + cc) * 4)) v;
                                            if (v >= 0) { if (v < 256) { if (cssc::peek8(solids + v) == 1) { found = 1; } } }
                                            #delete[v];
                                        }
                                        cc = cc + 1;
                                    }
                                    #delete[cc];
                                    rr = rr + 1;
                                }
                                #delete[rr];
                                if (found == 1) { r = 1; }
                                #delete[found];
                                #delete[c0]; #delete[c1]; #delete[r0]; #delete[r1];
                            }
                            #delete[run];
                            #delete[cols]; #delete[rows]; #delete[tw]; #delete[th];
                            #delete[data]; #delete[solids];
                        }
                        if (ttaw == 1) {
                            #stack[int, 64] cols = cssc::peek32(a1 + 8);
                            #stack[int, 64] rows = cssc::peek32(a1 + 12);
                            #stack[int, 64] tw = cssc::peek32(a1 + 16);
                            #stack[int, 64] th = cssc::peek32(a1 + 20);
                            #stack[int, 64] data = cssc::peek64(a1 + 24);
                            r = 0 - 1;
                            #stack[int, 64] c = a2 / tw;
                            #stack[int, 64] rw = a3 / th;
                            if (a2 >= 0) { if (a3 >= 0) { if (c < cols) { if (rw < rows) {
                                ciSext32(cssc::peek32(data + (rw * cols + c) * 4)) v;
                                r = v;
                                #delete[v];
                            } } } }
                            #delete[c]; #delete[rw];
                            #delete[cols]; #delete[rows]; #delete[tw]; #delete[th]; #delete[data];
                        }
                    }
                    left = r;
                    ciEvalType = rt;
                    leftOwns = 0;
                    if (rt == 5) { leftOwns = 1; }
                    handled = 1;
                    if (q1 == 1) { ciValFree(y1, a1); }
                    if (q2 == 1) { ciValFree(y2, a2); }
                    if (q3 == 1) { ciValFree(y3, a3); }
                    if (q4 == 1) { ciValFree(y4, a4); }
                    if (q5 == 1) { ciValFree(y5, a5); }
                    #delete[a1]; #delete[a2]; #delete[a3]; #delete[a4]; #delete[a5];
                    #delete[q1]; #delete[q2]; #delete[q3]; #delete[q4]; #delete[q5];
                    #delete[y1]; #delete[y2]; #delete[y3]; #delete[y4]; #delete[y5];
                    #delete[n]; #delete[r]; #delete[rt];
                    #delete[tsc]; #delete[tsl]; #delete[tcr]; #delete[tgt]; #delete[twd];
                    #delete[tht]; #delete[ttw]; #delete[tth]; #delete[tpw]; #delete[tph];
                    #delete[tis]; #delete[tcc]; #delete[tcx]; #delete[tcy]; #delete[tw2s];
                    #delete[ts2w]; #delete[tca]; #delete[ttaw];
                }
                // ---- video.font value methods (modid 7) ----
                if (mvmod == 7) {
                    ciIdentIs(mmo, mml, "builtin") fbi;
                    ciIdentIs(mmo, mml, "loadBmp") fld;
                    ciIdentIs(mmo, mml, "glyphWidth") fgw;
                    ciIdentIs(mmo, mml, "glyphHeight") fgh;
                    ciIdentIs(mmo, mml, "measureWidth") fmw;
                    ciIdentIs(mmo, mml, "measureHeight") fmh;
                    ciIdentIs(mmo, mml, "lineHeight") flh;
                    if (ciCur == 9) { ciAdvance(); }
                    #stack[int, 64] a1 = 0; #stack[int, 64] a2 = 0; #stack[int, 64] a3 = 0;
                    #stack[int, 64] a4 = 0;
                    #stack[int, 64] q1 = 0; #stack[int, 64] q2 = 0; #stack[int, 64] q3 = 0;
                    #stack[int, 64] q4 = 0;
                    #stack[int, 64] y1 = 0; #stack[int, 64] y2 = 0; #stack[int, 64] y3 = 0;
                    #stack[int, 64] y4 = 0;
                    #stack[int, 32] n = 0;
                    #stack[int, 32] go = 1;
                    while (go == 1) {
                        if (ciCur == 10) { go = 0; }
                        if (ciCur == 0) { go = 0; }
                        if (go == 1) {
                            ciExpr(0) e;
                            #stack[int, 64] eo = ciEvalOwns;
                            #stack[int, 64] et = ciEvalType;
                            if (n == 0) { a1 = e; q1 = eo; y1 = et; }
                            if (n == 1) { a2 = e; q2 = eo; y2 = et; }
                            if (n == 2) { a3 = e; q3 = eo; y3 = et; }
                            if (n == 3) { a4 = e; q4 = eo; y4 = et; }
                            n = n + 1;
                            #delete[et]; #delete[eo]; #delete[e];
                            if (ciCur == 21) { ciAdvance(); }
                            if (n >= 4) { go = 0; }
