                    }
                    #delete[go];
                    if (ciCur == 10) { ciAdvance(); }
                    #stack[int, 64] r = 0;
                    if (ciExec == 1) {
                        if (fbi == 1) {
                            #stack[int, 64] hd = cssc::alloc(48);
                            cssc::poke32(hd + 0, 5);
                            cssc::poke32(hd + 4, 7);
                            cssc::poke32(hd + 8, 32);
                            cssc::poke32(hd + 12, 1);
                            cssc::poke32(hd + 16, 1);
                            cssc::poke32(hd + 20, 1);
                            cssc::poke32(hd + 24, 0);
                            cssc::poke64(hd + 28, ciFont5);
                            cssc::poke64(hd + 36, 0);
                            r = hd;
                            #delete[hd];
                        }
                        if (fld == 1) {
                            ciBmpLoad(a1) bmp;
                            #stack[int, 64] gw = a2; if (gw < 1) { gw = 1; }
                            #stack[int, 64] gh = a3; if (gh < 1) { gh = 1; }
                            #stack[int, 64] fc = 32; if (n >= 4) { fc = a4; }
                            #stack[int, 64] cols = ciBmpW / gw; if (cols < 1) { cols = 1; }
                            #stack[int, 64] rows = ciBmpH / gh; if (rows < 1) { rows = 1; }
                            #stack[int, 64] sh = cssc::alloc(40);
                            cssc::poke32(sh, ciBmpW);
                            cssc::poke32(sh + 4, ciBmpH);
                            cssc::poke32(sh + 8, gw);
                            cssc::poke32(sh + 12, gh);
                            cssc::poke32(sh + 16, cols);
                            cssc::poke32(sh + 20, rows);
                            cssc::poke32(sh + 24, 1);
                            cssc::poke32(sh + 28, cssc::shl(255, 24));
                            cssc::poke64(sh + 32, bmp);
                            #stack[int, 64] hd = cssc::alloc(48);
                            cssc::poke32(hd + 0, gw);
                            cssc::poke32(hd + 4, gh);
                            cssc::poke32(hd + 8, fc);
                            cssc::poke32(hd + 12, 1);
                            cssc::poke32(hd + 16, 1);
                            cssc::poke32(hd + 20, 1);
                            cssc::poke32(hd + 24, 1);
                            cssc::poke64(hd + 28, 0);
                            cssc::poke64(hd + 36, sh);
                            r = hd;
                            #delete[hd]; #delete[sh]; #delete[bmp]; #delete[gw]; #delete[gh];
                            #delete[fc]; #delete[cols]; #delete[rows];
                        }
                        if (fgw == 1) { r = cssc::peek32(a1 + 0); }
                        if (fgh == 1) { r = cssc::peek32(a1 + 4); }
                        if (fmw == 1) { ciFontMeasure(a1, a2) mw; r = mw; #delete[mw]; }
                        if (fmh == 1) {
                            #stack[int, 64] glyphH = cssc::peek32(a1 + 4);
                            #stack[int, 64] lineGap = cssc::peek32(a1 + 16);
                            #stack[int, 64] scale = cssc::peek32(a1 + 20);
                            #stack[int, 64] lineH = (glyphH + lineGap) * scale;
                            #stack[int, 64] slen = cssc::peek32(a2 + 4);
                            #stack[int, 64] lines = 1;
                            #stack[int, 64] i = 0;
                            while (i < slen) {
                                if (cssc::peek8(a2 + 8 + i) == 10) { lines = lines + 1; }
                                i = i + 1;
                            }
                            #delete[i];
                            r = lines * lineH - lineGap * scale;
                            #delete[glyphH]; #delete[lineGap]; #delete[scale];
                            #delete[lineH]; #delete[slen]; #delete[lines];
                        }
                        if (flh == 1) {
                            #stack[int, 64] glyphH = cssc::peek32(a1 + 4);
                            #stack[int, 64] lineGap = cssc::peek32(a1 + 16);
                            #stack[int, 64] scale = cssc::peek32(a1 + 20);
                            r = (glyphH + lineGap) * scale;
                            #delete[glyphH]; #delete[lineGap]; #delete[scale];
                        }
                    }
                    left = r;
                    ciEvalType = 0;
                    leftOwns = 0;
                    handled = 1;
                    if (q1 == 1) { ciValFree(y1, a1); }
                    if (q2 == 1) { ciValFree(y2, a2); }
                    if (q3 == 1) { ciValFree(y3, a3); }
                    if (q4 == 1) { ciValFree(y4, a4); }
                    #delete[a1]; #delete[a2]; #delete[a3]; #delete[a4];
