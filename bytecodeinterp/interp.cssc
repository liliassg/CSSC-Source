        // Lets a guest generate files (savegames, and #load'able library sources);
        // also the self-contained way to test #load on host (the CCFS starts empty).
        ciIdentIs(o, l, "cssc::fsWrite") kfsw;
        ciIdentIs(o, l, "cssc::push") kapush;
        ciIdentIs(o, l, "cssc::unshift") kaunsh;
        ciIdentIs(o, l, "cssc::pop") kapop;
        ciIdentIs(o, l, "cssc::shift") kashift;
        ciIdentIs(o, l, "cssc::sort") kasort;
        ciIdentIs(o, l, "cssc::reverse_arr") karev;
        ciIdentIs(o, l, "cssc::slice") kaslice;
        ciIdentIs(o, l, "cssc::concat") kaconc;
        ciIdentIs(o, l, "cssc::unique") kauniq;
        ciIdentIs(o, l, "cssc::flatten") kaflat;
        ciIdentIs(o, l, "cssc::range") karange;
        ciIdentIs(o, l, "cssc::zip_arr") kazip;
        ciIdentIs(o, l, "cssc::fill") kafill;
        ciIdentIs(o, l, "cssc::map_arr") kamap;
        ciIdentIs(o, l, "cssc::filter_arr") kafilt;
        ciIdentIs(o, l, "cssc::getIndex") kagidx;
        ciIdentIs(o, l, "cssc::find") kafind;
        ciIdentIs(o, l, "cssc::count") kacount;
        ciIdentIs(o, l, "cssc::sum") kasum;
        ciIdentIs(o, l, "cssc::avg") kaavg;
