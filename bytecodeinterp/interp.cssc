    #req[ciStrClone] ciStrClone;
    #req[ciMapRT] ciMapRT;
    #stack[int, 64] size = cssc::peek32(h + 4);
    #stack[int, 64] r = 0;
    ciMapRT = 0 - 1;
    if (idx >= 0) {
        if (idx < size) {
