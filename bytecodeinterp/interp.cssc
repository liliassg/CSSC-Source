                    ciIdentIs(mmo, mml, "to_int") cTi;
                    ciIdentIs(mmo, mml, "to_float") cTf;
                    if (ciCur == 9) { ciAdvance(); }
                    #stack[int, 64] a1 = 0; #stack[int, 64] a2 = 0; #stack[int, 64] a3 = 0;
                    #stack[int, 64] a4 = 0; #stack[int, 64] a5 = 0;
                    #stack[int, 64] q1 = 0; #stack[int, 64] q2 = 0; #stack[int, 64] q3 = 0;
                    #stack[int, 64] q4 = 0; #stack[int, 64] q5 = 0;
                    #stack[int, 64] y1 = 0; #stack[int, 64] y2 = 0; #stack[int, 64] y3 = 0;
                    #stack[int, 64] y4 = 0; #stack[int, 64] y5 = 0;
                    #stack[int, 32] n = 0;
                    #stack[int, 32] go = 1;
                    while (go == 1) {
                        if (ciCur == 10) { go = 0; }
                        if (ciCur == 0) { go = 0; }
                        if (go == 1) {
                            ciExpr(0) e;
                            #stack[int, 64] eo = ciEvalOwns;
                            #stack[int, 64] et = ciEvalType;
                            if (n == 0) { a1 = e; q1 = eo; y1 = et; }
                            if (n == 1) { a2 = e; q2 = eo; y2 = et; }
                            if (n == 2) { a3 = e; q3 = eo; y3 = et; }
                            if (n == 3) { a4 = e; q4 = eo; y4 = et; }
                            if (n == 4) { a5 = e; q5 = eo; y5 = et; }
                            n = n + 1;
                            #delete[et]; #delete[eo]; #delete[e];
                            if (ciCur == 21) { ciAdvance(); }
                            if (n >= 5) { go = 0; }
                        }
                    }
                    #delete[go];
                    if (ciCur == 10) { ciAdvance(); }
                    #stack[int, 64] f1 = a1; if (y1 != 2) { f1 = cssc::iToF(a1); }
                    #stack[int, 64] f2 = a2; if (y2 != 2) { f2 = cssc::iToF(a2); }
                    #stack[int, 64] f3 = a3; if (y3 != 2) { f3 = cssc::iToF(a3); }
                    #stack[int, 64] f4 = a4; if (y4 != 2) { f4 = cssc::iToF(a4); }
                    #stack[int, 64] f5 = a5; if (y5 != 2) { f5 = cssc::iToF(a5); }
                    // result type: default float; sign/to_int/floor/ceil/trunc -> int
                    #stack[int, 64] rt = 2;
                    if (cSg == 1) { rt = 0; }
                    if (cTi == 1) { rt = 0; }
                    if (cFl == 1) { rt = 0; }   // FX-MATHFIX: floor/ceil/trunc return int
                    if (cCe == 1) { rt = 0; }
                    if (cTr == 1) { rt = 0; }
                    #stack[int, 64] r = 0;
                    if (ciExec == 1) {
                        if (cPi == 1) { r = 0x400921FB54442D18; }
                        if (cE == 1) { r = 0x4005BF0A8B145769; }
                        if (cTau == 1) { r = 0x401921FB54442D18; }
                        if (cInf == 1) { r = 0x7FF0000000000000; }
                        if (cNan == 1) { r = 0x7FF8000000000000; }
                        if (cAbs == 1) { r = cssc::band(f1, 0x7FFFFFFFFFFFFFFF); }
                        if (cFl == 1) { cssc::fFloor(f1) rf; r = cssc::fToI(rf); #delete[rf]; }
                        if (cCe == 1) { cssc::fCeil(f1) rf; r = cssc::fToI(rf); #delete[rf]; }
                        if (cTr == 1) { cssc::fTrunc(f1) rf; r = cssc::fToI(rf); #delete[rf]; }
                        if (cRo == 1) {
                            // FX-MATHFIX: round(x[, digits]) -> banker's (half-even);
                            // with a 2nd arg, round to that many fractional digits.
                            #stack[int, 64] scale = cssc::iToF(1);
                            #stack[int, 64] digits = 0;
                            if (n >= 2) { digits = a2; }
                            #stack[int, 64] di = 0;
                            while (di < digits) { scale = cssc::fMul(scale, cssc::iToF(10)); di = di + 1; }
                            #delete[di];
                            #stack[int, 64] xs = cssc::fMul(f1, scale);
                            #stack[int, 64] fl = cssc::fFloor(xs);
                            #stack[int, 64] df = cssc::fSub(xs, fl);
                            #stack[int, 64] hf = cssc::fDiv(cssc::iToF(1), cssc::iToF(2));
                            #stack[int, 64] cc = cssc::fCmp(df, hf);
                            #stack[int, 64] rr = fl;
                            if (cc > 0) { rr = cssc::fAdd(fl, cssc::iToF(1)); }
                            if (cc == 0) {
                                #stack[int, 64] fi = cssc::fToI(fl);
                                if (cssc::band(fi, 1) == 1) { rr = cssc::fAdd(fl, cssc::iToF(1)); }
                                #delete[fi];
                            }
                            r = cssc::fDiv(rr, scale);
                            #delete[scale]; #delete[digits]; #delete[xs];
                            #delete[fl]; #delete[df]; #delete[hf]; #delete[cc]; #delete[rr];
                        }
                        if (cSg == 1) {
                            #stack[int, 64] cc = cssc::fCmp(f1, cssc::iToF(0));
                            r = 0;
                            if (cc == 1) { r = 1; }
                            if (cc < 0) { r = 0 - 1; }
