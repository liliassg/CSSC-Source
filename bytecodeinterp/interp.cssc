                        if (ciDevStdout == 0) { ciVecNew(1) nl; ciDevStdout = nl; #delete[nl]; }
                        if (sp != 0) { ciVecPush(ciDevStdout, sp, 1); }
                        if (spOwn == 1) { cssc::free(sp); }
