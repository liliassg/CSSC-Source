                    ciIdentIs(mmo, mml, "valueNoise2") mVn;
                    ciIdentIs(mmo, mml, "fbm2") mFb;
                    ciIdentIs(mmo, mml, "available") mAv;
                    if (ciCur == 9) { ciAdvance(); }
                    #stack[int, 64] a1 = 0; #stack[int, 64] a2 = 0; #stack[int, 64] a3 = 0;
                    #stack[int, 64] a4 = 0; #stack[int, 64] a5 = 0; #stack[int, 64] a6 = 0;
                    #stack[int, 64] q1 = 0; #stack[int, 64] q2 = 0; #stack[int, 64] q3 = 0;
                    #stack[int, 64] q4 = 0; #stack[int, 64] q5 = 0; #stack[int, 64] q6 = 0;
                    #stack[int, 64] y1 = 0; #stack[int, 64] y2 = 0; #stack[int, 64] y3 = 0;
                    #stack[int, 64] y4 = 0; #stack[int, 64] y5 = 0; #stack[int, 64] y6 = 0;
                    #stack[int, 32] n = 0;
                    #stack[int, 32] go = 1;
                    while (go == 1) {
