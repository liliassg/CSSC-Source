// ============================================================================
//  NATIVE MODULE PARITY -- reimplements the CSSC video/keyboard/sound/ini
//  backend (cssc_host_game.c / cssc_host_extras.c / cssc_ini.c) with ABSOLUTE
//  semantic parity. All helpers here are PURE: they take already-evaluated int/
//  pointer args and never call ciExpr, so ciExpr (below) can dispatch value
//  methods inline while the statement handlers (ciDoVideo etc.) reuse the same
//  helpers. See docs/module-parity-spec.md.
//
//  VIDEO handle = 24-byte struct {w@0 i32, h@4 i32, fps@8 i32, isOpen@12 i32,
//  buf@16 i64ptr}; buf = w*h*4 bytes ARGB backbuffer in native's B<->R-swapped
//  layout. Every video method takes the handle as arg-0.
// ============================================================================

// alias/module id lookup: returns 1=video 2=sound 3=keyboard 4=ini for a
// token whose "ns::" prefix matches a registered alias, else 0. Compares the
// namespace bytes (before '::') against every #include alias.
#define(ciModOf) {
    #scanp(ciModOf, int, 0) off;
    #scanp(ciModOf, int, 1) len;
    #req[ciTokHasCC] ciTokHasCC;
    #req[ciSpanEq] ciSpanEq;
    #req[ciAlOff] ciAlOff;
    #req[ciAlLen] ciAlLen;
    #req[ciAlMod] ciAlMod;
    #req[ciAlCount] ciAlCount;
    #stack[int, 64] mod = 0;
    ciTokHasCC(off, len) ccp;
    if (ccp > 0) {
        #stack[int, 64] k = 0;
        while (k < ciAlCount) {
            if (mod == 0) {
                #stack[int, 64] ao = cssc::peek64(ciAlOff + k * 8);
                #stack[int, 64] al = cssc::peek64(ciAlLen + k * 8);
                ciSpanEq(off, ccp, ao, al) eq;
                if (eq == 1) { mod = cssc::peek64(ciAlMod + k * 8); }
                #delete[eq];
                #delete[ao];
                #delete[al];
            }
            k = k + 1;
        }
        #delete[k];
    }
    #delete[ccp];
    return mod;
}

// ARGB 0xAARRGGBB -> stored word (a<<24)|(b<<16)|(g<<8)|r. Its own inverse.
#define(ciBgraOf) {
    #scanp(ciBgraOf, int, 0) argb;
    #stack[int, 64] a = cssc::band(cssc::shr(argb, 24), 255);
    #stack[int, 64] r = cssc::band(cssc::shr(argb, 16), 255);
    #stack[int, 64] g = cssc::band(cssc::shr(argb, 8), 255);
    #stack[int, 64] b = cssc::band(argb, 255);
    #stack[int, 64] out = cssc::bor(cssc::bor(cssc::shl(a, 24), cssc::shl(b, 16)), cssc::bor(cssc::shl(g, 8), r));
    #delete[a];
    #delete[r];
    #delete[g];
    #delete[b];
    return out;
}

// pixel(handle,x,y,argb): bounds-reject then swap-store the whole word (no blend).
#define(ciVidStore) {
    #scanp(ciVidStore, int, 0) hd;
    #scanp(ciVidStore, int, 1) x;
    #scanp(ciVidStore, int, 2) y;
    #scanp(ciVidStore, int, 3) argb;
    #req[ciBgraOf] ciBgraOf;
    #stack[int, 64] w = cssc::peek32(hd);
    #stack[int, 64] hh = cssc::peek32(hd + 4);
    #stack[int, 32] ok = 0;
    if (x >= 0) { if (y >= 0) { if (x < w) { if (y < hh) { ok = 1; } } } }
    if (ok == 1) {
        #stack[int, 64] buf = cssc::peek64(hd + 16);
        ciBgraOf(argb) sw;
        cssc::poke32(buf + (y * w + x) * 4, sw);
        #delete[sw];
        #delete[buf];
    }
    #delete[ok];
    #delete[w];
    #delete[hh];
}

// getPixel(handle,x,y): raw stored word (swapped layout), 0 if OOB.
#define(ciVidLoad) {
    #scanp(ciVidLoad, int, 0) hd;
    #scanp(ciVidLoad, int, 1) x;
    #scanp(ciVidLoad, int, 2) y;
    #stack[int, 64] w = cssc::peek32(hd);
    #stack[int, 64] hh = cssc::peek32(hd + 4);
    #stack[int, 64] out = 0;
    #stack[int, 32] ok = 0;
    if (x >= 0) { if (y >= 0) { if (x < w) { if (y < hh) { ok = 1; } } } }
    if (ok == 1) {
        #stack[int, 64] buf = cssc::peek64(hd + 16);
        out = cssc::peek32(buf + (y * w + x) * 4);
        #delete[buf];
    }
    #delete[ok];
    #delete[w];
    #delete[hh];
    return out;
}

// blendARGB(src_argb, dst_stored) -> ARGB (alpha forced 0xFF), integer /255.
#define(ciBlend) {
    #scanp(ciBlend, int, 0) src;
    #scanp(ciBlend, int, 1) dst;
    #stack[int, 64] sa = cssc::band(cssc::shr(src, 24), 255);
    #stack[int, 64] out = src;
    if (sa < 255) {
        #stack[int, 64] dr = cssc::band(dst, 255);
        #stack[int, 64] dg = cssc::band(cssc::shr(dst, 8), 255);
        #stack[int, 64] db = cssc::band(cssc::shr(dst, 16), 255);
        #stack[int, 64] aFF = cssc::shl(255, 24);
        if (sa == 0) {
            out = cssc::bor(aFF, cssc::bor(cssc::shl(dr, 16), cssc::bor(cssc::shl(dg, 8), db)));
        }
        if (sa != 0) {
            #stack[int, 64] sr = cssc::band(cssc::shr(src, 16), 255);
            #stack[int, 64] sg = cssc::band(cssc::shr(src, 8), 255);
            #stack[int, 64] sb = cssc::band(src, 255);
            #stack[int, 64] inv = 255 - sa;
            #stack[int, 64] rr = (sr * sa + dr * inv) / 255;
            #stack[int, 64] gg = (sg * sa + dg * inv) / 255;
            #stack[int, 64] bb = (sb * sa + db * inv) / 255;
            out = cssc::bor(aFF, cssc::bor(cssc::shl(rr, 16), cssc::bor(cssc::shl(gg, 8), bb)));
            #delete[sr];
            #delete[sg];
            #delete[sb];
            #delete[inv];
            #delete[rr];
            #delete[gg];
            #delete[bb];
        }
        #delete[dr];
        #delete[dg];
        #delete[db];
        #delete[aFF];
    }
    #delete[sa];
    return out;
}

// clear(handle,argb): fill all w*h words with bgraOf(argb).
#define(ciVidClear) {
    #scanp(ciVidClear, int, 0) hd;
    #scanp(ciVidClear, int, 1) argb;
    #req[ciBgraOf] ciBgraOf;
    #stack[int, 64] w = cssc::peek32(hd);
    #stack[int, 64] hh = cssc::peek32(hd + 4);
    #stack[int, 64] buf = cssc::peek64(hd + 16);
    ciBgraOf(argb) sw;
    cssc::memfill32(buf, sw, w * hh);
    #delete[sw];
    #delete[buf];
    #delete[w];
    #delete[hh];
}

// fillRect(handle,x,y,w,h,argb): alpha-aware, half-open clip. alpha 0 -> nothing.
#define(ciVidFill) {
    #scanp(ciVidFill, int, 0) hd;
    #scanp(ciVidFill, int, 1) x;
    #scanp(ciVidFill, int, 2) y;
    #scanp(ciVidFill, int, 3) rw;
    #scanp(ciVidFill, int, 4) rh;
    #scanp(ciVidFill, int, 5) argb;
    #req[ciVidStore] ciVidStore;
    #req[ciVidLoad] ciVidLoad;
    #req[ciBlend] ciBlend;
    #stack[int, 64] vw = cssc::peek32(hd);
    #stack[int, 64] vh = cssc::peek32(hd + 4);
    #stack[int, 64] alpha = cssc::band(cssc::shr(argb, 24), 255);
    #stack[int, 32] run = 1;
    if (rw <= 0) { run = 0; }
    if (rh <= 0) { run = 0; }
    if (alpha == 0) { run = 0; }
    if (run == 1) {
        #stack[int, 64] x0 = x;
        if (x0 < 0) { x0 = 0; }
        #stack[int, 64] y0 = y;
        if (y0 < 0) { y0 = 0; }
        #stack[int, 64] x1 = x + rw;
        if (x1 > vw) { x1 = vw; }
        #stack[int, 64] y1 = y + rh;
        if (y1 > vh) { y1 = vh; }
        #stack[int, 64] py = y0;
        while (py < y1) {
            #stack[int, 64] px = x0;
            while (px < x1) {
                if (alpha >= 255) { ciVidStore(hd, px, py, argb); }
                if (alpha < 255) {
                    ciVidLoad(hd, px, py) dv;
                    ciBlend(argb, dv) bl;
                    ciVidStore(hd, px, py, bl);
                    #delete[dv];
                    #delete[bl];
                }
                px = px + 1;
            }
            #delete[px];
            py = py + 1;
        }
        #delete[py];
        #delete[x0];
        #delete[y0];
        #delete[x1];
        #delete[y1];
    }
    #delete[run];
    #delete[vw];
    #delete[vh];
    #delete[alpha];
}

// drawRect(handle,x,y,w,h,argb): 1px outline, plain swap-store (no blend).
#define(ciVidRect) {
    #scanp(ciVidRect, int, 0) hd;
    #scanp(ciVidRect, int, 1) x;
    #scanp(ciVidRect, int, 2) y;
    #scanp(ciVidRect, int, 3) rw;
    #scanp(ciVidRect, int, 4) rh;
    #scanp(ciVidRect, int, 5) argb;
    #req[ciVidStore] ciVidStore;
    #stack[int, 64] vw = cssc::peek32(hd);
    #stack[int, 64] vh = cssc::peek32(hd + 4);
    #stack[int, 32] run = 1;
    if (rw <= 0) { run = 0; }
    if (rh <= 0) { run = 0; }
    if (run == 1) {
        #stack[int, 64] x0 = x;
        if (x0 < 0) { x0 = 0; }
        #stack[int, 64] y0 = y;
        if (y0 < 0) { y0 = 0; }
        #stack[int, 64] x1 = x + rw - 1;
        if (x1 > vw - 1) { x1 = vw - 1; }
        #stack[int, 64] y1 = y + rh - 1;
        if (y1 > vh - 1) { y1 = vh - 1; }
        #stack[int, 32] ok = 1;
        if (x1 < x0) { ok = 0; }
        if (y1 < y0) { ok = 0; }
        if (ok == 1) {
            #stack[int, 64] yb = y + rh - 1;
            #stack[int, 64] xr = x + rw - 1;
            #stack[int, 64] px = x0;
            while (px <= x1) {
                if (y >= 0) { if (y < vh) { ciVidStore(hd, px, y, argb); } }
                if (yb >= 0) { if (yb < vh) { ciVidStore(hd, px, yb, argb); } }
                px = px + 1;
            }
            #delete[px];
            #stack[int, 64] py = y0;
            while (py <= y1) {
                if (x >= 0) { if (x < vw) { ciVidStore(hd, x, py, argb); } }
                if (xr >= 0) { if (xr < vw) { ciVidStore(hd, xr, py, argb); } }
                py = py + 1;
            }
            #delete[py];
            #delete[yb];
            #delete[xr];
        }
        #delete[ok];
        #delete[x0];
        #delete[y0];
        #delete[x1];
        #delete[y1];
    }
    #delete[run];
    #delete[vw];
    #delete[vh];
}

// darken(handle,amount): multiplicative dim of the whole viewport, alpha kept.
// amount is fraction*255 (int) -- once the float type lands the float 0..1 gets
// coerced to floor(f*255) at the call site for exact parity. keep=(255-amount).
#define(ciVidDark) {
    #scanp(ciVidDark, int, 0) hd;
    #scanp(ciVidDark, int, 1) amount;
    #stack[int, 64] am = amount;
    #stack[int, 32] run = 1;
    if (am <= 0) { run = 0; }
    if (am > 255) { am = 255; }
    if (run == 1) {
        #stack[int, 64] keep = 255 - am;
        #stack[int, 64] w = cssc::peek32(hd);
        #stack[int, 64] hh = cssc::peek32(hd + 4);
        #stack[int, 64] buf = cssc::peek64(hd + 16);
        #stack[int, 64] tot = w * hh;
        #stack[int, 64] i = 0;
        while (i < tot) {
            #stack[int, 64] p = cssc::peek32(buf + i * 4);
            #stack[int, 64] a = cssc::band(cssc::shr(p, 24), 255);
            #stack[int, 64] c16 = (cssc::band(cssc::shr(p, 16), 255) * keep) / 255;
            #stack[int, 64] c8 = (cssc::band(cssc::shr(p, 8), 255) * keep) / 255;
            #stack[int, 64] c0 = (cssc::band(p, 255) * keep) / 255;
            #stack[int, 64] np = cssc::bor(cssc::shl(a, 24), cssc::bor(cssc::shl(c16, 16), cssc::bor(cssc::shl(c8, 8), c0)));
            cssc::poke32(buf + i * 4, np);
            #delete[p];
            #delete[a];
            #delete[c16];
            #delete[c8];
            #delete[c0];
            #delete[np];
            i = i + 1;
        }
        #delete[i];
        #delete[tot];
        #delete[buf];
        #delete[w];
        #delete[hh];
        #delete[keep];
    }
    #delete[run];
    #delete[am];
}

// drawGlyph(handle,x,y,ch,argb,scale): one 8x8 glyph, LSB-first bit order,
// scale x scale blocks. ch<32 or >127 -> hollow 8x8 box placeholder.
#define(ciVidGlyph) {
    #scanp(ciVidGlyph, int, 0) hd;
    #scanp(ciVidGlyph, int, 1) x;
    #scanp(ciVidGlyph, int, 2) y;
    #scanp(ciVidGlyph, int, 3) ch;
    #scanp(ciVidGlyph, int, 4) argb;
    #scanp(ciVidGlyph, int, 5) scale;
    #req[ciVidStore] ciVidStore;
    #req[ciFont] ciFont;
    #stack[int, 64] sc = scale;
    if (sc < 1) { sc = 1; }
    #stack[int, 32] hollow = 0;
    if (ch < 32) { hollow = 1; }
    if (ch > 127) { hollow = 1; }
    #stack[int, 64] gy = 0;
    while (gy < 8) {
        #stack[int, 64] row = 0;
        if (hollow == 0) {
            #stack[int, 64] word = cssc::peek64(ciFont + (ch - 32) * 8);
            row = cssc::band(cssc::shr(word, gy * 8), 255);
            #delete[word];
        }
        #stack[int, 64] gx = 0;
        while (gx < 8) {
            #stack[int, 32] on = 0;
            if (hollow == 1) {
                if (gy == 0) { on = 1; }
                if (gy == 7) { on = 1; }
                if (gx == 0) { on = 1; }
                if (gx == 7) { on = 1; }
            }
            if (hollow == 0) {
                if (cssc::band(cssc::shr(row, gx), 1) == 1) { on = 1; }
            }
            if (on == 1) {
                #stack[int, 64] sy = 0;
                while (sy < sc) {
                    #stack[int, 64] sx = 0;
                    while (sx < sc) {
                        ciVidStore(hd, x + gx * sc + sx, y + gy * sc + sy, argb);
                        sx = sx + 1;
                    }
                    #delete[sx];
                    sy = sy + 1;
                }
                #delete[sy];
            }
            #delete[on];
            gx = gx + 1;
        }
        #delete[gx];
        #delete[row];
        gy = gy + 1;
    }
    #delete[gy];
    #delete[hollow];
    #delete[sc];
}

// drawText(handle,x,y,strPtr,argb,scale): '\n' resets x and advances 10*scale;
// each glyph advances 8*scale (no inter-char gap).
#define(ciVidText) {
    #scanp(ciVidText, int, 0) hd;
    #scanp(ciVidText, int, 1) x;
    #scanp(ciVidText, int, 2) y;
    #scanp(ciVidText, int, 3) sp;
    #scanp(ciVidText, int, 4) argb;
    #scanp(ciVidText, int, 5) scale;
    #req[ciVidGlyph] ciVidGlyph;
    #stack[int, 64] sc = scale;
    if (sc < 1) { sc = 1; }
    #stack[int, 64] slen = cssc::peek32(sp + 4);
    #stack[int, 64] cx = x;
    #stack[int, 64] cy = y;
    #stack[int, 64] i = 0;
    while (i < slen) {
        #stack[int, 64] ch = cssc::peek8(sp + 8 + i);
        #stack[int, 32] nl = 0;
        if (ch == 10) { nl = 1; }
        if (nl == 1) { cx = x; cy = cy + 10 * sc; }
        if (nl == 0) {
            ciVidGlyph(hd, cx, cy, ch, argb, sc);
            cx = cx + 8 * sc;
        }
        #delete[nl];
        #delete[ch];
        i = i + 1;
    }
    #delete[i];
    #delete[cx];
    #delete[cy];
    #delete[slen];
    #delete[sc];
}

// present(handle): nearest-neighbor integer-scaled, centered blit of the
// backbuffer to the real framebuffer. The stored word already encodes native's
// displayed (R<->B-swapped) color; write its low 24 bits as XRGB8888.
#define(ciVidPresent) {
    #scanp(ciVidPresent, int, 0) hd;
    #stack[int, 64] w = cssc::peek32(hd);
    #stack[int, 64] hh = cssc::peek32(hd + 4);
    #stack[int, 64] buf = cssc::peek64(hd + 16);
    #stack[int, 64] fbA = cssc::fbAddr();
    #stack[int, 64] fbP = cssc::fbPitch();
    #stack[int, 64] SW = cssc::fbWidth();
    #stack[int, 64] SH = cssc::fbHeight();
    #stack[int, 64] s = SW / w;
    #stack[int, 64] s2 = SH / hh;
    if (s2 < s) { s = s2; }
    if (s < 1) { s = 1; }
    #stack[int, 64] ox = (SW - w * s) / 2;
    #stack[int, 64] oy = (SH - hh * s) / 2;
    // publish the mapping so cssc::mouseX/Y can invert it (fb cursor -> backbuffer)
    #req[ciVidScale] ciVidScale;
    #req[ciVidOffX] ciVidOffX;
    #req[ciVidOffY] ciVidOffY;
    ciVidScale = s;
    ciVidOffX = ox;
    ciVidOffY = oy;
    #stack[int, 64] sy = 0;
    while (sy < hh) {
        #stack[int, 64] sx = 0;
        while (sx < w) {
            #stack[int, 64] stored = cssc::peek32(buf + (sy * w + sx) * 4);
            #stack[int, 64] fbWord = cssc::band(stored, 16777215);
            #stack[int, 64] dy = 0;
            while (dy < s) {
                #stack[int, 64] dx = 0;
                while (dx < s) {
                    #stack[int, 64] X = ox + sx * s + dx;
                    #stack[int, 64] Y = oy + sy * s + dy;
                    cssc::poke32(fbA + Y * fbP + X * 4, fbWord);
                    #delete[X];
                    #delete[Y];
                    dx = dx + 1;
                }
                #delete[dx];
                dy = dy + 1;
            }
            #delete[dy];
            #delete[stored];
            #delete[fbWord];
            sx = sx + 1;
        }
        #delete[sx];
        sy = sy + 1;
    }
    #delete[sy];
    #delete[s];
    #delete[s2];
    #delete[ox];
    #delete[oy];
    #delete[w];
    #delete[hh];
    #delete[buf];
    #delete[fbA];
    #delete[fbP];
    #delete[SW];
    #delete[SH];
}

// ---- gfx: sign-extend a peek32'd i32 (peek32 zero-extends; tile ids are signed) ----
#define(ciSext32) {
    #scanp(ciSext32, int, 0) v;
    #stack[int, 64] out = v;
    #stack[int, 64] hb = cssc::shl(1, 31);
    if (v >= hb) { out = v - cssc::shl(1, 32); }
    #delete[hb];
    return out;
}

// ---- gfx: BMP24/32 loader. Reads CCFS file named by string value `pathPtr`, returns a
// fresh w*h*4 RAW-ARGB buffer, publishes ciBmpW/ciBmpH. On any failure -> 1x1 zeroed. ----
#define(ciBmpLoad) {
    #scanp(ciBmpLoad, int, 0) pathPtr;
    #req[fsFind] fsFind;
    #req[fsIdx] fsIdx;
    #req[fsReadPtr] fsReadPtr;
    #req[fsReadLen] fsReadLen;
    #req[ciBmpW] ciBmpW;
    #req[ciBmpH] ciBmpH;
    #stack[int, 64] out = 0;
    #stack[int, 64] buf = 0;
    #stack[int, 64] blen = 0;
    #stack[int, 32] okmagic = 0;
    fsFind(pathPtr + 8, cssc::peek32(pathPtr + 4));
    if (fsIdx >= 0) {
        fsReadPtr(fsIdx) bp; buf = bp; #delete[bp];
        fsReadLen(fsIdx) bl; blen = bl; #delete[bl];
        if (blen >= 54) {
            if (cssc::peek8(buf) == 66) { if (cssc::peek8(buf + 1) == 77) { okmagic = 1; } }
        }
    }
    if (okmagic == 1) {
        #stack[int, 64] pixOff = cssc::peek32(buf + 10);
        #stack[int, 64] width = cssc::peek32(buf + 18);
        #stack[int, 64] hRaw = cssc::peek32(buf + 22);
        #stack[int, 64] bpp = cssc::bor(cssc::peek8(buf + 28), cssc::shl(cssc::peek8(buf + 29), 8));
        #stack[int, 32] flipped = 1;
        #stack[int, 64] height = hRaw;
        #stack[int, 64] hb = cssc::shl(1, 31);
        if (hRaw >= hb) { flipped = 0; height = cssc::shl(1, 32) - hRaw; }
        #delete[hb];
        if (width < 1) { width = 1; }
        if (height < 1) { height = 1; }
        #stack[int, 64] rowBytes = ((width * bpp + 31) / 32) * 4;
        ciBmpW = width;
        ciBmpH = height;
        out = cssc::alloc(width * height * 4);
        cssc::memfill32(out, 0, width * height);
        #stack[int, 64] row = 0;
        while (row < height) {
            #stack[int, 64] srcRow = row;
            if (flipped == 1) { srcRow = height - 1 - row; }
            #stack[int, 64] srcOff = pixOff + srcRow * rowBytes;
            #stack[int, 64] col = 0;
            while (col < width) {
                #stack[int, 64] argb = 0;
                if (bpp == 32) {
                    #stack[int, 64] b = cssc::peek8(srcOff + col * 4);
                    #stack[int, 64] g = cssc::peek8(srcOff + col * 4 + 1);
                    #stack[int, 64] r = cssc::peek8(srcOff + col * 4 + 2);
                    #stack[int, 64] a = cssc::peek8(srcOff + col * 4 + 3);
                    if (a == 0) { a = 255; }
                    argb = cssc::bor(cssc::shl(a, 24), cssc::bor(cssc::shl(r, 16), cssc::bor(cssc::shl(g, 8), b)));
                    #delete[b]; #delete[g]; #delete[r]; #delete[a];
                }
                if (bpp == 24) {
                    #stack[int, 64] b = cssc::peek8(srcOff + col * 3);
                    #stack[int, 64] g = cssc::peek8(srcOff + col * 3 + 1);
                    #stack[int, 64] r = cssc::peek8(srcOff + col * 3 + 2);
                    argb = cssc::bor(cssc::shl(255, 24), cssc::bor(cssc::shl(r, 16), cssc::bor(cssc::shl(g, 8), b)));
                    #delete[b]; #delete[g]; #delete[r];
                }
                cssc::poke32(out + (row * width + col) * 4, argb);
                #delete[argb];
                col = col + 1;
            }
            #delete[col];
            #delete[srcOff];
            #delete[srcRow];
            row = row + 1;
        }
        #delete[row];
        #delete[pixOff]; #delete[width]; #delete[hRaw]; #delete[bpp];
        #delete[flipped]; #delete[height]; #delete[rowBytes];
    }
    if (okmagic == 0) {
        ciBmpW = 1;
        ciBmpH = 1;
        out = cssc::alloc(4);
        cssc::memfill32(out, 0, 1);
    }
    #delete[okmagic];
    #delete[buf];
    #delete[blen];
    return out;
}

// ---- gfx: alloc a 24B sprite {w@0,h@4,keyFlag@8,key@12,data@16}; data zeroed RAW ARGB.
#define(ciSprNew) {
    #scanp(ciSprNew, int, 0) w;
    #scanp(ciSprNew, int, 1) h;
    #scanp(ciSprNew, int, 2) keyFlag;
    #scanp(ciSprNew, int, 3) key;
    #stack[int, 64] ww = w;
    #stack[int, 64] hh = h;
    if (ww < 1) { ww = 1; }
    if (hh < 1) { hh = 1; }
    #stack[int, 64] hd = cssc::alloc(24);
    #stack[int, 64] data = cssc::alloc(ww * hh * 4);
    cssc::memfill32(data, 0, ww * hh);
    cssc::poke32(hd, ww);
    cssc::poke32(hd + 4, hh);
    cssc::poke32(hd + 8, keyFlag);
    cssc::poke32(hd + 12, key);
    cssc::poke64(hd + 16, data);
    #delete[data];
    #delete[ww];
    #delete[hh];
    return hd;
}

// ---- gfx: alloc a 40B sheet {w,h,tileW,tileH,cols,rows,keyFlag,key,data@32}. Shared by
// sprite::sheet*, tilemap tileset*, font sheet. data zeroed RAW ARGB. ----
#define(ciSheetNew) {
    #scanp(ciSheetNew, int, 0) w;
    #scanp(ciSheetNew, int, 1) h;
    #scanp(ciSheetNew, int, 2) tileW;
    #scanp(ciSheetNew, int, 3) tileH;
    #scanp(ciSheetNew, int, 4) keyFlag;
    #scanp(ciSheetNew, int, 5) key;
    #stack[int, 64] ww = w; if (ww < 1) { ww = 1; }
    #stack[int, 64] hh = h; if (hh < 1) { hh = 1; }
    #stack[int, 64] tw = tileW; if (tw < 1) { tw = 1; }
    #stack[int, 64] th = tileH; if (th < 1) { th = 1; }
    #stack[int, 64] cols = ww / tw; if (cols < 1) { cols = 1; }
    #stack[int, 64] rows = hh / th; if (rows < 1) { rows = 1; }
    #stack[int, 64] hd = cssc::alloc(40);
    #stack[int, 64] data = cssc::alloc(ww * hh * 4);
    cssc::memfill32(data, 0, ww * hh);
    cssc::poke32(hd, ww);
    cssc::poke32(hd + 4, hh);
    cssc::poke32(hd + 8, tw);
    cssc::poke32(hd + 12, th);
    cssc::poke32(hd + 16, cols);
    cssc::poke32(hd + 20, rows);
    cssc::poke32(hd + 24, keyFlag);
    cssc::poke32(hd + 28, key);
    cssc::poke64(hd + 32, data);
    #delete[data];
    #delete[ww]; #delete[hh]; #delete[tw]; #delete[th];
    #delete[cols]; #delete[rows];
    return hd;
}

// ---- gfx [[CRIT]]: sprite blit (key-aware, per-pixel clip+swap via ciVidStore) ----
#define(ciSprBlit) {
    #scanp(ciSprBlit, int, 0) spr;
    #scanp(ciSprBlit, int, 1) target;
    #scanp(ciSprBlit, int, 2) x;
    #scanp(ciSprBlit, int, 3) y;
    #req[ciVidStore] ciVidStore;
    #stack[int, 64] w = cssc::peek32(spr);
    #stack[int, 64] h = cssc::peek32(spr + 4);
    #stack[int, 64] keyFlag = cssc::peek32(spr + 8);
    #stack[int, 64] key = cssc::peek32(spr + 12);
    #stack[int, 64] data = cssc::peek64(spr + 16);
    #stack[int, 64] py = 0;
    while (py < h) {
        #stack[int, 64] px = 0;
        while (px < w) {
            #stack[int, 64] pix = cssc::peek32(data + (py * w + px) * 4);
            #stack[int, 32] skip = 0;
            if (keyFlag == 1) { if (pix == key) { skip = 1; } }
            if (skip == 0) { ciVidStore(target, x + px, y + py, pix); }
            #delete[skip];
            #delete[pix];
            px = px + 1;
        }
        #delete[px];
        py = py + 1;
    }
    #delete[py];
    #delete[w]; #delete[h]; #delete[keyFlag]; #delete[key]; #delete[data];
}

// ---- gfx [[CRIT]]: draw tile `index` of a sheet (main.cssc:839 player draw) ----
#define(ciSheetDrawFrame) {
    #scanp(ciSheetDrawFrame, int, 0) sheet;
    #scanp(ciSheetDrawFrame, int, 1) target;
    #scanp(ciSheetDrawFrame, int, 2) x;
    #scanp(ciSheetDrawFrame, int, 3) y;
    #scanp(ciSheetDrawFrame, int, 4) index;
    #req[ciVidStore] ciVidStore;
    #stack[int, 64] sw = cssc::peek32(sheet);
    #stack[int, 64] tileW = cssc::peek32(sheet + 8);
    #stack[int, 64] tileH = cssc::peek32(sheet + 12);
    #stack[int, 64] cols = cssc::peek32(sheet + 16);
    #stack[int, 64] keyFlag = cssc::peek32(sheet + 24);
    #stack[int, 64] key = cssc::peek32(sheet + 28);
    #stack[int, 64] data = cssc::peek64(sheet + 32);
    #stack[int, 64] col = index % cols;
    #stack[int, 64] row = index / cols;
    #stack[int, 64] sx0 = col * tileW;
    #stack[int, 64] sy0 = row * tileH;
    #stack[int, 64] py = 0;
    while (py < tileH) {
        #stack[int, 64] px = 0;
        while (px < tileW) {
            #stack[int, 64] pix = cssc::peek32(data + ((sy0 + py) * sw + (sx0 + px)) * 4);
            #stack[int, 32] skip = 0;
            if (keyFlag == 1) { if (pix == key) { skip = 1; } }
            if (skip == 0) { ciVidStore(target, x + px, y + py, pix); }
            #delete[skip];
            #delete[pix];
            px = px + 1;
        }
        #delete[px];
        py = py + 1;
    }
    #delete[py];
    #delete[sw]; #delete[tileW]; #delete[tileH]; #delete[cols];
    #delete[keyFlag]; #delete[key]; #delete[data];
    #delete[col]; #delete[row]; #delete[sx0]; #delete[sy0];
}

// ---- gfx [[CRIT]]: tilemap cull+blit (main.cssc:795 world draw) ----
#define(ciTmDraw) {
    #scanp(ciTmDraw, int, 0) map;
    #scanp(ciTmDraw, int, 1) target;
    #scanp(ciTmDraw, int, 2) camX;
    #scanp(ciTmDraw, int, 3) camY;
    #req[ciVidStore] ciVidStore;
    #req[ciSext32] ciSext32;
    #stack[int, 64] tileset = cssc::peek64(map);
    #stack[int, 32] run = 1;
    if (tileset == 0) { run = 0; }
    if (run == 1) {
        #stack[int, 64] cols = cssc::peek32(map + 8);
        #stack[int, 64] rows = cssc::peek32(map + 12);
        #stack[int, 64] tw = cssc::peek32(map + 16);
        #stack[int, 64] th = cssc::peek32(map + 20);
        #stack[int, 64] data = cssc::peek64(map + 24);
        #stack[int, 64] tsW = cssc::peek32(tileset);
        #stack[int, 64] tsCols = cssc::peek32(tileset + 16);
        #stack[int, 64] tsKeyFlag = cssc::peek32(tileset + 24);
        #stack[int, 64] tsKey = cssc::peek32(tileset + 28);
        #stack[int, 64] tsData = cssc::peek64(tileset + 32);
        #stack[int, 64] vw = cssc::peek32(target);
        #stack[int, 64] vh = cssc::peek32(target + 4);
        #stack[int, 64] r = 0;
        while (r < rows) {
            #stack[int, 64] c = 0;
            while (c < cols) {
                ciSext32(cssc::peek32(data + (r * cols + c) * 4)) idx;
                #stack[int, 32] draw = 1;
                if (idx < 0) { draw = 0; }
                #stack[int, 64] sxp = c * tw - camX;
                #stack[int, 64] syp = r * th - camY;
                if (sxp + tw <= 0) { draw = 0; }
                if (syp + th <= 0) { draw = 0; }
                if (sxp >= vw) { draw = 0; }
                if (syp >= vh) { draw = 0; }
                if (draw == 1) {
                    #stack[int, 64] tcol = idx % tsCols;
                    #stack[int, 64] trow = idx / tsCols;
                    #stack[int, 64] ssx = tcol * tw;
                    #stack[int, 64] ssy = trow * th;
                    #stack[int, 64] py = 0;
                    while (py < th) {
                        #stack[int, 64] px = 0;
                        while (px < tw) {
                            #stack[int, 64] pix = cssc::peek32(tsData + ((ssy + py) * tsW + (ssx + px)) * 4);
                            #stack[int, 32] skip = 0;
                            if (tsKeyFlag == 1) { if (pix == tsKey) { skip = 1; } }
                            if (skip == 0) { ciVidStore(target, sxp + px, syp + py, pix); }
                            #delete[skip];
                            #delete[pix];
                            px = px + 1;
                        }
                        #delete[px];
                        py = py + 1;
                    }
                    #delete[py];
                    #delete[tcol]; #delete[trow]; #delete[ssx]; #delete[ssy];
                }
                #delete[sxp]; #delete[syp];
                #delete[draw];
                #delete[idx];
                c = c + 1;
            }
            #delete[c];
            r = r + 1;
        }
        #delete[r];
        #delete[cols]; #delete[rows]; #delete[tw]; #delete[th]; #delete[data];
        #delete[tsW]; #delete[tsCols]; #delete[tsKeyFlag]; #delete[tsKey]; #delete[tsData];
        #delete[vw]; #delete[vh];
    }
    #delete[run];
    #delete[tileset];
}

// ---- gfx [[CRIT]]: font pixel-width of `sp` (also used by drawWrapped) ----
#define(ciFontMeasure) {
    #scanp(ciFontMeasure, int, 0) font;
    #scanp(ciFontMeasure, int, 1) sp;
    #stack[int, 64] glyphW = cssc::peek32(font);
    #stack[int, 64] kern = cssc::peek32(font + 12);
    #stack[int, 64] scale = cssc::peek32(font + 20);
    #stack[int, 64] advance = (glyphW + kern) * scale;
    #stack[int, 64] slen = cssc::peek32(sp + 4);
    #stack[int, 64] maxw = 0;
    #stack[int, 64] cur = 0;
    #stack[int, 64] i = 0;
    while (i < slen) {
        #stack[int, 64] ch = cssc::peek8(sp + 8 + i);
        if (ch == 10) {
            if (cur > maxw) { maxw = cur; }
            cur = 0;
        }
        if (ch != 10) { cur = cur + advance; }
        #delete[ch];
        i = i + 1;
    }
    #delete[i];
    if (cur > maxw) { maxw = cur; }
    if (maxw > 0) { maxw = maxw - kern * scale; }
    #delete[cur];
    #delete[glyphW]; #delete[kern]; #delete[scale]; #delete[advance]; #delete[slen];
    return maxw;
}

// ---- gfx [[CRIT]]: font blit of `sp` at (x,y) in color argb. mode0 = 5x7 procedural
// (MSB-first over glyphW bits, scale x scale blocks); mode1 = sheet frame per char. ----
#define(ciFontBlit) {
    #scanp(ciFontBlit, int, 0) font;
    #scanp(ciFontBlit, int, 1) target;
    #scanp(ciFontBlit, int, 2) x;
    #scanp(ciFontBlit, int, 3) y;
    #scanp(ciFontBlit, int, 4) sp;
    #scanp(ciFontBlit, int, 5) argb;
    #req[ciVidStore] ciVidStore;
    #req[ciSheetDrawFrame] ciSheetDrawFrame;
    #stack[int, 64] glyphW = cssc::peek32(font);
    #stack[int, 64] glyphH = cssc::peek32(font + 4);
    #stack[int, 64] firstChar = cssc::peek32(font + 8);
    #stack[int, 64] kern = cssc::peek32(font + 12);
    #stack[int, 64] lineGap = cssc::peek32(font + 16);
    #stack[int, 64] scale = cssc::peek32(font + 20);
    #stack[int, 64] mode = cssc::peek32(font + 24);
    #stack[int, 64] glyphs = cssc::peek64(font + 28);
    #stack[int, 64] sheet = cssc::peek64(font + 36);
    #stack[int, 64] advance = (glyphW + kern) * scale;
    #stack[int, 64] lineStep = (glyphH + lineGap) * scale;
    #stack[int, 64] slen = cssc::peek32(sp + 4);
    #stack[int, 64] cx = x;
    #stack[int, 64] cy = y;
    #stack[int, 64] i = 0;
    while (i < slen) {
        #stack[int, 64] ch = cssc::peek8(sp + 8 + i);
        if (ch == 10) { cx = x; cy = cy + lineStep; }
        if (ch != 10) {
            if (mode == 0) {
                #stack[int, 64] gi = ch - firstChar;
                #stack[int, 32] okg = 1;
                if (gi < 0) { okg = 0; }
                if (gi > 94) { okg = 0; }
                if (okg == 1) {
                    #stack[int, 64] word = cssc::peek64(glyphs + gi * 8);
                    #stack[int, 64] rr = 0;
                    while (rr < glyphH) {
                        #stack[int, 64] bits = cssc::band(cssc::shr(word, rr * 8), 255);
                        #stack[int, 64] bb = 0;
                        while (bb < glyphW) {
                            #stack[int, 64] mask = cssc::shl(1, glyphW - 1 - bb);
                            if (cssc::band(bits, mask) != 0) {
                                #stack[int, 64] sy = 0;
                                while (sy < scale) {
                                    #stack[int, 64] sx = 0;
                                    while (sx < scale) {
                                        ciVidStore(target, cx + bb * scale + sx, cy + rr * scale + sy, argb);
                                        sx = sx + 1;
                                    }
                                    #delete[sx];
                                    sy = sy + 1;
                                }
                                #delete[sy];
                            }
                            #delete[mask];
                            bb = bb + 1;
                        }
                        #delete[bb];
                        #delete[bits];
                        rr = rr + 1;
                    }
                    #delete[rr];
                    #delete[word];
                }
                #delete[okg];
                #delete[gi];
            }
            if (mode != 0) {
                ciSheetDrawFrame(sheet, target, cx, cy, ch - firstChar);
            }
            cx = cx + advance;
        }
        #delete[ch];
        i = i + 1;
    }
    #delete[i];
    #delete[cx]; #delete[cy];
    #delete[glyphW]; #delete[glyphH]; #delete[firstChar]; #delete[kern];
    #delete[lineGap]; #delete[scale]; #delete[mode]; #delete[glyphs]; #delete[sheet];
    #delete[advance]; #delete[lineStep]; #delete[slen];
}

// ---- gfx: nearest-neighbor scaled sprite blit ----
#define(ciSprBlitScaled) {
    #scanp(ciSprBlitScaled, int, 0) spr;
    #scanp(ciSprBlitScaled, int, 1) target;
    #scanp(ciSprBlitScaled, int, 2) x;
    #scanp(ciSprBlitScaled, int, 3) y;
    #scanp(ciSprBlitScaled, int, 4) outW;
    #scanp(ciSprBlitScaled, int, 5) outH;
    #req[ciVidStore] ciVidStore;
    #stack[int, 64] w = cssc::peek32(spr);
    #stack[int, 64] h = cssc::peek32(spr + 4);
    #stack[int, 64] keyFlag = cssc::peek32(spr + 8);
    #stack[int, 64] key = cssc::peek32(spr + 12);
    #stack[int, 64] data = cssc::peek64(spr + 16);
    #stack[int, 32] run = 1;
    if (outW <= 0) { run = 0; }
    if (outH <= 0) { run = 0; }
    if (run == 1) {
        #stack[int, 64] oy = 0;
        while (oy < outH) {
            #stack[int, 64] ox = 0;
            while (ox < outW) {
                #stack[int, 64] sx = ox * w / outW;
                #stack[int, 64] sy = oy * h / outH;
                #stack[int, 64] pix = cssc::peek32(data + (sy * w + sx) * 4);
                #stack[int, 32] skip = 0;
                if (keyFlag == 1) { if (pix == key) { skip = 1; } }
                if (skip == 0) { ciVidStore(target, x + ox, y + oy, pix); }
                #delete[skip]; #delete[pix]; #delete[sx]; #delete[sy];
                ox = ox + 1;
            }
            #delete[ox];
            oy = oy + 1;
        }
        #delete[oy];
    }
    #delete[run];
    #delete[w]; #delete[h]; #delete[keyFlag]; #delete[key]; #delete[data];
}

// ---- gfx: per-pixel multiply-tint blit (out.rgb = pix.rgb*tint.rgb/255, alpha kept) ----
#define(ciSprBlitTinted) {
    #scanp(ciSprBlitTinted, int, 0) spr;
    #scanp(ciSprBlitTinted, int, 1) target;
    #scanp(ciSprBlitTinted, int, 2) x;
    #scanp(ciSprBlitTinted, int, 3) y;
    #scanp(ciSprBlitTinted, int, 4) tint;
    #req[ciVidStore] ciVidStore;
    #stack[int, 64] w = cssc::peek32(spr);
    #stack[int, 64] h = cssc::peek32(spr + 4);
    #stack[int, 64] keyFlag = cssc::peek32(spr + 8);
    #stack[int, 64] key = cssc::peek32(spr + 12);
    #stack[int, 64] data = cssc::peek64(spr + 16);
    #stack[int, 64] tr = cssc::band(cssc::shr(tint, 16), 255);
    #stack[int, 64] tg = cssc::band(cssc::shr(tint, 8), 255);
    #stack[int, 64] tb = cssc::band(tint, 255);
    #stack[int, 64] py = 0;
    while (py < h) {
        #stack[int, 64] px = 0;
        while (px < w) {
            #stack[int, 64] pix = cssc::peek32(data + (py * w + px) * 4);
            #stack[int, 32] skip = 0;
            if (keyFlag == 1) { if (pix == key) { skip = 1; } }
            if (skip == 0) {
                #stack[int, 64] pa = cssc::band(cssc::shr(pix, 24), 255);
                #stack[int, 64] pr = cssc::band(cssc::shr(pix, 16), 255) * tr / 255;
                #stack[int, 64] pg = cssc::band(cssc::shr(pix, 8), 255) * tg / 255;
                #stack[int, 64] pb = cssc::band(pix, 255) * tb / 255;
                #stack[int, 64] o = cssc::bor(cssc::shl(pa, 24), cssc::bor(cssc::shl(pr, 16), cssc::bor(cssc::shl(pg, 8), pb)));
                ciVidStore(target, x + px, y + py, o);
                #delete[pa]; #delete[pr]; #delete[pg]; #delete[pb]; #delete[o];
            }
            #delete[skip];
            #delete[pix];
            px = px + 1;
        }
        #delete[px];
        py = py + 1;
    }
    #delete[py];
    #delete[w]; #delete[h]; #delete[keyFlag]; #delete[key]; #delete[data];
    #delete[tr]; #delete[tg]; #delete[tb];
}

// ---- gfx: per-pixel constant-alpha blend blit (reuses ciBlend) ----
#define(ciSprBlitAlpha) {
    #scanp(ciSprBlitAlpha, int, 0) spr;
    #scanp(ciSprBlitAlpha, int, 1) target;
    #scanp(ciSprBlitAlpha, int, 2) x;
    #scanp(ciSprBlitAlpha, int, 3) y;
    #scanp(ciSprBlitAlpha, int, 4) alpha;
    #req[ciVidStore] ciVidStore;
    #req[ciVidLoad] ciVidLoad;
    #req[ciBlend] ciBlend;
    #stack[int, 64] w = cssc::peek32(spr);
    #stack[int, 64] h = cssc::peek32(spr + 4);
    #stack[int, 64] keyFlag = cssc::peek32(spr + 8);
    #stack[int, 64] key = cssc::peek32(spr + 12);
    #stack[int, 64] data = cssc::peek64(spr + 16);
    #stack[int, 64] py = 0;
    while (py < h) {
        #stack[int, 64] px = 0;
        while (px < w) {
            #stack[int, 64] pix = cssc::peek32(data + (py * w + px) * 4);
            #stack[int, 32] skip = 0;
            if (keyFlag == 1) { if (pix == key) { skip = 1; } }
            if (skip == 0) {
                #stack[int, 64] src = cssc::bor(cssc::shl(alpha, 24), cssc::band(pix, 16777215));
                ciVidLoad(target, x + px, y + py) dv;
                ciBlend(src, dv) bl;
                ciVidStore(target, x + px, y + py, bl);
                #delete[src]; #delete[dv]; #delete[bl];
            }
            #delete[skip];
            #delete[pix];
            px = px + 1;
        }
        #delete[px];
        py = py + 1;
    }
    #delete[py];
    #delete[w]; #delete[h]; #delete[keyFlag]; #delete[key]; #delete[data];
}

// ---- gfx: flipped blit (flipX/flipY select source column/row) ----
#define(ciSprBlitFlip) {
    #scanp(ciSprBlitFlip, int, 0) spr;
    #scanp(ciSprBlitFlip, int, 1) target;
    #scanp(ciSprBlitFlip, int, 2) x;
    #scanp(ciSprBlitFlip, int, 3) y;
    #scanp(ciSprBlitFlip, int, 4) flipX;
    #scanp(ciSprBlitFlip, int, 5) flipY;
    #req[ciVidStore] ciVidStore;
    #stack[int, 64] w = cssc::peek32(spr);
    #stack[int, 64] h = cssc::peek32(spr + 4);
    #stack[int, 64] keyFlag = cssc::peek32(spr + 8);
    #stack[int, 64] key = cssc::peek32(spr + 12);
    #stack[int, 64] data = cssc::peek64(spr + 16);
    #stack[int, 64] py = 0;
    while (py < h) {
        #stack[int, 64] px = 0;
        while (px < w) {
            #stack[int, 64] sx = px;
            if (flipX == 1) { sx = w - 1 - px; }
            #stack[int, 64] sy = py;
            if (flipY == 1) { sy = h - 1 - py; }
            #stack[int, 64] pix = cssc::peek32(data + (sy * w + sx) * 4);
            #stack[int, 32] skip = 0;
            if (keyFlag == 1) { if (pix == key) { skip = 1; } }
            if (skip == 0) { ciVidStore(target, x + px, y + py, pix); }
            #delete[skip]; #delete[pix]; #delete[sx]; #delete[sy];
            px = px + 1;
        }
        #delete[px];
        py = py + 1;
    }
    #delete[py];
    #delete[w]; #delete[h]; #delete[keyFlag]; #delete[key]; #delete[data];
}
// ============================================================================
//  KEYBOARD module -- real PS/2 input. The ISR fills a scancode ring buffer
//  (keyBufAddr/keyHead); this module drains it via its OWN tail (ciKbTail,
//  independent of the shell's keyTail) applying make/break codes to a held-by-VK
//  state (ciKbCurr). update() snapshots last frame to ciKbPrev first. Queries
//  return strictly 0/1. Focused == always true on CCOS. See spec section 2.
// ============================================================================

// PS/2 set-1 make scancode (top bit stripped) + E0-ext flag -> VK, else 0.
#define(ciScanToVk) {
    #scanp(ciScanToVk, int, 0) base;
    #scanp(ciScanToVk, int, 1) ext;
    #stack[int, 64] vk = 0;
    if (ext == 1) {
        if (base == 72) { vk = 38; }
        if (base == 80) { vk = 40; }
        if (base == 75) { vk = 37; }
        if (base == 77) { vk = 39; }
        if (base == 29) { vk = 17; }
        if (base == 56) { vk = 18; }
    }
    if (ext == 0) {
        if (base == 1) { vk = 27; }
        if (base == 28) { vk = 13; }
        if (base == 14) { vk = 8; }
        if (base == 15) { vk = 9; }
        if (base == 42) { vk = 16; }
        if (base == 54) { vk = 16; }
        if (base == 29) { vk = 17; }
        if (base == 56) { vk = 18; }
        if (base == 57) { vk = 32; }
        if (base >= 59) { if (base <= 68) { vk = 112 + (base - 59); } }
        if (base == 87) { vk = 122; }
        if (base == 88) { vk = 123; }
        if (base >= 2) { if (base <= 10) { vk = 48 + (base - 1); } }
        if (base == 11) { vk = 48; }
        if (base == 16) { vk = 81; }
        if (base == 17) { vk = 87; }
        if (base == 18) { vk = 69; }
        if (base == 19) { vk = 82; }
        if (base == 20) { vk = 84; }
        if (base == 21) { vk = 89; }
        if (base == 22) { vk = 85; }
        if (base == 23) { vk = 73; }
        if (base == 24) { vk = 79; }
        if (base == 25) { vk = 80; }
        if (base == 30) { vk = 65; }
        if (base == 31) { vk = 83; }
        if (base == 32) { vk = 68; }
        if (base == 33) { vk = 70; }
        if (base == 34) { vk = 71; }
        if (base == 35) { vk = 72; }
        if (base == 36) { vk = 74; }
        if (base == 37) { vk = 75; }
        if (base == 38) { vk = 76; }
        if (base == 44) { vk = 90; }
        if (base == 45) { vk = 88; }
        if (base == 46) { vk = 67; }
        if (base == 47) { vk = 86; }
        if (base == 48) { vk = 66; }
        if (base == 49) { vk = 78; }
        if (base == 50) { vk = 77; }
    }
    return vk;
}

// key name (string ptr) -> VK, case-insensitive exact match. -1 = unknown.
// single-char a-z/A-Z -> VK uppercase ascii; 0-9 -> VK ascii; else name table.
#define(ciNameToVk) {
    #scanp(ciNameToVk, int, 0) sp;
    #req[ciKbNames] ciKbNames;
    #stack[int, 64] vk = 0 - 1;
    #stack[int, 64] len = cssc::peek32(sp + 4);
    if (len == 1) {
        #stack[int, 64] c = cssc::peek8(sp + 8);
        #stack[int, 64] lc = c;
        if (c >= 65) { if (c <= 90) { lc = c + 32; } }
        if (lc >= 97) { if (lc <= 122) { vk = lc - 32; } }
        if (c >= 48) { if (c <= 57) { vk = c; } }
        #delete[c];
        #delete[lc];
    }
    if (len != 1) {
        #stack[int, 64] p = ciKbNames;
        #stack[int, 32] scanning = 1;
        while (scanning == 1) {
            #stack[int, 64] rlen = cssc::peek8(p);
            if (rlen == 0) { scanning = 0; }
            if (rlen != 0) {
                #stack[int, 64] rvk = cssc::peek8(p + 1);
                #stack[int, 32] match = 0;
                if (rlen == len) {
                    match = 1;
                    #stack[int, 64] j = 0;
                    while (j < len) {
                        #stack[int, 64] a = cssc::peek8(sp + 8 + j);
                        #stack[int, 64] b = cssc::peek8(p + 2 + j);
                        if (a >= 97) { if (a <= 122) { a = a - 32; } }
                        if (a != b) { match = 0; }
                        #delete[a];
                        #delete[b];
                        j = j + 1;
                    }
                    #delete[j];
                }
                if (match == 1) { vk = rvk; scanning = 0; }
                if (match == 0) { p = p + 2 + rlen; }
                #delete[match];
                #delete[rvk];
            }
            #delete[rlen];
        }
        #delete[p];
        #delete[scanning];
    }
    #delete[len];
    return vk;
}

// update(): snapshot curr->prev, then drain the scancode ring since ciKbTail,
// applying make (held=1) / break (held=0) to ciKbCurr[vk]. E0 prefix latches.
#define(ciKbUpdate) {
    #req[ciKbCurr] ciKbCurr;
    #req[ciKbPrev] ciKbPrev;
    #req[ciKbEdge] ciKbEdge;
    #req[ciKbTail] ciKbTail;
    #req[ciKbExt] ciKbExt;
    #req[ciScanToVk] ciScanToVk;
    #req[keyBufAddr] keyBufAddr;
    #req[keyHead] keyHead;
    cssc::memcopy(ciKbPrev, ciKbCurr, 64);
    // clear the per-frame press latch; a make below re-sets it and a same-frame
    // break does NOT clear it, so taps survive slow frames (see ciKbEdge decl)
    cssc::memfill32(ciKbEdge, 0, 64);
    #stack[int, 64] hd = keyHead;
    while (ciKbTail < hd) {
        #stack[int, 64] sc = cssc::peek8(keyBufAddr + ciKbTail % 256);
        ciKbTail = ciKbTail + 1;
        #stack[int, 32] consumed = 0;
        if (sc == 224) { ciKbExt = 1; consumed = 1; }
        if (consumed == 0) {
            #stack[int, 64] rel = 0;
            #stack[int, 64] base = sc;
            if (sc >= 128) { rel = 1; base = sc - 128; }
            ciScanToVk(base, ciKbExt) vk;
            if (vk > 0) {
                #stack[int, 64] v = 1;
                if (rel == 1) { v = 0; }
                cssc::poke8(ciKbCurr + vk, v);
                if (rel == 0) { cssc::poke8(ciKbEdge + vk, 1); }
                #delete[v];
            }
            ciKbExt = 0;
            #delete[vk];
            #delete[rel];
            #delete[base];
        }
        #delete[consumed];
        #delete[sc];
    }
    #delete[hd];
}

// getKey(): canonical UPPERCASE name (owned string) of the first held key in
// table order, then A-Z, then 0-9; "" (empty owned string) if none held.
#define(ciKbGetKey) {
    #req[ciKbNames] ciKbNames;
    #req[ciKbCurr] ciKbCurr;
    #req[ciStrNew] ciStrNew;
    #stack[int, 64] outp = 0;
    #stack[int, 32] found = 0;
    // named keys (table order; skip the RETURN/ESCAPE aliases via vk dedupe not
    // needed -- canonical precedes them, so first-held wins)
    #stack[int, 64] p = ciKbNames;
    #stack[int, 32] scanning = 1;
    while (scanning == 1) {
        #stack[int, 64] rlen = cssc::peek8(p);
        if (rlen == 0) { scanning = 0; }
        if (rlen != 0) {
            #stack[int, 64] rvk = cssc::peek8(p + 1);
            if (found == 0) {
                if (cssc::peek8(ciKbCurr + rvk) == 1) {
                    ciStrNew(p + 2, rlen) s;
                    outp = s;
                    found = 1;
                    #delete[s];
                }
            }
            p = p + 2 + rlen;
            #delete[rvk];
        }
        #delete[rlen];
    }
    #delete[p];
    #delete[scanning];
    // A-Z (VK 0x41..0x5A) then 0-9 (VK 0x30..0x39): single-char names
    #stack[int, 64] k = 65;
    while (k <= 90) {
        if (found == 0) {
            if (cssc::peek8(ciKbCurr + k) == 1) {
                #stack[int, 64] tmp = cssc::alloc(1);
                cssc::poke8(tmp, k);
                ciStrNew(tmp, 1) s;
                outp = s;
                found = 1;
                cssc::free(tmp);
                #delete[tmp];
                #delete[s];
            }
        }
        k = k + 1;
    }
    #delete[k];
    #stack[int, 64] d = 48;
    while (d <= 57) {
        if (found == 0) {
            if (cssc::peek8(ciKbCurr + d) == 1) {
                #stack[int, 64] tmp = cssc::alloc(1);
                cssc::poke8(tmp, d);
                ciStrNew(tmp, 1) s;
                outp = s;
                found = 1;
                cssc::free(tmp);
                #delete[tmp];
                #delete[s];
            }
        }
        d = d + 1;
    }
    #delete[d];
    if (found == 0) { ciStrNew(ciKbNames, 0) e; outp = e; #delete[e]; }
    #delete[found];
    return outp;
}

// ============================================================================
//  SOUND module -- INERT return-correct stub (no audio engine on bare metal).
//  Exact signatures/returns so guest code runs unchanged; produces no sound.
//  32 slots {path@0 i64, alias@8 i64}; nextId + volume. See spec section 3.
// ============================================================================

// load(path): first free slot gets path; returns owned alias "cssc"+nextId then
// nextId++. Empty string on null path / table full. (isPlaying stays 0.)
#define(ciSndLoad) {
    #scanp(ciSndLoad, int, 0) pathPtr;
    #req[ciSndSlots] ciSndSlots;
    #req[ciSndNextId] ciSndNextId;
    #req[ciStrNew] ciStrNew;
    #req[ciStrClone] ciStrClone;
    #req[ciItoa] ciItoa;
    #stack[int, 64] out = 0;
    #stack[int, 32] fail = 0;
    if (pathPtr == 0) { fail = 1; }
    #stack[int, 64] slot = 0 - 1;
    if (fail == 0) {
        #stack[int, 64] i = 0;
        while (i < 32) {
            if (slot < 0) {
                if (cssc::peek64(ciSndSlots + i * 16) == 0) { slot = i; }
            }
            i = i + 1;
        }
        #delete[i];
        if (slot < 0) { fail = 1; }
    }
    if (fail == 1) {
        ciStrNew(ciSndSlots, 0) e;
        out = e;
        #delete[e];
    }
    if (fail == 0) {
        ciStrClone(pathPtr) pc;
        cssc::poke64(ciSndSlots + slot * 16, pc);
        #delete[pc];
        #stack[int, 64] id = ciSndNextId;
        ciSndNextId = ciSndNextId + 1;
        #stack[int, 64] buf = cssc::alloc(24);
        cssc::poke8(buf, 99);
        cssc::poke8(buf + 1, 115);
        cssc::poke8(buf + 2, 115);
        cssc::poke8(buf + 3, 99);
        ciItoa(id, buf + 4) dn;
        ciStrNew(buf, 4 + dn) alias;
        ciStrClone(alias) ac;
        cssc::poke64(ciSndSlots + slot * 16 + 8, ac);
        out = alias;
        cssc::free(buf);
        #delete[ac];
        #delete[alias];
        #delete[dn];
        #delete[id];
        #delete[buf];
    }
    #delete[fail];
    #delete[slot];
    return out;
}
// ============================================================================
//  INI module -- REAL, backed by CCFS. cssc_ini.c parity: case-sensitive,
//  ';'/'#' inline comments, \r-tolerant, isspace trim, first-match-wins read,
//  default-on-miss, key=value (no spaces) writes. Spec section 4.
// ============================================================================

// isspace: space \t \n \v \f \r.
#define(ciIniWs) {
    #scanp(ciIniWs, int, 0) c;
    #stack[int, 32] w = 0;
    if (c == 32) { w = 1; }
    if (c == 9) { w = 1; }
    if (c == 10) { w = 1; }
    if (c == 11) { w = 1; }
    if (c == 12) { w = 1; }
    if (c == 13) { w = 1; }
    return w;
}

// section header match on the trimmed line [ts,te): skip leading spaces, require
// '[', take to first ']', exact case-sensitive length compare against sctP/sctL.
#define(ciIniSectMatch) {
    #scanp(ciIniSectMatch, int, 0) buf;
    #scanp(ciIniSectMatch, int, 1) ts;
    #scanp(ciIniSectMatch, int, 2) te;
    #scanp(ciIniSectMatch, int, 3) sctP;
    #scanp(ciIniSectMatch, int, 4) sctL;
    #stack[int, 32] ok = 0;
    #stack[int, 64] p = ts;
    #stack[int, 32] sk = 1;
    while (sk == 1) {
        sk = 0;
        if (p < te) { if (cssc::peek8(buf + p) == 32) { p = p + 1; sk = 1; } }
    }
    #delete[sk];
    if (p < te) {
        if (cssc::peek8(buf + p) == 91) {
            p = p + 1;
            #stack[int, 64] ns = p;
            #stack[int, 32] fin = 0;
            while (fin == 0) {
                if (p >= te) { fin = 1; }
                if (fin == 0) { if (cssc::peek8(buf + p) == 93) { fin = 1; } }
                if (fin == 0) { p = p + 1; }
            }
            #delete[fin];
            #stack[int, 64] nl = p - ns;
            if (nl == sctL) {
                ok = 1;
                #stack[int, 64] j = 0;
                while (j < nl) {
                    if (cssc::peek8(buf + ns + j) != cssc::peek8(sctP + j)) { ok = 0; }
                    j = j + 1;
                }
                #delete[j];
            }
            #delete[nl];
            #delete[ns];
        }
    }
    #delete[p];
    return ok;
}

// line scan for read/hasKey: on the FIRST matching key in the matching section,
// copy the trimmed value into ciIniVal (len -> ciIniValLen) and return 1.
#define(ciIniLookup) {
    #scanp(ciIniLookup, int, 0) buf;
    #scanp(ciIniLookup, int, 1) len;
    #scanp(ciIniLookup, int, 2) sctP;
    #scanp(ciIniLookup, int, 3) sctL;
    #scanp(ciIniLookup, int, 4) keyP;
    #scanp(ciIniLookup, int, 5) keyL;
    #req[ciIniWs] ciIniWs;
    #req[ciIniSectMatch] ciIniSectMatch;
    #req[ciIniVal] ciIniVal;
    #req[ciIniValLen] ciIniValLen;
    #stack[int, 64] pos = 0;
    #stack[int, 32] inSect = 0;
    #stack[int, 32] hit = 0;
    while (pos < len) {
        if (hit == 1) { pos = len; }
        if (hit == 0) {
            #stack[int, 64] ls = pos;
            #stack[int, 64] le = pos;
            #stack[int, 32] fe = 0;
            while (fe == 0) {
                if (le >= len) { fe = 1; }
                if (fe == 0) {
                    #stack[int, 64] ch = cssc::peek8(buf + le);
                    if (ch == 10) { fe = 1; }
                    if (ch == 0) { fe = 1; }
                    #delete[ch];
                }
                if (fe == 0) { le = le + 1; }
            }
            #delete[fe];
            #stack[int, 64] ce = ls;
            #stack[int, 32] fc = 0;
            while (fc == 0) {
                if (ce >= le) { fc = 1; }
                if (fc == 0) {
                    #stack[int, 64] ch = cssc::peek8(buf + ce);
                    if (ch == 59) { fc = 1; }
                    if (ch == 35) { fc = 1; }
                    #delete[ch];
                }
                if (fc == 0) { ce = ce + 1; }
            }
            #delete[fc];
            #stack[int, 64] ts = ls;
            #stack[int, 64] te = ce;
            #stack[int, 32] t1 = 1;
            while (t1 == 1) {
                t1 = 0;
                if (ts < te) { ciIniWs(cssc::peek8(buf + ts)) w; if (w == 1) { ts = ts + 1; t1 = 1; } #delete[w]; }
            }
            #stack[int, 32] t2 = 1;
            while (t2 == 1) {
                t2 = 0;
                if (te > ts) { ciIniWs(cssc::peek8(buf + te - 1)) w; if (w == 1) { te = te - 1; t2 = 1; } #delete[w]; }
            }
            #delete[t1];
            #delete[t2];
            if (te > ts) {
                #stack[int, 64] first = cssc::peek8(buf + ts);
                if (first == 91) {
                    ciIniSectMatch(buf, ts, te, sctP, sctL) sm;
                    inSect = sm;
                    #delete[sm];
                }
                if (first != 91) {
                    if (inSect == 1) {
                        #stack[int, 64] eq = ts;
                        #stack[int, 32] fq = 0;
                        while (fq == 0) {
                            if (eq >= te) { fq = 1; }
                            if (fq == 0) { if (cssc::peek8(buf + eq) == 61) { fq = 1; } }
                            if (fq == 0) { eq = eq + 1; }
                        }
                        #delete[fq];
                        if (eq < te) {
                            #stack[int, 64] ke = eq;
                            #stack[int, 32] kt = 1;
                            while (kt == 1) {
                                kt = 0;
                                if (ke > ts) { ciIniWs(cssc::peek8(buf + ke - 1)) w; if (w == 1) { ke = ke - 1; kt = 1; } #delete[w]; }
                            }
                            #delete[kt];
                            #stack[int, 64] kl2 = ke - ts;
                            #stack[int, 32] km = 0;
                            if (kl2 == keyL) {
                                km = 1;
                                #stack[int, 64] j = 0;
                                while (j < kl2) {
                                    if (cssc::peek8(buf + ts + j) != cssc::peek8(keyP + j)) { km = 0; }
                                    j = j + 1;
                                }
                                #delete[j];
                            }
                            if (km == 1) {
                                #stack[int, 64] vs = eq + 1;
                                #stack[int, 32] vsk = 1;
                                while (vsk == 1) {
                                    vsk = 0;
                                    if (vs < te) {
                                        #stack[int, 64] c = cssc::peek8(buf + vs);
                                        if (c == 32) { vs = vs + 1; vsk = 1; }
                                        if (c == 9) { vs = vs + 1; vsk = 1; }
                                        #delete[c];
                                    }
                                }
                                #delete[vsk];
                                #stack[int, 64] ve = te;
                                #stack[int, 32] vt = 1;
                                while (vt == 1) {
                                    vt = 0;
                                    if (ve > vs) { ciIniWs(cssc::peek8(buf + ve - 1)) w; if (w == 1) { ve = ve - 1; vt = 1; } #delete[w]; }
                                }
                                #delete[vt];
                                #stack[int, 64] vl = ve - vs;
                                if (vl > 1023) { vl = 1023; }
                                #stack[int, 64] j = 0;
                                while (j < vl) {
                                    cssc::poke8(ciIniVal + j, cssc::peek8(buf + vs + j));
                                    j = j + 1;
                                }
                                #delete[j];
                                ciIniValLen = vl;
                                hit = 1;
                                #delete[vs];
                                #delete[ve];
                                #delete[vl];
                            }
                            #delete[km];
                            #delete[kl2];
                            #delete[ke];
                        }
                        #delete[eq];
                    }
                }
                #delete[first];
            }
            #delete[ts];
            #delete[te];
            #delete[ce];
            pos = le;
            if (pos < len) { if (cssc::peek8(buf + pos) == 10) { pos = pos + 1; } }
            #delete[ls];
            #delete[le];
        }
    }
    #delete[pos];
    #delete[inSect];
    return hit;
}

// emit n verbatim bytes from src to ciIniOut+off; returns new offset.
#define(ciIniPut) {
    #scanp(ciIniPut, int, 0) off;
    #scanp(ciIniPut, int, 1) src;
    #scanp(ciIniPut, int, 2) n;
    #req[ciIniOut] ciIniOut;
    #stack[int, 64] i = 0;
    while (i < n) {
        cssc::poke8(ciIniOut + off + i, cssc::peek8(src + i));
        i = i + 1;
    }
    #delete[i];
    return off + n;
}

// emit "key=value" (no spaces) + optional '\n' to ciIniOut+off; new offset.
#define(ciIniEmitKV) {
    #scanp(ciIniEmitKV, int, 0) off;
    #scanp(ciIniEmitKV, int, 1) keyP;
    #scanp(ciIniEmitKV, int, 2) keyL;
    #scanp(ciIniEmitKV, int, 3) valP;
    #scanp(ciIniEmitKV, int, 4) valL;
    #scanp(ciIniEmitKV, int, 5) addNL;
    #req[ciIniOut] ciIniOut;
    #stack[int, 64] o = off;
    #stack[int, 64] i = 0;
    while (i < keyL) {
        cssc::poke8(ciIniOut + o, cssc::peek8(keyP + i));
        o = o + 1;
        i = i + 1;
    }
    #delete[i];
    cssc::poke8(ciIniOut + o, 61);
    o = o + 1;
    #stack[int, 64] j = 0;
    while (j < valL) {
        cssc::poke8(ciIniOut + o, cssc::peek8(valP + j));
        o = o + 1;
        j = j + 1;
    }
    #delete[j];
    if (addNL == 1) {
        cssc::poke8(ciIniOut + o, 10);
        o = o + 1;
    }
    return o;
}

// write(path,section,key,value): byte-preserving rewrite. Overwrite an existing
// key in the section; else insert before the next header; else append the
// section and/or key at EOF (leading '\n' only if the file didn't end in one).
// Returns 1 on store success, 0 on failure. Spec section 4.4.
// does the ini text contain a `[section]` header? Same line-scan/trim rules as
// ciIniLookup (comments after ; or # stripped, surrounding whitespace ignored),
// but it only ever looks at section headers.
#stack[int, 64] ciIniHasSection;
#define(ciIniHasSection) {
    #scanp(ciIniHasSection, int, 0) buf;
    #scanp(ciIniHasSection, int, 1) len;
    #scanp(ciIniHasSection, int, 2) sctP;
    #scanp(ciIniHasSection, int, 3) sctL;
    #req[ciIniWs] ciIniWs;
    #req[ciIniSectMatch] ciIniSectMatch;
    #stack[int, 64] pos = 0;
    #stack[int, 32] hit = 0;
    while (pos < len) {
        if (hit == 1) { pos = len; }
        if (hit == 0) {
            #stack[int, 64] ls = pos;
            #stack[int, 64] le = pos;
            #stack[int, 32] fe = 0;
            while (fe == 0) {
                if (le >= len) { fe = 1; }
                if (fe == 0) {
                    #stack[int, 64] ch = cssc::peek8(buf + le);
                    if (ch == 10) { fe = 1; }
                    if (ch == 0) { fe = 1; }
                    #delete[ch];
                }
                if (fe == 0) { le = le + 1; }
            }
            #delete[fe];
            #stack[int, 64] ce = ls;                 // strip a trailing comment
            #stack[int, 32] fc = 0;
            while (fc == 0) {
                if (ce >= le) { fc = 1; }
                if (fc == 0) {
                    #stack[int, 64] ch = cssc::peek8(buf + ce);
                    if (ch == 59) { fc = 1; }
                    if (ch == 35) { fc = 1; }
                    #delete[ch];
                }
                if (fc == 0) { ce = ce + 1; }
            }
            #delete[fc];
            #stack[int, 64] ts = ls;                 // trim both ends
            #stack[int, 64] te = ce;
            #stack[int, 32] t1 = 1;
            while (t1 == 1) {
                t1 = 0;
                if (ts < te) { ciIniWs(cssc::peek8(buf + ts)) w; if (w == 1) { ts = ts + 1; t1 = 1; } #delete[w]; }
            }
            #stack[int, 32] t2 = 1;
            while (t2 == 1) {
                t2 = 0;
                if (te > ts) { ciIniWs(cssc::peek8(buf + te - 1)) w; if (w == 1) { te = te - 1; t2 = 1; } #delete[w]; }
            }
            #delete[t1];
            #delete[t2];
            if (te > ts) {
                if (cssc::peek8(buf + ts) == 91) {   // '[' -> a section header
                    ciIniSectMatch(buf, ts, te, sctP, sctL) sm;
                    if (sm == 1) { hit = 1; }
                    #delete[sm];
                }
            }
            #delete[te];
            #delete[ts];
            #delete[ce];
            #delete[ls];
            pos = le + 1;
            #delete[le];
        }
    }
    #stack[int, 32] r = hit;
    #delete[hit];
    #delete[pos];
    return r;
}

// append a `[section]` header to an ini file (creating the file if needed).
// Returns 1 if the section exists afterwards, 0 on failure. Idempotent: an
// already-present section is left untouched.
#stack[int, 64] ciIniAddSection;
#define(ciIniAddSection) {
    #scanp(ciIniAddSection, int, 0) pathStr;
    #scanp(ciIniAddSection, int, 1) sectStr;
    #req[fsFind] fsFind;
    #req[fsIdx] fsIdx;
    #req[fsCreate] fsCreate;
    #req[fsReadPtr] fsReadPtr;
    #req[fsReadLen] fsReadLen;
    #req[fsStore] fsStore;
    #req[ciIniHasSection] ciIniHasSection;
    #stack[int, 64] sctP = sectStr + 8;
    #stack[int, 64] sctL = cssc::peek32(sectStr + 4);
    fsCreate(pathStr + 8, cssc::peek32(pathStr + 4));
    #stack[int, 64] r = 0;
    if (fsIdx >= 0) {
        #stack[int, 64] idx = fsIdx;
        fsReadPtr(idx) bp;
        fsReadLen(idx) bl;
        ciIniHasSection(bp, bl, sctP, sctL) has;
        if (has == 1) { r = 1; }
        if (has == 0) {
            // old content + optional separating newline + "[sect]\n"
            #stack[int, 64] nb = cssc::alloc(bl + sctL + 4);
            #stack[int, 64] w = 0;
            while (w < bl) { cssc::poke8(nb + w, cssc::peek8(bp + w)); w = w + 1; }
            if (bl > 0) {
                if (cssc::peek8(bp + bl - 1) != 10) { cssc::poke8(nb + w, 10); w = w + 1; }
            }
            cssc::poke8(nb + w, 91); w = w + 1;              // '['
            #stack[int, 64] j = 0;
            while (j < sctL) { cssc::poke8(nb + w, cssc::peek8(sctP + j)); w = w + 1; j = j + 1; }
            #delete[j];
            cssc::poke8(nb + w, 93); w = w + 1;              // ']'
            cssc::poke8(nb + w, 10); w = w + 1;              // '\n'
            fsStore(idx, nb, w);
            cssc::free(nb);
            r = 1;
            #delete[w];
            #delete[nb];
        }
        #delete[has];
        #delete[bp];
        #delete[bl];
        #delete[idx];
    }
    #delete[sctL];
    #delete[sctP];
    return r;
}

#define(ciIniWriteKey) {
    #scanp(ciIniWriteKey, int, 0) pathStr;
    #scanp(ciIniWriteKey, int, 1) sectStr;
    #scanp(ciIniWriteKey, int, 2) keyStr;
    #scanp(ciIniWriteKey, int, 3) valStr;
    #req[fsFind] fsFind;
    #req[fsIdx] fsIdx;
    #req[fsCreate] fsCreate;
    #req[fsReadPtr] fsReadPtr;
    #req[fsReadLen] fsReadLen;
    #req[fsStore] fsStore;
    #req[ciIniWs] ciIniWs;
    #req[ciIniSectMatch] ciIniSectMatch;
    #req[ciIniPut] ciIniPut;
    #req[ciIniEmitKV] ciIniEmitKV;
    #req[ciIniOut] ciIniOut;
    #stack[int, 64] sctP = sectStr + 8;
    #stack[int, 64] sctL = cssc::peek32(sectStr + 4);
    #stack[int, 64] keyP = keyStr + 8;
    #stack[int, 64] keyL = cssc::peek32(keyStr + 4);
    #stack[int, 64] valP = 0;
    #stack[int, 64] valL = 0;
    if (valStr != 0) { valP = valStr + 8; valL = cssc::peek32(valStr + 4); }
    fsFind(pathStr + 8, cssc::peek32(pathStr + 4));
    #stack[int, 64] idx = fsIdx;
    if (idx < 0) {
        fsCreate(pathStr + 8, cssc::peek32(pathStr + 4));
        idx = fsIdx;
    }
    #stack[int, 64] buf = 0;
    #stack[int, 64] len = 0;
    if (idx >= 0) {
        fsReadPtr(idx) bp;
        buf = bp;
        #delete[bp];
        fsReadLen(idx) bl;
        len = bl;
        #delete[bl];
    }
    #stack[int, 64] op = 0;
    #stack[int, 32] inTarget = 0;
    #stack[int, 32] wroteKey = 0;
    #stack[int, 32] sawTarget = 0;
    #stack[int, 64] pos = 0;
    while (pos < len) {
        #stack[int, 64] ls = pos;
        #stack[int, 64] le = pos;
        #stack[int, 32] fe = 0;
        while (fe == 0) {
            if (le >= len) { fe = 1; }
            if (fe == 0) {
                #stack[int, 64] ch = cssc::peek8(buf + le);
                if (ch == 10) { fe = 1; }
                if (ch == 0) { fe = 1; }
                #delete[ch];
            }
            if (fe == 0) { le = le + 1; }
        }
        #delete[fe];
        #stack[int, 64] rle = le;
        if (rle < len) { if (cssc::peek8(buf + rle) == 10) { rle = rle + 1; } }
        // classify: comment-cut + trim -> [ts,te)
        #stack[int, 64] ce = ls;
        #stack[int, 32] fc = 0;
        while (fc == 0) {
            if (ce >= le) { fc = 1; }
            if (fc == 0) {
                #stack[int, 64] ch = cssc::peek8(buf + ce);
                if (ch == 59) { fc = 1; }
                if (ch == 35) { fc = 1; }
                #delete[ch];
            }
            if (fc == 0) { ce = ce + 1; }
        }
        #delete[fc];
        #stack[int, 64] ts = ls;
        #stack[int, 64] te = ce;
        #stack[int, 32] t1 = 1;
        while (t1 == 1) {
            t1 = 0;
            if (ts < te) { ciIniWs(cssc::peek8(buf + ts)) w; if (w == 1) { ts = ts + 1; t1 = 1; } #delete[w]; }
        }
        #stack[int, 32] t2 = 1;
        while (t2 == 1) {
            t2 = 0;
            if (te > ts) { ciIniWs(cssc::peek8(buf + te - 1)) w; if (w == 1) { te = te - 1; t2 = 1; } #delete[w]; }
        }
        #delete[t1];
        #delete[t2];
        #stack[int, 32] isHdr = 0;
        #stack[int, 32] isTgtHdr = 0;
        #stack[int, 32] isMatchKey = 0;
        if (te > ts) {
            #stack[int, 64] first = cssc::peek8(buf + ts);
            if (first == 91) {
                isHdr = 1;
                ciIniSectMatch(buf, ts, te, sctP, sctL) sm;
                isTgtHdr = sm;
                #delete[sm];
            }
            if (first != 91) {
                if (inTarget == 1) {
                    #stack[int, 64] eq = ts;
                    #stack[int, 32] fq = 0;
                    while (fq == 0) {
                        if (eq >= te) { fq = 1; }
                        if (fq == 0) { if (cssc::peek8(buf + eq) == 61) { fq = 1; } }
                        if (fq == 0) { eq = eq + 1; }
                    }
                    #delete[fq];
                    if (eq < te) {
                        #stack[int, 64] ke = eq;
                        #stack[int, 32] kt = 1;
                        while (kt == 1) {
                            kt = 0;
                            if (ke > ts) { ciIniWs(cssc::peek8(buf + ke - 1)) w; if (w == 1) { ke = ke - 1; kt = 1; } #delete[w]; }
                        }
                        #delete[kt];
                        #stack[int, 64] kl2 = ke - ts;
                        if (kl2 == keyL) {
                            #stack[int, 32] km = 1;
                            #stack[int, 64] j = 0;
                            while (j < kl2) {
                                if (cssc::peek8(buf + ts + j) != cssc::peek8(keyP + j)) { km = 0; }
                                j = j + 1;
                            }
                            #delete[j];
                            if (km == 1) { isMatchKey = 1; }
                            #delete[km];
                        }
                        #delete[kl2];
                        #delete[ke];
                    }
                    #delete[eq];
                }
            }
            #delete[first];
        }
        if (isHdr == 1) {
            if (inTarget == 1) {
                if (wroteKey == 0) {
                    ciIniEmitKV(op, keyP, keyL, valP, valL, 1) o2;
                    op = o2;
                    wroteKey = 1;
                    #delete[o2];
                }
            }
            ciIniPut(op, buf + ls, rle - ls) o3;
            op = o3;
            #delete[o3];
            inTarget = isTgtHdr;
            if (isTgtHdr == 1) { sawTarget = 1; }
        }
        if (isHdr == 0) {
            if (isMatchKey == 1) {
                #stack[int, 32] nlp = 0;
                if (rle > le) { nlp = 1; }
                ciIniEmitKV(op, keyP, keyL, valP, valL, nlp) o4;
                op = o4;
                wroteKey = 1;
                #delete[nlp];
                #delete[o4];
            }
            if (isMatchKey == 0) {
                ciIniPut(op, buf + ls, rle - ls) o5;
                op = o5;
                #delete[o5];
            }
        }
        #delete[isHdr];
        #delete[isTgtHdr];
        #delete[isMatchKey];
        #delete[ts];
        #delete[te];
        #delete[ce];
        pos = rle;
        #delete[rle];
        #delete[ls];
        #delete[le];
    }
    if (sawTarget == 0) {
        if (op > 0) { if (cssc::peek8(ciIniOut + op - 1) != 10) { cssc::poke8(ciIniOut + op, 10); op = op + 1; } }
        cssc::poke8(ciIniOut + op, 91);
        op = op + 1;
        ciIniPut(op, sctP, sctL) os;
        op = os;
        #delete[os];
        cssc::poke8(ciIniOut + op, 93);
        op = op + 1;
        cssc::poke8(ciIniOut + op, 10);
        op = op + 1;
        ciIniEmitKV(op, keyP, keyL, valP, valL, 1) ok;
        op = ok;
        #delete[ok];
    }
    if (sawTarget == 1) {
        if (wroteKey == 0) {
            if (op > 0) { if (cssc::peek8(ciIniOut + op - 1) != 10) { cssc::poke8(ciIniOut + op, 10); op = op + 1; } }
            ciIniEmitKV(op, keyP, keyL, valP, valL, 1) ok;
            op = ok;
            #delete[ok];
        }
    }
    #stack[int, 64] res = 0;
    if (idx >= 0) {
        fsStore(idx, ciIniOut, op);
        res = 1;
    }
    #delete[op];
    #delete[inTarget];
    #delete[wroteKey];
    #delete[sawTarget];
    #delete[pos];
    #delete[buf];
    #delete[len];
    #delete[idx];
    #delete[sctP];
    #delete[sctL];
    #delete[keyP];
    #delete[keyL];
    #delete[valP];
    #delete[valL];
    return res;
}

// delete(path,section,key): drop every matching key line in matching sections
// (its trailing newline too). Rewrites + stores only if something was removed.
// Returns 1 if any line removed, else 0. Spec section 4.5.
#define(ciIniDeleteKey) {
    #scanp(ciIniDeleteKey, int, 0) pathStr;
    #scanp(ciIniDeleteKey, int, 1) sectStr;
    #scanp(ciIniDeleteKey, int, 2) keyStr;
    #req[fsFind] fsFind;
    #req[fsIdx] fsIdx;
    #req[fsReadPtr] fsReadPtr;
    #req[fsReadLen] fsReadLen;
    #req[fsStore] fsStore;
    #req[ciIniWs] ciIniWs;
    #req[ciIniSectMatch] ciIniSectMatch;
    #req[ciIniPut] ciIniPut;
    #req[ciIniOut] ciIniOut;
    #stack[int, 64] sctP = sectStr + 8;
    #stack[int, 64] sctL = cssc::peek32(sectStr + 4);
    #stack[int, 64] keyP = keyStr + 8;
    #stack[int, 64] keyL = cssc::peek32(keyStr + 4);
    #stack[int, 64] res = 0;
    fsFind(pathStr + 8, cssc::peek32(pathStr + 4));
    #stack[int, 64] idx = fsIdx;
    if (idx >= 0) {
        fsReadPtr(idx) bp;
        #stack[int, 64] buf = bp;
        #delete[bp];
        fsReadLen(idx) bl;
        #stack[int, 64] len = bl;
        #delete[bl];
        #stack[int, 64] op = 0;
        #stack[int, 32] inTarget = 0;
        #stack[int, 32] removed = 0;
        #stack[int, 64] pos = 0;
        while (pos < len) {
            #stack[int, 64] ls = pos;
            #stack[int, 64] le = pos;
            #stack[int, 32] fe = 0;
            while (fe == 0) {
                if (le >= len) { fe = 1; }
                if (fe == 0) {
                    #stack[int, 64] ch = cssc::peek8(buf + le);
                    if (ch == 10) { fe = 1; }
                    if (ch == 0) { fe = 1; }
                    #delete[ch];
                }
                if (fe == 0) { le = le + 1; }
            }
            #delete[fe];
            #stack[int, 64] rle = le;
            if (rle < len) { if (cssc::peek8(buf + rle) == 10) { rle = rle + 1; } }
            #stack[int, 64] ce = ls;
            #stack[int, 32] fc = 0;
            while (fc == 0) {
                if (ce >= le) { fc = 1; }
                if (fc == 0) {
                    #stack[int, 64] ch = cssc::peek8(buf + ce);
                    if (ch == 59) { fc = 1; }
                    if (ch == 35) { fc = 1; }
                    #delete[ch];
                }
                if (fc == 0) { ce = ce + 1; }
            }
            #delete[fc];
            #stack[int, 64] ts = ls;
            #stack[int, 64] te = ce;
            #stack[int, 32] t1 = 1;
            while (t1 == 1) {
                t1 = 0;
                if (ts < te) { ciIniWs(cssc::peek8(buf + ts)) w; if (w == 1) { ts = ts + 1; t1 = 1; } #delete[w]; }
            }
            #stack[int, 32] t2 = 1;
            while (t2 == 1) {
                t2 = 0;
                if (te > ts) { ciIniWs(cssc::peek8(buf + te - 1)) w; if (w == 1) { te = te - 1; t2 = 1; } #delete[w]; }
            }
            #delete[t1];
            #delete[t2];
            #stack[int, 32] drop = 0;
            if (te > ts) {
                #stack[int, 64] first = cssc::peek8(buf + ts);
                if (first == 91) {
                    ciIniSectMatch(buf, ts, te, sctP, sctL) sm;
                    inTarget = sm;
                    #delete[sm];
                }
                if (first != 91) {
                    if (inTarget == 1) {
                        #stack[int, 64] eq = ts;
                        #stack[int, 32] fq = 0;
                        while (fq == 0) {
                            if (eq >= te) { fq = 1; }
                            if (fq == 0) { if (cssc::peek8(buf + eq) == 61) { fq = 1; } }
                            if (fq == 0) { eq = eq + 1; }
                        }
                        #delete[fq];
                        if (eq < te) {
                            #stack[int, 64] ke = eq;
                            #stack[int, 32] kt = 1;
                            while (kt == 1) {
                                kt = 0;
                                if (ke > ts) { ciIniWs(cssc::peek8(buf + ke - 1)) w; if (w == 1) { ke = ke - 1; kt = 1; } #delete[w]; }
                            }
                            #delete[kt];
                            #stack[int, 64] kl2 = ke - ts;
                            if (kl2 == keyL) {
                                #stack[int, 32] km = 1;
                                #stack[int, 64] j = 0;
                                while (j < kl2) {
                                    if (cssc::peek8(buf + ts + j) != cssc::peek8(keyP + j)) { km = 0; }
                                    j = j + 1;
                                }
                                #delete[j];
                                if (km == 1) { drop = 1; }
                                #delete[km];
                            }
                            #delete[kl2];
                            #delete[ke];
                        }
                        #delete[eq];
                    }
                }
                #delete[first];
            }
            if (drop == 1) { removed = 1; }
            if (drop == 0) {
                ciIniPut(op, buf + ls, rle - ls) o2;
                op = o2;
                #delete[o2];
            }
            #delete[drop];
            #delete[ts];
            #delete[te];
            #delete[ce];
            #delete[ls];
            #delete[le];
            pos = rle;
            #delete[rle];
        }
        if (removed == 1) {
            fsStore(idx, ciIniOut, op);
            res = 1;
        }
        #delete[op];
        #delete[inTarget];
        #delete[removed];
        #delete[pos];
        #delete[buf];
        #delete[len];
    }
    #delete[idx];
    #delete[sctP];
    #delete[sctL];
    #delete[keyP];
    #delete[keyL];
    return res;
}
// ============================================================================
// CONSOLE module (#include("console"); #console[w,h] name;) -- a grid-backed
// terminal handle (value tag 6). Host-testable: writes mirror to stdout via
// termTypeRaw; on CCOS the same bytes render to the terminal.
// header 64B: w@0 h@4 curLine@8 curCol@12 curAttr@16 defAttr@20 closed@24
// syncCount@28 cellsPtr@32 syncTagPtr@40 syncListPtr@48 syncLenPtr@56.
// cell 2B {char@0, attr@1}. sync slots: 8 x i64 across the 3 parallel arrays.
// ============================================================================
// 0xRRGGBB -> VGA-ish attr (r>=128->4, g->2, b->1; hi 0x08 if max>=160; 0->grey 7)
#define(ciConAttr) {
    #scanp(ciConAttr, int, 0) color;
    #stack[int, 64] col = color;
    if (col < 0) { col = 13421772; }
    #stack[int, 64] r = cssc::band(cssc::shr(col, 16), 255);
    #stack[int, 64] g = cssc::band(cssc::shr(col, 8), 255);
    #stack[int, 64] b = cssc::band(col, 255);
    #stack[int, 64] mx = r;
    if (g > mx) { mx = g; }
    if (b > mx) { mx = b; }
    #stack[int, 64] hi = 0;
    if (mx >= 160) { hi = 8; }
    #stack[int, 64] attr = 0;
    if (r >= 128) { attr = attr + 4; }
    if (g >= 128) { attr = attr + 2; }
    if (b >= 128) { attr = attr + 1; }
    if (attr == 0) { attr = 7; }
    #stack[int, 64] res = attr + hi;
    #delete[col];
    #delete[r];
    #delete[g];
    #delete[b];
    #delete[mx];
    #delete[hi];
    #delete[attr];
    return res;
}
// allocate + zero a console: header, w*h*2 cells {0x20,defAttr=7}, 3 sync arrays.
#define(ciConNew) {
    #scanp(ciConNew, int, 0) w;
    #scanp(ciConNew, int, 1) h;
    #stack[int, 64] hd = cssc::alloc(64);
    #stack[int, 64] cells = cssc::alloc(w * h * 2);
    #stack[int, 64] st = cssc::alloc(64);
    #stack[int, 64] sl = cssc::alloc(64);
    #stack[int, 64] sn = cssc::alloc(64);
    cssc::poke32(hd, w);
    cssc::poke32(hd + 4, h);
    cssc::poke32(hd + 8, 0);
    cssc::poke32(hd + 12, 0);
    cssc::poke32(hd + 16, 7);
    cssc::poke32(hd + 20, 7);
    cssc::poke32(hd + 24, 0);
    cssc::poke32(hd + 28, 0);
    cssc::poke64(hd + 32, cells);
    cssc::poke64(hd + 40, st);
    cssc::poke64(hd + 48, sl);
    cssc::poke64(hd + 56, sn);
    cssc::memfill32(st, 0, 16);
    cssc::memfill32(sl, 0, 16);
    cssc::memfill32(sn, 0, 16);
    #stack[int, 64] i = 0;
    #stack[int, 64] total = w * h;
    while (i < total) {
        cssc::poke8(cells + i * 2, 32);
        cssc::poke8(cells + i * 2 + 1, 7);
        i = i + 1;
    }
    #delete[i];
    #delete[total];
    #delete[cells];
    #delete[st];
    #delete[sl];
    #delete[sn];
    return hd;
}
// shift rows up one, clear the last row to {space, defAttr}
#define(ciConScroll) {
    #scanp(ciConScroll, int, 0) ch;
    #stack[int, 64] w = cssc::peek32(ch);
    #stack[int, 64] h = cssc::peek32(ch + 4);
    #stack[int, 64] da = cssc::peek32(ch + 20);
    #stack[int, 64] cells = cssc::peek64(ch + 32);
    if (h > 1) {
        cssc::memcopy(cells, cells + w * 2, (h - 1) * w * 2);
    }
    #stack[int, 64] base = (h - 1) * w;
    #stack[int, 64] c = 0;
    while (c < w) {
        cssc::poke8(cells + (base + c) * 2, 32);
        cssc::poke8(cells + (base + c) * 2 + 1, da);
        c = c + 1;
    }
    #delete[c];
    #delete[base];
    #delete[w];
    #delete[h];
    #delete[da];
    #delete[cells];
}
// write one byte into the grid at the cursor (wrap + scroll). '\n' -> next line.
#define(ciConPutc) {
    #scanp(ciConPutc, int, 0) ch;
    #scanp(ciConPutc, int, 1) b;
    #req[ciConScroll] ciConScroll;
    #stack[int, 64] w = cssc::peek32(ch);
    #stack[int, 64] h = cssc::peek32(ch + 4);
    #stack[int, 64] cl = cssc::peek32(ch + 8);
    #stack[int, 64] cc = cssc::peek32(ch + 12);
    #stack[int, 64] at = cssc::peek32(ch + 16);
    if (b == 10) {
        cl = cl + 1;
        cc = 0;
    }
    if (b != 10) {
        if (cc >= w) { cl = cl + 1; cc = 0; }
        if (cl >= h) { ciConScroll(ch); cl = h - 1; }
        #stack[int, 64] cells = cssc::peek64(ch + 32);
        #stack[int, 64] off = (cl * w + cc) * 2;
        cssc::poke8(cells + off, b);
        cssc::poke8(cells + off + 1, at);
        cc = cc + 1;
        #delete[cells];
        #delete[off];
    }
    if (cl >= h) { ciConScroll(ch); cl = h - 1; }
    cssc::poke32(ch + 8, cl);
    cssc::poke32(ch + 12, cc);
    #delete[w];
    #delete[h];
    #delete[cl];
    #delete[cc];
    #delete[at];
}
// write n bytes at src into the grid + mirror to the host/terminal sink.
#define(ciConOut) {
    #scanp(ciConOut, int, 0) ch;
    #scanp(ciConOut, int, 1) src;
    #scanp(ciConOut, int, 2) n;
    #req[ciConPutc] ciConPutc;
    #req[termTypeRaw] termTypeRaw;
    #stack[int, 64] closed = cssc::peek32(ch + 24);
    if (closed == 0) {
        #stack[int, 64] i = 0;
        while (i < n) {
            ciConPutc(ch, cssc::peek8(src + i));
            i = i + 1;
        }
        #delete[i];
        termTypeRaw(src, n, 11843776);
    }
    #delete[closed];
}
// fill the whole grid with {space, defAttr}; cursor -> (0,0)
#define(ciConClearAll) {
    #scanp(ciConClearAll, int, 0) ch;
    #stack[int, 64] closed = cssc::peek32(ch + 24);
    if (closed == 0) {
        #stack[int, 64] w = cssc::peek32(ch);
        #stack[int, 64] h = cssc::peek32(ch + 4);
        #stack[int, 64] da = cssc::peek32(ch + 20);
        #stack[int, 64] cells = cssc::peek64(ch + 32);
        #stack[int, 64] i = 0;
        #stack[int, 64] total = w * h;
        while (i < total) {
            cssc::poke8(cells + i * 2, 32);
            cssc::poke8(cells + i * 2 + 1, da);
            i = i + 1;
        }
        #delete[i];
        #delete[total];
        cssc::poke32(ch + 8, 0);
        cssc::poke32(ch + 12, 0);
        #delete[w];
        #delete[h];
        #delete[da];
        #delete[cells];
    }
    #delete[closed];
}
// fill one row with {space, defAttr}; out-of-range -> no-op; cursor unchanged
#define(ciConClearLine) {
    #scanp(ciConClearLine, int, 0) ch;
    #scanp(ciConClearLine, int, 1) line;
    #stack[int, 64] w = cssc::peek32(ch);
    #stack[int, 64] h = cssc::peek32(ch + 4);
    if (line >= 0) {
        if (line < h) {
            #stack[int, 64] da = cssc::peek32(ch + 20);
            #stack[int, 64] cells = cssc::peek64(ch + 32);
            #stack[int, 64] base = line * w;
            #stack[int, 64] c = 0;
            while (c < w) {
                cssc::poke8(cells + (base + c) * 2, 32);
                cssc::poke8(cells + (base + c) * 2 + 1, da);
                c = c + 1;
            }
            #delete[c];
            #delete[base];
            #delete[da];
            #delete[cells];
        }
    }
    #delete[w];
    #delete[h];
}
// per-mille cursor X (native float(pos in [-1,1]) redefined as int -1000..1000)
#define(ciConCursorPos) {
    #scanp(ciConCursorPos, int, 0) ch;
    #scanp(ciConCursorPos, int, 1) p;
    #stack[int, 64] w = cssc::peek32(ch);
    #stack[int, 64] cx = 0;
    #stack[int, 32] mid = 1;
    if (p <= 0 - 1000) { cx = 0; mid = 0; }
    if (p >= 1000) { cx = w - 1; mid = 0; }
    if (mid == 1) {
        #stack[int, 64] pp = p;
        if (pp < 0) { pp = pp + 1000; }
        cx = cssc::div(pp * (w - 1), 1000);
        if (cx < 0) { cx = 0; }
        if (cx > w - 1) { cx = w - 1; }
        #delete[pp];
    }
    #delete[mid];
    cssc::poke32(ch + 12, cx);
    #delete[w];
    #delete[cx];
}
// read a row into a fresh string, rstripping trailing space/NUL; oob -> 0 (null)
#define(ciConGetLine) {
    #scanp(ciConGetLine, int, 0) ch;
    #scanp(ciConGetLine, int, 1) line;
    #req[ciStrNew] ciStrNew;
    #stack[int, 64] w = cssc::peek32(ch);
    #stack[int, 64] h = cssc::peek32(ch + 4);
    #stack[int, 64] res = 0;
    if (line >= 0) {
        if (line < h) {
            #stack[int, 64] cells = cssc::peek64(ch + 32);
            #stack[int, 64] tmp = cssc::alloc(w + 1);
            #stack[int, 64] base = line * w;
            #stack[int, 64] c = 0;
            while (c < w) {
                cssc::poke8(tmp + c, cssc::peek8(cells + (base + c) * 2));
                c = c + 1;
            }
            #delete[c];
            #stack[int, 64] ln = w;
            #stack[int, 32] go = 1;
            while (go == 1) {
                if (ln <= 0) { go = 0; }
                if (go == 1) {
                    #stack[int, 64] bb = cssc::peek8(tmp + ln - 1);
                    #stack[int, 32] trim = 0;
                    if (bb == 32) { trim = 1; }
                    if (bb == 0) { trim = 1; }
                    if (trim == 0) { go = 0; }
                    if (trim == 1) { ln = ln - 1; }
                    #delete[bb];
                    #delete[trim];
                }
            }
            #delete[go];
            ciStrNew(tmp, ln) s;
            res = s;
            cssc::free(tmp);
            #delete[s];
            #delete[ln];
            #delete[base];
            #delete[cells];
            #delete[tmp];
        }
    }
    #delete[w];
    #delete[h];
    return res;
}
// fresh 2-element int vector [curLine, curCol]
#define(ciConCursorAt) {
    #scanp(ciConCursorAt, int, 0) ch;
    #req[ciVecNew] ciVecNew;
    #req[ciVecPush] ciVecPush;
    #stack[int, 64] cl = cssc::peek32(ch + 8);
    #stack[int, 64] cc = cssc::peek32(ch + 12);
    ciVecNew(0) v;
    ciVecPush(v, cl, 0);
    ciVecPush(v, cc, 0);
    #stack[int, 64] res = v;
    #delete[v];
    #delete[cl];
    #delete[cc];
    return res;
}
// register/replace a {tag, listHandle, lastLen=current size} sync binding (cap 8).
// TAIL not replay: lastLen starts at the list's current length. null list -> ignored.
#define(ciConSyncAdd) {
    #scanp(ciConSyncAdd, int, 0) ch;
    #scanp(ciConSyncAdd, int, 1) tagPtr;
    #scanp(ciConSyncAdd, int, 2) lh;
    #req[ciStrClone] ciStrClone;
    #req[ciStrCmp] ciStrCmp;
    if (lh != 0) {
        #stack[int, 64] st = cssc::peek64(ch + 40);
        #stack[int, 64] sl = cssc::peek64(ch + 48);
        #stack[int, 64] sn = cssc::peek64(ch + 56);
        #stack[int, 64] count = cssc::peek32(ch + 28);
        #stack[int, 64] idx = 0 - 1;
        #stack[int, 64] i = 0;
        while (i < count) {
            if (idx < 0) {
                #stack[int, 64] et = cssc::peek64(st + i * 8);
                if (et != 0) {
                    ciStrCmp(et, tagPtr) c;
                    if (c == 0) { idx = i; }
                    #delete[c];
                }
                #delete[et];
            }
            i = i + 1;
        }
        #delete[i];
        #stack[int, 64] curSize = cssc::peek32(lh + 4);
        if (idx >= 0) {
            cssc::poke64(sl + idx * 8, lh);
            cssc::poke64(sn + idx * 8, curSize);
        }
        if (idx < 0) {
            if (count < 8) {
                ciStrClone(tagPtr) tc;
                cssc::poke64(st + count * 8, tc);
                cssc::poke64(sl + count * 8, lh);
                cssc::poke64(sn + count * 8, curSize);
                cssc::poke32(ch + 28, count + 1);
                #delete[tc];
            }
        }
        #delete[curSize];
        #delete[idx];
        #delete[count];
        #delete[st];
        #delete[sl];
        #delete[sn];
    }
}
// synchronous tail-forward: for each binding, emit "[tag] entry\n" for the new
// entries [lastLen..size) then bump lastLen. Collapses the host's poll thread.
#define(ciConSyncDrain) {
    #scanp(ciConSyncDrain, int, 0) ch;
    #req[ciConOut] ciConOut;
    #req[ciVecGet] ciVecGet;
    #stack[int, 64] st = cssc::peek64(ch + 40);
    #stack[int, 64] sl = cssc::peek64(ch + 48);
    #stack[int, 64] sn = cssc::peek64(ch + 56);
    #stack[int, 64] count = cssc::peek32(ch + 28);
    #stack[int, 64] i = 0;
    while (i < count) {
        #stack[int, 64] lh = cssc::peek64(sl + i * 8);
        #stack[int, 64] tg = cssc::peek64(st + i * 8);
        #stack[int, 64] last = cssc::peek64(sn + i * 8);
        if (lh != 0) {
            #stack[int, 64] sz = cssc::peek32(lh + 4);
            #stack[int, 64] tglen = 0;
            if (tg != 0) { tglen = cssc::peek32(tg + 4); }
            #stack[int, 64] j = last;
            while (j < sz) {
                ciVecGet(lh, j) entry;
                #stack[int, 64] elen = 0;
                if (entry != 0) { elen = cssc::peek32(entry + 4); }
                #stack[int, 64] tot = tglen + elen + 4;
                #stack[int, 64] buf = cssc::alloc(tot);
                #stack[int, 64] p = 0;
                cssc::poke8(buf + p, 91);
                p = p + 1;
                #stack[int, 64] k = 0;
                while (k < tglen) {
                    cssc::poke8(buf + p, cssc::peek8(tg + 8 + k));
                    p = p + 1;
                    k = k + 1;
                }
                #delete[k];
                cssc::poke8(buf + p, 93);
                p = p + 1;
                cssc::poke8(buf + p, 32);
                p = p + 1;
                #stack[int, 64] k2 = 0;
                while (k2 < elen) {
                    cssc::poke8(buf + p, cssc::peek8(entry + 8 + k2));
                    p = p + 1;
                    k2 = k2 + 1;
                }
                #delete[k2];
                cssc::poke8(buf + p, 10);
                p = p + 1;
                ciConOut(ch, buf, p);
                cssc::free(buf);
                if (entry != 0) { cssc::free(entry); }
                #delete[p];
                #delete[buf];
                #delete[tot];
                #delete[elen];
                #delete[entry];
                j = j + 1;
            }
            #delete[j];
            cssc::poke64(sn + i * 8, sz);
            #delete[sz];
            #delete[tglen];
        }
        #delete[lh];
        #delete[tg];
        #delete[last];
        i = i + 1;
    }
    #delete[i];
    #delete[st];
    #delete[sl];
    #delete[sn];
    #delete[count];
}
// flush pending FIRST, then remove the binding (compact); missing tag -> no-op
#define(ciConDesync) {
    #scanp(ciConDesync, int, 0) ch;
    #scanp(ciConDesync, int, 1) tagPtr;
    #req[ciConSyncDrain] ciConSyncDrain;
    #req[ciStrCmp] ciStrCmp;
    ciConSyncDrain(ch);
    #stack[int, 64] st = cssc::peek64(ch + 40);
    #stack[int, 64] sl = cssc::peek64(ch + 48);
    #stack[int, 64] sn = cssc::peek64(ch + 56);
    #stack[int, 64] count = cssc::peek32(ch + 28);
    #stack[int, 64] idx = 0 - 1;
    #stack[int, 64] i = 0;
    while (i < count) {
        if (idx < 0) {
            #stack[int, 64] et = cssc::peek64(st + i * 8);
            if (et != 0) {
                ciStrCmp(et, tagPtr) c;
                if (c == 0) { idx = i; }
                #delete[c];
            }
            #delete[et];
        }
        i = i + 1;
    }
    #delete[i];
    if (idx >= 0) {
        #stack[int, 64] ot = cssc::peek64(st + idx * 8);
        if (ot != 0) { cssc::free(ot); }
        #delete[ot];
        #stack[int, 64] lastI = count - 1;
        if (idx < lastI) {
            cssc::poke64(st + idx * 8, cssc::peek64(st + lastI * 8));
            cssc::poke64(sl + idx * 8, cssc::peek64(sl + lastI * 8));
            cssc::poke64(sn + idx * 8, cssc::peek64(sn + lastI * 8));
        }
        cssc::poke64(st + lastI * 8, 0);
        cssc::poke64(sl + lastI * 8, 0);
        cssc::poke64(sn + lastI * 8, 0);
        cssc::poke32(ch + 28, lastI);
        #delete[lastI];
    }
    #delete[idx];
    #delete[count];
    #delete[st];
    #delete[sl];
    #delete[sn];
}
// mark closed + drop all sync bindings (free owned tag strings). Cells/header left
// for the program-end sweep (ciValFree tag 6).
#define(ciConClose) {
    #scanp(ciConClose, int, 0) ch;
    #stack[int, 64] closed = cssc::peek32(ch + 24);
    if (closed == 0) {
        #stack[int, 64] st = cssc::peek64(ch + 40);
        #stack[int, 64] count = cssc::peek32(ch + 28);
        #stack[int, 64] i = 0;
        while (i < count) {
            #stack[int, 64] t = cssc::peek64(st + i * 8);
            if (t != 0) { cssc::free(t); }
            cssc::poke64(st + i * 8, 0);
            #delete[t];
            i = i + 1;
        }
        #delete[i];
        cssc::poke32(ch + 28, 0);
        cssc::poke32(ch + 24, 1);
        #delete[st];
        #delete[count];
    }
    #delete[closed];
}
// ============================================================================
// MOUSE module (#include("mouse"); mouse::* ; mouse::client(vh) -> tag-8 handle).
// Coordinates map the framebuffer cursor back into backbuffer space using the
// scale/offset present() published. All state is plain int (no heap).
// ============================================================================
#define(ciMsLc) {
    #scanp(ciMsLc, int, 0) c;
    #stack[int, 64] r = c;
    if (c >= 65) { if (c <= 90) { r = c + 32; } }
    return r;
}
#define(ciMsMapX) {
    #req[mouseX] mouseX;
    #req[ciVidScale] ciVidScale;
    #req[ciVidOffX] ciVidOffX;
    #stack[int, 64] sc = ciVidScale;
    if (sc < 1) { sc = 1; }
    #stack[int, 64] r = (mouseX - ciVidOffX) / sc;
    #delete[sc];
    return r;
}
#define(ciMsMapY) {
    #req[mouseY] mouseY;
    #req[ciVidScale] ciVidScale;
    #req[ciVidOffY] ciVidOffY;
    #stack[int, 64] sc = ciVidScale;
    if (sc < 1) { sc = 1; }
    #stack[int, 64] r = (mouseY - ciVidOffY) / sc;
    #delete[sc];
    return r;
}
// "left"->1 "right"->2 "middle"->4 (case-insensitive); unknown -> 0
#define(ciMsBtnMask) {
    #scanp(ciMsBtnMask, int, 0) sp;
    #req[ciMsLc] ciMsLc;
    #stack[int, 64] r = 0;
    if (sp != 0) {
        #stack[int, 64] len = cssc::peek32(sp + 4);
        #stack[int, 64] d = sp + 8;
        if (len == 4) {
            #stack[int, 32] m = 1;
            ciMsLc(cssc::peek8(d)) c0;
            if (c0 != 108) { m = 0; }
            #delete[c0];
            ciMsLc(cssc::peek8(d + 1)) c1;
            if (c1 != 101) { m = 0; }
            #delete[c1];
            ciMsLc(cssc::peek8(d + 2)) c2;
            if (c2 != 102) { m = 0; }
            #delete[c2];
            ciMsLc(cssc::peek8(d + 3)) c3;
            if (c3 != 116) { m = 0; }
            #delete[c3];
            if (m == 1) { r = 1; }
            #delete[m];
        }
        if (len == 5) {
            #stack[int, 32] m = 1;
            ciMsLc(cssc::peek8(d)) c0;
            if (c0 != 114) { m = 0; }
            #delete[c0];
            ciMsLc(cssc::peek8(d + 1)) c1;
            if (c1 != 105) { m = 0; }
            #delete[c1];
            ciMsLc(cssc::peek8(d + 2)) c2;
            if (c2 != 103) { m = 0; }
            #delete[c2];
            ciMsLc(cssc::peek8(d + 3)) c3;
            if (c3 != 104) { m = 0; }
            #delete[c3];
            ciMsLc(cssc::peek8(d + 4)) c4;
            if (c4 != 116) { m = 0; }
            #delete[c4];
            if (m == 1) { r = 2; }
            #delete[m];
        }
        if (len == 6) {
            #stack[int, 32] m = 1;
            ciMsLc(cssc::peek8(d)) c0;
            if (c0 != 109) { m = 0; }
            #delete[c0];
            ciMsLc(cssc::peek8(d + 1)) c1;
            if (c1 != 105) { m = 0; }
            #delete[c1];
            ciMsLc(cssc::peek8(d + 2)) c2;
            if (c2 != 100) { m = 0; }
            #delete[c2];
            ciMsLc(cssc::peek8(d + 3)) c3;
            if (c3 != 100) { m = 0; }
            #delete[c3];
            ciMsLc(cssc::peek8(d + 4)) c4;
            if (c4 != 108) { m = 0; }
            #delete[c4];
            ciMsLc(cssc::peek8(d + 5)) c5;
            if (c5 != 101) { m = 0; }
            #delete[c5];
            if (m == 1) { r = 4; }
            #delete[m];
        }
        #delete[len];
        #delete[d];
    }
    return r;
}
// snapshot the button state (prev<-curr, curr<-flags&7). Level state, no ring.
#define(ciMsUpdate) {
    #req[mouseFlags] mouseFlags;
    #req[ciMsCurr] ciMsCurr;
    #req[ciMsPrev] ciMsPrev;
    ciMsPrev = ciMsCurr;
    ciMsCurr = cssc::band(mouseFlags, 7);
}
#define(ciMsOver) {
    #scanp(ciMsOver, int, 0) x;
    #scanp(ciMsOver, int, 1) y;
    #scanp(ciMsOver, int, 2) w;
    #scanp(ciMsOver, int, 3) h;
    #req[ciMsMapX] ciMsMapX;
    #req[ciMsMapY] ciMsMapY;
    ciMsMapX() mx;
    ciMsMapY() my;
    #stack[int, 64] r = 0;
    if (mx >= x) { if (mx < x + w) { if (my >= y) { if (my < y + h) { r = 1; } } } }
    #delete[mx];
    #delete[my];
    return r;
}
// compute an int mouse method result (shared by namespace + client-dot dispatch).
// button methods take a1 = string ptr; isOver takes a1..a4; clampX/Y take (a1,a2).
#define(ciMsMethod) {
    #scanp(ciMsMethod, int, 0) moff;
    #scanp(ciMsMethod, int, 1) mlen;
    #scanp(ciMsMethod, int, 2) a1;
    #scanp(ciMsMethod, int, 3) a2;
    #scanp(ciMsMethod, int, 4) a3;
    #scanp(ciMsMethod, int, 5) a4;
    #req[ciIdentIs] ciIdentIs;
    #req[ciMsMapX] ciMsMapX;
    #req[ciMsMapY] ciMsMapY;
    #req[ciMsOver] ciMsOver;
    #req[ciMsBtnMask] ciMsBtnMask;
    #req[ciMsCurr] ciMsCurr;
    #req[ciMsPrev] ciMsPrev;
    #req[mouseFlags] mouseFlags;
    ciIdentIs(moff, mlen, "getX") mgx;
    ciIdentIs(moff, mlen, "getY") mgy;
    ciIdentIs(moff, mlen, "isOver") mov;
    ciIdentIs(moff, mlen, "isClicked") mck;
    ciIdentIs(moff, mlen, "isHeld") mhl;
    ciIdentIs(moff, mlen, "isReleased") mrl;
    ciIdentIs(moff, mlen, "clampX") mcx;
    ciIdentIs(moff, mlen, "clampY") mcy;
    #stack[int, 64] res = 0;
    if (mgx == 1) { ciMsMapX() r; res = r; #delete[r]; }
    if (mgy == 1) { ciMsMapY() r; res = r; #delete[r]; }
    if (mov == 1) { ciMsOver(a1, a2, a3, a4) r; res = r; #delete[r]; }
    if (mck == 1) {
        ciMsBtnMask(a1) mask;
        #stack[int, 64] rr = 0;
        if (mask != 0) {
            #stack[int, 64] cu = cssc::band(ciMsCurr, mask);
            #stack[int, 64] pr = cssc::band(ciMsPrev, mask);
            if (cu > 0) { if (pr == 0) { rr = 1; } }
            #delete[cu];
            #delete[pr];
        }
        res = rr;
        #delete[mask];
        #delete[rr];
    }
    if (mrl == 1) {
        ciMsBtnMask(a1) mask;
        #stack[int, 64] rr = 0;
        if (mask != 0) {
            #stack[int, 64] cu = cssc::band(ciMsCurr, mask);
            #stack[int, 64] pr = cssc::band(ciMsPrev, mask);
            if (cu == 0) { if (pr > 0) { rr = 1; } }
            #delete[cu];
            #delete[pr];
        }
        res = rr;
        #delete[mask];
        #delete[rr];
    }
    if (mhl == 1) {
        ciMsBtnMask(a1) mask;
        #stack[int, 64] m2 = mask;
        if (m2 == 0) { m2 = 1; }
        #stack[int, 64] hv = cssc::band(mouseFlags, m2);
        #stack[int, 64] rr = 0;
        if (hv > 0) { rr = 1; }
        res = rr;
        #delete[mask];
        #delete[m2];
        #delete[hv];
        #delete[rr];
    }
    if (mcx == 1) {
        ciMsMapX() mx;
        #stack[int, 64] w = a2;
        if (w < 1) { w = 1; }
        #stack[int, 64] rr = mx;
        if (mx < a1) { rr = a1; }
        if (mx > a1 + w - 1) { rr = a1 + w - 1; }
        res = rr;
        #delete[mx];
        #delete[w];
        #delete[rr];
    }
    if (mcy == 1) {
        ciMsMapY() my;
        #stack[int, 64] h = a2;
        if (h < 1) { h = 1; }
        #stack[int, 64] rr = my;
        if (my < a1) { rr = a1; }
        if (my > a1 + h - 1) { rr = a1 + h - 1; }
        res = rr;
        #delete[my];
        #delete[h];
        #delete[rr];
    }
    #delete[mgx];
    #delete[mgy];
    #delete[mov];
    #delete[mck];
    #delete[mhl];
    #delete[mrl];
    #delete[mcx];
    #delete[mcy];
    return res;
}
// ============================================================================
//  math.accel (modid 12) NATIVE helpers -- bit-exact port of cssc_math_accel.c
//  (splitmix64 lattice + FNV-1a mix). When interp.cssc is compiled to native
//  these run at machine speed: one guest ma::fbm2 call collapses ~135 CSSC-level
//  calls into one native call. Float values are IEEE-754 f64 bit patterns in i64
//  slots (ciEvalType==2). Callee-first: each helper is defined before any caller,
//  and the whole block precedes #define(ciExpr) which dispatches them.
//
//  CRITICAL: 64-bit hex constants lex to the exact bit pattern (top-bit-set reads
//  as a negative i64 but band/bxor/shr treat it as uint64); i64 '*'/'+' wrap mod
//  2^64; cssc::shr is LOGICAL (zero-fill) -- required for splitmix's z>>k. Native
//  FLOAT LITERALS do NOT lex to doubles (6.0 -> int 6), so every float constant is
//  built with cssc::iToF (6.0=iToF(6), 2^53=iToF(9007199254740992)).
// ============================================================================
// splitmix64(z): z += PHI; z=(z^(z>>30))*MIXA; z=(z^(z>>27))*MIXB; return z^(z>>31)
#stack[int, 64] ciMaSplitmix;
#define(ciMaSplitmix) {
    #scanp(ciMaSplitmix, int, 0) z0;
    #stack[int, 64] z = z0 + 0x9E3779B97F4A7C15;
    #stack[int, 64] z1 = cssc::bxor(z, cssc::shr(z, 30)); z = z1 * 0xBF58476D1CE4E5B9; #delete[z1];
    #stack[int, 64] z2 = cssc::bxor(z, cssc::shr(z, 27)); z = z2 * 0x94D049BB133111EB; #delete[z2];
    #stack[int, 64] out = cssc::bxor(z, cssc::shr(z, 31));
    #delete[z];
    return out;
}
// hashN(a,b,c,d,cnt): FNV-1a over cnt args (2/3/4) then splitmix64, masked to 63 bits
#stack[int, 64] ciMaHashN;
#define(ciMaHashN) {
    #scanp(ciMaHashN, int, 0) a;
    #scanp(ciMaHashN, int, 1) b;
    #scanp(ciMaHashN, int, 2) c;
    #scanp(ciMaHashN, int, 3) d;
    #scanp(ciMaHashN, int, 4) cnt;
    #req[ciMaSplitmix] ciMaSplitmix;
    #stack[int, 64] h = 0xCBF29CE484222325;
    #stack[int, 64] h1 = cssc::bxor(h, a); h = h1 * 0x100000001B3; #delete[h1];
    #stack[int, 64] h2 = cssc::bxor(h, b); h = h2 * 0x100000001B3; #delete[h2];
