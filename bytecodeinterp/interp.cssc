// out-param: the value type of the entry a map get/find just returned (0=int,
// 1=string), so the dispatch can set ciEvalType/ownership correctly.
#stack[int, 64] ciMapRT = 0;
// out-param: 1 if the last map get found the key, else 0 (lets has/contains/count
