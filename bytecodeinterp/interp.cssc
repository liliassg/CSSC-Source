                                if (cssc::fCmp(f3, f1) < 0) { r = cssc::iToF(0); }
                            } else {
                                #stack[int, 64] t = cssc::fDiv(cssc::fSub(f3, f1), den);
                                if (cssc::fCmp(t, cssc::iToF(0)) < 0) { t = cssc::iToF(0); }
                                if (cssc::fCmp(t, cssc::iToF(1)) > 0) { t = cssc::iToF(1); }
                                ciMaFade(t) fv; r = fv; #delete[fv];
                                #delete[t];
                            }
                            #delete[den];
                        }
                        if (mVn == 1) { ciMaValueNoise2(f1, f2, a3) hh; r = hh; #delete[hh]; }
                        if (mFb == 1) { ciMaFbm2(f1, f2, a3, f4, f5, a6) hh; r = hh; #delete[hh]; }
                    }
                    left = r;
                    ciEvalType = rt;
                    leftOwns = 0;
                    handled = 1;
                    if (q1 == 1) { ciValFree(y1, a1); }
                    if (q2 == 1) { ciValFree(y2, a2); }
                    if (q3 == 1) { ciValFree(y3, a3); }
                    if (q4 == 1) { ciValFree(y4, a4); }
                    if (q5 == 1) { ciValFree(y5, a5); }
                    if (q6 == 1) { ciValFree(y6, a6); }
                    #delete[f1]; #delete[f2]; #delete[f3]; #delete[f4]; #delete[f5];
                    #delete[a1]; #delete[a2]; #delete[a3]; #delete[a4]; #delete[a5]; #delete[a6];
                    #delete[q1]; #delete[q2]; #delete[q3]; #delete[q4]; #delete[q5]; #delete[q6];
                    #delete[y1]; #delete[y2]; #delete[y3]; #delete[y4]; #delete[y5]; #delete[y6];
                    #delete[n]; #delete[r]; #delete[rt];
                    #delete[mH2]; #delete[mH3]; #delete[mH4]; #delete[mHU]; #delete[mHU3];
                    #delete[mFd]; #delete[mLp]; #delete[mLp2]; #delete[mFi]; #delete[mFf];
                    #delete[mCf]; #delete[mRf]; #delete[mAf]; #delete[mAf2]; #delete[mSf];
                    #delete[mSf2]; #delete[mCl]; #delete[mCl2]; #delete[mMn]; #delete[mMx];
                    #delete[mSs]; #delete[mSs2]; #delete[mVn]; #delete[mFb]; #delete[mAv];
                }
                // ---- cssc.math value methods (modid 13) -- float-intrinsic delegation ----
                if (mvmod == 13) {
                    ciIdentIs(mmo, mml, "pi") cPi;
                    ciIdentIs(mmo, mml, "e") cE;
                    ciIdentIs(mmo, mml, "tau") cTau;
