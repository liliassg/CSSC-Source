                    ciIdentIs(mmo, mml, "nan") cNan;
                    ciIdentIs(mmo, mml, "abs") cAbs;
                    ciIdentIs(mmo, mml, "floor") cFl;
                    ciIdentIs(mmo, mml, "ceil") cCe;
                    ciIdentIs(mmo, mml, "trunc") cTr;
                    ciIdentIs(mmo, mml, "round") cRo;
                    ciIdentIs(mmo, mml, "sign") cSg;
