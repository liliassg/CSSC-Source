                    ciExec = ctSE;
                    #delete[ctSE];
                    #delete[ctDoBody];
                    #delete[ctFaultStr];
                    #delete[ctcO];
                    #delete[ctcL];
                    #delete[ctTgtStart];
                    #delete[ctAfterIdx];
