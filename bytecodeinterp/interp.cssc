                                cssc::poke64(depIL + depN * 8, dil);
                                depN = depN + 1;
                            }
                            #delete[dso];
                            #delete[dsl];
                            #delete[dio];
                            #delete[dil];
                            if (ciCur == 21) { ciAdvance(); }
                            if (ciPos == dbefore) { if (ciCur != 0) { ciAdvance(); } }
                            #delete[dbefore];
                        }
                    }
                    if (ciCur == 18) { ciAdvance(); }
                    #delete[dcg];
                }
                // optional ?label -> deferred sector (runs on #reserve)
                #stack[int, 32] sdef = 0;
                #stack[int, 64] labO = 0;
                #stack[int, 64] labL = 0;
                if (ciCur == 32) {
                    ciAdvance();
                    labO = ciTokOff;
                    labL = ciTokLen;
                    sdef = 1;
                    if (ciCur == 2) { ciAdvance(); }
                }
                // body span: token-level brace scan (never raw bytes)
                #stack[int, 64] bodyS = 0;
                #stack[int, 64] bodyE = 0;
                if (ciCur == 11) {
                    bodyS = ciPos;
                    #stack[int, 32] dep2 = 1;
                    #stack[int, 32] sc2 = 1;
                    while (sc2 == 1) {
                        ciAdvance();
                        if (ciCur == 0) { sc2 = 0; }
                        if (ciCur == 11) { dep2 = dep2 + 1; }
                        if (ciCur == 12) {
                            dep2 = dep2 - 1;
                            if (dep2 == 0) { sc2 = 0; }
                        }
                    }
                    #delete[sc2];
                    #delete[dep2];
                    bodyE = ciPos;
                    if (ciCur == 12) { ciAdvance(); }
                }
                // optional trailing free { ... } span
                #stack[int, 64] freeS = 0;
                #stack[int, 64] freeE = 0;
                if (ciCur == 2) {
                    #stack[int, 64] fko = ciTokOff;
                    #stack[int, 64] fkl = ciTokLen;
                    ciIdentIs(fko, fkl, "free") isfb;
                    if (isfb == 1) {
                        ciAdvance();
                        if (ciCur == 11) {
                            freeS = ciPos;
                            #stack[int, 32] dep3 = 1;
                            #stack[int, 32] sc3 = 1;
                            while (sc3 == 1) {
                                ciAdvance();
                                if (ciCur == 0) { sc3 = 0; }
                                if (ciCur == 11) { dep3 = dep3 + 1; }
                                if (ciCur == 12) {
                                    dep3 = dep3 - 1;
                                    if (dep3 == 0) { sc3 = 0; }
                                }
                            }
                            #delete[sc3];
                            #delete[dep3];
                            freeE = ciPos;
                            if (ciCur == 12) { ciAdvance(); }
                        }
                    }
                    #delete[isfb];
                    #delete[fko];
                    #delete[fkl];
                }
                if (ciCur == 13) { ciAdvance(); }
                // register + construct only when executing at top level
                if (ciExec == 1) {
                    if (ciScopeBase == 0) {
                        // redeclaration = silent replace (reference 16301)
                        ciSecFind(sno, snl) si;
                        if (si < 0) {
                            if (ciSecCount < 128) {
                                si = ciSecCount;
                                ciSecCount = ciSecCount + 1;
                            }
                        }
                        if (si >= 0) {
                            cssc::poke64(ciSecNameOff + si * 8, sno);
                            cssc::poke64(ciSecNameLen + si * 8, snl);
                            cssc::poke64(ciSecBodyS + si * 8, bodyS);
                            cssc::poke64(ciSecBodyE + si * 8, bodyE);
                            cssc::poke64(ciSecFreeS + si * 8, freeS);
                            cssc::poke64(ciSecFreeE + si * 8, freeE);
                            cssc::poke64(ciSecFreed + si * 8, 0);
                            cssc::poke64(ciSecDefer + si * 8, sdef);
                            cssc::poke64(ciSecLabOff + si * 8, labO);
                            cssc::poke64(ciSecLabLen + si * 8, labL);
                            if (sdef == 0) {
                                if (bodyS > 0) {
                                    // eager construction: replay the body in
                                    // member-init mode (default PRIVATE);
                                    // full state save so nesting is safe
                                    #stack[int, 64] rp = ciPos;
                                    #stack[int, 64] rc = ciCur;
                                    #stack[int, 64] rtn = ciTokNum;
                                    #stack[int, 64] rto = ciTokOff;
                                    #stack[int, 64] rtl = ciTokLen;
                                    #stack[int, 64] rsg = ciSignal;
                                    #stack[int, 64] rso = ciCurSecOff;
                                    #stack[int, 64] rsl = ciCurSecLen;
                                    #stack[int, 64] rsi = ciSecInit;
                                    #stack[int, 64] rsv = ciSecVis;
                                    ciCurSecOff = sno;
                                    ciCurSecLen = snl;
                                    ciSecInit = 1;
                                    ciSecVis = 0;
                                    ciSignal = 0;
                                    #stack[int, 32] dii = 0;
                                    while (dii < depN) {
                                        #stack[int, 64] iso = cssc::peek64(depSO + dii * 8);
                                        #stack[int, 64] isl = cssc::peek64(depSL + dii * 8);
                                        #stack[int, 64] iio = cssc::peek64(depIO + dii * 8);
                                        #stack[int, 64] iil = cssc::peek64(depIL + dii * 8);
                                        ciVarFind(iso, isl) gi;
                                        if (gi >= 0) {
                                            #stack[int, 64] dv = cssc::peek64(ciVVals + gi * 8);
                                            #stack[int, 64] dt = cssc::peek64(ciVTypes + gi * 8);
                                            ciQualify(sno, snl, iio, iil) dq;
                                            ciBindVis = 0;
                                            ciVarSet(ciQualBuf - ciSrc, dq, dv, dt, 0);
                                            ciBindVis = 1;
                                            #delete[dv];
                                            #delete[dt];
                                            #delete[dq];
                                        }
                                        #delete[gi];
                                        #delete[iso];
                                        #delete[isl];
                                        #delete[iio];
                                        #delete[iil];
                                        dii = dii + 1;
                                    }
                                    #delete[dii];
                                    ciPos = bodyS;
                                    ciAdvance();
                                    #stack[int, 32] bg2 = 1;
                                    while (bg2 == 1) {
                                        if (ciCur == 12) { bg2 = 0; }
                                        if (ciCur == 0) { bg2 = 0; }
                                        if (ciSignal >= 2) { bg2 = 0; }
                                        if (bg2 == 1) { ciStmt(); }
                                    }
                                    #delete[bg2];
                                    ciPos = rp;
                                    ciCur = rc;
                                    ciTokNum = rtn;
                                    ciTokOff = rto;
                                    ciTokLen = rtl;
                                    ciSignal = rsg;
                                    ciCurSecOff = rso;
                                    ciCurSecLen = rsl;
                                    ciSecInit = rsi;
                                    ciSecVis = rsv;
                                    #delete[rp];
                                    #delete[rc];
                                    #delete[rtn];
                                    #delete[rto];
                                    #delete[rtl];
                                    #delete[rsg];
                                    #delete[rso];
                                    #delete[rsl];
                                    #delete[rsi];
                                    #delete[rsv];
                                }
                            }
                        }
                        #delete[si];
                    }
                }
                #delete[freeS];
                #delete[freeE];
                #delete[bodyS];
                #delete[bodyE];
                #delete[sdef];
                #delete[labO];
                #delete[labL];
                cssc::free(depSO);
                cssc::free(depSL);
                cssc::free(depIO);
                cssc::free(depIL);
                #delete[depN];
                #delete[depSO];
                #delete[depSL];
                #delete[depIO];
                #delete[depIL];
                #delete[sno];
                #delete[snl];
                h = 1;
            }
        }
        // ---- object Name <ctorParams>? { ctor-stmts labels* } free {..} ; --
        // Registered WITHOUT executing (the body is the constructor and
        // replays per instantiation). The token scan records the ctor
        // boundary (first label ident / closing brace) and every depth-1
        // label: IDENT (<params>)? ':' -> name + param span + body span.
        if (h == 0) {
            if (kobj == 1) {
                ciAdvance();
                #stack[int, 64] ono = ciTokOff;
                #stack[int, 64] onl = ciTokLen;
                if (ciCur == 2) { ciAdvance(); }
                #stack[int, 64] oParS = 0;
                if (ciCur == 17) {
                    oParS = ciPos;
                    #stack[int, 32] psk = 1;
                    while (psk == 1) {
                        if (ciCur == 18) { psk = 0; }
                        if (ciCur == 0) { psk = 0; }
                        if (psk == 1) { ciAdvance(); }
                    }
                    if (ciCur == 18) { ciAdvance(); }
                    #delete[psk];
                }
                #stack[int, 32] reg = 0;
                if (ciExec == 1) {
                    if (ciScopeBase == 0) {
                        if (ciObjCount < 32) { reg = 1; }
                    }
                }
                #stack[int, 64] oi = ciObjCount;
                #stack[int, 64] lastLab = 0 - 1;
                #stack[int, 64] oBodyS = 0;
                #stack[int, 64] oBodyE = 0;
                #stack[int, 64] oTopE = 0;
                if (ciCur == 11) {
                    oBodyS = ciPos;
                    #stack[int, 32] dep2 = 1;
                    #stack[int, 32] sc2 = 1;
                    while (sc2 == 1) {
                        ciAdvance();
                        if (ciCur == 0) { sc2 = 0; }
                        if (sc2 == 1) {
                            if (dep2 == 1) {
                                if (ciCur == 2) {
                                    // label lookahead (consumes the ident and
                                    // an optional <...> param list)
                                    #stack[int, 64] lo = ciTokOff;
                                    #stack[int, 64] ll = ciTokLen;
                                    // FX-OBJ-BOUND: the previous label's body ends
                                    // at THIS label's ident TOKEN INDEX (ciPos-1),
                                    // not its byte offset (ciTokOff) -- the replay
                                    // consumer bounds on the token cursor ciPos.
                                    #stack[int, 64] labTokIdx = ciPos - 1;
                                    ciAdvance();
                                    #stack[int, 64] lps = 0;
                                    #stack[int, 32] isLab = 0;
                                    if (ciCur == 31) { isLab = 1; }
                                    if (ciCur == 17) {
                                        // PARAM-SHAPE GUARD: a real param list
                                        // holds only idents ':' ',' '&' '*'.
                                        // Anything else (number, '(', '{') is
                                        // a less-than comparison -- abort the
                                        // label hypothesis; the offending
                                        // token flows to the depth check, so
                                        // brace bookkeeping stays exact.
                                        lps = ciPos;
                                        ciAdvance();
                                        #stack[int, 32] lsk = 1;
                                        while (lsk == 1) {
                                            if (ciCur == 18) { lsk = 0; }
                                            if (ciCur == 0) { lsk = 0; }
                                            if (lsk == 1) {
                                                #stack[int, 32] shape = 0;
                                                if (ciCur == 2) { shape = 1; }
                                                if (ciCur == 31) { shape = 1; }
                                                if (ciCur == 21) { shape = 1; }
                                                if (ciCur == 30) { shape = 1; }
                                                if (ciCur == 6) { shape = 1; }
                                                if (shape == 0) { lsk = 0; lps = 0; }
                                                if (shape == 1) { ciAdvance(); }
                                                #delete[shape];
                                            }
                                        }
                                        if (lps > 0) {
                                            if (ciCur == 18) { ciAdvance(); }
                                            if (ciCur == 31) { isLab = 1; }
                                        }
                                        #delete[lsk];
                                    }
                                    // 'public:'/'private:' are SECTION marks,
                                    // never labels: skip without touching the
                                    // ctor boundary or any label span
                                    if (isLab == 1) {
                                        ciIdentIs(lo, ll, "public") opub;
                                        ciIdentIs(lo, ll, "private") opriv;
                                        if (opub == 1) { isLab = 0; }
                                        if (opriv == 1) { isLab = 0; }
                                        #delete[opub];
                                        #delete[opriv];
                                    }
                                    if (isLab == 1) {
                                        // previous span ends at this ident (token index)
                                        if (lastLab >= 0) {
                                            cssc::poke64(ciLabBodyE + lastLab * 8, labTokIdx);
                                        }
                                        if (lastLab < 0) { oTopE = labTokIdx; }
                                        if (reg == 1) {
                                            if (ciLabCount < 256) {
                                                cssc::poke64(ciLabObj + ciLabCount * 8, oi);
                                                cssc::poke64(ciLabNameOff + ciLabCount * 8, lo);
                                                cssc::poke64(ciLabNameLen + ciLabCount * 8, ll);
                                                cssc::poke64(ciLabParS + ciLabCount * 8, lps);
                                                cssc::poke64(ciLabBodyS + ciLabCount * 8, ciPos);
                                                lastLab = ciLabCount;
                                                ciLabCount = ciLabCount + 1;
                                            }
                                        }
                                    }
                                    #delete[isLab];
                                    #delete[lps];
                                    #delete[labTokIdx];
                                    #delete[lo];
                                    #delete[ll];
                                }
                            }
                            // depth bookkeeping for the CURRENT token (also
                            // covers tokens left by the label lookahead)
                            if (ciCur == 11) { dep2 = dep2 + 1; }
                            if (ciCur == 12) {
                                dep2 = dep2 - 1;
                                if (dep2 == 0) { sc2 = 0; }
                            }
                        }
                    }
                    #delete[sc2];
                    #delete[dep2];
                    oBodyE = ciPos;
                    // last span ends at the closing '}' (ciPos points past it)
                    #stack[int, 64] endOff = ciPos - 1;
                    if (lastLab >= 0) {
                        cssc::poke64(ciLabBodyE + lastLab * 8, endOff);
                    }
                    if (oTopE == 0) { oTopE = endOff; }
                    #delete[endOff];
                    if (ciCur == 12) { ciAdvance(); }
                }
                // mandatory trailing free { ... } (may be empty)
                #stack[int, 64] oFreeS = 0;
                #stack[int, 64] oFreeE = 0;
                if (ciCur == 2) {
                    #stack[int, 64] fko2 = ciTokOff;
                    #stack[int, 64] fkl2 = ciTokLen;
                    ciIdentIs(fko2, fkl2, "free") isfb2;
                    if (isfb2 == 1) {
                        ciAdvance();
                        if (ciCur == 11) {
                            oFreeS = ciPos;
                            #stack[int, 32] dep4 = 1;
                            #stack[int, 32] sc4 = 1;
                            while (sc4 == 1) {
                                ciAdvance();
                                if (ciCur == 0) { sc4 = 0; }
                                if (ciCur == 11) { dep4 = dep4 + 1; }
                                if (ciCur == 12) {
                                    dep4 = dep4 - 1;
                                    if (dep4 == 0) { sc4 = 0; }
                                }
                            }
                            #delete[sc4];
                            #delete[dep4];
                            oFreeE = ciPos;
                            if (ciCur == 12) { ciAdvance(); }
                        }
                    }
                    #delete[isfb2];
                    #delete[fko2];
                    #delete[fkl2];
                }
                if (ciCur == 13) { ciAdvance(); }
                if (reg == 1) {
                    cssc::poke64(ciObjNameOff + oi * 8, ono);
                    cssc::poke64(ciObjNameLen + oi * 8, onl);
                    cssc::poke64(ciObjParS + oi * 8, oParS);
                    cssc::poke64(ciObjBodyS + oi * 8, oBodyS);
                    cssc::poke64(ciObjBodyE + oi * 8, oBodyE);
                    cssc::poke64(ciObjTopE + oi * 8, oTopE);
                    cssc::poke64(ciObjFreeS + oi * 8, oFreeS);
                    cssc::poke64(ciObjFreeE + oi * 8, oFreeE);
                    ciObjCount = ciObjCount + 1;
                }
                #delete[oFreeS];
                #delete[oFreeE];
                #delete[oBodyS];
                #delete[oBodyE];
                #delete[oTopE];
                #delete[lastLab];
                #delete[oi];
                #delete[reg];
                #delete[oParS];
                #delete[ono];
                #delete[onl];
                h = 1;
            }
        }
        if (kif == 1) {
            // if (cond) { body } [ else if (cond) { body } ]* [ else { body } ]
            ciAdvance();
            if (ciCur == 9) { ciAdvance(); }
            ciExpr(0) c;
            if (ciCur == 10) { ciAdvance(); }
            #stack[int, 64] se = ciExec;
            // tookAny: has any branch of this chain executed yet?
            #stack[int, 32] tookAny = 0;
            if (c != 0) { if (se == 1) { tookAny = 1; } }
            if (tookAny == 1) { ciExec = 1; }
            if (tookAny == 0) { ciExec = 0; }
            ciStmt();
            ciExec = se;
            // walk any else / else-if that follows
            #stack[int, 32] chaining = 1;
            while (chaining == 1) {
                #stack[int, 32] iselse = 0;
                if (ciCur == 2) {
                    #stack[int, 64] eo = ciTokOff;
                    #stack[int, 64] el = ciTokLen;
                    ciIdentIs(eo, el, "else") ie;
                    if (ie == 1) { iselse = 1; }
                    #delete[ie];
                    #delete[eo];
                    #delete[el];
                }
                if (iselse == 0) { chaining = 0; }
                if (iselse == 1) {
                    ciAdvance();
                    // distinguish 'else if' from a plain 'else'
                    #stack[int, 32] iseif = 0;
                    if (ciCur == 2) {
                        #stack[int, 64] fo = ciTokOff;
                        #stack[int, 64] fl = ciTokLen;
                        ciIdentIs(fo, fl, "if") iif;
                        if (iif == 1) { iseif = 1; }
                        #delete[iif];
                        #delete[fo];
                        #delete[fl];
                    }
                    if (iseif == 1) {
                        ciAdvance();
                        if (ciCur == 9) { ciAdvance(); }
                        ciExpr(0) c2;
                        if (ciCur == 10) { ciAdvance(); }
                        #stack[int, 32] run2 = 0;
                        if (tookAny == 0) { if (c2 != 0) { if (se == 1) { run2 = 1; } } }
                        if (run2 == 1) { ciExec = 1; tookAny = 1; }
                        if (run2 == 0) { ciExec = 0; }
                        ciStmt();
                        ciExec = se;
                        #delete[run2];
                        #delete[c2];
                    }
                    if (iseif == 0) {
                        // plain 'else { body }' terminates the chain
                        #stack[int, 32] run2 = 0;
                        if (tookAny == 0) { if (se == 1) { run2 = 1; } }
                        if (run2 == 1) { ciExec = 1; tookAny = 1; }
                        if (run2 == 0) { ciExec = 0; }
                        ciStmt();
                        ciExec = se;
                        chaining = 0;
                        #delete[run2];
                    }
                    #delete[iseif];
                }
                #delete[iselse];
            }
            #delete[chaining];
            #delete[tookAny];
            #delete[se];
            #delete[c];
            h = 1;
        }
        if (h == 0) {
            if (kwh == 1) {
                ciAdvance();
                #stack[int, 64] condPos = ciPos;
                #stack[int, 64] se = ciExec;
                #stack[int, 32] looping = 1;
                while (looping == 1) {
                    ciPos = condPos;
                    ciAdvance();
                    if (ciCur == 9) { ciAdvance(); }
                    ciExpr(0) c;
                    if (ciCur == 10) { ciAdvance(); }
                    #stack[int, 32] rb = 0;
                    if (c != 0) { if (se == 1) { rb = 1; } }
                    if (rb == 1) { ciExec = 1; ciStmt(); }
                    if (rb == 0) { ciExec = 0; ciStmt(); looping = 0; }
                    ciExec = se;
                    // guest loop control: signal 4 (break) ends THIS loop,
                    // signal 5 (continue) just re-evaluates the condition; both
                    // consumed here. return(2)/destruct(3) keep propagating out.
                    if (ciSignal == 4) { ciSignal = 0; looping = 0; }
                    if (ciSignal == 5) { ciSignal = 0; }
                    if (ciSignal >= 2) { looping = 0; }
                    #delete[rb];
                    #delete[c];
                }
                #delete[looping];
                #delete[se];
                #delete[condPos];
                h = 1;
            }
        }
        // ---- for (init; cond; post) { body } -- C-style. init runs once; each
        // iteration re-evaluates cond by resetting ciPos to the saved TOKEN INDEX
        // (zero re-lex). post runs after the body unless break/return exits.
        // continue runs post; break/return/destruct exit. The loop var lives in the
        // enclosing scope. (firefield uses while; for is here for completeness.)
        if (h == 0) {
            if (kfor == 1) {
                ciAdvance();                          // consume 'for'
                if (ciCur == 9) { ciAdvance(); }      // '(' -> ciCur = first init token
                #stack[int, 64] se = ciExec;
                // for-init: accept a bare `int i = expr` (also float/string/bool/
                // auto) loop-variable declaration. The bare type keyword as the
                // first init token means "declare this loop-local", mapped to the
                // same slot creation the #stack path uses (default bit width 64).
                // Anything else (assignment, #stack[..] decl, call) runs via ciStmt.
                #stack[int, 32] forDecl = 0;
                #stack[int, 64] fdType = 0;
                if (ciCur == 2) {
                    ciIdentIs(ciTokOff, ciTokLen, "int") fki;
                    ciIdentIs(ciTokOff, ciTokLen, "float") fkf;
                    ciIdentIs(ciTokOff, ciTokLen, "string") fks;
                    ciIdentIs(ciTokOff, ciTokLen, "bool") fkb;
                    ciIdentIs(ciTokOff, ciTokLen, "auto") fka;
                    if (fki == 1) { forDecl = 1; fdType = 0; }
                    if (fkf == 1) { forDecl = 1; fdType = 2; }
                    if (fks == 1) { forDecl = 1; fdType = 1; }
                    if (fkb == 1) { forDecl = 1; fdType = 0; }
                    if (fka == 1) { forDecl = 1; fdType = 0; }
                    #delete[fki];
                    #delete[fkf];
                    #delete[fks];
                    #delete[fkb];
                    #delete[fka];
                }
                if (forDecl == 1) {
                    ciAdvance();                      // consume type keyword
                    #stack[int, 64] fno = ciTokOff;   // loop-var name span
                    #stack[int, 64] fnl = ciTokLen;
                    ciAdvance();                      // consume name
                    #stack[int, 64] fv  = 0;
                    #stack[int, 64] fvt = fdType;
                    #stack[int, 64] fvo = 0;
                    if (ciCur == 14) {                // '='
                        ciAdvance();
                        ciExpr(0) fe;
                        fv  = fe;
                        fvt = ciEvalType;
                        fvo = ciEvalOwns;
                        #delete[fe];
                    }
                    if (ciExec == 1) {
                        ciSetMode = 0;                // force a fresh frame-local slot
                        ciVarSet(fno, fnl, fv, fvt, fvo);
                    }
                    if (ciExec == 0) {
                        if (fvo == 1) { if (fvt == 1) { cssc::free(fv); } }
                    }
                    if (ciCur == 13) { ciAdvance(); } // consume ';'
                    #delete[fv];
                    #delete[fvt];
                    #delete[fvo];
                    #delete[fno];
                    #delete[fnl];
                }
                if (forDecl == 0) {
                    ciStmt();                         // run init once (consumes its ';')
                }
                #delete[forDecl];
                #delete[fdType];
                #stack[int, 64] condPos = ciPos - 1;  // first cond token (cur is at ciPos-1)
                #stack[int, 64] svx = ciExec;
                ciExec = 0;
                ciExpr(0) cskip;                      // skip cond to reach the ';'
                #delete[cskip];
                ciExec = svx;
                #delete[svx];
                if (ciCur == 13) { ciAdvance(); }     // ';' -> ciCur = first post token
                #stack[int, 64] postPos = ciPos - 1;  // first post token
                // skip post by scanning to the matching ')'
                #stack[int, 64] pdepth = 0;
                #stack[int, 32] psc = 1;
                while (psc == 1) {
                    if (ciCur == 0) { psc = 0; }
                    if (ciCur == 9) { pdepth = pdepth + 1; }
                    if (ciCur == 10) {
                        if (pdepth == 0) { psc = 0; }
                        if (pdepth > 0) { pdepth = pdepth - 1; }
                    }
                    if (psc == 1) { ciAdvance(); }
                }
                #delete[psc];
                #delete[pdepth];
                if (ciCur == 10) { ciAdvance(); }     // ')' -> ciCur = '{' body start
                #stack[int, 64] bodyPos = ciPos - 1;  // '{'
                #stack[int, 32] looping = 1;
                while (looping == 1) {
                    ciPos = condPos;
                    ciAdvance();
                    ciExpr(0) c;
                    #stack[int, 32] rb = 0;
                    if (c != 0) { if (se == 1) { rb = 1; } }
                    #delete[c];
                    if (rb == 1) {
                        ciPos = bodyPos;
                        ciAdvance();
                        ciExec = 1;
                        ciStmt();
                        #stack[int, 32] didBrk = 0;
                        if (ciSignal == 5) { ciSignal = 0; }
                        if (ciSignal == 4) { ciSignal = 0; looping = 0; didBrk = 1; }
                        if (ciSignal == 2) { looping = 0; didBrk = 1; }
                        if (ciSignal == 3) { looping = 0; didBrk = 1; }
                        if (didBrk == 0) {
                            ciPos = postPos;
                            ciAdvance();
                            ciExec = 1;
                            ciStmt();
                        }
                        #delete[didBrk];
                    }
                    if (rb == 0) {
                        ciPos = bodyPos;
                        ciAdvance();
                        ciExec = 0;
                        ciStmt();
                        looping = 0;
                    }
                    ciExec = se;
                    #delete[rb];
                }
                #delete[looping];
                #delete[bodyPos];
                #delete[postPos];
                #delete[condPos];
                #delete[se];
                h = 1;
            }
        }
        // ---- select (iterable) ?label { body } ----
        // Iterates a container/string ONE element per pass, binding each element
        // to ?label. Body advances the cursor via jump;(+1) jump++;(+2)
        // !jump;(-1) !jump++;(-2). continue == jump(+1); break exits. Falling off
        // the body WITHOUT a jump EXITS (no implicit advance). map yields VALUES;
        // bind yields FLAT CELLS (the one CCOS divergence from CSSC pair-iter --
        // CCOS has no pair scalar to bind to a label). Cursor out of range exits.
        if (h == 0) {
            if (ksel == 1) {
                ciAdvance();                          // 'select'
                if (ciCur == 9) { ciAdvance(); }      // '('
                ciExpr(0) ih;                         // evaluate iterable ONCE
                #stack[int, 64] it    = ciEvalType;   // 4 vec / 5 map / 7 bind / 1 string
                #stack[int, 64] ownIt = ciEvalOwns;
                if (ciCur == 10) { ciAdvance(); }     // ')'
                if (ciCur == 32) { ciAdvance(); }     // '?'
                #stack[int, 64] labOff  = ciTokOff;   // label name span
                #stack[int, 64] labLen  = ciTokLen;
                #stack[int, 64] bodyPos = ciPos;      // past label -> re-lexes to '{'
                if (ciCur == 2) { ciAdvance(); }      // consume label ident

                // element COUNT per container (safe in skip mode: a missing var
                // gives it==0 -> no branch dereferences ih)
                #stack[int, 64] count = 0;
                if (it == 4) { ciVecSize(ih) rvs; count = rvs; #delete[rvs]; }
                if (it == 5) { ciMapSize(ih) rms; count = rms; #delete[rms]; }
                if (it == 1) { count = cssc::peek32(ih + 4); }
                if (it == 7) {
                    ciBindPairs(ih) rbp;
                    ciBindWidth(ih) rbw;
                    count = rbp * rbw;
                    #delete[rbp];
                    #delete[rbw];
                }

                #stack[int, 64] svCur = ciSelCursor; #stack[int, 64] svIn = ciInSelect;
                #stack[int, 64] svLO  = ciSelLabOff; #stack[int, 64] svLL = ciSelLabLen;
                ciSelLabOff = labOff;
                ciSelLabLen = labLen;

                #stack[int, 64] se = ciExec;
                #stack[int, 64] cursor  = 0;
                #stack[int, 64] maxIter = count * 1000;
                if (maxIter < 100000) { maxIter = 100000; }
                #stack[int, 64] iters = 0;
                #stack[int, 32] looping = 1;
                if (se == 0) { looping = 0; }

                while (looping == 1) {
                    #stack[int, 32] inb = 0;
                    if (cursor >= 0) { if (cursor < count) { inb = 1; } }
                    if (inb == 0) { looping = 0; }
                    if (inb == 1) { iters = iters + 1; if (iters > maxIter) { looping = 0; } }
                    if (looping == 1) {
                        #stack[int, 64] ev = 0;
                        #stack[int, 64] et = 0;
                        #stack[int, 64] eo = 0;
                        if (it == 4) {
                            ciVecGet(ih, cursor) rvg; ev = rvg; #delete[rvg];
                            #stack[int, 64] vet = cssc::peek32(ih + 12);
                            if (vet == 8) {
                                #stack[int, 64] vtp = cssc::peek64(ih + 24);
                                et = cssc::peek32(vtp + cursor * 8);
                                #delete[vtp];
                            }
                            if (vet != 8) {
                                ciVecType(ih) rvt; et = rvt; #delete[rvt];
                            }
                            if (et == 1) { eo = 1; }
                            #delete[vet];
                        }
                        if (it == 5) {
                            #stack[int, 64] d  = cssc::peek64(ih + 16);
                            #stack[int, 64] vt = cssc::peek64(d + cursor * 32 + 16);
                            #stack[int, 64] vv = cssc::peek64(d + cursor * 32 + 24);
                            et = vt;
                            if (vt == 1) { ciStrClone(vv) cc; ev = cc; eo = 1; #delete[cc]; }
                            if (vt != 1) { ev = vv; }
                            #delete[d];
                            #delete[vt];
                            #delete[vv];
                        }
                        if (it == 7) {
                            ciBindCellGet(ih, cursor) rbc; ev = rbc; #delete[rbc];
                            et = ciBindCellRT;
                            if (et == 1) { eo = 1; }
                        }
                        if (it == 1) {
                            ciStrNew(ih + 8 + cursor, 1) rsn; ev = rsn; et = 1; eo = 1; #delete[rsn];
                        }
                        ciSelCursor = cursor;
                        ciSetMode = 0;                         // bind label as frame-local
                        ciVarSet(labOff, labLen, ev, et, eo); // frees prev owned string
                        #delete[ev];
                        #delete[et];
                        #delete[eo];

                        ciPos = bodyPos;
                        ciAdvance();                           // ciCur == 11 ('{')
                        ciSignal = 0;
                        ciInSelect = svIn + 1;
                        ciStmt();
                        ciInSelect = svIn;

                        #stack[int, 64] sig = ciSignal;
                        if (sig == 6) { cursor = cursor + ciSelDelta; ciSignal = 0; }
                        if (sig == 5) { cursor = cursor + 1;          ciSignal = 0; }
                        if (sig == 4) { ciSignal = 0; looping = 0; }
                        if (sig == 0) { looping = 0; }
                        if (sig == 2) { looping = 0; }
                        if (sig == 3) { looping = 0; }
                        #delete[sig];
                    }
                    #delete[inb];
                }

                if (ciSignal < 2) {                            // reposition past body ONCE
                    ciPos = bodyPos;
                    ciAdvance();
                    #stack[int, 64] se2 = ciExec;
                    ciExec = 0;
                    ciStmt();
                    ciExec = se2;
                    #delete[se2];
                }

                ciVarDrop(labOff, labLen);                     // ?label dropped at '}'
                ciSelCursor = svCur;
                ciInSelect  = svIn;
                ciSelLabOff = svLO;
                ciSelLabLen = svLL;
                if (ownIt == 1) { if (it == 1) { cssc::free(ih); } }  // free owned string temp only

                #delete[se];
                #delete[looping];
                #delete[iters];
                #delete[maxIter];
                #delete[cursor];
                #delete[count];
                #delete[svCur];
                #delete[svIn];
                #delete[svLO];
                #delete[svLL];
                #delete[ownIt];
                #delete[it];
                #delete[ih];
                #delete[labOff];
                #delete[labLen];
                #delete[bodyPos];
                h = 1;
            }
        }
        if (h == 0) { if (koln == 1) { ciDoPrint(); h = 1; } }
        if (h == 0) { if (kout == 1) { ciDoPrint(); h = 1; } }
        if (h == 0) { if (kp32 == 1) { ciDoPoke(); h = 1; } }
        if (h == 0) { if (kp8 == 1) { ciDoPoke(); h = 1; } }
        if (h == 0) {
            if (kkinj == 1) {
                ciAdvance();
                if (ciCur == 9) { ciAdvance(); }
                ciExpr(0) sc;
                if (ciCur == 10) { ciAdvance(); }
                if (ciExec == 1) {
                    cssc::poke8(keyBufAddr + keyHead % 256, sc);
                    keyHead = keyHead + 1;
                }
                if (ciCur == 13) { ciAdvance(); }
                #delete[sc];
                h = 1;
            }
        }
        if (h == 0) {
            if (kmset == 1) {
                ciAdvance();
                if (ciCur == 9) { ciAdvance(); }
                ciExpr(0) msx;
                if (ciCur == 21) { ciAdvance(); }
                ciExpr(0) msy;
                if (ciCur == 21) { ciAdvance(); }
                ciExpr(0) msf;
                if (ciCur == 10) { ciAdvance(); }
                if (ciExec == 1) {
                    mouseX = msx;
                    mouseY = msy;
                    mouseFlags = msf;
                }
                if (ciCur == 13) { ciAdvance(); }
                #delete[msx];
                #delete[msy];
                #delete[msf];
                h = 1;
            }
        }
        if (h == 0) {
            if (kfsw == 1) {
                ciAdvance();
                if (ciCur == 9) { ciAdvance(); }
                ciExpr(0) fwn;                 // file name string
                #stack[int, 64] fwno = ciEvalOwns;
                if (ciCur == 21) { ciAdvance(); }
                ciExpr(0) fwc;                 // content string
                #stack[int, 64] fwco = ciEvalOwns;
                if (ciCur == 10) { ciAdvance(); }
                if (ciExec == 1) {
                    fsCreate(fwn + 8, cssc::peek32(fwn + 4));
                    if (fsIdx >= 0) {
                        fsStore(fsIdx, fwc + 8, cssc::peek32(fwc + 4));
                    }
                }
                if (fwno == 1) { cssc::free(fwn); }
                if (fwco == 1) { cssc::free(fwc); }
                if (ciCur == 13) { ciAdvance(); }
                #delete[fwn];
                #delete[fwno];
                #delete[fwc];
                #delete[fwco];
                h = 1;
            }
        }
        // ---- bare-statement cssc:: array builtins (route through ciExpr for side effect) ----
        if (h == 0) {
            #stack[int, 32] kArr = 0;
            if (kapush == 1) { kArr = 1; }
            if (kaunsh == 1) { kArr = 1; }
            if (kapop == 1) { kArr = 1; }
            if (kashift == 1) { kArr = 1; }
            if (kasort == 1) { kArr = 1; }
            if (karev == 1) { kArr = 1; }
            if (kaslice == 1) { kArr = 1; }
            if (kaconc == 1) { kArr = 1; }
            if (kauniq == 1) { kArr = 1; }
            if (kaflat == 1) { kArr = 1; }
            if (karange == 1) { kArr = 1; }
            if (kazip == 1) { kArr = 1; }
            if (kafill == 1) { kArr = 1; }
            if (kamap == 1) { kArr = 1; }
            if (kafilt == 1) { kArr = 1; }
            if (kagidx == 1) { kArr = 1; }
            if (kafind == 1) { kArr = 1; }
            if (kacount == 1) { kArr = 1; }
            if (kasum == 1) { kArr = 1; }
            if (kaavg == 1) { kArr = 1; }
            if (kArr == 1) {
                ciExpr(0) ae;
                #stack[int, 64] aet = ciEvalType;
                #stack[int, 64] aeo = ciEvalOwns;
                if (ciCur == 13) { ciAdvance(); }
                if (aeo == 1) { ciValFree(aet, ae); }
                #delete[aet]; #delete[aeo]; #delete[ae];
                h = 1;
            }
            #delete[kArr];
        }
        // ---- native module methods (gated on the #include flag) ----
        if (h == 0) { if (ciModId == 1) { ciDoVideo(); h = 1; } }
        if (h == 0) { if (ciModId == 2) { ciDoSound(); h = 1; } }
        if (h == 0) { if (ciModId == 3) { ciDoKey(); h = 1; } }
        if (h == 0) { if (ciModId == 4) { ciDoIni(); h = 1; } }
        if (h == 0) { if (ciModId == 14) { ciDoStdio(); h = 1; } }
        if (h == 0) { if (ciModId == 15) { ciDoSys(); h = 1; } }
        if (h == 0) { if (ciModId == 5) { ciDoSprite(); h = 1; } }
        if (h == 0) { if (ciModId == 6) { ciDoTilemap(); h = 1; } }
        if (h == 0) { if (ciModId == 7) { ciDoFont(); h = 1; } }
        if (h == 0) { if (ciModId == 11) { ciDoMouse(); h = 1; } }
        // ---- stdgrace: grace::catch(fn [, sink]) [capvar] ; (statement form). Runs
        // the target inline (self-recursive ciStmt) + builds a tag-7 [value,error]. ----
        if (h == 0) {
            if (ciModId == 10) {
                ciTokHasCC(o, l) gcc;
                #stack[int, 64] gmo = o;
                #stack[int, 64] gml = l;
                if (gcc >= 0) { gmo = o + gcc + 2; gml = l - gcc - 2; }
                ciIdentIs(gmo, gml, "catch") isCatch;
                ciAdvance();
                if (ciCur == 9) { ciAdvance(); }
                #stack[int, 64] gfn = 0 - 1;
                #stack[int, 64] gArgType = 0;
                #stack[int, 32] gCallable = 0;
                if (ciCur == 2) {
                    #stack[int, 64] fmo = ciTokOff;
                    #stack[int, 64] fml = ciTokLen;
                    ciFnFind(fmo, fml) fi;
                    if (fi >= 0) { gfn = fi; gCallable = 1; }
                    if (fi < 0) {
                        ciVarGet(fmo, fml) vgc;
                        gArgType = ciEvalType;
                        #delete[vgc];
                    }
                    ciAdvance();
                    #delete[fmo];
                    #delete[fml];
                    #delete[fi];
                }
                if (ciCur == 1) { gArgType = 0; if (ciTokFloat == 1) { gArgType = 2; } ciAdvance(); }
                if (ciCur == 3) { gArgType = 1; ciAdvance(); }
                #stack[int, 32] hasSink = 0;
                #stack[int, 64] sinkOff = 0;
                #stack[int, 64] sinkLen = 0;
                if (ciCur == 21) {
                    ciAdvance();
                    if (ciCur == 2) { sinkOff = ciTokOff; sinkLen = ciTokLen; hasSink = 1; ciAdvance(); }
                }
                #stack[int, 32] gsk = 1;
                while (gsk == 1) {
                    if (ciCur == 10) { gsk = 0; }
                    if (ciCur == 0) { gsk = 0; }
                    if (ciCur == 13) { gsk = 0; }
                    if (gsk == 1) { ciAdvance(); }
                }
                #delete[gsk];
                if (ciCur == 10) { ciAdvance(); }
                #stack[int, 32] hasCap = 0;
                #stack[int, 64] capOff = 0;
                #stack[int, 64] capLen = 0;
                if (ciCur == 2) { capOff = ciTokOff; capLen = ciTokLen; hasCap = 1; ciAdvance(); }
                if (ciCur == 13) { ciAdvance(); }
                if (ciExec == 1) {
                    if (isCatch == 1) {
                        #stack[int, 64] valType = 0;
                        #stack[int, 64] valVal = 0;
                        #stack[int, 64] errType = 0;
                        #stack[int, 64] errVal = 0;
                        #stack[int, 32] freeVal = 0;
                        if (gCallable == 1) {
                            #stack[int, 64] gcBase = ciScopeBase;
                            #stack[int, 64] gcCount = ciVCount;
                            #stack[int, 64] gcSignal = ciSignal;
                            #stack[int, 64] gcSecO = ciCurSecOff;
                            #stack[int, 64] gcSecL = ciCurSecLen;
                            #stack[int, 64] gcSecI = ciSecInit;
                            #stack[int, 64] gcSecV = ciSecVis;
                            #stack[int, 64] gcMir = ciMirrored;
                            #stack[int, 64] gcRV = ciRetVal;
                            #stack[int, 64] gcRT = ciRetType;
                            #stack[int, 64] gcRO = ciRetOwns;
                            #stack[int, 64] gcPos = ciPos;
                            #stack[int, 64] gcCur = ciCur;
                            #stack[int, 64] gcTN = ciTokNum;
                            #stack[int, 64] gcTO = ciTokOff;
                            #stack[int, 64] gcTL = ciTokLen;
                            ciRetVal = 0;
                            ciRetType = 0;
                            ciRetOwns = 0;
                            ciScopeBase = ciVCount;
                            ciSignal = 0;
                            ciMirrored = 0;
                            ciCurSecOff = cssc::peek64(ciFnSecOff + gfn * 8);
                            ciCurSecLen = cssc::peek64(ciFnSecLen + gfn * 8);
                            ciSecInit = 0;
                            #stack[int, 64] pgc = cssc::peek64(ciFnInjCnt + gfn * 8);
                            #stack[int, 32] pgj = pgc - 1;
                            while (pgj >= 0) {
                                if (ciSignal < 2) {
                                    ciPos = cssc::peek64(ciFnInjStart + (gfn * 8 + pgj) * 8);
                                    ciAdvance();
                                    #stack[int, 32] pgb = 1;
                                    while (pgb == 1) {
                                        if (ciCur == 12) { pgb = 0; }
                                        if (ciCur == 0) { pgb = 0; }
                                        if (ciSignal >= 2) { pgb = 0; }
                                        if (pgb == 1) { ciStmt(); }
                                    }
                                    #delete[pgb];
                                }
                                pgj = pgj - 1;
                            }
                            #delete[pgc];
                            #delete[pgj];
                            ciPos = cssc::peek64(ciFnBodyStart + gfn * 8);
                            ciAdvance();
                            #stack[int, 32] gcbg = 1;
                            while (gcbg == 1) {
                                if (ciCur == 12) { gcbg = 0; }
                                if (ciCur == 0) { gcbg = 0; }
                                if (ciSignal >= 2) { gcbg = 0; }
                                if (gcbg == 1) { ciStmt(); }
                            }
                            #delete[gcbg];
                            #stack[int, 64] gcSig = ciSignal;
                            #stack[int, 32] gcGot = 0;
                            if (gcSig == 2) { gcGot = 1; }
                            if (ciMirrored == 1) { gcGot = 1; }
                            #stack[int, 64] grv = 0;
                            #stack[int, 64] grt = 0;
                            #stack[int, 64] gro = 0;
                            if (gcGot == 1) { grv = ciRetVal; grt = ciRetType; gro = ciRetOwns; }
                            #stack[int, 32] gcfci = gcCount;
                            while (gcfci < ciVCount) {
                                #stack[int, 64] gcvv = cssc::peek64(ciVVals + gcfci * 8);
                                #stack[int, 64] gcvt = cssc::peek64(ciVTypes + gcfci * 8);
                                #stack[int, 64] gcvo = cssc::peek64(ciVOwns + gcfci * 8);
                                if (gcvo == 1) {
                                    if (gcvt == 1) { if (gcvv != grv) { cssc::free(gcvv); } }
                                    if (gcvt == 3) { if (gcvv != grv) { if (gcvv != 0) { ciInstFree(gcvv); } } }
                                }
                                #delete[gcvv];
                                #delete[gcvt];
                                #delete[gcvo];
                                gcfci = gcfci + 1;
                            }
                            #delete[gcfci];
                            ciScopeBase = gcBase;
                            ciVCount = gcCount;
                            ciSignal = gcSignal;
                            ciCurSecOff = gcSecO;
                            ciCurSecLen = gcSecL;
                            ciSecInit = gcSecI;
                            ciSecVis = gcSecV;
                            ciMirrored = gcMir;
                            ciRetVal = gcRV;
                            ciRetType = gcRT;
                            ciRetOwns = gcRO;
                            ciPos = gcPos;
                            ciCur = gcCur;
                            ciTokNum = gcTN;
                            ciTokOff = gcTO;
                            ciTokLen = gcTL;
                            if (gcSig == 7) {
                                valType = 3;
                                valVal = 0;
                                errType = 1;
                                errVal = ciFaultMsg;
                                ciFaultMsg = 0;
                                ciFaultKind = 0;
                            }
                            if (gcSig != 7) {
                                valType = grt;
                                valVal = grv;
                                errType = 0;
                                errVal = 0;
                                if (grt == 1) { if (gro == 1) { freeVal = 1; } }
                            }
