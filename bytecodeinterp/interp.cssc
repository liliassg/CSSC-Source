                    }
                    #delete[go];
                    if (ciCur == 10) { ciAdvance(); }
                    // coerce float-position args: an int arg (type != 2) is iToF'd,
                    // an already-float arg is kept (double-converting would corrupt it)
                    #stack[int, 64] f1 = a1; if (y1 != 2) { f1 = cssc::iToF(a1); }
                    #stack[int, 64] f2 = a2; if (y2 != 2) { f2 = cssc::iToF(a2); }
                    #stack[int, 64] f3 = a3; if (y3 != 2) { f3 = cssc::iToF(a3); }
                    #stack[int, 64] f4 = a4; if (y4 != 2) { f4 = cssc::iToF(a4); }
                    #stack[int, 64] f5 = a5; if (y5 != 2) { f5 = cssc::iToF(a5); }
                    // result type: default float (2); the int-returning methods flip to 0
                    #stack[int, 64] rt = 2;
                    if (mH2 == 1) { rt = 0; }
                    if (mH3 == 1) { rt = 0; }
                    if (mH4 == 1) { rt = 0; }
                    if (mFi == 1) { rt = 0; }
                    if (mAv == 1) { rt = 0; }
                    #stack[int, 64] r = 0;
                    if (ciExec == 1) {
                        if (mAv == 1) { r = 1; }
                        if (mH2 == 1) { ciMaHashN(a1, a2, a3, a4, 2) hh; r = hh; #delete[hh]; }
                        if (mH3 == 1) { ciMaHashN(a1, a2, a3, a4, 3) hh; r = hh; #delete[hh]; }
                        if (mH4 == 1) { ciMaHashN(a1, a2, a3, a4, 4) hh; r = hh; #delete[hh]; }
                        if (mHU == 1) { ciMaHashUnit(a1, a2) hh; r = hh; #delete[hh]; }
                        if (mHU3 == 1) { ciMaHashUnit3(a1, a2, a3) hh; r = hh; #delete[hh]; }
                        if (mFd == 1) { ciMaFade(f1) hh; r = hh; #delete[hh]; }
                        if (mLp == 1) { ciMaLerpf(f1, f2, f3) hh; r = hh; #delete[hh]; }
                        if (mLp2 == 1) { ciMaLerpf(f1, f2, f3) hh; r = hh; #delete[hh]; }
                        if (mFi == 1) { ciMaFloori(f1) hh; r = hh; #delete[hh]; }
                        if (mFf == 1) { r = cssc::fFloor(f1); }
                        if (mCf == 1) { r = cssc::fCeil(f1); }
                        if (mRf == 1) { r = cssc::fRound(f1); }
                        if (mAf == 1) { r = cssc::band(f1, 0x7FFFFFFFFFFFFFFF); }
                        if (mAf2 == 1) { r = cssc::band(f1, 0x7FFFFFFFFFFFFFFF); }
                        if (mSf == 1) { r = cssc::fSqrt(f1); }
                        if (mSf2 == 1) { r = cssc::fSqrt(f1); }
                        if (mMn == 1) { r = f1; if (cssc::fCmp(f2, f1) < 0) { r = f2; } }
                        if (mMx == 1) { r = f1; if (cssc::fCmp(f2, f1) > 0) { r = f2; } }
                        if (mCl == 1) { r = f1; if (cssc::fCmp(f1, f2) < 0) { r = f2; } if (cssc::fCmp(f1, f3) > 0) { r = f3; } }
                        if (mCl2 == 1) { r = f1; if (cssc::fCmp(f1, f2) < 0) { r = f2; } if (cssc::fCmp(f1, f3) > 0) { r = f3; } }
