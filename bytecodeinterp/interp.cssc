        #stack[int, 64] ekv = cssc::peek64(d + i * 32 + 8);
        ciVecPush(v, ekv, ekt);
        #delete[ekt];
        #delete[ekv];
        i = i + 1;
    }
    #delete[i];
    #delete[kt];
    #delete[d];
    #delete[size];
    return v;
}
// snapshot values in insertion order -> fresh owned vector (elem type = value
// type; string values cloned by ciVecPush). Empty map -> empty int-vector.
#define(ciMapValues) {
    #scanp(ciMapValues, int, 0) h;
    #req[ciVecNew] ciVecNew;
    #req[ciVecPush] ciVecPush;
    #stack[int, 64] size = cssc::peek32(h + 4);
    #stack[int, 64] d = cssc::peek64(h + 16);
    #stack[int, 64] vt = 0;
    if (size > 0) { vt = cssc::peek64(d + 16); }
    ciVecNew(vt) v;
    #stack[int, 64] i = 0;
    while (i < size) {
        #stack[int, 64] evt = cssc::peek64(d + i * 32 + 16);
        #stack[int, 64] evv = cssc::peek64(d + i * 32 + 24);
        ciVecPush(v, evv, evt);
        #delete[evt];
        #delete[evv];
        i = i + 1;
    }
    #delete[i];
    #delete[vt];
    #delete[d];
    #delete[size];
    return v;
}
// snapshot entries as a vector<vector> -- each element is a 2-slot string-vector
// [keyStr, valStr] so ciContFmt renders `{{k, v}, ...}` (curly braces, comma).
// NOTE: the inner pair-vectors are borrows of the outer (ciVecClear/Free frees
// only string elements), so they are reclaimed at process exit, not on free.
#define(ciMapItems) {
    #scanp(ciMapItems, int, 0) h;
    #req[ciVecNew] ciVecNew;
    #req[ciVecPush] ciVecPush;
    #stack[int, 64] size = cssc::peek32(h + 4);
    #stack[int, 64] d = cssc::peek64(h + 16);
    ciVecNew(4) v;
