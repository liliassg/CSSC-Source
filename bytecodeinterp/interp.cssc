                    ciAdvance();
                    if (ciCur == 4) { ciAdvance(); d = 2; }
                }
                if (ciCur == 13) { ciAdvance(); }
                if (ciExec == 1) { if (ciInSelect > 0) { ciSignal = 6; ciSelDelta = d; } }
                #delete[d];
