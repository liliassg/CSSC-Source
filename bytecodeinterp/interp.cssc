            }
            if (dh == 0) { ciDoDecl(); }
            #delete[dh];
            #delete[kfree];
            #delete[kres];
            #delete[kdbg];
            #delete[ktrc];
            #delete[kcat];
            #delete[kstdo];
            #delete[kinc];
            #delete[kunld];
            #delete[kld];
            #delete[kdep];
            #delete[kpanic];
            #delete[kincd];
            #delete[fo];
            #delete[fl];
            done = 1;
