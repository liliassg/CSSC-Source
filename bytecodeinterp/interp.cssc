        // a write-through link so `alias = x` mutates the real global.
        if (ciExec == 1) {
            ciVarSet(ano, anl, gv, gt, 0);
            if (hasRef == 0) {                        // snapshot -> no write-through link
                if (targetRow >= 0) {
                    ciVarFind(ano, anl) arow;
                    if (arow >= 0) { cssc::poke64(ciVReq + arow * 8, targetRow + 1); }
                    #delete[arow];
                }
