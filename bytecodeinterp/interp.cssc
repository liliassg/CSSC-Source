    // Gated on ciInSelect>0 so a stray !jump outside a select is inert. ----
    if (done == 0) {
        if (ciCur == 27) {
            #stack[int, 64] sP = ciPos;    #stack[int, 64] sC = ciCur;
            #stack[int, 64] sO = ciTokOff; #stack[int, 64] sL = ciTokLen; #stack[int, 64] sN = ciTokNum;
            ciAdvance();
            #stack[int, 32] isj = 0;
            if (ciCur == 2) {
