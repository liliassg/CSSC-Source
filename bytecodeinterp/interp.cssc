                        ciBindNew(1) bh;
                        cssc::poke32(bh + 4, 2);
                        ciBindRawSet(bh, 0, valType, valVal);
                        ciBindRawSet(bh, 1, errType, errVal);
                        if (freeVal == 1) { if (valVal != 0) { cssc::free(valVal); } }
                        if (errType == 1) { if (errVal != 0) { cssc::free(errVal); } }
                        if (hasCap == 1) { ciVarSet(capOff, capLen, bh, 7, 1); }
