                            // have pushed it further -- do NOT reset it here.)
                            if (ciLoadCount < 32) {
                                #stack[int, 32] zk = 0;
                                while (zk < 32) {
                                    cssc::poke8(ciLoadName + ciLoadCount * 32 + zk, 0);
                                    zk = zk + 1;
                                }
                                #delete[zk];
