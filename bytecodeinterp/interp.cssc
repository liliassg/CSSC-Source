// reset each run. value-tag 6 = console instance; value-tag 8 = mouse-client handle.
#stack[int, 64] ciModConsole = 0;
#stack[int, 64] ciModDev = 0;
#stack[int, 64] ciModGrace = 0;
#stack[int, 64] ciModStdout = 0;
#stack[int, 64] ciModMouse = 0;
