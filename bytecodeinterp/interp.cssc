                                            #stack[int, 64] rc2 = ciCur;
                                            #stack[int, 64] rtn2 = ciTokNum;
                                            #stack[int, 64] rto2 = ciTokOff;
                                            #stack[int, 64] rtl2 = ciTokLen;
                                            #stack[int, 64] rsg2 = ciSignal;
                                            #stack[int, 64] rvi2 = ciCurInst;
                                            #stack[int, 64] rvo2 = ciCurObj;
                                            #stack[int, 64] roi2 = ciObjInit;
                                            #stack[int, 64] rso2 = ciCurSecOff;
                                            #stack[int, 64] rsl2 = ciCurSecLen;
                                            #stack[int, 64] rsi2 = ciSecInit;
                                            ciCurInst = ival;
                                            ciCurObj = idf;
                                            ciObjInit = 0;
                                            ciCurSecOff = 0;
                                            ciCurSecLen = 0;
                                            ciSecInit = 0;
                                            ciSignal = 0;
                                            ciPos = ofs2;
                                            ciAdvance();
                                            #stack[int, 32] og = 1;
                                            while (og == 1) {
                                                if (ciCur == 12) { og = 0; }
                                                if (ciCur == 0) { og = 0; }
                                                if (ciSignal >= 2) { og = 0; }
                                                if (og == 1) { ciStmt(); }
                                            }
                                            #delete[og];
                                            ciPos = rp2;
                                            ciCur = rc2;
                                            ciTokNum = rtn2;
                                            ciTokOff = rto2;
                                            ciTokLen = rtl2;
                                            ciSignal = rsg2;
                                            ciCurInst = rvi2;
                                            ciCurObj = rvo2;
                                            ciObjInit = roi2;
                                            ciCurSecOff = rso2;
                                            ciCurSecLen = rsl2;
                                            ciSecInit = rsi2;
                                            #delete[rp2];
                                            #delete[rc2];
                                            #delete[rtn2];
                                            #delete[rto2];
                                            #delete[rtl2];
                                            #delete[rsg2];
                                            #delete[rvi2];
                                            #delete[rvo2];
                                            #delete[roi2];
                                            #delete[rso2];
                                            #delete[rsl2];
                                            #delete[rsi2];
                                        }
                                        #delete[ofs2];
                                        #delete[idf];
                                    }
                                    #delete[ifr2];
                                }
                                ciVarDrop(fno, fnl);
                            }
                            #delete[ity];
                            #delete[ival];
                        }
                        #delete[vi];
                    }
                    #delete[si];
                }
                #delete[fno];
                #delete[fnl];
                dh = 1;
            }
            if (dh == 0) {
                if (kres == 1) {
                    // ---- #reserve[label]; -- run a deferred sector's body now
                    ciAdvance();
                    if (ciCur == 23) { ciAdvance(); }
                    #stack[int, 64] lno = ciTokOff;
                    #stack[int, 64] lnl = ciTokLen;
                    if (ciCur == 2) { ciAdvance(); }
                    if (ciCur == 24) { ciAdvance(); }
                    if (ciCur == 13) { ciAdvance(); }
                    if (ciExec == 1) {
                        ciSecFindLab(lno, lnl) si;
                        if (si >= 0) {
                            // consume the label (a second #reserve is inert)
                            cssc::poke64(ciSecDefer + si * 8, 0);
                            cssc::poke64(ciSecLabLen + si * 8, 0);
                            #stack[int, 64] bs = cssc::peek64(ciSecBodyS + si * 8);
                            #stack[int, 64] snO = cssc::peek64(ciSecNameOff + si * 8);
                            #stack[int, 64] snL = cssc::peek64(ciSecNameLen + si * 8);
                            // replay the parked body in member-init mode
                            #stack[int, 64] rp = ciPos;
                            #stack[int, 64] rc = ciCur;
                            #stack[int, 64] rtn = ciTokNum;
                            #stack[int, 64] rto = ciTokOff;
                            #stack[int, 64] rtl = ciTokLen;
                            #stack[int, 64] rsg = ciSignal;
                            #stack[int, 64] rso = ciCurSecOff;
                            #stack[int, 64] rsl = ciCurSecLen;
                            #stack[int, 64] rsi = ciSecInit;
                            #stack[int, 64] rsv = ciSecVis;
                            ciCurSecOff = snO;
                            ciCurSecLen = snL;
                            ciSecInit = 1;
                            ciSecVis = 0;
                            ciSignal = 0;
                            ciPos = bs;
                            ciAdvance();
                            #stack[int, 32] rg = 1;
                            while (rg == 1) {
                                if (ciCur == 12) { rg = 0; }
                                if (ciCur == 0) { rg = 0; }
                                if (ciSignal >= 2) { rg = 0; }
                                if (rg == 1) { ciStmt(); }
                            }
                            #delete[rg];
                            ciPos = rp;
                            ciCur = rc;
                            ciTokNum = rtn;
                            ciTokOff = rto;
                            ciTokLen = rtl;
                            ciSignal = rsg;
                            ciCurSecOff = rso;
                            ciCurSecLen = rsl;
                            ciSecInit = rsi;
                            ciSecVis = rsv;
                            #delete[rp];
                            #delete[rc];
                            #delete[rtn];
                            #delete[rto];
                            #delete[rtl];
                            #delete[rsg];
                            #delete[rso];
                            #delete[rsl];
                            #delete[rsi];
                            #delete[rsv];
                            #delete[bs];
                            #delete[snO];
                            #delete[snL];
                        }
                        #delete[si];
                    }
                    #delete[lno];
                    #delete[lnl];
                    dh = 1;
                }
            }
            // ---- #include("name") / #depend("name") [alias]; -- enable a
            // native capability module (video/sound/ini) as a callable namespace
            if (kincd > 0) {
                ciAdvance();
                if (ciCur == 9) { ciAdvance(); }
                #stack[int, 64] mo = ciTokOff;
                #stack[int, 64] ml = ciTokLen;
                ciIdentIs(mo, ml, "video") mvid;
                ciIdentIs(mo, ml, "sound") msnd;
                ciIdentIs(mo, ml, "keyboard") mkey;
                ciIdentIs(mo, ml, "ini") mini;
                ciIdentIs(mo, ml, "cssc.ini") mini2;   // reference spelling
                ciIdentIs(mo, ml, "stdio") mstd;
                ciIdentIs(mo, ml, "cssc.sys") msys1;
                ciIdentIs(mo, ml, "sys") msys2;
                #stack[int, 32] msys = 0;
                if (msys1 == 1) { msys = 1; }
                if (msys2 == 1) { msys = 1; }
                #delete[msys1];
                #delete[msys2];
                ciIdentIs(mo, ml, "video.sprite") mspr;
                ciIdentIs(mo, ml, "video.tilemap") mtm;
                ciIdentIs(mo, ml, "video.font") mfnt;
                // math.accel: names "math.accel"/"acc"/"ma" -> modid 12 (any may be
                // the include name; a user-given alias is registered on top).
                ciIdentIs(mo, ml, "math.accel") mma1;
                ciIdentIs(mo, ml, "acc") mma2;
                ciIdentIs(mo, ml, "ma") mma3;
                #stack[int, 32] mmaA = 0;
                if (mma1 == 1) { mmaA = 1; }
                if (mma2 == 1) { mmaA = 1; }
                if (mma3 == 1) { mmaA = 1; }
                // cssc.math: names "cssc.math"/"math" -> modid 13.
                ciIdentIs(mo, ml, "cssc.math") mcm1;
                ciIdentIs(mo, ml, "math") mcm2;
                #stack[int, 32] mcmA = 0;
                if (mcm1 == 1) { mcmA = 1; }
                if (mcm2 == 1) { mcmA = 1; }
                // 'def' is the prelude gate (no module id / no alias): it enables
                // #cdefine / #param / #fvar / #qvar. firefield's first line.
                ciIdentIs(mo, ml, "def") mdef;
                // stdlib modules. console: instance-dispatched (tag 6), no modid.
                // devdebug/dev -> modid 9 (shared dev::stdout list). stdgrace -> 10.
                // stdout: companion (no modid). mouse -> modid 11.
                ciIdentIs(mo, ml, "console") mcon;
                #stack[int, 32] mconA = 0;
                ciIdentIs(mo, ml, "sys.console") mcon2;
                ciIdentIs(mo, ml, "cssc.console") mcon3;
                if (mcon == 1) { mconA = 1; }
                if (mcon2 == 1) { mconA = 1; }
                if (mcon3 == 1) { mconA = 1; }
                ciIdentIs(mo, ml, "devdebug") mdvd;
                ciIdentIs(mo, ml, "dev") mdv2;
                #stack[int, 32] mdevA = 0;
                if (mdvd == 1) { mdevA = 1; }
                if (mdv2 == 1) { mdevA = 1; }
                ciIdentIs(mo, ml, "stdgrace") mgrc;
                ciIdentIs(mo, ml, "stdout") mstdo;
                ciIdentIs(mo, ml, "mouse") mmou;
                ciAdvance();
                if (ciCur == 10) { ciAdvance(); }
                // optional alias:  #include("video") vid;  -> key = "vid"
                #stack[int, 64] aliasOff = mo;
                #stack[int, 64] aliasLen = ml;
                if (ciCur == 2) {
                    aliasOff = ciTokOff;
                    aliasLen = ciTokLen;
                    ciTokHasCC(aliasOff, aliasLen) aliasCC;
                    if (aliasCC >= 0) {
                        ciRaiseMsg("Unexpected token: DCOLON ('::')", ciLineAt(aliasOff), 2);
                    }
                    #delete[aliasCC];
                    ciAdvance();
                }
                if (ciCur == 13) { ciAdvance(); }
                if (ciExec == 1) {
                    #stack[int, 64] modid = 0;
                    if (mvid == 1) { ciModVideo = 1; modid = 1; }
                    if (msnd == 1) { ciModSound = 1; modid = 2; }
                    if (mkey == 1) { ciModKey = 1; modid = 3; }
                    if (mini == 1) { ciModIni = 1; modid = 4; }
                    if (mini2 == 1) { ciModIni = 1; modid = 4; }
                    if (mstd == 1) { ciModStdio = 1; modid = 14; }
                    if (msys == 1) { ciModSys = 1; modid = 15; }
                    if (mspr == 1) { ciModSprite = 1; modid = 5; }
                    if (mtm == 1) { ciModTilemap = 1; modid = 6; }
                    if (mfnt == 1) { ciModFont = 1; modid = 7; }
                    if (mmaA == 1) { ciModMathAccel = 1; modid = 12; }
                    if (mcmA == 1) { ciModCsscMath = 1; modid = 13; }
                    if (mdef == 1) { ciDefLoaded = 1; }
                    if (mconA == 1) { ciModConsole = 1; }
                    if (mdevA == 1) {
                        ciModDev = 1;
                        modid = 9;
                        if (ciDevStdout == 0) { ciVecNew(1) nl; ciDevStdout = nl; #delete[nl]; }
                    }
                    if (mgrc == 1) { ciModGrace = 1; modid = 10; }
                    if (mstdo == 1) { ciModStdout = 1; }
                    if (mmou == 1) { ciModMouse = 1; modid = 11; }
                    #stack[int, 32] mknown = 0;
                    if (mvid == 1) { mknown = 1; }
                    if (msnd == 1) { mknown = 1; }
                    if (mkey == 1) { mknown = 1; }
                    if (mini == 1) { mknown = 1; }
                    if (mini2 == 1) { mknown = 1; }
                    if (mstd == 1) { mknown = 1; }
                    if (msys == 1) { mknown = 1; }
                    if (mspr == 1) { mknown = 1; }
                    if (mtm == 1) { mknown = 1; }
                    if (mfnt == 1) { mknown = 1; }
                    if (mmaA == 1) { mknown = 1; }
                    if (mcmA == 1) { mknown = 1; }
                    if (mdef == 1) { mknown = 1; }
                    if (mconA == 1) { mknown = 1; }
                    if (mdevA == 1) { mknown = 1; }
                    if (mgrc == 1) { mknown = 1; }
                    if (mstdo == 1) { mknown = 1; }
                    if (mmou == 1) { mknown = 1; }
                    if (mknown == 0) {
                        #stack[int, 64] mln = ciLineAt(mo);
                        ciRaiseNamed("Unknown module: ", ciSrc + mo, ml, mln);
                        #delete[mln];
                    }
                    #delete[mknown];
                    if (modid > 0) {
                        if (ciAlCount < 128) {
                            cssc::poke64(ciAlOff + ciAlCount * 8, aliasOff);
                            cssc::poke64(ciAlLen + ciAlCount * 8, aliasLen);
                            cssc::poke64(ciAlMod + ciAlCount * 8, modid);
                            ciAlCount = ciAlCount + 1;
                        }
                    }
                    #delete[modid];
                }
                #delete[aliasOff];
                #delete[aliasLen];
                #delete[mvid];
                #delete[msnd];
                #delete[mkey];
                #delete[mini];
                #delete[mini2];
                #delete[mstd];
                #delete[msys];
                #delete[mspr];
                #delete[mtm];
                #delete[mfnt];
                #delete[mma1]; #delete[mma2]; #delete[mma3]; #delete[mmaA];
                #delete[mcm1]; #delete[mcm2]; #delete[mcmA];
                #delete[mdef];
                #delete[mcon];
                #delete[mcon2];
                #delete[mcon3];
                #delete[mconA];
                #delete[mdvd];
                #delete[mdv2];
                #delete[mdevA];
                #delete[mgrc];
                #delete[mstdo];
                #delete[mmou];
                #delete[mo];
                #delete[ml];
                dh = 1;
            }
            // ---- #unload("name"); / #unload[name]; -- disable + release ----
            if (kunld == 1) {
                ciAdvance();
                if (ciCur == 9) { ciAdvance(); }
                if (ciCur == 23) { ciAdvance(); }
                #stack[int, 64] mo = ciTokOff;
                #stack[int, 64] ml = ciTokLen;
                ciIdentIs(mo, ml, "video") mvid;
                ciIdentIs(mo, ml, "sound") msnd;
                ciIdentIs(mo, ml, "ini") mini;
                ciIdentIs(mo, ml, "cssc.ini") mini2;   // reference spelling
                ciIdentIs(mo, ml, "stdio") mstd;
                ciIdentIs(mo, ml, "video.sprite") mspr;
                ciIdentIs(mo, ml, "video.tilemap") mtm;
                ciIdentIs(mo, ml, "video.font") mfnt;
                ciIdentIs(mo, ml, "math.accel") mma1;
                ciIdentIs(mo, ml, "acc") mma2;
                ciIdentIs(mo, ml, "ma") mma3;
                #stack[int, 32] mmaA = 0;
                if (mma1 == 1) { mmaA = 1; }
                if (mma2 == 1) { mmaA = 1; }
                if (mma3 == 1) { mmaA = 1; }
                ciIdentIs(mo, ml, "cssc.math") mcm1;
                ciIdentIs(mo, ml, "math") mcm2;
                #stack[int, 32] mcmA = 0;
                if (mcm1 == 1) { mcmA = 1; }
                if (mcm2 == 1) { mcmA = 1; }
                ciAdvance();
                if (ciCur == 10) { ciAdvance(); }
                if (ciCur == 24) { ciAdvance(); }
                if (ciCur == 13) { ciAdvance(); }
                if (ciExec == 1) {
                    if (mvid == 1) { ciModVideo = 0; }
                    if (msnd == 1) {
                        ciModSound = 0;
                        // leave no sound leaking: silence the speaker on unload
                        cssc::outb(0x61, cssc::band(cssc::inb(0x61), 252));
                    }
                    if (mini == 1) { ciModIni = 0; }
                    if (mini2 == 1) { ciModIni = 0; }
                    if (mstd == 1) { ciModStdio = 0; }
                    if (mspr == 1) { ciModSprite = 0; }
                    if (mtm == 1) { ciModTilemap = 0; }
                    if (mfnt == 1) { ciModFont = 0; }
                    if (mmaA == 1) { ciModMathAccel = 0; }
                    if (mcmA == 1) { ciModCsscMath = 0; }
                    // also tombstone a loaded file's registered functions (its
                    // source bytes stay but ciFnFind can no longer resolve them)
                    #stack[int, 32] u = 0;
                    while (u < ciLoadCount) {
                        #stack[int, 32] match = 1;
                        if (ml > 32) { match = 0; }
                        #stack[int, 32] mci = 0;
                        while (mci < ml) {
                            if (cssc::peek8(ciLoadName + u * 32 + mci) != cssc::peek8(ciSrc + mo + mci)) { match = 0; }
                            mci = mci + 1;
                        }
                        #delete[mci];
                        if (ml < 32) {
                            if (cssc::peek8(ciLoadName + u * 32 + ml) != 0) { match = 0; }
                        }
                        if (match == 1) {
                            #stack[int, 64] tfs = cssc::peek64(ciLoadFnS + u * 8);
                            #stack[int, 64] tfe = cssc::peek64(ciLoadFnE + u * 8);
                            #stack[int, 32] tf = tfs;
                            while (tf < tfe) {
                                cssc::poke64(ciFnLens + tf * 8, 0);
                                tf = tf + 1;
                            }
                            #delete[tf];
                            #delete[tfs];
                            #delete[tfe];
                        }
                        #delete[match];
                        u = u + 1;
                    }
                    #delete[u];
                }
                #delete[mvid];
                #delete[msnd];
                #delete[mini];
                #delete[mini2];
                #delete[mstd];
                #delete[mspr];
                #delete[mtm];
                #delete[mfnt];
                #delete[mma1]; #delete[mma2]; #delete[mma3]; #delete[mmaA];
                #delete[mcm1]; #delete[mcm2]; #delete[mcmA];
                #delete[mo];
                #delete[ml];
                dh = 1;
            }
            // ---- #load[path]; / #load("path"); -- read a .cssc file from the
            // CCFS, append it to the master source buffer and run it once
            // (registering its #defines for the rest of this program) ----
            if (kld == 1) {
                ciAdvance();
                if (ciCur == 23) { ciAdvance(); }
                if (ciCur == 9) { ciAdvance(); }
                #stack[int, 64] po = ciTokOff;
                #stack[int, 64] pl = ciTokLen;
                ciAdvance();
                if (ciCur == 24) { ciAdvance(); }
                if (ciCur == 10) { ciAdvance(); }
                // capture the load ALIAS (`#load["path"] alias;`) -- used to register
                // the module's symbols as `alias::name`. Defaults to the path if absent.
                #stack[int, 64] ao = po;
                #stack[int, 64] al = pl;
                if (ciCur == 2) { ao = ciTokOff; al = ciTokLen; ciAdvance(); }
                if (ciCur == 13) { ciAdvance(); }
                if (ciExec == 1) {
                    fsFind(ciSrc + po, pl);
                    #stack[int, 64] fbuf = 0;
                    #stack[int, 64] fsz = 0;
                    #stack[int, 32] loadOk = 0;
                    #stack[int, 64] loadTmp = 0;
                    if (fsIdx >= 0) {
                        fbuf = cssc::peek64(fsData + fsIdx * 8);
                        fsz = cssc::peek64(fsSizes + fsIdx * 8);
                        loadOk = 1;
                    }
                    if (fsIdx < 0) {
                        loadTmp = cssc::alloc(262144);
                        cssc::osReadFile(ciSrc + po, pl, loadTmp, 262144) rdn;
                        if (rdn != (0 - 1)) {
                            fbuf = loadTmp;
                            fsz = rdn;
                            loadOk = 1;
                        }
                        if (rdn == (0 - 1)) {
                            ciRaiseNamed("#load: file not found: ", ciSrc + po, pl, ciLineAt(fo));
                        }
                        #delete[rdn];
                    }
                    if (loadOk == 1) {
                        #stack[int, 64] astart = ciSrcUsed + 1;
                        if (astart + fsz < 524280) {
                            cssc::poke8(ciSrcBuf + ciSrcUsed, 10);
                            #stack[int, 32] li = 0;
                            while (li < fsz) {
                                cssc::poke8(ciSrcBuf + astart + li, cssc::peek8(fbuf + li));
                                li = li + 1;
                            }
                            #delete[li];
                            #stack[int, 64] aend = astart + fsz;
                            #stack[int, 64] fnBefore = ciFnCount;
                            #stack[int, 64] vBefore = ciVCount;
                            // replay the appended span with the lexer state saved
                            #stack[int, 64] rp = ciPos;
                            #stack[int, 64] rc = ciCur;
                            #stack[int, 64] rtn = ciTokNum;
                            #stack[int, 64] rto = ciTokOff;
                            #stack[int, 64] rtl = ciTokLen;
                            #stack[int, 64] rsg = ciSignal;
                            ciSrcLen = aend;
                            // advance ciSrcUsed BEFORE running the module top-level, so a
                            // NESTED #load appends AFTER this module (not over it). A nested
                            // load pushes ciSrcUsed further, which must persist -- so we do
                            // NOT reset it after the run.
                            ciSrcUsed = aend;
                            ciSignal = 0;
                            // append the loaded file's tokens onto the stream, then
                            // parse them by TOKEN INDEX (ciPos was a byte cursor for
                            // ciTokenize; tokStart is where the appended tokens begin)
                            #stack[int, 64] tokStart = ciTokCount;
                            ciPos = astart;
                            ciTokenize();
                            ciPos = tokStart;
                            ciAdvance();
                            #stack[int, 32] lg = 1;
                            while (lg == 1) {
                                if (ciCur == 0) { lg = 0; }
                                if (ciTokOff >= aend) { lg = 0; }
                                if (ciSignal >= 2) { lg = 0; }
                                if (lg == 1) { ciStmt(); }
                            }
                            #delete[lg];
                            // ---- alias-qualified registration ----
                            // Register every fn/sector-method the module defined ALSO as
                            // `alias::name` (po/pl = the load alias), so external calls
                            // `alias::fn` and `alias::Sector::method` resolve. Bare internal
                            // calls keep the un-prefixed registration. Params copied too.
                            #stack[int, 64] fnEnd = ciFnCount;
                            #stack[int, 64] qr = fnBefore;
                            while (qr < fnEnd) {
                                #stack[int, 64] qnl = cssc::peek64(ciFnLens + qr * 8);
                                #stack[int, 32] qk = 0;
                                while (qk < al) {
                                    cssc::poke8(ciQualBuf + qk, cssc::peek8(ciSrc + ao + qk));
                                    qk = qk + 1;
                                }
                                #delete[qk];
                                cssc::poke8(ciQualBuf + al, 58);
                                cssc::poke8(ciQualBuf + al + 1, 58);
                                #stack[int, 32] qm = 0;
                                while (qm < qnl) {
                                    cssc::poke8(ciQualBuf + al + 2 + qm, cssc::peek8(ciFnNames + qr * 32 + qm));
                                    qm = qm + 1;
                                }
                                #delete[qm];
                                #stack[int, 64] qtotal = al + 2 + qnl;
                                #stack[int, 64] qbs = cssc::peek64(ciFnBodyStart + qr * 8);
                                #stack[int, 64] qbe = cssc::peek64(ciFnBodyEnd + qr * 8);
                                #stack[int, 64] qpc = cssc::peek64(ciFnParCnt + qr * 8);
                                ciRegSecOff = 0;
                                ciRegSecLen = 0;
                                ciBindVis = 1;
                                ciFnRegister(ciQualBuf - ciSrc, qtotal, qbs, qbe) qrow;
                                if (qrow >= 0) {
                                    cssc::poke64(ciFnParCnt + qrow * 8, qpc);
                                    #stack[int, 32] qp = 0;
                                    while (qp < qpc) {
                                        cssc::poke64(ciFnParOff + (qrow * 8 + qp) * 8, cssc::peek64(ciFnParOff + (qr * 8 + qp) * 8));
                                        cssc::poke64(ciFnParLen + (qrow * 8 + qp) * 8, cssc::peek64(ciFnParLen + (qr * 8 + qp) * 8));
                                        qp = qp + 1;
                                    }
                                    #delete[qp];
                                }
                                #delete[qrow];
                                #delete[qbs];
                                #delete[qbe];
                                #delete[qpc];
                                #delete[qtotal];
                                #delete[qnl];
                                qr = qr + 1;
                            }
                            #delete[qr];
                            #delete[fnEnd];
                            // alias-qualify module GLOBALS too: register each top-level var
                            // ALSO as `alias::name` = a SNAPSHOT of the value (reference:
                            // alias::var reads are stale; mutable state uses getters).
                            #stack[int, 64] vEnd = ciVCount;
                            #stack[int, 64] vqr = vBefore;
                            while (vqr < vEnd) {
                                #stack[int, 64] vnl = cssc::peek64(ciVLens + vqr * 8);
                                #stack[int, 32] vqk = 0;
                                while (vqk < al) {
                                    cssc::poke8(ciQualBuf + vqk, cssc::peek8(ciSrc + ao + vqk));
                                    vqk = vqk + 1;
                                }
                                #delete[vqk];
                                cssc::poke8(ciQualBuf + al, 58);
                                cssc::poke8(ciQualBuf + al + 1, 58);
                                #stack[int, 32] vqm = 0;
                                while (vqm < vnl) {
                                    cssc::poke8(ciQualBuf + al + 2 + vqm, cssc::peek8(ciVNames + vqr * 32 + vqm));
                                    vqm = vqm + 1;
                                }
                                #delete[vqm];
                                #stack[int, 64] vqtotal = al + 2 + vnl;
                                #stack[int, 64] vval = cssc::peek64(ciVVals + vqr * 8);
                                #stack[int, 64] vtyp = cssc::peek64(ciVTypes + vqr * 8);
                                ciVarSet(ciQualBuf - ciSrc, vqtotal, vval, vtyp, 0);
                                #delete[vval];
                                #delete[vtyp];
                                #delete[vqtotal];
                                #delete[vnl];
                                vqr = vqr + 1;
                            }
                            #delete[vqr];
                            #delete[vEnd];
                            // keep ciSrcLen extended (loaded fn bodies live here)
                            // but restore the lexer to the original program
                            ciPos = rp;
                            ciCur = rc;
                            ciTokNum = rtn;
                            ciTokOff = rto;
                            ciTokLen = rtl;
                            ciSignal = rsg;
