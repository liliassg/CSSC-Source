        if (h == 0) {
            if (ksec == 1) {
                ciAdvance();
                #stack[int, 64] sno = ciTokOff;
                #stack[int, 64] snl = ciTokLen;
                if (ciCur == 2) { ciAdvance(); }
                #stack[int, 64] depN = 0;
                #stack[int, 64] depSO = cssc::alloc(64);
                #stack[int, 64] depSL = cssc::alloc(64);
                #stack[int, 64] depIO = cssc::alloc(64);
