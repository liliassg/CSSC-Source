    cssc::poke8(ciKbNames + 103, 2); cssc::poke8(ciKbNames + 104, 120); cssc::poke8(ciKbNames + 105, 70); cssc::poke8(ciKbNames + 106, 57);
    cssc::poke8(ciKbNames + 107, 3); cssc::poke8(ciKbNames + 108, 121); cssc::poke8(ciKbNames + 109, 70); cssc::poke8(ciKbNames + 110, 49); cssc::poke8(ciKbNames + 111, 48);
    cssc::poke8(ciKbNames + 112, 3); cssc::poke8(ciKbNames + 113, 122); cssc::poke8(ciKbNames + 114, 70); cssc::poke8(ciKbNames + 115, 49); cssc::poke8(ciKbNames + 116, 49);
    cssc::poke8(ciKbNames + 117, 3); cssc::poke8(ciKbNames + 118, 123); cssc::poke8(ciKbNames + 119, 70); cssc::poke8(ciKbNames + 120, 49); cssc::poke8(ciKbNames + 121, 50);
    cssc::poke8(ciKbNames + 122, 6); cssc::poke8(ciKbNames + 123, 13); cssc::poke8(ciKbNames + 124, 82); cssc::poke8(ciKbNames + 125, 69); cssc::poke8(ciKbNames + 126, 84); cssc::poke8(ciKbNames + 127, 85); cssc::poke8(ciKbNames + 128, 82); cssc::poke8(ciKbNames + 129, 78);
    cssc::poke8(ciKbNames + 130, 6); cssc::poke8(ciKbNames + 131, 27); cssc::poke8(ciKbNames + 132, 69); cssc::poke8(ciKbNames + 133, 83); cssc::poke8(ciKbNames + 134, 67); cssc::poke8(ciKbNames + 135, 65); cssc::poke8(ciKbNames + 136, 80); cssc::poke8(ciKbNames + 137, 69);
    cssc::poke8(ciKbNames + 138, 0);
}

// ciLexRaw -- the raw single-token lexer. Reads ONE token starting at the BYTE
// cursor ciPos (skipping whitespace/comments), sets ciCur/ciTokNum/ciTokFloat/
// ciTokOff/ciTokLen, and advances ciPos past it. Called ONLY by ciTokenize during
// the one-time pre-pass; during parsing ciPos is a token index and this is never
// invoked. (Formerly ciAdvance -- the byte-cursor logic is byte-for-byte unchanged.)
#define(ciLexRaw) {
    #req[ciSrc] ciSrc;
    #req[ciSrcLen] ciSrcLen;
    #req[ciPos] ciPos;
    #req[ciCur] ciCur;
    #req[ciTokNum] ciTokNum;
    #req[ciTokFloat] ciTokFloat;
    #req[ciTokOff] ciTokOff;
    #req[ciTokLen] ciTokLen;
    ciTokFloat = 0;
    #stack[int, 32] skipping = 1;
    while (skipping == 1) {
        if (ciPos >= ciSrcLen) {
            skipping = 0;
        }
        if (skipping == 1) {
            #stack[int, 64] c = cssc::peek8(ciSrc + ciPos);
            #stack[int, 32] isws = 0;
            if (c == 32) { isws = 1; }
            if (c == 10) { isws = 1; }
            if (c == 13) { isws = 1; }
            if (c == 9) { isws = 1; }
            if (isws == 1) {
                ciPos = ciPos + 1;
            }
            if (isws == 0) {
                #stack[int, 32] iscomment = 0;
                if (c == 47) {
                    if (ciPos + 1 < ciSrcLen) {
                        #stack[int, 64] c2 = cssc::peek8(ciSrc + ciPos + 1);
                        if (c2 == 47) {
                            iscomment = 1;
                        }
                        if (c2 == 42) {
                            iscomment = 2;
                        }
                        #delete[c2];
                    }
                }
                if (iscomment == 1) {
                    #stack[int, 32] cs = 1;
                    while (cs == 1) {
                        if (ciPos >= ciSrcLen) { cs = 0; }
                        if (cs == 1) {
                            #stack[int, 64] cc = cssc::peek8(ciSrc + ciPos);
                            if (cc == 10) { cs = 0; }
                            if (cc != 10) { ciPos = ciPos + 1; }
                            #delete[cc];
                        }
                    }
                    #delete[cs];
                }
                if (iscomment == 2) {
                    ciPos = ciPos + 2;
                    #stack[int, 32] bcs = 1;
                    while (bcs == 1) {
                        if (ciPos + 1 >= ciSrcLen) { bcs = 0; ciPos = ciSrcLen; }
                        if (bcs == 1) {
                            #stack[int, 64] bc = cssc::peek8(ciSrc + ciPos);
                            #stack[int, 64] bc2 = cssc::peek8(ciSrc + ciPos + 1);
                            if (bc == 42) { if (bc2 == 47) { ciPos = ciPos + 2; bcs = 0; } }
                            if (bcs == 1) { ciPos = ciPos + 1; }
                            #delete[bc];
                            #delete[bc2];
                        }
                    }
                    #delete[bcs];
                }
                if (iscomment == 0) {
                    skipping = 0;
                }
                #delete[iscomment];
            }
            #delete[isws];
            #delete[c];
        }
    }
    #delete[skipping];
    if (ciPos >= ciSrcLen) {
        ciCur = 0;
    }
    if (ciPos < ciSrcLen) {
        #stack[int, 64] c = cssc::peek8(ciSrc + ciPos);
        #stack[int, 32] done = 0;
        // NUMBER: decimal, or hex when prefixed with 0x / 0X
        if (c >= 48) {
            if (c <= 57) {
                // detect a 0x / 0X hex prefix
                #stack[int, 32] ishex = 0;
                if (c == 48) {
                    if (ciPos + 1 < ciSrcLen) {
                        #stack[int, 64] cx = cssc::peek8(ciSrc + ciPos + 1);
                        if (cx == 120) { ishex = 1; }
                        if (cx == 88) { ishex = 1; }
                        #delete[cx];
                    }
                }
                if (ishex == 1) {
                    // hex literal: skip '0x', accumulate base-16 digits
                    #stack[int, 64] hexStart = ciPos;
                    ciPos = ciPos + 2;
                    #stack[int, 64] hv = 0;
                    #stack[int, 32] rd = 1;
                    while (rd == 1) {
                        if (ciPos >= ciSrcLen) { rd = 0; }
                        if (rd == 1) {
                            #stack[int, 64] d = cssc::peek8(ciSrc + ciPos);
                            #stack[int, 64] hd = 0 - 1;
                            if (d >= 48) { if (d <= 57) { hd = d - 48; } }
                            if (d >= 97) { if (d <= 102) { hd = d - 87; } }
                            if (d >= 65) { if (d <= 70) { hd = d - 55; } }
                            if (hd >= 0) {
                                hv = hv * 16 + hd;
                                ciPos = ciPos + 1;
                            }
                            if (hd < 0) { rd = 0; }
                            #delete[hd];
                            #delete[d];
                        }
                    }
                    #delete[rd];
                    ciTokNum = hv;
                    ciTokOff = hexStart;
                    ciTokLen = ciPos - hexStart;
                    ciTokFloat = 2;
                    ciCur = 1;
                    done = 1;
                    #delete[hv];
                    #delete[hexStart];
                }
                if (ishex == 0) {
                    // decimal literal: DIGIT+ ('.' DIGIT+)? -- a '.' is part of
                    // the number ONLY when a digit follows (so `3.` = int 3 + '.',
                    // `3.5` = float). A float token carries the f64 bit pattern in
                    // ciTokNum with ciTokFloat=1 (parsed via cssc::strToF).
                    #stack[int, 64] numStart = ciPos;
                    #stack[int, 64] v = 0;
                    #stack[int, 32] rd = 1;
                    while (rd == 1) {
                        if (ciPos >= ciSrcLen) { rd = 0; }
                        if (rd == 1) {
                            #stack[int, 64] d = cssc::peek8(ciSrc + ciPos);
                            #stack[int, 32] dig = 0;
                            if (d >= 48) { if (d <= 57) { dig = 1; } }
                            if (dig == 1) {
                                v = v * 10 + (d - 48);
                                ciPos = ciPos + 1;
                            }
                            if (dig == 0) { rd = 0; }
                            #delete[dig];
                            #delete[d];
                        }
                    }
                    #delete[rd];
                    #stack[int, 32] isFloat = 0;
                    if (ciPos + 1 < ciSrcLen) {
                        if (cssc::peek8(ciSrc + ciPos) == 46) {
                            #stack[int, 64] nd = cssc::peek8(ciSrc + ciPos + 1);
                            if (nd >= 48) { if (nd <= 57) { isFloat = 1; } }
                            #delete[nd];
                        }
                    }
                    if (isFloat == 1) {
                        ciPos = ciPos + 1;
                        // Build an integer mantissa + fractional-digit count so the
                        // literal can be produced by ONE correctly-rounded f64
                        // division mant / 10^fdc (Clinger fast path). The native
                        // cssc::strToF mis-rounds some literals -- e.g. "0.3" comes
                        // out as 0.30000000000000004 (one ULP high, it scales by an
                        // inexact 0.1) which then wrongly compares equal to 0.1+0.2.
                        // iToF/fDiv of exactly-representable operands rounds once and
                        // matches the reference's compile-time literal parse. Fall
                        // back to strToF only outside the exact range (mant > 2^53 or
                        // fdc > 15), preserving prior behavior for huge literals.
                        #stack[int, 64] mant = v;
                        #stack[int, 64] fdc = 0;
                        #stack[int, 32] moflow = 0;
                        if (v > 900719925474098) { moflow = 1; }
                        #stack[int, 32] fd = 1;
                        while (fd == 1) {
                            if (ciPos >= ciSrcLen) { fd = 0; }
                            if (fd == 1) {
                                #stack[int, 64] d2 = cssc::peek8(ciSrc + ciPos);
                                #stack[int, 32] isd = 0;
                                if (d2 >= 48) { if (d2 <= 57) { isd = 1; } }
                                if (isd == 1) {
                                    if (mant > 900719925474098) { moflow = 1; }
                                    if (moflow == 0) { mant = mant * 10 + (d2 - 48); fdc = fdc + 1; }
                                    ciPos = ciPos + 1;
                                }
                                if (isd == 0) { fd = 0; }
                                #delete[isd];
                                #delete[d2];
                            }
                        }
                        #delete[fd];
                        if (fdc > 15) { moflow = 1; }
                        if (moflow == 0) {
                            #stack[int, 64] p10 = 1;
                            #stack[int, 64] pi = 0;
                            while (pi < fdc) { p10 = p10 * 10; pi = pi + 1; }
                            #delete[pi];
                            cssc::fDiv(cssc::iToF(mant), cssc::iToF(p10)) fv2;
                            ciTokNum = fv2;
                            #delete[fv2];
                            #delete[p10];
                        }
                        if (moflow == 1) {
                            cssc::strToF(ciSrc + numStart, ciPos - numStart) fb;
                            ciTokNum = fb;
                            #delete[fb];
                        }
                        ciTokFloat = 1;
                        #delete[mant];
                        #delete[fdc];
                        #delete[moflow];
                    }
                    if (isFloat == 0) { ciTokNum = v; }
                    ciCur = 1;
                    done = 1;
                    #delete[isFloat];
                    #delete[numStart];
                    #delete[v];
                }
                #delete[ishex];
            }
        }
        if (done == 0) {
            #stack[int, 32] isletter = 0;
            if (c >= 65) { if (c <= 90) { isletter = 1; } }
            if (c >= 97) { if (c <= 122) { isletter = 1; } }
            if (c == 95) { isletter = 1; }
            if (isletter == 1) {
                #stack[int, 64] start = ciPos;
                #stack[int, 32] rd = 1;
                while (rd == 1) {
                    if (ciPos >= ciSrcLen) { rd = 0; }
                    if (rd == 1) {
                        #stack[int, 64] d = cssc::peek8(ciSrc + ciPos);
                        #stack[int, 32] idc = 0;
                        if (d >= 65) { if (d <= 90) { idc = 1; } }
                        if (d >= 97) { if (d <= 122) { idc = 1; } }
                        if (d >= 48) { if (d <= 57) { idc = 1; } }
                        if (d == 95) { idc = 1; }
                        // ':' folds into the identifier ONLY as a double '::'
                        // (namespace path: cssc::outln, Sector::member). A
                        // single ':' ends the ident and lexes as token 31,
                        // so labels like `public:` / `private:` work (L3).
                        if (d == 58) {
                            if (ciPos + 1 < ciSrcLen) {
                                #stack[int, 64] d2 = cssc::peek8(ciSrc + ciPos + 1);
                                if (d2 == 58) { idc = 2; }
                                #delete[d2];
                            }
                        }
                        if (idc == 1) { ciPos = ciPos + 1; }
                        if (idc == 2) { ciPos = ciPos + 2; }
                        if (idc == 0) { rd = 0; }
                        #delete[idc];
                        #delete[d];
                    }
                }
                #delete[rd];
                ciTokOff = start;
                ciTokLen = ciPos - start;
                ciCur = 2;
                done = 1;
                #delete[start];
            }
            #delete[isletter];
        }
        if (done == 0) {
            if (c == 34) {
                ciPos = ciPos + 1;
                #stack[int, 64] start = ciPos;
                #stack[int, 32] rd = 1;
                while (rd == 1) {
                    if (ciPos >= ciSrcLen) { rd = 0; }
                    if (rd == 1) {
                        #stack[int, 64] d = cssc::peek8(ciSrc + ciPos);
                        if (d == 34) { rd = 0; }
                        if (d != 34) { ciPos = ciPos + 1; }
                        #delete[d];
                    }
                }
                #delete[rd];
                ciTokOff = start;
                ciTokLen = ciPos - start;
                if (ciPos < ciSrcLen) { ciPos = ciPos + 1; }
                ciCur = 3;
                done = 1;
                #delete[start];
            }
        }
        if (done == 0) {
            if (c == 39) {
                // single-quote literal. The reference treats single quotes as
                // STRINGS (like "); CCOS additionally keeps the char-literal 'x'->
                // ASCII-number form (used by the `char` type). Disambiguate by
                // scanning to the closing quote and counting LOGICAL chars: exactly
                // one -> NUMBER (char literal); two or more (or zero) -> STRING
                // (raw span between the quotes, escapes stored verbatim like ").
                #stack[int, 64] qstart = ciPos + 1;   // first content byte
                #stack[int, 64] sp = ciPos + 1;
                #stack[int, 64] nch = 0;
                #stack[int, 64] first = 0;
                #stack[int, 32] qs = 1;
                while (qs == 1) {
                    if (sp >= ciSrcLen) { qs = 0; }
                    if (qs == 1) {
                        #stack[int, 64] d = cssc::peek8(ciSrc + sp);
                        if (d == 39) { qs = 0; }
                        if (d != 39) {
                            if (d == 92) {
                                #stack[int, 64] e = 0;
                                if (sp + 1 < ciSrcLen) { e = cssc::peek8(ciSrc + sp + 1); }
                                #stack[int, 64] ev = e;
                                if (e == 110) { ev = 10; }
                                if (e == 116) { ev = 9; }
                                if (e == 114) { ev = 13; }
                                if (e == 48) { ev = 0; }
                                if (e == 92) { ev = 92; }
                                if (e == 39) { ev = 39; }
                                if (e == 34) { ev = 34; }
                                if (nch == 0) { first = ev; }
                                sp = sp + 2;
                                nch = nch + 1;
                                #delete[ev];
                                #delete[e];
                            }
                            if (d != 92) {
                                if (nch == 0) { first = d; }
                                sp = sp + 1;
                                nch = nch + 1;
                            }
                        }
                        #delete[d];
                    }
                }
                #delete[qs];
                // FX-SQUOTE: single-quote is ALWAYS a string (match reference);
                // the char-literal 'x'->ASCII-number form is dropped.
                ciTokOff = qstart;
                ciTokLen = sp - qstart;
                ciCur = 3;
                ciPos = sp;
                if (ciPos < ciSrcLen) { if (cssc::peek8(ciSrc + ciPos) == 39) { ciPos = ciPos + 1; } }
                done = 1;
                #delete[first];
                #delete[nch];
                #delete[sp];
                #delete[qstart];
            }
        }
        if (done == 0) {
            if (c == 61) {
                #stack[int, 64] c2 = 0;
                if (ciPos + 1 < ciSrcLen) { c2 = cssc::peek8(ciSrc + ciPos + 1); }
                if (c2 == 61) { ciCur = 15; ciPos = ciPos + 2; }
                if (c2 != 61) { ciCur = 14; ciPos = ciPos + 1; }
                done = 1;
                #delete[c2];
            }
        }
        if (done == 0) {
            if (c == 33) {
                // '!' : '!=' comparison (16), or logical-not (27)
                #stack[int, 64] c2 = 0;
                if (ciPos + 1 < ciSrcLen) { c2 = cssc::peek8(ciSrc + ciPos + 1); }
                if (c2 == 61) { ciCur = 16; ciPos = ciPos + 2; }
                if (c2 != 61) { ciCur = 27; ciPos = ciPos + 1; }
                done = 1;
                #delete[c2];
            }
        }
        if (done == 0) {
            if (c == 60) {
                #stack[int, 64] c2 = 0;
                if (ciPos + 1 < ciSrcLen) { c2 = cssc::peek8(ciSrc + ciPos + 1); }
                if (c2 == 61) { ciCur = 19; ciPos = ciPos + 2; }
                if (c2 != 61) { ciCur = 17; ciPos = ciPos + 1; }
                done = 1;
                #delete[c2];
            }
        }
        if (done == 0) {
            if (c == 62) {
                #stack[int, 64] c2 = 0;
                if (ciPos + 1 < ciSrcLen) { c2 = cssc::peek8(ciSrc + ciPos + 1); }
                if (c2 == 61) { ciCur = 20; ciPos = ciPos + 2; }
                if (c2 != 61) { ciCur = 18; ciPos = ciPos + 1; }
                done = 1;
                #delete[c2];
            }
        }
        if (done == 0) {
            if (c == 38) {
                // '&' : '&&' logical-and (25), or single '&' copy prefix (30)
                #stack[int, 64] c2 = 0;
                if (ciPos + 1 < ciSrcLen) { c2 = cssc::peek8(ciSrc + ciPos + 1); }
                if (c2 == 38) { ciCur = 25; ciPos = ciPos + 2; }
                if (c2 != 38) { ciCur = 30; ciPos = ciPos + 1; }
                done = 1;
                #delete[c2];
            }
        }
        if (done == 0) {
            if (c == 124) {
                // '|' : '||' logical-or (26); single '|' is unsupported (99)
                #stack[int, 64] c2 = 0;
                if (ciPos + 1 < ciSrcLen) { c2 = cssc::peek8(ciSrc + ciPos + 1); }
                if (c2 == 124) { ciCur = 26; ciPos = ciPos + 2; }
                if (c2 != 124) { ciCur = 99; ciPos = ciPos + 1; }
                done = 1;
                #delete[c2];
            }
        }
        if (done == 0) {
            if (c == 45) {
                // '-' : '->' arrow member access (34, L4 objects), else minus (5)
                #stack[int, 64] c2 = 0;
                if (ciPos + 1 < ciSrcLen) { c2 = cssc::peek8(ciSrc + ciPos + 1); }
                if (c2 == 62) { ciCur = 34; ciPos = ciPos + 2; }
                if (c2 != 62) { ciCur = 5; ciPos = ciPos + 1; }
                done = 1;
                #delete[c2];
            }
        }
        if (done == 0) {
            #stack[int, 64] t = 99;
            if (c == 43) { t = 4; }
            if (c == 42) { t = 6; }
            if (c == 47) { t = 7; }
            if (c == 37) { t = 8; }
            if (c == 40) { t = 9; }
            if (c == 41) { t = 10; }
            if (c == 123) { t = 11; }
            if (c == 125) { t = 12; }
            if (c == 59) { t = 13; }
            if (c == 44) { t = 21; }
            if (c == 35) { t = 22; }
            if (c == 91) { t = 23; }
            if (c == 93) { t = 24; }
            // L3 tokens: single ':' = 31 (labels public:/private:),
            // '?' = 32 (deferred sector marker `sector Name ?label {..}`)
            if (c == 58) { t = 31; }
            if (c == 63) { t = 32; }
            // L4 token: '.' = 33 (instance access `inst.label(args)` /
            // `inst.member`); '-'/'->' are handled in their own case above
            if (c == 46) { t = 33; }
            ciCur = t;
            ciPos = ciPos + 1;
            done = 1;
            #delete[t];
        }
        #delete[done];
        #delete[c];
    }
}

// ciTokenize -- APPEND tokens for the byte range [ciPos, ciSrcLen) onto the stream
// at ciTokCount. The caller sets ciPos (BYTE start) + ciSrcLen (BYTE end) and, for a
// fresh program, resets ciTokCount to 0 first. Runs ciLexRaw in a loop; stops at EOF
// (ciCur==0) or when the byte cursor reaches ciSrcLen. This is the whole point of the
// rewrite: it happens ONCE per source region, not per loop iteration.
#define(ciTokenize) {
    #req[ciLexRaw] ciLexRaw;
    #req[ciPos] ciPos;
    #req[ciSrcLen] ciSrcLen;
    #req[ciTokCount] ciTokCount;
    #req[ciTokCap] ciTokCap;
    #req[ciTokCode] ciTokCode;
    #req[ciTokNumA] ciTokNumA;
    #req[ciTokFlag] ciTokFlag;
    #req[ciTokOffA] ciTokOffA;
    #req[ciTokLenA] ciTokLenA;
    #req[ciCur] ciCur;
    #req[ciTokNum] ciTokNum;
    #req[ciTokFloat] ciTokFloat;
    #req[ciTokOff] ciTokOff;
    #req[ciTokLen] ciTokLen;
    #stack[int, 32] go = 1;
    while (go == 1) {
        if (ciPos >= ciSrcLen) { go = 0; }
        if (go == 1) {
            ciLexRaw();
            if (ciCur == 0) { go = 0; }
            if (go == 1) {
                if (ciTokCount < ciTokCap) {
                    cssc::poke8(ciTokCode + ciTokCount, ciCur);
                    cssc::poke64(ciTokNumA + ciTokCount * 8, ciTokNum);
                    cssc::poke8(ciTokFlag + ciTokCount, ciTokFloat);
                    cssc::poke32(ciTokOffA + ciTokCount * 4, ciTokOff);
                    cssc::poke32(ciTokLenA + ciTokCount * 4, ciTokLen);
                    ciTokCount = ciTokCount + 1;
                }
            }
        }
    }
    #delete[go];
}

// ciAdvance -- the hot-path token reader. ciPos is a TOKEN INDEX: load the current
// token's columns into the ciCur/ciTokNum/ciTokFloat/ciTokOff/ciTokLen registers and
// step ciPos forward. Past the end -> ciCur=0 (EOF), ciPos parked (repeat calls inert).
// This replaces the per-call character scan; span-replay is now a pointer reset.
#define(ciAdvance) {
    #req[ciPos] ciPos;
    #req[ciTokCount] ciTokCount;
    #req[ciTokCode] ciTokCode;
    #req[ciTokNumA] ciTokNumA;
    #req[ciTokFlag] ciTokFlag;
    #req[ciTokOffA] ciTokOffA;
    #req[ciTokLenA] ciTokLenA;
    #req[ciCur] ciCur;
    #req[ciTokNum] ciTokNum;
    #req[ciTokFloat] ciTokFloat;
    #req[ciTokOff] ciTokOff;
    #req[ciTokLen] ciTokLen;
    if (ciPos >= ciTokCount) {
        ciCur = 0;
    }
    if (ciPos < ciTokCount) {
        ciCur = cssc::peek8(ciTokCode + ciPos);
        ciTokNum = cssc::peek64(ciTokNumA + ciPos * 8);
        ciTokFloat = cssc::peek8(ciTokFlag + ciPos);
        ciTokOff = cssc::peek32(ciTokOffA + ciPos * 4);
        ciTokLen = cssc::peek32(ciTokLenA + ciPos * 4);
        ciPos = ciPos + 1;
    }
}

#define(ciIdentIs) {
    #scanp(ciIdentIs, int, 0) off;
    #scanp(ciIdentIs, int, 1) len;
    #scanp(ciIdentIs, string, 2) lit;
    #req[ciSrc] ciSrc;
    #stack[int, 64] sa = 0;
    #adress[lit] sa;
    #stack[int, 64] hdr = cssc::peek64(sa);
    #stack[int, 64] llen = cssc::peek32(hdr + 4);
    #stack[int, 64] ldata = hdr + 8;
    #stack[int, 32] ok = 1;
    if (llen != len) { ok = 0; }
    if (ok == 1) {
        #stack[int, 32] j = 0;
        while (j < len) {
            #stack[int, 64] a = cssc::peek8(ciSrc + off + j);
            #stack[int, 64] b = cssc::peek8(ldata + j);
            if (a != b) { ok = 0; }
            #delete[a];
            #delete[b];
            j = j + 1;
        }
        #delete[j];
    }
    #delete[ldata];
    #delete[llen];
    #delete[hdr];
    #delete[sa];
    return ok;
}

// build "Sector::name" into the scratch buffer, return the qualified length
// (truncated at 32 = the name-column width). Callers address the scratch via
// offset (ciQualBuf - ciSrc) so every name helper -- which reads bytes at
// ciSrc + off -- works unchanged. INVARIANT: the scratch never survives a
// call into ciExpr/ciStmt; qualify at the last instant before the table scan.
#define(ciQualify) {
    #scanp(ciQualify, int, 0) so;
    #scanp(ciQualify, int, 1) sl;
    #scanp(ciQualify, int, 2) no;
    #scanp(ciQualify, int, 3) nl;
    #req[ciSrc] ciSrc;
    #req[ciQualBuf] ciQualBuf;
    #stack[int, 64] q = 0;
    #stack[int, 32] i = 0;
    while (i < sl) {
        if (q < 32) {
            cssc::poke8(ciQualBuf + q, cssc::peek8(ciSrc + so + i));
            q = q + 1;
        }
        i = i + 1;
    }
    #delete[i];
    if (q < 32) { cssc::poke8(ciQualBuf + q, 58); q = q + 1; }
    if (q < 32) { cssc::poke8(ciQualBuf + q, 58); q = q + 1; }
    #stack[int, 32] j = 0;
    while (j < nl) {
        if (q < 32) {
            cssc::poke8(ciQualBuf + q, cssc::peek8(ciSrc + no + j));
            q = q + 1;
        }
        j = j + 1;
    }
    #delete[j];
    return q;
}

// index of the first "::" inside a token, or -1 for a bare name
#define(ciTokHasCC) {
    #scanp(ciTokHasCC, int, 0) off;
    #scanp(ciTokHasCC, int, 1) len;
    #req[ciSrc] ciSrc;
    #stack[int, 64] found = 0 - 1;
    #stack[int, 32] i = 0;
    while (i + 1 < len) {
        if (found < 0) {
            #stack[int, 64] a = cssc::peek8(ciSrc + off + i);
            if (a == 58) {
                #stack[int, 64] b = cssc::peek8(ciSrc + off + i + 1);
                if (b == 58) { found = i; }
                #delete[b];
            }
            #delete[a];
        }
        i = i + 1;
    }
    #delete[i];
    return found;
}

// 1 when the token's "Sector" prefix (bytes before the ccp'th char) equals
// the CURRENT sector context -- used for the private-access exemption
#define(ciSecPrefixIs) {
    #scanp(ciSecPrefixIs, int, 0) off;
    #scanp(ciSecPrefixIs, int, 1) ccp;
    #req[ciSrc] ciSrc;
    #req[ciCurSecOff] ciCurSecOff;
    #req[ciCurSecLen] ciCurSecLen;
    #stack[int, 32] same = 0;
    if (ciCurSecLen > 0) {
        if (ccp == ciCurSecLen) {
            same = 1;
            #stack[int, 32] i = 0;
            while (i < ccp) {
                #stack[int, 64] a = cssc::peek8(ciSrc + off + i);
                #stack[int, 64] b = cssc::peek8(ciSrc + ciCurSecOff + i);
                if (a != b) { same = 0; }
                #delete[a];
                #delete[b];
                i = i + 1;
            }
            #delete[i];
        }
    }
    return same;
}

// sector-table lookup by NAME (source-span compare) -> row index or -1
#define(ciSecFind) {
    #scanp(ciSecFind, int, 0) off;
    #scanp(ciSecFind, int, 1) len;
    #req[ciSrc] ciSrc;
    #req[ciSecNameOff] ciSecNameOff;
    #req[ciSecNameLen] ciSecNameLen;
    #req[ciSecCount] ciSecCount;
    #stack[int, 64] found = 0 - 1;
    #stack[int, 32] i = 0;
    while (i < ciSecCount) {
        #stack[int, 64] nl = cssc::peek64(ciSecNameLen + i * 8);
        if (nl == len) {
            #stack[int, 64] noff = cssc::peek64(ciSecNameOff + i * 8);
            #stack[int, 32] m = 1;
            #stack[int, 32] j = 0;
            while (j < len) {
                #stack[int, 64] a = cssc::peek8(ciSrc + off + j);
                #stack[int, 64] b = cssc::peek8(ciSrc + noff + j);
                if (a != b) { m = 0; }
                #delete[a];
                #delete[b];
                j = j + 1;
            }
            #delete[j];
            if (m == 1) { found = i; }
            #delete[m];
            #delete[noff];
        }
        #delete[nl];
        i = i + 1;
    }
    #delete[i];
    return found;
}

// sector-table lookup by DEFERRED LABEL -> row index or -1 (#reserve target)
#define(ciSecFindLab) {
    #scanp(ciSecFindLab, int, 0) off;
    #scanp(ciSecFindLab, int, 1) len;
    #req[ciSrc] ciSrc;
    #req[ciSecLabOff] ciSecLabOff;
    #req[ciSecLabLen] ciSecLabLen;
    #req[ciSecDefer] ciSecDefer;
    #req[ciSecCount] ciSecCount;
    #stack[int, 64] found = 0 - 1;
    #stack[int, 32] i = 0;
    while (i < ciSecCount) {
        #stack[int, 64] dfl = cssc::peek64(ciSecDefer + i * 8);
        if (dfl == 1) {
            #stack[int, 64] nl = cssc::peek64(ciSecLabLen + i * 8);
            if (nl == len) {
                #stack[int, 64] noff = cssc::peek64(ciSecLabOff + i * 8);
                #stack[int, 32] m = 1;
                #stack[int, 32] j = 0;
                while (j < len) {
                    #stack[int, 64] a = cssc::peek8(ciSrc + off + j);
                    #stack[int, 64] b = cssc::peek8(ciSrc + noff + j);
                    if (a != b) { m = 0; }
                    #delete[a];
                    #delete[b];
                    j = j + 1;
                }
                #delete[j];
                if (m == 1) { found = i; }
                #delete[m];
                #delete[noff];
            }
            #delete[nl];
        }
        #delete[dfl];
        i = i + 1;
    }
    #delete[i];
    return found;
}

// object-def lookup by name (source-span compare) -> def index or -1
#define(ciObjFind) {
    #scanp(ciObjFind, int, 0) off;
    #scanp(ciObjFind, int, 1) len;
    #req[ciSrc] ciSrc;
    #req[ciObjNameOff] ciObjNameOff;
    #req[ciObjNameLen] ciObjNameLen;
    #req[ciObjCount] ciObjCount;
    #stack[int, 64] found = 0 - 1;
    #stack[int, 32] i = 0;
    while (i < ciObjCount) {
        #stack[int, 64] nl = cssc::peek64(ciObjNameLen + i * 8);
        if (nl == len) {
            #stack[int, 64] noff = cssc::peek64(ciObjNameOff + i * 8);
            #stack[int, 32] m = 1;
            #stack[int, 32] j = 0;
            while (j < len) {
                #stack[int, 64] a = cssc::peek8(ciSrc + off + j);
                #stack[int, 64] b = cssc::peek8(ciSrc + noff + j);
                if (a != b) { m = 0; }
                #delete[a];
                #delete[b];
                j = j + 1;
            }
            #delete[j];
            if (m == 1) { found = i; }
            #delete[m];
            #delete[noff];
        }
        #delete[nl];
        i = i + 1;
    }
    #delete[i];
    return found;
}

// 1 when the token equals the given object def's name (arrow resolution:
// `Box->val` inside a Box label targets the CURRENT instance; any other
// ident before `->` is a variable holding an instance)
#define(ciObjNameIs) {
    #scanp(ciObjNameIs, int, 0) objIdx;
    #scanp(ciObjNameIs, int, 1) off;
    #scanp(ciObjNameIs, int, 2) len;
    #req[ciSrc] ciSrc;
    #req[ciObjNameOff] ciObjNameOff;
    #req[ciObjNameLen] ciObjNameLen;
    #stack[int, 32] same = 0;
    if (objIdx >= 0) {
        #stack[int, 64] nl = cssc::peek64(ciObjNameLen + objIdx * 8);
        if (nl == len) {
            same = 1;
            #stack[int, 64] noff = cssc::peek64(ciObjNameOff + objIdx * 8);
            #stack[int, 32] j = 0;
            while (j < len) {
                #stack[int, 64] a = cssc::peek8(ciSrc + off + j);
                #stack[int, 64] b = cssc::peek8(ciSrc + noff + j);
                if (a != b) { same = 0; }
                #delete[a];
                #delete[b];
                j = j + 1;
            }
            #delete[j];
            #delete[noff];
        }
        #delete[nl];
    }
    return same;
}

// 1 when two ciSrc-relative token spans are byte-equal (for select label.pos()
// span-matching: does the receiver ident equal the active select label?).
#define(ciSpanEq) {
    #scanp(ciSpanEq, int, 0) aoff;
    #scanp(ciSpanEq, int, 1) alen;
    #scanp(ciSpanEq, int, 2) boff;
    #scanp(ciSpanEq, int, 3) blen;
    #req[ciSrc] ciSrc;
    #stack[int, 32] same = 0;
    if (alen == blen) {
        same = 1;
        #stack[int, 32] j = 0;
        while (j < alen) {
            #stack[int, 64] a = cssc::peek8(ciSrc + aoff + j);
            #stack[int, 64] b = cssc::peek8(ciSrc + boff + j);
            if (a != b) { same = 0; }
            #delete[a];
            #delete[b];
            j = j + 1;
        }
        #delete[j];
    }
    return same;
}

// null out every var-table BORROW (owns=0) of a freed value so no alias
// dangles into freed heap -- the single use-after-free guard, called from
// every path that actually frees an owned string (tag 1) or instance (tag 3)
#define(ciNullBorrows) {
    #scanp(ciNullBorrows, int, 0) ptr;
    #scanp(ciNullBorrows, int, 1) vtype;
    #req[ciVVals] ciVVals;
    #req[ciVTypes] ciVTypes;
    #req[ciVOwns] ciVOwns;
    #req[ciVCount] ciVCount;
    #stack[int, 32] k = 0;
    while (k < ciVCount) {
        #stack[int, 64] bt = cssc::peek64(ciVTypes + k * 8);
        #stack[int, 64] bo = cssc::peek64(ciVOwns + k * 8);
        #stack[int, 64] bv = cssc::peek64(ciVVals + k * 8);
        if (bt == vtype) {
            if (bo == 0) {
                if (bv == ptr) {
                    cssc::poke64(ciVVals + k * 8, 0);
                    cssc::poke64(ciVTypes + k * 8, 0);
                }
            }
        }
        #delete[bt];
        #delete[bo];
        #delete[bv];
        k = k + 1;
    }
    #delete[k];
}
// ---- instance record (heap block, value tag 3) ----
//   +0  i32 refcount        +4  i32 freed-flag (free{} run-once)
//   +8  i64 objDefIdx       +16 i64 memberCount
//   +24 8 member rows, stride 64: name[32] | len | val | type | owns
// member row lookup by name -> row index or -1 (name bytes read at addr,
// which may be ciSrc + off OR the qualification scratch)
#define(ciInstMemFind) {
    #scanp(ciInstMemFind, int, 0) inst;
    #scanp(ciInstMemFind, int, 1) off;
    #scanp(ciInstMemFind, int, 2) len;
    #req[ciSrc] ciSrc;
    if (len > 32) { len = 32; }
    #stack[int, 64] found = 0 - 1;
    #stack[int, 64] n = cssc::peek64(inst + 16);
    #stack[int, 32] i = 0;
    while (i < n) {
        #stack[int, 64] row = inst + 24 + i * 64;
        #stack[int, 64] nl = cssc::peek64(row + 32);
        if (nl == len) {
            #stack[int, 32] m = 1;
            #stack[int, 32] j = 0;
            while (j < len) {
                #stack[int, 64] a = cssc::peek8(ciSrc + off + j);
                #stack[int, 64] b = cssc::peek8(row + j);
                if (a != b) { m = 0; }
                #delete[a];
                #delete[b];
                j = j + 1;
            }
            #delete[j];
            if (m == 1) { found = i; }
            #delete[m];
        }
        #delete[nl];
        #delete[row];
        i = i + 1;
    }
    #delete[i];
    #delete[n];
    return found;
}

// release an instance: null var-table borrows of every freed value, free
// owned member strings, recurse into owned nested instances (self-recursion
// is backend-legal), null borrows of the block pointer, free the block.
// Does NOT run the guest free{} block (that replay needs ciStmt and happens
// at the explicit #free site); cascade/REPL teardown uses this raw release.
#define(ciInstFree) {
    #scanp(ciInstFree, int, 0) inst;
    #req[ciInstFree] ciInstFree;
    #req[ciNullBorrows] ciNullBorrows;
    #stack[int, 64] n = cssc::peek64(inst + 16);
    #stack[int, 32] i = 0;
    while (i < n) {
        #stack[int, 64] row = inst + 24 + i * 64;
        #stack[int, 64] mo = cssc::peek64(row + 56);
        #stack[int, 64] mt = cssc::peek64(row + 48);
        #stack[int, 64] mv = cssc::peek64(row + 40);
        if (mo == 1) {
            if (mt == 1) {
                ciNullBorrows(mv, 1);
                cssc::free(mv);
            }
            if (mt == 3) { if (mv != 0) { ciInstFree(mv); } }
        }
        #delete[mo];
        #delete[mt];
        #delete[mv];
        #delete[row];
        i = i + 1;
    }
    #delete[i];
    #delete[n];
    ciNullBorrows(inst, 3);
    cssc::free(inst);
}

// deep-copy a value into a fresh OWNED allocation (value semantics for `&`).
// Self-contained + self-recursive (must sit before ciExpr, so it inlines the
// string/vector/map/bind construction rather than calling ciStrClone/ciVecNew).
// Clones owned string sub-elements + the top-level structure; nested container/
// object sub-elements are copied by pointer (BORROW) to stay symmetric with the
// borrow-respecting ciValFree (which never frees them). int(0)/float(2) copy raw.
#define(ciValClone) {
    #scanp(ciValClone, int, 0) ty;
    #scanp(ciValClone, int, 1) vv;
    #stack[int, 64] r = vv;
    if (vv != 0) {
        if (ty == 1) {
            // string {rc@0,size@4,bytes@8}
            #stack[int, 64] sl = cssc::peek32(vv + 4);
            #stack[int, 64] nb = cssc::alloc(sl + 8);
            cssc::poke32(nb, 1);
            cssc::poke32(nb + 4, sl);
            #stack[int, 64] i = 0;
            while (i < sl) {
                cssc::poke8(nb + 8 + i, cssc::peek8(vv + 8 + i));
                i = i + 1;
            }
            #delete[i];
            r = nb;
            #delete[nb];
            #delete[sl];
        }
        if (ty == 4) {
            // vector/array {rc,size@4,cap@8,elemType@12,data@16,(auto)types@24}.
            // The header is 32 B (types@24 must exist for et==8 auto arrays, else
            // ciContFmt reads a wild pointer). Elements clone by their REAL type:
            // homogeneous vectors use elemType; auto arrays use the per-element
            // types[] array (which is itself cloned).
            #stack[int, 64] sz = cssc::peek32(vv + 4);
            #stack[int, 64] et = cssc::peek32(vv + 12);
            #stack[int, 64] cap = sz;
            if (cap < 8) { cap = 8; }
            #stack[int, 64] nh = cssc::alloc(32);
            #stack[int, 64] nd = cssc::alloc(cap * 8);
            cssc::memfill32(nd, 0, cap * 2);
            cssc::poke32(nh, 1);
            cssc::poke32(nh + 4, sz);
            cssc::poke32(nh + 8, cap);
            cssc::poke32(nh + 12, et);
            cssc::poke64(nh + 16, nd);
            #stack[int, 64] otp = 0;
            #stack[int, 64] ntp = 0;
            if (et == 8) {
                otp = cssc::peek64(vv + 24);
                ntp = cssc::alloc(cap * 8);
                cssc::memfill32(ntp, 0, cap * 2);
            }
            cssc::poke64(nh + 24, ntp);
            #stack[int, 64] od = cssc::peek64(vv + 16);
            #stack[int, 64] i = 0;
            while (i < sz) {
                #stack[int, 64] ev = cssc::peek64(od + i * 8);
                #stack[int, 64] pet = et;
                if (et == 8) {
                    pet = cssc::peek64(otp + i * 8);
                    cssc::poke64(ntp + i * 8, pet);
                }
                #stack[int, 64] cev = ev;
                if (pet == 1) { ciValClone(1, ev) c; cev = c; #delete[c]; }
                if (pet == 4) { ciValClone(4, ev) c; cev = c; #delete[c]; }
                if (pet == 5) { ciValClone(5, ev) c; cev = c; #delete[c]; }
                cssc::poke64(nd + i * 8, cev);
                #delete[cev];
                #delete[pet];
                #delete[ev];
                i = i + 1;
            }
            #delete[i];
            #delete[od];
            #delete[otp];
            #delete[ntp];
            r = nh;
            #delete[nh];
            #delete[nd];
            #delete[cap];
            #delete[et];
            #delete[sz];
        }
        if (ty == 5) {
            // map {rc,size@4,cap@8,data@16}; entry 32B kt@0,kv@8,vt@16,vv@24
            #stack[int, 64] sz = cssc::peek32(vv + 4);
            #stack[int, 64] cap = sz;
            if (cap < 8) { cap = 8; }
            #stack[int, 64] nh = cssc::alloc(24);
            #stack[int, 64] nd = cssc::alloc(cap * 32);
            cssc::poke32(nh, 1);
            cssc::poke32(nh + 4, sz);
            cssc::poke32(nh + 8, cap);
            cssc::poke64(nh + 16, nd);
            #stack[int, 64] od = cssc::peek64(vv + 16);
            #stack[int, 64] i = 0;
            while (i < sz) {
                #stack[int, 64] kt = cssc::peek64(od + i * 32);
                #stack[int, 64] kv = cssc::peek64(od + i * 32 + 8);
                #stack[int, 64] vt = cssc::peek64(od + i * 32 + 16);
                #stack[int, 64] vl = cssc::peek64(od + i * 32 + 24);
                #stack[int, 64] nkv = kv;
                #stack[int, 64] nvl = vl;
                if (kt == 1) { ciValClone(1, kv) c; nkv = c; #delete[c]; }
                if (vt == 1) { ciValClone(1, vl) c; nvl = c; #delete[c]; }
                cssc::poke64(nd + i * 32, kt);
                cssc::poke64(nd + i * 32 + 8, nkv);
                cssc::poke64(nd + i * 32 + 16, vt);
                cssc::poke64(nd + i * 32 + 24, nvl);
                #delete[nkv];
                #delete[nvl];
                #delete[kt];
                #delete[kv];
                #delete[vt];
                #delete[vl];
                i = i + 1;
            }
            #delete[i];
            #delete[od];
            r = nh;
            #delete[nh];
            #delete[nd];
            #delete[cap];
            #delete[sz];
        }
        if (ty == 7) {
            // bind {rc,size@4=pairs,cap@8,pairWidth@12,data@16}; cell 16B type@0,val@8
            #stack[int, 64] sz = cssc::peek32(vv + 4);
            #stack[int, 64] pw = cssc::peek32(vv + 12);
            #stack[int, 64] cap = cssc::peek32(vv + 8);
            #stack[int, 64] used = sz * pw;
            #stack[int, 64] acells = cap * pw;
            if (acells < 1) { acells = 1; }
            #stack[int, 64] nh = cssc::alloc(24);
            #stack[int, 64] nd = cssc::alloc(acells * 16);
            cssc::poke32(nh, 1);
            cssc::poke32(nh + 4, sz);
            cssc::poke32(nh + 8, cap);
            cssc::poke32(nh + 12, pw);
            cssc::poke64(nh + 16, nd);
            #stack[int, 64] od = cssc::peek64(vv + 16);
            #stack[int, 64] i = 0;
            while (i < used) {
                #stack[int, 64] ct = cssc::peek64(od + i * 16);
                #stack[int, 64] cvl = cssc::peek64(od + i * 16 + 8);
                #stack[int, 64] ncvl = cvl;
                if (ct == 1) { ciValClone(1, cvl) c; ncvl = c; #delete[c]; }
                cssc::poke64(nd + i * 16, ct);
                cssc::poke64(nd + i * 16 + 8, ncvl);
                #delete[ncvl];
                #delete[ct];
                #delete[cvl];
                i = i + 1;
            }
            #delete[i];
            #delete[od];
            r = nh;
            #delete[nh];
            #delete[nd];
            #delete[used];
            #delete[acells];
            #delete[cap];
            #delete[pw];
            #delete[sz];
        }
    }
    return r;
}

// unified value destructor: frees whatever heap a value tag OWNS -- string(1),
// object instance(3), and the top-level structure of vector/array(4), map(5),
// bind(7). BORROW-RESPECTING: containers store nested container/object cells as
// raw borrows (only strings are cloned on insert), so it frees owned string
// sub-elements + the handle/data but NEVER a nested container -> no double-free.
// Placed right after ciInstFree (its only callee) so EVERY release site (ciVarSet
// overwrite, ciVarDrop, frame/arg teardown, the run reset) can call it backward.
#define(ciValFree) {
    #scanp(ciValFree, int, 0) ty;
    #scanp(ciValFree, int, 1) vv;
    #req[ciInstFree] ciInstFree;
    if (vv != 0) {
        if (ty == 1) { cssc::free(vv); }
        if (ty == 3) { ciInstFree(vv); }
        if (ty == 4) {
            // vector/array {rc,size@4,cap@8,elemType@12,data@16}. Only STRING
            // elements are cloned+owned (ciVecPush); container/object elements
            // are BORROWS stored raw -- recursing would double-free. So release
            // just the owned string elements + the handle+data (borrow-respecting).
            #stack[int, 64] et = cssc::peek32(vv + 12);
            #stack[int, 64] vd = cssc::peek64(vv + 16);
            if (et == 1) {
                #stack[int, 64] vsz = cssc::peek32(vv + 4);
                #stack[int, 64] vi = 0;
                while (vi < vsz) {
                    #stack[int, 64] ev = cssc::peek64(vd + vi * 8);
                    if (ev != 0) { cssc::free(ev); }
                    #delete[ev];
                    vi = vi + 1;
                }
                #delete[vi];
                #delete[vsz];
            }
            cssc::free(vd);
            cssc::free(vv);
            #delete[vd];
            #delete[et];
        }
        if (ty == 5) {
            // map {rc,size@4,cap@8,data@16}; entry 32B keyType@0,keyVal@8,
            // valType@16,valVal@24. Only string keys/values are cloned+owned;
            // container values are borrows -> free the owned strings + handle+data.
            #stack[int, 64] msz = cssc::peek32(vv + 4);
            #stack[int, 64] md = cssc::peek64(vv + 16);
            #stack[int, 64] mi = 0;
            while (mi < msz) {
                #stack[int, 64] kt = cssc::peek64(md + mi * 32);
                #stack[int, 64] kv = cssc::peek64(md + mi * 32 + 8);
                #stack[int, 64] mvt = cssc::peek64(md + mi * 32 + 16);
                #stack[int, 64] mvv = cssc::peek64(md + mi * 32 + 24);
                if (kt == 1) { if (kv != 0) { cssc::free(kv); } }
                if (mvt == 1) { if (mvv != 0) { cssc::free(mvv); } }
                #delete[kt];
                #delete[kv];
                #delete[mvt];
                #delete[mvv];
                mi = mi + 1;
            }
            #delete[mi];
            #delete[msz];
            cssc::free(md);
            cssc::free(vv);
            #delete[md];
        }
        if (ty == 7) {
            // bind {rc,size@4=pairs,cap@8,pairWidth@12,data@16}; cell 16B
            // type@0,val@8. Only string cells are cloned+owned (ciBindRawSet);
            // container cells are BORROWS -> free the owned string cells +
            // handle+data (matches ciBindClear; NEVER frees a borrowed container,
            // e.g. a bind literal that captured a live global vector by reference).
            #stack[int, 64] bsz = cssc::peek32(vv + 4);
            #stack[int, 64] bpw = cssc::peek32(vv + 12);
            #stack[int, 64] bused = bsz * bpw;
            #stack[int, 64] bd = cssc::peek64(vv + 16);
            #stack[int, 64] bi = 0;
            while (bi < bused) {
                #stack[int, 64] ct = cssc::peek64(bd + bi * 16);
                #stack[int, 64] cvv = cssc::peek64(bd + bi * 16 + 8);
                if (ct == 1) { if (cvv != 0) { cssc::free(cvv); } }
                #delete[ct];
                #delete[cvv];
                bi = bi + 1;
            }
            #delete[bi];
            #delete[bused];
            #delete[bpw];
            #delete[bsz];
            cssc::free(bd);
            cssc::free(vv);
            #delete[bd];
        }
        if (ty == 6) {
            // console instance {..., cellsPtr@32, syncTagPtr@40, syncListPtr@48,
            // syncLenPtr@56}. Frees the grid + the 3 sync subbuffers + owned sync
            // tag strings (the bound LISTs are borrows -> never freed here) + header.
            #stack[int, 64] cst = cssc::peek64(vv + 40);
            #stack[int, 64] ccount = cssc::peek32(vv + 28);
            #stack[int, 64] ci6 = 0;
            while (ci6 < ccount) {
                #stack[int, 64] ctg = cssc::peek64(cst + ci6 * 8);
                if (ctg != 0) { cssc::free(ctg); }
                #delete[ctg];
                ci6 = ci6 + 1;
            }
            #delete[ci6];
            cssc::free(cssc::peek64(vv + 32));
            cssc::free(cst);
            cssc::free(cssc::peek64(vv + 48));
            cssc::free(cssc::peek64(vv + 56));
            cssc::free(vv);
            #delete[cst];
            #delete[ccount];
        }
    }
}

// bind/overwrite an instance member (find-or-create; owned old values are
// released on overwrite -- single owner, exactly like the var table)
#define(ciInstMemSet) {
    #scanp(ciInstMemSet, int, 0) inst;
    #scanp(ciInstMemSet, int, 1) off;
    #scanp(ciInstMemSet, int, 2) len;
    #scanp(ciInstMemSet, int, 3) val;
    #scanp(ciInstMemSet, int, 4) vtype;
    #scanp(ciInstMemSet, int, 5) owns;
    #req[ciSrc] ciSrc;
    #req[ciInstMemFind] ciInstMemFind;
    #req[ciInstFree] ciInstFree;
    #req[ciNullBorrows] ciNullBorrows;
    if (len > 32) { len = 32; }
    ciInstMemFind(inst, off, len) idx;
    if (idx < 0) {
        #stack[int, 64] n = cssc::peek64(inst + 16);
        if (n < 8) {
            #stack[int, 64] row = inst + 24 + n * 64;
            #stack[int, 32] j = 0;
            while (j < len) {
                cssc::poke8(row + j, cssc::peek8(ciSrc + off + j));
                j = j + 1;
            }
            #delete[j];
            cssc::poke64(row + 32, len);
            cssc::poke64(row + 40, val);
            cssc::poke64(row + 48, vtype);
            cssc::poke64(row + 56, owns);
            cssc::poke64(inst + 16, n + 1);
            idx = n;
            #delete[row];
        }
        if (idx < 0) {
            // instance full (8 members): drop the bind, release an owned temp
            if (owns == 1) {
                if (vtype == 1) { cssc::free(val); }
                if (vtype == 3) { if (val != 0) { ciInstFree(val); } }
            }
        }
        #delete[n];
    }
    if (idx >= 0) {
        #stack[int, 64] row = inst + 24 + idx * 64;
        #stack[int, 64] ov = cssc::peek64(row + 40);
        if (ov != val) {
            #stack[int, 64] oo = cssc::peek64(row + 56);
            #stack[int, 64] ot = cssc::peek64(row + 48);
            if (oo == 1) {
                if (ot == 1) {
                    ciNullBorrows(ov, 1);
                    cssc::free(ov);
                }
                if (ot == 3) { if (ov != 0) { ciInstFree(ov); } }
            }
            cssc::poke64(row + 40, val);
            cssc::poke64(row + 48, vtype);
            cssc::poke64(row + 56, owns);
            #delete[oo];
            #delete[ot];
        }
        #delete[ov];
        #delete[row];
    }
    #delete[idx];
}

// read an instance member; sets ciEvalType; missing member -> 0
#define(ciInstMemGet) {
    #scanp(ciInstMemGet, int, 0) inst;
    #scanp(ciInstMemGet, int, 1) off;
    #scanp(ciInstMemGet, int, 2) len;
    #req[ciEvalType] ciEvalType;
    #req[ciInstMemFind] ciInstMemFind;
    ciInstMemFind(inst, off, len) idx;
    #stack[int, 64] r = 0;
    ciEvalType = 0;
    if (idx >= 0) {
        #stack[int, 64] row = inst + 24 + idx * 64;
        r = cssc::peek64(row + 40);
        ciEvalType = cssc::peek64(row + 48);
        #delete[row];
    }
    #delete[idx];
    return r;
}

#define(ciVarFind) {
    #scanp(ciVarFind, int, 0) off;
    #scanp(ciVarFind, int, 1) len;
    #req[ciSrc] ciSrc;
    #req[ciVNames] ciVNames;
    #req[ciVLens] ciVLens;
    #req[ciVCount] ciVCount;
    #req[ciScopeBase] ciScopeBase;
    // consistent-truncation rule: stores clamp to 32, so must lookups
    if (len > 32) { len = 32; }
    #stack[int, 64] found = 0 - 1;
    // only search rows in the current frame [ciScopeBase, ciVCount) -> isolation
    #stack[int, 32] i = ciScopeBase;
    while (i < ciVCount) {
        #stack[int, 64] nl = cssc::peek64(ciVLens + i * 8);
        if (nl == len) {
            #stack[int, 32] m = 1;
            #stack[int, 32] j = 0;
            while (j < len) {
                #stack[int, 64] a = cssc::peek8(ciSrc + off + j);
                #stack[int, 64] b = cssc::peek8(ciVNames + i * 32 + j);
                if (a != b) { m = 0; }
                #delete[a];
                #delete[b];
                j = j + 1;
            }
            #delete[j];
            if (m == 1) { found = i; }
            #delete[m];
        }
        #delete[nl];
        i = i + 1;
    }
    #delete[i];
    return found;
}

// var lookup with the frame floor dropped to 0 (global-frame resolution)
#define(ciVarFindGlobal) {
    #scanp(ciVarFindGlobal, int, 0) off;
    #scanp(ciVarFindGlobal, int, 1) len;
    #req[ciScopeBase] ciScopeBase;
    #req[ciVarFind] ciVarFind;
    #stack[int, 64] savedBase = ciScopeBase;
    ciScopeBase = 0;
    ciVarFind(off, len) idx;
    ciScopeBase = savedBase;
    #delete[savedBase];
    return idx;
}

// read a variable. Resolution: qualified "Sec::member" tokens resolve in the
// global frame with a visibility check (private -> 0 unless inside that
// sector); bare names resolve in the current frame, then -- inside a sector
// method / free block -- fall back to the qualified member (reference
// semantics: members are visible bare inside their sector, cssl_cssc.py:16060)
#define(ciVarGet) {
    #scanp(ciVarGet, int, 0) off;
    #scanp(ciVarGet, int, 1) len;
    #req[ciSrc] ciSrc;
    #req[ciVVals] ciVVals;
    #req[ciVTypes] ciVTypes;
    #req[ciVVis] ciVVis;
    #req[ciEvalType] ciEvalType;
    #req[ciCurSecOff] ciCurSecOff;
    #req[ciCurSecLen] ciCurSecLen;
    #req[ciQualBuf] ciQualBuf;
    #req[ciQualify] ciQualify;
    #req[ciTokHasCC] ciTokHasCC;
    #req[ciSecPrefixIs] ciSecPrefixIs;
    #req[ciVarFind] ciVarFind;
    #req[ciVarFindGlobal] ciVarFindGlobal;
    // names are consistently clamped to the 32B column everywhere
    if (len > 32) { len = 32; }
    ciTokHasCC(off, len) ccp;
    #stack[int, 64] idx = 0 - 1;
    if (ccp >= 0) {
        ciVarFindGlobal(off, len) gi;
        idx = gi;
        #delete[gi];
        if (idx >= 0) {
            #stack[int, 64] vis = cssc::peek64(ciVVis + idx * 8);
            if (vis == 0) {
                // private member: readable only from inside its own sector
                ciSecPrefixIs(off, ccp) same;
                if (same == 0) { idx = 0 - 1; }
                #delete[same];
            }
            #delete[vis];
        }
    }
    if (ccp < 0) {
        ciVarFind(off, len) fi;
        idx = fi;
        #delete[fi];
        if (idx < 0) {
            if (ciCurSecLen > 0) {
                ciQualify(ciCurSecOff, ciCurSecLen, off, len) ql;
                ciVarFindGlobal(ciQualBuf - ciSrc, ql) qi;
                idx = qi;
                #delete[qi];
                #delete[ql];
            }
        }
    }
    #stack[int, 64] r = 0;
    ciEvalType = 0;
    if (idx >= 0) {
        r = cssc::peek64(ciVVals + idx * 8);
        ciEvalType = cssc::peek64(ciVTypes + idx * 8);
    }
    if (idx < 0) { ciEvalType = 3; }   // FX-NULLVAR: unbound/deleted read -> null (tag 3, val 0 -> `0x0`)
    #delete[idx];
    #delete[ccp];
    return r;
}

// bind name = (val, vtype) with ownership `owns` (1 = this slot owns a heap
// string). Resolution order: (1) qualified "Sec::member" tokens target the
// GLOBAL member row -- writes to a foreign private member are silently
// dropped (read parity: private reads yield 0); (2) bare names target the
// current frame; (3) on a frame miss in ASSIGNMENT mode (ciSetMode=1) inside
// a sector context the write falls through to the qualified member (the
// reference's member write-back, cssl_cssc.py:16129); declarations
// (ciSetMode=0) never fall through -- a method-local #stack always shadows.
// (4) otherwise a fresh row is created in the current frame, writing ALL
// columns (val/type/owns/vis) so reused slots never leak stale state.
// Overwriting a slot that owns a string frees the old one first (single
// owner, reassignment never leaks).
#define(ciVarSet) {
    #scanp(ciVarSet, int, 0) off;
    #scanp(ciVarSet, int, 1) len;
    #scanp(ciVarSet, int, 2) val;
    #scanp(ciVarSet, int, 3) vtype;
    #scanp(ciVarSet, int, 4) owns;
    #req[ciSrc] ciSrc;
    #req[ciVNames] ciVNames;
    #req[ciVLens] ciVLens;
    #req[ciVVals] ciVVals;
    #req[ciVTypes] ciVTypes;
    #req[ciVOwns] ciVOwns;
    #req[ciVVis] ciVVis;
    #req[ciVCount] ciVCount;
    #req[ciBindVis] ciBindVis;
    #req[ciSetMode] ciSetMode;
    #req[ciCurSecOff] ciCurSecOff;
    #req[ciCurSecLen] ciCurSecLen;
    #req[ciQualBuf] ciQualBuf;
    #req[ciQualify] ciQualify;
    #req[ciTokHasCC] ciTokHasCC;
    #req[ciSecPrefixIs] ciSecPrefixIs;
    #req[ciVarFind] ciVarFind;
    #req[ciVarFindGlobal] ciVarFindGlobal;
    #req[ciInstFree] ciInstFree;
    #req[ciValFree] ciValFree;
    #req[ciNullBorrows] ciNullBorrows;
    #req[ciBindBits] ciBindBits;
    #req[ciVBits] ciVBits;
    #req[ciVReq] ciVReq;
    #req[ciSignal] ciSignal;
    #req[termType] termType;
    #req[termNewline] termNewline;
    if (len > 32) { len = 32; }
    ciTokHasCC(off, len) ccp;
    #stack[int, 64] idx = 0 - 1;
    #stack[int, 32] blocked = 0;
    if (ccp >= 0) {
        ciVarFindGlobal(off, len) gi;
        idx = gi;
        #delete[gi];
        if (idx >= 0) {
            #stack[int, 64] vis = cssc::peek64(ciVVis + idx * 8);
            if (vis == 0) {
                ciSecPrefixIs(off, ccp) same;
                if (same == 0) { blocked = 1; }
                #delete[same];
            }
            #delete[vis];
        }
    }
    if (ccp < 0) {
        ciVarFind(off, len) fi;
        idx = fi;
        #delete[fi];
        if (idx < 0) {
            if (ciSetMode == 1) {
                if (ciCurSecLen > 0) {
                    ciQualify(ciCurSecOff, ciCurSecLen, off, len) ql;
                    ciVarFindGlobal(ciQualBuf - ciSrc, ql) qi;
                    idx = qi;
                    #delete[qi];
                    #delete[ql];
                }
            }
        }
    }
    // ---- declared-bit-width enforcement (reference: "Value exceeds its
    // bit limit" is a hard error). An int write must fit the slot's width:
    // accepted range = [-(2^(b-1)) .. 2^b - 1] (union of signed/unsigned).
    if (blocked == 0) {
        if (vtype == 0) {
            #stack[int, 64] bw = ciBindBits;
            if (idx >= 0) { bw = cssc::peek64(ciVBits + idx * 8); }
            if (bw > 0) {
                if (bw < 64) {
                    #stack[int, 64] lim = cssc::shl(1, bw - 1);
                    #stack[int, 64] ulim = cssc::shl(1, bw);
                    #stack[int, 32] fits = 1;
                    if (val > ulim - 1) { fits = 0; }
                    if (val < 0 - lim) { fits = 0; }
                    if (fits == 0) {
                        blocked = 1;
                        #stack[string, 48] bmsg = "error: value exceeds its bit limit";
                        termType(bmsg, 14707829);
                        termNewline();
                        #delete[bmsg];
                        // reference semantics: the program aborts
                        ciSignal = 2;
                    }
                    #delete[fits];
                    #delete[lim];
                    #delete[ulim];
                }
            }
            #delete[bw];
        }
    }
    if (blocked == 0) {
        if (idx < 0) {
            if (ciVCount < 4096) {
                #stack[int, 32] j = 0;
                while (j < len) {
                    #stack[int, 64] ch = cssc::peek8(ciSrc + off + j);
                    cssc::poke8(ciVNames + ciVCount * 32 + j, ch);
                    #delete[ch];
                    j = j + 1;
                }
                #delete[j];
                cssc::poke64(ciVLens + ciVCount * 8, len);
                cssc::poke64(ciVVals + ciVCount * 8, val);
                cssc::poke64(ciVTypes + ciVCount * 8, vtype);
                cssc::poke64(ciVOwns + ciVCount * 8, owns);
                cssc::poke64(ciVVis + ciVCount * 8, ciBindVis);
                cssc::poke64(ciVBits + ciVCount * 8, ciBindBits);
                cssc::poke64(ciVReq + ciVCount * 8, 0);
                idx = ciVCount;
                ciVCount = ciVCount + 1;
            }
            if (idx < 0) {
                // table full: the bind is dropped -- release an owned
                // temporary so the overflow can not leak heap memory
                if (owns == 1) { ciValFree(vtype, val); }
            }
        }
        if (idx >= 0) {
            #stack[int, 32] fresh = 0;
            if (idx == ciVCount - 1) {
                // just created above: columns already written
                #stack[int, 64] cv = cssc::peek64(ciVVals + idx * 8);
                if (cv == val) { fresh = 1; }
                #delete[cv];
            }
            if (fresh == 0) {
                // release what the slot owned before (string or instance;
                // skip on self-assignment) and null any dangling borrows
                #stack[int, 64] oldOwns = cssc::peek64(ciVOwns + idx * 8);
                #stack[int, 64] oldType = cssc::peek64(ciVTypes + idx * 8);
                #stack[int, 64] oldVal = cssc::peek64(ciVVals + idx * 8);
                if (oldOwns == 1) {
                    if (oldVal != val) {
                        // null dangling aliases, then release string/instance AND
                        // container (4/5/7) -- reassigning an owned container var
                        // (e.g. setCH overwriting the global CH vector) otherwise
                        // orphaned the previous container on every write
                        if (oldType == 1) { ciNullBorrows(oldVal, 1); }
                        if (oldType == 4) { ciNullBorrows(oldVal, 4); }
                        if (oldType == 5) { ciNullBorrows(oldVal, 5); }
                        if (oldType == 7) { ciNullBorrows(oldVal, 7); }
                        ciValFree(oldType, oldVal);
                    }
                }
                cssc::poke64(ciVVals + idx * 8, val);
                cssc::poke64(ciVTypes + idx * 8, vtype);
                cssc::poke64(ciVOwns + idx * 8, owns);
                // #req write-through: if this row is a requisition alias, mutate
                // the target global too (transfer ownership to the global; the
                // alias becomes a borrow). Lets `#req[A] a; a = x;` update A.
                #stack[int, 64] rl = cssc::peek64(ciVReq + idx * 8);
                if (rl > 0) {
                    #stack[int, 64] grow = rl - 1;
                    #stack[int, 64] goOwns = cssc::peek64(ciVOwns + grow * 8);
                    #stack[int, 64] goType = cssc::peek64(ciVTypes + grow * 8);
                    #stack[int, 64] goVal = cssc::peek64(ciVVals + grow * 8);
                    if (goOwns == 1) {
                        if (goVal != val) {
                            // release the target global's previous owned value,
                            // containers included (setCH via `#req[CH] ch; ch=...`
                            // reaches CH through this write-through path)
                            ciValFree(goType, goVal);
                        }
                    }
                    cssc::poke64(ciVVals + grow * 8, val);
                    cssc::poke64(ciVTypes + grow * 8, vtype);
                    cssc::poke64(ciVOwns + grow * 8, owns);
                    cssc::poke64(ciVOwns + idx * 8, 0);
                    #delete[goOwns];
                    #delete[goType];
                    #delete[goVal];
                    #delete[grow];
                }
                #delete[rl];
                #delete[oldOwns];
                #delete[oldType];
                #delete[oldVal];
            }
            #delete[fresh];
        }
    }
    if (blocked == 1) {
        // silently dropped write to a foreign private member: nobody adopts
        // an owned temporary, so release it here
        if (owns == 1) {
            if (vtype == 1) { cssc::free(val); }
            if (vtype == 3) { if (val != 0) { ciInstFree(val); } }
        }
    }
    #delete[blocked];
    #delete[idx];
    #delete[ccp];
}

// Bind a call/mirror result capture to its target. A plain ident (isMem=0) binds
// a variable; `X->member` (isMem=1) binds an object member, resolving X the same
// way an `X->m = v` assignment does: the running object's own instance when the
// name is the current object, else a variable holding an instance (tag 3). This
// is why a capture like `g::ld() Self->data;` must NOT just ciVarSet the first
// ident -- that overwrote the instance and left the member 0.
#define(ciCapStore) {
    #scanp(ciCapStore, int, 0) nOff;
    #scanp(ciCapStore, int, 1) nLen;
    #scanp(ciCapStore, int, 2) isMem;
    #scanp(ciCapStore, int, 3) mOff;
    #scanp(ciCapStore, int, 4) mLen;
    #scanp(ciCapStore, int, 5) val;
    #scanp(ciCapStore, int, 6) vtype;
    #scanp(ciCapStore, int, 7) owns;
    #req[ciVarSet] ciVarSet;
    #req[ciVarGet] ciVarGet;
    #req[ciInstMemSet] ciInstMemSet;
    #req[ciObjNameIs] ciObjNameIs;
    #req[ciCurInst] ciCurInst;
    #req[ciCurObj] ciCurObj;
    #req[ciEvalType] ciEvalType;
    if (isMem == 0) {
        ciVarSet(nOff, nLen, val, vtype, owns);
    }
    if (isMem == 1) {
        #stack[int, 64] tinst = 0;
        if (ciCurInst != 0) {
            ciObjNameIs(ciCurObj, nOff, nLen) isCur;
            if (isCur == 1) { tinst = ciCurInst; }
            #delete[isCur];
        }
        if (tinst == 0) {
            ciVarGet(nOff, nLen) iv;
            if (ciEvalType == 3) { tinst = iv; }
            #delete[iv];
        }
        if (tinst != 0) {
            ciInstMemSet(tinst, mOff, mLen, val, vtype, owns);
        }
        if (tinst == 0) {
            if (owns == 1) { if (vtype == 1) { cssc::free(val); } }
        }
        #delete[tinst];
    }
}

// #delete[name]: free the string the row owns (if any) and unbind the row by
// TOMBSTONING it in place (nameLen=0 never matches a lookup). No rows are
// moved: a swap-compaction could pull a live frame-local across the frame
// floor when a GLOBAL member row is dropped from inside a method -- the
// tombstone is provably safe in every frame context. Resolution mirrors
// ciVarGet: qualified tokens hit the global row (private only from inside),
// bare names hit the frame, then fall back to the current sector's member.
#define(ciVarDrop) {
    #scanp(ciVarDrop, int, 0) off;
    #scanp(ciVarDrop, int, 1) len;
    #req[ciSrc] ciSrc;
    #req[ciVLens] ciVLens;
    #req[ciVVals] ciVVals;
    #req[ciVTypes] ciVTypes;
    #req[ciVOwns] ciVOwns;
    #req[ciVVis] ciVVis;
    #req[ciVCount] ciVCount;
    #req[ciInstFree] ciInstFree;
    #req[ciNullBorrows] ciNullBorrows;
    #req[ciValFree] ciValFree;
    #req[ciCurSecOff] ciCurSecOff;
    #req[ciCurSecLen] ciCurSecLen;
    #req[ciQualBuf] ciQualBuf;
    #req[ciQualify] ciQualify;
    #req[ciTokHasCC] ciTokHasCC;
    #req[ciSecPrefixIs] ciSecPrefixIs;
    #req[ciVarFind] ciVarFind;
    #req[ciVarFindGlobal] ciVarFindGlobal;
    if (len > 32) { len = 32; }
    ciTokHasCC(off, len) ccp;
    #stack[int, 64] idx = 0 - 1;
    if (ccp >= 0) {
        ciVarFindGlobal(off, len) gi;
        idx = gi;
        #delete[gi];
        if (idx >= 0) {
            #stack[int, 64] vis = cssc::peek64(ciVVis + idx * 8);
            if (vis == 0) {
                ciSecPrefixIs(off, ccp) same;
                if (same == 0) { idx = 0 - 1; }
                #delete[same];
            }
            #delete[vis];
        }
    }
    if (ccp < 0) {
        ciVarFind(off, len) fi;
        idx = fi;
        #delete[fi];
        if (idx < 0) {
            if (ciCurSecLen > 0) {
                ciQualify(ciCurSecOff, ciCurSecLen, off, len) ql;
                ciVarFindGlobal(ciQualBuf - ciSrc, ql) qi;
                idx = qi;
                #delete[qi];
                #delete[ql];
            }
        }
    }
    if (idx >= 0) {
        #stack[int, 64] ty = cssc::peek64(ciVTypes + idx * 8);
        #stack[int, 64] ow = cssc::peek64(ciVOwns + idx * 8);
        #stack[int, 64] vv = cssc::peek64(ciVVals + idx * 8);
        if (ow == 1) {
            // release the owned value; null every dangling alias first
            // (use-after-free guard), then hand the heap back via ciValFree so
            // strings, objects AND containers (vector/map/bind) are all freed
            if (vv != 0) {
                if (ty == 1) { ciNullBorrows(vv, 1); }
                if (ty == 4) { ciNullBorrows(vv, 4); }
                if (ty == 5) { ciNullBorrows(vv, 5); }
                if (ty == 7) { ciNullBorrows(vv, 7); }
                ciValFree(ty, vv);
            }
        }
        // tombstone: unbind in place, wipe every column
        cssc::poke64(ciVLens + idx * 8, 0);
        cssc::poke64(ciVVals + idx * 8, 0);
        cssc::poke64(ciVTypes + idx * 8, 0);
        cssc::poke64(ciVOwns + idx * 8, 0);
        cssc::poke64(ciVVis + idx * 8, 1);
        #delete[ty];
        #delete[ow];
        #delete[vv];
    }
    #delete[idx];
    #delete[ccp];
}

#define(ciEatCall) {
    #req[ciCur] ciCur;
    #req[ciAdvance] ciAdvance;
    if (ciCur == 9) {
        ciAdvance();
    }
    if (ciCur == 10) {
        ciAdvance();
    }
}

#define(ciStrNew) {
    #scanp(ciStrNew, int, 0) srcAddr;
    #scanp(ciStrNew, int, 1) len;
    #stack[int, 64] p = cssc::alloc(len + 8);
    cssc::poke32(p, 1);
    cssc::poke32(p + 4, len);
    #stack[int, 32] i = 0;
    while (i < len) {
        cssc::poke8(p + 8 + i, cssc::peek8(srcAddr + i));
        i = i + 1;
    }
    #delete[i];
    return p;
}

// deep-copy a string object {rc,size,bytes} into a fresh owned allocation.
// This is what the `&` copy operator produces (CSSC: ref by default, & = copy).
#define(ciStrClone) {
    #scanp(ciStrClone, int, 0) src;
    // a null source (uninitialized string) clones to an empty string, not a fault.
    #stack[int, 64] n = 0;
    if (src != 0) { n = cssc::peek32(src + 4); }
    #stack[int, 64] p = cssc::alloc(n + 8);
    cssc::poke32(p, 1);
    cssc::poke32(p + 4, n);
    #stack[int, 32] i = 0;
    while (i < n) {
        cssc::poke8(p + 8 + i, cssc::peek8(src + 8 + i));
        i = i + 1;
    }
    #delete[i];
    #delete[n];
    return p;
}

#define(ciItoa) {
    #scanp(ciItoa, int, 0) val;
    #scanp(ciItoa, int, 1) buf;
    #stack[int, 64] v = val;
    #stack[int, 32] n = 0;
    if (v < 0) {
        cssc::poke8(buf, 45);
        n = 1;
        v = 0 - v;
    }
    #stack[int, 64] place = 1;
    while (place * 10 <= v) {
        place = place * 10;
    }
    #stack[int, 32] more = 1;
    while (more == 1) {
        #stack[int, 64] d = (v / place) % 10;
        cssc::poke8(buf + n, 48 + d);
        n = n + 1;
        #delete[d];
        place = cssc::div(place, 10);
        if (place == 0) {
            more = 0;
        }
    }
    #delete[more];
    #delete[place];
    #delete[v];
    return n;
}

// stringify ANY value into buf at offset `off` (cap-bounded); returns the new
// offset. SELF-RECURSIVE so nested containers print in full: scalars via itoa/
// fToStr/bytes; vector/array 4 -> [a, b, c]; bind 7 -> [cells]; map 5 -> {k: v}.
// A container element that is itself a container recurses (nested vec support).
#define(ciContFmt) {
    #scanp(ciContFmt, int, 0) val;
    #scanp(ciContFmt, int, 1) type;
    #scanp(ciContFmt, int, 2) buf;
    #scanp(ciContFmt, int, 3) off;
    #scanp(ciContFmt, int, 4) cap;
    #req[ciItoa] ciItoa;
    #req[ciContFmt] ciContFmt;
    #stack[int, 64] n = off;
    if (type == 1) {
        #stack[int, 64] sl = cssc::peek32(val + 4);
        #stack[int, 64] j = 0;
        while (j < sl) { if (n < cap) { cssc::poke8(buf + n, cssc::peek8(val + 8 + j)); n = n + 1; } j = j + 1; }
        #delete[j];
        #delete[sl];
    }
    if (type == 2) {
        #stack[int, 64] fb = cssc::alloc(48);
        cssc::fToStr(val, fb, 48) fn;
        #stack[int, 64] j = 0;
        while (j < fn) { if (n < cap) { cssc::poke8(buf + n, cssc::peek8(fb + j)); n = n + 1; } j = j + 1; }
        cssc::free(fb);
        #delete[j];
        #delete[fn];
        #delete[fb];
    }
    #stack[int, 32] scalarInt = 0;
    if (type == 0) { scalarInt = 1; }
    if (type == 3) { scalarInt = 1; }
    if (scalarInt == 1) {
        #stack[int, 64] tb = cssc::alloc(24);
        ciItoa(val, tb) dn;
        #stack[int, 64] j = 0;
        while (j < dn) { if (n < cap) { cssc::poke8(buf + n, cssc::peek8(tb + j)); n = n + 1; } j = j + 1; }
        cssc::free(tb);
        #delete[j];
        #delete[dn];
        #delete[tb];
    }
    #delete[scalarInt];
    if (type == 9) {
        #stack[int, 32] tv = 0;
        if (val != 0) { tv = 1; }
        if (tv == 1) {
            if (n < cap) { cssc::poke8(buf + n, 116); n = n + 1; }
            if (n < cap) { cssc::poke8(buf + n, 114); n = n + 1; }
            if (n < cap) { cssc::poke8(buf + n, 117); n = n + 1; }
            if (n < cap) { cssc::poke8(buf + n, 101); n = n + 1; }
        }
        if (tv == 0) {
            if (n < cap) { cssc::poke8(buf + n, 102); n = n + 1; }
            if (n < cap) { cssc::poke8(buf + n, 97); n = n + 1; }
            if (n < cap) { cssc::poke8(buf + n, 108); n = n + 1; }
            if (n < cap) { cssc::poke8(buf + n, 115); n = n + 1; }
            if (n < cap) { cssc::poke8(buf + n, 101); n = n + 1; }
        }
        #delete[tv];
    }
    if (type == 4) {
        #stack[int, 64] sz = cssc::peek32(val + 4);
        #stack[int, 64] et = cssc::peek32(val + 12);
        #stack[int, 64] data = cssc::peek64(val + 16);
        #stack[int, 64] tp = 0;
        if (et == 8) { tp = cssc::peek64(val + 24); }
        if (n < cap) { cssc::poke8(buf + n, 123); n = n + 1; }
        #stack[int, 64] i = 0;
        while (i < sz) {
            if (i > 0) { if (n < cap) { cssc::poke8(buf + n, 44); n = n + 1; } if (n < cap) { cssc::poke8(buf + n, 32); n = n + 1; } }
            #stack[int, 64] ev = cssc::peek64(data + i * 8);
            #stack[int, 64] eet = et;
            if (et == 8) { eet = cssc::peek32(tp + i * 8); }
            #stack[int, 32] evNull = 0;
            if (eet == 3) { if (ev == 0) { evNull = 1; } }
            if (evNull == 1) {
                if (n < cap) { cssc::poke8(buf + n, 48); n = n + 1; }
                if (n < cap) { cssc::poke8(buf + n, 120); n = n + 1; }
                if (n < cap) { cssc::poke8(buf + n, 48); n = n + 1; }
            }
            if (evNull == 0) {
                ciContFmt(ev, eet, buf, n, cap) nn;
                n = nn;
                #delete[nn];
            }
            #delete[evNull];
            #delete[eet];
            #delete[ev];
            i = i + 1;
        }
        if (n < cap) { cssc::poke8(buf + n, 125); n = n + 1; }
        #delete[i];
        #delete[tp];
        #delete[data];
        #delete[et];
        #delete[sz];
    }
    if (type == 7) {
        // FX-BINDLIT render: `{c0, c1; c2, c3}` -- curly braces, `; ` between
        // rows (every pairWidth cells), `, ` within a row; null pad cells -> 0x0.
        #stack[int, 64] size = cssc::peek32(val + 4);
        #stack[int, 64] pw = cssc::peek32(val + 12);
        #stack[int, 64] used = size * pw;
        #stack[int, 64] d = cssc::peek64(val + 16);
        if (n < cap) { cssc::poke8(buf + n, 123); n = n + 1; }
        #stack[int, 64] i = 0;
        while (i < used) {
            if (i > 0) {
                #stack[int, 64] sep = 44;                       // ','
                if (pw > 0) { if (i % pw == 0) { sep = 59; } }  // ';' on a row boundary
                if (n < cap) { cssc::poke8(buf + n, sep); n = n + 1; }
                if (n < cap) { cssc::poke8(buf + n, 32); n = n + 1; }
                #delete[sep];
            }
            #stack[int, 64] ct = cssc::peek64(d + i * 16);
            #stack[int, 64] cv = cssc::peek64(d + i * 16 + 8);
            #stack[int, 32] isNull = 0;
            if (ct == 3) { if (cv == 0) { isNull = 1; } }
            if (isNull == 1) {
                if (n < cap) { cssc::poke8(buf + n, 48); n = n + 1; }
                if (n < cap) { cssc::poke8(buf + n, 120); n = n + 1; }
                if (n < cap) { cssc::poke8(buf + n, 48); n = n + 1; }
            }
            if (isNull == 0) {
                ciContFmt(cv, ct, buf, n, cap) nn;
                n = nn;
                #delete[nn];
            }
            #delete[isNull];
            #delete[ct];
            #delete[cv];
            i = i + 1;
        }
        if (n < cap) { cssc::poke8(buf + n, 125); n = n + 1; }
        #delete[i];
        #delete[d];
        #delete[used];
        #delete[pw];
        #delete[size];
    }
    if (type == 5) {
        #stack[int, 64] sz = cssc::peek32(val + 4);
        #stack[int, 64] data = cssc::peek64(val + 16);
        if (n < cap) { cssc::poke8(buf + n, 123); n = n + 1; }
        #stack[int, 64] i = 0;
        while (i < sz) {
            if (i > 0) { if (n < cap) { cssc::poke8(buf + n, 44); n = n + 1; } if (n < cap) { cssc::poke8(buf + n, 32); n = n + 1; } }
            #stack[int, 64] kt = cssc::peek64(data + i * 32);
            #stack[int, 64] kv = cssc::peek64(data + i * 32 + 8);
            #stack[int, 64] vt = cssc::peek64(data + i * 32 + 16);
            #stack[int, 64] vv = cssc::peek64(data + i * 32 + 24);
            ciContFmt(kv, kt, buf, n, cap) n1;
            n = n1;
            #delete[n1];
            if (n < cap) { cssc::poke8(buf + n, 58); n = n + 1; }
            if (n < cap) { cssc::poke8(buf + n, 32); n = n + 1; }
            ciContFmt(vv, vt, buf, n, cap) n2;
            n = n2;
            #delete[n2];
            #delete[kt];
            #delete[kv];
            #delete[vt];
            #delete[vv];
            i = i + 1;
        }
        if (n < cap) { cssc::poke8(buf + n, 125); n = n + 1; }
        #delete[i];
        #delete[data];
        #delete[sz];
    }
    return n;
}

#define(ciStrConcat) {
    #scanp(ciStrConcat, int, 0) a;
    #scanp(ciStrConcat, int, 1) aT;
    #scanp(ciStrConcat, int, 2) b;
    #scanp(ciStrConcat, int, 3) bT;
    #req[ciItoa] ciItoa;
    #req[ciContFmt] ciContFmt;
    #stack[int, 64] tmpA = cssc::alloc(1024);
    #stack[int, 64] tmpB = cssc::alloc(1024);
    #stack[int, 64] aData = 0;
    #stack[int, 64] aLen = 0;
    #stack[int, 64] bData = 0;
    #stack[int, 64] bLen = 0;
    if (aT == 1) {
        // a null string pointer (an uninitialized `#stack[string]` reads as 0)
        // is an empty string, NOT a fault: peek32(0+4) would segfault. Match the
        // reference, which treats an uninitialised string as "".
        if (a != 0) {
            aData = a + 8;
            aLen = cssc::peek32(a + 4);
        }
    }
    if (aT == 2) {
        cssc::fToStr(a, tmpA, 1024) na;
        aLen = na;
        aData = tmpA;
        #delete[na];
    }
    if (aT == 0) {
        ciItoa(a, tmpA) na;
        aLen = na;
        aData = tmpA;
        #delete[na];
    }
    if (aT >= 4) {
        ciContFmt(a, aT, tmpA, 0, 1024) na;
        aLen = na;
        aData = tmpA;
        #delete[na];
    }
    if (bT == 1) {
        if (b != 0) {
            bData = b + 8;
            bLen = cssc::peek32(b + 4);
        }
    }
    if (bT == 2) {
        cssc::fToStr(b, tmpB, 1024) nb;
        bLen = nb;
        bData = tmpB;
        #delete[nb];
    }
    if (bT == 0) {
        ciItoa(b, tmpB) nb;
        bLen = nb;
        bData = tmpB;
        #delete[nb];
    }
    if (bT >= 4) {
        ciContFmt(b, bT, tmpB, 0, 1024) nb;
        bLen = nb;
        bData = tmpB;
        #delete[nb];
    }
    #stack[int, 64] total = aLen + bLen;
    #stack[int, 64] p = cssc::alloc(total + 8);
    cssc::poke32(p, 1);
    cssc::poke32(p + 4, total);
    #stack[int, 32] i = 0;
    while (i < aLen) {
        cssc::poke8(p + 8 + i, cssc::peek8(aData + i));
        i = i + 1;
    }
    #stack[int, 32] k = 0;
    while (k < bLen) {
        cssc::poke8(p + 8 + aLen + k, cssc::peek8(bData + k));
        k = k + 1;
    }
    #delete[i];
    #delete[k];
    #delete[total];
    #delete[aData];
    #delete[aLen];
    #delete[bData];
    #delete[bLen];
    // free the heap the scratch buffers hold -- #delete only pops the stack slot
    // and would otherwise leak 2KB on EVERY concatenation (the dominant leak that
    // starved the OS heap when running concat-heavy programs like test_file.cssc)
    cssc::free(tmpA);
    cssc::free(tmpB);
    #delete[tmpA];
    #delete[tmpB];
    return p;
}

// look up a registered user function by name -> table index, or -1
#define(ciFnFind) {
    #scanp(ciFnFind, int, 0) off;
    #scanp(ciFnFind, int, 1) len;
    #req[ciSrc] ciSrc;
    #req[ciFnNames] ciFnNames;
    #req[ciFnLens] ciFnLens;
    #req[ciFnCount] ciFnCount;
    // consistent-truncation rule: stores clamp to 32, so must lookups
    if (len > 32) { len = 32; }
    #stack[int, 64] found = 0 - 1;
    #stack[int, 32] i = 0;
    while (i < ciFnCount) {
        #stack[int, 64] nl = cssc::peek64(ciFnLens + i * 8);
        if (nl == len) {
            #stack[int, 32] m = 1;
            #stack[int, 32] j = 0;
            while (j < len) {
                #stack[int, 64] a = cssc::peek8(ciSrc + off + j);
                #stack[int, 64] b = cssc::peek8(ciFnNames + i * 32 + j);
                if (a != b) { m = 0; }
                #delete[a];
                #delete[b];
                j = j + 1;
            }
            #delete[j];
            if (m == 1) { found = i; }
            #delete[m];
        }
        #delete[nl];
        i = i + 1;
    }
    #delete[i];
    return found;
}

// record a #define's name + body source span (start after '{', end at the
// matching '}'). Re-registering an existing name UPDATES it in place (sector
// redeclaration = silent replace, reference cssl_cssc.py:16301). The sector
// backpointer + visibility come from the ciRegSecOff/Len + ciBindVis context
// globals and are written on EVERY register so reused rows carry no stale
// state (0/0 + public for plain free functions).
#define(ciFnRegister) {
    #scanp(ciFnRegister, int, 0) off;
    #scanp(ciFnRegister, int, 1) len;
    #scanp(ciFnRegister, int, 2) bstart;
    #scanp(ciFnRegister, int, 3) bend;
    #req[ciSrc] ciSrc;
    #req[ciFnNames] ciFnNames;
    #req[ciFnLens] ciFnLens;
    #req[ciFnBodyStart] ciFnBodyStart;
    #req[ciFnBodyEnd] ciFnBodyEnd;
    #req[ciFnSecOff] ciFnSecOff;
    #req[ciFnSecLen] ciFnSecLen;
    #req[ciFnVis] ciFnVis;
    #req[ciFnCount] ciFnCount;
    #req[ciRegSecOff] ciRegSecOff;
    #req[ciRegSecLen] ciRegSecLen;
    #req[ciBindVis] ciBindVis;
    #req[ciFnFind] ciFnFind;
    #req[ciFnParCnt] ciFnParCnt;
    if (len > 32) { len = 32; }
    ciFnFind(off, len) row;
    if (row < 0) {
        if (ciFnCount < 2048) {
            #stack[int, 32] j = 0;
            while (j < len) {
                cssc::poke8(ciFnNames + ciFnCount * 32 + j, cssc::peek8(ciSrc + off + j));
                j = j + 1;
            }
            #delete[j];
            cssc::poke64(ciFnLens + ciFnCount * 8, len);
            row = ciFnCount;
            ciFnCount = ciFnCount + 1;
        }
    }
    if (row >= 0) {
        cssc::poke64(ciFnBodyStart + row * 8, bstart);
        cssc::poke64(ciFnBodyEnd + row * 8, bend);
        cssc::poke64(ciFnSecOff + row * 8, ciRegSecOff);
        cssc::poke64(ciFnSecLen + row * 8, ciRegSecLen);
        cssc::poke64(ciFnVis + row * 8, ciBindVis);
        // default to no named params (#define uses #scanp); #cdefine sets these after
        cssc::poke64(ciFnParCnt + row * 8, 0);
    }
    // return the row so #cdefine can attach its named params (#define ignores it)
    return row;
}
// ---- vector (value tag 4) : dynamic array, two-level so growth never moves
// the handle. handle{rc@0,size@4,cap@8,elemType@12,data@16}; data = cap*8 value
// slots. Elements are homogeneous (`vector<T>`); elemType (0=int,1=string) is in
// the handle. String elements are OWNED by the vector: push/set CLONE the string
// and free/clear/set-overwrite RELEASE it, so there is no dangling and no leak.
#define(ciVecNew) {
    #scanp(ciVecNew, int, 0) et;
    #stack[int, 64] cap = 8;
    #stack[int, 64] h = cssc::alloc(32);
    #stack[int, 64] d = cssc::alloc(cap * 8);
    cssc::memfill32(d, 0, cap * 2);
    cssc::poke32(h, 1);
    cssc::poke32(h + 4, 0);
    cssc::poke32(h + 8, cap);
    cssc::poke32(h + 12, et);
    cssc::poke64(h + 16, d);
    #stack[int, 64] tp = 0;
    if (et == 8) {
        tp = cssc::alloc(cap * 8);
        cssc::memfill32(tp, 0, cap * 2);
    }
    cssc::poke64(h + 24, tp);
    #delete[tp];
    #delete[d];
    #delete[cap];
    return h;
}
#define(ciVecType) {
    #scanp(ciVecType, int, 0) h;
    return cssc::peek32(h + 12);
}
#define(ciVecTypeAt) {
    #scanp(ciVecTypeAt, int, 0) h;
    #scanp(ciVecTypeAt, int, 1) i;
    #stack[int, 64] et = cssc::peek32(h + 12);
    #stack[int, 64] r = et;
    if (et == 8) {
        #stack[int, 64] tp = cssc::peek64(h + 24);
        r = cssc::peek32(tp + i * 8);
        #delete[tp];
    }
    #delete[et];
    return r;
}
#define(ciVecSize) {
    #scanp(ciVecSize, int, 0) h;
    return cssc::peek32(h + 4);
}
#define(ciVecPush) {
    #scanp(ciVecPush, int, 0) h;
    #scanp(ciVecPush, int, 1) x;
    #scanp(ciVecPush, int, 2) xt;
    #req[ciStrClone] ciStrClone;
    #req[ciStrNew] ciStrNew;
    #req[ciItoa] ciItoa;
    #stack[int, 64] size = cssc::peek32(h + 4);
    #stack[int, 64] cap = cssc::peek32(h + 8);
    #stack[int, 64] et = cssc::peek32(h + 12);
    if (size >= cap) {
        #stack[int, 64] ncap = cap * 2;
        #stack[int, 64] nd = cssc::alloc(ncap * 8);
        #stack[int, 64] od = cssc::peek64(h + 16);
        cssc::memcopy(nd, od, size * 2);
        cssc::free(od);
        cssc::poke64(h + 16, nd);
        cssc::poke32(h + 8, ncap);
        if (et == 8) {
            #stack[int, 64] otp = cssc::peek64(h + 24);
            #stack[int, 64] ntp = cssc::alloc(ncap * 8);
            cssc::memfill32(ntp, 0, ncap * 2);
            cssc::memcopy(ntp, otp, size * 2);
            cssc::free(otp);
            cssc::poke64(h + 24, ntp);
            #delete[otp];
            #delete[ntp];
        }
        #delete[od];
        #delete[nd];
        #delete[ncap];
    }
    #stack[int, 64] sv = x;
    if (et == 1) {
        // Push into a vector<string>. The pushed value's type tag (xt) is not
        // always reliable (e.g. `char = &popped` can leave a string carrying tag
        // 0), so distinguish by VALUE as well: a real string element is a heap
        // pointer (always large); a small int/char is < 0x10000; a float is the
        // one type reliably tagged (2). This both prevents ciStrClone from
        // dereferencing a non-pointer (float bits -> peek32 fault) and salvages a
        // stale-tagged string instead of printing its pointer as a number.
        if (xt == 2) {
            #stack[int, 64] sb = cssc::alloc(64);
            cssc::fToStr(x, sb, 64) fn;
            ciStrNew(sb, fn) ss;
            sv = ss;
            #delete[ss];
            cssc::free(sb);
            #delete[sb];
            #delete[fn];
        }
        if (xt != 2) {
            // small int / char code
            if (x < 65536) {
                #stack[int, 64] sb = cssc::alloc(64);
                ciItoa(x, sb) in3;
                ciStrNew(sb, in3) ss;
                sv = ss;
                #delete[ss];
                cssc::free(sb);
                #delete[sb];
                #delete[in3];
            }
            // a real heap string pointer is large but below 2^48; a value with
            // bits at/above 2^48 is a stale-tagged float bit pattern (a finite
            // double like 0.55 = 0x3FE1..., far above any real pointer) -> format
            // as a float rather than clone (which would peek32(bits+4) and fault).
            if (x >= 65536) {
                if (x < 281474976710656) {
                    ciStrClone(x) cx;
                    sv = cx;
                    #delete[cx];
                }
                if (x >= 281474976710656) {
                    #stack[int, 64] sb = cssc::alloc(64);
                    cssc::fToStr(x, sb, 64) fn2;
                    ciStrNew(sb, fn2) ss;
                    sv = ss;
                    #delete[ss];
                    cssc::free(sb);
                    #delete[sb];
                    #delete[fn2];
                }
            }
        }
    }
    if (et == 8) {
        if (xt == 1) { ciStrClone(x) cx; sv = cx; #delete[cx]; }
        #stack[int, 64] tp2 = cssc::peek64(h + 24);
        cssc::poke32(tp2 + size * 8, xt);
        #delete[tp2];
    }
    #stack[int, 64] d = cssc::peek64(h + 16);
    cssc::poke64(d + size * 8, sv);
    cssc::poke32(h + 4, size + 1);
    #delete[d];
    #delete[sv];
    #delete[et];
    #delete[size];
    #delete[cap];
}
#define(ciVecGet) {
    #scanp(ciVecGet, int, 0) h;
    #scanp(ciVecGet, int, 1) i;
    #req[ciStrClone] ciStrClone;
    #req[ciVecPopType] ciVecPopType;
    #stack[int, 64] size = cssc::peek32(h + 4);
    #stack[int, 64] et = cssc::peek32(h + 12);
    #stack[int, 64] r = 0;
    ciVecPopType = et;              // real type of the returned element (auto -> per-elem)
    #stack[int, 32] inb = 0;
    if (i >= 0) {
        if (i < size) {
            inb = 1;
            #stack[int, 64] d = cssc::peek64(h + 16);
            #stack[int, 64] raw = cssc::peek64(d + i * 8);
            if (et == 1) {
                ciStrClone(raw) cr;
                r = cr;
                #delete[cr];
            }
            if (et == 8) {
                #stack[int, 64] tp = cssc::peek64(h + 24);
                #stack[int, 64] pt = cssc::peek32(tp + i * 8);
                ciVecPopType = pt;
                if (pt == 1) { ciStrClone(raw) cr8; r = cr8; #delete[cr8]; }
                if (pt != 1) { r = raw; }
                #delete[tp];
                #delete[pt];
            }
            if (et != 1) { if (et != 8) { r = raw; } }
            #delete[raw];
            #delete[d];
        }
    }
    if (inb == 0) { ciVecPopType = 3; }   // out-of-bounds read -> null (0x0), RAW
    #delete[inb];
    #delete[et];
    #delete[size];
    return r;
}
#define(ciVecSet) {
    #scanp(ciVecSet, int, 0) h;
    #scanp(ciVecSet, int, 1) i;
    #scanp(ciVecSet, int, 2) x;
    #req[ciStrClone] ciStrClone;
    #stack[int, 64] size = cssc::peek32(h + 4);
    #stack[int, 64] et = cssc::peek32(h + 12);
    if (i >= 0) {
        if (i < size) {
            #stack[int, 64] d = cssc::peek64(h + 16);
            if (et == 1) {
                #stack[int, 64] old = cssc::peek64(d + i * 8);
                cssc::free(old);
                ciStrClone(x) cx;
                cssc::poke64(d + i * 8, cx);
                #delete[cx];
                #delete[old];
            }
            if (et != 1) { cssc::poke64(d + i * 8, x); }
            #delete[d];
        }
    }
    #delete[et];
    #delete[size];
}
#define(ciVecPop) {
    #scanp(ciVecPop, int, 0) h;
    #req[ciVecPopType] ciVecPopType;
    #stack[int, 64] size = cssc::peek32(h + 4);
    #stack[int, 64] et = cssc::peek32(h + 12);
    #stack[int, 64] r = 0;
    ciVecPopType = et;
    if (size > 0) {
        size = size - 1;
        cssc::poke32(h + 4, size);
        #stack[int, 64] d = cssc::peek64(h + 16);
        r = cssc::peek64(d + size * 8);
        if (et == 8) {
            #stack[int, 64] tp = cssc::peek64(h + 24);
            ciVecPopType = cssc::peek32(tp + size * 8);
            #delete[tp];
        }
        #delete[d];
    }
    #delete[size];
    #delete[et];
    return r;
}
// remove + return element 0, shifting the rest down one slot (FIFO front pop).
// Ownership transfers to the caller exactly like ciVecPop (the slot is dropped
// from the vector, so a string element is no longer owned here).
#define(ciVecPopFront) {
    #scanp(ciVecPopFront, int, 0) h;
    #req[ciVecPopType] ciVecPopType;
    #stack[int, 64] size = cssc::peek32(h + 4);
    #stack[int, 64] et = cssc::peek32(h + 12);
    #stack[int, 64] r = 0;
    ciVecPopType = et;
    if (size > 0) {
        #stack[int, 64] d = cssc::peek64(h + 16);
        r = cssc::peek64(d);
        #stack[int, 64] tp = 0;
        if (et == 8) {
            tp = cssc::peek64(h + 24);
            ciVecPopType = cssc::peek32(tp);
        }
        #stack[int, 64] i = 0;
        while (i < size - 1) {
            cssc::poke64(d + i * 8, cssc::peek64(d + (i + 1) * 8));
            if (et == 8) {
                cssc::poke32(tp + i * 8, cssc::peek32(tp + (i + 1) * 8));
            }
            i = i + 1;
        }
        #delete[i];
        cssc::poke32(h + 4, size - 1);
        #delete[tp];
        #delete[d];
    }
    #delete[size];
    #delete[et];
    return r;
}
#define(ciVecClear) {
    #scanp(ciVecClear, int, 0) h;
    #stack[int, 64] et = cssc::peek32(h + 12);
    // free only the owned STRING elements (ciVecPush clones strings); container/
    // object elements are borrows -> leave them alone (borrow-respecting)
    if (et == 1) {
        #stack[int, 64] size = cssc::peek32(h + 4);
        #stack[int, 64] d = cssc::peek64(h + 16);
        #stack[int, 64] i = 0;
        while (i < size) {
            #stack[int, 64] ev = cssc::peek64(d + i * 8);
            if (ev != 0) { cssc::free(ev); }
            #delete[ev];
            i = i + 1;
        }
        #delete[i];
        #delete[d];
        #delete[size];
    }
    if (et == 8) {
        #stack[int, 64] size = cssc::peek32(h + 4);
        #stack[int, 64] d = cssc::peek64(h + 16);
        #stack[int, 64] tp = cssc::peek64(h + 24);
        #stack[int, 64] i = 0;
        while (i < size) {
            #stack[int, 64] pt = cssc::peek32(tp + i * 8);
            if (pt == 1) {
                #stack[int, 64] ev = cssc::peek64(d + i * 8);
                if (ev != 0) { cssc::free(ev); }
                #delete[ev];
            }
            #delete[pt];
            i = i + 1;
        }
        #delete[i];
        #delete[tp];
        #delete[d];
        #delete[size];
    }
    cssc::poke32(h + 4, 0);
    #delete[et];
}
#define(ciVecFree) {
    #scanp(ciVecFree, int, 0) h;
    #req[ciVecClear] ciVecClear;
    ciVecClear(h);
    #stack[int, 64] d = cssc::peek64(h + 16);
    cssc::free(d);
    #stack[int, 64] et = cssc::peek32(h + 12);
    if (et == 8) {
        #stack[int, 64] tp = cssc::peek64(h + 24);
        if (tp != 0) { cssc::free(tp); }
        #delete[tp];
    }
    #delete[et];
    cssc::free(h);
    #delete[d];
}

// ---- string expression-method helpers (root cause #3) ------------------------
// A CSSC string value is a heap ptr to {i32 rc@0, i32 size@4, bytes@8}. These
// build/inspect strings for the `.method()` dispatch in ciExpr (see ciStrMethod).
// Every helper that returns a NEW string returns an OWNED allocation (rc=1) so
// the caller marks leftOwns=1; scope-exit/#delete then reclaims it (no leak).

// index of first occurrence of `needle` in `hay` (both string ptrs), or -1.
// empty needle -> 0.
#define(ciStrIndexOf) {
    #scanp(ciStrIndexOf, int, 0) hay;
    #scanp(ciStrIndexOf, int, 1) needle;
    #stack[int, 64] hl = cssc::peek32(hay + 4);
    #stack[int, 64] nl = cssc::peek32(needle + 4);
    #stack[int, 64] res = 0 - 1;
    if (nl == 0) { res = 0; }
    if (nl != 0) {
        #stack[int, 64] i = 0;
        #stack[int, 32] go = 1;
        while (go == 1) {
            if (i + nl > hl) { go = 0; }
            if (go == 1) {
                #stack[int, 64] j = 0;
                #stack[int, 32] m = 1;
                while (j < nl) {
                    if (cssc::peek8(hay + 8 + i + j) != cssc::peek8(needle + 8 + j)) { m = 0; j = nl; }
                    if (m == 1) { j = j + 1; }
                }
                if (m == 1) { res = i; go = 0; }
                #delete[j];
                #delete[m];
            }
            if (go == 1) { i = i + 1; }
        }
        #delete[i];
        #delete[go];
    }
    #delete[hl];
    #delete[nl];
    return res;
}

// ASCII case flip -> new owned string. toUpper=1 upper-cases, 0 lower-cases.
#define(ciStrCaseNew) {
    #scanp(ciStrCaseNew, int, 0) sp;
    #scanp(ciStrCaseNew, int, 1) toUpper;
    #req[ciStrNew] ciStrNew;
    #stack[int, 64] n = cssc::peek32(sp + 4);
    #stack[int, 64] buf = cssc::alloc(n + 1);
    #stack[int, 64] i = 0;
    while (i < n) {
        #stack[int, 64] c = cssc::peek8(sp + 8 + i);
        if (toUpper == 1) { if (c >= 97) { if (c <= 122) { c = c - 32; } } }
        if (toUpper == 0) { if (c >= 65) { if (c <= 90) { c = c + 32; } } }
        cssc::poke8(buf + i, c);
        #delete[c];
        i = i + 1;
    }
    ciStrNew(buf, n) r;
    cssc::free(buf);
    #delete[i];
    #delete[n];
    #delete[buf];
    return r;
}

// strip leading+trailing ASCII whitespace (space/tab/LF/CR) -> new owned string.
#define(ciStrTrimNew) {
    #scanp(ciStrTrimNew, int, 0) sp;
    #req[ciStrNew] ciStrNew;
    #stack[int, 64] n = cssc::peek32(sp + 4);
    #stack[int, 64] a = 0;
    #stack[int, 64] b = n;
    #stack[int, 32] g1 = 1;
    while (g1 == 1) {
        if (a >= b) { g1 = 0; }
        if (g1 == 1) {
            #stack[int, 64] c = cssc::peek8(sp + 8 + a);
            #stack[int, 32] ws = 0;
            if (c == 32) { ws = 1; }
            if (c == 9) { ws = 1; }
            if (c == 10) { ws = 1; }
            if (c == 13) { ws = 1; }
            if (ws == 0) { g1 = 0; }
            if (ws == 1) { a = a + 1; }
            #delete[c];
            #delete[ws];
        }
    }
    #delete[g1];
    #stack[int, 32] g2 = 1;
    while (g2 == 1) {
        if (b <= a) { g2 = 0; }
        if (g2 == 1) {
            #stack[int, 64] c = cssc::peek8(sp + 8 + b - 1);
            #stack[int, 32] ws = 0;
            if (c == 32) { ws = 1; }
            if (c == 9) { ws = 1; }
            if (c == 10) { ws = 1; }
            if (c == 13) { ws = 1; }
            if (ws == 0) { g2 = 0; }
            if (ws == 1) { b = b - 1; }
            #delete[c];
            #delete[ws];
        }
    }
    #delete[g2];
    ciStrNew(sp + 8 + a, b - a) r;
    #delete[n];
    #delete[a];
    #delete[b];
    return r;
}

// reversed copy -> new owned string.
#define(ciStrRevNew) {
    #scanp(ciStrRevNew, int, 0) sp;
    #req[ciStrNew] ciStrNew;
    #stack[int, 64] n = cssc::peek32(sp + 4);
    #stack[int, 64] buf = cssc::alloc(n + 1);
    #stack[int, 64] i = 0;
    while (i < n) {
        cssc::poke8(buf + i, cssc::peek8(sp + 8 + n - 1 - i));
        i = i + 1;
    }
    ciStrNew(buf, n) r;
    cssc::free(buf);
    #delete[i];
    #delete[n];
    #delete[buf];
    return r;
}

// `cnt` concatenated copies -> new owned string (cnt<=0 -> empty).
#define(ciStrRepeatNew) {
    #scanp(ciStrRepeatNew, int, 0) sp;
    #scanp(ciStrRepeatNew, int, 1) cnt;
    #req[ciStrNew] ciStrNew;
    #stack[int, 64] n = cssc::peek32(sp + 4);
    #stack[int, 64] c = cnt;
    if (c < 0) { c = 0; }
    #stack[int, 64] total = n * c;
    #stack[int, 64] buf = cssc::alloc(total + 1);
    #stack[int, 64] k = 0;
    #stack[int, 64] off = 0;
    while (k < c) {
        #stack[int, 64] j = 0;
        while (j < n) {
            cssc::poke8(buf + off, cssc::peek8(sp + 8 + j));
            off = off + 1;
            j = j + 1;
        }
        #delete[j];
        k = k + 1;
    }
    ciStrNew(buf, total) r;
    cssc::free(buf);
    #delete[k];
    #delete[off];
    #delete[n];
    #delete[c];
    #delete[total];
    #delete[buf];
    return r;
}

// chars [start, start+len) (clamped to bounds) -> new owned string.
#define(ciStrSubNew) {
    #scanp(ciStrSubNew, int, 0) sp;
    #scanp(ciStrSubNew, int, 1) start;
    #scanp(ciStrSubNew, int, 2) len;
    #req[ciStrNew] ciStrNew;
    #stack[int, 64] n = cssc::peek32(sp + 4);
    #stack[int, 64] s = start;
    #stack[int, 64] l = len;
    if (s < 0) { s = 0; }
    if (s > n) { s = n; }
    if (l < 0) { l = 0; }
    if (s + l > n) { l = n - s; }
    ciStrNew(sp + 8 + s, l) r;
    #delete[n];
    #delete[s];
    #delete[l];
    return r;
}

// replace ALL occurrences of `oldp` with `newp` -> new owned string.
#define(ciStrReplaceNew) {
    #scanp(ciStrReplaceNew, int, 0) sp;
    #scanp(ciStrReplaceNew, int, 1) oldp;
    #scanp(ciStrReplaceNew, int, 2) newp;
    #req[ciStrNew] ciStrNew;
    #req[ciStrClone] ciStrClone;
    #stack[int, 64] hn = cssc::peek32(sp + 4);
    #stack[int, 64] on = cssc::peek32(oldp + 4);
    #stack[int, 64] nn = cssc::peek32(newp + 4);
    #stack[int, 64] r = 0;
    if (on == 0) {
        ciStrClone(sp) c;
        r = c;
        #delete[c];
    }
    if (on != 0) {
        #stack[int, 64] cnt = 0;
        #stack[int, 64] i = 0;
        while (i + on <= hn) {
            #stack[int, 64] j = 0;
            #stack[int, 32] m = 1;
            while (j < on) {
                if (cssc::peek8(sp + 8 + i + j) != cssc::peek8(oldp + 8 + j)) { m = 0; j = on; }
                if (m == 1) { j = j + 1; }
            }
            #delete[j];
            if (m == 1) { cnt = cnt + 1; i = i + on; }
            if (m == 0) { i = i + 1; }
            #delete[m];
        }
        #delete[i];
        #stack[int, 64] total = hn + cnt * (nn - on);
        #stack[int, 64] buf = cssc::alloc(total + 1);
        #stack[int, 64] w = 0;
        #stack[int, 64] p = 0;
        while (p < hn) {
            #stack[int, 32] m2 = 0;
            if (p + on <= hn) {
                m2 = 1;
                #stack[int, 64] j2 = 0;
                while (j2 < on) {
                    if (cssc::peek8(sp + 8 + p + j2) != cssc::peek8(oldp + 8 + j2)) { m2 = 0; j2 = on; }
                    if (m2 == 1) { j2 = j2 + 1; }
                }
                #delete[j2];
            }
            if (m2 == 1) {
                #stack[int, 64] k = 0;
                while (k < nn) { cssc::poke8(buf + w, cssc::peek8(newp + 8 + k)); w = w + 1; k = k + 1; }
                #delete[k];
                p = p + on;
            }
            if (m2 == 0) {
                cssc::poke8(buf + w, cssc::peek8(sp + 8 + p));
                w = w + 1;
                p = p + 1;
            }
            #delete[m2];
        }
        #delete[p];
        ciStrNew(buf, total) rr;
        r = rr;
        cssc::free(buf);
        #delete[rr];
        #delete[w];
        #delete[total];
        #delete[buf];
        #delete[cnt];
    }
    #delete[hn];
    #delete[on];
    #delete[nn];
    return r;
}

// split `sp` on separator `sepp` -> a fresh owned vector<string> (elem type 1).
// A sep not present (or empty sep) yields a size-1 vector holding the whole string.
#define(ciStrSplitVec) {
    #scanp(ciStrSplitVec, int, 0) sp;
    #scanp(ciStrSplitVec, int, 1) sepp;
    #req[ciVecNew] ciVecNew;
    #req[ciVecPush] ciVecPush;
    #req[ciStrNew] ciStrNew;
    ciVecNew(1) newv;
    #stack[int, 64] vh = newv;
    #delete[newv];
    #stack[int, 64] hn = cssc::peek32(sp + 4);
    #stack[int, 64] sn = cssc::peek32(sepp + 4);
    if (sn == 0) {
        ciStrNew(sp + 8, hn) whole;
        ciVecPush(vh, whole, 1);
        cssc::free(whole);
        #delete[whole];
    }
    if (sn != 0) {
        #stack[int, 64] start = 0;
        #stack[int, 64] i = 0;
        while (i + sn <= hn) {
            #stack[int, 32] m = 1;
            #stack[int, 64] j = 0;
            while (j < sn) {
                if (cssc::peek8(sp + 8 + i + j) != cssc::peek8(sepp + 8 + j)) { m = 0; j = sn; }
                if (m == 1) { j = j + 1; }
            }
            #delete[j];
            if (m == 1) {
                ciStrNew(sp + 8 + start, i - start) piece;
                ciVecPush(vh, piece, 1);
                cssc::free(piece);
                #delete[piece];
                i = i + sn;
                start = i;
            }
            if (m == 0) { i = i + 1; }
            #delete[m];
        }
        ciStrNew(sp + 8 + start, hn - start) tail;
        ciVecPush(vh, tail, 1);
        cssc::free(tail);
        #delete[tail];
        #delete[start];
        #delete[i];
    }
    #delete[hn];
    #delete[sn];
    return vh;
}

// pad `sp` to TOTAL length `target` with 1-char string `chp` -> new owned string.
// atStart=1 -> padStart (pad on the left); 0 -> padEnd. If already >= target, clone.
#define(ciStrPadNew) {
    #scanp(ciStrPadNew, int, 0) sp;
    #scanp(ciStrPadNew, int, 1) target;
    #scanp(ciStrPadNew, int, 2) chp;
    #scanp(ciStrPadNew, int, 3) atStart;
    #req[ciStrNew] ciStrNew;
    #req[ciStrClone] ciStrClone;
    #stack[int, 64] n = cssc::peek32(sp + 4);
    #stack[int, 64] r = 0;
    if (target <= n) {
        ciStrClone(sp) c;
        r = c;
        #delete[c];
    }
    if (target > n) {
        #stack[int, 64] padcount = target - n;
        // the pad-char arg is optional: padStart(width) passes chp=0. Reading
        // peek32(0+4) would fault -> default to space (32) when absent.
        #stack[int, 64] cn = 0;
        if (chp != 0) { cn = cssc::peek32(chp + 4); }
        #stack[int, 64] padchar = 32;
        if (cn > 0) { padchar = cssc::peek8(chp + 8); }
        #stack[int, 64] buf = cssc::alloc(target + 1);
        #stack[int, 64] w = 0;
        if (atStart == 1) {
            #stack[int, 64] k = 0;
            while (k < padcount) { cssc::poke8(buf + w, padchar); w = w + 1; k = k + 1; }
            #delete[k];
            #stack[int, 64] j = 0;
            while (j < n) { cssc::poke8(buf + w, cssc::peek8(sp + 8 + j)); w = w + 1; j = j + 1; }
            #delete[j];
        }
        if (atStart == 0) {
            #stack[int, 64] j = 0;
            while (j < n) { cssc::poke8(buf + w, cssc::peek8(sp + 8 + j)); w = w + 1; j = j + 1; }
            #delete[j];
            #stack[int, 64] k = 0;
            while (k < padcount) { cssc::poke8(buf + w, padchar); w = w + 1; k = k + 1; }
            #delete[k];
        }
        ciStrNew(buf, target) rr;
        r = rr;
        cssc::free(buf);
        #delete[rr];
        #delete[w];
        #delete[buf];
        #delete[padcount];
        #delete[cn];
        #delete[padchar];
    }
    #delete[n];
    return r;
}

// parse a leading (optionally signed) decimal integer; non-numeric -> 0.
#define(ciStrToIntV) {
    #scanp(ciStrToIntV, int, 0) sp;
    #stack[int, 64] n = cssc::peek32(sp + 4);
    #stack[int, 64] i = 0;
    #stack[int, 64] sign = 1;
    #stack[int, 64] v = 0;
    if (n > 0) {
        #stack[int, 64] c0 = cssc::peek8(sp + 8);
        if (c0 == 45) { sign = 0 - 1; i = 1; }
        if (c0 == 43) { i = 1; }
        #delete[c0];
    }
    #stack[int, 32] go = 1;
    while (go == 1) {
        if (i >= n) { go = 0; }
        if (go == 1) {
            #stack[int, 64] c = cssc::peek8(sp + 8 + i);
            if (c < 48) { go = 0; }
            if (c > 57) { go = 0; }
            if (go == 1) { v = v * 10 + (c - 48); i = i + 1; }
            #delete[c];
        }
    }
    #delete[go];
    #stack[int, 64] r = v * sign;
    #delete[n];
    #delete[i];
    #delete[sign];
    #delete[v];
    return r;
}

// bool: non-empty AND every char is a digit 0-9.
#define(ciStrIsDigit) {
    #scanp(ciStrIsDigit, int, 0) sp;
    #stack[int, 64] n = cssc::peek32(sp + 4);
    #stack[int, 32] r = 1;
    if (n == 0) { r = 0; }
    #stack[int, 64] i = 0;
    while (i < n) {
        #stack[int, 64] c = cssc::peek8(sp + 8 + i);
        if (c < 48) { r = 0; }
        if (c > 57) { r = 0; }
        #delete[c];
        i = i + 1;
    }
    #delete[i];
    #delete[n];
    return r;
}

// bool: non-empty AND every char is a-z / A-Z.
#define(ciStrIsAlpha) {
    #scanp(ciStrIsAlpha, int, 0) sp;
    #stack[int, 64] n = cssc::peek32(sp + 4);
    #stack[int, 32] r = 1;
    if (n == 0) { r = 0; }
    #stack[int, 64] i = 0;
    while (i < n) {
        #stack[int, 64] c = cssc::peek8(sp + 8 + i);
        #stack[int, 32] ok = 0;
        if (c >= 65) { if (c <= 90) { ok = 1; } }
        if (c >= 97) { if (c <= 122) { ok = 1; } }
        if (ok == 0) { r = 0; }
        #delete[ok];
        #delete[c];
        i = i + 1;
    }
    #delete[i];
    #delete[n];
    return r;
}

// first index of value `x` (type `xt`) in vector `h`, or -1. String elements are
// content-compared (ciStrCmp); everything else by value. Used by vector
// .contains/.indexOf.
#define(ciVecIndexOf) {
    #scanp(ciVecIndexOf, int, 0) h;
    #scanp(ciVecIndexOf, int, 1) x;
    #scanp(ciVecIndexOf, int, 2) xt;
    #req[ciStrCmp] ciStrCmp;
    #stack[int, 64] size = cssc::peek32(h + 4);
    #stack[int, 64] et = cssc::peek32(h + 12);
    #stack[int, 64] data = cssc::peek64(h + 16);
    #stack[int, 64] res = 0 - 1;
    #stack[int, 64] i = 0;
    #stack[int, 32] go = 1;
    while (go == 1) {
        if (i >= size) { go = 0; }
        if (go == 1) {
            #stack[int, 64] ev = cssc::peek64(data + i * 8);
            #stack[int, 32] eq = 0;
            if (et == 1) {
                if (xt == 1) { ciStrCmp(ev, x) c; if (c == 0) { eq = 1; } #delete[c]; }
            }
            if (et != 1) {
                if (ev == x) { eq = 1; }
            }
            if (eq == 1) { res = i; go = 0; }
            #delete[ev];
            #delete[eq];
        }
        if (go == 1) { i = i + 1; }
    }
    #delete[size];
    #delete[et];
    #delete[data];
    #delete[i];
    #delete[go];
    return res;
}

// ---- vector producers + queries (batch: slice/flat/unique/join/count/
// notAtIndex). Producers return a FRESH owned vector (rc=1, same discipline as
// ciStrSplitVec): the caller marks leftOwns=1 so scope-exit reclaims it. ----
#define(ciVecSlice) {
    #scanp(ciVecSlice, int, 0) h;
    #scanp(ciVecSlice, int, 1) a;
    #scanp(ciVecSlice, int, 2) b;
    #req[ciVecNew] ciVecNew;
    #req[ciVecPush] ciVecPush;
    #stack[int, 64] size = cssc::peek32(h + 4);
    #stack[int, 64] et = cssc::peek32(h + 12);
    #stack[int, 64] sa = a;
    #stack[int, 64] sb = b;
    if (sa < 0) { sa = 0; }
    if (sa > size) { sa = size; }
    if (sb < 0) { sb = 0; }
    if (sb > size) { sb = size; }
    if (sb < sa) { sb = sa; }
    #stack[int, 64] nv = 0;
    ciVecNew(et) t;
    nv = t;
    #delete[t];
    #stack[int, 64] d = cssc::peek64(h + 16);
    #stack[int, 64] i = sa;
    while (i < sb) {
        #stack[int, 64] ev = cssc::peek64(d + i * 8);
        ciVecPush(nv, ev, et);
        #delete[ev];
        i = i + 1;
    }
    #delete[i];
    #delete[d];
    #delete[sa];
    #delete[sb];
    #delete[size];
    #delete[et];
    return nv;
}
#define(ciVecUnique) {
    #scanp(ciVecUnique, int, 0) h;
    #req[ciVecNew] ciVecNew;
    #req[ciVecPush] ciVecPush;
    #req[ciVecIndexOf] ciVecIndexOf;
    #stack[int, 64] size = cssc::peek32(h + 4);
    #stack[int, 64] et = cssc::peek32(h + 12);
    #stack[int, 64] nv = 0;
    ciVecNew(et) t;
    nv = t;
    #delete[t];
    #stack[int, 64] d = cssc::peek64(h + 16);
    #stack[int, 64] i = 0;
    while (i < size) {
        #stack[int, 64] ev = cssc::peek64(d + i * 8);
        ciVecIndexOf(nv, ev, et) ix;
        if (ix < 0) { ciVecPush(nv, ev, et); }
        #delete[ix];
        #delete[ev];
        i = i + 1;
    }
    #delete[i];
    #delete[d];
    #delete[size];
    #delete[et];
    return nv;
}
#define(ciVecFlat) {
    #scanp(ciVecFlat, int, 0) h;
    #req[ciVecNew] ciVecNew;
    #req[ciVecPush] ciVecPush;
    #stack[int, 64] size = cssc::peek32(h + 4);
    #stack[int, 64] et = cssc::peek32(h + 12);
    #stack[int, 64] d = cssc::peek64(h + 16);
    #stack[int, 64] nv = 0;
    #stack[int, 64] i = 0;
    if (et != 4) {
        ciVecNew(et) t;
        nv = t;
        #delete[t];
        while (i < size) {
            #stack[int, 64] ev = cssc::peek64(d + i * 8);
            ciVecPush(nv, ev, et);
            #delete[ev];
            i = i + 1;
        }
    }
    if (et == 4) {
        #stack[int, 64] iet = 0;
        if (size > 0) {
            #stack[int, 64] e0 = cssc::peek64(d);
            if (e0 != 0) { iet = cssc::peek32(e0 + 12); }
            #delete[e0];
        }
        ciVecNew(iet) t2;
        nv = t2;
        #delete[t2];
        while (i < size) {
            #stack[int, 64] sub = cssc::peek64(d + i * 8);
            if (sub != 0) {
                #stack[int, 64] ss = cssc::peek32(sub + 4);
                #stack[int, 64] sd = cssc::peek64(sub + 16);
                #stack[int, 64] j = 0;
                while (j < ss) {
                    #stack[int, 64] iv2 = cssc::peek64(sd + j * 8);
                    ciVecPush(nv, iv2, iet);
                    #delete[iv2];
                    j = j + 1;
                }
                #delete[j];
                #delete[sd];
                #delete[ss];
            }
            #delete[sub];
            i = i + 1;
        }
        #delete[iet];
    }
    #delete[i];
    #delete[d];
    #delete[size];
    #delete[et];
    return nv;
}
#define(ciVecJoin) {
    #scanp(ciVecJoin, int, 0) h;
    #scanp(ciVecJoin, int, 1) sep;
    #req[ciStrClone] ciStrClone;
    #req[ciStrConcat] ciStrConcat;
    #req[ciStrNew] ciStrNew;
    #stack[int, 64] size = cssc::peek32(h + 4);
    #stack[int, 64] et = cssc::peek32(h + 12);
    #stack[int, 64] d = cssc::peek64(h + 16);
    #stack[int, 64] usesep = sep;
    #stack[int, 32] madesep = 0;
    if (sep == 0) {
        #stack[int, 64] cb = cssc::alloc(1);
        cssc::poke8(cb, 44);
        ciStrNew(cb, 1) cs;
        usesep = cs;
        madesep = 1;
        cssc::free(cb);
        #delete[cs];
        #delete[cb];
    }
    #stack[int, 64] acc = 0;
    ciStrClone(0) acc0;
    acc = acc0;
    #delete[acc0];
    #stack[int, 64] i = 0;
    while (i < size) {
        if (i > 0) {
            ciStrConcat(acc, 1, usesep, 1) t1;
            cssc::free(acc);
            acc = t1;
            #delete[t1];
        }
        #stack[int, 64] ev = cssc::peek64(d + i * 8);
        ciStrConcat(acc, 1, ev, et) t2;
        cssc::free(acc);
        acc = t2;
        #delete[ev];
        #delete[t2];
        i = i + 1;
    }
    if (madesep == 1) { cssc::free(usesep); }
    #delete[usesep];
    #delete[madesep];
    #delete[i];
    #delete[d];
    #delete[et];
    #delete[size];
    return acc;
}
#define(ciVecCount) {
    #scanp(ciVecCount, int, 0) h;
    #scanp(ciVecCount, int, 1) x;
    #scanp(ciVecCount, int, 2) xt;
    #req[ciStrCmp] ciStrCmp;
    #stack[int, 64] size = cssc::peek32(h + 4);
    #stack[int, 64] et = cssc::peek32(h + 12);
    #stack[int, 64] d = cssc::peek64(h + 16);
    #stack[int, 64] c = 0;
    #stack[int, 64] i = 0;
    while (i < size) {
        #stack[int, 64] ev = cssc::peek64(d + i * 8);
        #stack[int, 32] eq = 0;
        if (et == 1) {
            if (xt == 1) { ciStrCmp(ev, x) cc; if (cc == 0) { eq = 1; } #delete[cc]; }
        }
        if (et != 1) {
            if (ev == x) { eq = 1; }
        }
        if (eq == 1) { c = c + 1; }
        #delete[eq];
        #delete[ev];
        i = i + 1;
    }
    #delete[i];
    #delete[d];
    #delete[et];
    #delete[size];
    return c;
}
#define(ciVecNotAtIndex) {
    #scanp(ciVecNotAtIndex, int, 0) h;
    #scanp(ciVecNotAtIndex, int, 1) i;
    #scanp(ciVecNotAtIndex, int, 2) t;
    #stack[int, 64] size = cssc::peek32(h + 4);
    #stack[int, 64] r = 1;
    if (i >= 0) {
        if (i < size) {
            r = 0;
            #stack[int, 64] et = cssc::peek32(h + 12);
            #stack[int, 64] exp = 0 - 2;
            if (t != 0) {
                #stack[int, 64] ts = cssc::peek32(t + 4);
                #stack[int, 64] c0 = 0;
                if (ts > 0) { c0 = cssc::peek8(t + 8); }
                if (ts == 3) { if (c0 == 105) { exp = 0; } if (c0 == 109) { exp = 5; } }
                if (ts == 4) { if (c0 == 98) { exp = 9; } }
                if (ts == 5) { if (c0 == 102) { exp = 2; } if (c0 == 97) { exp = 4; } }
                if (ts == 6) { if (c0 == 115) { exp = 1; } }
                #delete[ts];
                #delete[c0];
            }
            if (exp != 0 - 2) {
                if (et != exp) { r = 1; }
            }
            #delete[exp];
            #delete[et];
        }
    }
    #delete[size];
    return r;
}

// ---- vector in-place mutators (batch: insert/remove/erase/takeout/sort/
// reverse/resize/swap). Modeled on ciVecPopFront ownership discipline. ----

// insert value `x` (type `xt`) at index `i` (clamped to [0,size]); elements at
// [i..size) shift up one. Reuses ciVecPush for growth + string clone/format, then
// rotates the freshly-appended element down into slot i. push_front = i 0.
#define(ciVecInsert) {
    #scanp(ciVecInsert, int, 0) h;
    #scanp(ciVecInsert, int, 1) i;
    #scanp(ciVecInsert, int, 2) x;
    #scanp(ciVecInsert, int, 3) xt;
    #req[ciVecPush] ciVecPush;
    #stack[int, 64] size = cssc::peek32(h + 4);
    #stack[int, 64] idx = i;
    if (idx < 0) { idx = 0; }
    if (idx > size) { idx = size; }
    ciVecPush(h, x, xt);
    #stack[int, 64] d = cssc::peek64(h + 16);
    #stack[int, 64] nv = cssc::peek64(d + size * 8);
    #stack[int, 64] j = size;
    while (j > idx) {
        cssc::poke64(d + j * 8, cssc::peek64(d + (j - 1) * 8));
        j = j - 1;
    }
    cssc::poke64(d + idx * 8, nv);
    #delete[j];
    #delete[nv];
    #delete[d];
    #delete[idx];
    #delete[size];
}
// remove element at index `i`, shifting the rest down; frees an owned string
// slot. Out of range -> no-op (this interp does not raise).
#define(ciVecEraseAt) {
    #scanp(ciVecEraseAt, int, 0) h;
    #scanp(ciVecEraseAt, int, 1) i;
    #stack[int, 64] size = cssc::peek32(h + 4);
    if (i >= 0) {
        if (i < size) {
            #stack[int, 64] et = cssc::peek32(h + 12);
            #stack[int, 64] d = cssc::peek64(h + 16);
            if (et == 1) {
                #stack[int, 64] old = cssc::peek64(d + i * 8);
                if (old != 0) { cssc::free(old); }
                #delete[old];
            }
            #stack[int, 64] j = i;
            while (j < size - 1) {
                cssc::poke64(d + j * 8, cssc::peek64(d + (j + 1) * 8));
                j = j + 1;
            }
            cssc::poke32(h + 4, size - 1);
            #delete[j];
            #delete[d];
            #delete[et];
        }
    }
    #delete[size];
}
// remove + return element at index `i`, shifting the rest down. Ownership
// transfers to the caller (NO clone), exactly like ciVecPopFront. OOB -> 0.
#define(ciVecTakeout) {
    #scanp(ciVecTakeout, int, 0) h;
    #scanp(ciVecTakeout, int, 1) i;
    #req[ciVecPopType] ciVecPopType;
    #stack[int, 64] size = cssc::peek32(h + 4);
    #stack[int, 64] et = cssc::peek32(h + 12);
    #stack[int, 64] r = 0;
    ciVecPopType = et;
    if (i >= 0) {
        if (i < size) {
            #stack[int, 64] d = cssc::peek64(h + 16);
            r = cssc::peek64(d + i * 8);
            #stack[int, 64] tp = 0;
            if (et == 8) {
                tp = cssc::peek64(h + 24);
                ciVecPopType = cssc::peek32(tp + i * 8);
            }
            #stack[int, 64] j = i;
            while (j < size - 1) {
                cssc::poke64(d + j * 8, cssc::peek64(d + (j + 1) * 8));
                if (et == 8) {
                    cssc::poke32(tp + j * 8, cssc::peek32(tp + (j + 1) * 8));
                }
                j = j + 1;
            }
            cssc::poke32(h + 4, size - 1);
            #delete[j];
            #delete[tp];
            #delete[d];
        }
    }
    #delete[size];
    #delete[et];
    return r;
}
// remove first element equal to value `x` (type `xt`); string elements are
// content-compared (via ciVecIndexOf). Returns 1 if removed, 0 if absent (this
// interp does not raise on absence).
#define(ciVecRemoveVal) {
    #scanp(ciVecRemoveVal, int, 0) h;
    #scanp(ciVecRemoveVal, int, 1) x;
    #scanp(ciVecRemoveVal, int, 2) xt;
    #req[ciVecIndexOf] ciVecIndexOf;
    #req[ciVecEraseAt] ciVecEraseAt;
    ciVecIndexOf(h, x, xt) ix;
    #stack[int, 64] found = 0;
    if (ix >= 0) { ciVecEraseAt(h, ix); found = 1; }
    #delete[ix];
    return found;
}
// reverse the vector in place (swap slots; no clone/free -- just moves pointers).
#define(ciVecReverse) {
    #scanp(ciVecReverse, int, 0) h;
    #stack[int, 64] size = cssc::peek32(h + 4);
    #stack[int, 64] d = cssc::peek64(h + 16);
    #stack[int, 64] i = 0;
    #stack[int, 64] jj = size - 1;
    while (i < jj) {
        #stack[int, 64] a = cssc::peek64(d + i * 8);
        #stack[int, 64] b = cssc::peek64(d + jj * 8);
        cssc::poke64(d + i * 8, b);
        cssc::poke64(d + jj * 8, a);
        #delete[a];
        #delete[b];
        i = i + 1;
        jj = jj - 1;
    }
    #delete[i];
    #delete[jj];
    #delete[d];
    #delete[size];
}
// ascending in-place insertion sort. String elements compared by content
// (ciStrCmp); everything else by SIGNED value (correct for int, incl. negatives).
// Stable (moves only on strict-greater). Float/object element ordering is by raw
// bits (not numeric) -- int/string are the supported element kinds.
#define(ciVecSort) {
    #scanp(ciVecSort, int, 0) h;
    #req[ciStrCmp] ciStrCmp;
    #stack[int, 64] size = cssc::peek32(h + 4);
    #stack[int, 64] et = cssc::peek32(h + 12);
    #stack[int, 64] d = cssc::peek64(h + 16);
    #stack[int, 64] i = 1;
    while (i < size) {
        #stack[int, 64] cur = cssc::peek64(d + i * 8);
        #stack[int, 64] j = i - 1;
        #stack[int, 32] go = 1;
        while (go == 1) {
            if (j < 0) { go = 0; }
            if (go == 1) {
                #stack[int, 64] pv = cssc::peek64(d + j * 8);
                #stack[int, 32] gt = 0;
                if (et == 1) {
                    ciStrCmp(pv, cur) c;
                    if (c > 0) { gt = 1; }
                    #delete[c];
                }
                if (et != 1) {
                    if (pv > cur) { gt = 1; }
                }
                if (gt == 1) {
                    cssc::poke64(d + (j + 1) * 8, pv);
                    j = j - 1;
                }
                if (gt == 0) { go = 0; }
                #delete[pv];
                #delete[gt];
            }
        }
        cssc::poke64(d + (j + 1) * 8, cur);
        #delete[cur];
        #delete[j];
        #delete[go];
        i = i + 1;
    }
    #delete[i];
    #delete[d];
    #delete[et];
    #delete[size];
}
// resize to exactly `n` elements. Shrink frees dropped owned-string slots; grow
// fills new slots with int 0 (the host vector is homogeneous, so a grown slot
// formats as `0` via elemType -- the reference prints a null `0x0` instead).
#define(ciVecResize) {
    #scanp(ciVecResize, int, 0) h;
    #scanp(ciVecResize, int, 1) n;
    #stack[int, 64] size = cssc::peek32(h + 4);
    #stack[int, 64] et = cssc::peek32(h + 12);
    #stack[int, 64] nn = n;
    if (nn < 0) { nn = 0; }
    if (nn < size) {
        if (et == 1) {
            #stack[int, 64] d0 = cssc::peek64(h + 16);
            #stack[int, 64] k = nn;
            while (k < size) {
                #stack[int, 64] ev = cssc::peek64(d0 + k * 8);
                if (ev != 0) { cssc::free(ev); }
                #delete[ev];
                k = k + 1;
            }
            #delete[k];
            #delete[d0];
        }
        cssc::poke32(h + 4, nn);
    }
    if (nn > size) {
        #stack[int, 64] cap = cssc::peek32(h + 8);
        if (nn > cap) {
            #stack[int, 64] ncap = cap;
            while (ncap < nn) { ncap = ncap * 2; }
            #stack[int, 64] nd = cssc::alloc(ncap * 8);
            #stack[int, 64] od = cssc::peek64(h + 16);
            cssc::memcopy(nd, od, size * 2);
            cssc::free(od);
            cssc::poke64(h + 16, nd);
            cssc::poke32(h + 8, ncap);
            #delete[od];
            #delete[nd];
            #delete[ncap];
        }
        #stack[int, 64] d = cssc::peek64(h + 16);
        #stack[int, 64] k = size;
        while (k < nn) {
            cssc::poke64(d + k * 8, 0);
            k = k + 1;
        }
        cssc::poke32(h + 4, nn);
        #delete[k];
        #delete[d];
        #delete[cap];
    }
    #delete[nn];
    #delete[et];
    #delete[size];
}
// swap the CONTENTS of two vectors by exchanging their header fields
// (size/cap/elemType/data). Self-swap (a==b) is a safe no-op (fields snapshot
// into locals first). Each variable keeps its own handle identity.
#define(ciVecSwap) {
    #scanp(ciVecSwap, int, 0) a;
    #scanp(ciVecSwap, int, 1) b;
    #stack[int, 64] asz = cssc::peek32(a + 4);
    #stack[int, 64] acp = cssc::peek32(a + 8);
    #stack[int, 64] aet = cssc::peek32(a + 12);
    #stack[int, 64] ad = cssc::peek64(a + 16);
    #stack[int, 64] bsz = cssc::peek32(b + 4);
    #stack[int, 64] bcp = cssc::peek32(b + 8);
    #stack[int, 64] bet = cssc::peek32(b + 12);
    #stack[int, 64] bd = cssc::peek64(b + 16);
    cssc::poke32(a + 4, bsz);
    cssc::poke32(a + 8, bcp);
    cssc::poke32(a + 12, bet);
    cssc::poke64(a + 16, bd);
    cssc::poke32(b + 4, asz);
    cssc::poke32(b + 8, acp);
    cssc::poke32(b + 12, aet);
    cssc::poke64(b + 16, ad);
    #delete[asz];
    #delete[acp];
    #delete[aet];
    #delete[ad];
    #delete[bsz];
    #delete[bcp];
    #delete[bet];
    #delete[bd];
}

// STRING expression-method dispatcher: receiver ptr `sp`, method-name span mo/ml.
// Parses the argument list `( .. )` from the live token stream, dispatches, and
// sets ciEvalType (result type: 0 int / 1 string / 2 float / 4 vector / 9 bool)
// and ciEvalOwns (1 if the returned value is a fresh owned allocation). Returns
// the result value. bool results use tag 9 so outln prints true/false (int
// comparisons stay tag 0 -> 1/0, preserving run.py's floatcmp golden).
// strip LEADING ASCII whitespace only -> new owned string.
#define(ciStrLTrimNew) {
    #scanp(ciStrLTrimNew, int, 0) sp;
    #req[ciStrNew] ciStrNew;
    #stack[int, 64] n = cssc::peek32(sp + 4);
    #stack[int, 64] a = 0;
    #stack[int, 32] g1 = 1;
    while (g1 == 1) {
        if (a >= n) { g1 = 0; }
        if (g1 == 1) {
            #stack[int, 64] c = cssc::peek8(sp + 8 + a);
            #stack[int, 32] ws = 0;
            if (c == 32) { ws = 1; }
            if (c == 9) { ws = 1; }
            if (c == 10) { ws = 1; }
            if (c == 13) { ws = 1; }
            if (ws == 0) { g1 = 0; }
            if (ws == 1) { a = a + 1; }
            #delete[c]; #delete[ws];
        }
    }
    #delete[g1];
    ciStrNew(sp + 8 + a, n - a) r;
    #delete[n]; #delete[a];
    return r;
}
// strip TRAILING ASCII whitespace only -> new owned string.
#define(ciStrRTrimNew) {
    #scanp(ciStrRTrimNew, int, 0) sp;
    #req[ciStrNew] ciStrNew;
    #stack[int, 64] n = cssc::peek32(sp + 4);
    #stack[int, 64] b = n;
    #stack[int, 32] g2 = 1;
    while (g2 == 1) {
        if (b <= 0) { g2 = 0; }
        if (g2 == 1) {
            #stack[int, 64] c = cssc::peek8(sp + 8 + b - 1);
            #stack[int, 32] ws = 0;
            if (c == 32) { ws = 1; }
            if (c == 9) { ws = 1; }
            if (c == 10) { ws = 1; }
            if (c == 13) { ws = 1; }
            if (ws == 0) { g2 = 0; }
            if (ws == 1) { b = b - 1; }
            #delete[c]; #delete[ws];
        }
    }
    #delete[g2];
    ciStrNew(sp + 8, b) r;
    #delete[n]; #delete[b];
    return r;
}
// index of LAST occurrence of needle in hay, or -1 (empty needle -> hl, matching Python rfind).
#define(ciStrLastIndexOf) {
    #scanp(ciStrLastIndexOf, int, 0) hay;
    #scanp(ciStrLastIndexOf, int, 1) needle;
    #stack[int, 64] hl = cssc::peek32(hay + 4);
    #stack[int, 64] nl = cssc::peek32(needle + 4);
    #stack[int, 64] res = 0 - 1;
    if (nl == 0) { res = hl; }
    if (nl != 0) {
        #stack[int, 64] i = hl - nl;
        #stack[int, 32] go = 1;
        if (i < 0) { go = 0; }
        while (go == 1) {
            #stack[int, 64] j = 0;
            #stack[int, 32] m = 1;
            while (j < nl) {
                if (cssc::peek8(hay + 8 + i + j) != cssc::peek8(needle + 8 + j)) { m = 0; j = nl; }
                if (m == 1) { j = j + 1; }
            }
            if (m == 1) { res = i; go = 0; }
            #delete[j]; #delete[m];
            if (go == 1) {
                if (i == 0) { go = 0; }
                if (i > 0) { i = i - 1; }
            }
        }
        #delete[i]; #delete[go];
    }
    #delete[hl]; #delete[nl];
    return res;
}
// join vector elements (stringified by elemType) with sep -> new owned string.
// sep==0 (default) -> no separator. elemType: 1 string / 0 int via ciStrConcat.
#define(ciStrJoinVec) {
    #scanp(ciStrJoinVec, int, 0) vh;
    #scanp(ciStrJoinVec, int, 1) sepp;
    #req[ciStrClone] ciStrClone;
    #req[ciStrConcat] ciStrConcat;
    #stack[int, 64] size = cssc::peek32(vh + 4);
    #stack[int, 64] et = cssc::peek32(vh + 12);
    #stack[int, 64] data = cssc::peek64(vh + 16);
    ciStrClone(0) acc;
    #stack[int, 64] r = acc;
    #delete[acc];
    #stack[int, 64] i = 0;
    while (i < size) {
        #stack[int, 64] ev = cssc::peek64(data + i * 8);
        if (i > 0) {
            if (sepp != 0) {
                ciStrConcat(r, 1, sepp, 1) t1;
                cssc::free(r);
                r = t1;
                #delete[t1];
            }
        }
        ciStrConcat(r, 1, ev, et) t2;
        cssc::free(r);
        r = t2;
        #delete[t2];
        #delete[ev];
        i = i + 1;
    }
    #delete[i]; #delete[size]; #delete[et]; #delete[data];
    return r;
}
#define(ciStrMethod) {
    #scanp(ciStrMethod, int, 0) sp;
    #scanp(ciStrMethod, int, 1) mo;
    #scanp(ciStrMethod, int, 2) ml;
    #req[ciCur] ciCur;
    #req[ciTokOff] ciTokOff;
    #req[ciTokLen] ciTokLen;
    #req[ciAdvance] ciAdvance;
    #req[ciExpr] ciExpr;
    #req[ciIdentIs] ciIdentIs;
    #req[ciEvalType] ciEvalType;
    #req[ciEvalOwns] ciEvalOwns;
    #req[ciStrNew] ciStrNew;
    #req[ciStrClone] ciStrClone;
    #req[ciStrCaseNew] ciStrCaseNew;
    #req[ciStrTrimNew] ciStrTrimNew;
    #req[ciStrRevNew] ciStrRevNew;
    #req[ciStrRepeatNew] ciStrRepeatNew;
    #req[ciStrSubNew] ciStrSubNew;
    #req[ciStrIndexOf] ciStrIndexOf;
    #req[ciStrReplaceNew] ciStrReplaceNew;
    #req[ciStrSplitVec] ciStrSplitVec;
    #req[ciStrPadNew] ciStrPadNew;
    #req[ciStrToIntV] ciStrToIntV;
    #req[ciStrIsDigit] ciStrIsDigit;
    #req[ciStrIsAlpha] ciStrIsAlpha;
    // --- parse up to 2 args: `( a0 , a1 )` (any excess consumed + string-freed) ---
    #stack[int, 64] a0 = 0;
    #stack[int, 64] a0t = 0;
    #stack[int, 64] a0o = 0;
    #stack[int, 64] a1 = 0;
    #stack[int, 64] a1t = 0;
    #stack[int, 64] a1o = 0;
    #stack[int, 32] argn = 0;
    if (ciCur == 9) {
        ciAdvance();
        #stack[int, 32] g = 1;
        if (ciCur == 10) { g = 0; }
        while (g == 1) {
            ciExpr(0) e;
            if (argn == 0) { a0 = e; a0t = ciEvalType; a0o = ciEvalOwns; }
            if (argn == 1) { a1 = e; a1t = ciEvalType; a1o = ciEvalOwns; }
            if (argn > 1) { if (ciEvalOwns == 1) { if (ciEvalType == 1) { cssc::free(e); } } }
            argn = argn + 1;
            #delete[e];
            if (ciCur == 21) { ciAdvance(); }
            if (ciCur == 10) { g = 0; }
            if (ciCur == 0) { g = 0; }
        }
        #delete[g];
    }
    if (ciCur == 10) { ciAdvance(); }
    // --- method identity ---
    ciIdentIs(mo, ml, "length") mLen;
    ciIdentIs(mo, ml, "size") mSz;
    ciIdentIs(mo, ml, "isEmpty") mEmp;
    ciIdentIs(mo, ml, "upper") mUp;
    ciIdentIs(mo, ml, "lower") mLo;
    ciIdentIs(mo, ml, "trim") mTr;
    ciIdentIs(mo, ml, "reverse") mRev;
    ciIdentIs(mo, ml, "repeat") mRep;
    ciIdentIs(mo, ml, "substr") mSub;
    ciIdentIs(mo, ml, "charAt") mCh;
    ciIdentIs(mo, ml, "contains") mCon;
    ciIdentIs(mo, ml, "indexOf") mIdx;
    ciIdentIs(mo, ml, "startsWith") mSw;
    ciIdentIs(mo, ml, "endsWith") mEw;
    ciIdentIs(mo, ml, "replace") mRpl;
    ciIdentIs(mo, ml, "split") mSpl;
    ciIdentIs(mo, ml, "padStart") mPs;
    ciIdentIs(mo, ml, "padEnd") mPe;
    ciIdentIs(mo, ml, "toInt") mTi;
    ciIdentIs(mo, ml, "toFloat") mTf;
    ciIdentIs(mo, ml, "isDigit") mIsD;
    ciIdentIs(mo, ml, "isAlpha") mIsA;
    // reference-parity string-method aliases + extras
    ciIdentIs(mo, ml, "starts_with") mSws;
    ciIdentIs(mo, ml, "ends_with") mEws;
    ciIdentIs(mo, ml, "index_of") mIdxs;
    if (mSws == 1) { mSw = 1; }
    if (mEws == 1) { mEw = 1; }
    if (mIdxs == 1) { mIdx = 1; }
    ciIdentIs(mo, ml, "begin") mBeg;
    ciIdentIs(mo, ml, "end") mEnd;
    ciIdentIs(mo, ml, "front") mFro;
    ciIdentIs(mo, ml, "back") mBak;
    ciIdentIs(mo, ml, "data") mDat;
    ciIdentIs(mo, ml, "capacity") mCap;
    ciIdentIs(mo, ml, "index") mIxc;
    ciIdentIs(mo, ml, "substring") mSbg;
    ciIdentIs(mo, ml, "exists") mEx;
    #stack[int, 64] rv = 0;
    #stack[int, 64] rt = 0;
    #stack[int, 32] ro = 0;
    if (mLen == 1) { rv = cssc::peek32(sp + 4); rt = 0; }
    if (mSz == 1) { rv = cssc::peek32(sp + 4); rt = 0; }
    if (mEmp == 1) { rv = 0; if (cssc::peek32(sp + 4) == 0) { rv = 1; } rt = 9; }
    if (mUp == 1) { ciStrCaseNew(sp, 1) r; rv = r; rt = 1; ro = 1; #delete[r]; }
    if (mLo == 1) { ciStrCaseNew(sp, 0) r; rv = r; rt = 1; ro = 1; #delete[r]; }
    if (mTr == 1) { ciStrTrimNew(sp) r; rv = r; rt = 1; ro = 1; #delete[r]; }
    if (mRev == 1) { ciStrRevNew(sp) r; rv = r; rt = 1; ro = 1; #delete[r]; }
    if (mRep == 1) { ciStrRepeatNew(sp, a0) r; rv = r; rt = 1; ro = 1; #delete[r]; }
    if (mSub == 1) { ciStrSubNew(sp, a0, a1) r; rv = r; rt = 1; ro = 1; #delete[r]; }
    if (mCh == 1) { ciStrSubNew(sp, a0, 1) r; rv = r; rt = 1; ro = 1; #delete[r]; }
    if (mCon == 1) { ciStrIndexOf(sp, a0) ix; rv = 0; if (ix >= 0) { rv = 1; } rt = 9; #delete[ix]; }
    if (mIdx == 1) { ciStrIndexOf(sp, a0) ix; rv = ix; rt = 0; #delete[ix]; }
    if (mSw == 1) { ciStrIndexOf(sp, a0) ix; rv = 0; if (ix == 0) { rv = 1; } rt = 9; #delete[ix]; }
    if (mEw == 1) {
        #stack[int, 64] nl = cssc::peek32(a0 + 4);
        #stack[int, 64] hl = cssc::peek32(sp + 4);
        #stack[int, 32] ew = 0;
        if (nl <= hl) {
            ew = 1;
            #stack[int, 64] j = 0;
            while (j < nl) {
                if (cssc::peek8(sp + 8 + hl - nl + j) != cssc::peek8(a0 + 8 + j)) { ew = 0; j = nl; }
                if (ew == 1) { j = j + 1; }
            }
            #delete[j];
        }
        rv = ew;
        rt = 9;
        #delete[nl];
        #delete[hl];
        #delete[ew];
    }
    if (mRpl == 1) { ciStrReplaceNew(sp, a0, a1) r; rv = r; rt = 1; ro = 1; #delete[r]; }
    if (mSpl == 1) { ciStrSplitVec(sp, a0) r; rv = r; rt = 4; ro = 1; #delete[r]; }
    if (mPs == 1) { ciStrPadNew(sp, a0, a1, 1) r; rv = r; rt = 1; ro = 1; #delete[r]; }
    if (mPe == 1) { ciStrPadNew(sp, a0, a1, 0) r; rv = r; rt = 1; ro = 1; #delete[r]; }
    if (mTi == 1) { ciStrToIntV(sp) r; rv = r; rt = 0; #delete[r]; }
    if (mTf == 1) { cssc::strToF(sp + 8, cssc::peek32(sp + 4)) r; rv = r; rt = 2; #delete[r]; }
    if (mIsD == 1) { ciStrIsDigit(sp) r; rv = r; rt = 9; #delete[r]; }
    if (mIsA == 1) { ciStrIsAlpha(sp) r; rv = r; rt = 9; #delete[r]; }
    if (mBeg == 1) { ciStrSubNew(sp, 0, 1) r; rv = r; rt = 1; ro = 1; #delete[r]; }
    if (mFro == 1) { ciStrSubNew(sp, 0, 1) r; rv = r; rt = 1; ro = 1; #delete[r]; }
    if (mEnd == 1) { ciStrSubNew(sp, cssc::peek32(sp + 4) - 1, 1) r; rv = r; rt = 1; ro = 1; #delete[r]; }
    if (mBak == 1) { ciStrSubNew(sp, cssc::peek32(sp + 4) - 1, 1) r; rv = r; rt = 1; ro = 1; #delete[r]; }
    if (mDat == 1) { ciStrClone(sp) r; rv = r; rt = 1; ro = 1; #delete[r]; }
    if (mCap == 1) { rv = cssc::peek32(sp + 4); rt = 0; }
    if (mIxc == 1) { ciStrSubNew(sp, a0, 1) r; rv = r; rt = 1; ro = 1; #delete[r]; }
    if (mSbg == 1) { #stack[int, 64] sbl = a1 - a0; if (argn < 2) { sbl = cssc::peek32(sp + 4) - a0; } ciStrSubNew(sp, a0, sbl) r; rv = r; rt = 1; ro = 1; #delete[r]; #delete[sbl]; }
    if (mEx == 1) { rv = 1; rt = 9; }
    // free any owned string-arg temporaries this call consumed
    if (a0o == 1) { if (a0t == 1) { if (a0 != 0) { cssc::free(a0); } } }
    if (a1o == 1) { if (a1t == 1) { if (a1 != 0) { cssc::free(a1); } } }
    ciEvalType = rt;
    ciEvalOwns = ro;
    #delete[a0]; #delete[a0t]; #delete[a0o];
    #delete[a1]; #delete[a1t]; #delete[a1o];
    #delete[argn];
    #delete[mLen]; #delete[mSz]; #delete[mEmp]; #delete[mUp]; #delete[mLo];
    #delete[mTr]; #delete[mRev]; #delete[mRep]; #delete[mSub]; #delete[mCh];
    #delete[mCon]; #delete[mIdx]; #delete[mSw]; #delete[mEw]; #delete[mRpl];
    #delete[mSpl]; #delete[mPs]; #delete[mPe]; #delete[mTi]; #delete[mTf];
    #delete[mIsD]; #delete[mIsA];
    #delete[mSws]; #delete[mEws]; #delete[mIdxs];
    #delete[mBeg]; #delete[mEnd]; #delete[mFro]; #delete[mBak]; #delete[mDat];
    #delete[mCap]; #delete[mIxc]; #delete[mSbg]; #delete[mEx];
    #delete[rt];
    #delete[ro];
    return rv;
}

// byte-wise string compare -> -1 / 0 / 1 (a<b / a==b / a>b). Operands are
// pointers to string objects {rc@0, size@4, bytes@8}. Enables content equality
// and ordering for `==`/`<`/... and string map keys (interpreter values only
// ever compared by pointer before this).
#define(ciStrCmp) {
    #scanp(ciStrCmp, int, 0) a;
    #scanp(ciStrCmp, int, 1) b;
    // a null string pointer (uninitialized `#stack[string]`) is the empty string,
    // not a fault: peek32(0+4) would segfault. length 0 -> the data ptr (a+8) is
    // never read (the i<la guard fails immediately).
    #stack[int, 64] la = 0;
    #stack[int, 64] lb = 0;
    if (a != 0) { la = cssc::peek32(a + 4); }
    if (b != 0) { lb = cssc::peek32(b + 4); }
    #stack[int, 64] da = a + 8;
    #stack[int, 64] db = b + 8;
    #stack[int, 64] i = 0;
    #stack[int, 64] res = 0;
    #stack[int, 32] go = 1;
    while (go == 1) {
        #stack[int, 32] ae = 0;
        #stack[int, 32] be = 0;
        if (i >= la) { ae = 1; }
        if (i >= lb) { be = 1; }
        if (ae == 1) {
            if (be == 1) { res = 0; go = 0; }
            if (be == 0) { res = 0 - 1; go = 0; }
        }
        if (go == 1) {
            if (be == 1) { res = 1; go = 0; }
        }
        if (go == 1) {
            #stack[int, 64] ca = cssc::peek8(da + i);
            #stack[int, 64] cb = cssc::peek8(db + i);
            if (ca < cb) { res = 0 - 1; go = 0; }
            if (ca > cb) { res = 1; go = 0; }
            #delete[ca];
            #delete[cb];
            i = i + 1;
        }
        #delete[ae];
        #delete[be];
    }
    #delete[go];
    #delete[i];
    #delete[da];
    #delete[db];
    #delete[la];
    #delete[lb];
    return res;
}

// ---- cssc:: array builtins (produce/reduce over vectors): concat/range/zip/
// fill/sum/avg. slice/unique/flat/count reuse the vector-method primitives above.
#define(ciVecConcat) {
    #scanp(ciVecConcat, int, 0) a;
    #scanp(ciVecConcat, int, 1) b;
    #req[ciVecNew] ciVecNew;
    #req[ciVecPush] ciVecPush;
    #stack[int, 64] et = cssc::peek32(a + 12);
    #stack[int, 64] nv = 0;
    ciVecNew(et) t; nv = t; #delete[t];
    #stack[int, 64] sa = cssc::peek32(a + 4);
    #stack[int, 64] da = cssc::peek64(a + 16);
    #stack[int, 64] i = 0;
    while (i < sa) { #stack[int, 64] ev = cssc::peek64(da + i * 8); ciVecPush(nv, ev, et); #delete[ev]; i = i + 1; }
    #delete[i]; #delete[da]; #delete[sa];
    #stack[int, 64] sb = cssc::peek32(b + 4);
    #stack[int, 64] db = cssc::peek64(b + 16);
    #stack[int, 64] j = 0;
    while (j < sb) { #stack[int, 64] ev = cssc::peek64(db + j * 8); ciVecPush(nv, ev, et); #delete[ev]; j = j + 1; }
    #delete[j]; #delete[db]; #delete[sb]; #delete[et];
    return nv;
}
#define(ciVecRange) {
    #scanp(ciVecRange, int, 0) s;
    #scanp(ciVecRange, int, 1) e;
    #scanp(ciVecRange, int, 2) step;
    #req[ciVecNew] ciVecNew;
    #req[ciVecPush] ciVecPush;
    #stack[int, 64] nv = 0;
    ciVecNew(0) t; nv = t; #delete[t];
    #stack[int, 64] st = step;
    if (st == 0) { st = 1; }
    #stack[int, 64] i = s;
    #stack[int, 32] go = 1;
    while (go == 1) {
        if (st > 0) { if (i >= e) { go = 0; } }
        if (st < 0) { if (i <= e) { go = 0; } }
        if (go == 1) { ciVecPush(nv, i, 0); i = i + st; }
    }
    #delete[go]; #delete[i]; #delete[st];
    return nv;
}
#define(ciVecZip) {
    #scanp(ciVecZip, int, 0) a;
    #scanp(ciVecZip, int, 1) b;
    #req[ciVecNew] ciVecNew;
    #req[ciVecPush] ciVecPush;
    #stack[int, 64] et = cssc::peek32(a + 12);
    #stack[int, 64] sa = cssc::peek32(a + 4);
    #stack[int, 64] sb = cssc::peek32(b + 4);
    #stack[int, 64] da = cssc::peek64(a + 16);
    #stack[int, 64] db = cssc::peek64(b + 16);
    #stack[int, 64] n = sa;
    if (sb < n) { n = sb; }
    #stack[int, 64] nv = 0;
    ciVecNew(et) t; nv = t; #delete[t];
    #stack[int, 64] i = 0;
    while (i < n) {
        #stack[int, 64] ea = cssc::peek64(da + i * 8);
        #stack[int, 64] eb = cssc::peek64(db + i * 8);
        ciVecPush(nv, ea, et); ciVecPush(nv, eb, et);
        #delete[ea]; #delete[eb]; i = i + 1;
    }
    #delete[i]; #delete[da]; #delete[db]; #delete[sa]; #delete[sb]; #delete[n]; #delete[et];
    return nv;
}
#define(ciVecFill) {
    #scanp(ciVecFill, int, 0) n;
    #scanp(ciVecFill, int, 1) x;
    #scanp(ciVecFill, int, 2) xt;
    #req[ciVecNew] ciVecNew;
    #req[ciVecPush] ciVecPush;
    #stack[int, 64] nv = 0;
    ciVecNew(xt) t; nv = t; #delete[t];
    #stack[int, 64] i = 0;
    while (i < n) { ciVecPush(nv, x, xt); i = i + 1; }
    #delete[i];
    return nv;
}
#define(ciVecSum) {
    #scanp(ciVecSum, int, 0) h;
    #stack[int, 64] et = cssc::peek32(h + 12);
    #stack[int, 64] size = cssc::peek32(h + 4);
    #stack[int, 64] d = cssc::peek64(h + 16);
    #stack[int, 64] acc = 0;
    if (et == 2) { cssc::iToF(0) z; acc = z; #delete[z]; }
    #stack[int, 64] i = 0;
    while (i < size) {
        #stack[int, 64] ev = cssc::peek64(d + i * 8);
        if (et == 2) { cssc::fAdd(acc, ev) tt; acc = tt; #delete[tt]; }
        if (et != 2) { acc = acc + ev; }
        #delete[ev]; i = i + 1;
    }
    #delete[i]; #delete[d]; #delete[size]; #delete[et];
    return acc;
}
#define(ciVecAvg) {
    #scanp(ciVecAvg, int, 0) h;
    #stack[int, 64] et = cssc::peek32(h + 12);
    #stack[int, 64] size = cssc::peek32(h + 4);
    #stack[int, 64] d = cssc::peek64(h + 16);
    #stack[int, 64] r = 0;
    if (size > 0) {
        #stack[int, 64] acc = 0;
        cssc::iToF(0) z; acc = z; #delete[z];
        #stack[int, 64] i = 0;
        while (i < size) {
            #stack[int, 64] ev = cssc::peek64(d + i * 8);
            #stack[int, 64] fv = ev;
            if (et != 2) { cssc::iToF(ev) c; fv = c; #delete[c]; }
            cssc::fAdd(acc, fv) tt; acc = tt; #delete[tt];
            #delete[fv]; #delete[ev]; i = i + 1;
        }
        cssc::iToF(size) fs;
        cssc::fDiv(acc, fs) q;
        r = q;
        #delete[q]; #delete[fs]; #delete[acc]; #delete[i];
    }
    #delete[et]; #delete[size]; #delete[d];
    return r;
}
// ---- map (value tag 5) : key->value store, linear probe. handle{rc@0,size@4,
// cap@8,data@16}; data = cap*32, entry{keyType@0,keyVal@8,valType@16,valVal@24}.
// keys int OR string (string keys compared by content via ciStrCmp and CLONED on
// insert so a temp literal key stays valid); values int for now.
#define(ciMapNew) {
    #stack[int, 64] cap = 8;
    #stack[int, 64] h = cssc::alloc(24);
    #stack[int, 64] d = cssc::alloc(cap * 32);
    cssc::memfill32(d, 0, cap * 8);
    cssc::poke32(h, 1);
    cssc::poke32(h + 4, 0);
    cssc::poke32(h + 8, cap);
    cssc::poke64(h + 16, d);
    #delete[d];
    #delete[cap];
    return h;
}
#define(ciMapSize) {
    #scanp(ciMapSize, int, 0) h;
    return cssc::peek32(h + 4);
}
#define(ciMapFind) {
    #scanp(ciMapFind, int, 0) h;
    #scanp(ciMapFind, int, 1) kt;
    #scanp(ciMapFind, int, 2) kv;
    #req[ciStrCmp] ciStrCmp;
    #stack[int, 64] size = cssc::peek32(h + 4);
    #stack[int, 64] d = cssc::peek64(h + 16);
    #stack[int, 64] i = 0;
    #stack[int, 64] res = 0 - 1;
    while (i < size) {
        if (res < 0) {
            #stack[int, 64] ekt = cssc::peek64(d + i * 32);
            #stack[int, 64] ekv = cssc::peek64(d + i * 32 + 8);
            #stack[int, 32] match = 0;
            if (ekt == kt) {
                if (kt == 1) {
                    ciStrCmp(ekv, kv) c;
                    if (c == 0) { match = 1; }
                    #delete[c];
                }
                if (kt != 1) {
                    if (ekv == kv) { match = 1; }
                }
            }
            if (match == 1) { res = i; }
            #delete[match];
            #delete[ekv];
            #delete[ekt];
        }
        i = i + 1;
    }
    #delete[i];
    #delete[d];
    #delete[size];
    return res;
}
#define(ciMapSet) {
    #scanp(ciMapSet, int, 0) h;
    #scanp(ciMapSet, int, 1) kt;
    #scanp(ciMapSet, int, 2) kv;
    #scanp(ciMapSet, int, 3) vt;
    #scanp(ciMapSet, int, 4) vv;
    #req[ciMapFind] ciMapFind;
    #req[ciStrClone] ciStrClone;
    ciMapFind(h, kt, kv) idx;
    #stack[int, 64] sv = vv;
    if (vt == 1) {
        ciStrClone(vv) cv;
        sv = cv;
        #delete[cv];
    }
    if (idx >= 0) {
        #stack[int, 64] d = cssc::peek64(h + 16);
        #stack[int, 64] ovt = cssc::peek64(d + idx * 32 + 16);
        if (ovt == 1) { cssc::free(cssc::peek64(d + idx * 32 + 24)); }
        cssc::poke64(d + idx * 32 + 16, vt);
        cssc::poke64(d + idx * 32 + 24, sv);
        #delete[ovt];
        #delete[d];
    }
    if (idx < 0) {
        #stack[int, 64] size = cssc::peek32(h + 4);
        #stack[int, 64] cap = cssc::peek32(h + 8);
        if (size >= cap) {
            #stack[int, 64] ncap = cap * 2;
            #stack[int, 64] nd = cssc::alloc(ncap * 32);
            #stack[int, 64] od = cssc::peek64(h + 16);
            cssc::memcopy(nd, od, size * 8);
            cssc::free(od);
            cssc::poke64(h + 16, nd);
            cssc::poke32(h + 8, ncap);
            #delete[od];
            #delete[nd];
            #delete[ncap];
        }
        #stack[int, 64] sk = kv;
        if (kt == 1) {
            ciStrClone(kv) ck;
            sk = ck;
            #delete[ck];
        }
        #stack[int, 64] d = cssc::peek64(h + 16);
        cssc::poke64(d + size * 32, kt);
        cssc::poke64(d + size * 32 + 8, sk);
        cssc::poke64(d + size * 32 + 16, vt);
        cssc::poke64(d + size * 32 + 24, sv);
        cssc::poke32(h + 4, size + 1);
        #delete[d];
        #delete[sk];
        #delete[size];
        #delete[cap];
    }
    #delete[sv];
    #delete[idx];
}
#define(ciMapGet) {
    #scanp(ciMapGet, int, 0) h;
    #scanp(ciMapGet, int, 1) kt;
    #scanp(ciMapGet, int, 2) kv;
    #req[ciStrClone] ciStrClone;
    #req[ciMapRT] ciMapRT;
    #req[ciMapFound] ciMapFound;
    #req[ciMapFind] ciMapFind;
    ciMapFind(h, kt, kv) idx;
    #stack[int, 64] r = 0;
    ciMapRT = 0;
    ciMapFound = 0;
    if (idx >= 0) {
        ciMapFound = 1;
        #stack[int, 64] d = cssc::peek64(h + 16);
        #stack[int, 64] vt = cssc::peek64(d + idx * 32 + 16);
        #stack[int, 64] vv = cssc::peek64(d + idx * 32 + 24);
        ciMapRT = vt;
        if (vt == 1) {
            ciStrClone(vv) cv;
            r = cv;
            #delete[cv];
