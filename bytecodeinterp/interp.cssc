    #delete[isdef];
    #delete[isredef];
    #delete[isscan];
    #delete[isreq];
    #delete[isvec];
    #delete[ismap];
    #delete[isarr];
    #delete[isvid];
    #delete[iscons];
    #delete[isadr];
    #delete[isref];
    #delete[isdelm];
    #delete[ctag];
