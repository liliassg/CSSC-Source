                            cssc::free(ebuf);
                            #delete[es];
                            #delete[ephdr];
                            #delete[ephh];
                            #delete[eplen];
                            #delete[tnlen];
                            #delete[etot];
                            #delete[ebuf];
                            #delete[tnhdr];
                            #delete[ea0];
                            #delete[ea1];
                            #delete[ea2];
                            #delete[ea3];
                            #delete[ea4];
                            #delete[ea5];
                            #delete[ea7];
