                        if (gCallable == 0) {
                            valType = 0;
                            valVal = 0;
                            errType = 1;
                            #stack[string, 80] epfx = "grace::catch first argument must be callable; got ";
                            #stack[string, 16] tn0 = "int";
                            #stack[string, 16] tn1 = "string";
                            #stack[string, 16] tn2 = "float";
                            #stack[string, 16] tn3 = "object";
                            #stack[string, 16] tn4 = "vector";
                            #stack[string, 16] tn5 = "map";
                            #stack[string, 16] tn7 = "bind";
                            #stack[int, 64] ea0 = 0;
                            #adress[tn0] ea0;
                            #stack[int, 64] tnhdr = cssc::peek64(ea0);
                            #stack[int, 64] ea1 = 0;
                            #adress[tn1] ea1;
                            if (gArgType == 1) { tnhdr = cssc::peek64(ea1); }
                            #stack[int, 64] ea2 = 0;
                            #adress[tn2] ea2;
                            if (gArgType == 2) { tnhdr = cssc::peek64(ea2); }
                            #stack[int, 64] ea3 = 0;
                            #adress[tn3] ea3;
                            if (gArgType == 3) { tnhdr = cssc::peek64(ea3); }
                            #stack[int, 64] ea4 = 0;
                            #adress[tn4] ea4;
                            if (gArgType == 4) { tnhdr = cssc::peek64(ea4); }
                            #stack[int, 64] ea5 = 0;
                            #adress[tn5] ea5;
                            if (gArgType == 5) { tnhdr = cssc::peek64(ea5); }
                            #stack[int, 64] ea7 = 0;
                            #adress[tn7] ea7;
                            if (gArgType == 7) { tnhdr = cssc::peek64(ea7); }
                            #stack[int, 64] ephdr = 0;
                            #adress[epfx] ephdr;
                            #stack[int, 64] ephh = cssc::peek64(ephdr);
                            #stack[int, 64] eplen = cssc::peek32(ephh + 4);
                            #stack[int, 64] tnlen = cssc::peek32(tnhdr + 4);
                            #stack[int, 64] etot = eplen + tnlen;
                            #stack[int, 64] ebuf = cssc::alloc(etot);
                            #stack[int, 64] ek = 0;
                            while (ek < eplen) {
                                cssc::poke8(ebuf + ek, cssc::peek8(ephh + 8 + ek));
                                ek = ek + 1;
                            }
                            #delete[ek];
                            #stack[int, 64] ek2 = 0;
                            while (ek2 < tnlen) {
