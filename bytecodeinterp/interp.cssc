        // route. modid 0 = not a module call. Statement-position handles the
        // VOID ops (draw / update / play); value ops resolve in ciExpr.
        ciModOf(o, l) ciModId;
        ciIdentIs(o, l, "return") kret;
        ciIdentIs(o, l, "sector") ksec;
        ciIdentIs(o, l, "object") kobj;
        ciIdentIs(o, l, "mirror") kmir;
        ciIdentIs(o, l, "destruct") kdes;
        ciIdentIs(o, l, "break") kbrk;
        ciIdentIs(o, l, "continue") kcont;
        ciIdentIs(o, l, "select") ksel;
        ciIdentIs(o, l, "jump") kjmp;
        #stack[int, 32] h = 0;
