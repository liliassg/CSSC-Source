        if (ciCur == 13) { ciAdvance(); }
        #delete[hasRef];
        #delete[targetRow];
        #delete[got];
        #delete[gv];
        #delete[gt];
        #delete[gno];
        #delete[gnl];
        #delete[ano];
        #delete[anl];
    }
    // ---- #stack / #heap / #auto : typed slot declaration ----
    #stack[int, 32] isvar = 0;
    if (isdel == 0) { if (isdef == 0) { if (isscan == 0) { if (isreq == 0) { if (isvid == 0) { if (iscons == 0) {
    if (iscdef == 0) { if (isparam == 0) { if (isfvar == 0) { if (isqvar == 0) { if (isredef == 0) {
    if (isadr == 0) { if (isref == 0) { if (isdelm == 0) { isvar = 1; } } } } } } } } } } } } } }
    // parse the [TYPE, BITS] annotation and capture the declared type
    // (declType: 0 = int/generic, 1 = string)
    // ---- #delete[name]; / #delete[Obj->member]; : unbind + free ----
    if (isdel == 1) {
        if (ciCur == 23) { ciAdvance(); }
        // the identifier inside [ ] is the variable (or Obj->member) to drop
        #stack[int, 64] dno = ciTokOff;
        #stack[int, 64] dnl = ciTokLen;
        #stack[int, 32] hasName = 0;
        if (ciCur == 2) { hasName = 1; ciAdvance(); }
        if (ciCur == 1) { if (ciTokFloat == 2) { hasName = 1; ciAdvance(); } }
        // arrow form: `#delete[Obj->member];` drops a member of the CURRENT
        // instance (free{} blocks + ctor cleanup use this)
        #stack[int, 32] isArrow = 0;
        #stack[int, 64] dmo = 0;
        #stack[int, 64] dml = 0;
        if (ciCur == 34) {
            ciAdvance();
            dmo = ciTokOff;
            dml = ciTokLen;
            isArrow = 1;
            if (ciCur == 2) { ciAdvance(); }
        }
        // skip any remainder up to and including ]
        #stack[int, 32] dsk = 1;
        while (dsk == 1) {
            if (ciCur == 24) { dsk = 0; }
            if (ciCur == 0) { dsk = 0; }
            if (dsk == 1) { ciAdvance(); }
        }
        if (ciCur == 24) { ciAdvance(); }
        if (ciCur == 13) { ciAdvance(); }
        if (ciExec == 1) {
            if (isArrow == 1) {
                if (ciCurInst != 0) {
                    ciInstMemFind(ciCurInst, dmo, dml) mi;
                    if (mi >= 0) {
                        #stack[int, 64] mrow = ciCurInst + 24 + mi * 64;
                        #stack[int, 64] mo2 = cssc::peek64(mrow + 56);
                        #stack[int, 64] mt2 = cssc::peek64(mrow + 48);
