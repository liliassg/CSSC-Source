                                if (ncap > 32) { ncap = 32; }
                                #stack[int, 32] nk = 0;
                                while (nk < ncap) {
                                    cssc::poke8(ciLoadName + ciLoadCount * 32 + nk, cssc::peek8(ciSrc + ao + nk));
                                    nk = nk + 1;
                                }
                                #delete[nk];
                                #delete[ncap];
