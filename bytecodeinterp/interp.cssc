    #req[ciIniVal] ciIniVal;
    #req[ciIniOut] ciIniOut;
    // variable table: up to 4096 rows (name 32B for qualified Sector::member,
    // len/val/type/owns 8B each). BIG for firefield's 13-module global set.
    ciVNames = cssc::alloc(131072);
    ciVLens = cssc::alloc(32768);
    ciVVals = cssc::alloc(32768);
    ciVTypes = cssc::alloc(32768);
