                    ciIdentIs(mmo, mml, "collideAabb") tca;
                    ciIdentIs(mmo, mml, "tileAtWorld") ttaw;
                    if (ciCur == 9) { ciAdvance(); }
                    #stack[int, 64] a1 = 0; #stack[int, 64] a2 = 0; #stack[int, 64] a3 = 0;
                    #stack[int, 64] a4 = 0; #stack[int, 64] a5 = 0;
                    #stack[int, 64] q1 = 0; #stack[int, 64] q2 = 0; #stack[int, 64] q3 = 0;
                    #stack[int, 64] q4 = 0; #stack[int, 64] q5 = 0;
