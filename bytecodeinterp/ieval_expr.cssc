    #req[ciFontMeasure] ciFontMeasure;
    #req[ciFont5] ciFont5;
    #req[ciValFree] ciValFree;
    #req[ciMapNew] ciMapNew;
    #req[ciMapSet] ciMapSet;
    #req[ciAppLit] ciAppLit;
    #req[ciVecNew] ciVecNew;
    #req[ciDevStdout] ciDevStdout;
    #req[ciMsMethod] ciMsMethod;
    #req[ciMsUpdate] ciMsUpdate;
    #req[ciConGetLine] ciConGetLine;
    #req[ciConCursorAt] ciConCursorAt;
    #req[ciMaHashN] ciMaHashN;
    #req[ciMaHashUnit] ciMaHashUnit;
    #req[ciMaHashUnit3] ciMaHashUnit3;
    #req[ciMaFade] ciMaFade;
    #req[ciMaLerpf] ciMaLerpf;
    #req[ciMaFloori] ciMaFloori;
    #req[ciMaValueNoise2] ciMaValueNoise2;
    #req[ciMaFbm2] ciMaFbm2;
    // ---- expr-position user-function call support (root cause #1): calling a
    // registered #define/#cdefine as a value, `outln(f(x))`. Replays the callee
    // body via ciStmt (forward-decl slot @367 -> mutual ciExpr<->ciStmt) with a
    // per-call fresh arg frame (reentrancy-safe) + full frame/ret save-restore. ----
    #req[ciPos] ciPos;
    #req[ciStmt] ciStmt;
    #req[ciFnFind] ciFnFind;
    #req[ciFnVis] ciFnVis;
    #req[ciSecPrefixIs] ciSecPrefixIs;
    #req[ciQualify] ciQualify;
    #req[ciQualBuf] ciQualBuf;
    #req[ciCurSecOff] ciCurSecOff;
    #req[ciCurSecLen] ciCurSecLen;
    #req[ciArgVals] ciArgVals;
    #req[ciArgTypes] ciArgTypes;
    #req[ciArgOwns] ciArgOwns;
    #req[ciArgCount] ciArgCount;
    #req[ciVecPush] ciVecPush;
    #req[ciScopeBase] ciScopeBase;
    #req[ciVCount] ciVCount;
    #req[ciSignal] ciSignal;
    #req[ciSecInit] ciSecInit;
    #req[ciSecVis] ciSecVis;
    #req[ciMirrored] ciMirrored;
    #req[ciRetVal] ciRetVal;
    #req[ciRetType] ciRetType;
    #req[ciRetOwns] ciRetOwns;
    #req[ciFnSecOff] ciFnSecOff;
    #req[ciFnSecLen] ciFnSecLen;
    #req[ciFnParCnt] ciFnParCnt;
    #req[ciFnParOff] ciFnParOff;
    #req[ciFnParLen] ciFnParLen;
    #req[ciVarSet] ciVarSet;
    #req[ciVVals] ciVVals;
    #req[ciVTypes] ciVTypes;
    #req[ciVOwns] ciVOwns;
    #req[ciInstFree] ciInstFree;
    #req[ciFnBodyStart] ciFnBodyStart;
    #req[ciFnInjCnt] ciFnInjCnt;
    #req[ciFnInjStart] ciFnInjStart;
    #req[ciFnInjEnd] ciFnInjEnd;
    #req[ciStrMethod] ciStrMethod;
    #req[ciVecIndexOf] ciVecIndexOf;
    #stack[int, 64] left = 0;
    // ownership of `left`: 1 = a fresh string this expression allocated and
    // still owns; 0 = an int or a borrow of a variable's string
    #stack[int, 32] leftOwns = 0;
    ciEvalType = 0;
    // ENTRY token: the primary-dispatch and PREFIX operators (unary '-', '!',
    // '&'-copy) must key off the token at ENTRY, not the live ciCur -- otherwise
    // after a number/ident advances ciCur onto a following '-', the unary-minus
    // block would wrongly fire and discard the left operand (broke `5 - 1`).
    #stack[int, 64] ciC0 = ciCur;
    if (ciCur == 1) {
        left = ciTokNum;
        if (ciTokFloat == 1) { ciEvalType = 2; }
        if (ciTokFloat == 2) {
            ciVarFindGlobal(ciTokOff, ciTokLen) hxi;
            if (hxi >= 0) {
                left = cssc::peek64(ciVVals + hxi * 8);
                ciEvalType = cssc::peek64(ciVTypes + hxi * 8);
            }
            #delete[hxi];
        }
        ciAdvance();
    }
    if (ciCur == 3) {
        ciStrNew(ciSrc + ciTokOff, ciTokLen) sp;
        left = sp;
        ciEvalType = 1;
        leftOwns = 1;
        #delete[sp];
        ciAdvance();
    }
    if (ciCur == 11) {
        // FX-TRANSIENT: `{a, b, c}` container literal in expression position ->
        // a fresh owned vector (tag 4); elements pushed by value.
        ciVecNew(0) vh;
        ciAdvance();
        #stack[int, 32] vgo = 1;
        if (ciCur == 12) { vgo = 0; ciAdvance(); }
        while (vgo == 1) {
            ciExpr(0) cv;
            #stack[int, 64] cvt = ciEvalType;
            #stack[int, 64] cvo = ciEvalOwns;
            ciVecPush(vh, cv, cvt);
            if (cvo == 1) { if (cvt == 1) { cssc::free(cv); } }
            #stack[int, 32] vstep = 0;
            if (ciCur == 21) { ciAdvance(); vstep = 1; }
            if (vstep == 0) {
                if (ciCur == 12) { ciAdvance(); }
                vgo = 0;
            }
            if (ciCur == 0) { vgo = 0; }
            #delete[vstep];
            #delete[cv];
            #delete[cvt];
            #delete[cvo];
        }
        left = vh;
        ciEvalType = 4;
        leftOwns = 1;
        #delete[vgo];
        #delete[vh];
    }
    if (ciC0 == 30) {
        // unary & : explicit copy. `&name` clones the variable's string into a
        // fresh owned allocation (ints copy by value trivially).
        ciAdvance();
        if (ciCur == 2) {
            #stack[int, 64] co = ciTokOff;
            #stack[int, 64] cl = ciTokLen;
            ciAdvance();
            ciVarGet(co, cl) cg;
            #stack[int, 64] cgt = ciEvalType;
            if (cgt == 1) {
                ciStrClone(cg) ccl;
                left = ccl;
                leftOwns = 1;
                #delete[ccl];
            }
            if (cgt >= 4) {
                // value semantics: `&container` yields an independent DEEP COPY
                // (owned), so the source -- and any argument temporary it came
                // from -- can be freed without dangling this copy
                ciValClone(cgt, cg) ccc;
                left = ccc;
                leftOwns = 1;
                #delete[ccc];
            }
            if (cgt == 0) { left = cg; leftOwns = 0; }
            if (cgt == 2) { left = cg; leftOwns = 0; }
            if (cgt == 3) { left = cg; leftOwns = 0; }
            ciEvalType = cgt;
            #delete[cg];
            #delete[cgt];
            #delete[co];
            #delete[cl];
        }
    }
    if (ciC0 == 5) {
        // unary minus (binds tighter than any binary operator); float-aware
        ciAdvance();
        ciExpr(6) u;
        #stack[int, 64] ut = ciEvalType;
        if (ut == 2) { left = cssc::fNeg(u); ciEvalType = 2; }
        if (ut != 2) { left = 0 - u; ciEvalType = 0; }
        #delete[ut];
        #delete[u];
    }
    if (ciC0 == 27) {
        // logical NOT: !0 -> 1, !nonzero -> 0; result is a BOOL (tag 9 ->
        // prints true/false), matching the reference.
        ciAdvance();
        ciExpr(6) u;
        if (u == 0) { left = 1; }
        if (u != 0) { left = 0; }
        ciEvalType = 9;
        #delete[u];
    }
    if (ciCur == 9) {
        ciAdvance();
        ciExpr(0) e;
        left = e;
        // a parenthesised sub-expression carries its ownership through
        leftOwns = ciEvalOwns;
        #delete[e];
        if (ciCur == 10) {
            ciAdvance();
        }
    }
    if (ciCur == 2) {
        #stack[int, 64] o = ciTokOff;
        #stack[int, 64] l = ciTokLen;
        ciIdentIs(o, l, "cssc::peek32") ip32;
        ciIdentIs(o, l, "cssc::peek8") ip8;
        ciIdentIs(o, l, "cssc::fbAddr") ifa;
        ciIdentIs(o, l, "cssc::fbWidth") ifw;
        ciIdentIs(o, l, "cssc::fbHeight") ifh;
        ciIdentIs(o, l, "cssc::heapUsed") ihu;
        ciIdentIs(o, l, "cssc::ticks") itk;
        ciIdentIs(o, l, "cssc::mouseX") imx;
        ciIdentIs(o, l, "cssc::mouseY") imy;
        ciIdentIs(o, l, "cssc::mouseBtn") imb;
        // SD-card + CCFS-file access for the on-device writer (writer.cssc)
        ciIdentIs(o, l, "cssc::sdInit") isin;
        ciIdentIs(o, l, "cssc::sdWriteRange") iswr;
        ciIdentIs(o, l, "cssc::sdFlashDisk") isfd;
        ciIdentIs(o, l, "cssc::sdVerifyDisk") isvd;
        ciIdentIs(o, l, "cssc::fileAddr") ifad;
        ciIdentIs(o, l, "cssc::fileSize") ifsz;
        ciIdentIs(o, l, "cssc::fileDiskLba") ifdl;
        // #include("ini") accessors (expression-position, return an int)
        ciIdentIs(o, l, "ini::lang") iil;
        ciIdentIs(o, l, "ini::layout") iily;
        // bool literals true/false -> 1/0 (bare identifiers, no call)
        ciIdentIs(o, l, "true") ktru;
        ciIdentIs(o, l, "false") kfls;
        // pure cssc:: std builtins (int/string; float-math ones come with float)
        ciIdentIs(o, l, "cssc::abs") bab;
        ciIdentIs(o, l, "cssc::min") bmn;
        ciIdentIs(o, l, "cssc::max") bmx;
        // bit intrinsics reachable from guest expressions (CSSC has no guest bit
        // operators; guests use these). 2-arg, int -> int, dispatch to the native op.
        ciIdentIs(o, l, "cssc::band") bband;
        ciIdentIs(o, l, "cssc::bor") bbor;
        ciIdentIs(o, l, "cssc::bxor") bbxor;
        ciIdentIs(o, l, "cssc::shl") bshl;
        ciIdentIs(o, l, "cssc::shr") bshr;
        ciIdentIs(o, l, "cssc::clamp") bcl;
        ciIdentIs(o, l, "cssc::len") bln;
        ciIdentIs(o, l, "cssc::to_int") bti;
        ciIdentIs(o, l, "cssc::to_string") bts;
        ciIdentIs(o, l, "cssc::to_bool") btb;
        ciIdentIs(o, l, "cssc::input") binput;
        ciIdentIs(o, l, "cssc::uptime") bupt;
        ciIdentIs(o, l, "cssc::sleep") bslp;
        ciIdentIs(o, l, "cssc::time") btime;
        ciIdentIs(o, l, "cssc::timestamp") btsm;
        ciIdentIs(o, l, "cssc::clock") bclk;
        ciIdentIs(o, l, "cssc::detime") bdet;
        ciIdentIs(o, l, "cssc::sdetime") bsdt;
        ciIdentIs(o, l, "cssc::elapsed") belp;
        ciIdentIs(o, l, "cssc::date") bdate;
        ciIdentIs(o, l, "cssc::datetime") bdtt;
        // float-math builtins (result is a float unless noted)
        ciIdentIs(o, l, "cssc::sqrt") bsq;
        ciIdentIs(o, l, "cssc::floor") bfl;
        ciIdentIs(o, l, "cssc::ceil") bce;
        ciIdentIs(o, l, "cssc::round") bro;
        ciIdentIs(o, l, "cssc::trunc") btr;
        ciIdentIs(o, l, "cssc::to_float") btf;
        ciIdentIs(o, l, "cssc::float") bfc;
        ciIdentIs(o, l, "cssc::PI") bpi;
        ciIdentIs(o, l, "cssc::pi") bpi2;
        ciIdentIs(o, l, "cssc::sign") bsg;
        // cssc:: string builtins (reference parity: 20 pure string ops)
        ciIdentIs(o, l, "cssc::strlen") bslen;
        ciIdentIs(o, l, "cssc::upper") bsup;
        ciIdentIs(o, l, "cssc::lower") bslo;
        ciIdentIs(o, l, "cssc::trim") bstrim;
        ciIdentIs(o, l, "cssc::ltrim") bsltrim;
        ciIdentIs(o, l, "cssc::rtrim") bsrtrim;
        ciIdentIs(o, l, "cssc::substr") bssub;
        ciIdentIs(o, l, "cssc::replace") bsrep;
        ciIdentIs(o, l, "cssc::split") bsspl;
        ciIdentIs(o, l, "cssc::join") bsjoin;
        ciIdentIs(o, l, "cssc::contains") bscon;
        ciIdentIs(o, l, "cssc::starts_with") bssw;
        ciIdentIs(o, l, "cssc::ends_with") bsew;
        ciIdentIs(o, l, "cssc::index_of") bsidx;
        ciIdentIs(o, l, "cssc::last_index_of") bslidx;
        ciIdentIs(o, l, "cssc::char_at") bschar;
        ciIdentIs(o, l, "cssc::repeat") bsrpt;
        ciIdentIs(o, l, "cssc::reverse") bsrev;
        ciIdentIs(o, l, "cssc::pad_left") bspl;
        ciIdentIs(o, l, "cssc::pad_right") bspr;
        ciIdentIs(o, l, "cssc::push") bapush;
        ciIdentIs(o, l, "cssc::unshift") baunsh;
        ciIdentIs(o, l, "cssc::pop") bapop;
        ciIdentIs(o, l, "cssc::shift") bashift;
        ciIdentIs(o, l, "cssc::sort") basort;
        ciIdentIs(o, l, "cssc::reverse_arr") barevA;
        ciIdentIs(o, l, "cssc::slice") baslice;
        ciIdentIs(o, l, "cssc::concat") baconc;
        ciIdentIs(o, l, "cssc::unique") bauniq;
        ciIdentIs(o, l, "cssc::flatten") baflat;
        ciIdentIs(o, l, "cssc::range") barange;
        ciIdentIs(o, l, "cssc::zip_arr") bazip;
        ciIdentIs(o, l, "cssc::fill") bafill;
        ciIdentIs(o, l, "cssc::map_arr") bamap;
        ciIdentIs(o, l, "cssc::filter_arr") bafilt;
        ciIdentIs(o, l, "cssc::getIndex") bagidx;
        ciIdentIs(o, l, "cssc::find") bafind;
        ciIdentIs(o, l, "cssc::count") bacount;
        ciIdentIs(o, l, "cssc::sum") basum;
        ciIdentIs(o, l, "cssc::avg") baavg;
        ciAdvance();
        #stack[int, 32] handled = 0;
        if (ktru == 1) { left = 1; ciEvalType = 9; handled = 1; }                    // FX-BOOL: bool tag 9 -> prints true/false
        if (handled == 0) { if (kfls == 1) { left = 0; ciEvalType = 9; handled = 1; } }
        // ---- cssc::abs/min/max/clamp (integer) ----
        if (handled == 0) {
            if (bab == 1) {
                if (ciCur == 9) { ciAdvance(); }
                ciExpr(0) x;
                #stack[int, 64] xt = ciEvalType;
                if (ciCur == 10) { ciAdvance(); }
                if (xt == 2) { left = cssc::band(x, 0x7FFFFFFFFFFFFFFF); ciEvalType = 2; }
                if (xt != 2) { #stack[int, 64] v = x; if (v < 0) { v = 0 - v; } left = v; ciEvalType = 0; #delete[v]; }
                handled = 1;
                #delete[xt];
                #delete[x];
            }
        }
        // min/max/clamp: float-aware. If any operand is float, promote each int
        // via cssc::iToF and compare via cssc::fCmp; else integer compare.
        if (handled == 0) {
            if (bmn == 1) {
                if (ciCur == 9) { ciAdvance(); }
                ciExpr(0) a;
                #stack[int, 64] at = ciEvalType;
                if (ciCur == 21) { ciAdvance(); }
                ciExpr(0) b;
                #stack[int, 64] bt = ciEvalType;
                if (ciCur == 10) { ciAdvance(); }
                #stack[int, 32] fl = 0;
                if (at == 2) { fl = 1; }
                if (bt == 2) { fl = 1; }
                if (fl == 1) {
                    #stack[int, 64] fa = a;
                    #stack[int, 64] fb = b;
                    if (at != 2) { cssc::iToF(a) c; fa = c; #delete[c]; }
                    if (bt != 2) { cssc::iToF(b) c; fb = c; #delete[c]; }
                    cssc::fCmp(fb, fa) cmp;
                    left = a;
                    ciEvalType = at;
                    if (cmp == 0 - 1) { left = b; ciEvalType = bt; }
                    #delete[cmp];
                    #delete[fa];
                    #delete[fb];
                }
                if (fl == 0) { #stack[int, 64] v = a; if (b < v) { v = b; } left = v; ciEvalType = 0; #delete[v]; }
                handled = 1;
                #delete[fl];
                #delete[at];
                #delete[bt];
                #delete[a];
                #delete[b];
            }
        }
        if (handled == 0) {
            #stack[int, 32] isbit = 0;
            if (bband == 1) { isbit = 1; }
            if (bbor == 1) { isbit = 1; }
            if (bbxor == 1) { isbit = 1; }
            if (bshl == 1) { isbit = 1; }
            if (bshr == 1) { isbit = 1; }
            if (isbit == 1) {
                if (ciCur == 9) { ciAdvance(); }
                ciExpr(0) a;
                if (ciCur == 21) { ciAdvance(); }
                ciExpr(0) b;
                if (ciCur == 10) { ciAdvance(); }
                #stack[int, 64] rv = 0;
                if (bband == 1) { cssc::band(a, b) x; rv = x; #delete[x]; }
                if (bbor == 1) { cssc::bor(a, b) x; rv = x; #delete[x]; }
                if (bbxor == 1) { cssc::bxor(a, b) x; rv = x; #delete[x]; }
                if (bshl == 1) { cssc::shl(a, b) x; rv = x; #delete[x]; }
                if (bshr == 1) { cssc::shr(a, b) x; rv = x; #delete[x]; }
                left = rv;
                ciEvalType = 0;
                handled = 1;
                #delete[rv];
                #delete[a];
                #delete[b];
            }
            #delete[isbit];
        }
        if (handled == 0) {
            if (bmx == 1) {
                if (ciCur == 9) { ciAdvance(); }
                ciExpr(0) a;
                #stack[int, 64] at = ciEvalType;
                if (ciCur == 21) { ciAdvance(); }
                ciExpr(0) b;
                #stack[int, 64] bt = ciEvalType;
                if (ciCur == 10) { ciAdvance(); }
                #stack[int, 32] fl = 0;
                if (at == 2) { fl = 1; }
                if (bt == 2) { fl = 1; }
                if (fl == 1) {
                    #stack[int, 64] fa = a;
                    #stack[int, 64] fb = b;
                    if (at != 2) { cssc::iToF(a) c; fa = c; #delete[c]; }
                    if (bt != 2) { cssc::iToF(b) c; fb = c; #delete[c]; }
                    cssc::fCmp(fb, fa) cmp;
