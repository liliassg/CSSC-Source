                }
                if (mmfind == 1) { ciMapGet(iv, kaT, ka) r; if (ciMapFound == 1) { left = r; ciEvalType = ciMapRT; if (ciMapRT == 1) { leftOwns = 1; } } if (ciMapFound == 0) { left = 0; ciEvalType = 3; } #delete[r]; }
                if (mmat == 1) { ciMapGet(iv, kaT, ka) r; if (ciMapFound == 1) { left = r; ciEvalType = ciMapRT; if (ciMapRT == 1) { leftOwns = 1; } } if (ciMapFound == 0) { left = 0; ciEvalType = 3; } #delete[r]; }
                // ---- presence predicates: has -> int (map.has golden); contains/exists -> bool ----
                if (mmhas == 1) { ciMapGet(iv, kaT, ka) r; if (ciMapRT == 1) { cssc::free(r); } left = ciMapFound; ciEvalType = 0; #delete[r]; }
                if (mmcon == 1) { ciMapGet(iv, kaT, ka) r; if (ciMapRT == 1) { cssc::free(r); } left = ciMapFound; ciEvalType = 9; #delete[r]; }
                if (mmex == 1) { ciMapGet(iv, kaT, ka) r; if (ciMapRT == 1) { cssc::free(r); } left = ciMapFound; ciEvalType = 9; #delete[r]; }
                // ---- remove(k) -> removed value | null (mutates; exec-guarded) ----
                if (mmrem == 1) {
                    left = 0;
                    ciEvalType = 3;
                    if (ciExec == 1) {
                        ciMapRemove(iv, kaT, ka) r;
                        if (ciMapFound == 1) { left = r; ciEvalType = ciMapRT; if (ciMapRT == 1) { leftOwns = 1; } }
                        if (ciMapFound == 0) { left = 0; ciEvalType = 3; }
                        #delete[r];
                    }
                }
                #delete[mmsz];
                #delete[mmemp];
                #delete[mmkeys];
                #delete[mmvals];
                #delete[mmitems];
                #delete[mmfront];
                #delete[mmback];
                #delete[mmbegin];
                #delete[mmend];
                #delete[mmget];
                #delete[mmfind];
                #delete[mmat];
                #delete[mmcon];
                #delete[mmhas];
                #delete[mmex];
                #delete[mmrem];
                // ciMapGet/Remove never consume ka -> release the owned string key
                // temporary (borrowed var = owns 0). Free the get() default only
                // when it was NOT moved out as the result (daO cleared on move).
                if (kaO == 1) { if (kaT == 1) { if (ka != 0) { cssc::free(ka); } } }
                if (daO == 1) { if (daT == 1) { if (da != 0) { cssc::free(da); } } }
                #delete[ka];
                #delete[kaT];
                #delete[kaO];
                #delete[da];
                #delete[daT];
                #delete[daO];
                #delete[hasDef];
            }
            if (it == 7) {
                // bind read-methods: size/length/pairs (pair count), width
                // (pair_width), get/at (flat cell). Exactly one arm assigns
                // left (gotcha #2); int arms reset ciEvalType=0 (gotcha #1).
                #stack[int, 64] a0 = 0;
                if (ciCur == 9) {
                    ciAdvance();
                    if (ciCur != 10) { ciExpr(0) ae; a0 = ae; #delete[ae]; }
                    if (ciCur == 10) { ciAdvance(); }
                }
                ciIdentIs(mo, ml, "size") bsz;
                ciIdentIs(mo, ml, "length") bln;
                ciIdentIs(mo, ml, "pairs") bpr;
                ciIdentIs(mo, ml, "width") bwd;
                #stack[int, 32] wantSize = 0;
                if (bsz == 1) { wantSize = 1; }
                if (bln == 1) { wantSize = 1; }
                if (bpr == 1) { wantSize = 1; }
                if (wantSize == 1) { ciBindPairs(iv) r; left = r; ciEvalType = 0; #delete[r]; }
                if (wantSize != 1) {
                    if (bwd == 1) { ciBindWidth(iv) r; left = r; ciEvalType = 0; #delete[r]; }
                    if (bwd != 1) {
                        ciBindCellGet(iv, a0) r;
                        left = r;
                        ciEvalType = ciBindCellRT;
                        if (ciBindCellRT == 1) { leftOwns = 1; }
                        #delete[r];
                    }
                }
                #delete[wantSize];
                #delete[bsz];
                #delete[bln];
                #delete[bpr];
                #delete[bwd];
                #delete[a0];
            }
                if (cdFirst == 0) { if (cdPrevOwn == 1) { ciValFree(it, cdPrev); } }
                cdFirst = 0;
                #delete[iv];
                #delete[it];
                #delete[mo];
                #delete[ml];
                #delete[cdPrev];
                #delete[cdPrevOwn];
            }
        }
        #delete[cdc];
    }
    #delete[cdgo];
    #delete[cdFirst];
    // postfix method chaining on a STRING result: e.g. s.trim().length(). The
    // primary/dot dispatch above handled the FIRST `.method()` (receiver = a
    // variable via ciVarGet); each further `.method()` here dispatches on the
    // running `left` value directly, freeing an owned intermediate string once
    // consumed (so s.trim() -> ...length() leaves no leak).
    #stack[int, 32] chgo = 1;
    while (chgo == 1) {
        chgo = 0;
        if (ciCur == 33) {
            if (ciEvalType == 1) {
                ciAdvance();
                #stack[int, 64] cmo = ciTokOff;
                #stack[int, 64] cml = ciTokLen;
                if (ciCur == 2) { ciAdvance(); }
                #stack[int, 64] crecv = left;
                #stack[int, 32] crecvOwns = leftOwns;
                ciStrMethod(crecv, cmo, cml) cres;
                left = cres;
                leftOwns = ciEvalOwns;
                if (crecvOwns == 1) { if (crecv != 0) { cssc::free(crecv); } }
                chgo = 1;
                #delete[cres];
                #delete[crecv];
                #delete[crecvOwns];
                #delete[cmo];
                #delete[cml];
            }
        }
    }
    #delete[chgo];
    #stack[int, 64] leftType = ciEvalType;
    #stack[int, 32] go = 1;
    while (go == 1) {
        #stack[int, 64] op = ciCur;
        // precedence: || (1) < && (2) < comparison (3) < +/- (4) < * / % (5)
        #stack[int, 64] prec = 0;
        if (op == 6) { prec = 5; }
        if (op == 7) { prec = 5; }
        if (op == 8) { prec = 5; }
        if (op == 4) { prec = 4; }
        if (op == 5) { prec = 4; }
        if (op == 15) { prec = 3; }
        if (op == 16) { prec = 3; }
        if (op == 17) { prec = 3; }
        if (op == 18) { prec = 3; }
        if (op == 19) { prec = 3; }
        if (op == 20) { prec = 3; }
        if (op == 25) { prec = 2; }
        if (op == 26) { prec = 1; }
        if (prec == 0) { go = 0; }
        if (prec < minPrec) { go = 0; }
        if (go == 1) {
            ciAdvance();
            ciExpr(prec + 1) right;
            #stack[int, 64] rightType = ciEvalType;
            // ownership of the right operand, captured before any further eval
            #stack[int, 32] rightOwns = ciEvalOwns;
            #stack[int, 32] didStr = 0;
            #stack[int, 32] didFloat = 0;
            #stack[int, 32] didNull = 0;   // FX-INTDIV0: integer / or % by 0 -> null (0x0)
            // float coercion: if either operand is a float (tag 2), promote the
            // int operand via cssc::iToF and use the float intrinsics; the result
            // of arithmetic is a float, of a comparison an int.
            #stack[int, 32] isFloat = 0;
            if (leftType == 2) { isFloat = 1; }
            if (rightType == 2) { isFloat = 1; }
            #stack[int, 64] la = left;
            #stack[int, 64] ra = right;
            if (isFloat == 1) {
                if (leftType != 2) { cssc::iToF(left) tl; la = tl; #delete[tl]; }
                if (rightType != 2) { cssc::iToF(right) tr; ra = tr; #delete[tr]; }
            }
            if (op == 4) {
                #stack[int, 32] isStr = 0;
                if (leftType == 1) { isStr = 1; }
                if (rightType == 1) { isStr = 1; }
                if (isStr == 1) {
                    ciStrConcat(left, leftType, right, rightType) nc;
                    // concat consumes its operands: free any this expression
                    // owned (borrows of variables are left untouched)
                    if (leftOwns == 1) { cssc::free(left); }
                    if (rightOwns == 1) { if (right != left) { cssc::free(right); } }
                    left = nc;
                    leftType = 1;
                    leftOwns = 1;
                    didStr = 1;
                    #delete[nc];
                }
                if (isStr == 0) {
                    if (isFloat == 1) { cssc::fAdd(la, ra) r; left = r; leftType = 2; didFloat = 1; #delete[r]; }
                    if (isFloat == 0) { left = left + right; }
                }
                #delete[isStr];
            }
            if (op == 5) {
                if (isFloat == 1) { cssc::fSub(la, ra) r; left = r; leftType = 2; didFloat = 1; #delete[r]; }
                if (isFloat == 0) { left = left - right; }
            }
            if (op == 6) {
                if (isFloat == 1) { cssc::fMul(la, ra) r; left = r; leftType = 2; didFloat = 1; #delete[r]; }
                if (isFloat == 0) { left = left * right; }
            }
            if (op == 7) {
                if (isFloat == 1) { cssc::fDiv(la, ra) r; left = r; leftType = 2; didFloat = 1; #delete[r]; }
                if (isFloat == 0) {
                    cssc::iToF(left) lf;
                    cssc::iToF(right) rf;
                    cssc::fDiv(lf, rf) r;
                    left = r;
                    leftType = 2;
                    didFloat = 1;
                    #delete[lf];
                    #delete[rf];
                    #delete[r];
                }
            }
            if (op == 8) {
                if (isFloat == 1) { cssc::fMod(la, ra) r; left = r; leftType = 2; didFloat = 1; #delete[r]; }
                if (isFloat == 0) {
                    if (right == 0) { left = 0; didNull = 1; }
                    if (right != 0) {
                        #stack[int, 64] rm = left % right;
                        if (rm != 0) {
                            #stack[int, 32] rn = 0;
                            if (rm < 0) { rn = 1; }
                            #stack[int, 32] ln = 0;
                            if (left < 0) { ln = 1; }
                            if (rn != ln) { rm = rm - right; }
                            #delete[rn];
                            #delete[ln];
                        }
                        left = rm;
                        #delete[rm];
                    }
                }
            }
            #stack[int, 64] t = 0;
            #stack[int, 32] isCmp = 0;
            if (op >= 15) { if (op <= 20) { isCmp = 1; } }
            if (isCmp == 1) {
                #stack[int, 32] bothStr = 0;
                if (leftType == 1) { if (rightType == 1) { bothStr = 1; } }
                if (bothStr == 1) {
                    ciStrCmp(left, right) cmp;
                    if (op == 15) { if (cmp == 0) { t = 1; } }
                    if (op == 16) { if (cmp != 0) { t = 1; } }
                    if (op == 17) { if (cmp < 0) { t = 1; } }
                    if (op == 18) { if (cmp > 0) { t = 1; } }
                    if (op == 19) { if (cmp <= 0) { t = 1; } }
                    if (op == 20) { if (cmp >= 0) { t = 1; } }
                    if (leftOwns == 1) { cssc::free(left); }
                    if (rightOwns == 1) { if (right != left) { cssc::free(right); } }
                    #delete[cmp];
                }
                if (bothStr == 0) {
                    if (isFloat == 1) {
                        // ordered compare: -1 less / 0 equal / 1 greater / 2 NaN
                        cssc::fCmp(la, ra) cmp;
                        if (op == 15) { if (cmp == 0) { t = 1; } }
                        if (op == 16) { if (cmp != 0) { t = 1; } }
                        if (op == 17) { if (cmp == 0 - 1) { t = 1; } }
                        if (op == 18) { if (cmp == 1) { t = 1; } }
                        if (op == 19) { if (cmp == 0 - 1) { t = 1; } if (cmp == 0) { t = 1; } }
                        if (op == 20) { if (cmp == 1) { t = 1; } if (cmp == 0) { t = 1; } }
                        #delete[cmp];
                    }
                    if (isFloat == 0) {
                        if (op == 15) { if (left == right) { t = 1; } }
                        if (op == 16) { if (left != right) { t = 1; } }
                        if (op == 17) { if (left < right) { t = 1; } }
                        if (op == 18) { if (left > right) { t = 1; } }
                        if (op == 19) { if (left <= right) { t = 1; } }
                        if (op == 20) { if (left >= right) { t = 1; } }
                    }
                }
                left = t;
                #delete[bothStr];
            }
            // logical and/or -> 1/0 (both operands computed; true short-circuit
            // + operand-return arrives in L1 once expressions can have effects)
            if (op == 25) {
                #stack[int, 32] r2 = 0;
                if (left != 0) { if (right != 0) { r2 = 1; } }
                left = r2;
                #delete[r2];
            }
            if (op == 26) {
                #stack[int, 32] r2 = 0;
                if (left != 0) { r2 = 1; }
                if (right != 0) { r2 = 1; }
                left = r2;
                #delete[r2];
            }
            // non-concat, non-float operators yield an int result (owns nothing);
            // a float arithmetic result keeps tag 2 (didFloat). Comparisons
            // (15-20) and boolean ops (25 &&, 26 ||) yield a BOOL (tag 9 ->
            // prints true/false) -- the value stays 1/0 internally.
            if (didStr == 0) {
                #stack[int, 32] isBoolRes = isCmp;
                if (op == 25) { isBoolRes = 1; }
                if (op == 26) { isBoolRes = 1; }
                if (isBoolRes == 1) { leftType = 9; }
                if (isBoolRes == 0) { if (didFloat == 0) { leftType = 0; if (didNull == 1) { leftType = 3; } } }
                leftOwns = 0;
                #delete[isBoolRes];
            }
            #delete[la];
            #delete[ra];
            #delete[isFloat];
            #delete[didFloat];
            #delete[didNull];
            #delete[t];
            #delete[isCmp];
            #delete[didStr];
            #delete[rightOwns];
            #delete[rightType];
            #delete[right];
        }
        #delete[op];
        #delete[prec];
    }
    #delete[go];
    ciEvalType = leftType;
    ciEvalOwns = leftOwns;
    #delete[leftType];
    #delete[leftOwns];
    #delete[ciC0];
    return left;
}
