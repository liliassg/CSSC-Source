                    ciIdentIs(mmo, mml, "clamp") mCl2;
                    ciIdentIs(mmo, mml, "minf") mMn;
                    ciIdentIs(mmo, mml, "maxf") mMx;
                    ciIdentIs(mmo, mml, "smoothstep") mSs;
                    ciIdentIs(mmo, mml, "smootherstep") mSs2;
                    ciIdentIs(mmo, mml, "valueNoise2") mVn;
                    ciIdentIs(mmo, mml, "fbm2") mFb;
                    ciIdentIs(mmo, mml, "available") mAv;
                    if (ciCur == 9) { ciAdvance(); }
