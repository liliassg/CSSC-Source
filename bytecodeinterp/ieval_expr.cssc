                        if (tca == 1) {
                            #stack[int, 64] cols = cssc::peek32(a1 + 8);
                            #stack[int, 64] rows = cssc::peek32(a1 + 12);
                            #stack[int, 64] tw = cssc::peek32(a1 + 16);
                            #stack[int, 64] th = cssc::peek32(a1 + 20);
                            #stack[int, 64] data = cssc::peek64(a1 + 24);
                            #stack[int, 64] solids = cssc::peek64(a1 + 32);
                            #stack[int, 32] run = 1;
                            if (a4 <= 0) { run = 0; }
