        #delete[kapush]; #delete[kaunsh]; #delete[kapop]; #delete[kashift];
        #delete[kasort]; #delete[karev]; #delete[kaslice]; #delete[kaconc];
        #delete[kauniq]; #delete[kaflat]; #delete[karange]; #delete[kazip];
        #delete[kafill]; #delete[kamap]; #delete[kafilt]; #delete[kagidx];
        #delete[kafind]; #delete[kacount]; #delete[kasum]; #delete[kaavg];
        #delete[ciModId];
        #delete[kret];
        #delete[ksec];
        #delete[kobj];
        #delete[kmir];
        #delete[kdes];
        #delete[kbrk];
        #delete[ksel];
        #delete[kjmp];
        #delete[o];
        #delete[l];
        done = 1;
    }
    }
    // fail-safe: an unhandled token (stray ':', '?', '(' after an unknown
    // function, garbage) must still make progress -- a non-consuming ciStmt
    // would spin the driver loops forever on bare metal
    if (done == 0) {
        if (ciCur != 0) { ciAdvance(); }
    }
    #delete[done];
}

#define(ciDoSys) {
    #req[ciExpr] ciExpr;
    #req[ciEvalType] ciEvalType;
    #req[ciEvalOwns] ciEvalOwns;
    #req[ciVarSet] ciVarSet;
    #req[ciValFree] ciValFree;
    #req[ciCur] ciCur;
    #req[ciTokOff] ciTokOff;
    #req[ciTokLen] ciTokLen;
    #req[ciAdvance] ciAdvance;
    #req[ciExec] ciExec;
    ciExpr(0) sv;
    #stack[int, 64] st = ciEvalType;
    #stack[int, 64] so = ciEvalOwns;
    #stack[int, 32] bound = 0;
    if (ciCur == 2) {
        #stack[int, 64] co = ciTokOff;
        #stack[int, 64] cl = ciTokLen;
        ciAdvance();
        if (ciExec == 1) { ciVarSet(co, cl, sv, st, so); bound = 1; }
        #delete[co];
        #delete[cl];
    }
    if (bound == 0) { if (so == 1) { ciValFree(st, sv); } }
    if (ciCur == 13) { ciAdvance(); }
    #delete[bound];
    #delete[sv];
    #delete[st];
    #delete[so];
    return 0;
}

#define(ciLineAt) {
    #scanp(ciLineAt, int, 0) off;
    #req[ciSrc] ciSrc;
    #stack[int, 64] ln = 1;
    #stack[int, 32] i = 0;
    while (i < off) {
        if (cssc::peek8(ciSrc + i) == 10) { ln = ln + 1; }
        i = i + 1;
    }
    #delete[i];
    return ln;
}

#define(ciAppLit) {
    #scanp(ciAppLit, int, 0) buf;
    #scanp(ciAppLit, int, 1) at;
    #scanp(ciAppLit, int, 2) lit;
    #stack[int, 64] j = at;
    #stack[int, 32] k = 0;
    #stack[int, 32] go = 1;
    while (go == 1) {
        #stack[int, 64] c = cssc::peek8(lit + k);
        if (c == 0) { go = 0; }
        if (go == 1) { cssc::poke8(buf + j, c); j = j + 1; k = k + 1; }
        #delete[c];
    }
    #delete[go];
    #delete[k];
    return j;
}

#define(ciRaise) {
    #scanp(ciRaise, int, 0) detailPtr;
    #scanp(ciRaise, int, 1) detailLen;
    #scanp(ciRaise, int, 2) line;
    #scanp(ciRaise, int, 3) kind;
    #req[ciFaultMsg] ciFaultMsg;
    #req[ciFaultKind] ciFaultKind;
    #req[ciFaultLine] ciFaultLine;
    #req[ciSignal] ciSignal;
    #req[ciExec] ciExec;
    #req[ciAppLit] ciAppLit;
    if (ciExec == 1) {
        if (ciSignal != 7) {
            #stack[int, 64] full = cssc::alloc(detailLen + 24);
            cssc::poke32(full, 1);
            cssc::poke32(full + 4, detailLen + 11);
            #stack[int, 64] pf = ciAppLit(full + 8, 0, "CsscError: ");
            #stack[int, 32] i = 0;
            while (i < detailLen) {
                cssc::poke8(full + 8 + pf + i, cssc::peek8(detailPtr + i));
                i = i + 1;
            }
            #delete[i];
            #delete[pf];
            if (ciFaultMsg != 0) { cssc::free(ciFaultMsg); }
            ciFaultMsg = full;
            ciFaultKind = kind;
            ciFaultLine = line;
            ciSignal = 7;
        }
    }
    return 0;
}

#define(ciRaiseNamed) {
    #scanp(ciRaiseNamed, int, 0) lit;
    #scanp(ciRaiseNamed, int, 1) nameAddr;
    #scanp(ciRaiseNamed, int, 2) nameLen;
    #scanp(ciRaiseNamed, int, 3) line;
    #req[ciAppLit] ciAppLit;
    #req[ciRaise] ciRaise;
    #stack[int, 64] db = cssc::alloc(nameLen + 512);
    #stack[int, 64] p = ciAppLit(db, 0, lit);
    #stack[int, 32] q = 0;
    while (q < nameLen) {
        cssc::poke8(db + p + q, cssc::peek8(nameAddr + q));
        q = q + 1;
    }
    #delete[q];
    #stack[int, 64] tot = p + nameLen;
    ciRaise(db, tot, line, 0);
    cssc::free(db);
    #delete[p];
    #delete[tot];
    return 0;
}

#define(ciRaiseSector) {
    #scanp(ciRaiseSector, int, 0) nameAddr;
    #scanp(ciRaiseSector, int, 1) nameLen;
    #scanp(ciRaiseSector, int, 2) line;
    #req[ciAppLit] ciAppLit;
    #req[ciRaise] ciRaise;
    #stack[int, 64] db = cssc::alloc(nameLen + nameLen + 600);
    #stack[int, 64] p1 = ciAppLit(db, 0, "Unknown sector: ");
    #stack[int, 32] q = 0;
    while (q < nameLen) {
        cssc::poke8(db + p1 + q, cssc::peek8(nameAddr + q));
        q = q + 1;
    }
    #delete[q];
    #stack[int, 64] p2 = p1 + nameLen;
    #stack[int, 64] p3 = ciAppLit(db, p2, " (declare, #include or #load it before `");
    #stack[int, 32] q2 = 0;
    while (q2 < nameLen) {
        cssc::poke8(db + p3 + q2, cssc::peek8(nameAddr + q2));
        q2 = q2 + 1;
    }
    #delete[q2];
    #stack[int, 64] p4 = p3 + nameLen;
    #stack[int, 64] p5 = ciAppLit(db, p4, "::` access)");
    ciRaise(db, p5, line, 0);
    cssc::free(db);
    #delete[p1];
    #delete[p2];
    #delete[p3];
    #delete[p4];
    #delete[p5];
    return 0;
}

#define(ciRaiseMsg) {
    #scanp(ciRaiseMsg, int, 0) lit;
    #scanp(ciRaiseMsg, int, 1) line;
    #scanp(ciRaiseMsg, int, 2) kind;
    #req[ciAppLit] ciAppLit;
    #req[ciRaise] ciRaise;
    #stack[int, 64] db = cssc::alloc(512);
    #stack[int, 64] p = ciAppLit(db, 0, lit);
    ciRaise(db, p, line, kind);
    cssc::free(db);
    #delete[p];
    return 0;
}

#define(ciReportFault) {
    #req[ciFaultMsg] ciFaultMsg;
    #req[ciFaultKind] ciFaultKind;
    #req[ciFaultLine] ciFaultLine;
    #req[ciSrcPath] ciSrcPath;
    #req[ciSrcPathLen] ciSrcPathLen;
    #req[ciAppLit] ciAppLit;
    #req[ciItoa] ciItoa;
    if (ciFaultMsg != 0) {
        #stack[int, 64] buf = cssc::alloc(4096);
        #stack[int, 64] n = ciAppLit(buf, 0, "CSSC ");
        if (ciFaultKind == 1) { n = ciAppLit(buf, n, "PANIC"); }
        if (ciFaultKind == 2) { n = ciAppLit(buf, n, "Parser"); }
        if (ciFaultKind == 0) { n = ciAppLit(buf, n, "Runtime"); }
        n = ciAppLit(buf, n, " Error");
        if (ciSrcPathLen > 0) {
            n = ciAppLit(buf, n, " in ");
            #stack[int, 32] pi = 0;
            while (pi < ciSrcPathLen) {
                cssc::poke8(buf + n, cssc::peek8(ciSrcPath + pi));
                n = n + 1;
                pi = pi + 1;
            }
            #delete[pi];
        }
        if (ciFaultLine > 0) {
            n = ciAppLit(buf, n, " line ");
            #stack[int, 64] nb = cssc::alloc(32);
            #stack[int, 64] nl = ciItoa(ciFaultLine, nb);
            #stack[int, 32] li = 0;
            while (li < nl) {
                cssc::poke8(buf + n, cssc::peek8(nb + li));
                n = n + 1;
                li = li + 1;
            }
            #delete[li];
            #delete[nl];
            cssc::free(nb);
        }
        n = ciAppLit(buf, n, ": ");
        #stack[int, 64] dl = cssc::peek32(ciFaultMsg + 4);
        #stack[int, 64] dd = ciFaultMsg + 8 + 11;
        #stack[int, 32] di = 0;
        while (di < dl - 11) {
            cssc::poke8(buf + n, cssc::peek8(dd + di));
            n = n + 1;
            di = di + 1;
        }
        #delete[di];
        #delete[dl];
        #delete[dd];
        cssc::poke8(buf + n, 10);
        n = n + 1;
        cssc::hostErr(buf, n);
        cssc::free(buf);
        #delete[n];
    }
    return 0;
}

#define(ciRun) {
    #scanp(ciRun, int, 0) buf;
    #scanp(ciRun, int, 1) len;
    #req[ciSrc] ciSrc;
    #req[ciSrcLen] ciSrcLen;
    #req[ciPos] ciPos;
    #req[ciCur] ciCur;
    #req[ciVCount] ciVCount;
    #req[ciVVals] ciVVals;
    #req[ciVTypes] ciVTypes;
    #req[ciVOwns] ciVOwns;
    #req[ciExec] ciExec;
    #req[ciScopeBase] ciScopeBase;
    #req[ciFnCount] ciFnCount;
    #req[ciFnInjCnt] ciFnInjCnt;
    #req[ciSignal] ciSignal;
    #req[ciSecCount] ciSecCount;
    #req[ciCurSecOff] ciCurSecOff;
    #req[ciCurSecLen] ciCurSecLen;
    #req[ciSecInit] ciSecInit;
    #req[ciSecVis] ciSecVis;
    #req[ciBindVis] ciBindVis;
    #req[ciBindBits] ciBindBits;
    #req[ciSetMode] ciSetMode;
    #req[ciObjCount] ciObjCount;
    #req[ciLabCount] ciLabCount;
    #req[ciCurInst] ciCurInst;
    #req[ciCurObj] ciCurObj;
    #req[ciLastInst] ciLastInst;
    #req[ciLastObj] ciLastObj;
    #req[ciObjInit] ciObjInit;
    #req[ciMirrored] ciMirrored;
    #req[ciInstFree] ciInstFree;
    #req[ciValFree] ciValFree;
    #req[ciAdvance] ciAdvance;
    #req[ciStmt] ciStmt;
    #req[ciReportFault] ciReportFault;
    #req[ciModVideo] ciModVideo;
    #req[ciModSound] ciModSound;
    #req[ciModIni] ciModIni;
    #req[ciModStdio] ciModStdio;
    #req[ciModSys] ciModSys;
    #req[ciModKey] ciModKey;
    #req[ciModSprite] ciModSprite;
    #req[ciModTilemap] ciModTilemap;
    #req[ciModFont] ciModFont;
    #req[ciModMathAccel] ciModMathAccel;
    #req[ciModCsscMath] ciModCsscMath;
    #req[ciModConsole] ciModConsole;
    #req[ciModDev] ciModDev;
    #req[ciModGrace] ciModGrace;
    #req[ciModStdout] ciModStdout;
    #req[ciModMouse] ciModMouse;
    #req[ciMsCurr] ciMsCurr;
    #req[ciMsPrev] ciMsPrev;
    #req[ciDevStdout] ciDevStdout;
    #req[ciFaultMsg] ciFaultMsg;
    #req[ciFaultKind] ciFaultKind;
    #req[ciFaultLine] ciFaultLine;
    #req[ciAlCount] ciAlCount;
    #req[ciDefLoaded] ciDefLoaded;
    #req[ciSndSlots] ciSndSlots;
    #req[ciSndNextId] ciSndNextId;
    #req[ciSndVolume] ciSndVolume;
    #req[ciKbCurr] ciKbCurr;
    #req[ciKbPrev] ciKbPrev;
    #req[ciKbEdge] ciKbEdge;
    #req[ciKbTail] ciKbTail;
    #req[ciKbExt] ciKbExt;
    #req[keyHead] keyHead;
    #req[ciSrcBuf] ciSrcBuf;
    #req[ciSrcUsed] ciSrcUsed;
    #req[ciMainEnd] ciMainEnd;
    #req[ciLoadCount] ciLoadCount;
    #req[ciTokOff] ciTokOff;
    #req[ciTokCount] ciTokCount;
    #req[ciTokenize] ciTokenize;
    // deterministic REPL reset: free EVERY owned heap value the *previous*
    // program left in the global frame -- strings, object instances AND
    // containers (vector/map/bind, incl. nested) -- before wiping the table.
    // Missing the containers here was the cross-run leak that slowed the whole
    // OS down after repeatedly running a container-using script (test_file.cssc).
    #stack[int, 32] pi = 0;
    while (pi < ciVCount) {
        #stack[int, 64] pt = cssc::peek64(ciVTypes + pi * 8);
        #stack[int, 64] po = cssc::peek64(ciVOwns + pi * 8);
        #stack[int, 64] pv = cssc::peek64(ciVVals + pi * 8);
        if (po == 1) { ciValFree(pt, pv); }
        #delete[pt];
        #delete[po];
        #delete[pv];
        pi = pi + 1;
    }
    #delete[pi];
    // copy the program into the master buffer (cap 65536) so #load can append
    // other files after it; ciSrc points at the master buffer for the whole run
    #stack[int, 64] clen = len;
    if (clen > 524288) { clen = 524288; }
    #stack[int, 32] cci = 0;
    while (cci < clen) {
        cssc::poke8(ciSrcBuf + cci, cssc::peek8(buf + cci));
        cci = cci + 1;
    }
    #delete[cci];
    ciSrc = ciSrcBuf;
    ciSrcLen = clen;
    ciMainEnd = clen;
    ciSrcUsed = clen;
    ciLoadCount = 0;
    #delete[clen];
    // pre-tokenize the whole program ONCE (ciPos is the BYTE cursor here); parsing
    // below then walks token indices with zero re-lexing. #load appends more tokens.
    ciTokCount = 0;
    ciPos = 0;
    ciTokenize();
    ciPos = 0;
    ciVCount = 0;
    ciExec = 1;
    // reset per-run state: fresh functions, global frame, no pending return,
    // and the whole L3 sector context (source spans are per-run)
    ciScopeBase = 0;
    ciFnCount = 0;
    cssc::memfill32(ciFnInjCnt, 0, 4096);
    ciSignal = 0;
    ciSecCount = 0;
    ciCurSecOff = 0;
    ciCurSecLen = 0;
    ciSecInit = 0;
    ciSecVis = 0;
    ciBindVis = 1;
    ciBindBits = 64;
    ciSetMode = 0;
    ciObjCount = 0;
    ciLabCount = 0;
    // native modules start disabled each run (must be #include'd) and no sound
    // leaks across runs
    ciModVideo = 0;
    ciModSound = 0;
    ciModIni = 0;
    ciModStdio = 0;
    ciModSys = 0;
    ciModKey = 0;
    ciModSprite = 0;
    ciModTilemap = 0;
    ciModFont = 0;
    ciModMathAccel = 0;
    ciModCsscMath = 0;
    // stdlib modules: fresh each run. dev::stdout is freed + recreated per run
    // (persistent WITHIN a run, never leaked ACROSS runs); fault channel cleared.
    ciModConsole = 0;
    ciModDev = 0;
    ciModGrace = 0;
    ciModStdout = 0;
    ciModMouse = 0;
    ciMsCurr = 0;
    ciMsPrev = 0;
    if (ciDevStdout != 0) { ciValFree(4, ciDevStdout); ciDevStdout = 0; }
    if (ciFaultMsg != 0) { cssc::free(ciFaultMsg); ciFaultMsg = 0; }
    ciFaultKind = 0;
    ciFaultLine = 0;
    ciDefLoaded = 0;
    ciAlCount = 0;
    // ciSndSlots is a per-run table; alloc returns recycled (non-zeroed) heap, so the
    // free-slot scan needs a clean slate every program or load() finds no free slot.
    ciSndNextId = 0;
    ciSndVolume = 100;
    cssc::memfill32(ciSndSlots, 0, 128);
    cssc::memfill32(ciKbCurr, 0, 64);
    cssc::memfill32(ciKbPrev, 0, 64);
    cssc::memfill32(ciKbEdge, 0, 64);
    ciKbTail = keyHead;
    ciKbExt = 0;
    cssc::outb(0x61, cssc::band(cssc::inb(0x61), 252));
    ciCurInst = 0;
    ciCurObj = 0;
    ciLastInst = 0;
    ciLastObj = 0;
    ciObjInit = 0;
    ciMirrored = 0;
    ciAdvance();
    #stack[int, 32] go = 1;
    while (go == 1) {
        if (ciCur == 0) { go = 0; }
        // stop at the ORIGINAL program's end -- #load may have extended ciSrcLen
        // with library code (already run at #load time), which must not re-run
        if (ciTokOff >= ciMainEnd) { go = 0; }
        // only a top-level `return` ends the program; stray destruct/break
        // outside any label/loop are consumed as inert
        if (ciSignal == 2) { go = 0; }
        if (ciSignal == 7) { go = 0; }
        if (ciSignal >= 3) { if (ciSignal != 7) { ciSignal = 0; } }
        if (go == 1) {
            ciStmt();
        }
    }
    #delete[go];
    if (ciSignal == 7) { ciReportFault(); }
}