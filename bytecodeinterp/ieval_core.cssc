                            #stack[int, 64] rp = ciPos;
                            #stack[int, 64] rc = ciCur;
                            #stack[int, 64] rtn = ciTokNum;
                            #stack[int, 64] rto = ciTokOff;
                            #stack[int, 64] rtl = ciTokLen;
                            #stack[int, 64] rsg = ciSignal;
                            ciSrcLen = aend;
                            // advance ciSrcUsed BEFORE running the module top-level, so a
