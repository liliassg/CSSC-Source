#define(ciStmt) {
    #req[ciCur] ciCur;
    #req[ciTokOff] ciTokOff;
    #req[ciTokLen] ciTokLen;
    #req[ciTokNum] ciTokNum;
    #req[ciPos] ciPos;
    #req[ciExec] ciExec;
    #req[ciEvalType] ciEvalType;
    #req[ciAdvance] ciAdvance;
    #req[ciStmt] ciStmt;
    #req[ciDoDecl] ciDoDecl;
    #req[ciIdentIs] ciIdentIs;
    #req[ciDoPrint] ciDoPrint;
    #req[ciDoPoke] ciDoPoke;
    #req[ciDoVideo] ciDoVideo;
    #req[ciDoSound] ciDoSound;
    #req[ciDoKey] ciDoKey;
    #req[ciDoIni] ciDoIni;
    #req[ciDoStdio] ciDoStdio;
    #req[ciDoSys] ciDoSys;
    #req[ciDoSprite] ciDoSprite;
    #req[ciDoTilemap] ciDoTilemap;
    #req[ciDoFont] ciDoFont;
    #req[ciDoMouse] ciDoMouse;
    #req[ciDoConsole] ciDoConsole;
    #req[ciMsMethod] ciMsMethod;
    #req[ciConSyncDrain] ciConSyncDrain;
    #req[ciModConsole] ciModConsole;
    #req[ciModDev] ciModDev;
    #req[ciModGrace] ciModGrace;
    #req[ciModStdout] ciModStdout;
    #req[ciModMouse] ciModMouse;
    #req[ciDevStdout] ciDevStdout;
    #req[ciFaultMsg] ciFaultMsg;
    #req[ciFaultKind] ciFaultKind;
    #req[ciBindNew] ciBindNew;
    #req[ciBindRawSet] ciBindRawSet;
    #req[ciItoa] ciItoa;
    #req[ciContFmt] ciContFmt;
    #req[ciTokFloat] ciTokFloat;
    #req[termTypeRaw] termTypeRaw;
    #req[termNewline] termNewline;
    #req[mouseX] mouseX;
    #req[mouseY] mouseY;
    #req[mouseFlags] mouseFlags;
    #req[ciModOf] ciModOf;
    #req[keyBufAddr] keyBufAddr;
    #req[keyHead] keyHead;
    #req[ciModVideo] ciModVideo;
    #req[ciModSound] ciModSound;
    #req[ciModIni] ciModIni;
    #req[ciModStdio] ciModStdio;
    #req[ciModSys] ciModSys;
    #req[ciModKey] ciModKey;
    #req[ciModSprite] ciModSprite;
    #req[ciModTilemap] ciModTilemap;
    #req[ciModFont] ciModFont;
    #req[ciModMathAccel] ciModMathAccel;
    #req[ciModCsscMath] ciModCsscMath;
    #req[ciDefLoaded] ciDefLoaded;
    #req[ciAlOff] ciAlOff;
    #req[ciAlLen] ciAlLen;
    #req[ciAlMod] ciAlMod;
    #req[ciAlCount] ciAlCount;
    #req[ciSrcBuf] ciSrcBuf;
    #req[ciSrcUsed] ciSrcUsed;
    #req[ciSrcLen] ciSrcLen;
    #req[ciMainEnd] ciMainEnd;
    #req[ciLoadName] ciLoadName;
    #req[ciLoadFnS] ciLoadFnS;
    #req[ciLoadFnE] ciLoadFnE;
    #req[ciLoadCount] ciLoadCount;
    #req[ciFnLens] ciFnLens;
    #req[ciTokCount] ciTokCount;
    #req[ciTokenize] ciTokenize;
    #req[fsFind] fsFind;
    #req[fsIdx] fsIdx;
    #req[fsData] fsData;
    #req[fsSizes] fsSizes;
    #req[fsCreate] fsCreate;
    #req[fsStore] fsStore;
    #req[ciDoAssign] ciDoAssign;
    #req[ciEvalOwns] ciEvalOwns;
    #req[ciExpr] ciExpr;
    #req[ciFnFind] ciFnFind;
    #req[ciFnBodyStart] ciFnBodyStart;
    #req[ciFnInjCnt] ciFnInjCnt;
    #req[ciFnInjStart] ciFnInjStart;
    #req[ciFnInjEnd] ciFnInjEnd;
    #req[ciFnBodyEnd] ciFnBodyEnd;
    #req[ciFnNames] ciFnNames;
    #req[ciFnParCnt] ciFnParCnt;
    #req[ciFnParOff] ciFnParOff;
    #req[ciFnParLen] ciFnParLen;
    #req[ciFnRegister] ciFnRegister;
    #req[ciQualBuf] ciQualBuf;
    #req[ciRegSecOff] ciRegSecOff;
    #req[ciRegSecLen] ciRegSecLen;
    #req[ciBindVis] ciBindVis;
    #req[ciVarSet] ciVarSet;
    #req[ciVecNew] ciVecNew;
    #req[ciVecPush] ciVecPush;
    #req[ciVecPushRef] ciVecPushRef;
    #req[ciVecSet] ciVecSet;
    #req[ciVecClear] ciVecClear;
    #req[ciVecPop] ciVecPop;
    #req[ciVecPopFront] ciVecPopFront;
    #req[ciVecPopType] ciVecPopType;
    #req[ciMapSet] ciMapSet;
    #req[ciMapClear] ciMapClear;
    #req[ciMapRemove] ciMapRemove;
    #req[ciMapAppend] ciMapAppend;
    #req[ciMapRT] ciMapRT;
    #req[ciMapFound] ciMapFound;
    #req[ciBindAddmap] ciBindAddmap;
    #req[ciBindClear] ciBindClear;
    #req[ciBindCellSet] ciBindCellSet;
    #req[ciScopeBase] ciScopeBase;
    #req[ciVCount] ciVCount;
    #req[ciVVals] ciVVals;
    #req[ciVTypes] ciVTypes;
    #req[ciVOwns] ciVOwns;
    #req[ciArgVals] ciArgVals;
    #req[ciArgTypes] ciArgTypes;
    #req[ciArgOwns] ciArgOwns;
    #req[ciArgCount] ciArgCount;
    #req[ciSignal] ciSignal;
    #req[ciRetVal] ciRetVal;
    #req[ciRetType] ciRetType;
    #req[ciRetOwns] ciRetOwns;
    #req[ciSrc] ciSrc;
    #req[ciVNames] ciVNames;
    #req[ciVLens] ciVLens;
    #req[ciVVis] ciVVis;
    #req[ciFnNames] ciFnNames;
    #req[ciFnLens] ciFnLens;
    #req[ciFnCount] ciFnCount;
    #req[ciFnSecOff] ciFnSecOff;
    #req[ciFnSecLen] ciFnSecLen;
    #req[ciFnVis] ciFnVis;
    #req[ciCurSecOff] ciCurSecOff;
    #req[ciCurSecLen] ciCurSecLen;
    #req[ciSecInit] ciSecInit;
    #req[ciSecVis] ciSecVis;
    #req[ciSecCount] ciSecCount;
    #req[ciSecNameOff] ciSecNameOff;
    #req[ciSecNameLen] ciSecNameLen;
    #req[ciSecBodyS] ciSecBodyS;
    #req[ciSecBodyE] ciSecBodyE;
    #req[ciSecFreeS] ciSecFreeS;
    #req[ciSecFreeE] ciSecFreeE;
    #req[ciSecFreed] ciSecFreed;
    #req[ciSecDefer] ciSecDefer;
    #req[ciSecLabOff] ciSecLabOff;
    #req[ciSecLabLen] ciSecLabLen;
    #req[ciQualBuf] ciQualBuf;
    #req[ciQualify] ciQualify;
    #req[ciTokHasCC] ciTokHasCC;
    #req[ciSecPrefixIs] ciSecPrefixIs;
    #req[ciSecFind] ciSecFind;
    #req[ciSecFindLab] ciSecFindLab;
    #req[ciVarFind] ciVarFind;
    #req[ciVarGet] ciVarGet;
    #req[ciVarDrop] ciVarDrop;
    #req[ciObjFind] ciObjFind;
    #req[ciLineAt] ciLineAt;
    #req[ciRaiseNamed] ciRaiseNamed;
    #req[ciRaiseSector] ciRaiseSector;
    #req[ciRaiseMsg] ciRaiseMsg;
    #req[ciRaise] ciRaise;
    #req[ciObjNameIs] ciObjNameIs;
    #req[ciInstMemSet] ciInstMemSet;
    #req[ciInstFree] ciInstFree;
    #req[ciValFree] ciValFree;
    #req[ciCurInst] ciCurInst;
    #req[ciCurObj] ciCurObj;
    #req[ciLastInst] ciLastInst;
    #req[ciLastObj] ciLastObj;
    #req[ciObjInit] ciObjInit;
    #req[ciMirrored] ciMirrored;
    #req[ciObjNameOff] ciObjNameOff;
    #req[ciObjNameLen] ciObjNameLen;
    #req[ciObjParS] ciObjParS;
    #req[ciObjBodyS] ciObjBodyS;
    #req[ciObjBodyE] ciObjBodyE;
    #req[ciObjTopE] ciObjTopE;
    #req[ciObjFreeS] ciObjFreeS;
    #req[ciObjFreeE] ciObjFreeE;
    #req[ciObjCount] ciObjCount;
    #req[ciLabObj] ciLabObj;
    #req[ciLabNameOff] ciLabNameOff;
    #req[ciLabNameLen] ciLabNameLen;
    #req[ciLabParS] ciLabParS;
    #req[ciLabBodyS] ciLabBodyS;
    #req[ciLabBodyE] ciLabBodyE;
    #req[ciLabCount] ciLabCount;
    #req[ciStrClone] ciStrClone;
    // select: iteration helpers + cursor/label state
    #req[ciVecSize] ciVecSize;
    #req[ciVecGet] ciVecGet;
    #req[ciVecType] ciVecType;
    #req[ciMapSize] ciMapSize;
    #req[ciBindPairs] ciBindPairs;
    #req[ciBindWidth] ciBindWidth;
    #req[ciBindCellGet] ciBindCellGet;
    #req[ciBindCellRT] ciBindCellRT;
    #req[ciStrNew] ciStrNew;
    #req[ciSetMode] ciSetMode;
    #req[ciSelDelta] ciSelDelta;
    #req[ciSelCursor] ciSelCursor;
    #req[ciInSelect] ciInSelect;
    #req[ciSelLabOff] ciSelLabOff;
    #req[ciSelLabLen] ciSelLabLen;
    #stack[int, 32] done = 0;
    if (ciCur == 13) {
        ciAdvance();
        done = 1;
    }
    if (done == 0) {
        if (ciCur == 11) {
            ciAdvance();
            #stack[int, 64] savedVC = ciVCount;   // FX-BLOCKSCOPE: scope block locals
            #stack[int, 32] bgo = 1;
            while (bgo == 1) {
                if (ciCur == 12) { bgo = 0; }
                if (ciCur == 0) { bgo = 0; }
                // return(2)/destruct(3)/break(4) stop the block; mirror(1)
                // keeps running (the enclosing replay loop unwinds/handles)
                if (ciSignal >= 2) { bgo = 0; }
                if (bgo == 1) { ciStmt(); }
            }
            #delete[bgo];
            // A control signal (break/return/destruct) can stop the block MID-body,
            // leaving the cursor before the closing '}'. Skip the remaining
            // statements to the matching '}' so the block is fully consumed -- else
            // `{ ...; break; more; }` leaks `more` (+ the '}') into the enclosing
            // scope once the loop exits without resetting the cursor.
            if (ciCur != 12) {
                #stack[int, 32] skd = 1;
                #stack[int, 32] sk = 1;
                while (sk == 1) {
                    if (ciCur == 0) { sk = 0; }
                    if (ciCur == 11) { skd = skd + 1; }
                    if (ciCur == 12) {
                        skd = skd - 1;
                        if (skd == 0) { sk = 0; }
                    }
                    if (sk == 1) { ciAdvance(); }
                }
                #delete[skd];
                #delete[sk];
            }
            if (ciCur == 12) { ciAdvance(); }
            // FX-BLOCKSCOPE: drop the block's locals (free owned strings/instances,
            // never the value escaping via ciRetVal), then restore the var count so
            // a name declared inside the block reads as null (0x0) afterwards.
            #stack[int, 64] bfc = savedVC;
            while (bfc < ciVCount) {
                #stack[int, 64] bcvv = cssc::peek64(ciVVals + bfc * 8);
                #stack[int, 64] bcvt = cssc::peek64(ciVTypes + bfc * 8);
                #stack[int, 64] bcvo = cssc::peek64(ciVOwns + bfc * 8);
                if (bcvo == 1) {
                    if (bcvt == 1) { if (bcvv != ciRetVal) { cssc::free(bcvv); } }
                    if (bcvt == 3) { if (bcvv != ciRetVal) { if (bcvv != 0) { ciInstFree(bcvv); } } }
                }
                #delete[bcvv];
                #delete[bcvt];
                #delete[bcvo];
                bfc = bfc + 1;
            }
            #delete[bfc];
            ciVCount = savedVC;
            #delete[savedVC];
            done = 1;
        }
    }
    if (done == 0) {
        if (ciCur == 22) {
            // pre-read the directive name: #free / #reserve replay statement
            // spans and therefore MUST run here in the self-recursive ciStmt
            // (ciDoDecl calling ciStmt would be forbidden mutual recursion)
            ciAdvance();
            #stack[int, 64] fo = ciTokOff;
            #stack[int, 64] fl = ciTokLen;
            ciIdentIs(fo, fl, "free") kfree;
            ciIdentIs(fo, fl, "reserve") kres;
            ciIdentIs(fo, fl, "debug") kdbg;
            ciIdentIs(fo, fl, "trace") ktrc;
            ciIdentIs(fo, fl, "catch") kcat;
            ciIdentIs(fo, fl, "stdout") kstdo;
            ciIdentIs(fo, fl, "include") kinc;
            ciIdentIs(fo, fl, "unload") kunld;
            ciIdentIs(fo, fl, "load") kld;
            ciIdentIs(fo, fl, "depend") kdep;
            ciIdentIs(fo, fl, "panic") kpanic;
            #stack[int, 32] kincd = kinc + kdep;
            #stack[int, 32] dh = 0;
            if (kfree == 1) {
                // ---- #free[Name]; -- run free{} once, then unbind everything
                ciAdvance();
                if (ciCur == 23) { ciAdvance(); }
                #stack[int, 64] fno = ciTokOff;
                #stack[int, 64] fnl = ciTokLen;
                if (ciCur == 2) { ciAdvance(); }
                if (ciCur == 24) { ciAdvance(); }
                if (ciCur == 13) { ciAdvance(); }
                if (ciExec == 1) {
                    ciSecFind(fno, fnl) si;
                    if (si >= 0) {
                        #stack[int, 64] fr = cssc::peek64(ciSecFreed + si * 8);
                        #stack[int, 64] dfr = cssc::peek64(ciSecDefer + si * 8);
                        if (fr == 0) {
                            if (dfr == 0) {
                                // run-once guard is set BEFORE the replay so
                                // #free cycles (A frees B frees A) terminate
                                cssc::poke64(ciSecFreed + si * 8, 1);
                                #stack[int, 64] fs = cssc::peek64(ciSecFreeS + si * 8);
                                #stack[int, 64] fe = cssc::peek64(ciSecFreeE + si * 8);
                                #stack[int, 64] snO = cssc::peek64(ciSecNameOff + si * 8);
                                #stack[int, 64] snL = cssc::peek64(ciSecNameLen + si * 8);
                                if (fs > 0) {
                                    // replay the free{} span with the sector
                                    // as current context (bare #delete[member]
                                    // resolves qualified); full state save
                                    #stack[int, 64] rp = ciPos;
                                    #stack[int, 64] rc = ciCur;
                                    #stack[int, 64] rtn = ciTokNum;
                                    #stack[int, 64] rto = ciTokOff;
                                    #stack[int, 64] rtl = ciTokLen;
                                    #stack[int, 64] rsg = ciSignal;
                                    #stack[int, 64] rso = ciCurSecOff;
                                    #stack[int, 64] rsl = ciCurSecLen;
                                    #stack[int, 64] rsi = ciSecInit;
                                    ciCurSecOff = snO;
                                    ciCurSecLen = snL;
                                    ciSecInit = 0;
                                    ciSignal = 0;
                                    ciPos = fs;
                                    ciAdvance();
                                    #stack[int, 32] fg = 1;
                                    while (fg == 1) {
                                        if (ciCur == 12) { fg = 0; }
                                        if (ciCur == 0) { fg = 0; }
                                        if (ciSignal >= 2) { fg = 0; }
                                        if (fg == 1) { ciStmt(); }
                                    }
                                    #delete[fg];
                                    ciPos = rp;
                                    ciCur = rc;
                                    ciTokNum = rtn;
                                    ciTokOff = rto;
                                    ciTokLen = rtl;
                                    ciSignal = rsg;
                                    ciCurSecOff = rso;
                                    ciCurSecLen = rsl;
                                    ciSecInit = rsi;
                                    #delete[rp];
                                    #delete[rc];
                                    #delete[rtn];
                                    #delete[rto];
                                    #delete[rtl];
                                    #delete[rsg];
                                    #delete[rso];
                                    #delete[rsl];
                                    #delete[rsi];
                                }
                                // unbind every remaining "Name::*" member row
                                // in REVERSE bind order (frees owned strings,
                                // tombstones in place -- frame-safe)
                                #stack[int, 64] vi = ciVCount - 1;
                                while (vi >= 0) {
                                    #stack[int, 64] rl = cssc::peek64(ciVLens + vi * 8);
                                    #stack[int, 32] pm = 0;
                                    if (rl > snL + 2) {
                                        pm = 1;
                                        #stack[int, 32] pj = 0;
                                        while (pj < snL) {
                                            #stack[int, 64] a = cssc::peek8(ciVNames + vi * 32 + pj);
                                            #stack[int, 64] b = cssc::peek8(ciSrc + snO + pj);
                                            if (a != b) { pm = 0; }
                                            #delete[a];
                                            #delete[b];
                                            pj = pj + 1;
                                        }
                                        #delete[pj];
                                        #stack[int, 64] c1 = cssc::peek8(ciVNames + vi * 32 + snL);
                                        #stack[int, 64] c2 = cssc::peek8(ciVNames + vi * 32 + snL + 1);
                                        if (c1 != 58) { pm = 0; }
                                        if (c2 != 58) { pm = 0; }
                                        #delete[c1];
                                        #delete[c2];
                                    }
                                    if (pm == 1) {
                                        #stack[int, 64] mt = cssc::peek64(ciVTypes + vi * 8);
                                        #stack[int, 64] mo = cssc::peek64(ciVOwns + vi * 8);
                                        #stack[int, 64] mv = cssc::peek64(ciVVals + vi * 8);
                                        if (mo == 1) { if (mt == 1) { cssc::free(mv); } }
                                        cssc::poke64(ciVLens + vi * 8, 0);
                                        cssc::poke64(ciVVals + vi * 8, 0);
                                        cssc::poke64(ciVTypes + vi * 8, 0);
                                        cssc::poke64(ciVOwns + vi * 8, 0);
                                        cssc::poke64(ciVVis + vi * 8, 1);
                                        #delete[mt];
                                        #delete[mo];
                                        #delete[mv];
                                    }
                                    #delete[pm];
                                    #delete[rl];
                                    vi = vi - 1;
                                }
                                #delete[vi];
                                // retire the sector's methods (len=0 rows
                                // never match a lookup again)
                                #stack[int, 32] mi = 0;
                                while (mi < ciFnCount) {
                                    #stack[int, 64] msO = cssc::peek64(ciFnSecOff + mi * 8);
                                    #stack[int, 64] msL = cssc::peek64(ciFnSecLen + mi * 8);
                                    if (msL == snL) {
                                        if (msO == snO) {
                                            cssc::poke64(ciFnLens + mi * 8, 0);
                                        }
                                    }
                                    #delete[msO];
                                    #delete[msL];
                                    mi = mi + 1;
                                }
                                #delete[mi];
                                #delete[fs];
                                #delete[fe];
                                #delete[snO];
                                #delete[snL];
                            }
                        }
                        #delete[fr];
                        #delete[dfr];
                    }
                    if (si < 0) {
                        // ---- #free[inst]; -- not a sector: an object
                        // instance. Run its free{} ONCE (instance context so
                        // `#delete[Obj->member]` resolves), then release the
                        // record + tombstone the variable via ciVarDrop ----
                        ciVarFind(fno, fnl) vi;
                        if (vi >= 0) {
                            #stack[int, 64] ity = cssc::peek64(ciVTypes + vi * 8);
                            #stack[int, 64] ival = cssc::peek64(ciVVals + vi * 8);
                            if (ity == 3) {
                                if (ival != 0) {
                                    #stack[int, 64] ifr2 = cssc::peek32(ival + 4);
                                    if (ifr2 == 0) {
                                        cssc::poke32(ival + 4, 1);
                                        #stack[int, 64] idf = cssc::peek64(ival + 8);
                                        #stack[int, 64] ofs2 = cssc::peek64(ciObjFreeS + idf * 8);
                                        if (ofs2 > 0) {
                                            #stack[int, 64] rp2 = ciPos;
                                            #stack[int, 64] rc2 = ciCur;
                                            #stack[int, 64] rtn2 = ciTokNum;
                                            #stack[int, 64] rto2 = ciTokOff;
                                            #stack[int, 64] rtl2 = ciTokLen;
                                            #stack[int, 64] rsg2 = ciSignal;
                                            #stack[int, 64] rvi2 = ciCurInst;
                                            #stack[int, 64] rvo2 = ciCurObj;
                                            #stack[int, 64] roi2 = ciObjInit;
                                            #stack[int, 64] rso2 = ciCurSecOff;
                                            #stack[int, 64] rsl2 = ciCurSecLen;
                                            #stack[int, 64] rsi2 = ciSecInit;
                                            ciCurInst = ival;
                                            ciCurObj = idf;
                                            ciObjInit = 0;
                                            ciCurSecOff = 0;
                                            ciCurSecLen = 0;
                                            ciSecInit = 0;
                                            ciSignal = 0;
                                            ciPos = ofs2;
                                            ciAdvance();
                                            #stack[int, 32] og = 1;
                                            while (og == 1) {
                                                if (ciCur == 12) { og = 0; }
                                                if (ciCur == 0) { og = 0; }
                                                if (ciSignal >= 2) { og = 0; }
                                                if (og == 1) { ciStmt(); }
                                            }
                                            #delete[og];
                                            ciPos = rp2;
                                            ciCur = rc2;
                                            ciTokNum = rtn2;
                                            ciTokOff = rto2;
                                            ciTokLen = rtl2;
                                            ciSignal = rsg2;
                                            ciCurInst = rvi2;
                                            ciCurObj = rvo2;
                                            ciObjInit = roi2;
                                            ciCurSecOff = rso2;
                                            ciCurSecLen = rsl2;
                                            ciSecInit = rsi2;
                                            #delete[rp2];
                                            #delete[rc2];
                                            #delete[rtn2];
                                            #delete[rto2];
                                            #delete[rtl2];
                                            #delete[rsg2];
                                            #delete[rvi2];
                                            #delete[rvo2];
                                            #delete[roi2];
                                            #delete[rso2];
                                            #delete[rsl2];
                                            #delete[rsi2];
                                        }
                                        #delete[ofs2];
                                        #delete[idf];
                                    }
                                    #delete[ifr2];
                                }
                                ciVarDrop(fno, fnl);
                            }
                            #delete[ity];
                            #delete[ival];
                        }
                        #delete[vi];
                    }
                    #delete[si];
                }
                #delete[fno];
                #delete[fnl];
                dh = 1;
            }
            if (dh == 0) {
                if (kres == 1) {
                    // ---- #reserve[label]; -- run a deferred sector's body now
                    ciAdvance();
                    if (ciCur == 23) { ciAdvance(); }
                    #stack[int, 64] lno = ciTokOff;
                    #stack[int, 64] lnl = ciTokLen;
                    if (ciCur == 2) { ciAdvance(); }
                    if (ciCur == 24) { ciAdvance(); }
                    if (ciCur == 13) { ciAdvance(); }
                    if (ciExec == 1) {
                        ciSecFindLab(lno, lnl) si;
                        if (si >= 0) {
                            // consume the label (a second #reserve is inert)
                            cssc::poke64(ciSecDefer + si * 8, 0);
                            cssc::poke64(ciSecLabLen + si * 8, 0);
                            #stack[int, 64] bs = cssc::peek64(ciSecBodyS + si * 8);
                            #stack[int, 64] snO = cssc::peek64(ciSecNameOff + si * 8);
                            #stack[int, 64] snL = cssc::peek64(ciSecNameLen + si * 8);
                            // replay the parked body in member-init mode
                            #stack[int, 64] rp = ciPos;
                            #stack[int, 64] rc = ciCur;
                            #stack[int, 64] rtn = ciTokNum;
                            #stack[int, 64] rto = ciTokOff;
                            #stack[int, 64] rtl = ciTokLen;
                            #stack[int, 64] rsg = ciSignal;
                            #stack[int, 64] rso = ciCurSecOff;
                            #stack[int, 64] rsl = ciCurSecLen;
                            #stack[int, 64] rsi = ciSecInit;
                            #stack[int, 64] rsv = ciSecVis;
                            ciCurSecOff = snO;
                            ciCurSecLen = snL;
                            ciSecInit = 1;
                            ciSecVis = 0;
                            ciSignal = 0;
                            ciPos = bs;
                            ciAdvance();
                            #stack[int, 32] rg = 1;
                            while (rg == 1) {
                                if (ciCur == 12) { rg = 0; }
                                if (ciCur == 0) { rg = 0; }
                                if (ciSignal >= 2) { rg = 0; }
                                if (rg == 1) { ciStmt(); }
                            }
                            #delete[rg];
                            ciPos = rp;
                            ciCur = rc;
                            ciTokNum = rtn;
                            ciTokOff = rto;
                            ciTokLen = rtl;
                            ciSignal = rsg;
                            ciCurSecOff = rso;
                            ciCurSecLen = rsl;
                            ciSecInit = rsi;
                            ciSecVis = rsv;
                            #delete[rp];
                            #delete[rc];
                            #delete[rtn];
                            #delete[rto];
                            #delete[rtl];
                            #delete[rsg];
                            #delete[rso];
                            #delete[rsl];
                            #delete[rsi];
                            #delete[rsv];
                            #delete[bs];
                            #delete[snO];
                            #delete[snL];
                        }
                        #delete[si];
                    }
                    #delete[lno];
                    #delete[lnl];
                    dh = 1;
                }
            }
            // ---- #include("name") / #depend("name") [alias]; -- enable a
            // native capability module (video/sound/ini) as a callable namespace
            if (kincd > 0) {
                ciAdvance();
                if (ciCur == 9) { ciAdvance(); }
                #stack[int, 64] mo = ciTokOff;
                #stack[int, 64] ml = ciTokLen;
                ciIdentIs(mo, ml, "video") mvid;
                ciIdentIs(mo, ml, "sound") msnd;
                ciIdentIs(mo, ml, "keyboard") mkey;
                ciIdentIs(mo, ml, "ini") mini;
                ciIdentIs(mo, ml, "cssc.ini") mini2;   // reference spelling
                ciIdentIs(mo, ml, "stdio") mstd;
                ciIdentIs(mo, ml, "cssc.sys") msys1;
                ciIdentIs(mo, ml, "sys") msys2;
                #stack[int, 32] msys = 0;
                if (msys1 == 1) { msys = 1; }
                if (msys2 == 1) { msys = 1; }
                #delete[msys1];
                #delete[msys2];
                ciIdentIs(mo, ml, "video.sprite") mspr;
                ciIdentIs(mo, ml, "video.tilemap") mtm;
                ciIdentIs(mo, ml, "video.font") mfnt;
                // math.accel: names "math.accel"/"acc"/"ma" -> modid 12 (any may be
                // the include name; a user-given alias is registered on top).
                ciIdentIs(mo, ml, "math.accel") mma1;
                ciIdentIs(mo, ml, "acc") mma2;
                ciIdentIs(mo, ml, "ma") mma3;
                #stack[int, 32] mmaA = 0;
                if (mma1 == 1) { mmaA = 1; }
                if (mma2 == 1) { mmaA = 1; }
                if (mma3 == 1) { mmaA = 1; }
                // cssc.math: names "cssc.math"/"math" -> modid 13.
                ciIdentIs(mo, ml, "cssc.math") mcm1;
                ciIdentIs(mo, ml, "math") mcm2;
                #stack[int, 32] mcmA = 0;
                if (mcm1 == 1) { mcmA = 1; }
                if (mcm2 == 1) { mcmA = 1; }
                // 'def' is the prelude gate (no module id / no alias): it enables
                // #cdefine / #param / #fvar / #qvar. firefield's first line.
                ciIdentIs(mo, ml, "def") mdef;
                // stdlib modules. console: instance-dispatched (tag 6), no modid.
                // devdebug/dev -> modid 9 (shared dev::stdout list). stdgrace -> 10.
                // stdout: companion (no modid). mouse -> modid 11.
                ciIdentIs(mo, ml, "console") mcon;
                #stack[int, 32] mconA = 0;
                ciIdentIs(mo, ml, "sys.console") mcon2;
                ciIdentIs(mo, ml, "cssc.console") mcon3;
                if (mcon == 1) { mconA = 1; }
                if (mcon2 == 1) { mconA = 1; }
                if (mcon3 == 1) { mconA = 1; }
                ciIdentIs(mo, ml, "devdebug") mdvd;
                ciIdentIs(mo, ml, "dev") mdv2;
                #stack[int, 32] mdevA = 0;
                if (mdvd == 1) { mdevA = 1; }
                if (mdv2 == 1) { mdevA = 1; }
                ciIdentIs(mo, ml, "stdgrace") mgrc;
                ciIdentIs(mo, ml, "stdout") mstdo;
                ciIdentIs(mo, ml, "mouse") mmou;
                ciAdvance();
                if (ciCur == 10) { ciAdvance(); }
                // optional alias:  #include("video") vid;  -> key = "vid"
                #stack[int, 64] aliasOff = mo;
                #stack[int, 64] aliasLen = ml;
                if (ciCur == 2) {
                    aliasOff = ciTokOff;
                    aliasLen = ciTokLen;
                    ciTokHasCC(aliasOff, aliasLen) aliasCC;
                    if (aliasCC >= 0) {
                        ciRaiseMsg("Unexpected token: DCOLON ('::')", ciLineAt(aliasOff), 2);
                    }
                    #delete[aliasCC];
                    ciAdvance();
                }
                if (ciCur == 13) { ciAdvance(); }
                if (ciExec == 1) {
                    #stack[int, 64] modid = 0;
                    if (mvid == 1) { ciModVideo = 1; modid = 1; }
                    if (msnd == 1) { ciModSound = 1; modid = 2; }
                    if (mkey == 1) { ciModKey = 1; modid = 3; }
                    if (mini == 1) { ciModIni = 1; modid = 4; }
                    if (mini2 == 1) { ciModIni = 1; modid = 4; }
                    if (mstd == 1) { ciModStdio = 1; modid = 14; }
                    if (msys == 1) { ciModSys = 1; modid = 15; }
                    if (mspr == 1) { ciModSprite = 1; modid = 5; }
                    if (mtm == 1) { ciModTilemap = 1; modid = 6; }
                    if (mfnt == 1) { ciModFont = 1; modid = 7; }
                    if (mmaA == 1) { ciModMathAccel = 1; modid = 12; }
                    if (mcmA == 1) { ciModCsscMath = 1; modid = 13; }
                    if (mdef == 1) { ciDefLoaded = 1; }
                    if (mconA == 1) { ciModConsole = 1; }
                    if (mdevA == 1) {
                        ciModDev = 1;
                        modid = 9;
                        if (ciDevStdout == 0) { ciVecNew(1) nl; ciDevStdout = nl; #delete[nl]; }
                    }
                    if (mgrc == 1) { ciModGrace = 1; modid = 10; }
                    if (mstdo == 1) { ciModStdout = 1; }
                    if (mmou == 1) { ciModMouse = 1; modid = 11; }
                    #stack[int, 32] mknown = 0;
                    if (mvid == 1) { mknown = 1; }
                    if (msnd == 1) { mknown = 1; }
                    if (mkey == 1) { mknown = 1; }
                    if (mini == 1) { mknown = 1; }
                    if (mini2 == 1) { mknown = 1; }
                    if (mstd == 1) { mknown = 1; }
                    if (msys == 1) { mknown = 1; }
                    if (mspr == 1) { mknown = 1; }
                    if (mtm == 1) { mknown = 1; }
                    if (mfnt == 1) { mknown = 1; }
                    if (mmaA == 1) { mknown = 1; }
                    if (mcmA == 1) { mknown = 1; }
                    if (mdef == 1) { mknown = 1; }
                    if (mconA == 1) { mknown = 1; }
                    if (mdevA == 1) { mknown = 1; }
                    if (mgrc == 1) { mknown = 1; }
                    if (mstdo == 1) { mknown = 1; }
                    if (mmou == 1) { mknown = 1; }
                    if (mknown == 0) {
                        #stack[int, 64] mln = ciLineAt(mo);
                        ciRaiseNamed("Unknown module: ", ciSrc + mo, ml, mln);
                        #delete[mln];
                    }
