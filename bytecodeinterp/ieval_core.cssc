                                    #stack[int, 64] rso = ciCurSecOff;
                                    #stack[int, 64] rsl = ciCurSecLen;
                                    #stack[int, 64] rsi = ciSecInit;
                                    #stack[int, 64] rsv = ciSecVis;
                                    ciCurSecOff = sno;
                                    ciCurSecLen = snl;
                                    ciSecInit = 1;
                                    ciSecVis = 0;
                                    ciSignal = 0;
                                    #stack[int, 32] dii = 0;
                                    while (dii < depN) {
                                        #stack[int, 64] iso = cssc::peek64(depSO + dii * 8);
                                        #stack[int, 64] isl = cssc::peek64(depSL + dii * 8);
                                        #stack[int, 64] iio = cssc::peek64(depIO + dii * 8);
                                        #stack[int, 64] iil = cssc::peek64(depIL + dii * 8);
                                        ciVarFind(iso, isl) gi;
                                        if (gi >= 0) {
                                            #stack[int, 64] dv = cssc::peek64(ciVVals + gi * 8);
                                            #stack[int, 64] dt = cssc::peek64(ciVTypes + gi * 8);
                                            ciQualify(sno, snl, iio, iil) dq;
                                            ciBindVis = 0;
                                            ciVarSet(ciQualBuf - ciSrc, dq, dv, dt, 0);
                                            ciBindVis = 1;
                                            #delete[dv];
                                            #delete[dt];
                                            #delete[dq];
                                        }
                                        #delete[gi];
                                        #delete[iso];
                                        #delete[isl];
                                        #delete[iio];
                                        #delete[iil];
                                        dii = dii + 1;
                                    }
                                    #delete[dii];
                                    ciPos = bodyS;
                                    ciAdvance();
                                    #stack[int, 32] bg2 = 1;
                                    while (bg2 == 1) {
                                        if (ciCur == 12) { bg2 = 0; }
                                        if (ciCur == 0) { bg2 = 0; }
                                        if (ciSignal >= 2) { bg2 = 0; }
                                        if (bg2 == 1) { ciStmt(); }
                                    }
                                    #delete[bg2];
                                    ciPos = rp;
                                    ciCur = rc;
                                    ciTokNum = rtn;
                                    ciTokOff = rto;
                                    ciTokLen = rtl;
                                    ciSignal = rsg;
                                    ciCurSecOff = rso;
                                    ciCurSecLen = rsl;
                                    ciSecInit = rsi;
                                    ciSecVis = rsv;
                                    #delete[rp];
                                    #delete[rc];
                                    #delete[rtn];
                                    #delete[rto];
                                    #delete[rtl];
                                    #delete[rsg];
                                    #delete[rso];
                                    #delete[rsl];
                                    #delete[rsi];
                                    #delete[rsv];
                                }
                            }
                        }
                        #delete[si];
                    }
                }
                #delete[freeS];
                #delete[freeE];
                #delete[bodyS];
                #delete[bodyE];
                #delete[sdef];
                #delete[labO];
                #delete[labL];
                cssc::free(depSO);
                cssc::free(depSL);
                cssc::free(depIO);
                cssc::free(depIL);
                #delete[depN];
                #delete[depSO];
                #delete[depSL];
                #delete[depIO];
                #delete[depIL];
                #delete[sno];
                #delete[snl];
                h = 1;
            }
        }
        // ---- object Name <ctorParams>? { ctor-stmts labels* } free {..} ; --
        // Registered WITHOUT executing (the body is the constructor and
        // replays per instantiation). The token scan records the ctor
        // boundary (first label ident / closing brace) and every depth-1
        // label: IDENT (<params>)? ':' -> name + param span + body span.
        if (h == 0) {
            if (kobj == 1) {
                ciAdvance();
                #stack[int, 64] ono = ciTokOff;
                #stack[int, 64] onl = ciTokLen;
                if (ciCur == 2) { ciAdvance(); }
                #stack[int, 64] oParS = 0;
                if (ciCur == 17) {
                    oParS = ciPos;
                    #stack[int, 32] psk = 1;
                    while (psk == 1) {
                        if (ciCur == 18) { psk = 0; }
                        if (ciCur == 0) { psk = 0; }
                        if (psk == 1) { ciAdvance(); }
                    }
                    if (ciCur == 18) { ciAdvance(); }
                    #delete[psk];
                }
                #stack[int, 32] reg = 0;
                if (ciExec == 1) {
                    if (ciScopeBase == 0) {
                        if (ciObjCount < 32) { reg = 1; }
                    }
                }
                #stack[int, 64] oi = ciObjCount;
                #stack[int, 64] lastLab = 0 - 1;
                #stack[int, 64] oBodyS = 0;
                #stack[int, 64] oBodyE = 0;
                #stack[int, 64] oTopE = 0;
                if (ciCur == 11) {
                    oBodyS = ciPos;
                    #stack[int, 32] dep2 = 1;
                    #stack[int, 32] sc2 = 1;
                    while (sc2 == 1) {
                        ciAdvance();
                        if (ciCur == 0) { sc2 = 0; }
                        if (sc2 == 1) {
                            if (dep2 == 1) {
                                if (ciCur == 2) {
                                    // label lookahead (consumes the ident and
                                    // an optional <...> param list)
                                    #stack[int, 64] lo = ciTokOff;
                                    #stack[int, 64] ll = ciTokLen;
                                    // FX-OBJ-BOUND: the previous label's body ends
                                    // at THIS label's ident TOKEN INDEX (ciPos-1),
                                    // not its byte offset (ciTokOff) -- the replay
                                    // consumer bounds on the token cursor ciPos.
                                    #stack[int, 64] labTokIdx = ciPos - 1;
                                    ciAdvance();
                                    #stack[int, 64] lps = 0;
                                    #stack[int, 32] isLab = 0;
                                    if (ciCur == 31) { isLab = 1; }
                                    if (ciCur == 17) {
                                        // PARAM-SHAPE GUARD: a real param list
                                        // holds only idents ':' ',' '&' '*'.
                                        // Anything else (number, '(', '{') is
                                        // a less-than comparison -- abort the
                                        // label hypothesis; the offending
                                        // token flows to the depth check, so
                                        // brace bookkeeping stays exact.
                                        lps = ciPos;
                                        ciAdvance();
                                        #stack[int, 32] lsk = 1;
                                        while (lsk == 1) {
                                            if (ciCur == 18) { lsk = 0; }
                                            if (ciCur == 0) { lsk = 0; }
                                            if (lsk == 1) {
                                                #stack[int, 32] shape = 0;
                                                if (ciCur == 2) { shape = 1; }
                                                if (ciCur == 31) { shape = 1; }
                                                if (ciCur == 21) { shape = 1; }
                                                if (ciCur == 30) { shape = 1; }
                                                if (ciCur == 6) { shape = 1; }
                                                if (shape == 0) { lsk = 0; lps = 0; }
                                                if (shape == 1) { ciAdvance(); }
                                                #delete[shape];
                                            }
                                        }
                                        if (lps > 0) {
                                            if (ciCur == 18) { ciAdvance(); }
                                            if (ciCur == 31) { isLab = 1; }
                                        }
                                        #delete[lsk];
                                    }
                                    // 'public:'/'private:' are SECTION marks,
                                    // never labels: skip without touching the
                                    // ctor boundary or any label span
                                    if (isLab == 1) {
                                        ciIdentIs(lo, ll, "public") opub;
                                        ciIdentIs(lo, ll, "private") opriv;
                                        if (opub == 1) { isLab = 0; }
                                        if (opriv == 1) { isLab = 0; }
                                        #delete[opub];
                                        #delete[opriv];
                                    }
                                    if (isLab == 1) {
                                        // previous span ends at this ident (token index)
                                        if (lastLab >= 0) {
                                            cssc::poke64(ciLabBodyE + lastLab * 8, labTokIdx);
                                        }
                                        if (lastLab < 0) { oTopE = labTokIdx; }
                                        if (reg == 1) {
                                            if (ciLabCount < 256) {
                                                cssc::poke64(ciLabObj + ciLabCount * 8, oi);
                                                cssc::poke64(ciLabNameOff + ciLabCount * 8, lo);
                                                cssc::poke64(ciLabNameLen + ciLabCount * 8, ll);
                                                cssc::poke64(ciLabParS + ciLabCount * 8, lps);
                                                cssc::poke64(ciLabBodyS + ciLabCount * 8, ciPos);
                                                lastLab = ciLabCount;
                                                ciLabCount = ciLabCount + 1;
                                            }
                                        }
                                    }
                                    #delete[isLab];
                                    #delete[lps];
                                    #delete[labTokIdx];
                                    #delete[lo];
                                    #delete[ll];
                                }
                            }
                            // depth bookkeeping for the CURRENT token (also
                            // covers tokens left by the label lookahead)
                            if (ciCur == 11) { dep2 = dep2 + 1; }
                            if (ciCur == 12) {
                                dep2 = dep2 - 1;
                                if (dep2 == 0) { sc2 = 0; }
                            }
                        }
                    }
                    #delete[sc2];
                    #delete[dep2];
                    oBodyE = ciPos;
                    // last span ends at the closing '}' (ciPos points past it)
                    #stack[int, 64] endOff = ciPos - 1;
                    if (lastLab >= 0) {
                        cssc::poke64(ciLabBodyE + lastLab * 8, endOff);
                    }
                    if (oTopE == 0) { oTopE = endOff; }
                    #delete[endOff];
                    if (ciCur == 12) { ciAdvance(); }
                }
                // mandatory trailing free { ... } (may be empty)
                #stack[int, 64] oFreeS = 0;
                #stack[int, 64] oFreeE = 0;
                if (ciCur == 2) {
                    #stack[int, 64] fko2 = ciTokOff;
                    #stack[int, 64] fkl2 = ciTokLen;
                    ciIdentIs(fko2, fkl2, "free") isfb2;
                    if (isfb2 == 1) {
                        ciAdvance();
                        if (ciCur == 11) {
                            oFreeS = ciPos;
                            #stack[int, 32] dep4 = 1;
                            #stack[int, 32] sc4 = 1;
                            while (sc4 == 1) {
                                ciAdvance();
                                if (ciCur == 0) { sc4 = 0; }
                                if (ciCur == 11) { dep4 = dep4 + 1; }
                                if (ciCur == 12) {
                                    dep4 = dep4 - 1;
                                    if (dep4 == 0) { sc4 = 0; }
                                }
                            }
                            #delete[sc4];
                            #delete[dep4];
                            oFreeE = ciPos;
                            if (ciCur == 12) { ciAdvance(); }
                        }
                    }
                    #delete[isfb2];
                    #delete[fko2];
                    #delete[fkl2];
                }
                if (ciCur == 13) { ciAdvance(); }
                if (reg == 1) {
                    cssc::poke64(ciObjNameOff + oi * 8, ono);
                    cssc::poke64(ciObjNameLen + oi * 8, onl);
                    cssc::poke64(ciObjParS + oi * 8, oParS);
                    cssc::poke64(ciObjBodyS + oi * 8, oBodyS);
                    cssc::poke64(ciObjBodyE + oi * 8, oBodyE);
                    cssc::poke64(ciObjTopE + oi * 8, oTopE);
                    cssc::poke64(ciObjFreeS + oi * 8, oFreeS);
                    cssc::poke64(ciObjFreeE + oi * 8, oFreeE);
                    ciObjCount = ciObjCount + 1;
                }
                #delete[oFreeS];
                #delete[oFreeE];
                #delete[oBodyS];
                #delete[oBodyE];
                #delete[oTopE];
                #delete[lastLab];
                #delete[oi];
                #delete[reg];
                #delete[oParS];
                #delete[ono];
                #delete[onl];
                h = 1;
            }
        }
        if (kif == 1) {
            // if (cond) { body } [ else if (cond) { body } ]* [ else { body } ]
            ciAdvance();
            if (ciCur == 9) { ciAdvance(); }
            ciExpr(0) c;
            if (ciCur == 10) { ciAdvance(); }
            #stack[int, 64] se = ciExec;
            // tookAny: has any branch of this chain executed yet?
            #stack[int, 32] tookAny = 0;
            if (c != 0) { if (se == 1) { tookAny = 1; } }
            if (tookAny == 1) { ciExec = 1; }
            if (tookAny == 0) { ciExec = 0; }
            ciStmt();
            ciExec = se;
            // walk any else / else-if that follows
            #stack[int, 32] chaining = 1;
            while (chaining == 1) {
                #stack[int, 32] iselse = 0;
                if (ciCur == 2) {
                    #stack[int, 64] eo = ciTokOff;
                    #stack[int, 64] el = ciTokLen;
                    ciIdentIs(eo, el, "else") ie;
                    if (ie == 1) { iselse = 1; }
                    #delete[ie];
                    #delete[eo];
                    #delete[el];
                }
                if (iselse == 0) { chaining = 0; }
                if (iselse == 1) {
                    ciAdvance();
                    // distinguish 'else if' from a plain 'else'
                    #stack[int, 32] iseif = 0;
                    if (ciCur == 2) {
                        #stack[int, 64] fo = ciTokOff;
                        #stack[int, 64] fl = ciTokLen;
                        ciIdentIs(fo, fl, "if") iif;
                        if (iif == 1) { iseif = 1; }
                        #delete[iif];
                        #delete[fo];
                        #delete[fl];
                    }
                    if (iseif == 1) {
                        ciAdvance();
                        if (ciCur == 9) { ciAdvance(); }
                        ciExpr(0) c2;
                        if (ciCur == 10) { ciAdvance(); }
                        #stack[int, 32] run2 = 0;
                        if (tookAny == 0) { if (c2 != 0) { if (se == 1) { run2 = 1; } } }
                        if (run2 == 1) { ciExec = 1; tookAny = 1; }
                        if (run2 == 0) { ciExec = 0; }
                        ciStmt();
                        ciExec = se;
                        #delete[run2];
                        #delete[c2];
                    }
                    if (iseif == 0) {
                        // plain 'else { body }' terminates the chain
                        #stack[int, 32] run2 = 0;
                        if (tookAny == 0) { if (se == 1) { run2 = 1; } }
                        if (run2 == 1) { ciExec = 1; tookAny = 1; }
                        if (run2 == 0) { ciExec = 0; }
                        ciStmt();
                        ciExec = se;
                        chaining = 0;
                        #delete[run2];
                    }
                    #delete[iseif];
                }
                #delete[iselse];
            }
            #delete[chaining];
            #delete[tookAny];
            #delete[se];
            #delete[c];
            h = 1;
        }
        if (h == 0) {
            if (kwh == 1) {
                ciAdvance();
                #stack[int, 64] condPos = ciPos;
                #stack[int, 64] se = ciExec;
                #stack[int, 32] looping = 1;
                while (looping == 1) {
                    ciPos = condPos;
                    ciAdvance();
                    if (ciCur == 9) { ciAdvance(); }
                    ciExpr(0) c;
                    if (ciCur == 10) { ciAdvance(); }
                    #stack[int, 32] rb = 0;
                    if (c != 0) { if (se == 1) { rb = 1; } }
                    if (rb == 1) { ciExec = 1; ciStmt(); }
                    if (rb == 0) { ciExec = 0; ciStmt(); looping = 0; }
                    ciExec = se;
                    // guest loop control: signal 4 (break) ends THIS loop,
                    // signal 5 (continue) just re-evaluates the condition; both
                    // consumed here. return(2)/destruct(3) keep propagating out.
                    if (ciSignal == 4) { ciSignal = 0; looping = 0; }
                    if (ciSignal == 5) { ciSignal = 0; }
                    if (ciSignal >= 2) { looping = 0; }
                    #delete[rb];
                    #delete[c];
                }
                #delete[looping];
                #delete[se];
                #delete[condPos];
                h = 1;
            }
        }
        // ---- for (init; cond; post) { body } -- C-style. init runs once; each
        // iteration re-evaluates cond by resetting ciPos to the saved TOKEN INDEX
        // (zero re-lex). post runs after the body unless break/return exits.
        // continue runs post; break/return/destruct exit. The loop var lives in the
        // enclosing scope. (firefield uses while; for is here for completeness.)
        if (h == 0) {
            if (kfor == 1) {
                ciAdvance();                          // consume 'for'
                if (ciCur == 9) { ciAdvance(); }      // '(' -> ciCur = first init token
                #stack[int, 64] se = ciExec;
                // for-init: accept a bare `int i = expr` (also float/string/bool/
                // auto) loop-variable declaration. The bare type keyword as the
                // first init token means "declare this loop-local", mapped to the
                // same slot creation the #stack path uses (default bit width 64).
                // Anything else (assignment, #stack[..] decl, call) runs via ciStmt.
                #stack[int, 32] forDecl = 0;
                #stack[int, 64] fdType = 0;
                if (ciCur == 2) {
                    ciIdentIs(ciTokOff, ciTokLen, "int") fki;
                    ciIdentIs(ciTokOff, ciTokLen, "float") fkf;
                    ciIdentIs(ciTokOff, ciTokLen, "string") fks;
                    ciIdentIs(ciTokOff, ciTokLen, "bool") fkb;
                    ciIdentIs(ciTokOff, ciTokLen, "auto") fka;
                    if (fki == 1) { forDecl = 1; fdType = 0; }
                    if (fkf == 1) { forDecl = 1; fdType = 2; }
                    if (fks == 1) { forDecl = 1; fdType = 1; }
                    if (fkb == 1) { forDecl = 1; fdType = 0; }
                    if (fka == 1) { forDecl = 1; fdType = 0; }
                    #delete[fki];
                    #delete[fkf];
                    #delete[fks];
                    #delete[fkb];
                    #delete[fka];
                }
                if (forDecl == 1) {
                    ciAdvance();                      // consume type keyword
                    #stack[int, 64] fno = ciTokOff;   // loop-var name span
                    #stack[int, 64] fnl = ciTokLen;
                    ciAdvance();                      // consume name
                    #stack[int, 64] fv  = 0;
                    #stack[int, 64] fvt = fdType;
                    #stack[int, 64] fvo = 0;
                    if (ciCur == 14) {                // '='
                        ciAdvance();
                        ciExpr(0) fe;
                        fv  = fe;
                        fvt = ciEvalType;
                        fvo = ciEvalOwns;
                        #delete[fe];
                    }
                    if (ciExec == 1) {
                        ciSetMode = 0;                // force a fresh frame-local slot
                        ciVarSet(fno, fnl, fv, fvt, fvo);
                    }
                    if (ciExec == 0) {
                        if (fvo == 1) { if (fvt == 1) { cssc::free(fv); } }
                    }
                    if (ciCur == 13) { ciAdvance(); } // consume ';'
                    #delete[fv];
                    #delete[fvt];
                    #delete[fvo];
                    #delete[fno];
                    #delete[fnl];
                }
                if (forDecl == 0) {
                    ciStmt();                         // run init once (consumes its ';')
                }
                #delete[forDecl];
                #delete[fdType];
                #stack[int, 64] condPos = ciPos - 1;  // first cond token (cur is at ciPos-1)
                #stack[int, 64] svx = ciExec;
                ciExec = 0;
                ciExpr(0) cskip;                      // skip cond to reach the ';'
                #delete[cskip];
                ciExec = svx;
                #delete[svx];
                if (ciCur == 13) { ciAdvance(); }     // ';' -> ciCur = first post token
                #stack[int, 64] postPos = ciPos - 1;  // first post token
                // skip post by scanning to the matching ')'
                #stack[int, 64] pdepth = 0;
                #stack[int, 32] psc = 1;
                while (psc == 1) {
                    if (ciCur == 0) { psc = 0; }
                    if (ciCur == 9) { pdepth = pdepth + 1; }
                    if (ciCur == 10) {
                        if (pdepth == 0) { psc = 0; }
                        if (pdepth > 0) { pdepth = pdepth - 1; }
                    }
                    if (psc == 1) { ciAdvance(); }
                }
                #delete[psc];
                #delete[pdepth];
                if (ciCur == 10) { ciAdvance(); }     // ')' -> ciCur = '{' body start
                #stack[int, 64] bodyPos = ciPos - 1;  // '{'
                #stack[int, 32] looping = 1;
                while (looping == 1) {
                    ciPos = condPos;
                    ciAdvance();
                    ciExpr(0) c;
                    #stack[int, 32] rb = 0;
                    if (c != 0) { if (se == 1) { rb = 1; } }
                    #delete[c];
                    if (rb == 1) {
                        ciPos = bodyPos;
                        ciAdvance();
                        ciExec = 1;
                        ciStmt();
                        #stack[int, 32] didBrk = 0;
                        if (ciSignal == 5) { ciSignal = 0; }
                        if (ciSignal == 4) { ciSignal = 0; looping = 0; didBrk = 1; }
                        if (ciSignal == 2) { looping = 0; didBrk = 1; }
                        if (ciSignal == 3) { looping = 0; didBrk = 1; }
                        if (didBrk == 0) {
                            ciPos = postPos;
                            ciAdvance();
                            ciExec = 1;
                            ciStmt();
                        }
                        #delete[didBrk];
                    }
                    if (rb == 0) {
                        ciPos = bodyPos;
                        ciAdvance();
                        ciExec = 0;
                        ciStmt();
                        looping = 0;
                    }
                    ciExec = se;
                    #delete[rb];
                }
                #delete[looping];
                #delete[bodyPos];
                #delete[postPos];
                #delete[condPos];
                #delete[se];
                h = 1;
            }
        }
        // ---- select (iterable) ?label { body } ----
        // Iterates a container/string ONE element per pass, binding each element
        // to ?label. Body advances the cursor via jump;(+1) jump++;(+2)
        // !jump;(-1) !jump++;(-2). continue == jump(+1); break exits. Falling off
        // the body WITHOUT a jump EXITS (no implicit advance). map yields VALUES;
        // bind yields FLAT CELLS (the one CCOS divergence from CSSC pair-iter --
        // CCOS has no pair scalar to bind to a label). Cursor out of range exits.
        if (h == 0) {
            if (ksel == 1) {
                ciAdvance();                          // 'select'
                if (ciCur == 9) { ciAdvance(); }      // '('
                ciExpr(0) ih;                         // evaluate iterable ONCE
                #stack[int, 64] it    = ciEvalType;   // 4 vec / 5 map / 7 bind / 1 string
                #stack[int, 64] ownIt = ciEvalOwns;
                if (ciCur == 10) { ciAdvance(); }     // ')'
                if (ciCur == 32) { ciAdvance(); }     // '?'
                #stack[int, 64] labOff  = ciTokOff;   // label name span
                #stack[int, 64] labLen  = ciTokLen;
                #stack[int, 64] bodyPos = ciPos;      // past label -> re-lexes to '{'
                if (ciCur == 2) { ciAdvance(); }      // consume label ident

                // element COUNT per container (safe in skip mode: a missing var
                // gives it==0 -> no branch dereferences ih)
                #stack[int, 64] count = 0;
                if (it == 4) { ciVecSize(ih) rvs; count = rvs; #delete[rvs]; }
                if (it == 5) { ciMapSize(ih) rms; count = rms; #delete[rms]; }
                if (it == 1) { count = cssc::peek32(ih + 4); }
                if (it == 7) {
                    ciBindPairs(ih) rbp;
                    ciBindWidth(ih) rbw;
                    count = rbp * rbw;
                    #delete[rbp];
                    #delete[rbw];
                }

                #stack[int, 64] svCur = ciSelCursor; #stack[int, 64] svIn = ciInSelect;
                #stack[int, 64] svLO  = ciSelLabOff; #stack[int, 64] svLL = ciSelLabLen;
                ciSelLabOff = labOff;
                ciSelLabLen = labLen;

                #stack[int, 64] se = ciExec;
                #stack[int, 64] cursor  = 0;
                #stack[int, 64] maxIter = count * 1000;
                if (maxIter < 100000) { maxIter = 100000; }
                #stack[int, 64] iters = 0;
                #stack[int, 32] looping = 1;
                if (se == 0) { looping = 0; }

                while (looping == 1) {
                    #stack[int, 32] inb = 0;
                    if (cursor >= 0) { if (cursor < count) { inb = 1; } }
                    if (inb == 0) { looping = 0; }
                    if (inb == 1) { iters = iters + 1; if (iters > maxIter) { looping = 0; } }
                    if (looping == 1) {
                        #stack[int, 64] ev = 0;
                        #stack[int, 64] et = 0;
                        #stack[int, 64] eo = 0;
                        if (it == 4) {
                            ciVecGet(ih, cursor) rvg; ev = rvg; #delete[rvg];
                            #stack[int, 64] vet = cssc::peek32(ih + 12);
                            if (vet == 8) {
                                #stack[int, 64] vtp = cssc::peek64(ih + 24);
                                et = cssc::peek32(vtp + cursor * 8);
                                #delete[vtp];
                            }
                            if (vet != 8) {
                                ciVecType(ih) rvt; et = rvt; #delete[rvt];
                            }
                            if (et == 1) { eo = 1; }
                            #delete[vet];
                        }
                        if (it == 5) {
                            #stack[int, 64] d  = cssc::peek64(ih + 16);
                            #stack[int, 64] vt = cssc::peek64(d + cursor * 32 + 16);
