                                    vqm = vqm + 1;
                                }
                                #delete[vqm];
                                #stack[int, 64] vqtotal = al + 2 + vnl;
                                #stack[int, 64] vval = cssc::peek64(ciVVals + vqr * 8);
                                #stack[int, 64] vtyp = cssc::peek64(ciVTypes + vqr * 8);
                                ciVarSet(ciQualBuf - ciSrc, vqtotal, vval, vtyp, 0);
                                #delete[vval];
                                #delete[vtyp];
                                #delete[vqtotal];
                                #delete[vnl];
                                vqr = vqr + 1;
                            }
