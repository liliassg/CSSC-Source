                            // have pushed it further -- do NOT reset it here.)
                            if (ciLoadCount < 32) {
                                #stack[int, 32] zk = 0;
                                while (zk < 32) {
                                    cssc::poke8(ciLoadName + ciLoadCount * 32 + zk, 0);
                                    zk = zk + 1;
                                }
                                #delete[zk];
                                #stack[int, 64] ncap = al;
                                if (ncap > 32) { ncap = 32; }
                                #stack[int, 32] nk = 0;
                                while (nk < ncap) {
                                    cssc::poke8(ciLoadName + ciLoadCount * 32 + nk, cssc::peek8(ciSrc + ao + nk));
                                    nk = nk + 1;
                                }
                                #delete[nk];
                                #delete[ncap];
                                cssc::poke64(ciLoadFnS + ciLoadCount * 8, fnBefore);
                                cssc::poke64(ciLoadFnE + ciLoadCount * 8, ciFnCount);
                                ciLoadCount = ciLoadCount + 1;
                            }
                            #delete[rp];
                            #delete[rc];
                            #delete[rtn];
                            #delete[rto];
                            #delete[rtl];
                            #delete[rsg];
                            #delete[aend];
                            #delete[fnBefore];
                            #delete[tokStart];
                        }
                        #delete[astart];
