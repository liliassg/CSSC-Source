                        if (ciAlCount < 128) {
                            cssc::poke64(ciAlOff + ciAlCount * 8, aliasOff);
                            cssc::poke64(ciAlLen + ciAlCount * 8, aliasLen);
                            cssc::poke64(ciAlMod + ciAlCount * 8, modid);
                            ciAlCount = ciAlCount + 1;
                        }
                    }
                    #delete[modid];
                }
                #delete[aliasOff];
                #delete[aliasLen];
                #delete[mvid];
                #delete[msnd];
                #delete[mkey];
                #delete[mini];
                #delete[mini2];
                #delete[mstd];
                #delete[msys];
                #delete[mspr];
                #delete[mtm];
                #delete[mfnt];
                #delete[mma1]; #delete[mma2]; #delete[mma3]; #delete[mmaA];
                #delete[mcm1]; #delete[mcm2]; #delete[mcmA];
                #delete[mdef];
                #delete[mcon];
                #delete[mcon2];
                #delete[mcon3];
                #delete[mconA];
                #delete[mdvd];
                #delete[mdv2];
                #delete[mdevA];
                #delete[mgrc];
                #delete[mstdo];
                #delete[mmou];
                #delete[mo];
                #delete[ml];
                dh = 1;
