            }
            // ---- #debug(msg); -- append msg's string to dev::stdout (always) then
            // synchronously tail-forward to every bound console. ----
            if (dh == 0) {
                if (kdbg == 1) {
                    ciAdvance();
                    if (ciCur == 9) { ciAdvance(); }
                    ciExpr(0) dmsg;
                    #stack[int, 64] dmt = ciEvalType;
                    #stack[int, 64] dmo = ciEvalOwns;
                    if (ciCur == 10) { ciAdvance(); }
                    if (ciCur == 13) { ciAdvance(); }
                    if (ciExec == 1) {
                        #stack[int, 64] sp = 0;
                        #stack[int, 32] spOwn = 0;
                        if (dmt == 1) { sp = dmsg; }
                        if (dmt != 1) {
                            #stack[int, 64] tb = cssc::alloc(64);
                            #stack[int, 64] tn = 0;
                            if (dmt == 0) { ciItoa(dmsg, tb) dn; tn = dn; #delete[dn]; }
                            if (dmt == 2) { cssc::fToStr(dmsg, tb, 64) dn; tn = dn; #delete[dn]; }
                            if (dmt >= 4) { ciContFmt(dmsg, dmt, tb, 0, 64) dn; tn = dn; #delete[dn]; }
                            ciStrNew(tb, tn) ns;
                            sp = ns;
                            spOwn = 1;
