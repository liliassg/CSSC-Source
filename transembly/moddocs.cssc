    if (txSpanEqLit(mOff, mLen, "cssc.binary") == 1) { if (txSpanEqLit(nOff, nLen, "Binary") == 1) { txEmitFiltered(pOff, pLen, "find\nget\ncontains\nadd\ndelete\ntypeof"); } }
