    if (txSpanEqLit(mOff, mLen, "video.sprite") == 1) { txEmitFiltered(pOff, pLen, "animCreate\nanimCurrentFrame\nanimDraw\nanimFinished\nanimReset\nanimUpdate\nclear\ncreate\ncreateFromAscii\ndraw\ndrawAlpha\ndrawFlipped\ndrawScaled\ndrawTinted\ngetPixel\nheight\nhitAabb\nhitPoint\nloadBmp\nsetKey\nsetPixel\nsheetCols\nsheetCreate\nsheetDrawFrame\nsheetFrame\nsheetLoadBmp\nsheetRows\nwidth"); }
    if (txSpanEqLit(mOff, mLen, "video.tilemap") == 1) { txEmitFiltered(pOff, pLen, "cameraCreate\ncameraFollow\ncameraMove\ncameraSet\ncameraSetBounds\ncameraX\ncameraY\ncollideAabb\ncreate\ndraw\nfill\ngetTile\nheight\nisSolid\npixelHeight\npixelWidth\nscreenToWorld\nsetLayout\nsetSolid\nsetTile\ntileAtWorld\ntileHeight\ntileWidth\ntilesetCreate\ntilesetLoadBmp\nwidth\nworldToScreen"); }
    return 0;
}

