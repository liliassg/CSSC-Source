    if (txSpanEqLit(mOff, mLen, "cssc.binary") == 1) { if (txSpanEqLit(nOff, nLen, "read") == 1) { txEmitFiltered(pOff, pLen, "find\nget\ncontains\nadd\ndelete\ntypeof"); } }
    if (txSpanEqLit(mOff, mLen, "cssc.binary") == 1) { if (txSpanEqLit(nOff, nLen, "tobinary") == 1) { txEmitFiltered(pOff, pLen, "find\nget\ncontains\nadd\ndelete\ntypeof"); } }
