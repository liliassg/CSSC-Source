// ===========================================================================
// compiler/main.cssc -- Transembly CSSC compiler, milestone M1 ENTRY.
//
// Concatenated LAST (after lex/ast/parse/cir/lower/x86/emit); these top-level
// statements become the program entry. Full pipeline for the M1 subset
// (`cssc::outln(<int|string literal>)`):
//
//   stdin bytes -> lex -> parse (AST) -> lower (CIR) -> x86 (bytes)
//               -> emit TXB1 text container to stdout
//
// harness/run.py parses the container, loads the code into executable memory,
// patches runtime relocs, and runs it -- its stdout must equal `cssc run`.
// ===========================================================================

// Module loader: after tokenizing the main program, scan the TOKEN stream (robust
// vs raw text -- no false hits inside strings/comments) for `#include('name')` and
// `#load[path]`, read each referenced source, and build a COMBINED buffer
// [module sources...] + [main] which is re-tokenized once. This keeps lex/parse
// non-re-entrant (one pass over the combined text); the `#include`/`#load` lines
// stay in place and become MODALIAS nodes that bind the alias to the module sector.
#stack[int, 64] txLoadModules;
#define(txLoadModules) {
    #scanp(txLoadModules, int, 0) mainBuf;
    #scanp(txLoadModules, int, 1) mainLen;
    #scanp(txLoadModules, int, 2) comb;
    #scanp(txLoadModules, int, 3) combCap;
    #req[txTokCount] txTokCount;
    #req[txTokCode] txTokCode;
    #req[txTokOffA] txTokOffA;
    #req[txTokLenA] txTokLenA;
    #req[txSrc] txSrc;
    #req[txSpanIs] txSpanIs;
    #req[txCapBad] txCapBadLM;
    #stack[int, 64] cn = 0;
    #stack[int, 64] ti = 0;
    #stack[int, 32] go = 1;
    while (go == 1) {
        if (ti + 3 >= txTokCount) { go = 0; }
        if (go == 1) {
            if (cssc::peek8(txTokCode + ti) == 22) {                 // '#'
                #stack[int, 64] koff = cssc::peek32(txTokOffA + (ti + 1) * 4);
                #stack[int, 64] klen = cssc::peek32(txTokLenA + (ti + 1) * 4);
                txSpanIs(koff, klen, "include") isInc;
                txSpanIs(koff, klen, "load") isLoad;
                #stack[int, 64] soff = cssc::peek32(txTokOffA + (ti + 3) * 4);
                #stack[int, 64] slen = cssc::peek32(txTokLenA + (ti + 3) * 4);
                if (isInc == 1) { cssc::modPathInc(txSrc + soff, slen); }
                if (isLoad == 1) { cssc::modPath(txSrc + soff, slen); }
                if (isInc + isLoad > 0) {
                    if (cn + 1000000 + 8 >= combCap) { txCapBadLM = 1; }   // module would overflow comb
                    if (cn + 1000000 + 8 < combCap) {
                        #stack[int, 64] nr = cssc::modRead(comb + cn, 1000000);
                        if (nr > 0) { cn = cn + nr; cssc::poke8(comb + cn, 10); cn = cn + 1; }
                        #delete[nr];
                    }
                }
                #delete[slen]; #delete[soff];
                #delete[isLoad]; #delete[isInc]; #delete[klen]; #delete[koff];
            }
            ti = ti + 1;
        }
    }
    #delete[go];
    #delete[ti];
    if (cn + mainLen + 1 >= combCap) { txCapBadLM = 1; return cn; }    // main would overflow comb
    #stack[int, 64] mi = 0;                                          // append the main source
    #stack[int, 32] mg = 1;
    while (mg == 1) {
        if (mi >= mainLen) { mg = 0; }
        if (mg == 1) { cssc::poke8(comb + cn + mi, cssc::peek8(mainBuf + mi)); mi = mi + 1; }
    }
    #delete[mg];
    cn = cn + mainLen;
    #delete[mi];
    return cn;
}

// Visible abort for a capacity overflow (input / AST / CIR / func / glob / sym /
// code / strings / relocs / comb). Printed instead of a silently-truncated
// artefact; the driver then sees no ENTRY/CODE/OBJ line and reports failure.
#stack[int, 64] txCapAbortMsg;
#define(txCapAbortMsg) {
    #stack[string, 256] ce = "CAPACITY_EXCEEDED: program exceeds a fixed compiler table (input/AST/CIR/functions/globals/symbols/code/strings/relocs). No output emitted -- split into smaller modules.";
    cssc::outln(ce);
    #delete[ce];
}

// Read the whole program off stdin. ★ The buffer was 1 MiB, which SILENTLY
// TRUNCATED any larger source (fread stops at the cap) -- a 2.4 MB kernel was cut
// to ~42%, which then compiled+linked+booted but produced almost no output. Now
// 32 MiB, and a fill-to-cap read is treated as OVERFLOW (txCapBad) so an even
// bigger input aborts VISIBLY instead of losing its tail.
#stack[int, 64] inCap = 33554432;
#stack[int, 64] buf = cssc::alloc(inCap);
#stack[int, 64] n = cssc::hostRead(buf, inCap - 1);
if (n >= inCap - 1) { #req[txCapBad] txCapBadIn; txCapBadIn = 1; }

txLexInit();
txTokenizeSrc(buf, n);        // fills token columns; sets txSrc = buf

// Pull in #include/#load module sources, then re-tokenize the combined text.
// 64 MiB holds a large program plus its inlined modules; txLoadModules flags
// txCapBad if the combined text would exceed it (see its guard).
#stack[int, 64] combCap = 67108864;
#stack[int, 64] comb = cssc::alloc(combCap);
#stack[int, 64] cn = txLoadModules(buf, n, comb, combCap);
txTokenizeSrc(comb, cn);      // txSrc now = comb (modules + main)

txAstInit();
txParseProgram() prog;        // AST root (PROGRAM node)

// E020 is the ONE place this compiler rejects instead of warning: a bare heap
// literal in a position where nothing can own it. The reference refuses the
// build here too (probe p_e020_concat, rc=1), so accepting it would make us
// disagree with the oracle on which programs are legal -- not just on what they
// print. Emitting no container IS the rejection: run.py cannot load one.
#req[txCapBad] txCapBadR;
// ★ Abort BEFORE txValidateLits / txLower if the stdin read or PARSE overflowed a
// table. The AST clamp can leave a CYCLIC node (a child pointing at the reused
// last slot), which would make the AST walkers LOOP forever -- so this early gate
// is what stops an over-cap program from HANGING instead of failing cleanly.
if (txCapBadR == 1) { txCapAbortMsg(); }
if (txCapBadR == 0) {
txValidateLits(prog) litBad;
if (litBad == 0) {
    txCirInit();
    txLower(prog);                // AST -> CIR (may set txIsoBad when a #define
                                  // body calls an un-#req'd sibling -- isolation)
    // A CIR overflow during lowering would likewise make txX86Emit loop -> abort.
    if (txCapBadR == 1) { txCapAbortMsg(); }
    if (txCapBadR == 0) {

    // Isolation violation OR a CONSTANT int/bool overflowing its declared bit
    // width -> reject like the reference: emit NO container (compile-time). The
    // bit overflow is a COMPILE-TIME contract (deterministic, no runtime guard);
    // a dynamic value is RAW.
    #req[txBitBad] txBitBadR;
    #req[txIntrinBad] txIntrinBadR;
    #req[txIntrinBadOff] txIntrinBadOffR;
    #req[txIntrinBadLen] txIntrinBadLenR;
    #stack[int, 32] canEmit = 0;
    if (txIsoBad == 0) { if (txBitBadR == 0) { if (txIntrinBadR == 0) { canEmit = 1; } } }
    // Name the builtin. "no output" on a large program costs a bisect to
    // localise; the name costs one line here.
    if (txIntrinBadR == 1) {
        cssc::out("UNIMPLEMENTED_BUILTIN ");
        cssc::printRaw(txSrc + txIntrinBadOffR, txIntrinBadLenR);
        cssc::outln();
    }
    if (canEmit == 1) {
        // Sink selection (argv[1]), decided BEFORE codegen:
        //   (none)  -> hosted TXB1 container (run.py / selfcarry)
        //   --free  -> standalone static Linux ELF, target 1 (raw syscalls)
        // fsTarget is the freestanding layout id (1 = Linux static).
        #stack[int, 32] fsMode = 0;
        #stack[int, 32] fsTarget = 0;
        if (cssc::argc() >= 2) {
            #stack[int, 64] fbuf = cssc::alloc(64);
            #stack[int, 64] fal = cssc::argStr(1, fbuf, 63);
            cssc::poke8(fbuf + fal, 0);
            #stack[string, 8] fdash = "--free";
            #stack[int, 64] fda = 0;
            #adress[fdash] fda;
            #stack[int, 64] fdh = cssc::peek64(fda);
            #stack[int, 32] fmatch = 1;
            #stack[int, 64] fi = 0;
            while (fi < 6) {
                if (cssc::peek8(fbuf + fi) != cssc::peek8(fdh + 8 + fi)) { fmatch = 0; }
                fi = fi + 1;
            }
            if (fmatch == 1) { fsMode = 1; fsTarget = 1; }   // --free -> Linux static (target 1)
            #delete[fi];
            #delete[fmatch];
            #delete[fdh];
            #delete[fda];
            #delete[fdash];
            #delete[fal];
            #delete[fbuf];
        }
        txX86Init();
        txX86Emit();              // CIR -> x86-64 bytes + relocs + string data
        // ★ CODE / string-data / fixup overflow during emit -> abort visibly.
        if (txCapBadR == 1) { txCapAbortMsg(); }
        if (txCapBadR == 0) {
            if (fsMode == 1) { txEmitFreestanding(0, fsTarget); }
            if (fsMode == 0) { txEmitContainer(0); }
        }
        #delete[fsTarget];
        #delete[fsMode];
    }
    }
}
if (litBad != 0) {
    #stack[string, 256] e020 = "E020: Bare-Heap-Literal in Argument-/Operand-Position hat keinen besitzenden Slot. CSSC v5 fordert, dass jeder Heap-Wert in einem deklarierten Slot lebt.";
    cssc::outln(e020);
    #delete[e020];
}

#delete[litBad];
}
#delete[prog];
#delete[n];
#delete[buf];
