// ===========================================================================
//  transembly/sema_complete_main.cssc  --  completion entry. Reads source with
//  a cursor marker byte (0x04) on stdin and prints candidate completion labels
//  (one per line) for that position. Parity vs `cssc lsp complete`.
//
//  Two buffers (mirrors the reference's _sane_analysis): `buf` keeps the
//  original cursor-line text (marker -> space) for reading the partial word +
//  qualifier; `bufP` blanks the whole cursor line so the incomplete word does
//  not break the parse of the rest of its enclosing scope. Blanking preserves
//  byte offsets (same-length spaces) and newlines, so symbol offsets/line
//  numbers are identical in both views.
// ===========================================================================

// Input: argv[1] file (0x04 marker byte inside) for the IDE (system::capture,
// no stdin, no hang); else stdin (the parity harness pipes the marked source).
#stack[int, 64] buf = cssc::alloc(1048576);
#stack[int, 64] n = 0;
if (cssc::argc() >= 2) {
    #stack[int, 64] pathBuf = cssc::alloc(4096);
    #stack[int, 64] plen = cssc::argStr(1, pathBuf, 4096);
    #stack[int, 64] rn = cssc::osReadFile(pathBuf, plen, buf, 1000000);
    if (rn < 0) { rn = 0; }
    n = rn;
    // Keep the edited file's DIRECTORY so `#load["rel.cssc"] alias;` completions can
    // resolve `alias::` against it. dirLen = offset of the last '/' or '\' in the path.
    #req[txCompDirBuf] txCompDirBuf;
    #req[txCompDirLen] txCompDirLen;
    txCompDirBuf = cssc::alloc(4096);
    #stack[int, 64] dcut = 0 - 1;
    #stack[int, 64] di = 0;
    while (di < plen) {
        #stack[int, 64] dc = cssc::peek8(pathBuf + di);
        if (dc == 47) { dcut = di; }
        if (dc == 92) { dcut = di; }
        #delete[dc];
        di = di + 1;
    }
    #delete[di];
    if (dcut >= 0) {
        #stack[int, 64] dk = 0;
        while (dk < dcut) { cssc::poke8(txCompDirBuf + dk, cssc::peek8(pathBuf + dk)); dk = dk + 1; }
        txCompDirLen = dcut;
        #delete[dk];
    }
    #delete[dcut];
    #delete[pathBuf];
    #delete[plen];
    #delete[rn];
}
if (cssc::argc() < 2) {
    #stack[int, 64] sn = cssc::hostRead(buf, 1000000);
    n = sn;
    #delete[sn];
}

txFindMarker(buf, n) mk;
cssc::poke8(buf + mk, 32);              // marker -> space (buf = original text view)

#stack[int, 64] bufP = cssc::alloc(1048576);
#stack[int, 64] ci = 0;
while (ci < n) {
    cssc::poke8(bufP + ci, cssc::peek8(buf + ci));
    ci = ci + 1;
}
#delete[ci];

#stack[int, 64] ls = mk;               // cursor line start
#stack[int, 32] g1 = 1;
while (g1 == 1) {
    if (ls <= 0) { g1 = 0; }
    if (g1 == 1) {
        if (cssc::peek8(buf + ls - 1) == 10) { g1 = 0; }
        if (g1 == 1) { ls = ls - 1; }
    }
}
#delete[g1];
#stack[int, 64] le = mk;               // cursor line end
#stack[int, 32] g2 = 1;
while (g2 == 1) {
    if (le >= n) { g2 = 0; }
    if (g2 == 1) {
        if (cssc::peek8(buf + le) == 10) { g2 = 0; }
        if (g2 == 1) { le = le + 1; }
    }
}
#delete[g2];
#stack[int, 64] bi = ls;               // blank the cursor line in bufP
while (bi < le) {
    cssc::poke8(bufP + bi, 32);
    bi = bi + 1;
}
#delete[bi];
#delete[ls];
#delete[le];

txLexInit();
txTokenizeSrc(bufP, n);                 // parse the blanked-line view
txAstInit();
txParseProgram() prog;
txSemaBuildSyms(prog);                  // symbol/scope model

txSetSrc(buf, n);                       // switch to the original text for completion
txCompleteAt(mk);

#delete[prog];
#delete[mk];
#delete[n];
#delete[bufP];
#delete[buf];
