        // on isCat alone would ALSO fire for the string-compare case and
        // overwrite `out` with a pointer comparison)
        if (isCat == 0) {
            if (isSEq == 0) {
                if (isFlt == 0) {
                    txCirBinOp(opc, lhs, rhs) id;
                    out = id;
                    #delete[id];
                }
            }
        }
        #delete[isFlt];
        #delete[isSEq];
        #delete[anyStr];
        #delete[isCat];
        #delete[lhs];
        #delete[rhs];
        #delete[opc];
    }
    if (kind == 13) {                                 // NOT -> (op == 0)
        txLowerExpr(cssc::peek64(txAstA + node * 8)) op;
        txCirConstInt(0) z;
        txCirBinOp(10, op, z) id;                     // op-code 10 = '=='
        out = id;
        #delete[id];
        #delete[z];
        #delete[op];
    }
    if (kind == 22) {                                 // ARRAY_LIT `{a, b, c}`
        // build a fresh vector sized to the literal, then push each element
        #stack[int, 64] cnt = 0;
        #stack[int, 64] ce = cssc::peek64(txAstA + node * 8);
        #stack[int, 32] cgo2 = 1;
        while (cgo2 == 1) {
            if (ce == 0) { cgo2 = 0; }
            if (cgo2 == 1) { cnt = cnt + 1; ce = cssc::peek64(txAstNext + ce * 8); }
        }
        #delete[cgo2];
        #delete[ce];
        txCirConstInt(cnt) capv;
        txCirCallR(22, capv, 0 - 1) vv;               // cssc_vec_new(cap)
        txSetVec(vv);
        #stack[int, 64] el = cssc::peek64(txAstA + node * 8);
        #stack[int, 32] ego = 1;
        #stack[int, 64] elemK = 0;                    // infer element kind from the first
        while (ego == 1) {
            if (el == 0) { ego = 0; }
            if (ego == 1) {
                txLowerExpr(el) ev;
                if (elemK == 0) {
                    txIsStr(ev) es2;
                    if (es2 == 1) { elemK = 1; }
                    #delete[es2];
                    txIsFloat(ev) ef2;
                    if (ef2 == 1) { elemK = 2; }
                    #delete[ef2];
                    txIsBool(ev) eb2;                 // bool elements -> true/false
                    if (eb2 == 1) { elemK = 3; }
                    #delete[eb2];
                }
                txCirCall(23, vv, ev);                // cssc_vec_push(v, x)
                txContainerTake(ev);                  // container holds a strong ref
                #delete[ev];
                el = cssc::peek64(txAstNext + el * 8);
            }
        }
        txSetElem(vv, elemK);
        #delete[elemK];
        #delete[ego];
        #delete[el];
        out = vv;
        #delete[vv];
        #delete[capv];
        #delete[cnt];
    }
    if (kind == 27) {                                 // COPY marker `&x`
        // v5: `&x` requests a COPY rather than the default by-reference pass.
        // For a string that is a real deep copy (cssc_string_copy); ints/floats
        // are values already, so passing them through IS the copy.
        txLowerExpr(cssc::peek64(txAstA + node * 8)) cv;
        #stack[int, 64] cDone = 0;
        txIsStr(cv) cIsStr;
        if (cIsStr == 1) {
            txCirCallR(14, cv, 0 - 1) cc;             // cssc_string_copy(s)
            txSetStr(cc);
            txSetOwned(cc);                           // fresh refcount-1 value
            out = cc;
            cDone = 1;
            #delete[cc];
        }
        #delete[cIsStr];
        // Containers: `&` is a RECURSIVE deep copy (spec 2.5 -- `&` IS
        // cssc::copy). The runtime cannot tell an integer cell from a string
        // pointer, so we pass the statically known element kind along.
        // Measured against the reference: docs/cssc-ownership.md section 2.
        if (cDone == 0) {
            txIsMap(cv) cIsMap;
            if (cIsMap == 1) {
                txGetElem(cv) cme;                    // 1 = string VALUES
                #stack[int, 64] cmf = 0;
                if (cme == 1) { cmf = 1; }
                txCirConstInt(cmf) cmk;
                txCirCallR(37, cv, cmk) cmc;          // cssc_map_copy(m, valIsStr)
                txSetMap(cmc);
                if (cme != 0) { txSetElem(cmc, cme); }
                // NOT txSetOwned: "owned" means owned STRING in this compiler --
                // txReleaseTemps would hand the fresh container to cssc_release.
                // Containers are torn down explicitly (cssc_map_free), like every
                // other container temporary (see the MAP_LIT / ARRAY_LIT paths).
                out = cmc;
                cDone = 1;
                #delete[cmc];
                #delete[cmk];
                #delete[cmf];
                #delete[cme];
            }
            #delete[cIsMap];
        }
        if (cDone == 0) {
            txIsVec(cv) cIsVec;                       // covers bind (vec storage)
            if (cIsVec == 1) {
                txGetElem(cv) cve;                    // 1 = string ELEMENTS
                #stack[int, 64] cvf = 0;
                if (cve == 1) { cvf = 1; }
                txCirConstInt(cvf) cvk;
                txCirCallR(36, cv, cvk) cvc;          // cssc_vec_copy(v, elemIsStr)
                txSetVec(cvc);
                if (cve != 0) { txSetElem(cvc, cve); }
                txIsBind(cv) cvb;                     // bind-ness must survive the
                if (cvb == 1) { txSetBind(cvc); }     // copy (pair-counting size())
                #delete[cvb];
                // NOT txSetOwned -- see the map branch above.
                out = cvc;
                cDone = 1;
                #delete[cvc];
                #delete[cvk];
                #delete[cvf];
                #delete[cve];
            }
            #delete[cIsVec];
        }
        // int / float / bool are values already -- passing them through IS the copy.
        if (cDone == 0) { out = cv; }
        #delete[cDone];
        #delete[cv];
    }
    if (kind == 25) {                                 // INDEX `recv[i]` (read)
        #stack[int, 32] idxHandled = 0;
        // `bind[i][j]` -- bind is flat pair-storage (pair_width 2), so the OUTER
        // index of an INDEX-of-a-bind is `vec_at(bind, i*2 + j)`. Detect the
        // nested shape here (recv is itself an INDEX whose recv is a bind slot).
        #stack[int, 64] rcvNode = cssc::peek64(txAstB + node * 8);
        if (cssc::peek64(txAstKind + rcvNode * 8) == 25) {
            #stack[int, 64] innerRecv = cssc::peek64(txAstB + rcvNode * 8);
            #stack[int, 32] innerIsBind = 0;
            if (cssc::peek64(txAstKind + innerRecv * 8) == 5) {   // IDENT
                txSymFind(cssc::peek64(txAstOff + innerRecv * 8), cssc::peek64(txAstLen + innerRecv * 8)) bsl;
                if (bsl >= 0) { txSlotIsBind(bsl) sb; if (sb == 1) { innerIsBind = 1; } #delete[sb]; }
                #delete[bsl];
            }
            if (innerIsBind == 1) {
                txLowerExpr(innerRecv) bvec;                       // the bind's flat vector
                txLowerExpr(cssc::peek64(txAstA + rcvNode * 8)) bi; // row i
                txLowerExpr(cssc::peek64(txAstA + node * 8)) bj;    // col j
                txCirConstInt(2) two2;
                txCirBinOp(3, bi, two2) i2;                        // i*2
                txCirBinOp(1, i2, bj) flat;                        // i*2 + j
                txCirCallR(24, bvec, flat) bv;                     // cssc_vec_at
                #stack[int, 64] belem = 0;
                txSymFind(cssc::peek64(txAstOff + innerRecv * 8), cssc::peek64(txAstLen + innerRecv * 8)) bsl2;
                if (bsl2 >= 0) { txSlotGetElem(bsl2) be; belem = be; #delete[be]; }
                #delete[bsl2];
                if (belem == 1) { txSetStr(bv); }
                if (belem == 2) { txSetFloat(bv); }
                if (belem == 3) { txSetBool(bv); }
                out = bv;
                idxHandled = 1;
                #delete[belem]; #delete[bv]; #delete[flat]; #delete[i2]; #delete[two2];
                #delete[bj]; #delete[bi]; #delete[bvec];
            }
            #delete[innerIsBind];
            #delete[innerRecv];
        }
        #delete[rcvNode];
        if (idxHandled == 0) {
        txLowerExpr(cssc::peek64(txAstB + node * 8)) irecv;
        txLowerExpr(cssc::peek64(txAstA + node * 8)) ikey;
        // `s[i]` on a STRING -> a fresh 1-char string (cssc_string_char_at),
        // NOT vec_at (which would treat the char buffer as a vector -> garbage).
        txIsStr(irecv) iIsStr0;
        if (iIsStr0 == 1) {
            txCirCallR(40, irecv, ikey) sch;          // cssc_string_char_at(s, i)
            txSetStr(sch);
            out = sch;
            idxHandled = 1;
            #delete[sch];
        }
        #delete[iIsStr0];
        if (idxHandled == 0) {                        // vector<auto>: value + runtime kind -> str
            txGetElem(irecv) ielemA;
            if (ielemA == 6) {
                txCirCallR(24, irecv, ikey) av;       // cssc_vec_at(v, i)
                txCirCallR(49, irecv, ikey) at;       // cssc_vec_type_at(v, i)
                txCirCallR(50, av, at) as;            // cssc_auto_to_str(val, kind) -> string
                txSetStr(as);
                out = as;
                idxHandled = 1;
                #delete[as]; #delete[at]; #delete[av];
            }
            #delete[ielemA];
        }
        if (idxHandled == 1) { #delete[ikey]; #delete[irecv]; }
        if (idxHandled == 0) {
        txIsMap(irecv) iIsMap;
        #stack[int, 64] getSym = 24;                  // cssc_vec_at
        if (iIsMap == 1) {
            getSym = 29;                              // cssc_map_get
            // int-keyed map: the runtime map is string-keyed, so stringify a
            // non-string key (matches the set side) rather than passing a raw
            // int as a pointer (crashes for any non-zero key).
            txIsStr(ikey) ikIsStr;
            if (ikIsStr == 0) { txCirCallR(11, ikey, 0 - 1) iks; ikey = iks; #delete[iks]; }
            #delete[ikIsStr];
        }
        txCirCallR(getSym, irecv, ikey) ir;
        txGetElem(irecv) iek;                         // type the element
        if (iek == 1) { txSetStr(ir); }
        if (iek == 2) { txSetFloat(ir); }
        if (iek == 3) { txSetBool(ir); }
        #delete[iek];
        out = ir;
        #delete[ir];
        #delete[getSym];
        #delete[iIsMap];
        #delete[ikey];
        #delete[irecv];
        }                                             // end vec/map path
        }                                             // end non-bind path
    }
    if (kind == 24) {                                 // MAP_LIT `{"k": v, ...}`
        // the parser chains pairs flat: k1, v1, k2, v2, ...
        txCirConstInt(8) mcap;
        txCirCallR(27, mcap, 0 - 1) mm;               // cssc_map_new(cap)
        txSetMap(mm);
        #stack[int, 64] mp = cssc::peek64(txAstA + node * 8);
        #stack[int, 32] mgo2 = 1;
        #stack[int, 64] mElem = 0;
        while (mgo2 == 1) {
            if (mp == 0) { mgo2 = 0; }
            if (mgo2 == 1) {
                #stack[int, 64] vn = cssc::peek64(txAstNext + mp * 8);
                txLowerExpr(mp) kv;                   // key
                if (vn != 0) {
                    txLowerExpr(vn) vv2;              // value
                    if (mElem == 0) {
                        txIsStr(vv2) ms;
                        if (ms == 1) { mElem = 1; }
                        #delete[ms];
                        txIsFloat(vv2) mf;
                        if (mf == 1) { mElem = 2; }
                        #delete[mf];
                    }
                    txCirCall3(28, mm, kv, vv2);      // cssc_map_set(m, key, value)
                    txContainerTake(kv);              // map holds strong refs to
                    txContainerTake(vv2);             // both key and value
                    #delete[vv2];
                    mp = cssc::peek64(txAstNext + vn * 8);
                } else { mp = 0; }
                #delete[kv];
                #delete[vn];
            }
        }
        txSetElem(mm, mElem);
        #delete[mElem];
        #delete[mgo2];
        #delete[mp];
        out = mm;
        #delete[mm];
        #delete[mcap];
    }
    if (kind == 23) {                                 // METHOD_CALL `recv.name(args)`
        #stack[int, 64] mOff = cssc::peek64(txAstOff + node * 8);
        #stack[int, 64] mLen = cssc::peek64(txAstLen + node * 8);
        // `?label.pos()` inside a select -> the cursor value. Intercept BEFORE
        // lowering the receiver, which would otherwise load the label's element.
        txSpanIs(mOff, mLen, "pos") isPos;
        #stack[int, 32] posDone = 0;
        if (isPos == 1) {
            #stack[int, 64] rcv = cssc::peek64(txAstB + node * 8);
            if (cssc::peek64(txAstKind + rcv * 8) == 5) {     // receiver is an IDENT
                txSelPosLookup(cssc::peek64(txAstOff + rcv * 8),
                               cssc::peek64(txAstLen + rcv * 8)) posCur;
                if (posCur >= 0) {
                    txCirSlotLoad(posCur) pv;
                    out = pv;
                    posDone = 1;
                    #delete[pv];
                }
                #delete[posCur];
            }
        }
        #delete[isPos];
        // NOTE: do NOT `#delete[posDone]` before the second test -- an unbound
        // name reads as 0, so `if (posDone == 0)` would fire again and the whole
        // dispatch below would overwrite a real `.pos()` result with const-0.
        // (This exact trap cost an afternoon; it is the M7c delete semantics
        // biting our own source. Keep posDone live across both branches.)
        // `inst.label(args)` -- if the receiver is an object instance and the
        // method is one of its labels, call the label function (singleton: the
        // label reaches the object's member globals directly).
        if (posDone == 0) {
            #req[txInstFind] txInstFind;
            #req[txLabFindFn] txLabFindFn;
            #req[txCirCallUser] txCirCallUser;
            #req[txCallArg] txCallArgL;
            #req[txCallArgCount] txCallArgCountL;
            #req[txAstNext] txAstNextL;
            #req[txMemBlock] txMemBlock;
            #stack[int, 64] rcvN = cssc::peek64(txAstB + node * 8);
            if (cssc::peek64(txAstKind + rcvN * 8) == 5) {   // receiver IDENT
                txInstFind(cssc::peek64(txAstOff + rcvN * 8), cssc::peek64(txAstLen + rcvN * 8)) iObj;
                if (iObj >= 0) {
                    txLabFindFn(iObj, mOff, mLen) lfn;
                    if (lfn >= 0) {
                        // "this" = the receiver instance's BLOCK pointer (arg0); the
                        // label's own params follow at arg1+.
                        txMemBlock(rcvN) lblk;
                        #stack[int, 64] la = cssc::peek64(txAstA + node * 8);
                        #stack[int, 64] lac = 0;
                        #stack[int, 64] lc = la;
                        #stack[int, 32] lcgo = 1;
                        while (lcgo == 1) {
                            if (lc == 0) { lcgo = 0; }
                            if (lcgo == 1) { lac = lac + 1; lc = cssc::peek64(txAstNextL + lc * 8); }
                        }
                        #delete[lcgo];
                        #delete[lc];
                        #stack[int, 64] las = txCallArgCountL;
                        txCallArgCountL = txCallArgCountL + lac + 1;
                        cssc::poke64(txCallArgL + las * 8, lblk);   // arg0 = this
                        #stack[int, 64] lai = 0;
                        #stack[int, 64] laa = la;
                        #stack[int, 32] lago = 1;
                        while (lago == 1) {
                            if (laa == 0) { lago = 0; }
                            if (lago == 1) {
                                txLowerExpr(laa) lsid;
                                cssc::poke64(txCallArgL + (las + 1 + lai) * 8, lsid);
                                lai = lai + 1;
                                #delete[lsid];
                                laa = cssc::peek64(txAstNextL + laa * 8);
                            }
                        }
                        #delete[lago];
                        txNewSsa() lres;
                        txCirCallUser(lfn, las, lac + 1, lres);
                        out = lres;
                        posDone = 1;
                        #delete[lres];
                        #delete[laa];
                        #delete[lai];
                        #delete[las];
                        #delete[lac];
                        #delete[la];
                        #delete[lblk];
                    }
                    #delete[lfn];
                }
                #delete[iObj];
            }
            #delete[rcvN];
        }
        if (posDone == 0) {
        txLowerExpr(cssc::peek64(txAstB + node * 8)) recv;
        #stack[int, 64] a1 = cssc::peek64(txAstA + node * 8);
        txSpanIs(mOff, mLen, "size") isSize;
        txSpanIs(mOff, mLen, "at") isAt;
        txSpanIs(mOff, mLen, "push_back") isPush;
        #stack[int, 32] mdone = 0;
        txIsMap(recv) rIsMap;                         // maps use map_get/map_size
        txIsBind(recv) rIsBind;                       // bind: flat cells, PAIR count
        if (isSize == 1) {
            #stack[int, 64] szSym = 25;               // cssc_vec_size
            if (rIsMap == 1) { szSym = 30; }          // cssc_map_size
            txCirCallR(szSym, recv, 0 - 1) r;
            if (rIsBind == 1) {                       // a bind reports PAIRS
                txCirConstInt(2) two;
                txCirBinOp(4, r, two) half;           // len / 2
                out = half;
                #delete[half];
                #delete[two];
            }
            if (rIsBind == 0) { out = r; }
            mdone = 1;
            #delete[r];
            #delete[szSym];
        }
        if (mdone == 0) { if (rIsMap == 1) { if (isAt == 1) {
            txLowerExpr(a1) mk;
            txCirCallR(29, recv, mk) r;               // cssc_map_get(m, key)
            txGetElem(recv) mek;
            if (mek == 1) { txSetStr(r); }
            if (mek == 2) { txSetFloat(r); }
            if (mek == 3) { txSetBool(r); }
            #delete[mek];
            out = r; mdone = 1;
            #delete[r];
            #delete[mk];
        } } }
        if (mdone == 0) { if (isAt == 1) {
            txLowerExpr(a1) idx;
            txCirCallR(24, recv, idx) r;              // cssc_vec_at(v, i)
            // the runtime returns a raw i64 -- give it the container's ELEMENT
            // type so a string element prints as text, not as its pointer
            txGetElem(recv) ek;
            if (ek == 1) { txSetStr(r); }
            if (ek == 2) { txSetFloat(r); }
            if (ek == 3) { txSetBool(r); }
            #delete[ek];
            out = r; mdone = 1;
            #delete[r];
            #delete[idx];
        } }
        txSpanIs(mOff, mLen, "set") isSet;
        txSpanIs(mOff, mLen, "pop_front") isPopF;
        txSpanIs(mOff, mLen, "pop_back") isPopB;
        if (mdone == 0) { if (isSet == 1) {           // v.set(i, x) / m.set(k, v)
            #stack[int, 64] a2 = cssc::peek64(txAstNext + a1 * 8);
            txLowerExpr(a1) sidx;
            txLowerExpr(a2) sval;
            #stack[int, 64] setSym = 26;              // cssc_vec_set
            if (rIsMap == 1) { setSym = 28; }         // cssc_map_set
            txCirCall3(setSym, recv, sidx, sval);
            txContainerTake(sval);                    // strong ref to the value
            if (rIsMap == 1) { txContainerTake(sidx); }   // ... and the key
            txCirConstInt(0) z2;
            out = z2; mdone = 1;
            #delete[z2];
            #delete[setSym];
            #delete[sval];
            #delete[sidx];
            #delete[a2];
        } }
        if (mdone == 0) { if (isPopF == 1) {
            txCirCallR(32, recv, 0 - 1) r;            // cssc_vec_pop_front(v)
            txGetElem(recv) pek;
            if (pek == 1) { txSetStr(r); }
            if (pek == 2) { txSetFloat(r); }
            if (pek == 3) { txSetBool(r); }
            #delete[pek];
            out = r; mdone = 1;
            #delete[r];
        } }
        if (mdone == 0) { if (isPopB == 1) {
            txCirCallR(33, recv, 0 - 1) r;            // cssc_vec_pop_back(v)
            txGetElem(recv) pek2;
            if (pek2 == 1) { txSetStr(r); }
            if (pek2 == 2) { txSetFloat(r); }
            if (pek2 == 3) { txSetBool(r); }
            #delete[pek2];
            out = r; mdone = 1;
            #delete[r];
        } }
        #delete[isSet];
        #delete[isPopF];
        #delete[isPopB];
        if (mdone == 0) { if (isPush == 1) {
            txLowerExpr(a1) xv;
            txGetElem(recv) pElem;                    // vector<auto> -> 6
            if (pElem == 6) {                         // record the pushed value's kind
                #stack[int, 64] xt = 0;               // 0 int / 1 string / 2 float / 3 bool
                txIsStr(xv) xas; if (xas == 1) { xt = 1; } #delete[xas];
                txIsFloat(xv) xaf; if (xaf == 1) { xt = 2; } #delete[xaf];
                txIsBool(xv) xab; if (xab == 1) { xt = 3; } #delete[xab];
                txCirConstInt(xt) xtc;
                txCirCall3(48, recv, xv, xtc);        // cssc_vec_push_typed(v, x, kind)
                #delete[xtc];
                #delete[xt];
            }
            if (pElem != 6) { txCirCall(23, recv, xv); } // cssc_vec_push(v, x)
            #delete[pElem];
            txContainerTake(xv);                      // container holds a strong ref
            txCirConstInt(0) z;                       // statement-valued
            out = z; mdone = 1;
            #delete[z];
            #delete[xv];
        } }
        if (mdone == 0) { txCirConstInt(0) z; out = z; #delete[z]; }   // warn-not-reject
        #delete[rIsBind];
        #delete[rIsMap];
        #delete[mdone];
        #delete[isSize];
        #delete[isAt];
        #delete[isPush];
        #delete[a1];
        #delete[recv];
        }                                             // end of `if (posDone == 0)`
        #delete[posDone];
        #delete[mLen];
        #delete[mOff];
    }
    if (kind == 14) {                                 // CALL in expression position
        txLowerCall(node) r;
        if (r < 0) { txCirConstInt(0) z; out = z; #delete[z]; }   // void call -> 0
        if (r >= 0) { out = r; }
        #delete[r];
    }
    #delete[kind];
    return out;
}

// lower one statement node
// push a loop frame; selCur = -1 for a plain for/while.
#stack[int, 64] txLoopPush;
#define(txLoopPush) {
    #scanp(txLoopPush, int, 0) breakL;
    #scanp(txLoopPush, int, 1) contL;
    #scanp(txLoopPush, int, 2) selCur;
    #scanp(txLoopPush, int, 3) selCond;
    #scanp(txLoopPush, int, 4) labOff;
    #scanp(txLoopPush, int, 5) labLen;
    #req[txLoopBreakL] txLoopBreakL;
    #req[txLoopContL] txLoopContL;
    #req[txLoopSelCur] txLoopSelCur;
    #req[txLoopSelCond] txLoopSelCond;
    #req[txLoopLabOff] txLoopLabOff;
    #req[txLoopLabLen] txLoopLabLen;
    #req[txLoopDepth] txLoopDepth;
    cssc::poke64(txLoopBreakL + txLoopDepth * 8, breakL);
    cssc::poke64(txLoopContL + txLoopDepth * 8, contL);
    cssc::poke64(txLoopSelCur + txLoopDepth * 8, selCur);
    cssc::poke64(txLoopSelCond + txLoopDepth * 8, selCond);
    cssc::poke64(txLoopLabOff + txLoopDepth * 8, labOff);
    cssc::poke64(txLoopLabLen + txLoopDepth * 8, labLen);
    txLoopDepth = txLoopDepth + 1;
}
#stack[int, 64] txLoopPop;
#define(txLoopPop) {
    #req[txLoopDepth] txLoopDepth;
    if (txLoopDepth > 0) { txLoopDepth = txLoopDepth - 1; }
}

// resolve `?label.pos()` -> the cursor slot of the matching active select, or -1.
#stack[int, 64] txSelPosLookup;
#define(txSelPosLookup) {
    #scanp(txSelPosLookup, int, 0) off;
    #scanp(txSelPosLookup, int, 1) len;
    #req[txLoopSelCur] txLoopSelCur;
    #req[txLoopLabOff] txLoopLabOff;
    #req[txLoopLabLen] txLoopLabLen;
    #req[txLoopDepth] txLoopDepth;
    #req[txSpanEq] txSpanEq;
    #stack[int, 64] i = txLoopDepth;
    #stack[int, 64] r = 0 - 1;
    #stack[int, 32] go = 1;
    while (go == 1) {
        if (i <= 0) { go = 0; }
        if (go == 1) {
            i = i - 1;
            #stack[int, 64] cur = cssc::peek64(txLoopSelCur + i * 8);
            if (cur >= 0) {
                #stack[int, 64] lo = cssc::peek64(txLoopLabOff + i * 8);
                #stack[int, 64] ll = cssc::peek64(txLoopLabLen + i * 8);
                txSpanEq(off, len, lo, ll) eq;
                if (eq == 1) { r = cur; go = 0; }
                #delete[eq];
                #delete[ll];
                #delete[lo];
            }
            #delete[cur];
        }
    }
    #delete[go];
    #delete[i];
    return r;
}

// does this statement chain (recursively, through blocks/if/loops/select)
// contain a `mirror`? Determines whether the function allocates mirror state.
#stack[int, 64] txHasMirror;
#define(txHasMirror) {
    #scanp(txHasMirror, int, 0) s0;
    #req[txAstKind] txAstKind;
    #req[txAstA] txAstA;
    #req[txAstB] txAstB;
    #req[txAstC] txAstC;
    #req[txAstNext] txAstNext;
    #req[txHasMirror] txHasMirror;
    #stack[int, 64] s = s0;
    #stack[int, 64] r = 0;
    #stack[int, 32] go = 1;
    while (go == 1) {
        if (s == 0) { go = 0; }
        if (go == 1) {
            #stack[int, 64] k = cssc::peek64(txAstKind + s * 8);
            if (k == 32) { r = 1; go = 0; }
            if (k == 12) { txHasMirror(cssc::peek64(txAstA + s * 8)) h; if (h == 1) { r = 1; go = 0; } #delete[h]; }
            if (k == 9) {
                txHasMirror(cssc::peek64(txAstB + s * 8)) h1; if (h1 == 1) { r = 1; go = 0; } #delete[h1];
                txHasMirror(cssc::peek64(txAstC + s * 8)) h2; if (h2 == 1) { r = 1; go = 0; } #delete[h2];
            }
            if (k == 10) { txHasMirror(cssc::peek64(txAstB + s * 8)) h3; if (h3 == 1) { r = 1; go = 0; } #delete[h3]; }
            if (k == 11) { txHasMirror(cssc::peek64(txAstC + s * 8)) h4; if (h4 == 1) { r = 1; go = 0; } #delete[h4]; }
            if (k == 30) { txHasMirror(cssc::peek64(txAstB + s * 8)) h5; if (h5 == 1) { r = 1; go = 0; } #delete[h5]; }
            #delete[k];
            if (go == 1) { s = cssc::peek64(txAstNext + s * 8); }
        }
    }
    #delete[go];
    #delete[s];
    return r;
}

#stack[int, 64] txLowerStmt;
#define(txLowerStmt) {
    #scanp(txLowerStmt, int, 0) node;
    #req[txAstKind] txAstKind;
    #req[txAstA] txAstA;
    #req[txAstB] txAstB;
    #req[txAstC] txAstC;
    #req[txAstNum] txAstNum;
    #req[txAstNext] txAstNext;
    #req[txAstOff] txAstOff;
    #req[txAstLen] txAstLen;
    #req[txSpanIs] txSpanIs;
    #req[txSymFind] txSymFind;
    #req[txSymAdd] txSymAdd;
    #req[txNewSlot] txNewSlot;
    #req[txNewLabel] txNewLabel;
    #req[txLowerExpr] txLowerExpr;
    #req[txLowerStmt] txLowerStmt;
    #req[txLowerCall] txLowerCall;
    #req[txFuncFind] txFuncFind;
    #req[txAliasAdd] txAliasAdd;
    #req[txGlobFind] txGlobFind;
    #req[txGAliasAdd] txGAliasAdd;
    #req[txGAliasFind] txGAliasFind;
    #req[txCirGlobStore] txCirGlobStore;
    #req[txIsStr] txIsStr;
    #req[txSlotSetStr] txSlotSetStr;
    #req[txSlotIsStr] txSlotIsStr;
    #req[txGlobSetStr] txGlobSetStr;
    #req[txIsFloat] txIsFloat;
    #req[txSlotSetFloat] txSlotSetFloat;
    #req[txSlotIsFloat] txSlotIsFloat;
    #req[txCirFloatToInt] txCirFloatToInt;
    #req[txSlotSetBool] txSlotSetBool;
    #req[txSlotSetAuto] txSlotSetAuto;
    #req[txSlotIsAuto] txSlotIsAuto;
    #req[txCirTrap] txCirTrap;
    #req[txGlobSetFloat] txGlobSetFloat;
    #req[txIsVec] txIsVec;
    #req[txSlotSetVec] txSlotSetVec;
    #req[txSlotSetElem] txSlotSetElem;
    #req[txSlotSetMap] txSlotSetMap;
    #req[txSlotSetBind] txSlotSetBind;
    #req[txContainerTake] txContainerTake;
    #req[txIsMap] txIsMap;
    #req[txCirCall3] txCirCall3;
    #req[txGetElem] txGetElem;
    #req[txFuncSetRetStr] txFuncSetRetStr;
    #req[txCurFunc] txCurFunc;
    #req[txIsBool] txIsBool;
    #req[txCirSlotAlloc] txCirSlotAlloc;
    #req[txCirSlotStore] txCirSlotStore;
    #req[txCirUnbind] txCirUnbind;
    #req[txCirGlobUnbind] txCirGlobUnbind;
    #req[txReqGlob] txReqGlob;
    #req[txSpanEq] txSpanEq;
    #req[txGlobIsStr] txGlobIsStr;
    #req[txGlobIsFloat] txGlobIsFloat;
    #req[txCirGlobLoad] txCirGlobLoad;
    #req[txCirCallR] txCirCallR;
    #req[txSetStr] txSetStr;
    #req[txSetOwned] txSetOwned;
    #req[txCirConstInt] txCirConstInt;
    #req[txCirConstStr] txCirConstStr;
    #req[txCirCall] txCirCall;
    #req[txCirRet] txCirRet;
    #req[txCirLabel] txCirLabel;
    #req[txCirBr] txCirBr;
    #req[txCirBrz] txCirBrz;
    #req[txSsaNext] txSsaNext;
    #req[txClearOwned] txClearOwned;
    #req[txIsOwned] txIsOwned;
    #req[txReleaseSlotOld] txReleaseSlotOld;
    #req[txReleaseGlobOld] txReleaseGlobOld;
    #req[txReleaseTemps] txReleaseTemps;
    #req[txReleaseLocals] txReleaseLocals;
    #req[txReqWriteBack] txReqWriteBack;
    #req[txLoopPush] txLoopPush;
    #req[txLoopPop] txLoopPop;
    #req[txSetVec] txSetVec;
    #req[txSetElem] txSetElem;
    #req[txSetFloat] txSetFloat;
    #req[txCirBinOp] txCirBinOp;
    #req[txCirSlotLoad] txCirSlotLoad;
    #req[txFuncArityOf] txFuncArityOf;
    #stack[int, 64] kind = cssc::peek64(txAstKind + node * 8);
    // M5: SSA watermark at statement entry -- everything allocated past this
    // point that is still an OWNED string at the end is a temporary to release.
    #stack[int, 64] stmtSsa0 = txSsaNext;
    if (kind == 7) {                                  // DECL: #stack[T] name = expr
        // A `string` literal wider than its declared bits traps at RUNTIME (the
        // interpreter's "value exceeds bit limit"), emitted here so it fires only
        // when this decl actually runs -- an error-path over-long string never
        // executes and so never blocks a build (that is what lets us self-host).
        #req[txDeclTrap] txDeclTrap;
        #req[txCirTrap] txCirTrap;
        if (cssc::peek64(txDeclTrap + node * 8) == 1) { txCirTrap(); }
        #stack[int, 64] nOff = cssc::peek64(txAstOff + node * 8);
        #stack[int, 64] nLen = cssc::peek64(txAstLen + node * 8);
        #stack[int, 64] init = cssc::peek64(txAstA + node * 8);
        #stack[int, 64] declStr = cssc::peek64(txAstNum + node * 8);   // 1 = `string`
        // OBJECT MEMBER decl (`#stack[T] Obj->m = v;` inside a body): the member
        // global was reserved at collect time; here we only run its initialiser
        // into that global. Singleton model -> members are object-globals.
        #stack[int, 32] memberDone = 0;
        if (cssc::peek64(txAstB + node * 8) == 1) {
            #req[txCurObj] txCurObjD;
            #req[txMemFind] txMemFind;
            #req[txMemBlkOff] txMemBlkOffD;
            #req[txCirStoreInd] txCirStoreIndD;
            if (txCurObjD >= 0) {
                txMemFind(txCurObjD, nOff, nLen) mi;
