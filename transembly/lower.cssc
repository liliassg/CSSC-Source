                            if (pArg2 != 0) { txLowerExpr(pArg2) hi; txCirCallR(pLenSym, pcoll, 0 - 1) ln; txCirConstInt(1) one; txCirBinOp(2, ln, one) lm1; txCirBinOp(10, hi, lm1) r; txSetBool(r); out = r; #delete[r]; #delete[lm1]; #delete[one]; #delete[ln]; #delete[hi]; }
