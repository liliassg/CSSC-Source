                #delete[nsVi];
            }
            if (nsSec < 0) {                              // `alias::member`: built-in / flat module
                #req[txBiModKind] txBiModKind;
                #req[txModFlatHas] txModFlatHas;
                #req[txSpanIs] txSpanIs;
                txBiModKind(pxOff, pxLen) nsBik;
                if (nsBik == 2) {                         // `sizes::<name>` -> compile-time constant
                    #stack[int, 64] szv = 0 - 1;
                    txSpanIs(mbOff, mbLen, "small_int") z01; if (z01 == 1) { szv = 16; } #delete[z01];
                    txSpanIs(mbOff, mbLen, "normal_int") z02; if (z02 == 1) { szv = 32; } #delete[z02];
                    txSpanIs(mbOff, mbLen, "large_int") z03; if (z03 == 1) { szv = 64; } #delete[z03];
                    txSpanIs(mbOff, mbLen, "small_float") z04; if (z04 == 1) { szv = 32; } #delete[z04];
                    txSpanIs(mbOff, mbLen, "normal_float") z05; if (z05 == 1) { szv = 64; } #delete[z05];
                    txSpanIs(mbOff, mbLen, "large_float") z06; if (z06 == 1) { szv = 128; } #delete[z06];
                    txSpanIs(mbOff, mbLen, "small_string") z07; if (z07 == 1) { szv = 128; } #delete[z07];
                    txSpanIs(mbOff, mbLen, "normal_string") z08; if (z08 == 1) { szv = 256; } #delete[z08];
                    txSpanIs(mbOff, mbLen, "large_string") z09; if (z09 == 1) { szv = 1024; } #delete[z09];
                    txSpanIs(mbOff, mbLen, "small_bool") z10; if (z10 == 1) { szv = 8; } #delete[z10];
                    txSpanIs(mbOff, mbLen, "normal_bool") z11; if (z11 == 1) { szv = 8; } #delete[z11];
                    txSpanIs(mbOff, mbLen, "large_bool") z12; if (z12 == 1) { szv = 8; } #delete[z12];
                    txSpanIs(mbOff, mbLen, "small_array") z13; if (z13 == 1) { szv = 256; } #delete[z13];
                    txSpanIs(mbOff, mbLen, "normal_array") z14; if (z14 == 1) { szv = 1024; } #delete[z14];
                    txSpanIs(mbOff, mbLen, "large_array") z15; if (z15 == 1) { szv = 4096; } #delete[z15];
                    txSpanIs(mbOff, mbLen, "small_vector") z16; if (z16 == 1) { szv = 256; } #delete[z16];
                    txSpanIs(mbOff, mbLen, "normal_vector") z17; if (z17 == 1) { szv = 1024; } #delete[z17];
                    txSpanIs(mbOff, mbLen, "large_vector") z18; if (z18 == 1) { szv = 4096; } #delete[z18];
                    txSpanIs(mbOff, mbLen, "small_list") z19; if (z19 == 1) { szv = 256; } #delete[z19];
                    txSpanIs(mbOff, mbLen, "normal_list") z20; if (z20 == 1) { szv = 1024; } #delete[z20];
                    txSpanIs(mbOff, mbLen, "large_list") z21; if (z21 == 1) { szv = 4096; } #delete[z21];
                    txSpanIs(mbOff, mbLen, "small_map") z22; if (z22 == 1) { szv = 512; } #delete[z22];
                    txSpanIs(mbOff, mbLen, "normal_map") z23; if (z23 == 1) { szv = 2048; } #delete[z23];
                    txSpanIs(mbOff, mbLen, "large_map") z24; if (z24 == 1) { szv = 8192; } #delete[z24];
                    txSpanIs(mbOff, mbLen, "small_dict") z25; if (z25 == 1) { szv = 512; } #delete[z25];
                    txSpanIs(mbOff, mbLen, "normal_dict") z26; if (z26 == 1) { szv = 2048; } #delete[z26];
                    txSpanIs(mbOff, mbLen, "large_dict") z27; if (z27 == 1) { szv = 8192; } #delete[z27];
                    txSpanIs(mbOff, mbLen, "small_auto") z28; if (z28 == 1) { szv = 64; } #delete[z28];
                    txSpanIs(mbOff, mbLen, "normal_auto") z29; if (z29 == 1) { szv = 256; } #delete[z29];
                    txSpanIs(mbOff, mbLen, "large_auto") z30; if (z30 == 1) { szv = 1024; } #delete[z30];
                    txSpanIs(mbOff, mbLen, "small_var") z31; if (z31 == 1) { szv = 64; } #delete[z31];
                    txSpanIs(mbOff, mbLen, "normal_var") z32; if (z32 == 1) { szv = 256; } #delete[z32];
                    txSpanIs(mbOff, mbLen, "large_var") z33; if (z33 == 1) { szv = 1024; } #delete[z33];
                    if (szv >= 0) {
                        nsHandled = 1;
                        txCirConstInt(szv) szc;
                        out = szc;
                        #delete[szc];
                    }
                    #delete[szv];
                }
                if (nsBik == 0) {                         // FLAT module: strip the transparent
                    txModFlatHas(pxOff, pxLen) nsFlat;    // alias, resolve `member` via the
                    if (nsFlat == 1) {                    // normal IDENT path below
                        nOff = mbOff;
                        nLen = mbLen;
                    }
                    #delete[nsFlat];
                }
                #delete[nsBik];
            }
            #delete[nsSec];
            #delete[mbLen];
            #delete[mbOff];
            #delete[pxLen];
            #delete[pxOff];
        }
        #delete[nsCp];
        // NOTE: keep nsHandled LIVE across BOTH branches -- deleting it before the
        // `== 0` test would make the deleted name read as 0, so the fall-through
        // IDENT path would ALSO run and clobber `out` (the delete-then-test trap).
        if (nsHandled == 1) {
            #delete[nLen];
            #delete[nOff];
        }
        if (nsHandled == 0) {
        #stack[int, 64] slot = 0;
        txSymFind(nOff, nLen) s;
        slot = s;
        #delete[s];
        if (slot >= 0) {
            txCirSlotLoad(slot) id;
            txSlotIsStr(slot) sIsStr;                 // carry string-ness onto the value
            if (sIsStr == 1) { txSetStr(id); }
            #delete[sIsStr];
            txSlotIsFloat(slot) sIsFlt;               // ... and float-ness
            if (sIsFlt == 1) { txSetFloat(id); }
            #delete[sIsFlt];
            txSlotIsBool(slot) sIsBool;               // ... and bool-ness (true/false)
            if (sIsBool == 1) { txSetBool(id); }
            #delete[sIsBool];
            txSlotIsVec(slot) sIsVec;                 // ... and vector-ness
            if (sIsVec == 1) { txSetVec(id); }
            #delete[sIsVec];
            txSlotGetElem(slot) sElem;                // ... and its element kind
            if (sElem != 0) { txSetElem(id, sElem); }
            #delete[sElem];
            txSlotIsMap(slot) sIsMap;                 // ... and map-ness
            if (sIsMap == 1) { txSetMap(id); }
            #delete[sIsMap];
            txSlotIsBind(slot) sIsBind;               // ... and bind-ness
            if (sIsBind == 1) { txSetBind(id); }
            #delete[sIsBind];
            out = id;
            #delete[id];
        }
