            // leaked global (S9, probe p_sec_globiso).
            #req[txGlobFind] txGlobFind;
            txGAliasFind(nOff, nLen) gi;
            if (gi < 0) { if (txCurSector < 0) { txGlobFind(nOff, nLen) gg; gi = gg; #delete[gg]; } }
            if (gi >= 0) {
                txCirGlobLoad(gi) id;
                txGlobIsStr(gi) gIsStr;
                if (gIsStr == 1) { txSetStr(id); }
                #delete[gIsStr];
                txGlobIsFloat(gi) gIsFlt;
                if (gIsFlt == 1) { txSetFloat(id); }
                #delete[gIsFlt];
                out = id;
                #delete[id];
