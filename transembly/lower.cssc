                            if (pArg2 != 0) { txLowerExpr(pArg2) pidx; txCirConstInt(1) one; txCirBinOp(1, pidx, one) pt; ptgt = pt; #delete[pt]; #delete[one]; #delete[pidx]; }
                        }
