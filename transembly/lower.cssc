                            if (pkFn == 24) {             // sum(v): (vec, elemKind)
                                txCirCallR(89, pcoll, sek) r;
                                if (sekKind == 2) { txSetFloat(r); }
                                out = r; #delete[r];
                            }
                            if (pkFn != 24) {             // contains/count/find_index/find_last_index(v, val)
                                if (pArg2 != 0) {
                                    txLowerExpr(pArg2) sval;
                                    #stack[int, 64] srid = 85;         // find_index
                                    if (pkFn == 20) { srid = 87; }     // contains
                                    if (pkFn == 21) { srid = 88; }     // count
                                    if (pkFn == 23) { srid = 86; }     // find_last_index
                                    txCirCall3R(srid, pcoll, sval, sek) r;
                                    if (pkFn == 20) { txSetBool(r); }  // contains -> true/false
                                    out = r;
                                    #delete[r];
                                    #delete[srid];
                                    #delete[sval];
                                }
                            }
                            #delete[sek];
                            #delete[sekKind];
                        }
                        // ---- min/max (nullable numeric element), find/find_last (nullable
                        //      element), equals_next/equals_prev (bool) ----
                        if (pkFn >= 30) {
                            #req[txCirCall3R] txCirCall3R;
                            txGetElem(pcoll) mek;
                            txCirConstInt(mek) mekS;
                            if (pkFn == 30) {             // min(v) -> numeric element | null
                                txCirCallR(90, pcoll, mekS) mv;
                                #stack[int, 64] mAlive = 0 - 1;
                                if (mek == 1) { txCirConstInt(0) z0; mAlive = z0; #delete[z0]; }
                                if (mek != 1) { txCirCallR(pLenSym, pcoll, 0 - 1) ln; txCirConstInt(0) z0; txCirBinOp(8, ln, z0) gt; mAlive = gt; #delete[gt]; #delete[z0]; #delete[ln]; }
                                if (mek == 2) { txSetFloat(mv); }
                                if (mek == 3) { txSetBool(mv); }
                                txSetAliveSsa(mv, mAlive);
                                out = mv; #delete[mAlive]; #delete[mv];
                            }
                            if (pkFn == 31) {             // max(v) -> numeric element | null
                                txCirCallR(91, pcoll, mekS) mv;
                                #stack[int, 64] mAlive = 0 - 1;
                                if (mek == 1) { txCirConstInt(0) z0; mAlive = z0; #delete[z0]; }
                                if (mek != 1) { txCirCallR(pLenSym, pcoll, 0 - 1) ln; txCirConstInt(0) z0; txCirBinOp(8, ln, z0) gt; mAlive = gt; #delete[gt]; #delete[z0]; #delete[ln]; }
                                if (mek == 2) { txSetFloat(mv); }
                                if (mek == 3) { txSetBool(mv); }
                                txSetAliveSsa(mv, mAlive);
                                out = mv; #delete[mAlive]; #delete[mv];
                            }
                            if (pkFn == 32) {             // find(v, val) -> matched element | null
                                if (pArg2 != 0) {
                                    txLowerExpr(pArg2) fv;
                                    txCirCall3R(85, pcoll, fv, mekS) fidx;   // find_index
                                    txCirConstInt(0) z; txCirBinOp(9, fidx, z) fAlive;  // idx >= 0
                                    if (mek == 1) { txSetStr(fv); } if (mek == 2) { txSetFloat(fv); } if (mek == 3) { txSetBool(fv); }
                                    txSetAliveSsa(fv, fAlive);
                                    out = fv; #delete[fAlive]; #delete[z]; #delete[fidx]; #delete[fv];
                                }
                            }
                            if (pkFn == 33) {             // find_last(v, val) -> matched element | null
                                if (pArg2 != 0) {
                                    txLowerExpr(pArg2) fv;
                                    txCirCall3R(86, pcoll, fv, mekS) fidx;   // find_last_index
                                    txCirConstInt(0) z; txCirBinOp(9, fidx, z) fAlive;
                                    if (mek == 1) { txSetStr(fv); } if (mek == 2) { txSetFloat(fv); } if (mek == 3) { txSetBool(fv); }
                                    txSetAliveSsa(fv, fAlive);
                                    out = fv; #delete[fAlive]; #delete[z]; #delete[fidx]; #delete[fv];
                                }
                            }
                            if (pkFn == 34) {             // equals_next(i) -> bool
                                if (pArg2 != 0) { txLowerExpr(pArg2) ei; txCirCall3R(92, pcoll, ei, mekS) r; txSetBool(r); out = r; #delete[r]; #delete[ei]; }
                            }
                            if (pkFn == 35) {             // equals_prev(i) -> bool
                                if (pArg2 != 0) { txLowerExpr(pArg2) ei; txCirCall3R(93, pcoll, ei, mekS) r; txSetBool(r); out = r; #delete[r]; #delete[ei]; }
                            }
                            #delete[mekS];
                            #delete[mek];
                        }
                        // ---- array-returning family: return a NEW vector (tagged vec + elem) ----
                        if (pkFn >= 40) {
                            #req[txSetVec] txSetVec;
                            #req[txSetElem] txSetElem;
                            #req[txCirCall3R] txCirCall3R;
                            txGetElem(pcoll) aelem;
                            #stack[int, 64] arr = 0 - 1;
                            // 2-arg (vec, n): take/take_last/skip/skip_last/every_nth
                            if (pkFn == 46) { if (pArg2 != 0) { txLowerExpr(pArg2) n; txCirConstInt(0) z; txCirCall3R(94, pcoll, z, n) rr; arr = rr; #delete[rr]; #delete[z]; #delete[n]; } }
                            if (pkFn == 47) { if (pArg2 != 0) { txLowerExpr(pArg2) n; txCirCallR(97, pcoll, n) rr; arr = rr; #delete[rr]; #delete[n]; } }
                            if (pkFn == 48) { if (pArg2 != 0) { txLowerExpr(pArg2) n; txCirConstInt(2000000000) big; txCirCall3R(94, pcoll, n, big) rr; arr = rr; #delete[rr]; #delete[big]; #delete[n]; } }
                            if (pkFn == 49) { if (pArg2 != 0) { txLowerExpr(pArg2) n; txCirCallR(98, pcoll, n) rr; arr = rr; #delete[rr]; #delete[n]; } }
                            if (pkFn == 50) { if (pArg2 != 0) { txLowerExpr(pArg2) n; txCirCallR(95, pcoll, n) rr; arr = rr; #delete[rr]; #delete[n]; } }
                            // peek_ahead(i, count): slice(i+1, i+1+count)
                            if (pkFn == 44) {
                                if (pArg2 != 0) {
                                    #stack[int, 64] pA3 = cssc::peek64(txAstNext + pArg2 * 8);
                                    if (pA3 != 0) {
                                        txLowerExpr(pArg2) ii; txLowerExpr(pA3) cc;
                                        txCirConstInt(1) one; txCirBinOp(1, ii, one) ip1; txCirBinOp(1, ip1, cc) iend;
                                        txCirCall3R(94, pcoll, ip1, iend) rr; arr = rr;
                                        #delete[rr]; #delete[iend]; #delete[ip1]; #delete[one]; #delete[cc]; #delete[ii];
                                    }
                                    #delete[pA3];
                                }
                            }
                            // 3-arg (vec, a, b): cpeek/peek_range/peek_window/peek_around/peek_behind
                            #stack[int, 32] is3 = 0;
                            #stack[int, 64] arid = 94;
                            if (pkFn == 40) { is3 = 1; arid = 102; }
                            if (pkFn == 41) { is3 = 1; arid = 94; }
                            if (pkFn == 42) { is3 = 1; arid = 99; }
                            if (pkFn == 43) { is3 = 1; arid = 100; }
                            if (pkFn == 45) { is3 = 1; arid = 101; }
                            if (is3 == 1) {
                                if (pArg2 != 0) {
                                    #stack[int, 64] pA3b = cssc::peek64(txAstNext + pArg2 * 8);
                                    if (pA3b != 0) {
                                        txLowerExpr(pArg2) aa; txLowerExpr(pA3b) bb;
                                        txCirCall3R(arid, pcoll, aa, bb) rr; arr = rr;
                                        #delete[rr]; #delete[bb]; #delete[aa];
                                    }
                                    #delete[pA3b];
                                }
                            }
                            #delete[arid];
                            #delete[is3];
                            if (arr >= 0) {
                                txSetVec(arr);
                                txSetElem(arr, aelem);
                                out = arr;
                            }
                            #delete[arr];
                            #delete[aelem];
                        }
                        #delete[ptgt];
                        #delete[pLenSym];
                        #delete[pIsM];
                        #delete[pIsV];
                        #delete[pArg2];
                        #delete[pcoll];
                    }
                }
                #delete[pkFn];
                #delete[kmLen];
                #delete[kmOff];
            }
            #delete[isMathA];
        }
        #delete[mcp];
    }

    if (handled == 0) {                                    // resolve a sector target
        txNsColon(calleeOff, calleeLen) ccp;
        if (ccp >= 0) {                                    // `prefix::member(...)`
            #stack[int, 64] cmbOff = calleeOff + ccp + 2;
            #stack[int, 64] cmbLen = calleeLen - ccp - 2;
            txSecFind(calleeOff, ccp) cSec;
            if (cSec >= 0) {
                txSFnFind(cSec, cmbOff, cmbLen) cFn;
                if (cFn >= 0) { secFnIdx = cFn; }
                if (cFn < 0) {                             // `Sector::Obj()` instantiation
                    #req[txObjFind] txObjFind;
                    txObjFind(cmbOff, cmbLen) cObj;
                    if (cObj >= 0) { secObjId = cObj; }
                    #delete[cObj];
                }
                #delete[cFn];
            }
            if (cSec < 0) {                                // `alias::member` on a FLAT module:
                #req[txModFlatHas] txModFlatHas;          // strip the transparent alias and
                txModFlatHas(calleeOff, ccp) isFlat;      // resolve `member` as a top-level fn
                if (isFlat == 1) {
                    txFuncFind(cmbOff, cmbLen) mFn;
                    if (mFn >= 0) { secFnIdx = mFn; }
                    #delete[mFn];
                }
                #delete[isFlat];
            }
            #delete[cSec];
            #delete[cmbLen];
            #delete[cmbOff];
        }
        // A BARE sibling call is auto-visible ONLY inside an OBJECT body: the
        // `object O<fn>` genparam injection lets a label call the sector sibling
        // `fn(...)` by bare name (txCurObj >= 0). Inside a #define BODY it is NOT
        // visible -- CSSC isolation requires `#req[sibling]` (a #req'd one
        // resolves via txAliasFind below); an un-imported bare sibling there
        // stays unbound, matching the reference rejecting the call.
        if (ccp < 0) {
            #req[txCurObj] txCurObj;
            if (txCurObj >= 0) {
                if (txCurSector >= 0) {
                    txSFnFind(txCurSector, calleeOff, calleeLen) sib;
                    if (sib >= 0) { secFnIdx = sib; }
                    #delete[sib];
                }
            }
            // Not an object body. Two sub-cases keyed off txCurSecCtor:
            //  == 1 (a sector's OWN construction/free scope): members are bare-
            //       visible, so a bare call to a member fn RESOLVES (S11 edge:
            //       `#define(f)` in the body, `f()` alongside it).
            //  == 0 (a #define member BODY): CSSC isolation requires `#req[sibling]`;
            //       an un-imported bare sibling is a violation -> main emits no
            //       container (matching the reference's reject).
            if (txCurObj < 0) {
                if (txCurSector >= 0) {
                    txSFnFind(txCurSector, calleeOff, calleeLen) sib2;
                    if (sib2 >= 0) {
                        #req[txCurSecCtor] txCurSecCtor;
                        if (txCurSecCtor == 1) { secFnIdx = sib2; }
                        if (txCurSecCtor == 0) {
                            txAliasFind(calleeOff, calleeLen) af2;
                            if (af2 < 0) { #req[txIsoBad] txIsoBad; txIsoBad = 1; }
                            #delete[af2];
                        }
                    }
                    #delete[sib2];
                }
            }
        }
        #delete[ccp];
    }

    if (handled == 0) {                                    // object instantiation `Type()`?
        #req[txObjFind] txObjFind;
        #req[txObjInitFn] txObjInitFn;
        #stack[int, 64] oid = secObjId;
        if (oid < 0) { txObjFind(calleeOff, calleeLen) o2; oid = o2; #delete[o2]; }
        if (oid >= 0) {
            // Route the ctor through the user-call path below (secFnIdx = its fn
            // index) so a typed ctor param (`object Box <int: start>`) receives
            // the call argument. A no-arg ctor marshals 0 args -- same as before.
            secFnIdx = cssc::peek64(txObjInitFn + oid * 8);
        }
        #delete[oid];
    }
    if (handled == 0) {                                    // user function?
        #stack[int, 64] fnIdx = secFnIdx;                  // sector member fn wins
        if (fnIdx < 0) { txFuncFind(calleeOff, calleeLen) ff; fnIdx = ff; #delete[ff]; }
        if (fnIdx < 0) { txAliasFind(calleeOff, calleeLen) af; fnIdx = af; #delete[af]; }
        if (fnIdx >= 0) {
            handled = 1;
            // Count the args and RESERVE our slice of the side-table FIRST. An arg
            // may itself be a call, which reserves+fills its own slice while we are
            // lowering ours -- reserving up front keeps our indices exclusive.
            #stack[int, 64] argCount = 0;
            #stack[int, 64] c = firstArg;
            #stack[int, 32] cgo = 1;
            while (cgo == 1) {
                if (c == 0) { cgo = 0; }
                if (cgo == 1) { argCount = argCount + 1; c = cssc::peek64(txAstNext + c * 8); }
            }
            #delete[cgo];
            #delete[c];
            // "this" injection: a ctor / label / free call prepends the instance
            // BLOCK pointer as arg0 (txCallThis). Captured + cleared NOW so the
            // args lowered below (which may be nested method calls) rebind it.
            #req[txCallThis] txCallThis;
            #stack[int, 64] thisSsa = txCallThis;
            txCallThis = 0 - 1;
            #stack[int, 64] thisOff = 0;
            if (thisSsa >= 0) { thisOff = 1; }
            #stack[int, 64] argStart = txCallArgCount;
            txCallArgCount = txCallArgCount + argCount + thisOff;
            if (thisOff == 1) { cssc::poke64(txCallArg + argStart * 8, thisSsa); }
            // lower each arg left-to-right, writing straight into the reserved slot
            #stack[int, 64] a = firstArg;
            #stack[int, 64] ai = 0;
            #stack[int, 32] go = 1;
            while (go == 1) {
                if (a == 0) { go = 0; }
                if (go == 1) {
                    // "caller wins" (docs/cssc-ownership.md section 3): when the
                    // callee assigns or deletes this parameter, the change must
                    // reach the CALLER's variable -- so we hand over the address
                    // of the caller's own cell instead of a copy of its value.
                    // Anything that is not a bare name (literal, expression,
                    // `&x`) has no source variable to write back to, so it is
                    // materialised into a throwaway cell: the callee's write-back
                    // lands there and is discarded, which is exactly what the
                    // reference does when there is no `src_name`.
                    txParamByRef(fnIdx, ai + thisOff) byRef;
                    #stack[int, 64] sid = 0 - 1;
                    if (byRef == 1) {
                        #stack[int, 64] aKind = cssc::peek64(txAstKind + a * 8);
                        #stack[int, 64] bound = 0;
                        if (aKind == 5) {                 // IDENT -> a real lvalue
                            #stack[int, 64] aOff = cssc::peek64(txAstOff + a * 8);
                            #stack[int, 64] aLen = cssc::peek64(txAstLen + a * 8);
                            txSymFind(aOff, aLen) aSlot;
                            if (aSlot >= 0) {
                                txCirSlotAddr(aSlot) ad;
                                sid = ad;
                                bound = 1;
                                #delete[ad];
                            }
                            if (aSlot < 0) {
                                txGAliasFind(aOff, aLen) aGi;
                                if (aGi >= 0) {
                                    txCirGlobAddr(aGi) gad;
                                    sid = gad;
                                    bound = 1;
                                    #delete[gad];
                                }
                                #delete[aGi];
                            }
                            #delete[aSlot];
                            #delete[aLen];
                            #delete[aOff];
                        }
                        if (bound == 0) {                 // materialise a temp cell
                            txLowerExpr(a) tv;
                            txNewSlot() ts;
                            txCirSlotAlloc(ts);
                            txCirSlotStore(ts, tv);
                            txCirSlotAddr(ts) tad;
                            sid = tad;
                            #delete[tad];
                            #delete[ts];
                            #delete[tv];
                        }
                        #delete[bound];
                        #delete[aKind];
                    }
                    if (byRef == 0) { txLowerExpr(a) v0; sid = v0; #delete[v0]; }
                    #delete[byRef];
                    cssc::poke64(txCallArg + (argStart + thisOff + ai) * 8, sid);
                    ai = ai + 1;
                    #delete[sid];
                    a = cssc::peek64(txAstNext + a * 8);
                }
            }
            #delete[go];
            txNewSsa() res;
            txCirCallUser(fnIdx, argStart, argCount + thisOff, res);
            txFuncIsRetStr(fnIdx) retIsStr;               // string-returning callee
            if (retIsStr == 1) { txSetStr(res); txSetOwned(res); }   // callee hands over its ref
            #delete[retIsStr];
            txFuncIsRetFloat(fnIdx) retIsFlt;             // float / bool return typing
            if (retIsFlt == 1) { txSetFloat(res); }
            #delete[retIsFlt];
            txFuncIsRetBool(fnIdx) retIsBool;
            if (retIsBool == 1) { txSetBool(res); }
            #delete[retIsBool];
            out = res;
            #delete[res];
            #delete[ai];
            #delete[a];
            #delete[argCount];
            #delete[argStart];
            #delete[thisOff];
            #delete[thisSsa];
        }
        #delete[fnIdx];
    }

    if (handled == 0) {                                    // unknown -> typed zero
        txCirConstInt(0) z;
        out = z;
        #delete[z];
    }
    #delete[secObjId];
    #delete[secFnIdx];
    #delete[handled];
    #delete[firstArg];
    #delete[calleeLen];
    #delete[calleeOff];
    return out;
}

// lower an expression node -> its CIR SSA value id
#stack[int, 64] txLowerExpr;
#define(txLowerExpr) {
    #scanp(txLowerExpr, int, 0) node;
    #req[txAstKind] txAstKind;
    #req[txAstNum] txAstNum;
    #req[txAstOff] txAstOff;
    #req[txAstLen] txAstLen;
    #req[txAstA] txAstA;
    #req[txAstB] txAstB;
    #req[txAstC] txAstC;
    #req[txSymFind] txSymFind;
    #req[txGAliasFind] txGAliasFind;
    #req[txCirConstInt] txCirConstInt;
    #req[txCirConstStr] txCirConstStr;
    #req[txCirSlotLoad] txCirSlotLoad;
    #req[txCirGlobLoad] txCirGlobLoad;
    #req[txCirCallR] txCirCallR;
    #req[txSetStr] txSetStr;
    #req[txSetBool] txSetBool;
    #req[txSetOwned] txSetOwned;
    #req[txIsStr] txIsStr;
    #req[txSlotIsStr] txSlotIsStr;
    #req[txGlobIsStr] txGlobIsStr;
    #req[txSetFloat] txSetFloat;
    #req[txIsFloat] txIsFloat;
    #req[txIsBool] txIsBool;
    #req[txSlotIsFloat] txSlotIsFloat;
    #req[txSlotIsBool] txSlotIsBool;
    #req[txSetBool] txSetBool;
    #req[txGlobIsFloat] txGlobIsFloat;
    #req[txCirFBinOp] txCirFBinOp;
    #req[txCirIntToFloat] txCirIntToFloat;
    #req[txSetVec] txSetVec;
    #req[txIsVec] txIsVec;
    #req[txSlotIsVec] txSlotIsVec;
    #req[txSelPosLookup] txSelPosLookup;
    #req[txSetElem] txSetElem;
    #req[txGetElem] txGetElem;
    #req[txSlotGetElem] txSlotGetElem;
    #req[txContainerTake] txContainerTake;
    #req[txSetMap] txSetMap;
    #req[txIsMap] txIsMap;
    #req[txSlotIsMap] txSlotIsMap;
    #req[txSetBind] txSetBind;
    #req[txIsBind] txIsBind;
    #req[txSlotIsBind] txSlotIsBind;
    #req[txCirCall3] txCirCall3;
    #req[txClearOwned] txClearOwned;
    #req[txCirCall] txCirCall;
    #req[txSpanIs] txSpanIs;
    #req[txAstNext] txAstNext;
    #req[txCirBinOp] txCirBinOp;
    #req[txLowerExpr] txLowerExpr;
    #req[txLowerCall] txLowerCall;
    #req[txNsColon] txNsColon;
    #req[txSecFind] txSecFind;
    #req[txSVarFind] txSVarFind;
    #req[txSVarGlob] txSVarGlob;
    #req[txSVarKind] txSVarKind;
    #req[txSVarElem] txSVarElem;
    #req[txSVarPub] txSVarPub;
    #req[txCurSector] txCurSector;
    #stack[int, 64] kind = cssc::peek64(txAstKind + node * 8);
    #stack[int, 64] out = 0;
    if (kind == 3) {                                  // NUMBER (int, or f64 literal)
        txCirConstInt(cssc::peek64(txAstNum + node * 8)) id;
        // the lexer already stored a float literal as its f64 BIT PATTERN in Num
        // and set the flag in B -- the constant is emitted identically, only its
        // type differs. C = 1 marks a `true`/`false` bool literal.
        if (cssc::peek64(txAstB + node * 8) == 1) { txSetFloat(id); }
        if (cssc::peek64(txAstC + node * 8) == 1) { txSetBool(id); }
        out = id;
        #delete[id];
    }
    if (kind == 38) {                                 // ARROW: obj->member (read)
        #req[txArrowObj] txArrowObj;
        #req[txMemBlock] txMemBlock;
        #req[txMemFind] txMemFind;
        #req[txMemBlkOff] txMemBlkOff;
        #req[txMemKind] txMemKind;
        #req[txMemElem] txMemElem;
        #req[txSetMap] txSetMap;
        #req[txCirLoadInd] txCirLoadInd;
        txArrowObj(cssc::peek64(txAstA + node * 8)) aObj;
        #stack[int, 32] aDone = 0;
        if (aObj >= 0) {
            txMemFind(aObj, cssc::peek64(txAstOff + node * 8), cssc::peek64(txAstLen + node * 8)) mi;
            if (mi >= 0) {
                #stack[int, 64] boff = cssc::peek64(txMemBlkOff + mi * 8);
                #stack[int, 64] mk = cssc::peek64(txMemKind + mi * 8);
                #stack[int, 64] mel = cssc::peek64(txMemElem + mi * 8);
                // read the member out of THIS instance's block: *(block + offset)
                txMemBlock(cssc::peek64(txAstA + node * 8)) blk;
                txCirConstInt(boff) boc;
                txCirBinOp(1, blk, boc) addr;
                txCirLoadInd(addr) mv;
                if (mk == 1) { txSetStr(mv); }
                if (mk == 2) { txSetFloat(mv); }
                if (mk == 3) { txSetVec(mv); if (mel != 0) { txSetElem(mv, mel); } }
                if (mk == 4) { txSetMap(mv); if (mel != 0) { txSetElem(mv, mel); } }
                if (mk == 5) { txSetVec(mv); if (mel != 0) { txSetElem(mv, mel); } }
                out = mv;
                aDone = 1;
                #delete[mv];
                #delete[addr];
                #delete[boc];
                #delete[blk];
                #delete[mel];
                #delete[mk];
                #delete[boff];
            }
            #delete[mi];
        }
        if (aDone == 0) { txCirConstInt(0) az; out = az; #delete[az]; }
        #delete[aDone];
        #delete[aObj];
    }
    if (kind == 4) {                                  // STRING literal -> heap string
        // In a VALUE context a literal must become a real refcounted heap string
        // (cssc_string_lit copies the static bytes), so it can be stored, passed,
        // concatenated and released like any other string. The `outln("lit")`
        // fast path never comes through here -- it prints the static bytes directly.
        #stack[int, 64] soff = cssc::peek64(txAstOff + node * 8);
        #stack[int, 64] slen = cssc::peek64(txAstLen + node * 8);
        txCirConstStr(soff, slen) p;                  // static byte pointer
        txCirConstInt(slen) l;
        txCirCallR(3, p, l) h;                        // cssc_string_lit(ptr, len)
        txSetStr(h);
        txSetOwned(h);                                // fresh refcount-1 value
        out = h;
        #delete[h];
        #delete[l];
        #delete[p];
        #delete[slen];
        #delete[soff];
    }
    if (kind == 5) {                                  // IDENT (variable read)
        #stack[int, 64] nOff = cssc::peek64(txAstOff + node * 8);
        #stack[int, 64] nLen = cssc::peek64(txAstLen + node * 8);
        // `Sector::var` / `alias::var` -- namespace-qualified member read (S1/S14).
        #stack[int, 32] nsHandled = 0;
        txNsColon(nOff, nLen) nsCp;
        if (nsCp >= 0) {
            #stack[int, 64] pxOff = nOff;
            #stack[int, 64] pxLen = nsCp;
            #stack[int, 64] mbOff = nOff + nsCp + 2;
            #stack[int, 64] mbLen = nLen - nsCp - 2;
            txSecFind(pxOff, pxLen) nsSec;
            if (nsSec >= 0) {
                nsHandled = 1;
                txSVarFind(nsSec, mbOff, mbLen) nsVi;
                // a PRIVATE member read from outside the sector is hidden (S13):
                // it reads 0x0, so drop it to an unbound-equivalent zero here.
                #stack[int, 32] nsHide = 0;
                if (nsVi >= 0) {
                    if (cssc::peek64(txSVarPub + nsVi * 8) == 0) {
                        if (txCurSector != nsSec) { nsHide = 1; }
                    }
                }
                if (nsHide == 1) { nsVi = 0 - 1; }
                #delete[nsHide];
                if (nsVi >= 0) {
                    #stack[int, 64] gidx = cssc::peek64(txSVarGlob + nsVi * 8);
                    #stack[int, 64] mk = cssc::peek64(txSVarKind + nsVi * 8);
                    #stack[int, 64] mel = cssc::peek64(txSVarElem + nsVi * 8);
                    txCirGlobLoad(gidx) mv;
                    if (mk == 1) { txSetStr(mv); }
                    if (mk == 2) { txSetFloat(mv); }
                    if (mk == 3) { txSetVec(mv); if (mel != 0) { txSetElem(mv, mel); } }
                    if (mk == 4) { txSetMap(mv); if (mel != 0) { txSetElem(mv, mel); } }
                    if (mk == 5) { txSetVec(mv); if (mel != 0) { txSetElem(mv, mel); } }
                    out = mv;
                    #delete[mv];
                    #delete[mel];
                    #delete[mk];
                    #delete[gidx];
                }
