        // (cvtsi2sd) so `1.5 * 2` works, then use the SSE form.
        #stack[int, 32] isFlt = 0;
        if (anyStr == 0) {
            txIsFloat(lhs) lf;
            txIsFloat(rhs) rf;
            if (lf == 1) { isFlt = 1; }
            if (rf == 1) { isFlt = 1; }
            // `/` is ALWAYS float division in CSSC: `6/4` is 1.5, not 1. The int
            // result only reappears when the value lands in an int-declared slot,
            // which truncates it (DECL/ASSIGN below). `%` (opc 5) stays integer.
            if (opc == 4) { isFlt = 1; }
            if (isFlt == 1) {
                if (opc <= 11) {                      // arithmetic + comparisons
                    if (lf == 0) { txCirIntToFloat(lhs) lp; lhs = lp; #delete[lp]; }
                    if (rf == 0) { txCirIntToFloat(rhs) rp; rhs = rp; #delete[rp]; }
                } else {
                    isFlt = 0;                        // && / || stay integer truthiness
                }
            }
            #delete[lf];
            #delete[rf];
        }
        if (isFlt == 1) {
            txCirFBinOp(opc, lhs, rhs) id;
            out = id;
            #delete[id];
        }
        if (isSEq == 1) {
            txCirCallR(19, lhs, rhs) eqv;             // cssc_string_eq(a, b) -> 0/1
            #stack[int, 64] rv = eqv;
            if (opc == 11) {                          // `!=` -> (eq == 0)
                txCirConstInt(0) z;
                txCirBinOp(10, eqv, z) neg;
                rv = neg;
                #delete[neg];
                #delete[z];
            }
            txSetBool(rv);                            // prints true/false
            out = rv;
            #delete[rv];
            #delete[eqv];
        }
        if (isCat == 1) {
            // A non-string operand (`"hey: " + x`, x an int/float/bool) must be
            // RENDERED to a string first -- passing the raw value to string_concat
            // as a pointer crashes. cssc_auto_to_str(val, kind) does int/float(bits)/
            // bool -> string; a string operand passes straight through.
            #stack[int, 64] lstr = lhs;
            txIsStr(lhs) lsc;
            if (lsc == 0) {
                #stack[int, 64] lt = 0;
                txIsFloat(lhs) lf2; if (lf2 == 1) { lt = 2; } #delete[lf2];
                txIsBool(lhs) lb2; if (lb2 == 1) { lt = 3; } #delete[lb2];
                txCirConstInt(lt) ltc; txCirCallR(50, lhs, ltc) lc; lstr = lc;
                #delete[lc]; #delete[ltc]; #delete[lt];
            }
            #delete[lsc];
            #stack[int, 64] rstr = rhs;
            txIsStr(rhs) rsc;
            if (rsc == 0) {
                #stack[int, 64] rt = 0;
                txIsFloat(rhs) rf2; if (rf2 == 1) { rt = 2; } #delete[rf2];
                txIsBool(rhs) rb2; if (rb2 == 1) { rt = 3; } #delete[rb2];
                txCirConstInt(rt) rtc; txCirCallR(50, rhs, rtc) rc; rstr = rc;
                #delete[rc]; #delete[rtc]; #delete[rt];
            }
            #delete[rsc];
            txCirCallR(4, lstr, rstr) id;             // cssc_string_concat(a, b)
            txSetStr(id);
            txSetOwned(id);                           // fresh refcount-1 value
            out = id;
            #delete[id];
            #delete[rstr];
            #delete[lstr];
        }
