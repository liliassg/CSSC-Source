                            if (pArg2 != 0) { txLowerExpr(pArg2) hi; txCirConstInt(1) one; txCirConstInt(0) z; txCirBinOp(2, hi, one) im1; txCirBinOp(9, im1, z) r; txSetBool(r); out = r; #delete[r]; #delete[im1]; #delete[z]; #delete[one]; #delete[hi]; }
