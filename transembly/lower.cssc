            // only the alive cell). cssc_release(0) is a guarded no-op.
            txCirConstInt(0) labz; txCirSlotStore(labS, labz); #delete[labz];
            txNewLabel() condS; txNewLabel() endS;
            txCirLabel(condS);
            // 0 <= cursor  (else end)
            txCirSlotLoad(curS) sc1; txCirConstInt(0) sz0;
            txCirBinOp(9, sc1, sz0) snn; txCirBrz(snn, endS);
            // cursor < string_size  (else end)
            txCirSlotLoad(strSlot) ssv; txCirCallR(41, ssv, 0 - 1) slen;   // cssc_string_size
            txCirSlotLoad(curS) sc2; txCirBinOp(6, sc2, slen) sInR;
            txCirBrz(sInR, endS);
            // release the previous char, extract the new one (fresh owned string)
            txReleaseSlotOld(labS);
            txCirSlotLoad(strSlot) ssv2; txCirSlotLoad(curS) sc3;
            txCirCallR(40, ssv2, sc3) ch;                 // cssc_string_char_at(s, i)
            txSetStr(ch);
            txCirSlotStore(labS, ch);                     // owned 1-char string
            txSlotSetStr(labS, 1);
            // run body; a `jump;` advances the cursor and re-enters condS.
            txLoopPush(endS, 0, curS, condS, labOff, labLen);
            txLowerStmt(body);
            txLoopPop();
            txCirBr(endS);                                // no jump -> stop
            txCirLabel(endS);
            txReleaseSlotOld(labS);                       // free the last char
            txSlotSetStr(labS, 0);
            txCirSlotLoad(strSlot) ssv3;                  // release the retained source
            txCirCall(16, ssv3, 0 - 1);                   // cssc_release(source)
            txSlotSetStr(strSlot, 0);
            #delete[ssv3];
            #delete[ch];
            #delete[sc3];
            #delete[ssv2];
            #delete[sInR];
            #delete[sc2];
            #delete[slen];
            #delete[ssv];
            #delete[snn];
            #delete[sz0];
            #delete[sc1];
            #delete[endS];
            #delete[condS];
            #delete[labS];
            #delete[zc0];
            #delete[curS];
            #delete[strSlot];
        }
        if (isStrSel == 0) {
        txGetElem(iv) ek;
        #stack[int, 64] esFlag = 0;
        if (ek == 1) { esFlag = 1; }
        // SNAPSHOT the container (interpreter does `list(iterable)`, so pushes to
        // the source during the loop are NOT seen -- probe p_s_select_mutate).
        txCirConstInt(esFlag) ekc;
        txCirCallR(36, iv, ekc) snap;                 // cssc_vec_copy(v, elemIsStr)
        txSetVec(snap);
        if (ek != 0) { txSetElem(snap, ek); }
        txNewSlot() snapSlot;
        txCirSlotAlloc(snapSlot);
        txSlotSetVec(snapSlot, 1);
        if (ek != 0) { txSlotSetElem(snapSlot, ek); }
        txCirSlotStore(snapSlot, snap);
        // cursor slot
        txNewSlot() curSlot;
        txCirSlotAlloc(curSlot);
        txCirConstInt(0) zc;
        txCirSlotStore(curSlot, zc);
        // ?label slot, typed to the element kind
        txNewSlot() labSlot;
        txCirSlotAlloc(labSlot);
        txSymAdd(labOff, labLen, labSlot);
        if (ek == 1) { txSlotSetStr(labSlot, 1); }
        if (ek == 2) { txSlotSetFloat(labSlot, 1); }
        if (ek == 3) { txSlotSetBool(labSlot, 1); }
        txNewLabel() condL;
        txNewLabel() endL;
        txCirLabel(condL);
        // 0 <= cursor  (else end)
        txCirSlotLoad(curSlot) c1;
        txCirConstInt(0) z1;
        txCirBinOp(9, c1, z1) nonneg;                 // opc 9 = '>=' -> cursor >= 0
        txCirBrz(nonneg, endL);
        // cursor < size(snap)   (else end)
        txCirSlotLoad(snapSlot) sv2;
        txCirCallR(25, sv2, 0 - 1) sz;                // cssc_vec_size
        txCirSlotLoad(curSlot) c2;
        txCirBinOp(6, c2, sz) inRange;                // opc 6 = '<'
        txCirBrz(inRange, endL);
        // ?label = snap.at(cursor)
        txCirSlotLoad(snapSlot) sv3;
        txCirSlotLoad(curSlot) c3;
        txCirCallR(24, sv3, c3) elem;                 // cssc_vec_at
        if (ek == 1) { txSetStr(elem); }
        if (ek == 2) { txSetFloat(elem); }
        if (ek == 3) { txSetBool(elem); }
        txCirSlotStore(labSlot, elem);
        // run body under a select frame; fallthrough (no jump) terminates.
        txLoopPush(endL, 0, curSlot, condL, labOff, labLen);
        txLowerStmt(body);
        txLoopPop();
        txCirBr(endL);                                // no explicit jump -> stop
        txCirLabel(endL);
        // release the snapshot (frees copied string elements too).
        txCirSlotLoad(snapSlot) sv4;
        txCirConstInt(esFlag) ekc2;
        txCirCall(34, sv4, ekc2);                     // cssc_vec_free(snap, elemIsStr)
        txSlotSetVec(snapSlot, 0);
        #delete[ekc2];
        #delete[sv4];
        #delete[elem];
        #delete[c3];
        #delete[sv3];
        #delete[inRange];
        #delete[c2];
        #delete[sz];
        #delete[sv2];
        #delete[nonneg];
        #delete[z1];
        #delete[c1];
        #delete[endL];
        #delete[condL];
        #delete[labSlot];
        #delete[zc];
        #delete[curSlot];
        #delete[snapSlot];
        #delete[snap];
        #delete[ekc];
        #delete[esFlag];
        #delete[ek];
        }                                             // end of `if (isStrSel == 0)`
        #delete[isStrSel];
        #delete[iv];
        #delete[body];
        #delete[iter];
        #delete[labLen];
        #delete[labOff];
    }
    // Leaf statements own their intermediates: release whatever string temp was
    // created while lowering this statement and not taken over by a slot/global.
    // Composite statements (BLOCK/IF/WHILE/FOR) delegate to their children, and
    // RETURN already did its own cleanup before emitting the RET.
    #stack[int, 32] isLeaf = 0;
    if (kind == 7) { isLeaf = 1; }                    // DECL
    if (kind == 8) { isLeaf = 1; }                    // ASSIGN
    if (kind == 15) { isLeaf = 1; }                   // RESULT_CAPTURE
    if (kind == 16) { isLeaf = 1; }                   // EXPR_STMT
    if (isLeaf == 1) { txReleaseTemps(stmtSsa0); }
    #delete[isLeaf];
    #delete[stmtSsa0];
    #delete[kind];
}

// ---- M4b: promote `#req`-ed module globals ----
// Walk a statement chain (recursing into nested blocks) and register every
// `#req[name]` whose bracket name is NOT a function as a module global. Mirrors
// the reference's `_prescan_top_level_reqs` -> `_PROMOTED_GLOBALS`: a top-level
// slot only becomes a real global when some body actually reaches for it.
#stack[int, 64] txScanReqs;
#define(txScanReqs) {
    #scanp(txScanReqs, int, 0) head;
    #req[txAstKind] txAstKind;
    #req[txAstA] txAstA;
    #req[txAstB] txAstB;
    #req[txAstC] txAstC;
    #req[txAstNext] txAstNext;
    #req[txAstOff] txAstOff;
    #req[txAstLen] txAstLen;
    #req[txFuncFind] txFuncFind;
    #req[txGlobFind] txGlobFind;
    #req[txGlobAdd] txGlobAdd;
    #req[txScanReqs] txScanReqs;
    #stack[int, 64] s = head;
    #stack[int, 32] go = 1;
    while (go == 1) {
        if (s == 0) { go = 0; }
        if (go == 1) {
            #stack[int, 64] k = cssc::peek64(txAstKind + s * 8);
            if (k == 19) {                                  // REQ
                #stack[int, 64] gOff = cssc::peek64(txAstOff + s * 8);
                #stack[int, 64] gLen = cssc::peek64(txAstLen + s * 8);
                txFuncFind(gOff, gLen) fi;
                if (fi < 0) {                               // not a function -> a global
                    txGlobFind(gOff, gLen) already;
                    if (already < 0) { txGlobAdd(gOff, gLen) ni; #delete[ni]; }
                    #delete[already];
                }
                #delete[fi];
                #delete[gLen];
                #delete[gOff];
            }
            // recurse into nested block-bearing statements
            if (k == 12) { txScanReqs(cssc::peek64(txAstA + s * 8)); }               // BLOCK
            if (k == 9) {                                                            // IF
                #stack[int, 64] tb = cssc::peek64(txAstB + s * 8);
                #stack[int, 64] eb = cssc::peek64(txAstC + s * 8);
                if (tb != 0) { txScanReqs(cssc::peek64(txAstA + tb * 8)); }
                if (eb != 0) { txScanReqs(cssc::peek64(txAstA + eb * 8)); }
                #delete[eb];
                #delete[tb];
            }
            if (k == 10) {                                                           // WHILE
                #stack[int, 64] wb = cssc::peek64(txAstB + s * 8);
                if (wb != 0) { txScanReqs(cssc::peek64(txAstA + wb * 8)); }
                #delete[wb];
            }
            if (k == 11) {                                                           // FOR
                #stack[int, 64] fb = cssc::peek64(txAstC + s * 8);
                if (fb != 0) { txScanReqs(cssc::peek64(txAstA + fb * 8)); }
                #delete[fb];
            }
            #delete[k];
            s = cssc::peek64(txAstNext + s * 8);
        }
    }
    #delete[go];
    #delete[s];
}

// scan every function body for `#req`-ed globals (run AFTER txCollectFuncs so
// txFuncFind can tell a callable `#req` from a variable one).
#stack[int, 64] txPrescanGlobals;
#define(txPrescanGlobals) {
    #scanp(txPrescanGlobals, int, 0) prog;
    #req[txAstA] txAstA;
    #req[txAstKind] txAstKind;
    #req[txAstNext] txAstNext;
    #req[txScanReqs] txScanReqs;
    #stack[int, 64] s = cssc::peek64(txAstA + prog * 8);
    #stack[int, 32] go = 1;
    while (go == 1) {
        if (s == 0) { go = 0; }
        if (go == 1) {
            if (cssc::peek64(txAstKind + s * 8) == 17) {    // FUNC_DEF
                #stack[int, 64] body = cssc::peek64(txAstA + s * 8);
                if (body != 0) { txScanReqs(cssc::peek64(txAstA + body * 8)); }
                #delete[body];
            }
            if (cssc::peek64(txAstKind + s * 8) == 34) {    // OBJECT
                #req[txAstB] txAstB;
                #req[txAstC] txAstC;
                #req[txAstOff] txAstOff;
                #req[txAstLen] txAstLen;
                #req[txFuncFind] txFuncFind;
                #req[txGlobFind] txGlobFind;
                #req[txGlobAdd] txGlobAdd;
                // genparams that name a top-level VARIABLE (not a #define) become
                // globals the object body can read directly (e.g. smoke_free_time).
                #stack[int, 64] gp = cssc::peek64(txAstA + s * 8);
                #stack[int, 32] gpgo = 1;
                while (gpgo == 1) {
                    if (gp == 0) { gpgo = 0; }
                    if (gpgo == 1) {
                        // A TYPED genparam (`<int: start>`, C==1) is a ctor PARAMETER,
                        // not a scope-injected outer name -- it must stay a local slot,
                        // so skip it here (else `start` becomes a 0-init global that
                        // shadows the argument and the object reads 0).
                        if (cssc::peek64(txAstC + gp * 8) == 0) {
                            #stack[int, 64] gpo = cssc::peek64(txAstOff + gp * 8);
                            #stack[int, 64] gpl = cssc::peek64(txAstLen + gp * 8);
                            txFuncFind(gpo, gpl) isFn;
                            if (isFn < 0) {
                                txGlobFind(gpo, gpl) has;
                                if (has < 0) { txGlobAdd(gpo, gpl) ng; #delete[ng]; }
                                #delete[has];
                            }
                            #delete[isFn];
                            #delete[gpl];
                            #delete[gpo];
                        }
                        gp = cssc::peek64(txAstNext + gp * 8);
                    }
                }
                #delete[gpgo];
                #delete[gp];
                // #req inside the init chain + label bodies -> promote those globals.
                #stack[int, 64] ib = cssc::peek64(txAstB + s * 8);
                if (ib != 0) { txScanReqs(ib); }
                #delete[ib];
                #stack[int, 64] lb = cssc::peek64(txAstC + s * 8);
                #stack[int, 32] lbgo = 1;
                while (lbgo == 1) {
                    if (lb == 0) { lbgo = 0; }
                    if (lbgo == 1) {
                        #stack[int, 64] lbody = cssc::peek64(txAstB + lb * 8);
                        if (lbody != 0) { txScanReqs(lbody); }
                        #delete[lbody];
                        lb = cssc::peek64(txAstNext + lb * 8);
                    }
                }
                #delete[lbgo];
                #delete[lb];
            }
            s = cssc::peek64(txAstNext + s * 8);
        }
    }
    #delete[go];
    #delete[s];
}

// ---- M5: return-type pre-scan ----
// main is lowered BEFORE the `#define` bodies, so by the time a call site is
// lowered the callee's `return` has not been seen yet. The reference solves this
// with `_prescan_define_returns`; we do the same: a cheap static pass that marks
// which functions return a string, run to a fixpoint so a function returning
// another function's string result is caught too.
#stack[int, 64] txPreStrAdd;
#define(txPreStrAdd) {
    #scanp(txPreStrAdd, int, 0) off;
    #scanp(txPreStrAdd, int, 1) len;
    #req[txPreStrOff] txPreStrOff;
    #req[txPreStrLen] txPreStrLen;
    #req[txPreStrCount] txPreStrCount;
    #stack[int, 64] i = txPreStrCount;
    txPreStrCount = txPreStrCount + 1;
    cssc::poke64(txPreStrOff + i * 8, off);
    cssc::poke64(txPreStrLen + i * 8, len);
    #delete[i];
}

#stack[int, 64] txPreStrHas;
#define(txPreStrHas) {
    #scanp(txPreStrHas, int, 0) off;
    #scanp(txPreStrHas, int, 1) len;
    #req[txPreStrOff] txPreStrOff;
    #req[txPreStrLen] txPreStrLen;
    #req[txPreStrCount] txPreStrCount;
    #req[txSpanEq] txSpanEq;
    #stack[int, 32] found = 0;
    #stack[int, 64] i = 0;
    while (i < txPreStrCount) {
        txSpanEq(off, len, cssc::peek64(txPreStrOff + i * 8), cssc::peek64(txPreStrLen + i * 8)) eq;
        if (eq == 1) { found = 1; }
        #delete[eq];
        i = i + 1;
    }
    #delete[i];
    return found;
}

// statically: does this expression produce a string?
#stack[int, 64] txExprIsStrStatic;
#define(txExprIsStrStatic) {
    #scanp(txExprIsStrStatic, int, 0) node;
    #req[txAstKind] txAstKind;
    #req[txAstA] txAstA;
    #req[txAstB] txAstB;
    #req[txAstNum] txAstNum;
    #req[txAstOff] txAstOff;
    #req[txAstLen] txAstLen;
    #req[txPreStrHas] txPreStrHas;
    #req[txGlobFind] txGlobFind;
    #req[txGlobIsStr] txGlobIsStr;
    #req[txFuncFind] txFuncFind;
    #req[txFuncIsRetStr] txFuncIsRetStr;
    #req[txExprIsStrStatic] txExprIsStrStatic;
    #stack[int, 32] r = 0;
    if (node != 0) {
        #stack[int, 64] k = cssc::peek64(txAstKind + node * 8);
        if (k == 4) { r = 1; }                              // string literal
        if (k == 5) {                                       // ident: string name?
            #stack[int, 64] iOff = cssc::peek64(txAstOff + node * 8);
            #stack[int, 64] iLen = cssc::peek64(txAstLen + node * 8);
            txPreStrHas(iOff, iLen) h;
            if (h == 1) { r = 1; }
            #delete[h];
            if (r == 0) {                                   // or a string global
                txGlobFind(iOff, iLen) gj;
                if (gj >= 0) { txGlobIsStr(gj) gs; if (gs == 1) { r = 1; } #delete[gs]; }
                #delete[gj];
            }
            #delete[iLen];
            #delete[iOff];
        }
        if (k == 6) {                                       // `+` with a string side
            if (cssc::peek64(txAstNum + node * 8) == 1) {
                txExprIsStrStatic(cssc::peek64(txAstA + node * 8)) ls;
                txExprIsStrStatic(cssc::peek64(txAstB + node * 8)) rs;
                if (ls == 1) { r = 1; }
                if (rs == 1) { r = 1; }
                #delete[ls];
                #delete[rs];
            }
        }
        if (k == 14) {                                      // call to a string-returning fn
            txFuncFind(cssc::peek64(txAstOff + node * 8), cssc::peek64(txAstLen + node * 8)) fj;
            if (fj >= 0) { txFuncIsRetStr(fj) fs; if (fs == 1) { r = 1; } #delete[fs]; }
            #delete[fj];
        }
        #delete[k];
    }
    return r;
}

// float-typed name set (parallel to txPreStr), for `mirror &floatvar` typing.
#stack[int, 64] txPreFloatAdd;
#define(txPreFloatAdd) {
    #scanp(txPreFloatAdd, int, 0) off;
    #scanp(txPreFloatAdd, int, 1) len;
    #req[txPreFloatOff] txPreFloatOff;
    #req[txPreFloatLen] txPreFloatLen;
    #req[txPreFloatCount] txPreFloatCount;
    #stack[int, 64] i = txPreFloatCount;
    txPreFloatCount = txPreFloatCount + 1;
    cssc::poke64(txPreFloatOff + i * 8, off);
    cssc::poke64(txPreFloatLen + i * 8, len);
    #delete[i];
}
#stack[int, 64] txPreFloatHas;
#define(txPreFloatHas) {
    #scanp(txPreFloatHas, int, 0) off;
    #scanp(txPreFloatHas, int, 1) len;
    #req[txPreFloatOff] txPreFloatOff;
    #req[txPreFloatLen] txPreFloatLen;
    #req[txPreFloatCount] txPreFloatCount;
    #req[txSpanEq] txSpanEq;
    #stack[int, 32] found = 0;
    #stack[int, 64] i = 0;
    while (i < txPreFloatCount) {
        txSpanEq(off, len, cssc::peek64(txPreFloatOff + i * 8), cssc::peek64(txPreFloatLen + i * 8)) eq;
        if (eq == 1) { found = 1; }
        #delete[eq];
        i = i + 1;
    }
    #delete[i];
    return found;
}

// statically: does this expression produce a float? (float literal, a float
// name, float arithmetic, or a float-returning call)
#stack[int, 64] txExprIsFloatStatic;
#define(txExprIsFloatStatic) {
    #scanp(txExprIsFloatStatic, int, 0) node;
    #req[txAstKind] txAstKind;
    #req[txAstA] txAstA;
    #req[txAstB] txAstB;
    #req[txAstNum] txAstNum;
    #req[txAstOff] txAstOff;
    #req[txAstLen] txAstLen;
    #req[txPreFloatHas] txPreFloatHas;
    #req[txGlobFind] txGlobFind;
    #req[txGlobIsFloat] txGlobIsFloat;
    #req[txFuncFind] txFuncFind;
    #req[txFuncIsRetFloat] txFuncIsRetFloat;
    #req[txExprIsFloatStatic] txExprIsFloatStatic;
    #stack[int, 32] r = 0;
    if (node != 0) {
        #stack[int, 64] k = cssc::peek64(txAstKind + node * 8);
        if (k == 3) { if (cssc::peek64(txAstB + node * 8) == 1) { r = 1; } }   // float literal
        if (k == 27) { txExprIsFloatStatic(cssc::peek64(txAstA + node * 8)) c; if (c == 1) { r = 1; } #delete[c]; }  // &x
        if (k == 5) {
            #stack[int, 64] iOff = cssc::peek64(txAstOff + node * 8);
            #stack[int, 64] iLen = cssc::peek64(txAstLen + node * 8);
            txPreFloatHas(iOff, iLen) h;
            if (h == 1) { r = 1; }
            #delete[h];
            if (r == 0) {
                txGlobFind(iOff, iLen) gj;
                if (gj >= 0) { txGlobIsFloat(gj) gs; if (gs == 1) { r = 1; } #delete[gs]; }
                #delete[gj];
            }
            #delete[iLen];
            #delete[iOff];
        }
        if (k == 6) {                                       // arithmetic with a float side
            #stack[int, 64] op = cssc::peek64(txAstNum + node * 8);
            if (op <= 5) {                                  // + - * / % (not comparisons)
                txExprIsFloatStatic(cssc::peek64(txAstA + node * 8)) ls;
                txExprIsFloatStatic(cssc::peek64(txAstB + node * 8)) rs;
                if (ls == 1) { r = 1; }
                if (rs == 1) { r = 1; }
                #delete[ls];
                #delete[rs];
            }
            #delete[op];
        }
        if (k == 14) {
            txFuncFind(cssc::peek64(txAstOff + node * 8), cssc::peek64(txAstLen + node * 8)) fj;
            if (fj >= 0) { txFuncIsRetFloat(fj) fs; if (fs == 1) { r = 1; } #delete[fs]; }
            #delete[fj];
        }
        #delete[k];
    }
    return r;
}

// statically: does this expression produce a bool? (true/false literal marked in
// C, a comparison/logical BINARY, `&bool`, or a bool-returning call)
#stack[int, 64] txExprIsBoolStatic;
#define(txExprIsBoolStatic) {
    #scanp(txExprIsBoolStatic, int, 0) node;
    #req[txAstKind] txAstKind;
    #req[txAstA] txAstA;
    #req[txAstC] txAstC;
    #req[txAstNum] txAstNum;
    #req[txAstOff] txAstOff;
    #req[txAstLen] txAstLen;
    #req[txFuncFind] txFuncFind;
    #req[txFuncIsRetBool] txFuncIsRetBool;
    #req[txExprIsBoolStatic] txExprIsBoolStatic;
    #stack[int, 32] r = 0;
    if (node != 0) {
        #stack[int, 64] k = cssc::peek64(txAstKind + node * 8);
        if (k == 3) { if (cssc::peek64(txAstC + node * 8) == 1) { r = 1; } }   // true/false
        if (k == 13) { r = 1; }                             // NOT -> bool
        if (k == 27) { txExprIsBoolStatic(cssc::peek64(txAstA + node * 8)) c; if (c == 1) { r = 1; } #delete[c]; }
        if (k == 6) { if (cssc::peek64(txAstNum + node * 8) >= 6) { r = 1; } }  // comparison/logical
        if (k == 14) {
            txFuncFind(cssc::peek64(txAstOff + node * 8), cssc::peek64(txAstLen + node * 8)) fj;
            if (fj >= 0) { txFuncIsRetBool(fj) fs; if (fs == 1) { r = 1; } #delete[fs]; }
            #delete[fj];
        }
        #delete[k];
    }
    return r;
}

// mark the current function's return kind from a `return`/`mirror` value node.
#stack[int, 64] txPreMarkRet;
#define(txPreMarkRet) {
    #scanp(txPreMarkRet, int, 0) val;
    #scanp(txPreMarkRet, int, 1) fi;
    #req[txExprIsStrStatic] txExprIsStrStatic;
    #req[txExprIsFloatStatic] txExprIsFloatStatic;
    #req[txExprIsBoolStatic] txExprIsBoolStatic;
    #req[txFuncIsRetStr] txFuncIsRetStr;
    #req[txFuncSetRetStr] txFuncSetRetStr;
    #req[txFuncIsRetFloat] txFuncIsRetFloat;
    #req[txFuncSetRetFloat] txFuncSetRetFloat;
    #req[txFuncIsRetBool] txFuncIsRetBool;
    #req[txFuncSetRetBool] txFuncSetRetBool;
    #req[txPreChanged] txPreChanged;
    txExprIsStrStatic(val) rs;
    if (rs == 1) { txFuncIsRetStr(fi) had; if (had == 0) { txFuncSetRetStr(fi); txPreChanged = 1; } #delete[had]; }
    #delete[rs];
    txExprIsFloatStatic(val) rf;
    if (rf == 1) { txFuncIsRetFloat(fi) had2; if (had2 == 0) { txFuncSetRetFloat(fi); txPreChanged = 1; } #delete[had2]; }
    #delete[rf];
    txExprIsBoolStatic(val) rb;
    if (rb == 1) { txFuncIsRetBool(fi) had3; if (had3 == 0) { txFuncSetRetBool(fi); txPreChanged = 1; } #delete[had3]; }
    #delete[rb];
}

// collect string-typed names (string params + string locals) of one body, and
// mark the function's return kind from its `return` statements. Recurses into
// nested blocks so a `return` inside an if/while counts.
#stack[int, 64] txPreScanBody;
#define(txPreScanBody) {
    #scanp(txPreScanBody, int, 0) head;
    #scanp(txPreScanBody, int, 1) fi;
    #req[txAstKind] txAstKind;
    #req[txAstA] txAstA;
    #req[txAstB] txAstB;
    #req[txAstC] txAstC;
    #req[txAstNum] txAstNum;
    #req[txAstNext] txAstNext;
    #req[txAstOff] txAstOff;
    #req[txAstLen] txAstLen;
    #req[txPreStrAdd] txPreStrAdd;
    #req[txPreFloatAdd] txPreFloatAdd;
    #req[txExprIsStrStatic] txExprIsStrStatic;
    #req[txExprIsFloatStatic] txExprIsFloatStatic;
    #req[txExprIsBoolStatic] txExprIsBoolStatic;
    #req[txPreMarkRet] txPreMarkRet;
    #req[txPreChanged] txPreChanged;
    #req[txPreScanBody] txPreScanBody;
    #stack[int, 64] s = head;
    #stack[int, 32] go = 1;
    while (go == 1) {
        if (s == 0) { go = 0; }
        if (go == 1) {
            #stack[int, 64] k = cssc::peek64(txAstKind + s * 8);
            if (k == 18) {                                  // SCANP: typed param
                if (cssc::peek64(txAstB + s * 8) == 1) {
                    txPreStrAdd(cssc::peek64(txAstOff + s * 8), cssc::peek64(txAstLen + s * 8));
                }
                if (cssc::peek64(txAstB + s * 8) == 2) {
                    txPreFloatAdd(cssc::peek64(txAstOff + s * 8), cssc::peek64(txAstLen + s * 8));
                }
            }
            if (k == 7) {                                   // DECL: typed local
                #stack[int, 32] ds = 0;
                if (cssc::peek64(txAstNum + s * 8) == 1) { ds = 1; }
                if (ds == 0) {
                    txExprIsStrStatic(cssc::peek64(txAstA + s * 8)) iv;
                    if (iv == 1) { ds = 1; }
                    #delete[iv];
                }
                if (ds == 1) {
                    txPreStrAdd(cssc::peek64(txAstOff + s * 8), cssc::peek64(txAstLen + s * 8));
                }
                #delete[ds];
                #stack[int, 32] df = 0;                     // float local?
                if (cssc::peek64(txAstNum + s * 8) == 2) { df = 1; }
                if (df == 0) {
                    txExprIsFloatStatic(cssc::peek64(txAstA + s * 8)) fv;
                    if (fv == 1) { df = 1; }
                    #delete[fv];
                }
                if (df == 1) {
                    txPreFloatAdd(cssc::peek64(txAstOff + s * 8), cssc::peek64(txAstLen + s * 8));
                }
                #delete[df];
            }
            if (k == 20) { txPreMarkRet(cssc::peek64(txAstA + s * 8), fi); }   // RETURN
            if (k == 32) {                                                     // MIRROR
                // A bare-slot (LIVE-REF) mirror re-reads the slot at function
                // exit; a `#delete`d slot re-reads as an unbound int 0. So it
                // does NOT make the function string/float-returning -- only a
                // `&`/expression SNAPSHOT captures the value's type. Without
                // this, `mirror strSlot; #delete[strSlot];` typed the return
                // `string` and the caller printed a null pointer (crash) instead
                // of the reference's `0`.
                #stack[int, 64] mvN = cssc::peek64(txAstA + s * 8);
                #stack[int, 32] mLive = 0;
                if (cssc::peek64(txAstNum + s * 8) == 0) {
                    if (mvN != 0) { if (cssc::peek64(txAstKind + mvN * 8) == 5) { mLive = 1; } }
                }
                if (mLive == 0) { txPreMarkRet(mvN, fi); }
                #delete[mLive];
                #delete[mvN];
            }
            if (k == 12) { txPreScanBody(cssc::peek64(txAstA + s * 8), fi); }
            if (k == 9) {
                #stack[int, 64] tb = cssc::peek64(txAstB + s * 8);
                #stack[int, 64] eb = cssc::peek64(txAstC + s * 8);
                if (tb != 0) { txPreScanBody(cssc::peek64(txAstA + tb * 8), fi); }
                if (eb != 0) { txPreScanBody(cssc::peek64(txAstA + eb * 8), fi); }
                #delete[eb];
                #delete[tb];
            }
            if (k == 10) {
                #stack[int, 64] wb = cssc::peek64(txAstB + s * 8);
                if (wb != 0) { txPreScanBody(cssc::peek64(txAstA + wb * 8), fi); }
                #delete[wb];
            }
            if (k == 11) {
                #stack[int, 64] fb = cssc::peek64(txAstC + s * 8);
                if (fb != 0) { txPreScanBody(cssc::peek64(txAstA + fb * 8), fi); }
                #delete[fb];
            }
            if (k == 30) {                                  // SELECT body
                #stack[int, 64] sb = cssc::peek64(txAstB + s * 8);
                if (sb != 0) { txPreScanBody(cssc::peek64(txAstA + sb * 8), fi); }
                #delete[sb];
            }
            #delete[k];
            s = cssc::peek64(txAstNext + s * 8);
        }
    }
    #delete[go];
    #delete[s];
}

// run the return-kind pre-scan over every function, to a fixpoint.
#stack[int, 64] txPrescanRetTypes;
#define(txPrescanRetTypes) {
    #scanp(txPrescanRetTypes, int, 0) prog;
    #req[txAstA] txAstA;
    #req[txAstB] txAstB;
    #req[txAstKind] txAstKind;
    #req[txAstNext] txAstNext;
    #req[txAstOff] txAstOff;
    #req[txAstLen] txAstLen;
    #req[txFuncFind] txFuncFind;
    #req[txPreStrCount] txPreStrCount;
    #req[txPreFloatCount] txPreFloatCount;
    #req[txPreChanged] txPreChanged;
    #req[txPreScanBody] txPreScanBody;
    #stack[int, 32] round = 0;
    #stack[int, 32] more = 1;
    while (more == 1) {
        txPreChanged = 0;
        #stack[int, 64] s = cssc::peek64(txAstA + prog * 8);
        #stack[int, 32] go = 1;
        while (go == 1) {
            if (s == 0) { go = 0; }
            if (go == 1) {
                if (cssc::peek64(txAstKind + s * 8) == 17) {        // FUNC_DEF
                    txFuncFind(cssc::peek64(txAstOff + s * 8), cssc::peek64(txAstLen + s * 8)) fi;
                    if (fi >= 0) {
                        #stack[int, 64] body = cssc::peek64(txAstA + s * 8);
                        txPreStrCount = 0;                          // fresh name sets
                        txPreFloatCount = 0;
                        if (body != 0) { txPreScanBody(cssc::peek64(txAstA + body * 8), fi); }
                        #delete[body];
                    }
                    #delete[fi];
                }
                if (cssc::peek64(txAstKind + s * 8) == 34) {        // OBJECT: prescan its labels
                    #req[txObjFind] txObjFind;
                    #req[txLabFindFn] txLabFindFn;
                    #req[txAstC] txAstC;
                    txObjFind(cssc::peek64(txAstOff + s * 8), cssc::peek64(txAstLen + s * 8)) poid;
                    #stack[int, 64] plab = cssc::peek64(txAstC + s * 8);
                    #stack[int, 32] plgo = 1;
                    while (plgo == 1) {
                        if (plab == 0) { plgo = 0; }
                        if (plgo == 1) {
                            txLabFindFn(poid, cssc::peek64(txAstOff + plab * 8), cssc::peek64(txAstLen + plab * 8)) plfn;
                            txPreStrCount = 0;
                            txPreFloatCount = 0;
                            txPreScanBody(cssc::peek64(txAstB + plab * 8), plfn);
                            #delete[plfn];
                            plab = cssc::peek64(txAstNext + plab * 8);
                        }
                    }
                    #delete[plgo];
                    #delete[plab];
                    #delete[poid];
                }
                if (cssc::peek64(txAstKind + s * 8) == 41) {        // SECTOR: member fns
                    #req[txSecFind] txSecFind;
                    #req[txSFnFind] txSFnFind;
                    #req[txAstC] txAstCP;
                    txSecFind(cssc::peek64(txAstOff + s * 8), cssc::peek64(txAstLen + s * 8)) psid;
                    #stack[int, 64] pchain = cssc::peek64(txAstB + s * 8);
                    #stack[int, 32] pph = 0;
                    #stack[int, 32] pag = 1;
                    while (pag == 1) {
                        if (pchain == 0) {
                            if (pph == 0) { pph = 1; pchain = cssc::peek64(txAstCP + s * 8); }
                            if (pph == 1) { if (pchain == 0) { pag = 0; } }
                        }
                        if (pag == 1) { if (pchain != 0) {
                            if (cssc::peek64(txAstKind + pchain * 8) == 17) {   // FUNC_DEF
                                txSFnFind(psid, cssc::peek64(txAstOff + pchain * 8), cssc::peek64(txAstLen + pchain * 8)) sfn;
                                if (sfn >= 0) {
                                    #stack[int, 64] sbody = cssc::peek64(txAstA + pchain * 8);
                                    txPreStrCount = 0;
                                    txPreFloatCount = 0;
                                    if (sbody != 0) { txPreScanBody(cssc::peek64(txAstA + sbody * 8), sfn); }
                                    #delete[sbody];
                                }
                                #delete[sfn];
                            }
                            pchain = cssc::peek64(txAstNext + pchain * 8);
                        } }
                    }
                    #delete[pag];
                    #delete[pph];
                    #delete[pchain];
                    #delete[psid];
                }
                s = cssc::peek64(txAstNext + s * 8);
            }
        }
        #delete[go];
        #delete[s];
        round = round + 1;
        if (txPreChanged == 0) { more = 0; }
        if (round > 8) { more = 0; }                                // safety bound
    }
    #delete[more];
    #delete[round];
}

// ---- M7c/R3: "caller wins" by-address parameter analysis ----
// A parameter must be passed BY ADDRESS when the callee
//   (a) assigns to it,
//   (b) `#delete`s it, or
//   (c) forwards it as a BARE NAME into another by-address parameter.
// Rule (c) is what makes this a FIXPOINT: an intermediate frame only becomes
// by-address once its own callee is known to be, and that is exactly what makes
// an assignment cascade all the way up (probe p_chain3_wb -> 99/99) while a
// plain value pass stays free of any cost.
#stack[int, 64] txBrPOff = 0;      // parameter name spans of the function being scanned
#stack[int, 64] txBrPLen = 0;
#stack[int, 64] txBrPIdx = 0;
#stack[int, 64] txBrPCount = 0;
#stack[int, 64] txBrChanged = 0;   // fixpoint: set whenever a new flag appears

#stack[int, 64] txBrParamIdx;
#define(txBrParamIdx) {
    #scanp(txBrParamIdx, int, 0) off;
    #scanp(txBrParamIdx, int, 1) len;
    #req[txBrPOff] txBrPOff;
    #req[txBrPLen] txBrPLen;
    #req[txBrPIdx] txBrPIdx;
    #req[txBrPCount] txBrPCount;
    #req[txSpanEq] txSpanEq;
    #stack[int, 64] i = 0;
    #stack[int, 64] r = 0 - 1;
    while (i < txBrPCount) {
        txSpanEq(off, len, cssc::peek64(txBrPOff + i * 8),
                 cssc::peek64(txBrPLen + i * 8)) eq;
        if (eq == 1) { r = cssc::peek64(txBrPIdx + i * 8); }
        #delete[eq];
        i = i + 1;
    }
    #delete[i];
    return r;
}

// mark parameter `idx` of function `fi` by-address; note the fixpoint change.
#stack[int, 64] txBrMark;
#define(txBrMark) {
    #scanp(txBrMark, int, 0) fi;
    #scanp(txBrMark, int, 1) idx;
    #req[txParamByRef] txParamByRef;
    #req[txSetParamByRef] txSetParamByRef;
    #req[txBrChanged] txBrChanged;
    if (idx >= 0) {
        txParamByRef(fi, idx) had;
        if (had == 0) { txSetParamByRef(fi, idx); txBrChanged = 1; }
        #delete[had];
    }
}

// walk an EXPRESSION looking for calls; a bare parameter handed to a callee's
// by-address slot makes this function's parameter by-address too (rule c).
#stack[int, 64] txBrScanExpr;
#define(txBrScanExpr) {
    #scanp(txBrScanExpr, int, 0) node;
    #scanp(txBrScanExpr, int, 1) fi;
    #req[txAstKind] txAstKind;
    #req[txAstA] txAstA;
    #req[txAstB] txAstB;
    #req[txAstOff] txAstOff;
    #req[txAstLen] txAstLen;
    #req[txAstNext] txAstNext;
    #req[txFuncFind] txFuncFind;
    #req[txParamByRef] txParamByRef;
    #req[txBrParamIdx] txBrParamIdx;
    #req[txBrMark] txBrMark;
    #req[txBrScanExpr] txBrScanExpr;
    if (node != 0) {
        #stack[int, 64] k = cssc::peek64(txAstKind + node * 8);
        if (k == 14) {                                   // CALL
            txFuncFind(cssc::peek64(txAstOff + node * 8),
                       cssc::peek64(txAstLen + node * 8)) cf;
            #stack[int, 64] arg = cssc::peek64(txAstA + node * 8);
            #stack[int, 64] ai = 0;
            #stack[int, 32] ago = 1;
            while (ago == 1) {
                if (arg == 0) { ago = 0; }
                if (ago == 1) {
                    if (cf >= 0) {
                        txParamByRef(cf, ai) cb;
                        if (cb == 1) {
                            if (cssc::peek64(txAstKind + arg * 8) == 5) {   // bare name
                                txBrParamIdx(cssc::peek64(txAstOff + arg * 8),
                                             cssc::peek64(txAstLen + arg * 8)) pidx;
                                txBrMark(fi, pidx);
                                #delete[pidx];
                            }
                        }
                        #delete[cb];
                    }
                    txBrScanExpr(arg, fi);               // nested calls in this arg
                    ai = ai + 1;
                    arg = cssc::peek64(txAstNext + arg * 8);
                }
            }
            #delete[ago];
            #delete[ai];
            #delete[arg];
            #delete[cf];
        }
        // Recurse ONLY into slots that actually hold child-expression pointers.
        // A blanket A/B walk is WRONG for leaf nodes: a NUMBER (k==3) keeps its
        // float flag in B (1 for an f64 literal), not a node -- walking that "1"
        // as a node index runs off into an unrelated cycle and stack-overflows.
        // Mirror txValExpr's kind set (the validated expression walker).
        if (k == 6) {                                    // BINARY: both operands
            txBrScanExpr(cssc::peek64(txAstA + node * 8), fi);
            txBrScanExpr(cssc::peek64(txAstB + node * 8), fi);
        }
        if (k == 13) { txBrScanExpr(cssc::peek64(txAstA + node * 8), fi); }   // !x
        if (k == 27) { txBrScanExpr(cssc::peek64(txAstA + node * 8), fi); }   // &x
        if (k == 25) {                                   // INDEX recv[key]
            txBrScanExpr(cssc::peek64(txAstA + node * 8), fi);
            txBrScanExpr(cssc::peek64(txAstB + node * 8), fi);
        }
        if (k == 22) {                                   // vector literal: elements
            #stack[int, 64] ve = cssc::peek64(txAstA + node * 8);
            #stack[int, 32] vego = 1;
            while (vego == 1) {
                if (ve == 0) { vego = 0; }
                if (vego == 1) { txBrScanExpr(ve, fi); ve = cssc::peek64(txAstNext + ve * 8); }
            }
            #delete[vego];
            #delete[ve];
        }
        if (k == 24) {                                   // map literal: pairs
            #stack[int, 64] me = cssc::peek64(txAstA + node * 8);
            #stack[int, 32] mego = 1;
            while (mego == 1) {
                if (me == 0) { mego = 0; }
                if (mego == 1) { txBrScanExpr(me, fi); me = cssc::peek64(txAstNext + me * 8); }
            }
            #delete[mego];
            #delete[me];
        }
        #delete[k];
    }
}

// walk a STATEMENT chain, applying rules (a), (b) and (c).
#stack[int, 64] txBrScanStmts;
#define(txBrScanStmts) {
    #scanp(txBrScanStmts, int, 0) s0;
    #scanp(txBrScanStmts, int, 1) fi;
    #req[txAstKind] txAstKind;
    #req[txAstA] txAstA;
    #req[txAstB] txAstB;
    #req[txAstC] txAstC;
    #req[txAstOff] txAstOff;
    #req[txAstLen] txAstLen;
    #req[txAstNext] txAstNext;
    #req[txBrParamIdx] txBrParamIdx;
    #req[txBrMark] txBrMark;
    #req[txBrScanExpr] txBrScanExpr;
    #req[txBrScanStmts] txBrScanStmts;
    #stack[int, 64] s = s0;
    #stack[int, 32] go = 1;
    while (go == 1) {
        if (s == 0) { go = 0; }
        if (go == 1) {
            #stack[int, 64] k = cssc::peek64(txAstKind + s * 8);
            if (k == 8) {                                // ASSIGN name = expr  (rule a)
                txBrParamIdx(cssc::peek64(txAstOff + s * 8),
                             cssc::peek64(txAstLen + s * 8)) pi2;
                txBrMark(fi, pi2);
                #delete[pi2];
                txBrScanExpr(cssc::peek64(txAstA + s * 8), fi);
            }
            if (k == 21) {                               // DELETE name        (rule b)
                txBrParamIdx(cssc::peek64(txAstOff + s * 8),
                             cssc::peek64(txAstLen + s * 8)) pi3;
                txBrMark(fi, pi3);
                #delete[pi3];
            }
            if (k == 7) { txBrScanExpr(cssc::peek64(txAstA + s * 8), fi); }   // DECL init
            if (k == 15) { txBrScanExpr(cssc::peek64(txAstA + s * 8), fi); }  // RESULT_CAPTURE
            if (k == 16) { txBrScanExpr(cssc::peek64(txAstA + s * 8), fi); }  // EXPR_STMT
            if (k == 20) { txBrScanExpr(cssc::peek64(txAstA + s * 8), fi); }  // RETURN
            if (k == 12) { txBrScanStmts(cssc::peek64(txAstA + s * 8), fi); } // BLOCK
            if (k == 9) {                                                     // IF
                txBrScanExpr(cssc::peek64(txAstA + s * 8), fi);
                txBrScanStmts(cssc::peek64(txAstB + s * 8), fi);
                txBrScanStmts(cssc::peek64(txAstC + s * 8), fi);
            }
            if (k == 10) {                                                    // WHILE
                txBrScanExpr(cssc::peek64(txAstA + s * 8), fi);
                txBrScanStmts(cssc::peek64(txAstB + s * 8), fi);
            }
            if (k == 11) {                                                    // FOR
                txBrScanStmts(cssc::peek64(txAstA + s * 8), fi);
                txBrScanExpr(cssc::peek64(txAstB + s * 8), fi);
                txBrScanStmts(cssc::peek64(txAstC + s * 8), fi);
            }
            #delete[k];
            s = cssc::peek64(txAstNext + s * 8);
        }
    }
    #delete[go];
    #delete[s];
}

// run the analysis over every user function until nothing changes.
#stack[int, 64] txPrescanByRef;
#define(txPrescanByRef) {
    #req[txFuncCount] txFuncCount;
    #req[txFuncAstNode] txFuncAstNode;
    #req[txAstA] txAstA;
    #req[txAstKind] txAstKind;
    #req[txAstNum] txAstNum;
    #req[txAstOff] txAstOff;
    #req[txAstLen] txAstLen;
    #req[txAstNext] txAstNext;
    #req[txBrPOff] txBrPOff;
    #req[txBrPLen] txBrPLen;
    #req[txBrPIdx] txBrPIdx;
    #req[txBrPCount] txBrPCount;
    #req[txBrChanged] txBrChanged;
    #req[txBrScanStmts] txBrScanStmts;
    txBrPOff = cssc::alloc(64);        // at most 8 parameters per function
    txBrPLen = cssc::alloc(64);
    txBrPIdx = cssc::alloc(64);
    #stack[int, 32] rounds = 1;
    while (rounds == 1) {
        txBrChanged = 0;
        #stack[int, 64] fi = 1;                        // 0 is cssc_user_main
        while (fi < txFuncCount) {
            #stack[int, 64] astNode = cssc::peek64(txFuncAstNode + fi * 8);
            #stack[int, 64] body = cssc::peek64(txAstA + astNode * 8);
            #stack[int, 64] first = cssc::peek64(txAstA + body * 8);
            // collect this function's parameter name spans (SCANP, top level)
            txBrPCount = 0;
            #stack[int, 64] p = first;
            #stack[int, 32] pgo = 1;
            while (pgo == 1) {
                if (p == 0) { pgo = 0; }
                if (pgo == 1) {
                    if (cssc::peek64(txAstKind + p * 8) == 18) {      // SCANP
                        if (txBrPCount < 8) {
                            cssc::poke64(txBrPOff + txBrPCount * 8, cssc::peek64(txAstOff + p * 8));
                            cssc::poke64(txBrPLen + txBrPCount * 8, cssc::peek64(txAstLen + p * 8));
                            cssc::poke64(txBrPIdx + txBrPCount * 8, cssc::peek64(txAstNum + p * 8));
                            txBrPCount = txBrPCount + 1;
                        }
                    }
                    p = cssc::peek64(txAstNext + p * 8);
                }
            }
            #delete[pgo];
            #delete[p];
            txBrScanStmts(first, fi);
            #delete[first];
            #delete[body];
            #delete[astNode];
            fi = fi + 1;
        }
        #delete[fi];
        if (txBrChanged == 0) { rounds = 0; }
    }
    #delete[rounds];
}

// ---- M4: multi-function lowering ----

// register cssc_user_main (index 0) + every top-level FUNC_DEF into the function
// registry BEFORE any body is lowered (enables forward refs + mutual recursion).
#stack[int, 64] txCollectFuncs;
#define(txCollectFuncs) {
    #scanp(txCollectFuncs, int, 0) prog;
    #req[txAstA] txAstA;
    #req[txAstNext] txAstNext;
    #req[txAstKind] txAstKind;
    #req[txAstOff] txAstOff;
    #req[txAstLen] txAstLen;
    #req[txFuncAdd] txFuncAdd;
    txFuncAdd(0, 0, 0) mainIdx;                        // index 0 = main (name len 0)
    #delete[mainIdx];
    #stack[int, 64] s = cssc::peek64(txAstA + prog * 8);
    #stack[int, 32] go = 1;
    while (go == 1) {
        if (s == 0) { go = 0; }
        if (go == 1) {
            if (cssc::peek64(txAstKind + s * 8) == 17) {   // FUNC_DEF
                txFuncAdd(cssc::peek64(txAstOff + s * 8), cssc::peek64(txAstLen + s * 8), s) fi;
                #delete[fi];
            }
            s = cssc::peek64(txAstNext + s * 8);
        }
    }
    #delete[go];
    #delete[s];
}

// lower cssc_user_main (function 0): the top-level statements, skipping FUNC_DEFs
// (lowered separately) and function forward-declarations (`#stack fnName;`).
#stack[int, 64] txLowerMain;
#define(txLowerMain) {
    #scanp(txLowerMain, int, 0) prog;
    #req[txAstA] txAstA;
    #req[txAstNext] txAstNext;
    #req[txAstKind] txAstKind;
    #req[txAstOff] txAstOff;
    #req[txAstLen] txAstLen;
    #req[txAstB] txAstB;
    #req[txAstC] txAstC;
    #req[txSrc] txSrc;
    #req[txFuncBegin] txFuncBegin;
    #req[txFuncEnd] txFuncEnd;
    #req[txFuncFind] txFuncFind;
    #req[txSymCount] txSymCount;
    #req[txAliasCount] txAliasCount;
    #req[txGAliasCount] txGAliasCount;
    #req[txGAliasAdd] txGAliasAdd;
    #req[txGlobNameOff] txGlobNameOff;
    #req[txGlobNameLen] txGlobNameLen;
    #req[txGlobCount] txGlobCount;
    #req[txGlobFind] txGlobFind;
    #req[txAstNum] txAstNum;
    #req[txGlobSetStr] txGlobSetStr;
    #req[txIsStr] txIsStr;
    #req[txLowerExpr] txLowerExpr;
    #req[txCirGlobStore] txCirGlobStore;
    #req[txLowerStmt] txLowerStmt;
    #req[txCurFunc] txCurFunc;
    #req[txCirRet] txCirRet;
    #req[txSecFind] txSecFind;
    #req[txConstructSector] txConstructSector;
    #req[txSecAliCount] txSecAliCount;
    txFuncBegin(0);
    txCurFunc = 0;
    txSymCount = 0;
    txAliasCount = 0;
    txGAliasCount = 0;
    txSecAliCount = 0;
    // module scope sees every global without `#req` -> pre-register each under
    // its own name so IDENT/ASSIGN resolve to the global cell inside main too.
    #stack[int, 64] gi = 0;
    while (gi < txGlobCount) {
        txGAliasAdd(cssc::peek64(txGlobNameOff + gi * 8),
                    cssc::peek64(txGlobNameLen + gi * 8), gi);
        gi = gi + 1;
    }
    #delete[gi];
    #stack[int, 64] s = cssc::peek64(txAstA + prog * 8);
    #stack[int, 32] go = 1;
    while (go == 1) {
        if (s == 0) { go = 0; }
        if (go == 1) {
            #stack[int, 64] k = cssc::peek64(txAstKind + s * 8);
            #stack[int, 32] skip = 0;
            if (k == 17) { skip = 1; }                      // FUNC_DEF
            if (k == 34) { skip = 1; }                      // OBJECT decl (lowered separately)
            if (k == 41) {                                  // SECTOR: build it here, in order
                skip = 1;
                txSecFind(cssc::peek64(txAstOff + s * 8), cssc::peek64(txAstLen + s * 8)) csid;
                if (csid >= 0) { txConstructSector(s, csid); }
                #delete[csid];
            }
            if (k == 43) {                                  // MODALIAS: #include('mod') alias
                skip = 1;                                   // bind alias -> the module's sector
                #req[txSecAliAdd] txSecAliAdd;
                #stack[int, 64] mnOff = cssc::peek64(txAstB + s * 8);
                #stack[int, 64] mnLen = cssc::peek64(txAstC + s * 8);
                if (mnLen > 5) {                            // strip a leading "cssc." namespace
                    #stack[int, 32] pfx = 0;
                    if (cssc::peek8(txSrc + mnOff + 0) == 99) { if (cssc::peek8(txSrc + mnOff + 1) == 115) {
                    if (cssc::peek8(txSrc + mnOff + 2) == 115) { if (cssc::peek8(txSrc + mnOff + 3) == 99) {
                    if (cssc::peek8(txSrc + mnOff + 4) == 46) { pfx = 1; } } } } }
                    if (pfx == 1) { mnOff = mnOff + 5; mnLen = mnLen - 5; }
                    #delete[pfx];
                }
                txSecFind(mnOff, mnLen) msec;
                #stack[int, 64] aOff = cssc::peek64(txAstOff + s * 8);
                #stack[int, 64] aLen = cssc::peek64(txAstLen + s * 8);
                txSpanIs(mnOff, mnLen, "math") isMathMod;   // built-in modules the compiler
                txSpanIs(mnOff, mnLen, "sizes") isSizesMod; // resolves itself (rtsym/constant)
                txSpanIs(mnOff, mnLen, "paths") isPathsMod;
                txSpanIs(mnOff, mnLen, "stdio") isStdioMod;
                txSpanIs(mnOff, mnLen, "peek") isPeekMod;
                #stack[int, 32] biKind = 0;
                if (isMathMod == 1) { biKind = 1; }
                if (isSizesMod == 1) { biKind = 2; }
                if (isPathsMod == 1) { biKind = 4; }
                if (isStdioMod == 1) { biKind = 5; }
                if (isPeekMod == 1) { biKind = 6; }
                if (biKind > 0) {
                    #req[txBiModAdd] txBiModAdd;            // not a sector; ignore any
                    if (aLen > 0) { txBiModAdd(aOff, aLen, biKind); } // placeholder module file
                }
                if (biKind == 0) {
                    if (msec >= 0) { if (aLen > 0) { txSecAliAdd(aOff, aLen, msec); } }
                    if (msec < 0) {                         // flat (`transparent`) module:
                        #req[txModFlatAdd] txModFlatAdd;    // its #defines/globals were
                        if (aLen > 0) { txModFlatAdd(aOff, aLen); } // concatenated at top level
                    }
                }
                #delete[biKind];
                #delete[isPeekMod];
                #delete[isStdioMod];
                #delete[isPathsMod];
                #delete[isSizesMod];
                #delete[isMathMod];
                #delete[aLen]; #delete[aOff]; #delete[msec]; #delete[mnLen]; #delete[mnOff];
            }
            if (k == 7) {
                #stack[int, 64] dOff = cssc::peek64(txAstOff + s * 8);
                #stack[int, 64] dLen = cssc::peek64(txAstLen + s * 8);
                #stack[int, 64] dInit = cssc::peek64(txAstA + s * 8);
                if (dInit == 0) {                           // no-init DECL of a fn name
                    txFuncFind(dOff, dLen) ff;
                    if (ff >= 0) { skip = 1; }              // function forward-decl: ignored
                    #delete[ff];
                }
                if (skip == 0) {
                    txGlobFind(dOff, dLen) gi;
                    if (gi >= 0) {
                        // promoted module global: no frame cell -- the declaration
                        // just initialises the global's data cell, in main's
                        // statement order (same as the reference).
                        skip = 1;
                        if (cssc::peek64(txAstNum + s * 8) == 1) { txGlobSetStr(gi, 1); }
                        if (dInit != 0) {
                            txLowerExpr(dInit) v;
                            txIsStr(v) gvs;
                            if (gvs == 1) { txGlobSetStr(gi, 1); }
                            #delete[gvs];
                            txCirGlobStore(gi, v);
                            #delete[v];
                        }
                    }
                    #delete[gi];
                }
                #delete[dInit];
                #delete[dLen];
                #delete[dOff];
            }
            if (skip == 0) { txLowerStmt(s); }
            #delete[skip];
            #delete[k];
            s = cssc::peek64(txAstNext + s * 8);
        }
    }
    #delete[go];
    #delete[s];
    txCirRet(0 - 1);                                        // main is void
    txFuncEnd(0);
}

// lower one #define function `funcIdx`: pre-scan #scanp for arity, reserve param
// slots 0..arity-1 (so param i occupies slot i), lower the body, trailing RET.
#stack[int, 64] txLowerDefine;
#define(txLowerDefine) {
    #scanp(txLowerDefine, int, 0) funcIdx;
    #req[txAstA] txAstA;
    #req[txAstNext] txAstNext;
    #req[txAstKind] txAstKind;
    #req[txAstNum] txAstNum;
    #req[txFuncAstNode] txFuncAstNode;
    #req[txFuncBegin] txFuncBegin;
    #req[txFuncEnd] txFuncEnd;
    #req[txFuncSetArity] txFuncSetArity;
    #req[txFuncHasByRef] txFuncHasByRef;
    #req[txSymCount] txSymCount;
    #req[txAliasCount] txAliasCount;
    #req[txGAliasCount] txGAliasCount;
    #req[txNewSlot] txNewSlot;
    #req[txLowerStmt] txLowerStmt;
    #req[txCurFunc] txCurFunc;
    #req[txReleaseLocals] txReleaseLocals;
    #req[txCirRet] txCirRet;
    #req[txReqReset] txReqReset;
    #req[txReqWriteBack] txReqWriteBack;
    #req[txSecAliCount] txSecAliCount;
    #req[txHasMirror] txHasMirror;
    #req[txMirUses] txMirUses;
    #req[txMirSetSlot] txMirSetSlot;
    #req[txMirValSlot] txMirValSlot;
    #req[txMirRefSlot] txMirRefSlot;
    #req[txMirAddrSlot] txMirAddrSlot;
    #req[txMirEscape] txMirEscape;
    #req[txCirSlotAlloc] txCirSlotAlloc;
    #req[txCirSlotStore] txCirSlotStore;
    #req[txCirSlotLoad] txCirSlotLoad;
    #req[txCirConstInt] txCirConstInt;
    #req[txCirLoadInd] txCirLoadInd;
    #req[txNewLabel] txNewLabel;
    #req[txCirLabel] txCirLabel;
    #req[txCirBrz] txCirBrz;
    #req[txCirBr] txCirBr;
    #stack[int, 64] astNode = cssc::peek64(txFuncAstNode + funcIdx * 8);
    #stack[int, 64] body = cssc::peek64(txAstA + astNode * 8);   // the body BLOCK
    txFuncBegin(funcIdx);
    txCurFunc = funcIdx;
    txSymCount = 0;
    txAliasCount = 0;
    txGAliasCount = 0;          // globals enter a function body only via `#req`
    txSecAliCount = 0;          // `#req[sector]` aliases are per-function too
    txReqReset();               // slot ids restart -> so must the `#req` back-links
    // pre-scan the body for the highest #scanp arg index -> arity
    #stack[int, 64] arity = 0;
    #stack[int, 64] s = cssc::peek64(txAstA + body * 8);
    #stack[int, 32] go = 1;
    while (go == 1) {
        if (s == 0) { go = 0; }
        if (go == 1) {
            if (cssc::peek64(txAstKind + s * 8) == 18) {        // SCANP
                #stack[int, 64] idx = cssc::peek64(txAstNum + s * 8);
                if (idx + 1 > arity) { arity = idx + 1; }
                #delete[idx];
            }
            s = cssc::peek64(txAstNext + s * 8);
        }
    }
    #delete[go];
    #delete[s];
    // reserve param slots 0..arity-1 BEFORE any body DECL grabs a slot
    #stack[int, 64] i = 0;
    while (i < arity) { txNewSlot() sl; #delete[sl]; i = i + 1; }
    #delete[i];
    txFuncSetArity(funcIdx, arity);
    // "caller wins": a by-address parameter needs a second, hidden slot holding
    // the CALLER's cell address, so the RET write-back knows where to put the
    // final value. Reserved as slots arity..2*arity-1 -- the backend's prologue
    // and epilogue address them by exactly that rule. Only functions that
    // actually have such a parameter pay the frame cost.
    txFuncHasByRef(funcIdx) needAddrSlots;
    if (needAddrSlots == 1) {
        #stack[int, 64] j = 0;
        while (j < arity) { txNewSlot() asl; #delete[asl]; j = j + 1; }
        #delete[j];
    }
    #delete[needAddrSlots];
    // M8b: if this function uses `mirror`, reserve the four hidden state slots
    // and seed the first-wins flag to 0 before any body statement runs.
    txHasMirror(cssc::peek64(txAstA + body * 8)) usesMir;
    txMirUses = usesMir;
    if (usesMir == 1) {
        txNewSlot() ms0; txMirSetSlot = ms0; txCirSlotAlloc(ms0); #delete[ms0];
        txNewSlot() mv0; txMirValSlot = mv0; txCirSlotAlloc(mv0); #delete[mv0];
        txNewSlot() mr0; txMirRefSlot = mr0; txCirSlotAlloc(mr0); #delete[mr0];
        txNewSlot() ma0; txMirAddrSlot = ma0; txCirSlotAlloc(ma0); #delete[ma0];
        txCirConstInt(0) z0; txCirSlotStore(txMirSetSlot, z0); #delete[z0];
    }
    // lower the body statements. When mirror is in play, each TOP-LEVEL statement
    // gets an escape label after it: a mirror inside branches there, which is
    // exactly "abort the enclosing statement path, resume at the next statement".
    #stack[int, 64] s2 = cssc::peek64(txAstA + body * 8);
    #stack[int, 32] go2 = 1;
    while (go2 == 1) {
        if (s2 == 0) { go2 = 0; }
        if (go2 == 1) {
            if (usesMir == 1) {
                txNewLabel() esc; txMirEscape = esc;
                txLowerStmt(s2);
                txCirLabel(esc);
                #delete[esc];
            }
            if (usesMir == 0) { txLowerStmt(s2); }
            s2 = cssc::peek64(txAstNext + s2 * 8);
        }
    }
    #delete[go2];
    #delete[s2];
    txReleaseLocals(arity);                                 // free local strings on fall-through
    txReqWriteBack();                                       // renamed `#req` -> globals
    // mirror epilogue: return  mirrorSet ? (retIsRef ? [retAddr] : retVal) : 0.
    if (usesMir == 1) {
        txCirSlotLoad(txMirSetSlot) msF;
        txNewLabel() haveMir; txNewLabel() noMir;
        txCirBrz(msF, noMir);                              // never mirrored -> default 0
        // mirrored: pick live-ref vs snapshot
        txCirSlotLoad(txMirRefSlot) rfF;
        txNewLabel() useRef; txNewLabel() emitRet;
        txCirBrz(rfF, useRef);                             // rf==0 -> snapshot; skip to it below
        // rf != 0 -> live ref: return [retAddr]
        txCirSlotLoad(txMirAddrSlot) adF;
        txCirLoadInd(adF) refv;
        txCirRet(refv);
        txCirBr(emitRet);
        #delete[refv];
        #delete[adF];
        txCirLabel(useRef);                                // snapshot value
        txCirSlotLoad(txMirValSlot) vF;
        txCirRet(vF);
        txCirLabel(emitRet);
        #delete[vF];
        txCirLabel(noMir);
        txCirRet(0 - 1);                                   // default 0
        #delete[rfF];
        #delete[msF];
        #delete[emitRet];
        #delete[useRef];
        #delete[haveMir];
        #delete[noMir];
    }
    if (usesMir == 0) { txCirRet(0 - 1); }                 // default 0 / trailing RET
    #delete[usesMir];
    txFuncEnd(funcIdx);
    #delete[arity];
    #delete[body];
    #delete[astNode];
}

// ---- M9: object registry helpers (all keyed by name text, via txSpanEq) ----
#stack[int, 64] txObjFind;
#define(txObjFind) {
    #scanp(txObjFind, int, 0) off;
    #scanp(txObjFind, int, 1) len;
    #req[txObjNameOff] txObjNameOff;
    #req[txObjNameLen] txObjNameLen;
    #req[txObjCount] txObjCount;
    #req[txSpanEq] txSpanEq;
    #stack[int, 64] i = 0;
    #stack[int, 64] r = 0 - 1;
    while (i < txObjCount) {
        txSpanEq(off, len, cssc::peek64(txObjNameOff + i * 8), cssc::peek64(txObjNameLen + i * 8)) eq;
        if (eq == 1) { r = i; }
        #delete[eq];
        i = i + 1;
    }
    #delete[i];
    return r;
}
// member table index for (objId, member text), or -1.
#stack[int, 64] txMemFind;
#define(txMemFind) {
    #scanp(txMemFind, int, 0) objId;
    #scanp(txMemFind, int, 1) off;
    #scanp(txMemFind, int, 2) len;
    #req[txMemObj] txMemObj;
    #req[txMemOff] txMemOff;
    #req[txMemLen] txMemLen;
    #req[txMemCount] txMemCount;
    #req[txSpanEq] txSpanEq;
    #stack[int, 64] i = 0;
    #stack[int, 64] r = 0 - 1;
    while (i < txMemCount) {
        if (cssc::peek64(txMemObj + i * 8) == objId) {
            txSpanEq(off, len, cssc::peek64(txMemOff + i * 8), cssc::peek64(txMemLen + i * 8)) eq;
            if (eq == 1) { r = i; }
            #delete[eq];
        }
        i = i + 1;
    }
    #delete[i];
    return r;
}
// label function index for (objId, label text), or -1.
#stack[int, 64] txLabFindFn;
#define(txLabFindFn) {
    #scanp(txLabFindFn, int, 0) objId;
    #scanp(txLabFindFn, int, 1) off;
    #scanp(txLabFindFn, int, 2) len;
    #req[txLabObj] txLabObj;
    #req[txLabOff] txLabOff;
    #req[txLabLen] txLabLen;
    #req[txLabFn] txLabFn;
    #req[txLabCount] txLabCount;
    #req[txSpanEq] txSpanEq;
    #stack[int, 64] i = 0;
    #stack[int, 64] r = 0 - 1;
    while (i < txLabCount) {
        if (cssc::peek64(txLabObj + i * 8) == objId) {
            txSpanEq(off, len, cssc::peek64(txLabOff + i * 8), cssc::peek64(txLabLen + i * 8)) eq;
            if (eq == 1) { r = cssc::peek64(txLabFn + i * 8); }
            #delete[eq];
        }
        i = i + 1;
    }
    #delete[i];
    return r;
}
// label function index by NAME across ALL objects (for a top-level `call lbl`,
// where there is no enclosing object). First match wins.
#stack[int, 64] txLabFindAnyFn;
#define(txLabFindAnyFn) {
    #scanp(txLabFindAnyFn, int, 0) off;
    #scanp(txLabFindAnyFn, int, 1) len;
    #req[txLabOff] txLabOff;
    #req[txLabLen] txLabLen;
    #req[txLabFn] txLabFn;
    #req[txLabCount] txLabCount;
    #req[txSpanEq] txSpanEq;
    #stack[int, 64] i = 0;
    #stack[int, 64] r = 0 - 1;
    while (i < txLabCount) {
        txSpanEq(off, len, cssc::peek64(txLabOff + i * 8), cssc::peek64(txLabLen + i * 8)) eq;
        if (eq == 1) { if (r < 0) { r = cssc::peek64(txLabFn + i * 8); } }
        #delete[eq];
        i = i + 1;
    }
    #delete[i];
    return r;
}

// instance var text -> objId, or -1.
#stack[int, 64] txInstFind;
#define(txInstFind) {
    #scanp(txInstFind, int, 0) off;
    #scanp(txInstFind, int, 1) len;
    #req[txInstOff] txInstOff;
    #req[txInstLen] txInstLen;
    #req[txInstObj] txInstObj;
    #req[txInstCount] txInstCount;
    #req[txSpanEq] txSpanEq;
    #stack[int, 64] i = 0;
    #stack[int, 64] r = 0 - 1;
    while (i < txInstCount) {
        txSpanEq(off, len, cssc::peek64(txInstOff + i * 8), cssc::peek64(txInstLen + i * 8)) eq;
        if (eq == 1) { r = cssc::peek64(txInstObj + i * 8); }
        #delete[eq];
        i = i + 1;
    }
    #delete[i];
    return r;
}
// resolve an ARROW's object expr (AST node) to an objId: either an object TYPE
// name or an instance var. Returns -1 if not an object.
#stack[int, 64] txArrowObj;
#define(txArrowObj) {
    #scanp(txArrowObj, int, 0) objExpr;
    #req[txAstKind] txAstKind;
    #req[txAstOff] txAstOff;
    #req[txAstLen] txAstLen;
    #req[txObjFind] txObjFind;
    #req[txInstFind] txInstFind;
    #stack[int, 64] r = 0 - 1;
    if (cssc::peek64(txAstKind + objExpr * 8) == 5) {   // IDENT
        #stack[int, 64] o = cssc::peek64(txAstOff + objExpr * 8);
        #stack[int, 64] l = cssc::peek64(txAstLen + objExpr * 8);
        txInstFind(o, l) inst;
        if (inst >= 0) { r = inst; }
        if (inst < 0) { txObjFind(o, l) ty; if (ty >= 0) { r = ty; } #delete[ty]; }
        #delete[inst];
        #delete[l];
        #delete[o];
    }
    return r;
}

// The BLOCK-pointer SSA for `objExpr->member`. An INSTANCE variable holds its
// block pointer in its own slot; the bare TYPE name inside a method body means
// "this" == slot 0 (the implicit first parameter). Emits the load and returns
// the SSA, or -1 when the object does not resolve to a block.
#stack[int, 64] txMemBlock;
#define(txMemBlock) {
    #scanp(txMemBlock, int, 0) objExpr;
    #req[txAstKind] txAstKind;
    #req[txAstOff] txAstOff;
    #req[txAstLen] txAstLen;
    #req[txInstFind] txInstFind;
    #req[txSymFind] txSymFind;
    #req[txObjFind] txObjFind;
    #req[txCurObj] txCurObj;
    #req[txCirSlotLoad] txCirSlotLoad;
    #stack[int, 64] r = 0 - 1;
    if (cssc::peek64(txAstKind + objExpr * 8) == 5) {   // IDENT
        #stack[int, 64] o = cssc::peek64(txAstOff + objExpr * 8);
        #stack[int, 64] l = cssc::peek64(txAstLen + objExpr * 8);
        txInstFind(o, l) inst;
        if (inst >= 0) {                                 // instance var -> block ptr in its slot
            txSymFind(o, l) slot;
            if (slot >= 0) { txCirSlotLoad(slot) bp; r = bp; #delete[bp]; }
            #delete[slot];
        }
        if (inst < 0) {                                  // bare TYPE name inside a method -> "this" (slot 0)
            if (txCurObj >= 0) {
                txObjFind(o, l) ty;
                if (ty >= 0) { txCirSlotLoad(0) bp2; r = bp2; #delete[bp2]; }
                #delete[ty];
            }
        }
        #delete[inst];
        #delete[l];
        #delete[o];
    }
    return r;
}

// ---- Sector registry helpers (keyed by name spans, like the object tables) ----
// index of `::` within a span [off, off+len), or -1. A folded namespace name
// (`Sector::member`, `alias::member`) is ONE ident token; splitting it here
// yields the prefix [off, i) and member [off+i+2, len-i-2).
#stack[int, 64] txNsColon;
#define(txNsColon) {
    #scanp(txNsColon, int, 0) off;
    #scanp(txNsColon, int, 1) len;
    #req[txSrc] txSrc;
    #stack[int, 64] i = 0;
    #stack[int, 64] r = 0 - 1;
    while (i < len) {
        if (r < 0) {
            if (cssc::peek8(txSrc + off + i) == 58) {         // ':'
                if (i + 1 < len) {
                    if (cssc::peek8(txSrc + off + i + 1) == 58) { r = i; }
                }
            }
        }
        i = i + 1;
    }
    #delete[i];
    return r;
}

// resolve a sector NAME span -> sectorId, or -1. Checks the sector registry
// first, then `#req[sector] alias` bindings (S14).
#stack[int, 64] txSecFind;
#define(txSecFind) {
    #scanp(txSecFind, int, 0) off;
    #scanp(txSecFind, int, 1) len;
    #req[txSecNameOff] txSecNameOff;
    #req[txSecNameLen] txSecNameLen;
    #req[txSecCount] txSecCount;
    #req[txSecAliOff] txSecAliOff;
    #req[txSecAliLen] txSecAliLen;
    #req[txSecAliSec] txSecAliSec;
    #req[txSecAliCount] txSecAliCount;
    #req[txSpanEq] txSpanEq;
    #stack[int, 64] r = 0 - 1;
    #stack[int, 64] i = 0;
    while (i < txSecCount) {
        txSpanEq(off, len, cssc::peek64(txSecNameOff + i * 8), cssc::peek64(txSecNameLen + i * 8)) eq;
        if (eq == 1) { r = i; }
        #delete[eq];
        i = i + 1;
    }
    #delete[i];
    if (r < 0) {
        #stack[int, 64] j = 0;
        while (j < txSecAliCount) {
            txSpanEq(off, len, cssc::peek64(txSecAliOff + j * 8), cssc::peek64(txSecAliLen + j * 8)) eq2;
            if (eq2 == 1) { r = cssc::peek64(txSecAliSec + j * 8); }
            #delete[eq2];
            j = j + 1;
        }
        #delete[j];
    }
    return r;
}

// member-var table index for (secId, name span), or -1.
#stack[int, 64] txSVarFind;
#define(txSVarFind) {
    #scanp(txSVarFind, int, 0) secId;
    #scanp(txSVarFind, int, 1) off;
    #scanp(txSVarFind, int, 2) len;
    #req[txSVarSec] txSVarSec;
    #req[txSVarOff] txSVarOff;
    #req[txSVarLen] txSVarLen;
    #req[txSVarCount] txSVarCount;
    #req[txSpanEq] txSpanEq;
    #stack[int, 64] i = 0;
    #stack[int, 64] r = 0 - 1;
    while (i < txSVarCount) {
        if (cssc::peek64(txSVarSec + i * 8) == secId) {
            txSpanEq(off, len, cssc::peek64(txSVarOff + i * 8), cssc::peek64(txSVarLen + i * 8)) eq;
            if (eq == 1) { r = i; }
            #delete[eq];
        }
        i = i + 1;
    }
    #delete[i];
    return r;
}

// member-fn func index for (secId, name span), or -1.
#stack[int, 64] txSFnFind;
#define(txSFnFind) {
    #scanp(txSFnFind, int, 0) secId;
    #scanp(txSFnFind, int, 1) off;
    #scanp(txSFnFind, int, 2) len;
    #req[txSFnSec] txSFnSec;
    #req[txSFnOff] txSFnOff;
    #req[txSFnLen] txSFnLen;
    #req[txSFnIdx] txSFnIdx;
    #req[txSFnCount] txSFnCount;
    #req[txSpanEq] txSpanEq;
    #stack[int, 64] i = 0;
    #stack[int, 64] r = 0 - 1;
    while (i < txSFnCount) {
        if (cssc::peek64(txSFnSec + i * 8) == secId) {
            txSpanEq(off, len, cssc::peek64(txSFnOff + i * 8), cssc::peek64(txSFnLen + i * 8)) eq;
            if (eq == 1) { r = cssc::peek64(txSFnIdx + i * 8); }
            #delete[eq];
        }
        i = i + 1;
    }
    #delete[i];
    return r;
}

// is the name span a `Sector::member` read of a PRIVATE member from OUTSIDE that
// sector? Such a read is hidden -> reads 0x0 (S13). Returns 1 if hidden, else 0.
#stack[int, 64] txSecMemHidden;
#define(txSecMemHidden) {
    #scanp(txSecMemHidden, int, 0) off;
    #scanp(txSecMemHidden, int, 1) len;
    #req[txNsColon] txNsColon;
    #req[txSecFind] txSecFind;
    #req[txSVarFind] txSVarFind;
    #req[txSVarPub] txSVarPub;
    #req[txCurSector] txCurSector;
    #stack[int, 64] r = 0;
    txNsColon(off, len) cp;
    if (cp >= 0) {
        txSecFind(off, cp) sec;
        if (sec >= 0) {
            txSVarFind(sec, off + cp + 2, len - cp - 2) vi;
            if (vi >= 0) {
                if (cssc::peek64(txSVarPub + vi * 8) == 0) {   // private member
                    if (txCurSector != sec) { r = 1; }         // ... accessed from outside
                }
            }
            #delete[vi];
        }
        #delete[sec];
    }
    #delete[cp];
    return r;
}

// register a `#req[sector] alias;` binding: alias name span -> sectorId (S14).
#stack[int, 64] txSecAliAdd;
#define(txSecAliAdd) {
    #scanp(txSecAliAdd, int, 0) off;
    #scanp(txSecAliAdd, int, 1) len;
    #scanp(txSecAliAdd, int, 2) secId;
    #req[txSecAliOff] txSecAliOff;
    #req[txSecAliLen] txSecAliLen;
    #req[txSecAliSec] txSecAliSec;
    #req[txSecAliCount] txSecAliCount;
    #stack[int, 64] i = txSecAliCount;
    txSecAliCount = txSecAliCount + 1;
    cssc::poke64(txSecAliOff + i * 8, off);
    cssc::poke64(txSecAliLen + i * 8, len);
    cssc::poke64(txSecAliSec + i * 8, secId);
    #delete[i];
}

// register a FLAT (`transparent`) module alias -- a `#load`/`#include` whose
// module is not a sector. `txLoadModules` concatenated its top-level #defines
// into the shared function namespace, so `alias::member` is resolved by
// STRIPPING the alias and looking the bare `member` up as a top-level function
// or global (matches the reference native's transparent `_DEFINES` model).
#stack[int, 64] txModFlatAdd;
#define(txModFlatAdd) {
    #scanp(txModFlatAdd, int, 0) off;
    #scanp(txModFlatAdd, int, 1) len;
    #req[txModFlatOff] txModFlatOff;
    #req[txModFlatLen] txModFlatLen;
    #req[txModFlatCount] txModFlatCount;
    #stack[int, 64] i = txModFlatCount;
    txModFlatCount = txModFlatCount + 1;
    cssc::poke64(txModFlatOff + i * 8, off);
    cssc::poke64(txModFlatLen + i * 8, len);
    #delete[i];
}

// is the name span a registered FLAT module alias? 1 = yes, 0 = no.
#stack[int, 64] txModFlatHas;
#define(txModFlatHas) {
    #scanp(txModFlatHas, int, 0) off;
    #scanp(txModFlatHas, int, 1) len;
    #req[txModFlatOff] txModFlatOff;
    #req[txModFlatLen] txModFlatLen;
    #req[txModFlatCount] txModFlatCount;
    #req[txSpanEq] txSpanEq;
    #stack[int, 64] r = 0;
    #stack[int, 64] i = 0;
    while (i < txModFlatCount) {
        txSpanEq(off, len, cssc::peek64(txModFlatOff + i * 8), cssc::peek64(txModFlatLen + i * 8)) eq;
        if (eq == 1) { r = 1; }
        #delete[eq];
        i = i + 1;
    }
    #delete[i];
    return r;
}

// register a built-in-module alias (`#include('cssc.math')`, `#include('sizes')`,
// ...) with its KIND, so `alias::member` is resolved by the compiler (rtsym /
// constant) instead of a sector or module file.
#stack[int, 64] txBiModAdd;
#define(txBiModAdd) {
    #scanp(txBiModAdd, int, 0) off;
    #scanp(txBiModAdd, int, 1) len;
    #scanp(txBiModAdd, int, 2) kind;
    #req[txBiModOff] txBiModOff;
    #req[txBiModLen] txBiModLen;
    #req[txBiModK] txBiModK;
    #req[txBiModCount] txBiModCount;
    #stack[int, 64] i = txBiModCount;
    txBiModCount = txBiModCount + 1;
    cssc::poke64(txBiModOff + i * 8, off);
    cssc::poke64(txBiModLen + i * 8, len);
    cssc::poke64(txBiModK + i * 8, kind);
    #delete[i];
}

// the kind of a registered built-in-module alias span (0 = not one).
#stack[int, 64] txBiModKind;
#define(txBiModKind) {
    #scanp(txBiModKind, int, 0) off;
    #scanp(txBiModKind, int, 1) len;
    #req[txBiModOff] txBiModOff;
    #req[txBiModLen] txBiModLen;
    #req[txBiModK] txBiModK;
    #req[txBiModCount] txBiModCount;
    #req[txSpanEq] txSpanEq;
    #stack[int, 64] r = 0;
    #stack[int, 64] i = 0;
    while (i < txBiModCount) {
        txSpanEq(off, len, cssc::peek64(txBiModOff + i * 8), cssc::peek64(txBiModLen + i * 8)) eq;
        if (eq == 1) { r = cssc::peek64(txBiModK + i * 8); }
        #delete[eq];
        i = i + 1;
    }
    #delete[i];
    return r;
}

// register ONE object (its type, member globals, init/free/label functions) and
// tag it with `secId` (the owning sector, or -1 for top level). Shared by the
// top-level walk and the sector collector so nested objects register identically.
#stack[int, 64] txRegisterObject;
#define(txRegisterObject) {
    #scanp(txRegisterObject, int, 0) s;
    #scanp(txRegisterObject, int, 1) secId;
    #req[txAstA] txAstA;
    #req[txAstB] txAstB;
    #req[txAstC] txAstC;
    #req[txAstNum] txAstNum;
    #req[txAstNext] txAstNext;
    #req[txAstKind] txAstKind;
    #req[txAstOff] txAstOff;
    #req[txAstLen] txAstLen;
    #req[txObjNameOff] txObjNameOff;
    #req[txObjNameLen] txObjNameLen;
    #req[txObjInitFn] txObjInitFn;
    #req[txObjFreeFn] txObjFreeFn;
    #req[txObjCount] txObjCount;
    #req[txObjNode] txObjNode;
    #req[txObjSec] txObjSec;
    #req[txMemObj] txMemObj;
    #req[txMemOff] txMemOff;
    #req[txMemLen] txMemLen;
    #req[txMemGlob] txMemGlob;
    #req[txMemBlkOff] txMemBlkOff;
    #req[txObjSize] txObjSize;
    #req[txMemKind] txMemKind;
    #req[txMemElem] txMemElem;
    #req[txMemCount] txMemCount;
    #req[txLabObj] txLabObj;
    #req[txLabOff] txLabOff;
    #req[txLabLen] txLabLen;
    #req[txLabFn] txLabFn;
    #req[txLabCount] txLabCount;
    #req[txGlobAlloc] txGlobAlloc;
    #req[txFuncAdd] txFuncAdd;
    #stack[int, 64] objId = txObjCount;
    cssc::poke64(txObjNameOff + objId * 8, cssc::peek64(txAstOff + s * 8));
    cssc::poke64(txObjNameLen + objId * 8, cssc::peek64(txAstLen + s * 8));
    cssc::poke64(txObjNode + objId * 8, s);
    cssc::poke64(txObjSec + objId * 8, secId);
    txObjCount = txObjCount + 1;
    // member table: walk the init chain for member DECLs (B==1). Each member gets
    // a still-allocated global (legacy singleton scratch, kept harmless) AND a
    // per-instance BLOCK OFFSET -- object access goes through the block so two
    // instances (m9_twoinst) keep independent storage.
    #stack[int, 64] init = cssc::peek64(txAstB + s * 8);
    #stack[int, 64] blkOff = 0;
    #stack[int, 32] mgo = 1;
    while (mgo == 1) {
        if (init == 0) { mgo = 0; }
        if (mgo == 1) {
            if (cssc::peek64(txAstKind + init * 8) == 7) {
                if (cssc::peek64(txAstB + init * 8) == 1) {   // member decl
                    txGlobAlloc() g;
                    #stack[int, 64] mi = txMemCount;
                    txMemCount = txMemCount + 1;
                    cssc::poke64(txMemObj + mi * 8, objId);
                    cssc::poke64(txMemOff + mi * 8, cssc::peek64(txAstOff + init * 8));
                    cssc::poke64(txMemLen + mi * 8, cssc::peek64(txAstLen + init * 8));
                    cssc::poke64(txMemGlob + mi * 8, g);
                    cssc::poke64(txMemBlkOff + mi * 8, blkOff);
                    blkOff = blkOff + 8;
                    cssc::poke64(txMemKind + mi * 8, cssc::peek64(txAstNum + init * 8));
                    cssc::poke64(txMemElem + mi * 8, cssc::peek64(txAstC + init * 8));
                    #delete[mi];
                    #delete[g];
                }
            }
            init = cssc::peek64(txAstNext + init * 8);
        }
    }
    cssc::poke64(txObjSize + objId * 8, blkOff);
    #delete[blkOff];
    #delete[mgo];
    #delete[init];
    // init (ctor) function: astNode = the OBJECT node, body = B.
    txFuncAdd(0, 0, s) initFn;
    cssc::poke64(txObjInitFn + objId * 8, initFn);
    // free function: only if a free chain exists.
    #stack[int, 64] freeChain = cssc::peek64(txAstNum + s * 8);
    #stack[int, 64] freeFn = 0 - 1;
    if (freeChain != 0) { txFuncAdd(0, 0, s) ff; freeFn = ff; #delete[ff]; }
    cssc::poke64(txObjFreeFn + objId * 8, freeFn);
    // labels: register a function per LABELDEF.
    #stack[int, 64] lab = cssc::peek64(txAstC + s * 8);
    #stack[int, 32] lgo = 1;
    while (lgo == 1) {
        if (lab == 0) { lgo = 0; }
        if (lgo == 1) {
            txFuncAdd(0, 0, lab) lf;
            #stack[int, 64] li = txLabCount;
            txLabCount = txLabCount + 1;
            cssc::poke64(txLabObj + li * 8, objId);
            cssc::poke64(txLabOff + li * 8, cssc::peek64(txAstOff + lab * 8));
            cssc::poke64(txLabLen + li * 8, cssc::peek64(txAstLen + lab * 8));
            cssc::poke64(txLabFn + li * 8, lf);
            #delete[li];
            #delete[lf];
            lab = cssc::peek64(txAstNext + lab * 8);
        }
    }
    #delete[lgo];
    #delete[lab];
    #delete[freeFn];
    #delete[freeChain];
    #delete[initFn];
    #delete[objId];
}

// register every TOP-LEVEL object. Runs after txCollectFuncs so object functions
// get later indices. Sector-nested objects are registered by txCollectSectors.
#stack[int, 64] txCollectObjects;
#define(txCollectObjects) {
    #scanp(txCollectObjects, int, 0) prog;
    #req[txAstA] txAstA;
    #req[txAstNext] txAstNext;
    #req[txAstKind] txAstKind;
    #req[txRegisterObject] txRegisterObject;
    #stack[int, 64] s = cssc::peek64(txAstA + prog * 8);
    #stack[int, 32] go = 1;
    while (go == 1) {
        if (s == 0) { go = 0; }
        if (go == 1) {
            if (cssc::peek64(txAstKind + s * 8) == 34) { txRegisterObject(s, 0 - 1); }
            s = cssc::peek64(txAstNext + s * 8);
        }
    }
    #delete[go];
    #delete[s];
}

// lower ONE object function (init / free / label). bodyHead = the statement
// chain; paramHead = LBLPARAM chain (0 for init/free); objId = the owning object.
// Mirrors txLowerDefine's framing but takes explicit chains and sets txCurObj so
// `Obj->member` / `call label` inside resolve against this object.
#stack[int, 64] txLowerObjFn;
#define(txLowerObjFn) {
    #scanp(txLowerObjFn, int, 0) funcIdx;
    #scanp(txLowerObjFn, int, 1) bodyHead;
    #scanp(txLowerObjFn, int, 2) paramHead;
    #scanp(txLowerObjFn, int, 3) objId;
    #req[txAstA] txAstA;
    #req[txAstB] txAstB;
    #req[txAstC] txAstC;
    #req[txAstKind] txAstKind;
    #req[txAstNum] txAstNum;
    #req[txAstNext] txAstNext;
    #req[txAstOff] txAstOff;
    #req[txAstLen] txAstLen;
    #req[txFuncBegin] txFuncBegin;
    #req[txFuncEnd] txFuncEnd;
    #req[txFuncSetArity] txFuncSetArity;
    #req[txSymCount] txSymCount;
    #req[txAliasCount] txAliasCount;
    #req[txGAliasCount] txGAliasCount;
    #req[txNewSlot] txNewSlot;
    #req[txSymAdd] txSymAdd;
    #req[txCirSlotAlloc] txCirSlotAlloc;
    #req[txSlotSetStr] txSlotSetStr;
    #req[txSlotSetFloat] txSlotSetFloat;
    #req[txLowerStmt] txLowerStmt;
    #req[txCurFunc] txCurFunc;
    #req[txCurObj] txCurObj;
    #req[txCurSector] txCurSector;
    #req[txObjSec] txObjSec;
    #req[txSecAliCount] txSecAliCount;
    #req[txReleaseLocals] txReleaseLocals;
    #req[txCirRet] txCirRet;
    #req[txReqReset] txReqReset;
    #req[txReqWriteBack] txReqWriteBack;
    #req[txHasMirror] txHasMirror;
    #req[txMirUses] txMirUses;
    #req[txMirSetSlot] txMirSetSlot;
    #req[txMirValSlot] txMirValSlot;
    #req[txMirRefSlot] txMirRefSlot;
    #req[txMirAddrSlot] txMirAddrSlot;
    #req[txMirEscape] txMirEscape;
    #req[txCirSlotStore] txCirSlotStore;
    #req[txCirSlotLoad] txCirSlotLoad;
    #req[txCirConstInt] txCirConstInt;
    #req[txCirLoadInd] txCirLoadInd;
    #req[txNewLabel] txNewLabel;
    #req[txCirLabel] txCirLabel;
    #req[txCirBrz] txCirBrz;
    #req[txCirBr] txCirBr;
    txFuncBegin(funcIdx);
    txCurFunc = funcIdx;
    txCurObj = objId;
    // an object nested in a sector reaches that sector's member functions by bare
    // name (its `<fn>` genparam injections, e.g. `MenuSelection<print>`).
    txCurSector = cssc::peek64(txObjSec + objId * 8);
    txSymCount = 0;
    txAliasCount = 0;
    txGAliasCount = 0;
    txSecAliCount = 0;
    txReqReset();
    // slot 0 is the implicit "this": the caller passes the instance BLOCK pointer
    // as arg0 for EVERY object method (ctor / label / free). Member access inside
    // the body resolves against it (`this + memberOffset`). Real params follow at
    // slot 1+, so their arg indices and the frame layout shift by one.
    txNewSlot() thisSlot; txCirSlotAlloc(thisSlot); #delete[thisSlot];
    // params: allocate a slot per LBLPARAM (labels) or TYPED genparam (ctor),
    // register the name + type.
    #stack[int, 64] arity = 1;
    #stack[int, 64] p = paramHead;
    #stack[int, 32] pgo = 1;
    while (pgo == 1) {
        if (p == 0) { pgo = 0; }
        if (pgo == 1) {
            #stack[int, 32] pSkip = 0;
            // an UNTYPED object genparam (kind 35, C==0) is a scope injection, not
            // a ctor argument: no slot, no arity. LBLPARAMs (kind 37) and TYPED
            // genparams (kind 35, C==1) are real params.
            if (cssc::peek64(txAstKind + p * 8) == 35) {
                if (cssc::peek64(txAstC + p * 8) == 0) { pSkip = 1; }
            }
            if (pSkip == 0) {
                txNewSlot() sl;
                txSymAdd(cssc::peek64(txAstOff + p * 8), cssc::peek64(txAstLen + p * 8), sl);
                txCirSlotAlloc(sl);
                #stack[int, 64] tc = cssc::peek64(txAstNum + p * 8);   // decl-type code
                if (tc == 3) { txSlotSetStr(sl, 1); }                 // string
                if (tc == 2) { txSlotSetFloat(sl, 1); }               // float
                #delete[tc];
                #delete[sl];
                arity = arity + 1;
            }
            #delete[pSkip];
            p = cssc::peek64(txAstNext + p * 8);
        }
    }
    #delete[pgo];
    #delete[p];
    txFuncSetArity(funcIdx, arity);
    // mirror state (labels like `calc` mirror their result).
    txHasMirror(bodyHead) usesMir;
    txMirUses = usesMir;
    if (usesMir == 1) {
        txNewSlot() ms0; txMirSetSlot = ms0; txCirSlotAlloc(ms0); #delete[ms0];
        txNewSlot() mv0; txMirValSlot = mv0; txCirSlotAlloc(mv0); #delete[mv0];
        txNewSlot() mr0; txMirRefSlot = mr0; txCirSlotAlloc(mr0); #delete[mr0];
        txNewSlot() ma0; txMirAddrSlot = ma0; txCirSlotAlloc(ma0); #delete[ma0];
        txCirConstInt(0) z0; txCirSlotStore(txMirSetSlot, z0); #delete[z0];
    }
    // lower body, with per-top-level-stmt mirror escape labels when needed.
    #stack[int, 64] s2 = bodyHead;
    #stack[int, 32] go2 = 1;
    while (go2 == 1) {
        if (s2 == 0) { go2 = 0; }
        if (go2 == 1) {
            if (usesMir == 1) {
                txNewLabel() esc; txMirEscape = esc;
                txLowerStmt(s2);
                txCirLabel(esc);
                #delete[esc];
            }
            if (usesMir == 0) { txLowerStmt(s2); }
            s2 = cssc::peek64(txAstNext + s2 * 8);
        }
    }
    #delete[go2];
    #delete[s2];
    txReleaseLocals(arity);
    txReqWriteBack();
    if (usesMir == 1) {
        txCirSlotLoad(txMirSetSlot) msF;
        txNewLabel() noMir;
        txCirBrz(msF, noMir);
        txCirSlotLoad(txMirRefSlot) rfF;
        txNewLabel() useRef; txNewLabel() emitRet;
        txCirBrz(rfF, useRef);
        txCirSlotLoad(txMirAddrSlot) adF;
        txCirLoadInd(adF) refv;
        txCirRet(refv);
        txCirBr(emitRet);
        #delete[refv];
        #delete[adF];
        txCirLabel(useRef);
        txCirSlotLoad(txMirValSlot) vF;
        txCirRet(vF);
        txCirLabel(emitRet);
        #delete[vF];
        txCirLabel(noMir);
        txCirRet(0 - 1);
        #delete[rfF];
        #delete[msF];
        #delete[emitRet];
        #delete[useRef];
        #delete[noMir];
    }
    if (usesMir == 0) { txCirRet(0 - 1); }
    #delete[usesMir];
    txFuncEnd(funcIdx);
    txCurObj = 0 - 1;
    txCurSector = 0 - 1;
    #delete[arity];
}

// lower every object's init, free, and label functions. Iterates the object
// REGISTRY (not the AST) so sector-nested objects are covered too; each object's
// AST node is txObjNode[objId].
#stack[int, 64] txLowerObjects;
#define(txLowerObjects) {
    #scanp(txLowerObjects, int, 0) prog;
    #req[txAstB] txAstB;
    #req[txAstC] txAstC;
    #req[txAstNum] txAstNum;
    #req[txAstNext] txAstNext;
    #req[txAstOff] txAstOff;
    #req[txAstLen] txAstLen;
    #req[txAstA] txAstA;
    #req[txObjNode] txObjNode;
    #req[txObjCount] txObjCount;
    #req[txObjInitFn] txObjInitFn;
    #req[txObjFreeFn] txObjFreeFn;
    #req[txLowerObjFn] txLowerObjFn;
    #req[txLabFindFn] txLabFindFn;
    #stack[int, 64] objId = 0;
    while (objId < txObjCount) {
        #stack[int, 64] s = cssc::peek64(txObjNode + objId * 8);
        // init: body = B (init chain); params = the genparam chain (A). Only the
        // TYPED genparams (`<int: start>`) become real ctor arguments; untyped
        // `<fn>` scope injections are skipped inside txLowerObjFn.
        txLowerObjFn(cssc::peek64(txObjInitFn + objId * 8), cssc::peek64(txAstB + s * 8), cssc::peek64(txAstA + s * 8), objId);
        // free: body = Num (free chain), if present.
        #stack[int, 64] freeFn = cssc::peek64(txObjFreeFn + objId * 8);
        if (freeFn >= 0) { txLowerObjFn(freeFn, cssc::peek64(txAstNum + s * 8), 0, objId); }
        #delete[freeFn];
        // labels: each LABELDEF (Off/Len=name, A=params, B=body).
        #stack[int, 64] lab = cssc::peek64(txAstC + s * 8);
        #stack[int, 32] lgo = 1;
        while (lgo == 1) {
            if (lab == 0) { lgo = 0; }
            if (lgo == 1) {
                txLabFindFn(objId, cssc::peek64(txAstOff + lab * 8), cssc::peek64(txAstLen + lab * 8)) lfn;
                txLowerObjFn(lfn, cssc::peek64(txAstB + lab * 8), cssc::peek64(txAstA + lab * 8), objId);
                #delete[lfn];
                lab = cssc::peek64(txAstNext + lab * 8);
            }
        }
        #delete[lgo];
        #delete[lab];
        #delete[s];
        objId = objId + 1;
    }
    #delete[objId];
}

// ---- Sector collection & lowering ----------------------------------------
// register a sector body chain's member functions (anonymous, like object
// labels: not bare-callable from outside, S7) and its nested objects.
#stack[int, 64] txSecScanFns;
#define(txSecScanFns) {
    #scanp(txSecScanFns, int, 0) secId;
    #scanp(txSecScanFns, int, 1) head;
    #req[txAstKind] txAstKind;
    #req[txAstNext] txAstNext;
    #req[txAstOff] txAstOff;
    #req[txAstLen] txAstLen;
    #req[txFuncAdd] txFuncAdd;
    #req[txRegisterObject] txRegisterObject;
    #req[txSFnSec] txSFnSec;
    #req[txSFnOff] txSFnOff;
    #req[txSFnLen] txSFnLen;
    #req[txSFnIdx] txSFnIdx;
    #req[txSFnCount] txSFnCount;
    #stack[int, 64] s = head;
    #stack[int, 32] go = 1;
    while (go == 1) {
        if (s == 0) { go = 0; }
        if (go == 1) {
            #stack[int, 64] k = cssc::peek64(txAstKind + s * 8);
            if (k == 17) {                              // FUNC_DEF -> member fn (anon)
                txFuncAdd(0, 0, s) fi;
                #stack[int, 64] idx = txSFnCount;
                txSFnCount = txSFnCount + 1;
                cssc::poke64(txSFnSec + idx * 8, secId);
                cssc::poke64(txSFnOff + idx * 8, cssc::peek64(txAstOff + s * 8));
                cssc::poke64(txSFnLen + idx * 8, cssc::peek64(txAstLen + s * 8));
                cssc::poke64(txSFnIdx + idx * 8, fi);
                #delete[idx];
                #delete[fi];
            }
            if (k == 34) { txRegisterObject(s, secId); }   // nested object
            #delete[k];
            s = cssc::peek64(txAstNext + s * 8);
        }
    }
    #delete[go];
    #delete[s];
}

// register a sector body chain's member-variable globals. Runs AFTER txSecScanFns
// so a `#stack[int,N] name;` that is really a `#define(name)` placeholder (S8) is
// recognised as a function and skipped -- it never becomes a member variable.
#stack[int, 64] txSecScanVars;
#define(txSecScanVars) {
    #scanp(txSecScanVars, int, 0) secId;
    #scanp(txSecScanVars, int, 1) head;
    #scanp(txSecScanVars, int, 2) isPub;
    #req[txAstKind] txAstKind;
    #req[txAstNext] txAstNext;
    #req[txAstNum] txAstNum;
    #req[txAstC] txAstC;
    #req[txAstOff] txAstOff;
    #req[txAstLen] txAstLen;
    #req[txSFnFind] txSFnFind;
    #req[txGlobAlloc] txGlobAlloc;
    #req[txSVarSec] txSVarSec;
    #req[txSVarOff] txSVarOff;
    #req[txSVarLen] txSVarLen;
    #req[txSVarGlob] txSVarGlob;
    #req[txSVarKind] txSVarKind;
    #req[txSVarElem] txSVarElem;
    #req[txSVarPub] txSVarPub;
    #req[txSVarCount] txSVarCount;
    #stack[int, 64] s = head;
    #stack[int, 32] go = 1;
    while (go == 1) {
        if (s == 0) { go = 0; }
        if (go == 1) {
            if (cssc::peek64(txAstKind + s * 8) == 7) {    // DECL
                #stack[int, 64] nOff = cssc::peek64(txAstOff + s * 8);
                #stack[int, 64] nLen = cssc::peek64(txAstLen + s * 8);
                txSFnFind(secId, nOff, nLen) isFn;
                if (isFn < 0) {
                    txGlobAlloc() g;
                    #stack[int, 64] idx = txSVarCount;
                    txSVarCount = txSVarCount + 1;
                    cssc::poke64(txSVarSec + idx * 8, secId);
                    cssc::poke64(txSVarOff + idx * 8, nOff);
                    cssc::poke64(txSVarLen + idx * 8, nLen);
                    cssc::poke64(txSVarGlob + idx * 8, g);
                    cssc::poke64(txSVarKind + idx * 8, cssc::peek64(txAstNum + s * 8));
                    cssc::poke64(txSVarElem + idx * 8, cssc::peek64(txAstC + s * 8));
                    cssc::poke64(txSVarPub + idx * 8, isPub);
                    #delete[idx];
                    #delete[g];
                }
                #delete[isFn];
                #delete[nLen];
                #delete[nOff];
            }
            s = cssc::peek64(txAstNext + s * 8);
        }
    }
    #delete[go];
    #delete[s];
}

// register every sector: its name, member fns, member vars, nested objects and a
// synthesized free function. Runs after txCollectObjects so its indices follow.
#stack[int, 64] txCollectSectors;
#define(txCollectSectors) {
    #scanp(txCollectSectors, int, 0) prog;
    #req[txAstA] txAstA;
    #req[txAstB] txAstB;
    #req[txAstC] txAstC;
    #req[txAstNum] txAstNum;
    #req[txAstNext] txAstNext;
    #req[txAstKind] txAstKind;
    #req[txAstOff] txAstOff;
    #req[txAstLen] txAstLen;
    #req[txSecNameOff] txSecNameOff;
    #req[txSecNameLen] txSecNameLen;
    #req[txSecFreeFn] txSecFreeFn;
    #req[txSecCount] txSecCount;
    #req[txSecScanFns] txSecScanFns;
    #req[txSecScanVars] txSecScanVars;
    #req[txFuncAdd] txFuncAdd;
    #stack[int, 64] s = cssc::peek64(txAstA + prog * 8);
    #stack[int, 32] go = 1;
    while (go == 1) {
        if (s == 0) { go = 0; }
        if (go == 1) {
            if (cssc::peek64(txAstKind + s * 8) == 41) {   // SECTOR
                #stack[int, 64] secId = txSecCount;
                cssc::poke64(txSecNameOff + secId * 8, cssc::peek64(txAstOff + s * 8));
                cssc::poke64(txSecNameLen + secId * 8, cssc::peek64(txAstLen + s * 8));
                txSecCount = txSecCount + 1;
                #stack[int, 64] priv = cssc::peek64(txAstB + s * 8);
                #stack[int, 64] pub = cssc::peek64(txAstC + s * 8);
                txSecScanFns(secId, priv);
                txSecScanFns(secId, pub);
                txSecScanVars(secId, priv, 0);
                txSecScanVars(secId, pub, 1);
                #stack[int, 64] freeChain = cssc::peek64(txAstNum + s * 8);
                #stack[int, 64] freeFn = 0 - 1;
                if (freeChain != 0) { txFuncAdd(0, 0, s) ff; freeFn = ff; #delete[ff]; }
                cssc::poke64(txSecFreeFn + secId * 8, freeFn);
                #delete[freeFn];
                #delete[freeChain];
                #delete[pub];
                #delete[priv];
                #delete[secId];
            }
            s = cssc::peek64(txAstNext + s * 8);
        }
    }
    #delete[go];
    #delete[s];
}

// register every member variable of `secId` as a GAlias -> its global, and stamp
// the global's string/float type. Used where members are reachable BY BARE NAME:
// construction (S11) and the free block.
#stack[int, 64] txSecRegAliases;
#define(txSecRegAliases) {
    #scanp(txSecRegAliases, int, 0) secId;
    #req[txSVarSec] txSVarSec;
    #req[txSVarOff] txSVarOff;
    #req[txSVarLen] txSVarLen;
    #req[txSVarGlob] txSVarGlob;
    #req[txSVarKind] txSVarKind;
    #req[txSVarCount] txSVarCount;
    #req[txGAliasAdd] txGAliasAdd;
    #req[txGlobSetStr] txGlobSetStr;
    #req[txGlobSetFloat] txGlobSetFloat;
    #stack[int, 64] i = 0;
    while (i < txSVarCount) {
        if (cssc::peek64(txSVarSec + i * 8) == secId) {
            #stack[int, 64] g = cssc::peek64(txSVarGlob + i * 8);
            txGAliasAdd(cssc::peek64(txSVarOff + i * 8), cssc::peek64(txSVarLen + i * 8), g);
            #stack[int, 64] mk = cssc::peek64(txSVarKind + i * 8);
            if (mk == 1) { txGlobSetStr(g, 1); }
            if (mk == 2) { txGlobSetFloat(g, 1); }
            #delete[mk];
            #delete[g];
        }
        i = i + 1;
    }
    #delete[i];
}

// construct a sector at its position in main: run each member-variable DECL's
// initialiser into its global and lower every other body statement in sector
// scope (members bare-visible). Functions and objects are lowered separately.
#stack[int, 64] txConstructSector;
#define(txConstructSector) {
    #scanp(txConstructSector, int, 0) sec;
    #scanp(txConstructSector, int, 1) secId;
    #req[txAstA] txAstA;
    #req[txAstB] txAstB;
    #req[txAstC] txAstC;
    #req[txAstNum] txAstNum;
    #req[txAstKind] txAstKind;
    #req[txAstNext] txAstNext;
    #req[txAstOff] txAstOff;
    #req[txAstLen] txAstLen;
    #req[txGAliasCount] txGAliasCount;
    #req[txSecRegAliases] txSecRegAliases;
    #req[txCurSector] txCurSector;
    #req[txCurSecCtor] txCurSecCtor;
    #req[txSVarFind] txSVarFind;
    #req[txSVarGlob] txSVarGlob;
    #req[txLowerExpr] txLowerExpr;
    #req[txLowerStmt] txLowerStmt;
    #req[txGlobSetStr] txGlobSetStr;
    #req[txGlobSetFloat] txGlobSetFloat;
    #req[txReleaseGlobOld] txReleaseGlobOld;
    #req[txCirGlobStore] txCirGlobStore;
    #req[txContainerTake] txContainerTake;
    #req[txReleaseTemps] txReleaseTemps;
    #req[txSsaNext] txSsaNext;
    #req[txCirConstStr] txCirConstStr;
    #req[txCirConstInt] txCirConstInt;
    #req[txCirCallR] txCirCallR;
    #req[txSetStr] txSetStr;
    #req[txSetOwned] txSetOwned;
    #stack[int, 64] gac0 = txGAliasCount;
    txSecRegAliases(secId);
    #stack[int, 64] savedSec = txCurSector;
    #stack[int, 64] savedCtor = txCurSecCtor;
    txCurSector = secId;
    txCurSecCtor = 1;
    #stack[int, 64] chain = cssc::peek64(txAstB + sec * 8);
    #stack[int, 32] phase = 0;                              // 0 private, 1 public
    #stack[int, 32] allgo = 1;
    while (allgo == 1) {
        if (chain == 0) {
            if (phase == 0) { phase = 1; chain = cssc::peek64(txAstC + sec * 8); }
            if (phase == 1) { if (chain == 0) { allgo = 0; } }
        }
        if (allgo == 1) { if (chain != 0) {
            #stack[int, 64] k = cssc::peek64(txAstKind + chain * 8);
            #stack[int, 32] skip = 0;
            if (k == 17) { skip = 1; }                      // FUNC_DEF
            if (k == 34) { skip = 1; }                      // OBJECT
            if (k == 7) {                                   // member var DECL
                skip = 1;
                #stack[int, 64] nOff = cssc::peek64(txAstOff + chain * 8);
                #stack[int, 64] nLen = cssc::peek64(txAstLen + chain * 8);
                txSVarFind(secId, nOff, nLen) svi;
                if (svi >= 0) {
                    #stack[int, 64] g = cssc::peek64(txSVarGlob + svi * 8);
                    #stack[int, 64] dnum = cssc::peek64(txAstNum + chain * 8);
                    if (dnum == 1) { txGlobSetStr(g, 1); }
                    if (dnum == 2) { txGlobSetFloat(g, 1); }
                    #stack[int, 64] init = cssc::peek64(txAstA + chain * 8);
                    #stack[int, 64] ssa0 = txSsaNext;
                    if (init != 0) {
                        txLowerExpr(init) mv;
                        txReleaseGlobOld(g);
                        txCirGlobStore(g, mv);
                        txContainerTake(mv);
                        #delete[mv];
                    }
                    if (init == 0) {                        // empty container / "" string
                        if (dnum == 1) {
                            txCirConstStr(0, 0) es; txCirConstInt(0) el;
                            txCirCallR(3, es, el) esh;
                            txSetStr(esh); txSetOwned(esh);
                            txReleaseGlobOld(g);
                            txCirGlobStore(g, esh); txContainerTake(esh);
                            #delete[esh]; #delete[el]; #delete[es];
                        }
                        #stack[int, 64] ctr = 0;
                        if (dnum == 3) { ctr = 1; }
                        if (dnum == 5) { ctr = 1; }
                        if (dnum == 4) { ctr = 2; }
                        if (ctr != 0) {
                            txCirConstInt(8) cc;
                            #stack[int, 64] ns = 22;
                            if (ctr == 2) { ns = 27; }
                            txCirCallR(ns, cc, 0 - 1) cn;
                            txReleaseGlobOld(g);
                            txCirGlobStore(g, cn);
                            #delete[cn]; #delete[ns]; #delete[cc];
                        }
                        #delete[ctr];
                    }
                    txReleaseTemps(ssa0);
                    #delete[ssa0];
                    #delete[init];
                    #delete[dnum];
                    #delete[g];
                }
                #delete[svi];
                #delete[nLen];
                #delete[nOff];
            }
            if (skip == 0) { txLowerStmt(chain); }
            #delete[skip];
            #delete[k];
            chain = cssc::peek64(txAstNext + chain * 8);
        } }
    }
    #delete[allgo];
    #delete[phase];
    #delete[chain];
    txCurSector = savedSec;
    txCurSecCtor = savedCtor;
    txGAliasCount = gac0;
    #delete[savedCtor];
    #delete[savedSec];
    #delete[gac0];
}

// lower a sector's free { } block as a zero-arg function. Members are reachable by
// bare name (S11), so `#delete[member]` releases the member global.
#stack[int, 64] txLowerSecFree;
#define(txLowerSecFree) {
    #scanp(txLowerSecFree, int, 0) funcIdx;
    #scanp(txLowerSecFree, int, 1) body;
    #scanp(txLowerSecFree, int, 2) secId;
    #req[txAstNext] txAstNext;
    #req[txFuncBegin] txFuncBegin;
    #req[txFuncEnd] txFuncEnd;
    #req[txFuncSetArity] txFuncSetArity;
    #req[txSymCount] txSymCount;
    #req[txAliasCount] txAliasCount;
    #req[txGAliasCount] txGAliasCount;
    #req[txSecAliCount] txSecAliCount;
    #req[txReqReset] txReqReset;
    #req[txSecRegAliases] txSecRegAliases;
    #req[txCurFunc] txCurFunc;
    #req[txCurSector] txCurSector;
    #req[txCurSecCtor] txCurSecCtor;
    #req[txLowerStmt] txLowerStmt;
    #req[txReleaseLocals] txReleaseLocals;
    #req[txCirRet] txCirRet;
    txFuncBegin(funcIdx);
    txCurFunc = funcIdx;
    txSymCount = 0;
    txAliasCount = 0;
    txGAliasCount = 0;
    txSecAliCount = 0;
    txReqReset();
    txFuncSetArity(funcIdx, 0);
    txSecRegAliases(secId);
    txCurSector = secId;
    txCurSecCtor = 1;
    #stack[int, 64] s = body;
    #stack[int, 32] go = 1;
    while (go == 1) {
        if (s == 0) { go = 0; }
        if (go == 1) { txLowerStmt(s); s = cssc::peek64(txAstNext + s * 8); }
    }
    #delete[go];
    #delete[s];
    txReleaseLocals(0);
    txCurSector = 0 - 1;
    txCurSecCtor = 0;
    txCirRet(0 - 1);
    txFuncEnd(funcIdx);
}

// lower every sector's member functions (as #defines with sector context) and its
// free block. Nested objects are handled by txLowerObjects (registry iteration).
#stack[int, 64] txLowerSectors;
#define(txLowerSectors) {
    #scanp(txLowerSectors, int, 0) prog;
    #req[txAstA] txAstA;
    #req[txAstB] txAstB;
    #req[txAstC] txAstC;
    #req[txAstNum] txAstNum;
    #req[txAstNext] txAstNext;
    #req[txAstKind] txAstKind;
    #req[txAstOff] txAstOff;
    #req[txAstLen] txAstLen;
    #req[txSecFind] txSecFind;
    #req[txSFnFind] txSFnFind;
    #req[txSecFreeFn] txSecFreeFn;
    #req[txLowerDefine] txLowerDefine;
    #req[txLowerSecFree] txLowerSecFree;
    #req[txCurSector] txCurSector;
    #req[txCurSecCtor] txCurSecCtor;
    #stack[int, 64] s = cssc::peek64(txAstA + prog * 8);
    #stack[int, 32] go = 1;
    while (go == 1) {
        if (s == 0) { go = 0; }
        if (go == 1) {
            if (cssc::peek64(txAstKind + s * 8) == 41) {   // SECTOR
                txSecFind(cssc::peek64(txAstOff + s * 8), cssc::peek64(txAstLen + s * 8)) secId;
                #stack[int, 64] chain = cssc::peek64(txAstB + s * 8);
                #stack[int, 32] phase = 0;
                #stack[int, 32] allgo = 1;
                while (allgo == 1) {
                    if (chain == 0) {
                        if (phase == 0) { phase = 1; chain = cssc::peek64(txAstC + s * 8); }
                        if (phase == 1) { if (chain == 0) { allgo = 0; } }
                    }
                    if (allgo == 1) { if (chain != 0) {
                        if (cssc::peek64(txAstKind + chain * 8) == 17) {   // FUNC_DEF
                            txSFnFind(secId, cssc::peek64(txAstOff + chain * 8), cssc::peek64(txAstLen + chain * 8)) fi;
                            if (fi >= 0) {
                                txCurSector = secId;
                                txCurSecCtor = 0;
                                txLowerDefine(fi);
                                txCurSector = 0 - 1;
                                txCurSecCtor = 0;
                            }
                            #delete[fi];
                        }
                        chain = cssc::peek64(txAstNext + chain * 8);
                    } }
                }
                #delete[allgo];
                #delete[phase];
                #delete[chain];
                #stack[int, 64] ff = cssc::peek64(txSecFreeFn + secId * 8);
                if (ff >= 0) { txLowerSecFree(ff, cssc::peek64(txAstNum + s * 8), secId); }
                #delete[ff];
                #delete[secId];
            }
            s = cssc::peek64(txAstNext + s * 8);
        }
    }
    #delete[go];
    #delete[s];
}

// lower the whole program: collect functions, lower main, then each #define.
#stack[int, 64] txLower;
#define(txLower) {
    #scanp(txLower, int, 0) prog;
    #req[txSymInit] txSymInit;
    #req[txCollectFuncs] txCollectFuncs;
    #req[txPrescanGlobals] txPrescanGlobals;
    #req[txPrescanRetTypes] txPrescanRetTypes;
    #req[txPrescanByRef] txPrescanByRef;
    #req[txCollectObjects] txCollectObjects;
    #req[txCollectSectors] txCollectSectors;
    #req[txLowerObjects] txLowerObjects;
    #req[txLowerSectors] txLowerSectors;
    #req[txLowerMain] txLowerMain;
    #req[txLowerDefine] txLowerDefine;
    #req[txFuncCount] txFuncCount;
    txSymInit();
    txCollectFuncs(prog);            // main + #defines: indices 0..defEnd-1
    #stack[int, 64] defEnd = txFuncCount;
    txCollectObjects(prog);          // object init/free/label fns: indices defEnd..
    txCollectSectors(prog);          // sector member fns + nested objects + free fns
    txPrescanGlobals(prog);          // must run AFTER the function registry exists
    txPrescanRetTypes(prog);         // string return kinds, before main sees calls
    txPrescanByRef();                // "caller wins" by-address params (fixpoint)
    txLowerMain(prog);
    #stack[int, 64] i = 1;
    while (i < defEnd) {             // only real #defines through txLowerDefine
        txLowerDefine(i);
        i = i + 1;
    }
    #delete[i];
    txLowerObjects(prog);            // object functions use their own lowerer
    txLowerSectors(prog);            // sector member fns + free blocks
    #delete[defEnd];
}
