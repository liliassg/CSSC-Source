// ===========================================================================
//  compiler/lower.cssc  --  AST -> CIR lowering (mirrors native/cir/cir_lower).
//  Walks the AST and emits SSA+slot CIR (cir.cssc). Maintains a SYMBOL TABLE
//  mapping a variable name-span (in txSrc) to its CIR slot id. Philosophy:
//  WARN, never reject -- unknown names / calls lower to a safe typed zero / no-op.
//
//  M2: #stack[int] decls, assignment, identifier reads, arithmetic (+ - * / %),
//  and cssc::outln(<int expr>|<string literal>).
// ===========================================================================

// ---- symbol table: name-span (off,len into txSrc) -> slot id.  RESET per
// function (locals are function-scoped). ----
#stack[int, 64] txSymOff = 0;
#stack[int, 64] txSymLen = 0;
#stack[int, 64] txSymSlot = 0;
#stack[int, 64] txSymCount = 0;
#stack[int, 64] txSymCap = 0;

// ---- M4: per-function callable-alias table for `#req[fn] alias;` where fn is a
// #define (alias(args) then resolves to fn). RESET per function. Rare (usually
// alias == fn, resolved directly via the function registry). ----
#stack[int, 64] txAliasOff = 0;
#stack[int, 64] txAliasLen = 0;
#stack[int, 64] txAliasFunc = 0;
#stack[int, 64] txAliasCount = 0;
#stack[int, 64] txAliasCap = 0;

// ---- M4b: per-function GLOBAL-alias table. `#req[g] alias;` (g a module
// global) maps `alias` -> g's global index for this function body, so reads and
// writes of `alias` compile to loads/stores of the ONE global cell -- that IS
// the reference's ref-aliasing/write-back semantics, for free. RESET per
// function. In cssc_user_main every global is pre-registered under its own name
// (module scope sees them all without `#req`). ----
#stack[int, 64] txGAliasOff = 0;
#stack[int, 64] txGAliasLen = 0;
#stack[int, 64] txGAliasIdx = 0;
#stack[int, 64] txGAliasCount = 0;
#stack[int, 64] txGAliasCap = 0;

// M5: the function currently being lowered (0 = cssc_user_main). `return <str>`
// records the string-ness of the return value against THIS function so callers
// can type the captured result.
#stack[int, 64] txCurFunc = 0;

// M5 return-type pre-scan state (see txPrescanRetTypes): the per-function set of
// string-typed names, and the fixpoint flag. Declared here because CSSC requires
// a global's declaration to precede any `#req` of it (txSymInit allocates these).
#stack[int, 64] txPreFloatOff = 0;   // float-typed names of the function being scanned
#stack[int, 64] txPreFloatLen = 0;
#stack[int, 64] txPreFloatCount = 0;
#stack[int, 64] txPreStrOff = 0;
#stack[int, 64] txPreStrLen = 0;
#stack[int, 64] txPreStrCount = 0;
#stack[int, 64] txPreStrCap = 0;
#stack[int, 64] txPreChanged = 0;

// M7c/R4: per-SLOT back-link for a RENAMED `#req[g] alias;`. 0 = none, else
// globalIdx+1. Binding the alias to the global CELL (txGAlias) is only correct
// while `alias == g` -- measured in docs/cssc-ownership.md section 5: with the
// same name a nested write is visible to the caller (p_req_shared_same -> 7),
// with a renamed alias it is NOT (p_req_shared -> 5), because the reference gave
// the callee its own copy. So a renamed alias becomes a real local slot that
// writes THROUGH to the global on assignment and writes BACK at every return.
// Reset per function (slot ids restart).
#stack[int, 64] txReqGlob = 0;
#stack[int, 64] txReqGlobCap = 0;

// statement-nesting depth WITHIN a function body (0 = top level; >0 = inside a
// conditional if/while/for body). A renamed `#req` REF alias only earns an exit
// write-back when it is declared at depth 0 -- there its slot init runs
// unconditionally, so the exit write-back reads a real value. A `#req` inside a
// conditional block whose branch is not taken leaves its slot uninitialised; a
// blind write-back would then store garbage over the global (this clobbered
// txAstC during self-compile, since txPrescanRetTypes' `#req[txAstC] txAstCP`
// lives inside an `if (kind==41)` sector branch that never runs for sector-free
// input). Balanced inc/dec keeps it at 0 between functions -- no reset needed.
#stack[int, 64] txStmtDepth = 0;

// M8a: the LOOP CONTEXT stack -- one frame per active `for`/`while`/`select`, so
// `break`/`continue`/`jump` know where to branch. A select frame additionally
// carries the cursor slot and cond label (jump adjusts the cursor and branches
// there) and the ?label name span (so `?label.pos()` resolves to the cursor).
// Pushed when lowering the loop body, popped after. Balanced -> no per-function
// reset needed, but the base is cleared in txSymInit for safety.
#stack[int, 64] txLoopBreakL = 0;   // end label of this loop
#stack[int, 64] txLoopContL = 0;    // continue target (for: post; while: cond)
#stack[int, 64] txLoopSelCur = 0;   // select cursor slot, else -1
#stack[int, 64] txLoopSelCond = 0;  // select cond label
#stack[int, 64] txLoopLabOff = 0;   // ?label name span (for .pos())
#stack[int, 64] txLoopLabLen = 0;
#stack[int, 64] txLoopDepth = 0;

// M8b: `mirror` soft-return state for the function currently being lowered.
// `mirror` sets the return value but the body keeps running, and the FIRST
// mirror wins (cssl_cssc.py:16529). A bare-slot mirror is a LIVE REF re-read at
// exit (`mirror inner; #delete[inner];` -> outer 0x0, probe p_mir_liveref); a
// `mirror &x` / expression mirror is a snapshot. Four hidden slots hold the
// runtime state; the escape label is the boundary a mirror branches to (the end
// of the current TOP-LEVEL body statement), which is how it "aborts the
// enclosing statement path and resumes at the next statement" (probe
// p_mir_abort -> 222 then 111).
#stack[int, 64] txMirUses = 0;      // does the current function contain a mirror?
#stack[int, 64] txMirSetSlot = 0;   // 0/1 first-wins flag
#stack[int, 64] txMirValSlot = 0;   // snapshot value
#stack[int, 64] txMirRefSlot = 0;   // 0/1 live-ref?
#stack[int, 64] txMirAddrSlot = 0;  // address of the live-ref source
#stack[int, 64] txMirEscape = 0;    // label: end of the current top-level stmt

// M9: OBJECT registry (SINGLETON model). Members are anonymous object-globals
// looked up by (objectId, memberText); labels + the ctor + the free block are
// ordinary functions. All keyed by name spans into txSrc, compared by text.
#stack[int, 64] txObjNameOff = 0;   // object type registry
#stack[int, 64] txObjNameLen = 0;
#stack[int, 64] txObjInitFn = 0;    // per-object: init (ctor) function index
#stack[int, 64] txObjFreeFn = 0;    // per-object: free function index (-1 = none)
#stack[int, 64] txObjCount = 0;
#stack[int, 64] txObjSize = 0;      // per-object: instance BLOCK size in bytes (members*8)
#stack[int, 64] txMemObj = 0;       // member table: (objId, name span) -> global idx
#stack[int, 64] txMemOff = 0;
#stack[int, 64] txMemLen = 0;
#stack[int, 64] txMemGlob = 0;
#stack[int, 64] txMemBlkOff = 0;    // member BYTE offset inside its object's instance block
#stack[int, 64] txMemKind = 0;      // 0 int, 1 string, 2 float, 3 vector, ...
#stack[int, 64] txMemElem = 0;      // container element kind
#stack[int, 64] txMemCount = 0;
#stack[int, 64] txLabObj = 0;       // label table: (objId, name span) -> func idx
#stack[int, 64] txLabOff = 0;
#stack[int, 64] txLabLen = 0;
#stack[int, 64] txLabFn = 0;
#stack[int, 64] txLabCount = 0;
#stack[int, 64] txInstOff = 0;      // instance var -> objId (so `inst->m` finds the type)
#stack[int, 64] txInstLen = 0;
#stack[int, 64] txInstObj = 0;
#stack[int, 64] txInstCount = 0;
#stack[int, 64] txCallThis = 0;     // block-ptr SSA to prepend as arg0 of the NEXT
                                    // user call (ctor / label / free -> "this"); -1 = none
#stack[int, 64] txCurObj = 0;       // object whose body is being lowered (-1 = none)
#stack[int, 64] txIsoBad = 0;       // 1 = a #define-body called an un-#req'd sibling
                                    // (isolation violation) -> reject: emit no container
#stack[int, 64] txObjNode = 0;      // per-object: its OBJECT AST node (lower via registry)
#stack[int, 64] txObjSec = 0;       // per-object: owning sector id (-1 = top level)

// SECTORS: named, isolated namespaces (docs/cssc-sectors.md). A sector is built
// ONCE at its position; members are variable globals, anonymous functions and
// sector-tagged objects, reached by `sector::member` / `#req[sector] alias` /
// bare sibling calls. `#free[sector]` runs the free block. Keyed by name spans.
#stack[int, 64] txSecNameOff = 0;   // sector registry
#stack[int, 64] txSecNameLen = 0;
#stack[int, 64] txSecFreeFn = 0;    // per-sector: free function index (-1 = none)
#stack[int, 64] txSecCount = 0;
#stack[int, 64] txSVarSec = 0;      // member var: (secId, name span) -> global idx
#stack[int, 64] txSVarOff = 0;
#stack[int, 64] txSVarLen = 0;
#stack[int, 64] txSVarGlob = 0;
#stack[int, 64] txSVarKind = 0;     // 0 int,1 string,2 float,3 vector,4 map,5 bind
#stack[int, 64] txSVarElem = 0;     // container element kind
#stack[int, 64] txSVarPub = 0;      // 1 = public member (private -> 0x0 from outside)
#stack[int, 64] txSVarCount = 0;
#stack[int, 64] txSFnSec = 0;       // member fn: (secId, name span) -> func idx
#stack[int, 64] txSFnOff = 0;
#stack[int, 64] txSFnLen = 0;
#stack[int, 64] txSFnIdx = 0;
#stack[int, 64] txSFnCount = 0;
#stack[int, 64] txSecAliOff = 0;    // #req[sector] alias: name span -> secId
#stack[int, 64] txSecAliLen = 0;
#stack[int, 64] txSecAliSec = 0;
#stack[int, 64] txSecAliCount = 0;
#stack[int, 64] txModFlatOff = 0;   // #load/#include FLAT-module alias name span
#stack[int, 64] txModFlatLen = 0;   // (module has no sector -> its top-level #defines
#stack[int, 64] txModFlatCount = 0; //  live in the shared function namespace; `a::f`->`f`)
#stack[int, 64] txBiModOff = 0;     // built-in module alias name span (#include('cssc.math'),
#stack[int, 64] txBiModLen = 0;     //  #include('sizes'), ...): resolved by the compiler, no
#stack[int, 64] txBiModK = 0;       //  sector/file. kind: 1 = cssc.math, 2 = sizes
#stack[int, 64] txBiModCount = 0;
#stack[int, 64] txCurSector = 0;    // sector whose fn/ctor is being lowered (-1 = none)
#stack[int, 64] txCurSecCtor = 0;   // 1 = construction/free scope (members bare-visible)

#stack[int, 64] txSymInit;
#define(txSymInit) {
    #req[txSymOff] txSymOff;
    #req[txSymLen] txSymLen;
    #req[txSymSlot] txSymSlot;
    #req[txSymCount] txSymCount;
    #req[txSymCap] txSymCap;
    #req[txAliasOff] txAliasOff;
    #req[txAliasLen] txAliasLen;
    #req[txAliasFunc] txAliasFunc;
    #req[txAliasCount] txAliasCount;
    #req[txAliasCap] txAliasCap;
    #req[txGAliasOff] txGAliasOff;
    #req[txGAliasLen] txGAliasLen;
    #req[txGAliasIdx] txGAliasIdx;
    #req[txGAliasCount] txGAliasCount;
    #req[txGAliasCap] txGAliasCap;
    #req[txPreStrOff] txPreStrOff;
    #req[txPreStrLen] txPreStrLen;
    #req[txPreStrCount] txPreStrCount;
    #req[txPreStrCap] txPreStrCap;
    #req[txPreFloatOff] txPreFloatOff;
    #req[txPreFloatLen] txPreFloatLen;
    #req[txPreFloatCount] txPreFloatCount;
    #req[txReqGlob] txReqGlob;
    #req[txReqGlobCap] txReqGlobCap;
    #req[txLoopBreakL] txLoopBreakL;
    #req[txLoopContL] txLoopContL;
    #req[txLoopSelCur] txLoopSelCur;
    #req[txLoopSelCond] txLoopSelCond;
    #req[txLoopLabOff] txLoopLabOff;
    #req[txLoopLabLen] txLoopLabLen;
    #req[txLoopDepth] txLoopDepth;
    #req[txObjNameOff] txObjNameOff;
    #req[txObjNameLen] txObjNameLen;
    #req[txObjInitFn] txObjInitFn;
    #req[txObjFreeFn] txObjFreeFn;
    #req[txObjSize] txObjSize;
    #req[txCallThis] txCallThis;
    #req[txObjCount] txObjCount;
    #req[txMemObj] txMemObj;
    #req[txMemOff] txMemOff;
    #req[txMemLen] txMemLen;
    #req[txMemGlob] txMemGlob;
    #req[txMemBlkOff] txMemBlkOff;
    #req[txMemKind] txMemKind;
    #req[txMemElem] txMemElem;
    #req[txMemCount] txMemCount;
    #req[txLabObj] txLabObj;
    #req[txLabOff] txLabOff;
    #req[txLabLen] txLabLen;
    #req[txLabFn] txLabFn;
    #req[txLabCount] txLabCount;
    #req[txInstOff] txInstOff;
    #req[txInstLen] txInstLen;
    #req[txInstObj] txInstObj;
    #req[txInstCount] txInstCount;
    #req[txCurObj] txCurObj;
    #req[txIsoBad] txIsoBad;
    #req[txObjNode] txObjNode;
    #req[txObjSec] txObjSec;
    #req[txSecNameOff] txSecNameOff;
    #req[txSecNameLen] txSecNameLen;
    #req[txSecFreeFn] txSecFreeFn;
    #req[txSecCount] txSecCount;
    #req[txSVarSec] txSVarSec;
    #req[txSVarOff] txSVarOff;
    #req[txSVarLen] txSVarLen;
    #req[txSVarGlob] txSVarGlob;
    #req[txSVarKind] txSVarKind;
    #req[txSVarElem] txSVarElem;
    #req[txSVarPub] txSVarPub;
    #req[txSVarCount] txSVarCount;
    #req[txSFnSec] txSFnSec;
    #req[txSFnOff] txSFnOff;
    #req[txSFnLen] txSFnLen;
    #req[txSFnIdx] txSFnIdx;
    #req[txSFnCount] txSFnCount;
    #req[txSecAliOff] txSecAliOff;
    #req[txSecAliLen] txSecAliLen;
    #req[txSecAliSec] txSecAliSec;
    #req[txSecAliCount] txSecAliCount;
    #req[txModFlatOff] txModFlatOff;
    #req[txModFlatLen] txModFlatLen;
    #req[txModFlatCount] txModFlatCount;
    #req[txBiModOff] txBiModOff;
    #req[txBiModLen] txBiModLen;
    #req[txBiModK] txBiModK;
    #req[txBiModCount] txBiModCount;
    #req[txCurSector] txCurSector;
    #req[txCurSecCtor] txCurSecCtor;
    txReqGlobCap = 16384;
    txReqGlob = cssc::alloc(txReqGlobCap * 8);
    cssc::memfill32(txReqGlob, 0, txReqGlobCap * 2);
    txLoopBreakL = cssc::alloc(256 * 8);       // nesting cap: 256 loops deep
    txLoopContL = cssc::alloc(256 * 8);
    txLoopSelCur = cssc::alloc(256 * 8);
    txLoopSelCond = cssc::alloc(256 * 8);
    txLoopLabOff = cssc::alloc(256 * 8);
    txLoopLabLen = cssc::alloc(256 * 8);
    txLoopDepth = 0;
    txObjNameOff = cssc::alloc(1024 * 8);
    txObjNameLen = cssc::alloc(1024 * 8);
    txObjInitFn = cssc::alloc(1024 * 8);
    txObjFreeFn = cssc::alloc(1024 * 8);
    txObjSize = cssc::alloc(1024 * 8);
    txObjCount = 0;
    txMemObj = cssc::alloc(8192 * 8);
    txMemOff = cssc::alloc(8192 * 8);
    txMemLen = cssc::alloc(8192 * 8);
    txMemGlob = cssc::alloc(8192 * 8);
    txMemBlkOff = cssc::alloc(8192 * 8);
    txMemKind = cssc::alloc(8192 * 8);
    txMemElem = cssc::alloc(8192 * 8);
    txMemCount = 0;
    txLabObj = cssc::alloc(8192 * 8);
    txLabOff = cssc::alloc(8192 * 8);
    txLabLen = cssc::alloc(8192 * 8);
    txLabFn = cssc::alloc(8192 * 8);
    txLabCount = 0;
    txInstOff = cssc::alloc(8192 * 8);
    txInstLen = cssc::alloc(8192 * 8);
    txInstObj = cssc::alloc(8192 * 8);
    txInstCount = 0;
    txCurObj = 0 - 1;
    txCallThis = 0 - 1;
    txObjNode = cssc::alloc(1024 * 8);
    txObjSec = cssc::alloc(1024 * 8);
    cssc::memfill32(txObjSec, 0 - 1, 1024 * 2);        // default: top-level (-1)
    txSecNameOff = cssc::alloc(256 * 8);
    txSecNameLen = cssc::alloc(256 * 8);
    txSecFreeFn = cssc::alloc(256 * 8);
    txSecCount = 0;
    txSVarSec = cssc::alloc(4096 * 8);
    txSVarOff = cssc::alloc(4096 * 8);
    txSVarLen = cssc::alloc(4096 * 8);
    txSVarGlob = cssc::alloc(4096 * 8);
    txSVarKind = cssc::alloc(4096 * 8);
    txSVarElem = cssc::alloc(4096 * 8);
    txSVarPub = cssc::alloc(4096 * 8);
    txSVarCount = 0;
    txSFnSec = cssc::alloc(4096 * 8);
    txSFnOff = cssc::alloc(4096 * 8);
    txSFnLen = cssc::alloc(4096 * 8);
    txSFnIdx = cssc::alloc(4096 * 8);
    txSFnCount = 0;
    txSecAliOff = cssc::alloc(1024 * 8);
    txSecAliLen = cssc::alloc(1024 * 8);
    txSecAliSec = cssc::alloc(1024 * 8);
    txSecAliCount = 0;
    txModFlatOff = cssc::alloc(1024 * 8);
    txModFlatLen = cssc::alloc(1024 * 8);
    txModFlatCount = 0;
    txBiModOff = cssc::alloc(1024 * 8);
    txBiModLen = cssc::alloc(1024 * 8);
    txBiModK = cssc::alloc(1024 * 8);
    txBiModCount = 0;
    txCurSector = 0 - 1;
    txCurSecCtor = 0;
    txIsoBad = 0;
    txSymCap = 16384;
    txSymOff = cssc::alloc(txSymCap * 8);
    txSymLen = cssc::alloc(txSymCap * 8);
    txSymSlot = cssc::alloc(txSymCap * 8);
    txSymCount = 0;
    txAliasCap = 4096;
    txAliasOff = cssc::alloc(txAliasCap * 8);
    txAliasLen = cssc::alloc(txAliasCap * 8);
    txAliasFunc = cssc::alloc(txAliasCap * 8);
    txAliasCount = 0;
    txGAliasCap = 4096;
    txGAliasOff = cssc::alloc(txGAliasCap * 8);
    txGAliasLen = cssc::alloc(txGAliasCap * 8);
    txGAliasIdx = cssc::alloc(txGAliasCap * 8);
    txGAliasCount = 0;
    txPreStrCap = 4096;
    txPreStrOff = cssc::alloc(txPreStrCap * 8);
    txPreStrLen = cssc::alloc(txPreStrCap * 8);
    txPreStrCount = 0;
    txPreFloatOff = cssc::alloc(txPreStrCap * 8);
    txPreFloatLen = cssc::alloc(txPreStrCap * 8);
    txPreFloatCount = 0;
}

// clear the per-function `#req` back-links (slot ids restart per function)
#stack[int, 64] txReqReset;
#define(txReqReset) {
    #req[txReqGlob] txReqGlob;
    #req[txReqGlobCap] txReqGlobCap;
    cssc::memfill32(txReqGlob, 0, txReqGlobCap * 2);
}

// emit the exit write-back of every RENAMED `#req` alias into its global. This
// is what makes the outer frame's value win over a nested one (p_req_shared:
// hw writes 7, fw's write-back then restores 5 -> global ends at 5).
#stack[int, 64] txReqWriteBack;
#define(txReqWriteBack) {
    #req[txReqGlob] txReqGlob;
    #req[txSlotNext] txSlotNext;
    #req[txCirSlotLoad] txCirSlotLoad;
    #req[txCirGlobStore] txCirGlobStore;
    #stack[int, 64] i = 0;
    while (i < txSlotNext) {
        #stack[int, 64] g = cssc::peek64(txReqGlob + i * 8);
        if (g != 0) {
            txCirSlotLoad(i) v;
            txCirGlobStore(g - 1, v);
            #delete[v];
        }
        #delete[g];
        i = i + 1;
    }
    #delete[i];
}

// enter/leave a conditional statement body -- bumps txStmtDepth so a `#req` REF
// alias lowered inside knows it is not at function top level (see txStmtDepth).
#stack[int, 64] txDepthInc;
#define(txDepthInc) {
    #req[txStmtDepth] txStmtDepth;
    txStmtDepth = txStmtDepth + 1;
}
#stack[int, 64] txDepthDec;
#define(txDepthDec) {
    #req[txStmtDepth] txStmtDepth;
    txStmtDepth = txStmtDepth - 1;
}
#stack[int, 64] txDepthGet;
#define(txDepthGet) {
    #req[txStmtDepth] txStmtDepth;
    return txStmtDepth;
}

// register an alias-span -> function index
#stack[int, 64] txAliasAdd;
#define(txAliasAdd) {
    #scanp(txAliasAdd, int, 0) off;
    #scanp(txAliasAdd, int, 1) len;
    #scanp(txAliasAdd, int, 2) fn;
    #req[txAliasOff] txAliasOff;
    #req[txAliasLen] txAliasLen;
    #req[txAliasFunc] txAliasFunc;
    #req[txAliasCount] txAliasCount;
    #stack[int, 64] i = txAliasCount;
    txAliasCount = txAliasCount + 1;
    cssc::poke64(txAliasOff + i * 8, off);
    cssc::poke64(txAliasLen + i * 8, len);
    cssc::poke64(txAliasFunc + i * 8, fn);
    #delete[i];
}

// find an alias-span -> function index, or -1
#stack[int, 64] txAliasFind;
#define(txAliasFind) {
    #scanp(txAliasFind, int, 0) off;
    #scanp(txAliasFind, int, 1) len;
    #req[txAliasOff] txAliasOff;
    #req[txAliasLen] txAliasLen;
    #req[txAliasFunc] txAliasFunc;
    #req[txAliasCount] txAliasCount;
    #req[txSpanEq] txSpanEq;
    #stack[int, 64] found = 0 - 1;
    #stack[int, 64] i = 0;
    while (i < txAliasCount) {
        txSpanEq(off, len, cssc::peek64(txAliasOff + i * 8), cssc::peek64(txAliasLen + i * 8)) eq;
        if (eq == 1) { found = cssc::peek64(txAliasFunc + i * 8); }
        #delete[eq];
        i = i + 1;
    }
    #delete[i];
    return found;
}

// find a function index by its registered name-span, or -1 (skips the len-0 main)
#stack[int, 64] txFuncFind;
#define(txFuncFind) {
    #scanp(txFuncFind, int, 0) off;
    #scanp(txFuncFind, int, 1) len;
    #req[txFuncNameOff] txFuncNameOff;
    #req[txFuncNameLen] txFuncNameLen;
    #req[txFuncCount] txFuncCount;
    #req[txSpanEq] txSpanEq;
    #stack[int, 64] found = 0 - 1;
    #stack[int, 64] i = 0;
    while (i < txFuncCount) {
        txSpanEq(off, len, cssc::peek64(txFuncNameOff + i * 8), cssc::peek64(txFuncNameLen + i * 8)) eq;
        if (eq == 1) { found = i; }
        #delete[eq];
        i = i + 1;
    }
    #delete[i];
    return found;
}

// find a module-global index by its registered name-span, or -1
#stack[int, 64] txGlobFind;
#define(txGlobFind) {
    #scanp(txGlobFind, int, 0) off;
    #scanp(txGlobFind, int, 1) len;
    #req[txGlobNameOff] txGlobNameOff;
    #req[txGlobNameLen] txGlobNameLen;
    #req[txGlobCount] txGlobCount;
    #req[txSpanEq] txSpanEq;
    #stack[int, 64] found = 0 - 1;
    #stack[int, 64] i = 0;
    while (i < txGlobCount) {
        txSpanEq(off, len, cssc::peek64(txGlobNameOff + i * 8), cssc::peek64(txGlobNameLen + i * 8)) eq;
        if (eq == 1) { found = i; }
        #delete[eq];
        i = i + 1;
    }
    #delete[i];
    return found;
}

#stack[int, 64] txGAliasAdd;
#define(txGAliasAdd) {
    #scanp(txGAliasAdd, int, 0) off;
    #scanp(txGAliasAdd, int, 1) len;
    #scanp(txGAliasAdd, int, 2) gi;
    #req[txGAliasOff] txGAliasOff;
    #req[txGAliasLen] txGAliasLen;
    #req[txGAliasIdx] txGAliasIdx;
    #req[txGAliasCount] txGAliasCount;
    #stack[int, 64] i = txGAliasCount;
    txGAliasCount = txGAliasCount + 1;
    cssc::poke64(txGAliasOff + i * 8, off);
    cssc::poke64(txGAliasLen + i * 8, len);
    cssc::poke64(txGAliasIdx + i * 8, gi);
    #delete[i];
}

#stack[int, 64] txGAliasFind;
#define(txGAliasFind) {
    #scanp(txGAliasFind, int, 0) off;
    #scanp(txGAliasFind, int, 1) len;
    #req[txGAliasOff] txGAliasOff;
    #req[txGAliasLen] txGAliasLen;
    #req[txGAliasIdx] txGAliasIdx;
    #req[txGAliasCount] txGAliasCount;
    #req[txSpanEq] txSpanEq;
    #stack[int, 64] found = 0 - 1;
    #stack[int, 64] i = 0;
    while (i < txGAliasCount) {
        txSpanEq(off, len, cssc::peek64(txGAliasOff + i * 8), cssc::peek64(txGAliasLen + i * 8)) eq;
        if (eq == 1) { found = cssc::peek64(txGAliasIdx + i * 8); }
        #delete[eq];
        i = i + 1;
    }
    #delete[i];
    return found;
}

// two txSrc spans equal?
#stack[int, 64] txSpanEq;
#define(txSpanEq) {
    #scanp(txSpanEq, int, 0) o1;
    #scanp(txSpanEq, int, 1) l1;
    #scanp(txSpanEq, int, 2) o2;
    #scanp(txSpanEq, int, 3) l2;
    #req[txSrc] txSrc;
    #stack[int, 32] r = 0;
    if (l1 == l2) {
        r = 1;
        #stack[int, 64] i = 0;
        while (i < l1) {
            if (cssc::peek8(txSrc + o1 + i) != cssc::peek8(txSrc + o2 + i)) { r = 0; }
            i = i + 1;
        }
        #delete[i];
    }
    #stack[int, 32] rr = r;
    #delete[r];
    return rr;
}

// find the slot id for a name-span, or -1
#stack[int, 64] txSymFind;
#define(txSymFind) {
    #scanp(txSymFind, int, 0) off;
    #scanp(txSymFind, int, 1) len;
    #req[txSymOff] txSymOff;
    #req[txSymLen] txSymLen;
    #req[txSymSlot] txSymSlot;
    #req[txSymCount] txSymCount;
    #req[txSpanEq] txSpanEq;
    #stack[int, 64] found = 0 - 1;
    #stack[int, 64] i = 0;
    while (i < txSymCount) {
        txSpanEq(off, len, cssc::peek64(txSymOff + i * 8), cssc::peek64(txSymLen + i * 8)) eq;
        if (eq == 1) { found = cssc::peek64(txSymSlot + i * 8); }
        #delete[eq];
        i = i + 1;
    }
    #delete[i];
    return found;
}

// register a name-span -> slot mapping
#stack[int, 64] txSymAdd;
#define(txSymAdd) {
    #scanp(txSymAdd, int, 0) off;
    #scanp(txSymAdd, int, 1) len;
    #scanp(txSymAdd, int, 2) slot;
    #req[txSymOff] txSymOff;
    #req[txSymLen] txSymLen;
    #req[txSymSlot] txSymSlot;
    #req[txSymCount] txSymCount;
    #stack[int, 64] i = txSymCount;
    txSymCount = txSymCount + 1;
    cssc::poke64(txSymOff + i * 8, off);
    cssc::poke64(txSymLen + i * 8, len);
    cssc::poke64(txSymSlot + i * 8, slot);
    #delete[i];
}

// span (off,len into txSrc) == string literal ?   (ported from interp ciIdentIs)
#stack[int, 64] txSpanIs;
#define(txSpanIs) {
    #scanp(txSpanIs, int, 0) off;
    #scanp(txSpanIs, int, 1) len;
    #scanp(txSpanIs, string, 2) lit;
    #req[txSrc] txSrc;
    #stack[int, 64] sa = 0;
    #adress[lit] sa;
    #stack[int, 64] hdr = cssc::peek64(sa);
    #stack[int, 64] llen = cssc::peek32(hdr + 4);
    #stack[int, 64] ldata = hdr + 8;
    #stack[int, 32] ok = 1;
    if (llen != len) { ok = 0; }
    if (ok == 1) {
        #stack[int, 32] j = 0;
        while (j < len) {
            if (cssc::peek8(txSrc + off + j) != cssc::peek8(ldata + j)) { ok = 0; }
            j = j + 1;
        }
        #delete[j];
    }
    #stack[int, 32] rr = ok;
    #delete[ok];
    #delete[ldata];
    #delete[llen];
    #delete[hdr];
    #delete[sa];
    return rr;
}

// ---- M5 part 2: refcount helpers ----
// Release the string a slot currently holds, before it is overwritten. The new
// value must already be computed (it may have been built FROM the old one, as in
// `s = s + x;`), so the caller does this immediately before the store.
#stack[int, 64] txReleaseSlotOld;
#define(txReleaseSlotOld) {
    #scanp(txReleaseSlotOld, int, 0) slot;
    #req[txSlotIsStr] txSlotIsStr;
    #req[txCirSlotLoad] txCirSlotLoad;
    #req[txCirCall] txCirCall;
    txSlotIsStr(slot) isS;
    if (isS == 1) {
        txCirSlotLoad(slot) old;
        txCirCall(16, old, 0 - 1);                    // cssc_release(old)
        #delete[old];
    }
    #delete[isS];
}

#stack[int, 64] txReleaseGlobOld;
#define(txReleaseGlobOld) {
    #scanp(txReleaseGlobOld, int, 0) idx;
    #req[txGlobIsStr] txGlobIsStr;
    #req[txCirGlobLoad] txCirGlobLoad;
    #req[txCirCall] txCirCall;
    txGlobIsStr(idx) isS;
    if (isS == 1) {
        txCirGlobLoad(idx) old;
        txCirCall(16, old, 0 - 1);                    // cssc_release(old)
        #delete[old];
    }
    #delete[isS];
}

// A STORAGE LOCATION -- container cell, local slot, or module global -- takes a
// STRONG reference to whatever it stores. If the value is an owned temporary we
// simply transfer that reference; if it was only BORROWED (loaded from another
// slot) we must retain it, otherwise the later teardown releases a reference it
// never held and frees the string out from under the name that still holds it.
//
// Slots need this just as much as containers do: `#stack[string,N] b = a;`
// followed by `a = "x";` releases a's old string, and without the retain `b`
// would dangle. That read-after-free happened to print the right bytes with one
// allocator and garbage with another -- see docs/cssc-ownership.md (p_alias_str).
#stack[int, 64] txContainerTake;
#define(txContainerTake) {
    #scanp(txContainerTake, int, 0) v;
    #req[txIsStr] txIsStr;
    #req[txIsOwned] txIsOwned;
    #req[txClearOwned] txClearOwned;
    #req[txCirCall] txCirCall;
    txIsStr(v) vs;
    if (vs == 1) {
        txIsOwned(v) vo;
        if (vo == 1) { txClearOwned(v); }             // transfer our reference
        if (vo == 0) { txCirCall(15, v, 0 - 1); }     // cssc_retain: add one
        #delete[vo];
    }
    #delete[vs];
}

// Release every still-OWNED string temporary created in the SSA range
// [from, txSsaNext). Called at the end of a leaf statement: anything not taken
// over by a slot/global/return is an intermediate (e.g. the `a+b` in `a+b+c`).
#stack[int, 64] txReleaseTemps;
#define(txReleaseTemps) {
    #scanp(txReleaseTemps, int, 0) from;
    #req[txSsaNext] txSsaNext;
    #req[txIsOwned] txIsOwned;
    #req[txClearOwned] txClearOwned;
    #req[txCirCall] txCirCall;
    #stack[int, 64] i = from;
    while (i < txSsaNext) {
        txIsOwned(i) own;
        if (own == 1) {
            txCirCall(16, i, 0 - 1);                  // cssc_release(temp)
            txClearOwned(i);
        }
        #delete[own];
        i = i + 1;
    }
    #delete[i];
}

// Release the function's LOCAL string slots (params are borrowed from the caller
// and must NOT be released). Emitted before every RET.
#stack[int, 64] txReleaseLocals;
#define(txReleaseLocals) {
    #scanp(txReleaseLocals, int, 0) fromSlot;
    #req[txSlotNext] txSlotNext;
    #req[txSlotIsStr] txSlotIsStr;
    #req[txCirSlotLoad] txCirSlotLoad;
    #req[txCirCall] txCirCall;
    #stack[int, 64] i = fromSlot;
    while (i < txSlotNext) {
        txSlotIsStr(i) isS;
        if (isS == 1) {
            txCirSlotLoad(i) v;
            txCirCall(16, v, 0 - 1);                  // cssc_release(local)
            #delete[v];
        }
        #delete[isS];
        i = i + 1;
    }
    #delete[i];
}

// lower a CALL node (kind 14). Returns the result SSA id, or -1 when the call
// yields no usable value (e.g. cssc::outln). Handles:
//   cssc::outln(...)  -> print_int / print_str / print_bool / print_newline
//   user f(...)       -> CALL_USER with args marshalled through the side-table
//   unknown           -> warn-not-reject: emits nothing, returns a const-0 SSA
#stack[int, 64] txLowerCall;
#define(txLowerCall) {
    #scanp(txLowerCall, int, 0) node;
    #req[txAstKind] txAstKind;
    #req[txAstOff] txAstOff;
    #req[txAstLen] txAstLen;
    #req[txAstA] txAstA;
    #req[txAstNext] txAstNext;
    #req[txSpanIs] txSpanIs;
    #req[txFuncFind] txFuncFind;
    #req[txAliasFind] txAliasFind;
    #req[txLowerExpr] txLowerExpr;
    #req[txIsBool] txIsBool;
    #req[txIsStr] txIsStr;
    #req[txIsMap] txIsMap;
    #req[txIsVec] txIsVec;
    #req[txCirCallR] txCirCallR;
    #req[txSetStr] txSetStr;
    #req[txIsFloat] txIsFloat;
    #req[txCirFCall] txCirFCall;
    #req[txFuncIsRetStr] txFuncIsRetStr;
    #req[txFuncIsRetFloat] txFuncIsRetFloat;
    #req[txFuncIsRetBool] txFuncIsRetBool;
    #req[txSetFloat] txSetFloat;
    #req[txSetBool] txSetBool;
    #req[txNewSsa] txNewSsa;
    #req[txCallArg] txCallArg;
    #req[txCallArgCount] txCallArgCount;
    #req[txCirConstStr] txCirConstStr;
    #req[txCirConstInt] txCirConstInt;
    #req[txCirCall] txCirCall;
    #req[txCirCallUser] txCirCallUser;
    #req[txParamByRef] txParamByRef;
    #req[txSymFind] txSymFind;
    #req[txGAliasFind] txGAliasFind;
    #req[txNewSlot] txNewSlot;
    #req[txCirSlotAlloc] txCirSlotAlloc;
    #req[txCirSlotStore] txCirSlotStore;
    #req[txCirSlotAddr] txCirSlotAddr;
    #req[txCirGlobAddr] txCirGlobAddr;
    #req[txCirSlotAlive] txCirSlotAlive;
    #req[txCirGlobAlive] txCirGlobAlive;
    #req[txNewLabel] txNewLabel;
    #req[txCirBrz] txCirBrz;
    #req[txCirBr] txCirBr;
    #req[txCirLabel] txCirLabel;
    #req[txNsColon] txNsColon;
    #req[txSecFind] txSecFind;
    #req[txSFnFind] txSFnFind;
    #req[txCurSector] txCurSector;
    #stack[int, 64] calleeOff = cssc::peek64(txAstOff + node * 8);
    #stack[int, 64] calleeLen = cssc::peek64(txAstLen + node * 8);
    #stack[int, 64] firstArg = cssc::peek64(txAstA + node * 8);
    #stack[int, 64] out = 0 - 1;
    #stack[int, 32] handled = 0;
    // sector namespace resolution: `Sector::fn()`/`alias::fn()`, `Sector::Obj()`,
    // and BARE sibling member calls inside a sector fn (S2/S5/S6/S14/S18).
    #stack[int, 64] secFnIdx = 0 - 1;
    #stack[int, 64] secObjId = 0 - 1;

    txSpanIs(calleeOff, calleeLen, "cssc::outln") isOutln;
    if (isOutln == 1) {
        handled = 1;
        if (firstArg == 0) {
            txCirCall(8, 0 - 1, 0 - 1);                    // print_newline
        }
        if (firstArg != 0) {
            #stack[int, 64] argKind = cssc::peek64(txAstKind + firstArg * 8);
            if (argKind == 4) {                            // string literal -> print_str
                #stack[int, 64] soff = cssc::peek64(txAstOff + firstArg * 8);
                #stack[int, 64] slen = cssc::peek64(txAstLen + firstArg * 8);
                txCirConstStr(soff, slen) sid;
                txCirConstInt(slen) lid;
                txCirCall(1, sid, lid);
                #delete[sid];
                #delete[lid];
                #delete[soff];
                #delete[slen];
            }
            if (argKind != 4) {                            // int/bool/string expression
                // A bare NAME can be UNBOUND -- `#delete`d here, or deleted by a
                // callee through a by-address parameter. The reference prints
                // `0x0` for that and `0` for a variable that merely holds zero
                // (docs/cssc-ownership.md section 6), so branch on the name's
                // `alive` cell. One compare and one jump in front of a call that
                // already does I/O, and correct for EVERY type -- which is why
                // this is a branch and not a set of per-type runtime variants.
                #stack[int, 64] aliveId = 0 - 1;
                if (argKind == 5) {                        // IDENT
                    #stack[int, 64] nOffP = cssc::peek64(txAstOff + firstArg * 8);
                    #stack[int, 64] nLenP = cssc::peek64(txAstLen + firstArg * 8);
                    #stack[int, 32] pBound = 0;
                    txSymFind(nOffP, nLenP) pSlot;
                    if (pSlot >= 0) { txCirSlotAlive(pSlot) av; aliveId = av; pBound = 1; #delete[av]; }
                    if (pSlot < 0) {
                        txGAliasFind(nOffP, nLenP) pGi;
                        if (pGi >= 0) { txCirGlobAlive(pGi) gav; aliveId = gav; pBound = 1; #delete[gav]; }
                        #delete[pGi];
                    }
                    // Inside a sector, a BARE (unqualified) name that is neither a
                    // local nor a member/#req alias is UNBOUND -> print 0x0, not 0
                    // (S3/S9). A `Sector::member` read (`::`) is bound; leave it.
                    if (pBound == 0) { if (txCurSector >= 0) {
                        txNsColon(nOffP, nLenP) pns;
                        if (pns < 0) { txCirConstInt(0) az; aliveId = az; #delete[az]; }
                        #delete[pns];
                    } }
                    // A `Sector::privateMember` read from outside prints 0x0 (S13).
                    #req[txSecMemHidden] txSecMemHidden;
                    txSecMemHidden(nOffP, nLenP) pHid;
                    if (pHid == 1) { txCirConstInt(0) hz; aliveId = hz; #delete[hz]; }
                    #delete[pHid];
                    #delete[pBound];
                    #delete[pSlot];
                    #delete[nLenP];
                    #delete[nOffP];
                }
                // Lower the value FIRST so a direct nullable expression (e.g.
                // `outln(pk::peek(oob))`, which no identifier alive-cell covers) can
                // fall back to the value's runtime alive companion -> print 0x0.
                // Safe to compute before the branch: peek's loads are bounds-checked.
                txLowerExpr(firstArg) vid;
                if (aliveId < 0) {
                    #req[txGetAliveSsa] txGetAliveSsa;
                    txGetAliveSsa(vid) vComp;
                    if (vComp > 0) { aliveId = vComp; }
                    #delete[vComp];
                }
                #stack[int, 64] nullL = 0;
                #stack[int, 64] endL2 = 0;
                if (aliveId >= 0) {
                    txNewLabel() nl2; nullL = nl2; #delete[nl2];
                    txNewLabel() el2; endL2 = el2; #delete[el2];
                    txCirBrz(aliveId, nullL);              // alive == 0 -> print 0x0
                }
                txIsStr(vid) iss;
                txIsBool(vid) isb;
                txIsFloat(vid) isf;
                if (iss == 1) { txCirCall(7, vid, 0 - 1); }       // print_string
                if (iss == 0) {
                    if (isf == 1) { txCirFCall(20, vid); }        // print_float (XMM0!)
                    if (isf == 0) {
                        if (isb == 1) { txCirCall(9, vid, 0 - 1); }   // print_bool
                        if (isb == 0) { txCirCall(0, vid, 0 - 1); }   // print_int
                    }
                }
                if (aliveId >= 0) {
                    txCirBr(endL2);
                    txCirLabel(nullL);
                    txCirCall(38, 0 - 1, 0 - 1);           // cssc_print_null -> "0x0"
                    txCirLabel(endL2);
                }
                #delete[endL2];
                #delete[nullL];
                #delete[aliveId];
                #delete[isf];
                #delete[isb];
                #delete[iss];
                #delete[vid];
            }
            #delete[argKind];
        }
    }
    #delete[isOutln];

    // cssc::len(x) -> element count for a container, char count for a string.
    // Dispatch on the argument's runtime kind (map -> map_size, vector/array ->
    // vec_size, else string_len). Was unimplemented -> resolved to a typed zero.
    txSpanIs(calleeOff, calleeLen, "cssc::len") isLen;
    if (isLen == 1) {
        handled = 1;
        if (firstArg != 0) {
            txLowerExpr(firstArg) lv;
            txIsMap(lv) lIsMap;
            txIsVec(lv) lIsVec;
            #stack[int, 64] lenSym = 41;              // cssc_string_len (default)
            if (lIsVec == 1) { lenSym = 25; }         // cssc_vec_size
            if (lIsMap == 1) { lenSym = 30; }         // cssc_map_size
            txCirCallR(lenSym, lv, 0 - 1) lr;
            out = lr;
            #delete[lr];
            #delete[lenSym];
            #delete[lIsVec];
            #delete[lIsMap];
            #delete[lv];
        }
        if (firstArg == 0) { txCirConstInt(0) lz; out = lz; #delete[lz]; }
    }
    #delete[isLen];

    // ---- raw-memory + bitwise intrinsics: the primitives the COMPILER ITSELF is
    // written in. Without these the self-hosted compiler mis-compiled its own
    // source (peek/poke/alloc -> typed zero) so stage-2 was inert. peek64/poke64
    // reuse LOAD_IND/STORE_IND; byte/32 + bitwise use ops 29-36; alloc -> rtsym 5.
    if (handled == 0) {
        #req[txCirLoadInd] txCirLoadInd;
        #req[txCirStoreInd] txCirStoreInd;
        #req[txCirBitBin] txCirBitBin;
        #req[txCirPeekN] txCirPeekN;
        #req[txCirPokeN] txCirPokeN;
        #stack[int, 64] arg2 = 0;
        if (firstArg != 0) { arg2 = cssc::peek64(txAstNext + firstArg * 8); }
        txSpanIs(calleeOff, calleeLen, "cssc::peek64") isPk64;
        if (isPk64 == 1) { handled = 1; if (firstArg != 0) { txLowerExpr(firstArg) a; txCirLoadInd(a) v; out = v; #delete[v]; #delete[a]; } }
        #delete[isPk64];
        txSpanIs(calleeOff, calleeLen, "cssc::poke64") isPo64;
        if (isPo64 == 1) { handled = 1; if (arg2 != 0) { txLowerExpr(firstArg) a; txLowerExpr(arg2) v; txCirStoreInd(a, v); #delete[v]; #delete[a]; } }
        #delete[isPo64];
        txSpanIs(calleeOff, calleeLen, "cssc::peek8") isPk8;
        if (isPk8 == 1) { handled = 1; if (firstArg != 0) { txLowerExpr(firstArg) a; txCirPeekN(33, a) v; out = v; #delete[v]; #delete[a]; } }
        #delete[isPk8];
        txSpanIs(calleeOff, calleeLen, "cssc::poke8") isPo8;
        if (isPo8 == 1) { handled = 1; if (arg2 != 0) { txLowerExpr(firstArg) a; txLowerExpr(arg2) v; txCirPokeN(34, a, v); #delete[v]; #delete[a]; } }
        #delete[isPo8];
        txSpanIs(calleeOff, calleeLen, "cssc::peek32") isPk32;
        if (isPk32 == 1) { handled = 1; if (firstArg != 0) { txLowerExpr(firstArg) a; txCirPeekN(35, a) v; out = v; #delete[v]; #delete[a]; } }
        #delete[isPk32];
        txSpanIs(calleeOff, calleeLen, "cssc::poke32") isPo32;
        if (isPo32 == 1) { handled = 1; if (arg2 != 0) { txLowerExpr(firstArg) a; txLowerExpr(arg2) v; txCirPokeN(36, a, v); #delete[v]; #delete[a]; } }
        #delete[isPo32];
        txSpanIs(calleeOff, calleeLen, "cssc::band") isBand;
        if (isBand == 1) { handled = 1; if (arg2 != 0) { txLowerExpr(firstArg) a; txLowerExpr(arg2) b; txCirBitBin(29, a, b) v; out = v; #delete[v]; #delete[b]; #delete[a]; } }
        #delete[isBand];
        txSpanIs(calleeOff, calleeLen, "cssc::bor") isBor;
        if (isBor == 1) { handled = 1; if (arg2 != 0) { txLowerExpr(firstArg) a; txLowerExpr(arg2) b; txCirBitBin(30, a, b) v; out = v; #delete[v]; #delete[b]; #delete[a]; } }
        #delete[isBor];
        txSpanIs(calleeOff, calleeLen, "cssc::shl") isShl;
        if (isShl == 1) { handled = 1; if (arg2 != 0) { txLowerExpr(firstArg) a; txLowerExpr(arg2) b; txCirBitBin(31, a, b) v; out = v; #delete[v]; #delete[b]; #delete[a]; } }
        #delete[isShl];
        txSpanIs(calleeOff, calleeLen, "cssc::shr") isShr;
        if (isShr == 1) { handled = 1; if (arg2 != 0) { txLowerExpr(firstArg) a; txLowerExpr(arg2) b; txCirBitBin(32, a, b) v; out = v; #delete[v]; #delete[b]; #delete[a]; } }
        #delete[isShr];
        txSpanIs(calleeOff, calleeLen, "cssc::alloc") isAlloc;
        if (isAlloc == 1) { handled = 1; if (firstArg != 0) { txLowerExpr(firstArg) a; txCirCallR(5, a, 0 - 1) v; out = v; #delete[v]; #delete[a]; } }
        #delete[isAlloc];
        // host + output + float intrinsics: hostRead=rt42, free=rt43, printRaw=rt44,
        // memfill32=rt45, strToF=rt46 (added to cssc_rt_host.c); out=rt6; iToF=ITOF;
        // fDiv=FBINOP(/). These complete the surface the compiler is written in.
        #req[txCirCall] txCirCallI;
        #req[txCirCall3] txCirCall3I;
        #req[txCirIntToFloat] txCirIntToFloat;
        #req[txCirFBinOp] txCirFBinOp;
        #stack[int, 64] arg3 = 0;
        if (arg2 != 0) { arg3 = cssc::peek64(txAstNext + arg2 * 8); }
        txSpanIs(calleeOff, calleeLen, "cssc::out") isOut;
        if (isOut == 1) { handled = 1; if (firstArg != 0) { txLowerExpr(firstArg) a; txCirCallI(6, a, 0 - 1); #delete[a]; } }
        #delete[isOut];
        txSpanIs(calleeOff, calleeLen, "cssc::dbg") isDbg;   // stderr trace (rt47), self-host debugging
        if (isDbg == 1) { handled = 1; if (firstArg != 0) { txLowerExpr(firstArg) a; txCirCallI(47, a, 0 - 1); #delete[a]; } }
        #delete[isDbg];
        txSpanIs(calleeOff, calleeLen, "cssc::hostRead") isHR;
        if (isHR == 1) { handled = 1; if (arg2 != 0) { txLowerExpr(firstArg) a; txLowerExpr(arg2) b; txCirCallR(42, a, b) v; out = v; #delete[v]; #delete[b]; #delete[a]; } }
        #delete[isHR];
        txSpanIs(calleeOff, calleeLen, "cssc::modPath") isMP;   // #load: set path span verbatim
