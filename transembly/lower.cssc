        }
        #delete[slot];
        #delete[nLen];
        #delete[nOff];
        }                                             // end of `if (nsHandled == 0)`
        #delete[nsHandled];
    }
    if (kind == 6) {                                  // BINARY (arith/cmp/logical)
        #stack[int, 64] opc = cssc::peek64(txAstNum + node * 8);
        txLowerExpr(cssc::peek64(txAstA + node * 8)) lhs;
        txLowerExpr(cssc::peek64(txAstB + node * 8)) rhs;
        // M5: with a string operand, `+` is CONCATENATION and `==`/`!=` compare
        // TEXT (two equal strings are separate allocations, so the plain integer
        // compare would answer on pointers).
        #stack[int, 32] anyStr = 0;
        txIsStr(lhs) ls;
        txIsStr(rhs) rs;
        if (ls == 1) { anyStr = 1; }
        if (rs == 1) { anyStr = 1; }
        #delete[ls];
        #delete[rs];
        #stack[int, 32] isCat = 0;
        #stack[int, 32] isSEq = 0;
