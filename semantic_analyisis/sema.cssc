// ===========================================================================
//  compiler/sema.cssc  --  semantic analysis over the Transembly AST.
//
//  Read-only walker producing LSP diagnostics from the SAME AST the compiler
//  lowers (shared front-end: compiler + interpreter + LSP). No codegen.
//
//  Milestone 1 lint:  SELECT_WITHOUT_JUMP  --  a `select (...) ?label { ... }`
//  whose body contains no `jump`/`jump_back` (the cursor never advances).
//  Parity oracle: `cssc lsp diagnostics` (code SELECT_WITHOUT_JUMP, severity 1).
//
//  The walker is KIND-AWARE: it recurses ONLY through slots that hold real
//  child node ids (statement/block flow). B/C are FLAGS for some kinds
//  (INT float/bool, DECL member/elem, ...), so a blind A/B/C recursion would
//  misread a flag `1` as node id 1 (PROGRAM) and loop forever.
//
//  Emits one diagnostic per line:   line:col:severity:code
//  (line 1-indexed, col 0-indexed).  Concatenated after lex/ast/parse.
// ===========================================================================

// --- forward declarations (mutual recursion) --------------------------------
// deleted-set storage (shared by DOUBLE_DELETE + USE_AFTER_DELETE) — declared
// up front because CSSC resolves function references forward but NOT data-slot
// references, and the USE_AFTER_DELETE pass reads these before their section.
#stack[int, 64] txDdOff = 0;
#stack[int, 64] txDdLen = 0;
#stack[int, 64] txDdLine = 0;
#stack[int, 64] txDdCount = 0;
#stack[int, 64] txDdCap = 0;
// moddocs module-surface glue spans (forward-declared: txSignatureAt/txCompleteAt
// #req these but their helper #defines live further down, after txCompModuleNames).
#stack[int, 64] txMdModOff = 0;
#stack[int, 64] txMdModLen = 0;
#stack[int, 64] txMdCanOff = 0;
#stack[int, 64] txMdCanLen = 0;
#stack[int, 64] txMdRnOff = 0;     // a resolved receiver's yielding-callable name span
#stack[int, 64] txMdRnLen = 0;
// symbol table (same forward-ref reason).
#stack[int, 64] txSemaSymOff = 0;
#stack[int, 64] txSemaSymLen = 0;
#stack[int, 64] txSemaSymKind = 0;
#stack[int, 64] txSemaSymScope = 0;
#stack[int, 64] txSemaSymNode = 0;
#stack[int, 64] txSemaSymCount = 0;
#stack[int, 64] txSemaSymCap = 0;
#stack[int, 64] txSemaScopeNext = 0;
// scope-id -> owning object/sector name span (0 if the scope has no owner) so
// LIFETIME_LEAK can tell a member is freed when its object is (`#delete[Obj->m]`
// is stored by the parser as just `Obj`). OwnerKind: 3 object, 4 sector, 0 none.
#stack[int, 64] txSemaScopeOwnerOff = 0;
#stack[int, 64] txSemaScopeOwnerLen = 0;
#stack[int, 64] txSemaScopeOwnerKind = 0;
// scope tree for scope-aware (in-scope) variable completion: parent id, source
// line range, and isolation. is_isolating: function/object/label BLOCK outer
// lookup (outer names reachable only via `#req`); sector + root do NOT.
#stack[int, 64] txSemaScopeParent = 0;
#stack[int, 64] txSemaScopeStartLine = 0;
#stack[int, 64] txSemaScopeEndLine = 0;
#stack[int, 64] txSemaScopeIsolating = 0;
// per-symbol public flag (1 for sector public-section members; else 0).
#stack[int, 64] txSemaSymPub = 0;
// per-symbol object-type name span for instances (`Widget() w;` -> w's type is
// "Widget"); 0 len when the slot is not an object instance. Powers `w->`/`w.`.
#stack[int, 64] txSemaSymTypeOff = 0;
#stack[int, 64] txSemaSymTypeLen = 0;
// per-slot DECL type tag (DECL.Num: 0 int, 1 string, 2 float, 3 vector,
// 4 map, 5 bind); -1 for non-DECL slots. Powers `str.`/container-method
// completion. Default -1 (memfilled below is 0, set explicitly on DECL).
#stack[int, 64] txSemaSymDeclType = 0;
#stack[int, 64] txSemaLineOf;
#stack[int, 64] txSemaColOf;
#stack[int, 64] txSemaSelectKeyCol;
#stack[int, 64] txSemaHasJump;
#stack[int, 64] txSemaChainHasJump;
#stack[int, 64] txSemaEmitSelect;
#stack[int, 64] txSelCursEmit;
#stack[int, 64] txSelCursIsBare;
#stack[int, 64] txSelCursScan;
// visited-guard for the cursor-escape scan: a per-node generation stamp so the
// A/B/C+Next recursion visits each node exactly once (block bodies and sibling
// chains overlap in the flat AST, which otherwise re-walks nodes hundreds of
// times). Generation ++ per select -> no per-scan reset needed.
#stack[int, 64] txSelCursSeen = 0;
#stack[int, 64] txSelCursGen = 0;
// directory of the file being edited (set by the completion main from argv[1]) so
// `#load["rel/path.cssc"] alias;` completions resolve `alias::` -> that file's defs.
#stack[int, 64] txCompDirBuf = 0;
#stack[int, 64] txCompDirLen = 0;
#stack[int, 64] txCompLoadDefs;
// last `#load[path] alias` before the cursor whose alias matched (path span in
// txSrc), set by txLoadPathAt; valid only when it returns 1 (alias still loaded).
#stack[int, 64] txLoadPathO = 0;
#stack[int, 64] txLoadPathL = 0;
#stack[int, 64] txLoadPathAt;
#stack[int, 64] txSemaVisit;
#stack[int, 64] txSemaVisitChain;
#stack[int, 64] txSemaBuild;
// cross-file symbol resolution: names #define'd/#cdefine'd/sector/object in the
// SIBLING files of the analyzed file's project dir (passed as argv[2]). Lets the
// UNKNOWN_FUNCTION check resolve calls to functions defined in a concatenated
// module without a #load, and stay zero-FP.
#stack[int, 64] txExtBuf = 0;
#stack[int, 64] txExtLen = 0;
#stack[int, 64] txExtCap = 0;
#stack[int, 64] txHasProject = 0;
#stack[int, 64] txDirDeclBuf = 0;    // '\n'-joined names declared by container/
#stack[int, 64] txDirDeclLen = 0;    // peripheral directives the sema parser skips
#stack[int, 64] txExtInit;
#stack[int, 64] txExtAdd;
#stack[int, 64] txExtNamed;
#stack[int, 64] txLitAt;
#stack[int, 64] txScanDefs;
#stack[int, 64] txScanModMembers;
#stack[int, 64] txScanProject;
// 1 while emitting a signature label as HOVER text (suppress the "active:" line).
#stack[int, 64] txSigNoActive = 0;

// --- source-offset -> 1-indexed line ----------------------------------------
#define(txSemaLineOf) {
    #scanp(txSemaLineOf, int, 0) off;
    #req[txSrc] txSrc;
    #stack[int, 64] line = 1;
    #stack[int, 64] i = 0;
    #stack[int, 32] go = 1;
    while (go == 1) {
        if (i >= off) { go = 0; }
        if (go == 1) {
            if (cssc::peek8(txSrc + i) == 10) { line = line + 1; }
            i = i + 1;
        }
    }
    #delete[go];
    #delete[i];
    return line;
}

// --- source-offset -> 0-indexed column --------------------------------------
#define(txSemaColOf) {
    #scanp(txSemaColOf, int, 0) off;
    #req[txSrc] txSrc;
    #stack[int, 64] col = 0;
    #stack[int, 64] i = 0;
    #stack[int, 32] go = 1;
    while (go == 1) {
        if (i >= off) { go = 0; }
        if (go == 1) {
            if (cssc::peek8(txSrc + i) == 10) { col = 0; }
            if (cssc::peek8(txSrc + i) != 10) { col = col + 1; }
            i = i + 1;
        }
    }
    #delete[go];
    #delete[i];
    return col;
}

// --- column (0-indexed) of the `select` keyword on the line holding `off` ----
//  Matches the reference (`cssc lsp diagnostics` reports the keyword column,
//  not the ?label column that the SELECT node's Off/Len carries).
#define(txSemaSelectKeyCol) {
    #scanp(txSemaSelectKeyCol, int, 0) off;
    #req[txSrc] txSrc;
    #stack[int, 64] ls = off;
    #stack[int, 32] g1 = 1;
    while (g1 == 1) {
        if (ls == 0) { g1 = 0; }
        if (g1 == 1) {
            if (cssc::peek8(txSrc + ls - 1) == 10) { g1 = 0; }
            if (g1 == 1) { ls = ls - 1; }
        }
    }
    #delete[g1];
    #stack[int, 64] i = ls;
    #stack[int, 64] col = off - ls;
    #stack[int, 32] g2 = 1;
    while (g2 == 1) {
        if (i > off) { g2 = 0; }
        if (g2 == 1) {
            if (cssc::peek8(txSrc + i) == 115) {
                if (cssc::peek8(txSrc + i + 1) == 101) {
                    if (cssc::peek8(txSrc + i + 2) == 108) {
                        if (cssc::peek8(txSrc + i + 3) == 101) {
                            if (cssc::peek8(txSrc + i + 4) == 99) {
                                if (cssc::peek8(txSrc + i + 5) == 116) {
                                    col = i - ls;
                                    g2 = 0;
                                }
                            }
                        }
                    }
                }
            }
            if (g2 == 1) { i = i + 1; }
        }
    }
    #delete[g2];
    #delete[i];
    #delete[ls];
    return col;
}

// --- walk a Next-chain, return 1 if any subtree holds a JUMP -----------------
#define(txSemaChainHasJump) {
    #scanp(txSemaChainHasJump, int, 0) first;
    #req[txAstNext] txAstNext;
    #req[txSemaHasJump] txSemaHasJump;
    #stack[int, 64] found = 0;
    #stack[int, 64] s = first;
    #stack[int, 32] go = 1;
    while (go == 1) {
        if (s == 0) { go = 0; }
        if (found != 0) { go = 0; }
        if (go == 1) {
            txSemaHasJump(s) f;
            if (f != 0) { found = 1; }
            #delete[f];
            s = cssc::peek64(txAstNext + s * 8);
        }
    }
    #delete[go];
    #delete[s];
    return found;
}

// --- does the control-flow subtree at `node` contain a JUMP (kind 31)? -------
#define(txSemaHasJump) {
    #scanp(txSemaHasJump, int, 0) node;
    #req[txAstKind] txAstKind;
    #req[txAstA] txAstA;
    #req[txAstB] txAstB;
    #req[txAstC] txAstC;
    #req[txSemaChainHasJump] txSemaChainHasJump;
    #stack[int, 64] found = 0;
    if (node != 0) {
        #stack[int, 64] k = cssc::peek64(txAstKind + node * 8);
        if (k == 31) { found = 1; }                              // JUMP
        if (found == 0) {
            if (k == 1) { txSemaChainHasJump(cssc::peek64(txAstA + node * 8)) r; if (r != 0) { found = 1; } #delete[r]; }
            if (k == 12) { txSemaChainHasJump(cssc::peek64(txAstA + node * 8)) r; if (r != 0) { found = 1; } #delete[r]; }
        }
        if (found == 0) {
            if (k == 9) {                                        // IF: then/else
                txSemaChainHasJump(cssc::peek64(txAstB + node * 8)) rb; if (rb != 0) { found = 1; } #delete[rb];
                txSemaChainHasJump(cssc::peek64(txAstC + node * 8)) rc; if (rc != 0) { found = 1; } #delete[rc];
            }
        }
        if (found == 0) {
            if (k == 10) { txSemaChainHasJump(cssc::peek64(txAstB + node * 8)) r; if (r != 0) { found = 1; } #delete[r]; }
            if (k == 11) { txSemaChainHasJump(cssc::peek64(txAstC + node * 8)) r; if (r != 0) { found = 1; } #delete[r]; }
            if (k == 30) { txSemaChainHasJump(cssc::peek64(txAstB + node * 8)) r; if (r != 0) { found = 1; } #delete[r]; }
        }
        #delete[k];
    }
    return found;
}

// --- emit a SELECT_WITHOUT_JUMP diagnostic at `node`'s ?label position -------
#define(txSemaEmitSelect) {
    #scanp(txSemaEmitSelect, int, 0) node;
    #req[txAstOff] txAstOff;
    #req[txSemaLineOf] txSemaLineOf;
    #req[txSemaSelectKeyCol] txSemaSelectKeyCol;
    #stack[int, 64] off = cssc::peek64(txAstOff + node * 8);
    txSemaLineOf(off) line;
    txSemaSelectKeyCol(off) col;
    cssc::out(line);
    cssc::out(":");
    cssc::out(col);
    cssc::out(":1:SELECT_WITHOUT_JUMP:select has no jump so its body runs only once");
    cssc::outln();
    #delete[off];
    #delete[line];
    #delete[col];
}

// ===========================================================================
//  SELECT_CURSOR_ESCAPE -- the `?cursor` bound by a `select` is a BORROW into
//  the container element; it dies when the block ends. A bare (un-`&`-copied)
//  cursor that is PASSED to a call, STORED into a variable, RETURNed, or
//  MIRRORed lets that borrow outlive the loop. The fix is `&cursor` (a copy),
//  which parses as COPY(27) and is therefore never flagged. WARNING severity.
//  Read/compare uses (`if (cursor == x)`, `cursor.method()`) are in-place and
//  never escape, so they are left alone.
// ===========================================================================
#define(txSelCursEmit) {
    #scanp(txSelCursEmit, int, 0) node;
    #req[txAstOff] txAstOff;
    #req[txSemaLineOf] txSemaLineOf;
    #req[txSemaColOf] txSemaColOf;
    #stack[int, 64] off = cssc::peek64(txAstOff + node * 8);
    txSemaLineOf(off) line;
    txSemaColOf(off) col;
    cssc::out(line);
    cssc::out(":");
    cssc::out(col);
    cssc::out(":2:SELECT_CURSOR_ESCAPE:select cursor is borrowed not copied and dies after the block; pass &cursor to keep it");
    cssc::outln();
    #delete[off];
    #delete[line];
    #delete[col];
}

// 1 iff `node` is a bare IDENT(5) whose name span equals the cursor's.
#define(txSelCursIsBare) {
    #scanp(txSelCursIsBare, int, 0) node;
    #scanp(txSelCursIsBare, int, 1) curOff;
    #scanp(txSelCursIsBare, int, 2) curLen;
    #req[txAstKind] txAstKind;
    #req[txAstOff] txAstOff;
    #req[txAstLen] txAstLen;
    #req[txDdSpanEq] txDdSpanEq;
    #stack[int, 64] r = 0;
    if (node != 0) {
        if (cssc::peek64(txAstKind + node * 8) == 5) {
            txDdSpanEq(curOff, curLen, cssc::peek64(txAstOff + node * 8),
                       cssc::peek64(txAstLen + node * 8)) eq;
            if (eq == 1) { r = 1; }
            #delete[eq];
        }
    }
    #stack[int, 64] rr = r;
    #delete[r];
    return rr;
}

// Walk a body subtree; flag every escaping bare-cursor use. Recurses A/B/C and
// the Next sibling chain so each node is visited exactly once (a node is reached
// via one parent slot or one prev-sibling Next).
#define(txSelCursScan) {
    #scanp(txSelCursScan, int, 0) node;
    #scanp(txSelCursScan, int, 1) curOff;
    #scanp(txSelCursScan, int, 2) curLen;
    #req[txAstKind] txAstKind;
    #req[txAstA] txAstA;
    #req[txAstB] txAstB;
    #req[txAstC] txAstC;
    #req[txAstNum] txAstNum;
    #req[txAstNext] txAstNext;
    #req[txSelCursIsBare] txSelCursIsBare;
    #req[txSelCursEmit] txSelCursEmit;
    #req[txSelCursScan] txSelCursScan;
    #req[txSelCursSeen] txSelCursSeen;
    #req[txSelCursGen] txSelCursGen;
    if (node != 0) {
        // visited-guard: each node scanned at most once per generation. Without
        // this the A/B/C + Next recursion re-walks nested-block nodes hundreds of
        // times (flat statement chains overlap), flooding duplicate diagnostics.
        #stack[int, 32] proceed = 1;
        if (cssc::peek64(txSelCursSeen + node * 8) == txSelCursGen) { proceed = 0; }
        if (proceed == 1) {
            cssc::poke64(txSelCursSeen + node * 8, txSelCursGen);
            #stack[int, 64] k = cssc::peek64(txAstKind + node * 8);
            // Only GENUINE escapes are flagged: storing / returning / mirroring the
            // bare (un-`&`-copied) cursor lets its borrow outlive the block. A cursor
            // merely READ -- printed (`cssc::outln(cursor)`), compared, or method-called
            // -- never escapes, so call arguments are NOT flagged (matches the
            // reference oracle, which emits no SELECT_CURSOR_ESCAPE for such uses).
            if (k == 8) {                                          // ASSIGN: rhs = bare cursor -> stored borrow
                txSelCursIsBare(cssc::peek64(txAstA + node * 8), curOff, curLen) b8;
                if (b8 == 1) { txSelCursEmit(cssc::peek64(txAstA + node * 8)); }
                #delete[b8];
            }
            if (k == 20) {                                         // RETURN bare cursor (no '&') -> escaped borrow
                if (cssc::peek64(txAstNum + node * 8) != 1) {
                    txSelCursIsBare(cssc::peek64(txAstA + node * 8), curOff, curLen) b20;
                    if (b20 == 1) { txSelCursEmit(cssc::peek64(txAstA + node * 8)); }
                    #delete[b20];
                }
            }
            if (k == 32) {                                         // MIRROR bare cursor (no '&') -> escaped borrow
                if (cssc::peek64(txAstNum + node * 8) != 1) {
                    txSelCursIsBare(cssc::peek64(txAstA + node * 8), curOff, curLen) b32;
                    if (b32 == 1) { txSelCursEmit(cssc::peek64(txAstA + node * 8)); }
                    #delete[b32];
                }
            }
            txSelCursScan(cssc::peek64(txAstA + node * 8), curOff, curLen);
            txSelCursScan(cssc::peek64(txAstB + node * 8), curOff, curLen);
            txSelCursScan(cssc::peek64(txAstC + node * 8), curOff, curLen);
            txSelCursScan(cssc::peek64(txAstNext + node * 8), curOff, curLen);
            #delete[k];
        }
        #delete[proceed];
    }
}

// --- visit a Next-chain of statements ---------------------------------------
#define(txSemaVisitChain) {
    #scanp(txSemaVisitChain, int, 0) first;
    #req[txAstNext] txAstNext;
    #req[txSemaVisit] txSemaVisit;
    #stack[int, 64] s = first;
    #stack[int, 32] go = 1;
    while (go == 1) {
        if (s == 0) { go = 0; }
        if (go == 1) {
            txSemaVisit(s);
            s = cssc::peek64(txAstNext + s * 8);
        }
    }
    #delete[go];
    #delete[s];
}

// --- visit one node: lint SELECTs, recurse statement-flow children ----------
#define(txSemaVisit) {
    #scanp(txSemaVisit, int, 0) node;
    #req[txAstKind] txAstKind;
    #req[txAstA] txAstA;
    #req[txAstB] txAstB;
    #req[txAstC] txAstC;
    #req[txAstNum] txAstNum;
    #req[txAstOff] txAstOff;
    #req[txAstLen] txAstLen;
    #req[txSemaHasJump] txSemaHasJump;
    #req[txSemaEmitSelect] txSemaEmitSelect;
    #req[txSelCursScan] txSelCursScan;
    #req[txSemaVisitChain] txSemaVisitChain;
    if (node != 0) {
        #stack[int, 64] k = cssc::peek64(txAstKind + node * 8);
        if (k == 30) {                                          // SELECT
            txSemaHasJump(cssc::peek64(txAstB + node * 8)) hj;
            if (hj == 0) { txSemaEmitSelect(node); }
            #delete[hj];
            #stack[int, 64] cl = cssc::peek64(txAstLen + node * 8);
            if (cl > 0) {                                        // borrow-escape of the ?cursor
                #req[txSelCursGen] txSelCursGen;
                txSelCursGen = txSelCursGen + 1;                 // fresh generation for this scan
                txSelCursScan(cssc::peek64(txAstB + node * 8),
                              cssc::peek64(txAstOff + node * 8), cl);
            }
            #delete[cl];
        }
        // recurse only through statement-holding slots
        if (k == 1) { txSemaVisitChain(cssc::peek64(txAstA + node * 8)); }
        if (k == 12) { txSemaVisitChain(cssc::peek64(txAstA + node * 8)); }
        if (k == 17) { txSemaVisitChain(cssc::peek64(txAstA + node * 8)); }
        if (k == 9) {
            txSemaVisitChain(cssc::peek64(txAstB + node * 8));
            txSemaVisitChain(cssc::peek64(txAstC + node * 8));
        }
        if (k == 10) { txSemaVisitChain(cssc::peek64(txAstB + node * 8)); }
        if (k == 11) { txSemaVisitChain(cssc::peek64(txAstC + node * 8)); }
        if (k == 30) { txSemaVisitChain(cssc::peek64(txAstB + node * 8)); }
        if (k == 36) { txSemaVisitChain(cssc::peek64(txAstB + node * 8)); }
        if (k == 34) {
            txSemaVisitChain(cssc::peek64(txAstB + node * 8));
            txSemaVisitChain(cssc::peek64(txAstC + node * 8));
            txSemaVisitChain(cssc::peek64(txAstNum + node * 8));
        }
        if (k == 41) {
            txSemaVisitChain(cssc::peek64(txAstB + node * 8));
            txSemaVisitChain(cssc::peek64(txAstC + node * 8));
            txSemaVisitChain(cssc::peek64(txAstNum + node * 8));
        }
        #delete[k];
    }
}

// --- entry: analyze the whole program ---------------------------------------
// ===========================================================================
//  USE_AFTER_DELETE — a READ/WRITE of a name after its `#delete`/`#free` on the
//  same path. Chronological walk sharing the txDd* deleted-set (reset between
//  passes). Unlike DOUBLE_DELETE, child scopes INHERIT the deleted-set (a use
//  in a nested scope of an outer-freed name is caught); a delete inside a child
//  does not leak back (snapshot + truncate). Reads are found by walking every
//  expression subtree for identifiers. Parity oracle: `cssc lsp diagnostics`.
// ===========================================================================
#stack[int, 64] txDdReset;
#stack[int, 64] txUadCheck;
#stack[int, 64] txUadWalkExpr;
#stack[int, 64] txUadWalkExprChain;
#stack[int, 64] txUadWalkStmt;
#stack[int, 64] txUadWalkChain;

#define(txDdReset) {
    #req[txDdCount] txDdCount;
    txDdCount = 0;
}

// record a deletion for the UAD pass (update the line if already present)
#stack[int, 64] txUadMarkDel;
#define(txUadMarkDel) {
    #scanp(txUadMarkDel, int, 0) off;
    #scanp(txUadMarkDel, int, 1) len;
    #req[txDdLine] txDdLine;
    #req[txDdFind] txDdFind;
    #req[txDdAdd] txDdAdd;
    #req[txSemaLineOf] txSemaLineOf;
    txSemaLineOf(off) ln;
    txDdFind(off, len) idx;
    if (idx >= 0) { cssc::poke64(txDdLine + idx * 8, ln); }
    if (idx < 0) { txDdAdd(off, len, ln); }
    #delete[idx];
    #delete[ln];
}

// a name-read at (off,len): flag if the name is deleted and this read is later
#define(txUadCheck) {
    #scanp(txUadCheck, int, 0) off;
    #scanp(txUadCheck, int, 1) len;
    #req[txDdLine] txDdLine;
    #req[txDdFind] txDdFind;
    #req[txSemaLineOf] txSemaLineOf;
    #req[txSemaColOf] txSemaColOf;
    txDdFind(off, len) idx;
    if (idx >= 0) {
        txSemaLineOf(off) line;
        #stack[int, 64] dl = cssc::peek64(txDdLine + idx * 8);
        if (line > dl) {
            txSemaColOf(off) col;
            cssc::out(line);
            cssc::out(":");
            cssc::out(col);
            cssc::out(":1:USE_AFTER_DELETE:value is used after it was deleted or freed");
            cssc::outln();
            #delete[col];
        }
        #delete[line];
        #delete[dl];
    }
    #delete[idx];
}

#define(txUadWalkExprChain) {
    #scanp(txUadWalkExprChain, int, 0) first;
    #req[txAstNext] txAstNext;
    #req[txUadWalkExpr] txUadWalkExpr;
    #stack[int, 64] s = first;
    #stack[int, 32] go = 1;
    while (go == 1) {
        if (s == 0) { go = 0; }
        if (go == 1) {
            txUadWalkExpr(s);
            s = cssc::peek64(txAstNext + s * 8);
        }
    }
    #delete[go];
    #delete[s];
}

#define(txUadWalkExpr) {
    #scanp(txUadWalkExpr, int, 0) node;
    #req[txAstKind] txAstKind;
    #req[txAstA] txAstA;
    #req[txAstB] txAstB;
    #req[txAstC] txAstC;
    #req[txAstOff] txAstOff;
    #req[txAstLen] txAstLen;
    #req[txUadCheck] txUadCheck;
    #req[txUadWalkExprChain] txUadWalkExprChain;
    if (node != 0) {
        #stack[int, 64] k = cssc::peek64(txAstKind + node * 8);
        if (k == 5) {                                          // IDENT read
            txUadCheck(cssc::peek64(txAstOff + node * 8),
                       cssc::peek64(txAstLen + node * 8));
        }
        if (k == 14) {                                         // CALL callee + args
            txUadCheck(cssc::peek64(txAstOff + node * 8),
                       cssc::peek64(txAstLen + node * 8));
            txUadWalkExprChain(cssc::peek64(txAstA + node * 8));
        }
        if (k == 6) {
            txUadWalkExprChain(cssc::peek64(txAstA + node * 8));
            txUadWalkExprChain(cssc::peek64(txAstB + node * 8));
        }
        if (k == 13) { txUadWalkExprChain(cssc::peek64(txAstA + node * 8)); }
        if (k == 23) {
            txUadWalkExprChain(cssc::peek64(txAstB + node * 8));
            txUadWalkExprChain(cssc::peek64(txAstA + node * 8));
        }
        if (k == 25) {
            txUadWalkExprChain(cssc::peek64(txAstA + node * 8));
            txUadWalkExprChain(cssc::peek64(txAstB + node * 8));
        }
        if (k == 27) { txUadWalkExprChain(cssc::peek64(txAstA + node * 8)); }
        if (k == 38) { txUadWalkExprChain(cssc::peek64(txAstA + node * 8)); }
        if (k == 32) { txUadWalkExprChain(cssc::peek64(txAstA + node * 8)); }
        if (k == 22) { txUadWalkExprChain(cssc::peek64(txAstA + node * 8)); }
        if (k == 24) { txUadWalkExprChain(cssc::peek64(txAstA + node * 8)); }
        #delete[k];
    }
}

#define(txUadWalkChain) {
    #scanp(txUadWalkChain, int, 0) first;
    #req[txAstNext] txAstNext;
    #req[txUadWalkStmt] txUadWalkStmt;
    #stack[int, 64] s = first;
    #stack[int, 32] go = 1;
    while (go == 1) {
        if (s == 0) { go = 0; }
        if (go == 1) {
            txUadWalkStmt(s);
            s = cssc::peek64(txAstNext + s * 8);
        }
    }
    #delete[go];
    #delete[s];
}

#define(txUadWalkStmt) {
    #scanp(txUadWalkStmt, int, 0) node;
    #req[txAstKind] txAstKind;
    #req[txAstA] txAstA;
    #req[txAstB] txAstB;
    #req[txAstC] txAstC;
    #req[txAstNum] txAstNum;
    #req[txAstOff] txAstOff;
    #req[txAstLen] txAstLen;
    #req[txDdCount] txDdCount;
    #req[txUadMarkDel] txUadMarkDel;
    #req[txUadCheck] txUadCheck;
    #req[txUadWalkExpr] txUadWalkExpr;
    #req[txUadWalkExprChain] txUadWalkExprChain;
    #req[txDdRemove] txDdRemove;
    #req[txUadWalkChain] txUadWalkChain;
    if (node != 0) {
        #stack[int, 64] k = cssc::peek64(txAstKind + node * 8);
        #stack[int, 64] off = cssc::peek64(txAstOff + node * 8);
        #stack[int, 64] len = cssc::peek64(txAstLen + node * 8);
        if (k == 21) { txUadMarkDel(off, len); }               // DELETE
        if (k == 42) { txUadMarkDel(off, len); }               // FREE
        if (k == 7) {                                          // DECL: unshadow + init read
            txDdRemove(off, len);
            txUadWalkExprChain(cssc::peek64(txAstA + node * 8));
        }
        if (k == 8) {                                          // ASSIGN: write + rhs
            txUadCheck(off, len);
            txUadWalkExprChain(cssc::peek64(txAstA + node * 8));
        }
        if (k == 16) { txUadWalkExprChain(cssc::peek64(txAstA + node * 8)); }
        if (k == 20) { txUadWalkExprChain(cssc::peek64(txAstA + node * 8)); }
        if (k == 32) { txUadWalkExprChain(cssc::peek64(txAstA + node * 8)); }
        if (k == 14) { txUadWalkExpr(node); }                  // CALL as stmt
        if (k == 15) { txUadWalkExprChain(cssc::peek64(txAstA + node * 8)); }
        if (k == 39) {                                         // ARROWSET
            txUadWalkExprChain(cssc::peek64(txAstA + node * 8));
            txUadWalkExprChain(cssc::peek64(txAstB + node * 8));
        }
        if (k == 26) {                                         // INDEX_ASSIGN
            txUadWalkExprChain(cssc::peek64(txAstA + node * 8));
            txUadWalkExprChain(cssc::peek64(txAstB + node * 8));
            txUadWalkExprChain(cssc::peek64(txAstC + node * 8));
        }
        if (k == 9) {                                          // IF
            txUadWalkExprChain(cssc::peek64(txAstA + node * 8));
            #stack[int, 64] b1 = txDdCount;
            txUadWalkChain(cssc::peek64(txAstB + node * 8));
            txDdCount = b1;
            txUadWalkChain(cssc::peek64(txAstC + node * 8));
            txDdCount = b1;
            #delete[b1];
        }
        if (k == 10) {                                         // WHILE
            txUadWalkExprChain(cssc::peek64(txAstA + node * 8));
            #stack[int, 64] b = txDdCount;
            txUadWalkChain(cssc::peek64(txAstB + node * 8));
            txDdCount = b;
            #delete[b];
        }
        if (k == 11) {                                         // FOR
            txUadWalkStmt(cssc::peek64(txAstA + node * 8));
            txUadWalkExprChain(cssc::peek64(txAstB + node * 8));
            #stack[int, 64] b = txDdCount;
            txUadWalkChain(cssc::peek64(txAstC + node * 8));
            txUadWalkStmt(cssc::peek64(txAstNum + node * 8));
            txDdCount = b;
            #delete[b];
        }
        if (k == 30) {                                         // SELECT
            txUadWalkExprChain(cssc::peek64(txAstA + node * 8));
            #stack[int, 64] b = txDdCount;
            txUadWalkChain(cssc::peek64(txAstB + node * 8));
            txDdCount = b;
            #delete[b];
        }
        if (k == 12) {                                         // BLOCK
            #stack[int, 64] b = txDdCount;
            txUadWalkChain(cssc::peek64(txAstA + node * 8));
            txDdCount = b;
            #delete[b];
        }
        if (k == 17) {                                         // FUNC_DEF
            #stack[int, 64] b = txDdCount;
            txUadWalkChain(cssc::peek64(txAstA + node * 8));
            txDdCount = b;
            #delete[b];
        }
        if (k == 34) {                                         // OBJECT
            #stack[int, 64] b = txDdCount;
            txUadWalkChain(cssc::peek64(txAstB + node * 8));
            txUadWalkChain(cssc::peek64(txAstC + node * 8));
            txUadWalkChain(cssc::peek64(txAstNum + node * 8));
            txDdCount = b;
            #delete[b];
        }
        if (k == 41) {                                         // SECTOR
            #stack[int, 64] b = txDdCount;
            txUadWalkChain(cssc::peek64(txAstB + node * 8));
            txUadWalkChain(cssc::peek64(txAstC + node * 8));
            txUadWalkChain(cssc::peek64(txAstNum + node * 8));
            txDdCount = b;
            #delete[b];
        }
        if (k == 36) {                                         // LABELDEF
            #stack[int, 64] b = txDdCount;
            txUadWalkChain(cssc::peek64(txAstB + node * 8));
            txDdCount = b;
            #delete[b];
        }
        #delete[k];
        #delete[off];
        #delete[len];
    }
}

// ===========================================================================
//  LIFETIME_LEAK — a #stack slot in a NESTED scope, never #delete'd, that is
//  not a callable (var-is-function) and not a param. Root-scope slots are
//  module globals (reclaimed at program exit) so skipped, matching cssc_aware.
//  WARNING severity. (#auto leaks need #auto in the AST — S1, not yet parsed.)
// ===========================================================================
#stack[int, 64] txLeakAddDel;
#stack[int, 64] txLeakCollectDeletes;
#stack[int, 64] txLeakIsCallable;
#stack[int, 64] txSrcHasModule;
#stack[int, 64] txLeakScan;
#stack[int, 64] txDanglingScan;
#stack[int, 64] txUnknownVarWalk;
#stack[int, 64] txForInitNamed;
#stack[int, 64] txKnownName;
#stack[int, 64] txCollectDirDecls;
#stack[int, 64] txDirDeclNamed;
#stack[int, 64] txDeclBufAdd;

// Access-operator lints (need the symbol table + scope-owner-kind + resolver).
//   NS_ACCESS_ON_OBJECT  `Obj::m` / `inst::m()` — `::` used on an object.
//   DOT_ACCESS_ON_SECTOR `sec.m`               — `.` used on a sector.
// My front-end folds `::` into the IDENT token, so a `::` access is an IDENT
// (or CALL callee) whose name span contains "::"; a `.` access is METHOD_CALL(23).
#stack[int, 64] txAccessFindCC;
#stack[int, 64] txNsCheck;
#stack[int, 64] txAccessWalk;

// MISSING_SEMICOLON — a text/line lint (no AST): a code line that ends without
// a terminator/operator/continuation and whose next code line does not continue
// it. Mirrors lints._missing_semicolon_lint exactly (tables + column).
#stack[int, 64] txSpanEqLit;
#stack[int, 64] txIsStmtEndOk;
#stack[int, 64] txIsStmtOpOk;
#stack[int, 64] txMissingSemiScan;
#stack[int, 64] txBlankBlockComments;

// register a delete target: the full name AND (for `Obj->member`) the leaf
// member name after the last `->`, so an object-member DECL (stored as the bare
// leaf `member`) matches `#delete[Obj->member]`.
#define(txLeakAddDel) {
    #scanp(txLeakAddDel, int, 0) off;
    #scanp(txLeakAddDel, int, 1) len;
    #req[txSrc] txSrc;
    #req[txDdAdd] txDdAdd;
    txDdAdd(off, len, 0);
    #stack[int, 64] la = 0 - 1;
    #stack[int, 64] j = 0;
    #stack[int, 32] gg = 1;
    while (gg == 1) {
        if (j + 1 >= len) { gg = 0; }
        if (gg == 1) {
            if (cssc::peek8(txSrc + off + j) == 45) {
                if (cssc::peek8(txSrc + off + j + 1) == 62) { la = j; }
            }
            j = j + 1;
        }
    }
    if (la >= 0) { txDdAdd(off + la + 2, len - la - 2, 0); }
    #delete[la];
    #delete[j];
    #delete[gg];
}

// flat scan of every AST node: add each #delete/#free target name to txDd,
// forming the "ever deleted anywhere" membership set (scope/path-agnostic).
#define(txLeakCollectDeletes) {
    #req[txAstKind] txAstKind;
    #req[txAstOff] txAstOff;
    #req[txAstLen] txAstLen;
    #req[txAstCount] txAstCount;
    #req[txLeakAddDel] txLeakAddDel;
    #stack[int, 64] i = 1;
    #stack[int, 32] go = 1;
    while (go == 1) {
        if (i >= txAstCount) { go = 0; }
        if (go == 1) {
            #stack[int, 64] k = cssc::peek64(txAstKind + i * 8);
            if (k == 21) {
                txLeakAddDel(cssc::peek64(txAstOff + i * 8),
                             cssc::peek64(txAstLen + i * 8));
            }
            if (k == 42) {
                txLeakAddDel(cssc::peek64(txAstOff + i * 8),
                             cssc::peek64(txAstLen + i * 8));
            }
            #delete[k];
            i = i + 1;
        }
    }
    #delete[i];
    #delete[go];
}

// is there a callable (#define) with the same name + scope? (var-is-function)
#define(txLeakIsCallable) {
    #scanp(txLeakIsCallable, int, 0) off;
    #scanp(txLeakIsCallable, int, 1) len;
    #scanp(txLeakIsCallable, int, 2) scope;
    #req[txSemaSymOff] txSemaSymOff;
    #req[txSemaSymLen] txSemaSymLen;
    #req[txSemaSymKind] txSemaSymKind;
    #req[txSemaSymScope] txSemaSymScope;
    #req[txSemaSymCount] txSemaSymCount;
    #req[txDdSpanEq] txDdSpanEq;
    #stack[int, 64] r = 0;
    #stack[int, 64] i = 0;
    #stack[int, 32] go = 1;
    while (go == 1) {
        if (i >= txSemaSymCount) { go = 0; }
        if (go == 1) {
            #stack[int, 64] o = i * 8;
            if (cssc::peek64(txSemaSymKind + o) == 2) {
                if (cssc::peek64(txSemaSymScope + o) == scope) {
                    txDdSpanEq(off, len, cssc::peek64(txSemaSymOff + o),
                               cssc::peek64(txSemaSymLen + o)) eq;
                    if (eq == 1) { r = 1; go = 0; }
                    #delete[eq];
                }
            }
            #delete[o];
            if (go == 1) { i = i + 1; }
        }
    }
    #delete[i];
    #delete[go];
    return r;
}

// 1 if expression node `nd`, once any leading `&` (MIRROR) is stripped, is a bare
// IDENT whose name span == (off,len). The unit test both the direct `return name`
// and each element of a `return {..}` set are checked against.
#stack[int, 64] txRetIdentIs;
#define(txRetIdentIs) {
    #scanp(txRetIdentIs, int, 0) off;
    #scanp(txRetIdentIs, int, 1) len;
    #scanp(txRetIdentIs, int, 2) nd;
    #req[txAstKind] txAstKind;
    #req[txAstA] txAstA;
    #req[txAstOff] txAstOff;
    #req[txAstLen] txAstLen;
    #req[txDdSpanEq] txDdSpanEq;
    #stack[int, 32] r = 0;
    if (nd != 0) {
        #stack[int, 64] idn = nd;
        if (cssc::peek64(txAstKind + nd * 8) == 32) { idn = cssc::peek64(txAstA + nd * 8); }  // MIRROR &x -> inner
        if (idn != 0) {
            if (cssc::peek64(txAstKind + idn * 8) == 5) {         // IDENT
                txDdSpanEq(off, len, cssc::peek64(txAstOff + idn * 8), cssc::peek64(txAstLen + idn * 8)) eq;
                if (eq == 1) { r = 1; }
                #delete[eq];
            }
        }
        #delete[idn];
    }
    return r;
}

// 1 if `name` (off,len) is handed back by some `return name` / `return &name` /
// `return {.. name ..}` (a set/return-tuple). A returned slot's ownership passes
// to the caller, so it is NOT a leak. The `{..}` set parses to an ARRAY_LIT(22) /
// MAP_LIT(24) whose elements chain through Next (matching the Python reference,
// which treats any name in a return set as escaped).
#stack[int, 64] txNameReturned;
#define(txNameReturned) {
    #scanp(txNameReturned, int, 0) off;
    #scanp(txNameReturned, int, 1) len;
    #req[txAstKind] txAstKind;
    #req[txAstA] txAstA;
    #req[txAstNext] txAstNext;
    #req[txAstCount] txAstCount;
    #req[txRetIdentIs] txRetIdentIs;
    #stack[int, 32] r = 0;
    #stack[int, 64] i = 1;
    #stack[int, 32] go = 1;
    while (go == 1) {
        if (i >= txAstCount) { go = 0; }
        if (go == 1) {
            if (cssc::peek64(txAstKind + i * 8) == 20) {          // RETURN
                #stack[int, 64] a = cssc::peek64(txAstA + i * 8);
                if (a != 0) {
                    txRetIdentIs(off, len, a) d1;                 // return name; / return &name;
                    if (d1 == 1) { r = 1; }
                    #delete[d1];
                    #stack[int, 64] ak = cssc::peek64(txAstKind + a * 8);
                    if (ak == 22) { ak = 100; }                   // ARRAY_LIT  -> walk elements
                    if (ak == 24) { ak = 100; }                   // MAP_LIT    -> walk elements
                    if (ak == 100) {                              // return {.. name ..};
                        #stack[int, 64] e = cssc::peek64(txAstA + a * 8);
                        #stack[int, 32] eg = 1;
                        while (eg == 1) {
                            if (e == 0) { eg = 0; }
                            if (eg == 1) {
                                txRetIdentIs(off, len, e) de;
                                if (de == 1) { r = 1; }
                                #delete[de];
                                e = cssc::peek64(txAstNext + e * 8);
                            }
                        }
                        #delete[e];
                        #delete[eg];
                    }
                    #delete[ak];
                }
                #delete[a];
            }
            i = i + 1;
        }
    }
    #delete[i];
    #delete[go];
    return r;
}

// 1 if the source declares itself a module via a top-level `#MODULE;` directive.
// A module's GLOBALS (variables AND #include/#load imports) are owned by whoever
// #loaded it and are freed by that importer's #unload — so this file must not be
// nagged to free them (and the cleanup must not insert those frees). Scans the
// raw bytes (the parser skips unknown directives, leaving no AST node). The word
// boundary check keeps `#MODULES...` from matching.
#define(txSrcHasModule) {
    #req[txSrc] txSrc;
    #req[txSrcLen] txSrcLen;
    #req[txSpanEqLit] txSpanEqLit;
    #stack[int, 64] i = 0;
    #stack[int, 32] r = 0;
    #stack[int, 32] go = 1;
    while (go == 1) {
        if (i >= txSrcLen) { go = 0; }
        if (go == 1) {
            if (cssc::peek8(txSrc + i) == 35) {                 // '#'
                if (i + 7 <= txSrcLen) {
                    txSpanEqLit(i + 1, 6, "MODULE") m;
                    if (m == 1) {
                        #stack[int, 32] bound = 1;              // must not be part of a longer word
                        if (i + 7 < txSrcLen) {
                            #stack[int, 64] c = cssc::peek8(txSrc + i + 7);
                            if (c >= 65) { if (c <= 90) { bound = 0; } }
                            if (c >= 97) { if (c <= 122) { bound = 0; } }
                            if (c >= 48) { if (c <= 57) { bound = 0; } }
                            if (c == 95) { bound = 0; }
                            #delete[c];
                        }
                        if (bound == 1) { r = 1; go = 0; }
                        #delete[bound];
                    }
                    #delete[m];
                }
            }
            if (go == 1) { i = i + 1; }
        }
    }
    #delete[i];
    #delete[go];
    return r;
}

#define(txLeakScan) {
    #req[txSemaSymOff] txSemaSymOff;
    #req[txSemaSymLen] txSemaSymLen;
    #req[txSemaSymKind] txSemaSymKind;
    #req[txSemaSymScope] txSemaSymScope;
    #req[txSemaSymDeclType] txSemaSymDeclType;
    #req[txSemaSymCount] txSemaSymCount;
    #req[txDdFind] txDdFind;
    #req[txLeakIsCallable] txLeakIsCallable;
    #req[txSemaLineOf] txSemaLineOf;
    #req[txDdKeyCol] txDdKeyCol;
    #req[txSemaScopeOwnerOff] txSemaScopeOwnerOff;
    #req[txSemaScopeOwnerLen] txSemaScopeOwnerLen;
    #req[txSemaScopeOwnerKind] txSemaScopeOwnerKind;
    #req[txSemaSymNode] txSemaSymNode;
    #req[txAstKind] txAstKind;
    #req[txAstA] txAstA;
    #req[txAstOff] txAstOff;
    #req[txAstLen] txAstLen;
    #req[txAstNum] txAstNum;
    #req[txAstCount] txAstCount;
    #req[txScopeAt] txScopeAt;
    #req[txOwnResolve] txOwnResolve;
    #req[txOwnResolveAt] txOwnResolveAt;
    #req[txFuncIsRefRet] txFuncIsRefRet;
    #req[txNameReturned] txNameReturned;
    #req[txSrcHasModule] txSrcHasModule;
    txSrcHasModule() isMod;       // `#MODULE;` -> don't nag about global cleanup
    // SCOPE-AWARE deleted-set: for every #delete/#free node, resolve its target
    // to the specific in-scope symbol (txOwnResolve walks scope->parent) and mark
    // that symbol freed. This replaces the name-agnostic txDdFind self-check that
    // wrongly treated `x` here as deleted when a DIFFERENT scope's `x` was freed
    // (false negative on shadowed names). Matches the ownership map + the Python
    // reference. Owner-delete (object members) stays name-based below.
    #stack[int, 64] freed = cssc::alloc(txSemaSymCount * 8 + 8);
    #stack[int, 64] zj = 0;
    while (zj < txSemaSymCount) { cssc::poke64(freed + zj * 8, 0); zj = zj + 1; }
    #delete[zj];
    #stack[int, 64] di = 1;
    #stack[int, 32] dgo = 1;
    while (dgo == 1) {
        if (di >= txAstCount) { dgo = 0; }
        if (dgo == 1) {
            #stack[int, 64] dk = cssc::peek64(txAstKind + di * 8);
            #stack[int, 32] isdel = 0;
            if (dk == 21) { isdel = 1; }
            if (dk == 42) { isdel = 1; }
            if (isdel == 1) {
                #stack[int, 64] doff = cssc::peek64(txAstOff + di * 8);
                #stack[int, 64] dlen = cssc::peek64(txAstLen + di * 8);
                txSemaLineOf(doff) dline;
                txScopeAt(dline) dscope;
                txOwnResolveAt(doff, dlen, dscope, doff) gid;
                if (gid >= 0) { cssc::poke64(freed + gid * 8, 1); }
                #delete[doff];
                #delete[dlen];
                #delete[dline];
                #delete[dscope];
                #delete[gid];
            }
            // A standalone `mirror x` (or `mirror *x`) in REFERENCE form (Num==0)
            // hands its operand OUT — the caller references it, so the local is
            // intentionally not #delete'd and must NOT be flagged as a leak. The
            // `&`-copy form (Num==1) keeps the local owned, so it stays leak-checked.
            // `return` is handled separately by txNameReturned. Mirrors the escape
            // marking in txOwnershipEmit so sema_diag and sema_own agree.
            if (dk == 32) {
                if (cssc::peek64(txAstNum + di * 8) == 0) {
                    #stack[int, 64] mval = cssc::peek64(txAstA + di * 8);
                    if (mval != 0) {
                        if (cssc::peek64(txAstKind + mval * 8) == 5) {   // bare identifier operand
                            #stack[int, 64] moff = cssc::peek64(txAstOff + mval * 8);
                            #stack[int, 64] mlen = cssc::peek64(txAstLen + mval * 8);
                            txSemaLineOf(moff) mln;
                            txScopeAt(mln) msc;
                            txOwnResolveAt(moff, mlen, msc, moff) mgid;
                            if (mgid >= 0) { cssc::poke64(freed + mgid * 8, 1); }
                            #delete[mgid];
                            #delete[msc];
                            #delete[mln];
                            #delete[moff];
                            #delete[mlen];
                        }
                    }
                    #delete[mval];
                }
            }
            #delete[dk];
            #delete[isdel];
            di = di + 1;
        }
    }
    #delete[di];
    #delete[dgo];
    #stack[int, 64] i = 0;
    #stack[int, 32] go = 1;
    while (go == 1) {
        if (i >= txSemaSymCount) { go = 0; }
        if (go == 1) {
            #stack[int, 64] o = i * 8;
            #stack[int, 64] kind = cssc::peek64(txSemaSymKind + o);
            #stack[int, 64] scope = cssc::peek64(txSemaSymScope + o);
            if (kind == 1) {
                #stack[int, 64] dtm = cssc::peek64(txSemaSymDeclType + o);
                if (scope != 0) {
                    if (dtm != 9) {                        // module aliases -> MODULE_LEAK, not LIFETIME_LEAK
                    #stack[int, 64] off = cssc::peek64(txSemaSymOff + o);
                    #stack[int, 64] len = cssc::peek64(txSemaSymLen + o);
                    txLeakIsCallable(off, len, scope) callable;
                    #stack[int, 64] del = 0 - 1;
                    if (cssc::peek64(freed + i * 8) == 1) { del = 0; }   // scope-aware: this symbol was #delete/#free'd
                    // a SECTOR member is freed when its owning sector is (`#free[Sec]`
                    // runs the sector's free block). OBJECT members are NOT freed by
                    // deleting the object: `#delete[Obj->m]` frees the specific member
                    // (parser stores the member name), and `#delete[Obj]` leaves the
                    // members leaking -- matching the runtime + Python reference. So
                    // owner-free applies to sectors (ownerKind 4) only.
                    #stack[int, 64] ownerLen = cssc::peek64(txSemaScopeOwnerLen + scope * 8);
                    #stack[int, 64] ownerDel = 0 - 1;
                    if (cssc::peek64(txSemaScopeOwnerKind + scope * 8) == 4) {
                        if (ownerLen > 0) {
                            txDdFind(cssc::peek64(txSemaScopeOwnerOff + scope * 8), ownerLen) od;
                            ownerDel = od;
                            #delete[od];
                        }
                    }
                    // A result-capture of a ref-returning user #define is a
                    // borrow, not a leak (matches the ownership map).
                    #stack[int, 64] lsNode = cssc::peek64(txSemaSymNode + o);
                    #stack[int, 32] lsRef = 0;
                    if (lsNode != 0) {
                        if (cssc::peek64(txAstKind + lsNode * 8) == 15) {
                            #stack[int, 64] lcn = cssc::peek64(txAstA + lsNode * 8);
                            if (lcn != 0) {
                                txFuncIsRefRet(cssc::peek64(txAstOff + lcn * 8),
                                               cssc::peek64(txAstLen + lcn * 8)) lrr;
                                if (lrr == 1) { lsRef = 1; }
                                #delete[lrr];
                            }
                            #delete[lcn];
                        }
                    }
                    // A slot handed back via `return` transfers ownership to the
                    // caller (who deletes it) -> not a leak.
                    txNameReturned(off, len) retd;
                    if (callable == 0) {
                        if (del < 0) {
                            if (ownerDel < 0) {
                                if (lsRef == 0) {
                                    if (retd == 0) {
                                        txSemaLineOf(off) line;
                                        txDdKeyCol(off) col;
                                        cssc::out(line);
                                        cssc::out(":");
                                        cssc::out(col);
                                        cssc::out(":2:LIFETIME_LEAK:allocation is never deleted before its scope ends");
                                        cssc::outln();
                                        #delete[line];
                                        #delete[col];
                                    }
                                }
                            }
                        }
                    }
                    #delete[retd];
                    #delete[lsNode];
                    #delete[lsRef];
                    #delete[callable];
                    #delete[del];
                    #delete[ownerLen];
                    #delete[ownerDel];
                    #delete[off];
                    #delete[len];
                    }
                }
                if (dtm == 9) {                            // MODULE_LEAK: unfreed #include/#load/#depend (any scope)
                    #stack[int, 32] modSkip = 0;           // in a #MODULE file the importer's #unload frees globals
                    if (isMod == 1) { if (scope == 0) { modSkip = 1; } }
                    if (modSkip == 0) {
                    if (cssc::peek64(freed + i * 8) == 0) {  // scope-aware: not #free'd / #unload'd
                        #stack[int, 64] moff = cssc::peek64(txSemaSymOff + o);
                        txSemaLineOf(moff) mline;
                        txDdKeyCol(moff) mcol;
                        cssc::out(mline);
                        cssc::out(":");
                        cssc::out(mcol);
                        cssc::out(":2:MODULE_LEAK:included module is never freed; add #free or #unload");
                        cssc::outln();
                        #delete[mline];
                        #delete[mcol];
                        #delete[moff];
                    }
                    }
                    #delete[modSkip];
                }
                #delete[dtm];
            }
            #delete[kind];
            #delete[scope];
            #delete[o];
            if (go == 1) { i = i + 1; }
        }
    }
    #delete[i];
    #delete[go];
    #delete[freed];
}

// ===========================================================================
//  DANGLING_RETURN — `return x;` (no `&`) where x resolves to a NON-root owning
//  local/copy: the returned reference dies when the frame is popped. `return &x`
//  copies the value out and is safe (Num==1, skipped). A returned param (kind 5
//  borrow) or global (root scope) is fine. WARNING/error severity 1. New code,
//  not in the parity SEMA_CODES set -> parity-neutral.
// ===========================================================================
#define(txDanglingScan) {
    #req[txAstKind] txAstKind;
    #req[txAstA] txAstA;
    #req[txAstNum] txAstNum;
    #req[txAstOff] txAstOff;
    #req[txAstLen] txAstLen;
    #req[txAstCount] txAstCount;
    #req[txSemaLineOf] txSemaLineOf;
    #req[txSemaColOf] txSemaColOf;
    #req[txScopeAt] txScopeAt;
    #req[txOwnResolve] txOwnResolve;
    #req[txSemaSymScope] txSemaSymScope;
    #stack[int, 64] i = 1;
    #stack[int, 32] go = 1;
    while (go == 1) {
        if (i >= txAstCount) { go = 0; }
        if (go == 1) {
            if (cssc::peek64(txAstKind + i * 8) == 20) {          // RETURN
                if (cssc::peek64(txAstNum + i * 8) != 1) {         // not `return &x` (a copy)
                    #stack[int, 64] a = cssc::peek64(txAstA + i * 8);
                    if (a != 0) {
                        if (cssc::peek64(txAstKind + a * 8) == 5) {  // returns a bare IDENT
                            #stack[int, 64] noff = cssc::peek64(txAstOff + a * 8);
                            #stack[int, 64] nlen = cssc::peek64(txAstLen + a * 8);
                            txSemaLineOf(noff) rl;
                            txScopeAt(rl) rsc;
                            txOwnResolve(noff, nlen, rsc) gid;
                            if (gid >= 0) {
                                if (cssc::peek64(txSemaSymScope + gid * 8) != 0) {
                                    txSemaColOf(noff) col;
                                    cssc::out(rl);
                                    cssc::out(":");
                                    cssc::out(col);
                                    cssc::out(":3:DANGLING_RETURN:returns a local by reference — ownership passes to the caller, who must #delete it (watch for double-free); use return &value to hand back a copy instead");
                                    cssc::outln();
                                    #delete[col];
                                }
                            }
                            #delete[gid];
                            #delete[rl];
                            #delete[rsc];
                            #delete[noff];
                            #delete[nlen];
                        }
                    }
                    #delete[a];
                }
            }
            i = i + 1;
        }
    }
    #delete[i];
    #delete[go];
}

// ===========================================================================
//  DANGLING_STORE — a live reference to `x` is stored into a container `c`
//  (`c.push_back(x)` bare = ref, or `c.push_back(*x)`), then `x` is `#delete`d
//  while `c` is NEVER freed (it escapes / outlives the delete). In the cell
//  model a stored reference survives scope exit, so the ONLY way it dangles is
//  an explicit `#delete[x]` — after which `c` holds a reference reading 0x0.
//  `c.push_back(&x)` (COPY, kind 27) is safe and never flagged; a container
//  that is itself `#delete`d anywhere is assumed managed and suppressed (zero
//  FP against the registry pattern `g.push_back({*a, *b})`, whose referents
//  are params, and against `dump.push_back(&abs)` copies). WARNING severity 1.
//  New code, not in the parity SEMA_CODES set -> parity-neutral.
// ===========================================================================
#stack[int, 64] txDangStoreRefName;
// referent span carried by a store method's first arg, or -1 len if none.
// bare IDENT(5) => the name itself; `*x` parses as BINARY(6,op=3) with a null
// left and an IDENT right => the right operand's name; anything else => none.
#define(txDangStoreRefName) {
    #scanp(txDangStoreRefName, int, 0) arg;
    #req[txAstKind] txAstKind;
    #req[txAstA] txAstA;
    #req[txAstB] txAstB;
    #req[txAstNum] txAstNum;
    #req[txAstOff] txAstOff;
    #req[txAstLen] txAstLen;
    #stack[int, 64] r = 0 - 1;
    if (arg != 0) {
        #stack[int, 64] ak = cssc::peek64(txAstKind + arg * 8);
        if (ak == 5) { r = arg; }
        if (ak == 6) {
            if (cssc::peek64(txAstNum + arg * 8) == 3) {
                if (cssc::peek64(txAstA + arg * 8) == 0) {
                    #stack[int, 64] rb = cssc::peek64(txAstB + arg * 8);
                    if (rb != 0) {
                        if (cssc::peek64(txAstKind + rb * 8) == 5) { r = rb; }
                    }
                    #delete[rb];
                }
            }
        }
        #delete[ak];
    }
    return r;
}

#stack[int, 64] txDanglingStore;
#define(txDanglingStore) {
    #req[txAstKind] txAstKind;
    #req[txAstA] txAstA;
    #req[txAstB] txAstB;
    #req[txAstOff] txAstOff;
    #req[txAstLen] txAstLen;
    #req[txAstCount] txAstCount;
    #req[txMethodInLit] txMethodInLit;
    #req[txDdSpanEq] txDdSpanEq;
    #req[txSemaLineOf] txSemaLineOf;
    #req[txSemaColOf] txSemaColOf;
    #req[txDangStoreRefName] txDangStoreRefName;
    #req[txSrc] txSrc;
    #stack[int, 64] i = 1;
    #stack[int, 32] go = 1;
    while (go == 1) {
        if (i >= txAstCount) { go = 0; }
        if (go == 1) {
            if (cssc::peek64(txAstKind + i * 8) == 23) {          // METHOD_CALL
                #stack[int, 64] mo = cssc::peek64(txAstOff + i * 8);
                #stack[int, 64] ml = cssc::peek64(txAstLen + i * 8);
                txMethodInLit(mo, ml, "push_back\npush_front\ninsert\nappend\nset\nemplace_back\nemplace_front\npush\npushafter") isStore;
                if (isStore == 1) {
                    #stack[int, 64] recv = cssc::peek64(txAstB + i * 8);
                    #stack[int, 64] arg = cssc::peek64(txAstA + i * 8);
                    #stack[int, 32] ok = 0;
                    if (recv != 0) { if (cssc::peek64(txAstKind + recv * 8) == 5) { ok = 1; } }
                    if (ok == 1) {
                        txDangStoreRefName(arg) refn;
                        if (refn >= 0) {
                            #stack[int, 64] contOff = cssc::peek64(txAstOff + recv * 8);
                            #stack[int, 64] contLen = cssc::peek64(txAstLen + recv * 8);
                            #stack[int, 64] refOff = cssc::peek64(txAstOff + refn * 8);
                            #stack[int, 64] refLen = cssc::peek64(txAstLen + refn * 8);
                            txSemaLineOf(mo) storeLine;
                            // scan every DELETE: is the referent freed AFTER the
                            // store, and is the container itself ever freed?
                            #stack[int, 64] refDelOff = 0 - 1;
                            #stack[int, 64] refDelLine = 0;
                            #stack[int, 32] contFreed = 0;
                            #stack[int, 64] j = 1;
                            #stack[int, 32] jg = 1;
                            while (jg == 1) {
                                if (j >= txAstCount) { jg = 0; }
                                if (jg == 1) {
                                    if (cssc::peek64(txAstKind + j * 8) == 21) {   // DELETE
                                        #stack[int, 64] dOff = cssc::peek64(txAstOff + j * 8);
                                        #stack[int, 64] dLen = cssc::peek64(txAstLen + j * 8);
                                        txDdSpanEq(dOff, dLen, contOff, contLen) ceq;
                                        if (ceq == 1) { contFreed = 1; }
                                        #delete[ceq];
                                        txDdSpanEq(dOff, dLen, refOff, refLen) req0;
                                        if (req0 == 1) {
                                            txSemaLineOf(dOff) dl;
                                            if (dl > storeLine) { refDelOff = dOff; refDelLine = dl; }
                                            #delete[dl];
                                        }
                                        #delete[req0];
                                        #delete[dOff];
                                        #delete[dLen];
                                    }
                                    j = j + 1;
                                }
                            }
                            #delete[j];
                            #delete[jg];
                            if (contFreed == 0) {
                                if (refDelOff >= 0) {
                                    txSemaColOf(refDelOff) col;
                                    cssc::out(refDelLine);
                                    cssc::out(":");
                                    cssc::out(col);
                                    cssc::out(":3:DANGLING_STORE:deletes ");
                                    cssc::printRaw(txSrc + refOff, refLen);
                                    cssc::out(" while a live reference to it is held in ");
                                    cssc::printRaw(txSrc + contOff, contLen);
                                    cssc::out(" (never freed) — the stored reference dangles to 0x0; store a copy with &");
                                    cssc::printRaw(txSrc + refOff, refLen);
                                    cssc::out(" or free ");
                                    cssc::printRaw(txSrc + contOff, contLen);
                                    cssc::out(" first");
                                    cssc::outln();
                                    #delete[col];
                                }
                            }
                            #delete[contOff];
                            #delete[contLen];
                            #delete[refOff];
                            #delete[refLen];
                            #delete[storeLine];
                            #delete[refDelOff];
                            #delete[refDelLine];
                            #delete[contFreed];
                        }
                        #delete[refn];
                    }
                    #delete[recv];
                    #delete[arg];
                    #delete[ok];
                }
                #delete[isStore];
                #delete[mo];
                #delete[ml];
            }
            i = i + 1;
        }
    }
    #delete[i];
    #delete[go];
}

// index of the first ':' within the name span (off,len) => length of the part
// before "::"; -1 when the span has no "::". Identifiers only ever contain ':'
// as part of a folded "::", so the first ':' marks the namespace boundary.
#define(txAccessFindCC) {
    #scanp(txAccessFindCC, int, 0) off;
    #scanp(txAccessFindCC, int, 1) len;
    #req[txSrc] txSrc;
    #stack[int, 64] r = 0 - 1;
    #stack[int, 64] i = 0;
    #stack[int, 32] go = 1;
    while (go == 1) {
        if (i >= len) { go = 0; }
        if (go == 1) {
            if (cssc::peek8(txSrc + off + i) == 58) { r = i; go = 0; }   // ':'
            if (go == 1) { i = i + 1; }
        }
    }
    #delete[i];
    #delete[go];
    return r;
}

// If name span (off,len) is `LHS::...` where LHS resolves to an object type or
// instance, emit NS_ACCESS_ON_OBJECT at the qualifier's line:col.
#define(txNsCheck) {
    #scanp(txNsCheck, int, 0) off;
    #scanp(txNsCheck, int, 1) len;
    #req[txAccessFindCC] txAccessFindCC;
    #req[txResolveTypeScope] txResolveTypeScope;
    #req[txSemaLineOf] txSemaLineOf;
    #req[txSemaColOf] txSemaColOf;
    txAccessFindCC(off, len) cc;
    if (cc > 0) {
        txResolveTypeScope(off, cc, 1, 3) sc;
        if (sc != 0) {
            txSemaLineOf(off) ln;
            txSemaColOf(off) cl;
            cssc::out(ln); cssc::out(":"); cssc::out(cl);
            cssc::out(":1:NS_ACCESS_ON_OBJECT:used :: on an object; use -> for members or . for labels"); cssc::outln();
            #delete[ln];
            #delete[cl];
        }
        #delete[sc];
    }
    #delete[cc];
}

// Walk every AST node once for the two access-operator lints.
#define(txAccessWalk) {
    #req[txAstKind] txAstKind;
    #req[txAstOff] txAstOff;
    #req[txAstLen] txAstLen;
    #req[txAstB] txAstB;
    #req[txAstCount] txAstCount;
    #req[txNsCheck] txNsCheck;
    #req[txResolveTypeScope] txResolveTypeScope;
    #req[txSemaLineOf] txSemaLineOf;
    #req[txSemaColOf] txSemaColOf;
    #stack[int, 64] i = 1;
    #stack[int, 32] go = 1;
    while (go == 1) {
        if (i >= txAstCount) { go = 0; }
        if (go == 1) {
            #stack[int, 64] k = cssc::peek64(txAstKind + i * 8);
            if (k == 23) {                                    // METHOD_CALL `recv.member`
                #stack[int, 64] b = cssc::peek64(txAstB + i * 8);
                if (b != 0) {
                    if (cssc::peek64(txAstKind + b * 8) == 5) {    // IDENT receiver
                        #stack[int, 64] ro = cssc::peek64(txAstOff + b * 8);
                        #stack[int, 64] rl = cssc::peek64(txAstLen + b * 8);
                        txResolveTypeScope(ro, rl, 1, 4) ssc;      // resolves to a sector?
                        if (ssc != 0) {
                            txSemaLineOf(ro) ln;
                            txSemaColOf(ro) cl;
                            cssc::out(ln); cssc::out(":"); cssc::out(cl);
                            cssc::out(":1:DOT_ACCESS_ON_SECTOR:used . on a sector; use :: to access its members"); cssc::outln();
                            #delete[ln];
                            #delete[cl];
                        }
                        #delete[ssc];
                        #delete[ro];
                        #delete[rl];
                    }
                }
                #delete[b];
            }
            if (k == 5) { txNsCheck(cssc::peek64(txAstOff + i * 8), cssc::peek64(txAstLen + i * 8)); }   // IDENT `A::b`
            if (k == 14) { txNsCheck(cssc::peek64(txAstOff + i * 8), cssc::peek64(txAstLen + i * 8)); }  // CALL `A::b()`
            #delete[k];
            i = i + 1;
        }
    }
    #delete[i];
    #delete[go];
}

// exact match: span (off,len) == CSSC literal `lit`.
#define(txSpanEqLit) {
    #scanp(txSpanEqLit, int, 0) off;
    #scanp(txSpanEqLit, int, 1) len;
    #scanp(txSpanEqLit, string, 2) lit;
    #req[txSrc] txSrc;
    #stack[int, 64] sa = 0;
    #adress[lit] sa;
    #stack[int, 64] hdr = cssc::peek64(sa);
    #stack[int, 64] llen = cssc::peek32(hdr + 4);
    #stack[int, 64] ldata = hdr + 8;
    #stack[int, 64] r = 0;
    if (len == llen) {
        r = 1;
        #stack[int, 64] i = 0;
        #stack[int, 32] go = 1;
        while (go == 1) {
            if (i >= len) { go = 0; }
            if (go == 1) {
                if (cssc::peek8(txSrc + off + i) != cssc::peek8(ldata + i)) { r = 0; go = 0; }
                if (go == 1) { i = i + 1; }
            }
        }
        #delete[i];
        #delete[go];
    }
    #delete[sa];
    #delete[hdr];
    #delete[llen];
    #delete[ldata];
    return r;
}

// 1 if `c` is a statement terminator/opener that means "no missing `;`":  ; { } , ( [ :
#define(txIsStmtEndOk) {
    #scanp(txIsStmtEndOk, int, 0) c;
    #stack[int, 64] r = 0;
    if (c == 59) { r = 1; }
    if (c == 123) { r = 1; }
    if (c == 125) { r = 1; }
    if (c == 44) { r = 1; }
    if (c == 40) { r = 1; }
    if (c == 91) { r = 1; }
    if (c == 58) { r = 1; }
    return r;
}

// 1 if `c` is a binary/continuation operator char:  + - * / % < > = & | ^ ~ ! ?
#define(txIsStmtOpOk) {
    #scanp(txIsStmtOpOk, int, 0) c;
    #stack[int, 64] r = 0;
    if (c == 43) { r = 1; }
    if (c == 45) { r = 1; }
    if (c == 42) { r = 1; }
    if (c == 47) { r = 1; }
    if (c == 37) { r = 1; }
    if (c == 60) { r = 1; }
    if (c == 62) { r = 1; }
    if (c == 61) { r = 1; }
    if (c == 38) { r = 1; }
    if (c == 124) { r = 1; }
    if (c == 94) { r = 1; }
    if (c == 126) { r = 1; }
    if (c == 33) { r = 1; }
    if (c == 63) { r = 1; }
    return r;
}

// MISSING_SEMICOLON — one forward pass over the source. Each non-empty code
// line is held "pending" until the next non-empty code line is seen; the
// pending line is then judged against it (a continuation on the next line, or a
// terminator/operator end, or a header/#define, means no missing `;`). Comments
// and string literals are skipped inline (mirrors _code_only). Column = index
// of the last code char (== reference len(rstripped)-1).
#define(txMissingSemiScan) {
    #req[txSrc] txSrc;
    #req[txSrcLen] txSrcLen;
    #req[txIsStmtEndOk] txIsStmtEndOk;
    #req[txIsStmtOpOk] txIsStmtOpOk;
    #req[txSpanEqLit] txSpanEqLit;
    #stack[int, 64] n = txSrcLen;
    #stack[int, 64] pos = 0;
    #stack[int, 64] lineNo = 1;
    #stack[int, 32] pV = 0;                 // pending line valid?
    #stack[int, 64] pLine = 0;
    #stack[int, 64] pLastCol = 0;
    #stack[int, 64] pLast = 0;              // pending last code char
    #stack[int, 64] pHead = 0;             // 0 normal, 1 header-kw, 2 define
    #stack[int, 32] outer = 1;
    while (outer == 1) {
        #stack[int, 64] ls = pos;           // line [ls, le)
        #stack[int, 64] le = pos;
        #stack[int, 32] fe = 1;
        while (fe == 1) {
            if (le >= n) { fe = 0; }
            if (fe == 1) { if (cssc::peek8(txSrc + le) == 10) { fe = 0; } }
            if (fe == 1) { le = le + 1; }
        }
        #delete[fe];
        // scan the line: first/last code char (col), head word span
        #stack[int, 64] firstCol = 0 - 1;
        #stack[int, 64] firstCh = 0;
        #stack[int, 64] firstCh2 = 0;
        #stack[int, 64] lastCol = 0 - 1;
        #stack[int, 64] lastCh = 0;
        #stack[int, 64] headOff = 0;
        #stack[int, 32] inStr = 0;
        #stack[int, 64] j = ls;
        #stack[int, 32] sg = 1;
        while (sg == 1) {
            if (j >= le) { sg = 0; }
            if (sg == 1) {
                #stack[int, 64] c = cssc::peek8(txSrc + j);
                #stack[int, 32] isCode = 0;
                #stack[int, 32] wasStr = inStr;             // decide on the state at char START
                if (wasStr == 1) {
                    if (c == 92) { j = j + 1; }             // backslash escape: skip next
                    if (c == 34) { inStr = 0; }             // closing quote
                }
                if (wasStr == 0) {
                    if (c == 34) { inStr = 1; }             // opening quote
                    if (c == 47) {                          // '/' -> maybe '//'
                        if (j + 1 < le) {
                            if (cssc::peek8(txSrc + j + 1) == 47) { sg = 0; }   // comment: stop line
                        }
                    }
                    if (sg == 1) {                          // real code char (not quote/space/tab/CR)
                        if (c != 34) { if (c != 32) { if (c != 9) { if (c != 13) { isCode = 1; } } } }
                    }
                }
                #delete[wasStr];
                if (isCode == 1) {
                    #stack[int, 64] col = j - ls;
                    if (firstCol < 0) { firstCol = col; firstCh = c; headOff = j; }
                    if (firstCol >= 0) { if (lastCol < 0) { } }        // (first set)
                    if (firstCh2 == 0) { if (firstCol >= 0) { if (col > firstCol) { firstCh2 = c; } } }
                    lastCol = col;
                    lastCh = c;
                    #delete[col];
                }
                #delete[isCode];
                #delete[c];
                if (sg == 1) { j = j + 1; }
            }
        }
        #delete[j];
        #delete[sg];
        #delete[inStr];
        // head word kind (only if the first code char starts an identifier/#)
        #stack[int, 64] headKind = 0;
        if (firstCol >= 0) {
            #stack[int, 32] hok = 0;
            if (firstCh == 35) { hok = 1; }                 // '#'
            if (firstCh == 95) { hok = 1; }                 // '_'
            if (firstCh >= 65) { if (firstCh <= 90) { hok = 1; } }
            if (firstCh >= 97) { if (firstCh <= 122) { hok = 1; } }
            if (hok == 1) {
                #stack[int, 64] he = headOff + 1;           // head word end
                #stack[int, 32] wg = 1;
                while (wg == 1) {
                    if (he >= le) { wg = 0; }
                    if (wg == 1) {
                        #stack[int, 64] wc = cssc::peek8(txSrc + he);
                        #stack[int, 32] iw = 0;
                        if (wc == 95) { iw = 1; }
                        if (wc >= 48) { if (wc <= 57) { iw = 1; } }
                        if (wc >= 65) { if (wc <= 90) { iw = 1; } }
                        if (wc >= 97) { if (wc <= 122) { iw = 1; } }
                        if (iw == 0) { wg = 0; }
                        if (wg == 1) { he = he + 1; }
                        #delete[wc];
                        #delete[iw];
                    }
                }
                #delete[wg];
                #stack[int, 64] hlen = he - headOff;
                txSpanEqLit(headOff, hlen, "if") e1;       if (e1 == 1) { headKind = 1; } #delete[e1];
                txSpanEqLit(headOff, hlen, "else") e2;     if (e2 == 1) { headKind = 1; } #delete[e2];
                txSpanEqLit(headOff, hlen, "while") e3;    if (e3 == 1) { headKind = 1; } #delete[e3];
                txSpanEqLit(headOff, hlen, "for") e4;      if (e4 == 1) { headKind = 1; } #delete[e4];
                txSpanEqLit(headOff, hlen, "select") e5;   if (e5 == 1) { headKind = 1; } #delete[e5];
                txSpanEqLit(headOff, hlen, "sector") e6;   if (e6 == 1) { headKind = 1; } #delete[e6];
                txSpanEqLit(headOff, hlen, "object") e7;   if (e7 == 1) { headKind = 1; } #delete[e7];
                txSpanEqLit(headOff, hlen, "#define") e8;  if (e8 == 1) { headKind = 2; } #delete[e8];
                txSpanEqLit(headOff, hlen, "#cdefine") e9; if (e9 == 1) { headKind = 2; } #delete[e9];
                #delete[he];
                #delete[hlen];
            }
            #delete[hok];
        }
        // resolve the pending line against THIS line's first chars (if non-empty)
        if (firstCol >= 0) {
            if (pV == 1) {
                #stack[int, 32] skip = 0;
                txIsStmtEndOk(pLast) se;  if (se == 1) { skip = 1; } #delete[se];
                txIsStmtOpOk(pLast) so;   if (so == 1) { skip = 1; } #delete[so];
                if (pHead == 1) { skip = 1; }
                if (pHead == 2) { skip = 1; }
                if (pLast == 41) { if (firstCh == 123) { skip = 1; } }        // ...) then { -> header
                txIsStmtOpOk(firstCh) fo; if (fo == 1) { skip = 1; } #delete[fo];
                if (firstCh == 123) { skip = 1; }                            // {
                if (firstCh == 41) { skip = 1; }                            // )
                if (firstCh == 59) { skip = 1; }                            // ;
                if (firstCh == 46) { skip = 1; }                            // .
                if (firstCh == 93) { skip = 1; }                            // ]
                if (firstCh == 58) { if (firstCh2 == 58) { skip = 1; } }     // ::
                if (firstCh == 45) { if (firstCh2 == 62) { skip = 1; } }     // ->
                if (skip == 0) {
                    cssc::out(pLine); cssc::out(":"); cssc::out(pLastCol);
                    cssc::out(":1:MISSING_SEMICOLON:statement may be missing a semicolon"); cssc::outln();
                }
                #delete[skip];
            }
            pV = 1;
            pLine = lineNo;
            pLastCol = lastCol;
            pLast = lastCh;
            pHead = headKind;
        }
        #delete[firstCol];
        #delete[firstCh];
        #delete[firstCh2];
        #delete[lastCol];
        #delete[lastCh];
        #delete[headOff];
        #delete[headKind];
        #delete[ls];
        if (le >= n) { outer = 0; }
        pos = le + 1;
        lineNo = lineNo + 1;
        #delete[le];
    }
    // resolve the final pending line (no following code line)
    if (pV == 1) {
        #stack[int, 32] skip = 0;
        txIsStmtEndOk(pLast) se;  if (se == 1) { skip = 1; } #delete[se];
        txIsStmtOpOk(pLast) so;   if (so == 1) { skip = 1; } #delete[so];
        if (pHead == 1) { skip = 1; }
        if (pHead == 2) { skip = 1; }
        if (skip == 0) {
            cssc::out(pLine); cssc::out(":"); cssc::out(pLastCol);
            cssc::out(":1:MISSING_SEMICOLON:statement may be missing a semicolon"); cssc::outln();
        }
        #delete[skip];
    }
    #delete[outer];
    #delete[pV];
    #delete[pLine];
    #delete[pLastCol];
    #delete[pLast];
    #delete[pHead];
    #delete[lineNo];
    #delete[pos];
    #delete[n];
}

// SELECT_CURSOR_NO_QMARK — `select (…)` must be followed by a `?cursor`; the
// `?` is mandatory (the parser rejects `select (v) h {}` with "Expected
// QUESTION"). Flag a missing `?` as a squiggle instead of a hard compile error.
// A whole-source scan that skips "…" strings and // comments so `select` inside
// them is never matched; only fires when a `(` follows the keyword (a real
// select header), and every valid select in the corpus has `?` right after `)`.
#define(txSelectCursorScan) {
    #req[txSrc] txSrc;
    #req[txSrcLen] txSrcLen;
    #req[txSemaLineOf] txSemaLineOf;
    #req[txSemaColOf] txSemaColOf;
    #req[txSpanEqLit] txSpanEqLit;
    #stack[int, 64] n = txSrcLen;
    #stack[int, 64] i = 0;
    #stack[int, 32] inStr = 0;
    #stack[int, 32] go = 1;
    while (go == 1) {
        if (i >= n) { go = 0; }
        if (go == 1) {
            #stack[int, 64] c = cssc::peek8(txSrc + i);
            if (inStr == 1) {
                if (c == 92) { i = i + 1; }                     // escape: skip next
                if (c == 34) { inStr = 0; }                     // closing quote
            }
            if (inStr == 0) {
                if (c == 34) { inStr = 1; }                     // opening quote
                #stack[int, 32] skipped = 0;
                if (c == 47) {                                  // '/'
                    if (i + 1 < n) {
                        if (cssc::peek8(txSrc + i + 1) == 47) { // '//' -> to EOL
                            #stack[int, 32] sc = 1;
                            while (sc == 1) {
                                if (i >= n) { sc = 0; }
                                if (sc == 1) { if (cssc::peek8(txSrc + i) == 10) { sc = 0; } else { i = i + 1; } }
                            }
                            #delete[sc];
                            skipped = 1;
                        }
                    }
                }
                if (skipped == 0) { if (c == 115) {             // 's' -> maybe "select"
                    #stack[int, 32] wb = 1;                     // left word boundary?
                    if (i > 0) {
                        #stack[int, 64] pc = cssc::peek8(txSrc + i - 1);
                        if (pc >= 65) { if (pc <= 90) { wb = 0; } }
                        if (pc >= 97) { if (pc <= 122) { wb = 0; } }
                        if (pc >= 48) { if (pc <= 57) { wb = 0; } }
                        if (pc == 95) { wb = 0; }
                        #delete[pc];
                    }
                    if (wb == 1) {
                        txSpanEqLit(i, 6, "select") isSel;
                        if (isSel == 1) {
                            #stack[int, 64] aft = cssc::peek8(txSrc + i + 6);
                            #stack[int, 32] aw = 0;             // right word boundary?
                            if (aft >= 65) { if (aft <= 90) { aw = 1; } }
                            if (aft >= 97) { if (aft <= 122) { aw = 1; } }
                            if (aft >= 48) { if (aft <= 57) { aw = 1; } }
                            if (aft == 95) { aw = 1; }
                            if (aw == 0) {
                                // skip ws to the '(' that opens the header
                                #stack[int, 64] j = i + 6;
                                #stack[int, 32] fp = 1;
                                while (fp == 1) {
                                    if (j >= n) { fp = 0; }
                                    if (fp == 1) {
                                        #stack[int, 64] wc = cssc::peek8(txSrc + j);
                                        #stack[int, 32] ws = 0;
                                        if (wc == 32) { ws = 1; }
                                        if (wc == 9) { ws = 1; }
                                        if (wc == 13) { ws = 1; }
                                        if (wc == 10) { ws = 1; }
                                        if (ws == 1) { j = j + 1; } else { fp = 0; }
                                        #delete[wc];
                                        #delete[ws];
                                    }
                                }
                                #delete[fp];
                                if (j < n) {
                                    if (cssc::peek8(txSrc + j) == 40) {     // '(' -> a select header
                                        #stack[int, 64] depth = 1;
                                        #stack[int, 64] k = j + 1;
                                        #stack[int, 32] mg = 1;
                                        while (mg == 1) {
                                            if (k >= n) { mg = 0; }
                                            if (mg == 1) {
                                                #stack[int, 64] kc = cssc::peek8(txSrc + k);
                                                if (kc == 40) { depth = depth + 1; }
                                                if (kc == 41) { depth = depth - 1; if (depth == 0) { mg = 0; } }
                                                #delete[kc];
                                                if (mg == 1) { k = k + 1; }
                                            }
                                        }
                                        #delete[mg];
                                        // skip ws (and // comments) after ')'
                                        #stack[int, 64] a = k + 1;
                                        #stack[int, 32] fa = 1;
                                        while (fa == 1) {
                                            if (a >= n) { fa = 0; }
                                            if (fa == 1) {
                                                #stack[int, 64] ac = cssc::peek8(txSrc + a);
                                                #stack[int, 32] adv = 0;
                                                if (ac == 32) { adv = 1; }
                                                if (ac == 9) { adv = 1; }
                                                if (ac == 13) { adv = 1; }
                                                if (ac == 10) { adv = 1; }
                                                if (ac == 47) { if (a + 1 < n) { if (cssc::peek8(txSrc + a + 1) == 47) {
                                                    #stack[int, 32] cc = 1;
                                                    while (cc == 1) {
                                                        if (a >= n) { cc = 0; }
                                                        if (cc == 1) { if (cssc::peek8(txSrc + a) == 10) { cc = 0; } else { a = a + 1; } }
                                                    }
                                                    #delete[cc];
                                                    adv = 2;
                                                } } }
                                                if (adv == 1) { a = a + 1; }
                                                if (adv == 0) { fa = 0; }
                                                #delete[ac];
                                                #delete[adv];
                                            }
                                        }
                                        #delete[fa];
                                        if (a < n) {
                                            if (cssc::peek8(txSrc + a) != 63) {   // not '?'
                                                txSemaLineOf(a) ln;
                                                txSemaColOf(a) cl;
                                                cssc::out(ln); cssc::out(":"); cssc::out(cl);
                                                cssc::out(":1:SELECT_CURSOR_NO_QMARK:select cursor must be written ?name; the ? is required"); cssc::outln();
                                                #delete[ln];
                                                #delete[cl];
                                            }
                                        }
                                        #delete[a];
                                        #delete[depth];
                                        #delete[k];
                                    }
                                }
                                #delete[j];
                            }
                            #delete[aft];
                            #delete[aw];
                        }
                        #delete[isSel];
                    }
                    #delete[wb];
                } }
                #delete[skipped];
            }
            #delete[c];
            if (go == 1) { i = i + 1; }
        }
    }
    #delete[i];
    #delete[inStr];
    #delete[n];
}

// Exact (case-sensitive) membership: is span(off,len) one of the '\n'-separated
// names in `lit`? Returns 1/0. (txSpanEqLit but over a set of literals.)
#define(txMethodInLit) {
    #scanp(txMethodInLit, int, 0) off;
    #scanp(txMethodInLit, int, 1) len;
    #scanp(txMethodInLit, string, 2) lit;
    #req[txSrc] txSrc;
    #stack[int, 64] sa = 0;
    #adress[lit] sa;
    #stack[int, 64] hdr = cssc::peek64(sa);
    #stack[int, 64] llen = cssc::peek32(hdr + 4);
    #stack[int, 64] ldata = hdr + 8;
    #stack[int, 64] r = 0;
    #stack[int, 64] i = 0;
    while (i < llen) {
        #stack[int, 64] j = i;
        #stack[int, 32] sg = 1;
        while (sg == 1) {
            if (j >= llen) { sg = 0; }
            if (sg == 1) { if (cssc::peek8(ldata + j) == 10) { sg = 0; } else { j = j + 1; } }
        }
        #delete[sg];
        #stack[int, 64] seglen = j - i;
        if (seglen == len) {
            #stack[int, 32] eq = 1;
            #stack[int, 64] k = 0;
            #stack[int, 32] mg = 1;
            while (mg == 1) {
                if (k >= len) { mg = 0; }
                if (mg == 1) {
                    if (cssc::peek8(txSrc + off + k) != cssc::peek8(ldata + i + k)) { eq = 0; mg = 0; }
                    if (mg == 1) { k = k + 1; }
                }
            }
            #delete[k];
            #delete[mg];
            if (eq == 1) { r = 1; }
            #delete[eq];
        }
        #delete[seglen];
        i = j + 1;
    }
    #delete[i];
    #delete[sa];
    #delete[hdr];
    #delete[llen];
    #delete[ldata];
    return r;
}

// 1 if the name span (qOff,qLen) is a SELECT cursor — a symbol whose declaring
// node is a SELECT (kind 30), i.e. `select (it) ?cursor { ... }`. A cursor is
// NOT the container: its VALUE is the current element AND it carries the special
// `cursor.pos()` index form (interpreter cssl_cssc.py ~9984). It is registered
// (kind 7) with declType inherited from the container so `cursor.<elemMethod>`
// completes -- but that same inheritance makes the container's method surface
// wrong for method-EXISTENCE checking (pos() is neither a vector nor a string
// method). So method-checking skips cursor receivers ("if unsure, show nothing").
#stack[int, 64] txNameIsCursor;
#define(txNameIsCursor) {
    #scanp(txNameIsCursor, int, 0) qOff;
    #scanp(txNameIsCursor, int, 1) qLen;
    #req[txSemaSymOff] txSemaSymOff;
    #req[txSemaSymLen] txSemaSymLen;
    #req[txSemaSymNode] txSemaSymNode;
    #req[txSemaSymCount] txSemaSymCount;
    #req[txAstKind] txAstKind;
    #req[txDdSpanEq] txDdSpanEq;
    #stack[int, 32] r = 0;
    #stack[int, 64] i = 0;
    #stack[int, 32] go = 1;
    while (go == 1) {
        if (i >= txSemaSymCount) { go = 0; }
        if (go == 1) {
            #stack[int, 64] o = i * 8;
            txDdSpanEq(qOff, qLen, cssc::peek64(txSemaSymOff + o), cssc::peek64(txSemaSymLen + o)) me;
            if (me == 1) {
                #stack[int, 64] nd = cssc::peek64(txSemaSymNode + o);
                if (nd != 0) {
                    if (cssc::peek64(txAstKind + nd * 8) == 30) { r = 1; go = 0; }
                }
                #delete[nd];
            }
            #delete[me];
            #delete[o];
            if (go == 1) { i = i + 1; }
        }
    }
    #delete[i];
    #delete[go];
    return r;
}

// NO_SUCH_METHOD — a `.method()` whose receiver is a variable of a KNOWN
// built-in type (string/vector/map/bind) but `method` is in none of that
// type's real methods. Allowlists = the interpreter's method-dispatch keys
// (cssl_cssc.py sm/lm/dm) UNION the Python str/list/dict builtins reachable via
// its getattr fallback — so every method valid in ANY backend is allowed and
// only a genuinely non-existent name (a typo like `.frobnicate()`) is flagged.
// Objects, sectors, `auto`, scalars, and chained-call receivers resolve outside
// {1,3,4,5} and are never checked ("if unsure, show nothing").
#define(txMethodCheckWalk) {
    #req[txAstKind] txAstKind;
    #req[txAstOff] txAstOff;
    #req[txAstLen] txAstLen;
    #req[txAstB] txAstB;
    #req[txAstCount] txAstCount;
    #req[txSlotDeclType] txSlotDeclType;
    #req[txMethodInLit] txMethodInLit;
    #req[txNameIsCursor] txNameIsCursor;
    #req[txSemaLineOf] txSemaLineOf;
    #req[txSemaColOf] txSemaColOf;
    #req[txSrc] txSrc;
    #stack[int, 64] i = 1;
    #stack[int, 32] go = 1;
    while (go == 1) {
        if (i >= txAstCount) { go = 0; }
        if (go == 1) {
            if (cssc::peek64(txAstKind + i * 8) == 23) {          // METHOD_CALL
                #stack[int, 64] b = cssc::peek64(txAstB + i * 8);
                if (b != 0) {
                    if (cssc::peek64(txAstKind + b * 8) == 5) {   // IDENT receiver
                        #stack[int, 64] ro = cssc::peek64(txAstOff + b * 8);
                        #stack[int, 64] rl = cssc::peek64(txAstLen + b * 8);
                        txNameIsCursor(ro, rl) rcur;
                        txSlotDeclType(ro, rl) dt;
                        #stack[int, 64] mo = cssc::peek64(txAstOff + i * 8);
                        #stack[int, 64] ml = cssc::peek64(txAstLen + i * 8);
                        #stack[int, 32] bad = 0;
                        #stack[int, 64] tnOff = 0;
                        #stack[int, 64] tnLen = 0;
                        if (dt == 1) {
                            txMethodInLit(mo, ml, "append\nlength\nsize\nbegin\nend\nfront\nback\ndata\ncapacity\nupper\nlower\ntrim\nsplit\nreplace\ncontains\nstarts_with\nstartsWith\nends_with\nendsWith\nindex_of\nindexOf\nindex\ncharAt\nsubstr\nsubstring\nreverse\nrepeat\npadStart\npadEnd\nisEmpty\nisDigit\nisAlpha\ntoInt\ntoFloat\nexists\ncapitalize\ncasefold\ncenter\ncount\nencode\nendswith\nexpandtabs\nfind\nformat\nformat_map\nisalnum\nisalpha\nisascii\nisdecimal\nisdigit\nisidentifier\nislower\nisnumeric\nisprintable\nisspace\nistitle\nisupper\njoin\nljust\nlstrip\nmaketrans\npartition\nremoveprefix\nremovesuffix\nrfind\nrindex\nrjust\nrpartition\nrsplit\nrstrip\nsplitlines\nstartswith\nstrip\nswapcase\ntitle\ntranslate\nzfill") ins;
                            if (ins == 0) { bad = 1; }
                            #delete[ins];
                        }
                        if (dt == 3) {
                            txMethodInLit(mo, ml, "get\npush\npop\nsize\nlength\ncontains\nindexOf\nclear\nsort\nreverse\nappend\natIndex\ntakeout\npushafter\nnotAtIndex\nremove\ninsert\nslice\njoin\nfirst\nlast\nempty\nflat\nunique\ncount\nexists\npush_back\npush_front\npop_back\npop_front\nemplace_back\nemplace_front\nfront\nback\nbegin\nend\nrbegin\nrend\nat\nerase\nresize\ncapacity\ndata\nswap\ncopy\nextend\nindex\nset\nhas") inv;
                            if (inv == 0) { bad = 1; }
                            #delete[inv];
                        }
                        if (dt == 4) {
                            txMethodInLit(mo, ml, "get\nset\nhas\nkeys\nvalues\nitems\nremove\nsize\nlength\nclear\nexists\nempty\nbegin\nend\nfront\nback\nat\nappend\nmerge\nupdate\ncontains\ncount\ncopy\nfromkeys\npop\npopitem\nsetdefault") inm;
                            if (inm == 0) { bad = 1; }
                            #delete[inm];
                        }
                        if (dt == 5) {
                            txMethodInLit(mo, ml, "get\npush\npop\nsize\nlength\nwidth\npair_width\ncontains\nindexOf\nclear\nsort\nreverse\nappend\natIndex\ntakeout\npushafter\nnotAtIndex\nremove\ninsert\nslice\njoin\nfirst\nlast\nempty\nflat\nunique\ncount\nexists\npush_back\npush_front\npop_back\npop_front\nemplace_back\nemplace_front\nfront\nback\nbegin\nend\nrbegin\nrend\nat\nerase\nresize\ncapacity\ndata\nswap\ncopy\nextend\nindex\naddmap\nset\nhas\nkeys\nvalues") inb;
                            if (inb == 0) { bad = 1; }
                            #delete[inb];
                        }
                        if (rcur == 1) { bad = 0; }          // select cursor -> never method-checked
                        txMethodInLit(mo, ml, "declared") mdec;   // universal on every type
                        if (mdec == 1) { bad = 0; }
                        #delete[mdec];
                        if (bad == 1) {
                            txSemaLineOf(mo) ln;
                            txSemaColOf(mo) cl;
                            cssc::out(ln); cssc::out(":"); cssc::out(cl);
                            cssc::out(":1:NO_SUCH_METHOD:no method ");
                            cssc::printRaw(txSrc + mo, ml);
                            if (dt == 1) { cssc::out(" on string"); }
                            if (dt == 3) { cssc::out(" on vector"); }
                            if (dt == 4) { cssc::out(" on map"); }
                            if (dt == 5) { cssc::out(" on bind"); }
                            cssc::outln();
                            #delete[ln];
                            #delete[cl];
                        }
                        #delete[rcur];
                        #delete[bad];
                        #delete[tnOff];
                        #delete[tnLen];
                        #delete[dt];
                        #delete[mo];
                        #delete[ml];
                        #delete[ro];
                        #delete[rl];
                    }
                }
                #delete[b];
            }
            i = i + 1;
        }
    }
    #delete[i];
    #delete[go];
}

// 1 if some symbol in the table is named exactly span(off,len) — ANY kind
// (slot / param / #req / object / sector). Used to suppress unknown-function
// flags on a bare call to a variable that holds a callable (`n()`).
#define(txSymNamed) {
    #scanp(txSymNamed, int, 0) off;
    #scanp(txSymNamed, int, 1) len;
    #req[txSemaSymOff] txSemaSymOff;
    #req[txSemaSymLen] txSemaSymLen;
    #req[txSemaSymCount] txSemaSymCount;
    #req[txDdSpanEq] txDdSpanEq;
    #stack[int, 64] r = 0;
    #stack[int, 64] i = 0;
    #stack[int, 32] go = 1;
    while (go == 1) {
        if (i >= txSemaSymCount) { go = 0; }
        if (go == 1) {
            #stack[int, 64] sl = cssc::peek64(txSemaSymLen + i * 8);
            if (sl == len) {
                txDdSpanEq(off, len, cssc::peek64(txSemaSymOff + i * 8), sl) eq;
                if (eq == 1) { r = 1; go = 0; }
                #delete[eq];
            }
            #delete[sl];
            if (go == 1) { i = i + 1; }
        }
    }
    #delete[i];
    #delete[go];
    return r;
}

// Like txSymNamed, but SKIPS the symbol declared by AST node `excl`. Used by the
// `#req[X] Y` target check: `#req` registers its own alias Y as a symbol, so a
// plain name lookup of the target X finds that alias when X==Y and wrongly
// concludes X exists (the vanishing-squiggle bug). Excluding this #req's own
// node makes the check ask "does X exist SOMEWHERE ELSE?".
#stack[int, 64] txSymNamedExcl;
#define(txSymNamedExcl) {
    #scanp(txSymNamedExcl, int, 0) off;
    #scanp(txSymNamedExcl, int, 1) len;
    #scanp(txSymNamedExcl, int, 2) excl;
    #req[txSemaSymOff] txSemaSymOff;
    #req[txSemaSymLen] txSemaSymLen;
    #req[txSemaSymNode] txSemaSymNode;
    #req[txSemaSymCount] txSemaSymCount;
    #req[txDdSpanEq] txDdSpanEq;
    #stack[int, 64] r = 0;
    #stack[int, 64] i = 0;
    #stack[int, 32] go = 1;
    while (go == 1) {
        if (i >= txSemaSymCount) { go = 0; }
        if (go == 1) {
            if (cssc::peek64(txSemaSymNode + i * 8) != excl) {
                #stack[int, 64] sl = cssc::peek64(txSemaSymLen + i * 8);
                if (sl == len) {
                    txDdSpanEq(off, len, cssc::peek64(txSemaSymOff + i * 8), sl) eq;
                    if (eq == 1) { r = 1; go = 0; }
                    #delete[eq];
                }
                #delete[sl];
            }
            if (go == 1) { i = i + 1; }
        }
    }
    #delete[i];
    #delete[go];
    return r;
}

// 1 if the source contains a `#load` directive. A #load pulls in symbols from
// another file, so a bare call could resolve there — while any #load is present
// we suppress unknown-function flags entirely (cross-file resolution is future
// work; "if unsure, show nothing").
#define(txHasLoad) {
    #req[txSrc] txSrc;
    #req[txSrcLen] txSrcLen;
    #req[txSpanEqLit] txSpanEqLit;
    #stack[int, 64] n = txSrcLen;
    #stack[int, 64] i = 0;
    #stack[int, 64] r = 0;
    #stack[int, 32] go = 1;
    while (go == 1) {
        if (i >= n) { go = 0; }
        if (go == 1) {
            if (cssc::peek8(txSrc + i) == 35) {                 // '#'
                txSpanEqLit(i + 1, 4, "load") isl;
                if (isl == 1) { r = 1; go = 0; }
                #delete[isl];
            }
            if (go == 1) { i = i + 1; }
        }
    }
    #delete[i];
    #delete[go];
    #delete[n];
    return r;
}

// UNKNOWN_FUNCTION — a bare `foo()` call whose name resolves to NOTHING: not a
// user `#define` (callable scope), not an object/sector type, not any declared
// symbol (a callable variable), and not one of the bare builtin functions
// (cssl_cssc.py `_ns_builtins`). Qualified calls (`cssc::x()`, `Sec::x()`) carry
// a `::` and are skipped. Suppressed entirely when a `#load` is present.
#define(txUnknownFuncWalk) {
    #req[txAstKind] txAstKind;
    #req[txAstOff] txAstOff;
    #req[txAstLen] txAstLen;
    #req[txAstCount] txAstCount;
    #req[txScopeByOwner] txScopeByOwner;
    #req[txSymNamed] txSymNamed;
    #req[txMethodInLit] txMethodInLit;
    #req[txHasLoad] txHasLoad;
    #req[txHasProject] txHasProject;
    #req[txExtNamed] txExtNamed;
    #req[txAccessFindCC] txAccessFindCC;
    #req[txSemaLineOf] txSemaLineOf;
    #req[txSemaColOf] txSemaColOf;
    #req[txSrc] txSrc;
    txHasLoad() hl;
    // Only fire with whole-project context (argv[2] project dir scanned) and no
    // #load in the file — otherwise a bare call may resolve elsewhere and we
    // stay silent ("if unsure, show nothing").
    #stack[int, 32] active = 0;
    if (hl == 0) { if (txHasProject == 1) { active = 1; } }
    if (active == 1) {
        #stack[int, 64] i = 1;
        #stack[int, 32] go = 1;
        while (go == 1) {
            if (i >= txAstCount) { go = 0; }
            if (go == 1) {
                if (cssc::peek64(txAstKind + i * 8) == 14) {    // CALL
                    #stack[int, 64] co = cssc::peek64(txAstOff + i * 8);
                    #stack[int, 64] cl = cssc::peek64(txAstLen + i * 8);
                    if (cl > 0) {
                        txAccessFindCC(co, cl) cc;
                        if (cc < 0) {                           // bare (no ':')
                            #stack[int, 32] unknown = 1;
                            txScopeByOwner(co, cl, 2) f2; if (f2 != 0) { unknown = 0; } #delete[f2];
                            if (unknown == 1) { txScopeByOwner(co, cl, 3) f3; if (f3 != 0) { unknown = 0; } #delete[f3]; }
                            if (unknown == 1) { txScopeByOwner(co, cl, 4) f4; if (f4 != 0) { unknown = 0; } #delete[f4]; }
                            if (unknown == 1) { txSymNamed(co, cl) sn; if (sn != 0) { unknown = 0; } #delete[sn]; }
                            if (unknown == 1) {
                                txMethodInLit(co, cl, "cout\ncoutln\nout\noutln\nin\ninput\ncerr\nclog\nread_file\nwrite_file\nappend_file\nfile_exists\ndelete_file\ncopy_file\nmove_file\nfile_size\nlist_dir\nmkdir\nstrlen\nsubstr\nreplace\nsplit\njoin\ntrim\nltrim\nrtrim\nupper\nlower\ncontains\nstarts_with\nends_with\nindex_of\nlast_index_of\nchar_at\nrepeat\nreverse\npad_left\npad_right\nabs\nmin\nmax\nfloor\nceil\nround\nsqrt\npow\nlog\nlog10\nsin\ncos\ntan\npi\ne\ne_const\nrandom\nrandom_int\nrandom_float\nrandom_choice\nclamp\nlen\npush\npop\nshift\nunshift\nslice\nsort\ngetIndex\nreverse_arr\nfind\nconcat\nunique\nflatten\nrange\nzip_arr\nfill\ncount\nsum\navg\nmap_arr\nfilter_arr\nkeys\nvalues\nhas_key\nmerge\nentries\nfrom_entries\nmap_keys\nmap_values\nmap_size\nmap_remove\ntypeof\nto_int\nto_float\nto_string\nto_str\ntoString\nto_bool\nto_array\nto_map\nvalue\nis_int\nis_float\nis_string\nis_array\nis_map\nis_bool\nis_null\nis_number\ntime\ntimestamp\nsleep\ndate\ndatetime\ntime_format\nclock\nelapsed\ndetime\nsdetime\nuptime\nreboot\ndiag_mem\ndiag_cpu\ndiag_enable\nenv\nset_env\ncwd\nchdir\nbasename\ndirname\nstem\nexec\nexit\nargs\nplatform\nhostname\nuser\nmd5\nsha256\nbase64_encode\nbase64_decode\njson_encode\njson_decode\nformat\nsprintf\nnumber_format\nhex\nrun") bi;
                                if (bi != 0) { unknown = 0; }
                                #delete[bi];
                            }
                            if (unknown == 1) { txExtNamed(co, cl) en; if (en != 0) { unknown = 0; } #delete[en]; }
                            if (unknown == 1) {
                                txSemaLineOf(co) ln;
                                txSemaColOf(co) cl2;
                                cssc::out(ln); cssc::out(":"); cssc::out(cl2);
                                cssc::out(":1:UNKNOWN_FUNCTION:function ");
                                cssc::printRaw(txSrc + co, cl);
                                cssc::out(" is not defined");
                                cssc::outln();
                                #delete[ln];
                                #delete[cl2];
                            }
                            #delete[unknown];
                        }
                        #delete[cc];
                    }
                    #delete[co];
                    #delete[cl];
                }
                i = i + 1;
            }
        }
        #delete[i];
        #delete[go];
    }
    #delete[active];
    #delete[hl];
}

// Append the source span (off,len) to txDirDeclBuf as a '\n'-terminated name.
#define(txDeclBufAdd) {
    #scanp(txDeclBufAdd, int, 0) off;
    #scanp(txDeclBufAdd, int, 1) len;
    #req[txSrc] txSrc;
    #req[txDirDeclBuf] txDirDeclBuf;
    #req[txDirDeclLen] txDirDeclLen;
    #stack[int, 64] k = 0;
    while (k < len) {
        cssc::poke8(txDirDeclBuf + txDirDeclLen, cssc::peek8(txSrc + off + k));
        txDirDeclLen = txDirDeclLen + 1;
        k = k + 1;
    }
    cssc::poke8(txDirDeclBuf + txDirDeclLen, 10);
    txDirDeclLen = txDirDeclLen + 1;
    #delete[k];
}

// Scan the source once for `#<dir>[ … ] <name>` declarations and collect each
// <name> into txDirDeclBuf ('\n'-joined). The sema parser only knows a fixed set
// of directives (stack/heap/auto/req/…) and SKIPS all others — so container and
// peripheral declarators (`#array[T,N] a;`, `#vector[T] v;`, `#map`, `#bind`,
// `#console`, `#matrix`, `#video`, `#pin`, …) leave NO symbol. This raw scan
// recovers the declared names so the unknown-variable check never false-flags
// them. Directive-arg brackets `[…]` never nest (container types use `<…>`), so
// scanning to the first `]` is sufficient. A `#delete[x];` / `#free[x];` has `;`
// right after `]` (no trailing ident) and contributes nothing.
#define(txCollectDirDecls) {
    #req[txSrc] txSrc;
    #req[txSrcLen] txSrcLen;
    #req[txDirDeclBuf] txDirDeclBuf;
    #req[txDirDeclLen] txDirDeclLen;
    #req[txDeclBufAdd] txDeclBufAdd;
    #req[txSpanEqLit] txSpanEqLit;
    if (txDirDeclBuf == 0) { txDirDeclBuf = cssc::alloc(1048576); }
    txDirDeclLen = 0;
    #stack[int, 64] i = 0;
    #stack[int, 32] go = 1;
    while (go == 1) {
        if (i >= txSrcLen) { go = 0; }
        if (go == 1) {
            if (cssc::peek8(txSrc + i) == 35) {                 // '#'
                #stack[int, 64] j = i + 1;
                #stack[int, 32] dg = 1;                          // skip the directive name
                while (dg == 1) {
                    if (j >= txSrcLen) { dg = 0; }
                    if (dg == 1) {
                        #stack[int, 64] c = cssc::peek8(txSrc + j);
                        #stack[int, 32] idc = 0;
                        if (c >= 65) { if (c <= 90) { idc = 1; } }
                        if (c >= 97) { if (c <= 122) { idc = 1; } }
                        if (c >= 48) { if (c <= 57) { idc = 1; } }
                        if (c == 95) { idc = 1; }
                        if (idc == 1) { j = j + 1; } else { dg = 0; }
                        #delete[c];
                        #delete[idc];
                    }
                }
                #delete[dg];
                // `#req[X] Y` — Y is an IMPORT alias, already added to the
                // symbol table by the collector, NOT a fresh declaration. Do
                // NOT record it here: otherwise the `#req[X]` target existence
                // check finds Y and a same-name `#req[nonexisting] nonexisting;`
                // wrongly satisfies itself (the vanishing-squiggle bug).
                #stack[int, 32] isReqDir = 0;
                if (j - (i + 1) == 3) {
                    if (cssc::peek8(txSrc + i + 1) == 114) {          // 'r'
                        if (cssc::peek8(txSrc + i + 2) == 101) {      // 'e'
                            if (cssc::peek8(txSrc + i + 3) == 113) { isReqDir = 1; }  // 'q'
                        }
                    }
                }
                #stack[int, 32] wg = 1;                          // skip ws to '['
                while (wg == 1) {
                    if (j >= txSrcLen) { wg = 0; }
                    if (wg == 1) {
                        #stack[int, 64] c = cssc::peek8(txSrc + j);
                        if (c == 32) { j = j + 1; } else { if (c == 9) { j = j + 1; } else { wg = 0; } }
                        #delete[c];
                    }
                }
                #delete[wg];
                if (j < txSrcLen) {
                    #stack[int, 64] opener = cssc::peek8(txSrc + j);
                    #stack[int, 32] hasArgs = 0;
                    if (opener == 91) { hasArgs = 1; }           // '['  #stack/#heap/#array/…
                    if (opener == 40) { hasArgs = 1; }           // '('  #scanp/#qvar/#cdefine/…
                    if (hasArgs == 1) {
                        if (opener == 91) {                      // '[' — no nesting, scan to ']'
                            #stack[int, 32] bg = 1;
                            while (bg == 1) {
                                if (j >= txSrcLen) { bg = 0; }
                                if (bg == 1) {
                                    if (cssc::peek8(txSrc + j) == 93) { j = j + 1; bg = 0; } else { j = j + 1; }
                                }
                            }
                            #delete[bg];
                        }
                        if (opener == 40) {                      // '(' — depth-match to ')'
                            #stack[int, 64] depth = 0;
                            #stack[int, 32] bg = 1;
                            while (bg == 1) {
                                if (j >= txSrcLen) { bg = 0; }
                                if (bg == 1) {
                                    #stack[int, 64] pc = cssc::peek8(txSrc + j);
                                    if (pc == 40) { depth = depth + 1; }
                                    if (pc == 41) { depth = depth - 1; if (depth == 0) { j = j + 1; bg = 0; } }
                                    if (bg == 1) { j = j + 1; }
                                    #delete[pc];
                                }
                            }
                            #delete[bg];
                        }
                        #stack[int, 32] wg2 = 1;                 // skip ws after ']'
                        while (wg2 == 1) {
                            if (j >= txSrcLen) { wg2 = 0; }
                            if (wg2 == 1) {
                                #stack[int, 64] c = cssc::peek8(txSrc + j);
                                if (c == 32) { j = j + 1; } else { if (c == 9) { j = j + 1; } else { wg2 = 0; } }
                                #delete[c];
                            }
                        }
                        #delete[wg2];
                        #stack[int, 64] ns = j;                  // trailing identifier = the name
                        #stack[int, 32] ng = 1;
                        while (ng == 1) {
                            if (j >= txSrcLen) { ng = 0; }
                            if (ng == 1) {
                                #stack[int, 64] c = cssc::peek8(txSrc + j);
                                #stack[int, 32] idc = 0;
                                if (c >= 65) { if (c <= 90) { idc = 1; } }
                                if (c >= 97) { if (c <= 122) { idc = 1; } }
                                if (c >= 48) { if (c <= 57) { idc = 1; } }
                                if (c == 95) { idc = 1; }
                                if (idc == 1) { j = j + 1; } else { ng = 0; }
                                #delete[c];
                                #delete[idc];
                            }
                        }
                        #delete[ng];
                        #stack[int, 64] nl = j - ns;
                        if (nl > 0) { if (isReqDir == 0) { txDeclBufAdd(ns, nl); } }
                        #delete[nl];
                        #delete[ns];
                    }
                    #delete[opener];
                    #delete[hasArgs];
                }
                #delete[isReqDir];
                #delete[j];
            }
            if (go == 1) { i = i + 1; }
        }
    }
    #delete[i];
    #delete[go];

    // Pass 2 — `?cursor` bindings (select / #catch / method cursors) and the
    // params of `#cdefine(fn, p1, p2, …)`. Both are declaration forms the sema
    // parser does not surface as symbols.
    #stack[int, 64] p = 0;
    #stack[int, 32] pg = 1;
    while (pg == 1) {
        if (p >= txSrcLen) { pg = 0; }
        if (pg == 1) {
            #stack[int, 64] ch = cssc::peek8(txSrc + p);
            if (ch == 63) {                                     // '?' cursor
                #stack[int, 64] cs = p + 1;
                #stack[int, 64] ce = cs;
                #stack[int, 32] cg = 1;
                while (cg == 1) {
                    if (ce >= txSrcLen) { cg = 0; }
                    if (cg == 1) {
                        #stack[int, 64] cc = cssc::peek8(txSrc + ce);
                        #stack[int, 32] idc = 0;
                        if (cc >= 65) { if (cc <= 90) { idc = 1; } }
                        if (cc >= 97) { if (cc <= 122) { idc = 1; } }
                        if (cc >= 48) { if (cc <= 57) { idc = 1; } }
                        if (cc == 95) { idc = 1; }
                        if (idc == 1) { ce = ce + 1; } else { cg = 0; }
                        #delete[cc];
                        #delete[idc];
                    }
                }
                #delete[cg];
                if (ce > cs) { txDeclBufAdd(cs, ce - cs); }
                #delete[cs];
                #delete[ce];
            }
            if (ch == 35) {                                     // '#cdefine(fn, p1, p2, ...)'
                txSpanEqLit(p + 1, 7, "cdefine") isc;
                if (isc == 1) {
                    #stack[int, 64] q = p + 8;
                    #stack[int, 32] fg = 1;                     // skip to '('
                    while (fg == 1) {
                        if (q >= txSrcLen) { fg = 0; }
                        if (fg == 1) { if (cssc::peek8(txSrc + q) == 40) { fg = 0; } else { q = q + 1; } }
                    }
                    #delete[fg];
                    q = q + 1;
                    #stack[int, 32] ag = 1;                     // collect idents until ')'
                    while (ag == 1) {
                        if (q >= txSrcLen) { ag = 0; }
                        if (ag == 1) {
                            #stack[int, 64] cc = cssc::peek8(txSrc + q);
                            if (cc == 41) { ag = 0; }           // ')'
                            #stack[int, 32] ids = 0;
                            if (cc >= 65) { if (cc <= 90) { ids = 1; } }
                            if (cc >= 97) { if (cc <= 122) { ids = 1; } }
                            if (cc == 95) { ids = 1; }
                            if (ag == 1) {
                                if (ids == 1) {
                                    #stack[int, 64] ns2 = q;
                                    #stack[int, 32] ig = 1;
                                    while (ig == 1) {
                                        if (q >= txSrcLen) { ig = 0; }
                                        if (ig == 1) {
                                            #stack[int, 64] c2 = cssc::peek8(txSrc + q);
                                            #stack[int, 32] i2 = 0;
                                            if (c2 >= 65) { if (c2 <= 90) { i2 = 1; } }
                                            if (c2 >= 97) { if (c2 <= 122) { i2 = 1; } }
                                            if (c2 >= 48) { if (c2 <= 57) { i2 = 1; } }
                                            if (c2 == 95) { i2 = 1; }
                                            if (i2 == 1) { q = q + 1; } else { ig = 0; }
                                            #delete[c2];
                                            #delete[i2];
                                        }
                                    }
                                    #delete[ig];
                                    txDeclBufAdd(ns2, q - ns2);
                                    #delete[ns2];
                                } else { q = q + 1; }
                            }
                            #delete[ids];
                            #delete[cc];
                        }
                    }
                    #delete[ag];
                    #delete[q];
                }
                #delete[isc];
            }
            #delete[ch];
            if (pg == 1) { p = p + 1; }
        }
    }
    #delete[p];
    #delete[pg];

    // Pass 3 — object/sector ctor params + sector injections: the identifier that
    // follows a ':' inside a `<…>` header (`object W<int: width, int: height>`,
    // `sector S<outer: local>`). A `:` only appears inside `<…>` for these forms;
    // container type args (`map<int,string>`, `array<auto>`) carry no ':'.
    #stack[int, 64] a = 0;
    #stack[int, 32] aggo = 1;
    while (aggo == 1) {
        if (a >= txSrcLen) { aggo = 0; }
        if (aggo == 1) {
            if (cssc::peek8(txSrc + a) == 60) {                 // '<'
                #stack[int, 64] b = a + 1;
                #stack[int, 32] bg2 = 1;
                while (bg2 == 1) {
                    if (b >= txSrcLen) { bg2 = 0; }
                    if (bg2 == 1) {
                        #stack[int, 64] cc = cssc::peek8(txSrc + b);
                        #stack[int, 64] afterGt = 0;            // where a trailing capture ident may start
                        if (cc == 62) { bg2 = 0; afterGt = b + 1; }  // '>' end
                        if (cc == 123) { bg2 = 0; }             // '{' safety bound
                        if (cc == 59) { bg2 = 0; }              // ';' safety bound
                        if (cc == 10) { bg2 = 0; }              // newline safety bound
                        if (afterGt > 0) {                      // `Type<...> capture;` — collect capture
                            #stack[int, 64] g = afterGt;
                            #stack[int, 32] gw = 1;
                            while (gw == 1) {
                                if (g >= txSrcLen) { gw = 0; }
                                if (gw == 1) {
                                    #stack[int, 64] wc = cssc::peek8(txSrc + g);
                                    if (wc == 32) { g = g + 1; } else { if (wc == 9) { g = g + 1; } else { gw = 0; } }
                                    #delete[wc];
                                }
                            }
                            #delete[gw];
                            #stack[int, 64] gs = g;
                            #stack[int, 32] gg = 1;
                            while (gg == 1) {
                                if (g >= txSrcLen) { gg = 0; }
                                if (gg == 1) {
                                    #stack[int, 64] gc = cssc::peek8(txSrc + g);
                                    #stack[int, 32] gi = 0;
                                    if (gc >= 65) { if (gc <= 90) { gi = 1; } }
                                    if (gc >= 97) { if (gc <= 122) { gi = 1; } }
                                    if (gc >= 48) { if (gc <= 57) { gi = 1; } }
                                    if (gc == 95) { gi = 1; }
                                    if (gi == 1) { g = g + 1; } else { gg = 0; }
                                    #delete[gc];
                                    #delete[gi];
                                }
                            }
                            #delete[gg];
                            if (g > gs) { txDeclBufAdd(gs, g - gs); }
                            #delete[gs];
                            #delete[g];
                        }
                        #delete[afterGt];
                        if (bg2 == 1) {
                            if (cc == 58) {                     // ':' -> next ident is a param
                                #stack[int, 64] d = b + 1;
                                #stack[int, 32] wg3 = 1;        // skip ws + a leading &/* ref marker
                                while (wg3 == 1) {
                                    if (d >= txSrcLen) { wg3 = 0; }
                                    if (wg3 == 1) {
                                        #stack[int, 64] wc = cssc::peek8(txSrc + d);
                                        if (wc == 32) { d = d + 1; } else { if (wc == 9) { d = d + 1; } else { if (wc == 38) { d = d + 1; } else { if (wc == 42) { d = d + 1; } else { wg3 = 0; } } } }
                                        #delete[wc];
                                    }
                                }
                                #delete[wg3];
                                #stack[int, 64] ds = d;
                                #stack[int, 32] dg = 1;
                                while (dg == 1) {
                                    if (d >= txSrcLen) { dg = 0; }
                                    if (dg == 1) {
                                        #stack[int, 64] dc = cssc::peek8(txSrc + d);
                                        #stack[int, 32] di = 0;
                                        if (dc >= 65) { if (dc <= 90) { di = 1; } }
                                        if (dc >= 97) { if (dc <= 122) { di = 1; } }
                                        if (dc >= 48) { if (dc <= 57) { di = 1; } }
                                        if (dc == 95) { di = 1; }
                                        if (di == 1) { d = d + 1; } else { dg = 0; }
                                        #delete[dc];
                                        #delete[di];
                                    }
                                }
                                #delete[dg];
                                if (d > ds) { txDeclBufAdd(ds, d - ds); }
                                b = d;
                                #delete[ds];
                            } else { b = b + 1; }
                        }
                        #delete[cc];
                    }
                }
                #delete[bg2];
                #delete[b];
            }
            if (aggo == 1) { a = a + 1; }
        }
    }
    #delete[a];
    #delete[aggo];

    // Pass 4 — result captures `<call>() name;`: the identifier between a ')'
    // and a ';' (`nope::thing() z;`, `foo(5) r;`). The sema parses these as
    // RESULT_CAPTURE normally, but inside a directive the parser cannot model
    // (a #cdefine body) they are lost; this recovers the captured name.
    #stack[int, 64] rc = 0;
    #stack[int, 32] rcg = 1;
    while (rcg == 1) {
        if (rc >= txSrcLen) { rcg = 0; }
        if (rcg == 1) {
            if (cssc::peek8(txSrc + rc) == 41) {                // ')'
                #stack[int, 64] g = rc + 1;
                #stack[int, 32] gw = 1;
                while (gw == 1) {
                    if (g >= txSrcLen) { gw = 0; }
                    if (gw == 1) {
                        #stack[int, 64] wc = cssc::peek8(txSrc + g);
                        if (wc == 32) { g = g + 1; } else { if (wc == 9) { g = g + 1; } else { gw = 0; } }
                        #delete[wc];
                    }
                }
                #delete[gw];
                #stack[int, 64] gs = g;
                #stack[int, 32] gg = 1;
                while (gg == 1) {
                    if (g >= txSrcLen) { gg = 0; }
                    if (gg == 1) {
                        #stack[int, 64] gc = cssc::peek8(txSrc + g);
                        #stack[int, 32] gi = 0;
                        if (gc >= 65) { if (gc <= 90) { gi = 1; } }
                        if (gc >= 97) { if (gc <= 122) { gi = 1; } }
                        if (gc >= 48) { if (gc <= 57) { gi = 1; } }
                        if (gc == 95) { gi = 1; }
                        if (gi == 1) { g = g + 1; } else { gg = 0; }
                        #delete[gc];
                        #delete[gi];
                    }
                }
                #delete[gg];
                if (g > gs) {                                   // ident present — must be `… name ;`
                    #stack[int, 64] h = g;
                    #stack[int, 32] hw = 1;
                    while (hw == 1) {
                        if (h >= txSrcLen) { hw = 0; }
                        if (hw == 1) {
                            #stack[int, 64] hc = cssc::peek8(txSrc + h);
                            if (hc == 32) { h = h + 1; } else { if (hc == 9) { h = h + 1; } else { hw = 0; } }
                            #delete[hc];
                        }
                    }
                    #delete[hw];
                    if (h < txSrcLen) {
                        if (cssc::peek8(txSrc + h) == 59) { txDeclBufAdd(gs, g - gs); }  // ';'
                    }
                }
                #delete[gs];
                #delete[g];
            }
            rc = rc + 1;
        }
    }
    #delete[rc];
    #delete[rcg];
}

// 1 if the span (off,len) matches a name collected by txCollectDirDecls.
#define(txDirDeclNamed) {
    #scanp(txDirDeclNamed, int, 0) off;
    #scanp(txDirDeclNamed, int, 1) len;
    #req[txSrc] txSrc;
    #req[txDirDeclBuf] txDirDeclBuf;
    #req[txDirDeclLen] txDirDeclLen;
    #stack[int, 32] r = 0;
    #stack[int, 64] i = 0;
    while (i < txDirDeclLen) {
        #stack[int, 64] s = i;
        #stack[int, 32] sg = 1;
        while (sg == 1) {
            if (i >= txDirDeclLen) { sg = 0; }
            if (sg == 1) { if (cssc::peek8(txDirDeclBuf + i) == 10) { sg = 0; } else { i = i + 1; } }
        }
        #delete[sg];
        #stack[int, 64] seglen = i - s;
        if (seglen == len) {
            #stack[int, 32] eq = 1;
            #stack[int, 64] k = 0;
            #stack[int, 32] mg = 1;
            while (mg == 1) {
                if (k >= len) { mg = 0; }
                if (mg == 1) {
                    if (cssc::peek8(txSrc + off + k) != cssc::peek8(txDirDeclBuf + s + k)) { eq = 0; mg = 0; }
                    if (mg == 1) { k = k + 1; }
                }
            }
            #delete[k];
            #delete[mg];
            if (eq == 1) { r = 1; }
            #delete[eq];
        }
        #delete[seglen];
        #delete[s];
        i = i + 1;
    }
    #delete[i];
    return r;
}

// 1 if `name` is declared by a `for (TYPE name = …; …)` init. For-init DECLs
// live in the FOR node's A slot and are NOT walked by the symbol collector
// (which only descends the loop BODY), so an unknown-variable check would else
// wrongly flag every loop counter. Scope-agnostic on purpose (over-permissive =
// zero-FP).
#define(txForInitNamed) {
    #scanp(txForInitNamed, int, 0) off;
    #scanp(txForInitNamed, int, 1) len;
    #req[txAstKind] txAstKind;
    #req[txAstA] txAstA;
    #req[txAstOff] txAstOff;
    #req[txAstLen] txAstLen;
    #req[txAstCount] txAstCount;
    #req[txDdSpanEq] txDdSpanEq;
    #stack[int, 32] r = 0;
    #stack[int, 64] i = 1;
    #stack[int, 32] go = 1;
    while (go == 1) {
        if (i >= txAstCount) { go = 0; }
        if (go == 1) {
            if (cssc::peek64(txAstKind + i * 8) == 11) {          // FOR
                #stack[int, 64] init = cssc::peek64(txAstA + i * 8);
                if (init != 0) {
                    if (cssc::peek64(txAstKind + init * 8) == 7) {  // DECL init
                        txDdSpanEq(off, len, cssc::peek64(txAstOff + init * 8),
                                   cssc::peek64(txAstLen + init * 8)) eq;
                        if (eq == 1) { r = 1; go = 0; }
                        #delete[eq];
                    }
                }
                #delete[init];
            }
            if (go == 1) { i = i + 1; }
        }
    }
    #delete[i];
    #delete[go];
    return r;
}

// 1 if the bare name (off,len) resolves to ANYTHING nameable — any collected
// symbol (slot/param/#req/cursor/#define/object/sector/module alias), a for-init
// counter, an external project definition, or a builtin/type keyword. Anything
// that returns 0 here is genuinely undeclared. Deliberately over-permissive so a
// real name never false-positives.
#define(txKnownName) {
    #scanp(txKnownName, int, 0) off;
    #scanp(txKnownName, int, 1) len;
    #req[txSymNamed] txSymNamed;
    #req[txExtNamed] txExtNamed;
    #req[txForInitNamed] txForInitNamed;
    #req[txDirDeclNamed] txDirDeclNamed;
    #req[txMethodInLit] txMethodInLit;
    #stack[int, 32] r = 0;
    txSymNamed(off, len) s;  if (s != 0) { r = 1; } #delete[s];
    if (r == 0) { txForInitNamed(off, len) fi; if (fi != 0) { r = 1; } #delete[fi]; }
    if (r == 0) { txDirDeclNamed(off, len) dd; if (dd != 0) { r = 1; } #delete[dd]; }
    if (r == 0) { txExtNamed(off, len) en; if (en != 0) { r = 1; } #delete[en]; }
    if (r == 0) {
        txMethodInLit(off, len, "cssc\nint\nfloat\nstring\nbool\nvoid\nauto\nvar\nvector\narray\nbind\nmap\nchar\nbyte\nobject\nsector\ntrue\nfalse\nnull") kw;
        if (kw != 0) { r = 1; }
        #delete[kw];
    }
    return r;
}

// Like txKnownName, but for a `#req[X] Y` TARGET: excludes the alias symbol that
// THIS #req node (`excl`) declares, so `#req[nonexisting] nonexisting;` no longer
// satisfies its own existence check via the alias it creates.
#stack[int, 64] txReqTargetKnown;
#define(txReqTargetKnown) {
    #scanp(txReqTargetKnown, int, 0) off;
    #scanp(txReqTargetKnown, int, 1) len;
    #scanp(txReqTargetKnown, int, 2) excl;
    #req[txSymNamedExcl] txSymNamedExcl;
    #req[txExtNamed] txExtNamed;
    #req[txForInitNamed] txForInitNamed;
    #req[txDirDeclNamed] txDirDeclNamed;
    #req[txMethodInLit] txMethodInLit;
    #stack[int, 32] r = 0;
    txSymNamedExcl(off, len, excl) s;  if (s != 0) { r = 1; } #delete[s];
    if (r == 0) { txForInitNamed(off, len) fi; if (fi != 0) { r = 1; } #delete[fi]; }
    if (r == 0) { txDirDeclNamed(off, len) dd; if (dd != 0) { r = 1; } #delete[dd]; }
    if (r == 0) { txExtNamed(off, len) en; if (en != 0) { r = 1; } #delete[en]; }
    if (r == 0) {
        txMethodInLit(off, len, "cssc\nint\nfloat\nstring\nbool\nvoid\nauto\nvar\nvector\narray\nbind\nmap\nchar\nbyte\nobject\nsector\ntrue\nfalse\nnull") kw;
        if (kw != 0) { r = 1; }
        #delete[kw];
    }
    return r;
}

// UNKNOWN_VARIABLE — a bare identifier REFERENCE (IDENT node, kind 5) that
// resolves to no declaration anywhere. Member/method/label names are SPANS on
// their ARROW/METHOD_CALL parent (never kind-5 nodes), so only genuine variable
// reads reach here; qualified `A::B` spans carry a ':' and are skipped (they
// resolve through the sector/module path). Same gate as UNKNOWN_FUNCTION: only
// with whole-project context (argv[2]) and no `#load` — otherwise a name might
// resolve cross-file and we stay silent.
#define(txUnknownVarWalk) {
    #req[txAstKind] txAstKind;
    #req[txAstOff] txAstOff;
    #req[txAstLen] txAstLen;
    #req[txAstCount] txAstCount;
    #req[txKnownName] txKnownName;
    #req[txReqTargetKnown] txReqTargetKnown;
    #req[txAccessFindCC] txAccessFindCC;
    #req[txHasLoad] txHasLoad;
    #req[txHasProject] txHasProject;
    #req[txCollectDirDecls] txCollectDirDecls;
    #req[txSemaLineOf] txSemaLineOf;
    #req[txSemaColOf] txSemaColOf;
    #req[txSrc] txSrc;
    txHasLoad() hl;
    #stack[int, 32] active = 0;
    if (hl == 0) { if (txHasProject == 1) { active = 1; } }
    if (active == 1) {
        txCollectDirDecls();       // recover container/peripheral directive decls
        #stack[int, 64] i = 1;
        #stack[int, 32] go = 1;
        while (go == 1) {
            if (i >= txAstCount) { go = 0; }
            if (go == 1) {
                if (cssc::peek64(txAstKind + i * 8) == 5) {         // IDENT reference
                    #stack[int, 64] vo = cssc::peek64(txAstOff + i * 8);
                    #stack[int, 64] vl = cssc::peek64(txAstLen + i * 8);
                    // A genuine variable read is never immediately preceded by
                    // '.' — that is member access (`x.member`), whose member is a
                    // span, not a variable. Skip such idents (guards the rare
                    // legacy `obj!secure.access` parse from a false flag).
                    #stack[int, 32] afterDot = 0;
                    if (vo > 0) { if (cssc::peek8(txSrc + vo - 1) == 46) { afterDot = 1; } }
                    if (vl > 0) {
                        if (afterDot == 0) {
                            txAccessFindCC(vo, vl) cc;
                            if (cc < 0) {                           // bare (no ':')
                                txKnownName(vo, vl) kn;
                                if (kn == 0) {
                                    txSemaLineOf(vo) ln;
                                    txSemaColOf(vo) cl;
                                    cssc::out(ln); cssc::out(":"); cssc::out(cl);
                                    cssc::out(":1:UNKNOWN_VARIABLE:variable ");
                                    cssc::printRaw(txSrc + vo, vl);
                                    cssc::out(" is not declared");
                                    cssc::outln();
                                    #delete[ln];
                                    #delete[cl];
                                }
                                #delete[kn];
                            }
                            #delete[cc];
                        }
                    }
                    #delete[afterDot];
                    #delete[vo];
                    #delete[vl];
                }
                #stack[int, 64] nk = cssc::peek64(txAstKind + i * 8);
                if (nk == 21) {                                 // #delete[X] target
                    #stack[int, 64] xo = cssc::peek64(txAstOff + i * 8);
                    #stack[int, 64] xl = cssc::peek64(txAstLen + i * 8);
                    if (xl > 0) {
                        txAccessFindCC(xo, xl) cc;
                        if (cc < 0) {
                            txKnownName(xo, xl) kn;
                            if (kn == 0) {
                                txSemaLineOf(xo) ln;
                                txSemaColOf(xo) cl;
                                cssc::out(ln); cssc::out(":"); cssc::out(cl);
                                cssc::out(":1:DELETE_UNKNOWN:cannot #delete ");
                                cssc::printRaw(txSrc + xo, xl);
                                cssc::out(" — it is not declared");
                                cssc::outln();
                                #delete[ln];
                                #delete[cl];
                            }
                            #delete[kn];
                        }
                        #delete[cc];
                    }
                    #delete[xo];
                    #delete[xl];
                }
                if (nk == 19) {                                 // #req[X] Y — source X must exist
                    #stack[int, 64] xo = cssc::peek64(txAstOff + i * 8);
                    #stack[int, 64] xl = cssc::peek64(txAstLen + i * 8);
                    if (xl > 0) {
                        txAccessFindCC(xo, xl) cc;
                        if (cc < 0) {
                            // Exclude THIS #req's own alias symbol (node i) so a
                            // same-name `#req[x] x;` doesn't satisfy itself.
                            txReqTargetKnown(xo, xl, i) kn;
                            if (kn == 0) {
                                txSemaLineOf(xo) ln;
                                txSemaColOf(xo) cl;
                                cssc::out(ln); cssc::out(":"); cssc::out(cl);
                                cssc::out(":1:UNKNOWN_VARIABLE:variable ");
                                cssc::printRaw(txSrc + xo, xl);
                                cssc::out(" is not declared");
                                cssc::outln();
                                #delete[ln];
                                #delete[cl];
                            }
                            #delete[kn];
                        }
                        #delete[cc];
                    }
                    #delete[xo];
                    #delete[xl];
                }
                #delete[nk];
                i = i + 1;
            }
        }
        #delete[i];
        #delete[go];
    }
    #delete[active];
    #delete[hl];
}

// Allocate the external-names buffer (1 MB of '\n'-joined names).
#define(txExtInit) {
    #req[txExtBuf] txExtBuf;
    #req[txExtLen] txExtLen;
    #req[txExtCap] txExtCap;
    #req[txHasProject] txHasProject;
    txExtCap = 1048576;
    txExtBuf = cssc::alloc(txExtCap);
    txExtLen = 0;
    txHasProject = 0;
}

// Append the name at (base+off, len) to the external-names buffer, '\n'-terminated.
#define(txExtAdd) {
    #scanp(txExtAdd, int, 0) base;
    #scanp(txExtAdd, int, 1) off;
    #scanp(txExtAdd, int, 2) len;
    #req[txExtBuf] txExtBuf;
    #req[txExtLen] txExtLen;
    #req[txExtCap] txExtCap;
    if (len > 0) {
        if (txExtLen + len + 1 < txExtCap) {
            #stack[int, 64] k = 0;
            while (k < len) {
                cssc::poke8(txExtBuf + txExtLen + k, cssc::peek8(base + off + k));
                k = k + 1;
            }
            #delete[k];
            txExtLen = txExtLen + len;
            cssc::poke8(txExtBuf + txExtLen, 10);
            txExtLen = txExtLen + 1;
        }
    }
}

// 1 if the bytes of literal `lit` occur verbatim at (base+pos).
#define(txLitAt) {
    #scanp(txLitAt, int, 0) base;
    #scanp(txLitAt, int, 1) pos;
    #scanp(txLitAt, int, 2) srcLen;
    #scanp(txLitAt, string, 3) lit;
    #stack[int, 64] sa = 0;
    #adress[lit] sa;
    #stack[int, 64] hdr = cssc::peek64(sa);
    #stack[int, 64] llen = cssc::peek32(hdr + 4);
    #stack[int, 64] ldata = hdr + 8;
    #stack[int, 64] r = 0;
    if (pos + llen <= srcLen) {
        r = 1;
        #stack[int, 64] k = 0;
        #stack[int, 32] mg = 1;
        while (mg == 1) {
            if (k >= llen) { mg = 0; }
            if (mg == 1) {
                if (cssc::peek8(base + pos + k) != cssc::peek8(ldata + k)) { r = 0; mg = 0; }
                if (mg == 1) { k = k + 1; }
            }
        }
        #delete[k];
        #delete[mg];
    }
    #delete[sa];
    #delete[hdr];
    #delete[llen];
    #delete[ldata];
    return r;
}

// 1 if span(txSrc+off, len) is in the external-names buffer (exact match).
#define(txExtNamed) {
    #scanp(txExtNamed, int, 0) off;
    #scanp(txExtNamed, int, 1) len;
    #req[txSrc] txSrc;
    #req[txExtBuf] txExtBuf;
    #req[txExtLen] txExtLen;
    #stack[int, 64] r = 0;
    #stack[int, 64] i = 0;
    while (i < txExtLen) {
        #stack[int, 64] j = i;
        #stack[int, 32] sg = 1;
        while (sg == 1) {
            if (j >= txExtLen) { sg = 0; }
            if (sg == 1) { if (cssc::peek8(txExtBuf + j) == 10) { sg = 0; } else { j = j + 1; } }
        }
        #delete[sg];
        #stack[int, 64] seglen = j - i;
        if (seglen == len) {
            #stack[int, 32] eq = 1;
            #stack[int, 64] k = 0;
            #stack[int, 32] mg = 1;
            while (mg == 1) {
                if (k >= len) { mg = 0; }
                if (mg == 1) {
                    if (cssc::peek8(txSrc + off + k) != cssc::peek8(txExtBuf + i + k)) { eq = 0; mg = 0; }
                    if (mg == 1) { k = k + 1; }
                }
            }
            #delete[k];
            #delete[mg];
            if (eq == 1) { r = 1; }
            #delete[eq];
        }
        #delete[seglen];
        i = j + 1;
    }
    #delete[i];
    return r;
}

// Scan a source buffer for top-level definition NAMES (#define(NAME),
// #cdefine(NAME, sector NAME, object NAME) and add each to the external table.
// Over-permissive by design: a spurious add only SUPPRESSES a flag, never
// creates one, so no string/comment skipping is needed (stays zero-FP).
#define(txScanDefs) {
    #scanp(txScanDefs, int, 0) base;
    #scanp(txScanDefs, int, 1) srcLen;
    #req[txExtAdd] txExtAdd;
    #req[txLitAt] txLitAt;
    #stack[int, 64] i = 0;
    #stack[int, 32] go = 1;
    while (go == 1) {
        if (i >= srcLen) { go = 0; }
        if (go == 1) {
            #stack[int, 64] ns = 0 - 1;
            txLitAt(base, i, srcLen, "#define(") d1;
            if (d1 == 1) { ns = i + 8; }
            #delete[d1];
            if (ns < 0) {
                txLitAt(base, i, srcLen, "#cdefine(") d2;
                if (d2 == 1) { ns = i + 9; }
                #delete[d2];
            }
            if (ns < 0) {
                #stack[int, 32] wb = 1;
                if (i > 0) {
                    #stack[int, 64] pc = cssc::peek8(base + i - 1);
                    if (pc >= 65) { if (pc <= 90) { wb = 0; } }
                    if (pc >= 97) { if (pc <= 122) { wb = 0; } }
                    if (pc >= 48) { if (pc <= 57) { wb = 0; } }
                    if (pc == 95) { wb = 0; }
                    #delete[pc];
                }
                if (wb == 1) {
                    #stack[int, 64] kwlen = 0;
                    txLitAt(base, i, srcLen, "sector ") s1;
                    if (s1 == 1) { kwlen = 7; }
                    #delete[s1];
                    if (kwlen == 0) {
                        txLitAt(base, i, srcLen, "object ") o1;
                        if (o1 == 1) { kwlen = 7; }
                        #delete[o1];
                    }
                    if (kwlen > 0) {
                        #stack[int, 64] p = i + kwlen;
                        #stack[int, 32] fw = 1;
                        while (fw == 1) {
                            if (p >= srcLen) { fw = 0; }
                            if (fw == 1) {
                                #stack[int, 64] wc = cssc::peek8(base + p);
                                if (wc == 32) { p = p + 1; } else { if (wc == 9) { p = p + 1; } else { fw = 0; } }
                                #delete[wc];
                            }
                        }
                        #delete[fw];
                        ns = p;
                        #delete[p];
                    }
                    #delete[kwlen];
                }
                #delete[wb];
            }
            if (ns >= 0) {
                #stack[int, 64] e = ns;
                #stack[int, 32] rg = 1;
                while (rg == 1) {
                    if (e >= srcLen) { rg = 0; }
                    if (rg == 1) {
                        #stack[int, 64] ic = cssc::peek8(base + e);
                        #stack[int, 32] iw = 0;
                        if (ic >= 65) { if (ic <= 90) { iw = 1; } }
                        if (ic >= 97) { if (ic <= 122) { iw = 1; } }
                        if (ic >= 48) { if (ic <= 57) { iw = 1; } }
                        if (ic == 95) { iw = 1; }
                        if (iw == 1) { e = e + 1; } else { rg = 0; }
                        #delete[ic];
                        #delete[iw];
                    }
                }
                #delete[rg];
                if (e > ns) { txExtAdd(base, ns, e - ns); }
                #delete[e];
            }
            #delete[ns];
            i = i + 1;
        }
    }
    #delete[i];
    #delete[go];
}

// Harvest the TOP-LEVEL member surface of a loaded (#load) module buffer into
// the external-names table: every top-level `#define(NAME)` / `#cdefine(NAME)`
// (callables), `sector NAME` / `object NAME` (types), AND `#stack/#heap/#auto`
// NAME (vars/consts). Brace depth is tracked (skipping string literals and
// // and /* */ comments so their braces never miscount) so ONLY depth-0 members
// are harvested -- a #define's locals / nested defines are the loaded module's
// private scope, never `alias::` members. Matches the runtime's CsscLoadedModule,
// which binds the loaded file's GLOBAL-scope members as the module's namespace.
// (Only DIRECT members are harvested -- a nested `#load` inside the loaded file
// is not followed, so no cycle/self-load recursion is possible.)
#define(txScanModMembers) {
    #scanp(txScanModMembers, int, 0) base;
    #scanp(txScanModMembers, int, 1) srcLen;
    #req[txExtAdd] txExtAdd;
    #req[txLitAt] txLitAt;
    #stack[int, 64] i = 0;
    #stack[int, 64] depth = 0;
    #stack[int, 32] go = 1;
    while (go == 1) {
        if (i >= srcLen) { go = 0; }
        if (go == 1) {
            #stack[int, 64] c = cssc::peek8(base + i);
            #stack[int, 32] handled = 0;
            if (c == 34) { handled = 1; }                       // '"'
            if (c == 39) { handled = 1; }                       // '\''
            if (handled == 1) {                                 // skip string literal
                #stack[int, 64] qq = c;
                i = i + 1;
                #stack[int, 32] sg = 1;
                while (sg == 1) {
                    if (i >= srcLen) { sg = 0; }
                    if (sg == 1) {
                        #stack[int, 64] sc = cssc::peek8(base + i);
                        if (sc == 92) { i = i + 2; } else { if (sc == qq) { sg = 0; i = i + 1; } else { i = i + 1; } }
                        #delete[sc];
                    }
                }
                #delete[sg];
                #delete[qq];
            }
            if (handled == 0) {
                if (c == 47) {                                  // '/'
                    #stack[int, 64] c2 = 0;
                    if (i + 1 < srcLen) { c2 = cssc::peek8(base + i + 1); }
                    if (c2 == 47) {                             // '//' line comment
                        handled = 1;
                        i = i + 2;
                        #stack[int, 32] lg = 1;
                        while (lg == 1) {
                            if (i >= srcLen) { lg = 0; }
                            if (lg == 1) { if (cssc::peek8(base + i) == 10) { lg = 0; } else { i = i + 1; } }
                        }
                        #delete[lg];
                    }
                    if (c2 == 42) {                             // '/*' block comment
                        handled = 1;
                        i = i + 2;
                        #stack[int, 32] bg = 1;
                        while (bg == 1) {
                            if (i + 1 >= srcLen) { bg = 0; i = srcLen; }
                            if (bg == 1) {
                                if (cssc::peek8(base + i) == 42) { if (cssc::peek8(base + i + 1) == 47) { bg = 0; i = i + 2; } else { i = i + 1; } } else { i = i + 1; }
                            }
                        }
                        #delete[bg];
                    }
                    #delete[c2];
                }
            }
            if (handled == 0) {
                if (c == 123) { depth = depth + 1; i = i + 1; handled = 1; }   // '{'
                if (c == 125) { depth = depth - 1; i = i + 1; handled = 1; }   // '}'
            }
            if (handled == 0) {
                if (depth == 0) {
                    #stack[int, 64] ns = 0 - 1;                 // identifier start to harvest
                    #stack[int, 64] varSkip = 0 - 1;            // '[' pos for a #stack/#heap/#auto var
                    if (c == 35) {                              // '#'
                        txLitAt(base, i, srcLen, "#define(") d1; if (d1 == 1) { ns = i + 8; } #delete[d1];
                        if (ns < 0) { txLitAt(base, i, srcLen, "#cdefine(") d2; if (d2 == 1) { ns = i + 9; } #delete[d2]; }
                        if (ns < 0) { txLitAt(base, i, srcLen, "#stack[") v1; if (v1 == 1) { varSkip = i + 6; } #delete[v1]; }
                        if (ns < 0) { if (varSkip < 0) { txLitAt(base, i, srcLen, "#heap[") v2; if (v2 == 1) { varSkip = i + 5; } #delete[v2]; } }
                        if (ns < 0) { if (varSkip < 0) { txLitAt(base, i, srcLen, "#auto[") v3; if (v3 == 1) { varSkip = i + 5; } #delete[v3]; } }
                    }
                    if (ns < 0) { if (varSkip < 0) {            // sector / object at a word boundary
                        #stack[int, 32] wb = 1;
                        if (i > 0) {
                            #stack[int, 64] pc = cssc::peek8(base + i - 1);
                            if (pc >= 65) { if (pc <= 90) { wb = 0; } }
                            if (pc >= 97) { if (pc <= 122) { wb = 0; } }
                            if (pc >= 48) { if (pc <= 57) { wb = 0; } }
                            if (pc == 95) { wb = 0; }
                            #delete[pc];
                        }
                        if (wb == 1) {
                            #stack[int, 64] kwlen = 0;
                            txLitAt(base, i, srcLen, "sector ") s1; if (s1 == 1) { kwlen = 7; } #delete[s1];
                            if (kwlen == 0) { txLitAt(base, i, srcLen, "object ") o1; if (o1 == 1) { kwlen = 7; } #delete[o1]; }
                            if (kwlen > 0) {
                                #stack[int, 64] p = i + kwlen;
                                #stack[int, 32] fw = 1;
                                while (fw == 1) {
                                    if (p >= srcLen) { fw = 0; }
                                    if (fw == 1) { #stack[int, 64] wc = cssc::peek8(base + p); if (wc == 32) { p = p + 1; } else { if (wc == 9) { p = p + 1; } else { fw = 0; } } #delete[wc]; }
                                }
                                #delete[fw];
                                ns = p;
                                #delete[p];
                            }
                            #delete[kwlen];
                        }
                        #delete[wb];
                    } }
                    if (varSkip >= 0) {                         // var: skip to ']' then whitespace -> NAME
                        #stack[int, 64] p = varSkip;
                        #stack[int, 32] bg = 1;
                        while (bg == 1) {
                            if (p >= srcLen) { bg = 0; }
                            if (bg == 1) { if (cssc::peek8(base + p) == 93) { bg = 0; } else { p = p + 1; } }
                        }
                        #delete[bg];
                        p = p + 1;
                        #stack[int, 32] fw = 1;
                        while (fw == 1) {
                            if (p >= srcLen) { fw = 0; }
                            if (fw == 1) { #stack[int, 64] wc = cssc::peek8(base + p); if (wc == 32) { p = p + 1; } else { if (wc == 9) { p = p + 1; } else { fw = 0; } } #delete[wc]; }
                        }
                        #delete[fw];
                        ns = p;
                        #delete[p];
                    }
                    #delete[varSkip];
                    if (ns >= 0) {                              // extract the identifier and add it
                        #stack[int, 64] e = ns;
                        #stack[int, 32] rg = 1;
                        while (rg == 1) {
                            if (e >= srcLen) { rg = 0; }
                            if (rg == 1) {
                                #stack[int, 64] ic = cssc::peek8(base + e);
                                #stack[int, 32] iw = 0;
                                if (ic >= 65) { if (ic <= 90) { iw = 1; } }
                                if (ic >= 97) { if (ic <= 122) { iw = 1; } }
                                if (ic >= 48) { if (ic <= 57) { iw = 1; } }
                                if (ic == 95) { iw = 1; }
                                if (iw == 1) { e = e + 1; } else { rg = 0; }
                                #delete[ic];
                                #delete[iw];
                            }
                        }
                        #delete[rg];
                        if (e > ns) { txExtAdd(base, ns, e - ns); }
                        #delete[e];
                    }
                    #delete[ns];
                }
                i = i + 1;
            }
            #delete[handled];
            #delete[c];
        }
    }
    #delete[go];
    #delete[i];
    #delete[depth];
}

// List the project dir (dOff,dLen = path bytes), read each *.cssc sibling, and
// scan its definitions into the external-names table. Sets txHasProject.
#define(txScanProject) {
    #scanp(txScanProject, int, 0) dOff;
    #scanp(txScanProject, int, 1) dLen;
    #req[txScanDefs] txScanDefs;
    #req[txHasProject] txHasProject;
    #stack[int, 64] names = cssc::alloc(131072);
    cssc::osListDir(dOff, dLen, names, 131072) nlen;
    #stack[int, 64] pathBuf = cssc::alloc(4096);
    #stack[int, 64] fileBuf = cssc::alloc(1200000);
    #stack[int, 64] i = 0;
    #stack[int, 32] go = 1;
    while (go == 1) {
        if (i >= nlen) { go = 0; }
        if (go == 1) {
            #stack[int, 64] j = i;
            #stack[int, 32] sg = 1;
            while (sg == 1) {
                if (j >= nlen) { sg = 0; }
                if (sg == 1) { if (cssc::peek8(names + j) == 10) { sg = 0; } else { j = j + 1; } }
            }
            #delete[sg];
            #stack[int, 64] elen = j - i;
            #stack[int, 32] iscssc = 0;
            if (elen > 5) {
                #stack[int, 64] b = i + elen - 5;
                if (cssc::peek8(names + b) == 46) {
                    if (cssc::peek8(names + b + 1) == 99) {
                        if (cssc::peek8(names + b + 2) == 115) {
                            if (cssc::peek8(names + b + 3) == 115) {
                                if (cssc::peek8(names + b + 4) == 99) { iscssc = 1; }
                            }
                        }
                    }
                }
                #delete[b];
            }
            if (iscssc == 1) {
                #stack[int, 64] k = 0;
                while (k < dLen) { cssc::poke8(pathBuf + k, cssc::peek8(dOff + k)); k = k + 1; }
                cssc::poke8(pathBuf + dLen, 47);
                #stack[int, 64] m = 0;
                while (m < elen) { cssc::poke8(pathBuf + dLen + 1 + m, cssc::peek8(names + i + m)); m = m + 1; }
                #stack[int, 64] plen = dLen + 1 + elen;
                cssc::osReadFile(pathBuf, plen, fileBuf, 1200000) rn;
                if (rn > 0) { txScanDefs(fileBuf, rn); }
                #delete[k];
                #delete[m];
                #delete[plen];
                #delete[rn];
            }
            #delete[elen];
            #delete[iscssc];
            i = j + 1;
        }
    }
    #delete[i];
    #delete[go];
    #delete[names];
    #delete[pathBuf];
    #delete[fileBuf];
    txHasProject = 1;
}

// Blank the CONTENT of every `/* … */` block comment in txSrc to spaces
// (newlines/CR preserved so line:col stay exact). The lexer already skips block
// comments, so no AST node points into one — but the TEXT lints (MISSING_SEMICOLON,
// SELECT_CURSOR_NO_QMARK) and the raw declaration scans read txSrc directly and
// would otherwise treat block-comment text as code. Line comments (`//`) are left
// to the scans that already handle them; a `/*` inside a `//` or a string is not a
// block open (both are skipped here first).
#define(txBlankBlockComments) {
    #req[txSrc] txSrc;
    #req[txSrcLen] txSrcLen;
    #stack[int, 64] i = 0;
    #stack[int, 32] go = 1;
    while (go == 1) {
        if (i >= txSrcLen) { go = 0; }
        if (go == 1) {
            #stack[int, 64] c = cssc::peek8(txSrc + i);
            if (c == 34) {                                  // "…" string — skip verbatim
                i = i + 1;
                #stack[int, 32] sg = 1;
                while (sg == 1) {
                    if (i >= txSrcLen) { sg = 0; }
                    if (sg == 1) {
                        #stack[int, 64] sc = cssc::peek8(txSrc + i);
                        if (sc == 92) { i = i + 2; }
                        else { if (sc == 34) { i = i + 1; sg = 0; } else { i = i + 1; } }
                        #delete[sc];
                    }
                }
                #delete[sg];
            } else {
                #stack[int, 32] handled = 0;
                if (c == 47) {                              // '/'
                    if (i + 1 < txSrcLen) {
                        #stack[int, 64] c2 = cssc::peek8(txSrc + i + 1);
                        if (c2 == 47) {                     // '//' line comment — skip to EOL, no blank
                            handled = 1;
                            i = i + 2;
                            #stack[int, 32] lg = 1;
                            while (lg == 1) {
                                if (i >= txSrcLen) { lg = 0; }
                                if (lg == 1) { if (cssc::peek8(txSrc + i) == 10) { lg = 0; } else { i = i + 1; } }
                            }
                            #delete[lg];
                        }
                        if (c2 == 42) {                     // '/*' block comment — BLANK content
                            handled = 1;
                            cssc::poke8(txSrc + i, 32);
                            cssc::poke8(txSrc + i + 1, 32);
                            i = i + 2;
                            #stack[int, 32] bg = 1;
                            while (bg == 1) {
                                if (i >= txSrcLen) { bg = 0; }
                                if (bg == 1) {
                                    #stack[int, 64] bc = cssc::peek8(txSrc + i);
                                    #stack[int, 32] closed = 0;
                                    if (bc == 42) {
                                        if (i + 1 < txSrcLen) {
                                            if (cssc::peek8(txSrc + i + 1) == 47) {   // '*/'
                                                cssc::poke8(txSrc + i, 32);
                                                cssc::poke8(txSrc + i + 1, 32);
                                                i = i + 2; bg = 0; closed = 1;
                                            }
                                        }
                                    }
                                    if (closed == 0) {
                                        if (bc != 10) { if (bc != 13) { cssc::poke8(txSrc + i, 32); } }
                                        i = i + 1;
                                    }
                                    #delete[closed];
                                    #delete[bc];
                                }
                            }
                            #delete[bg];
                        }
                        #delete[c2];
                    }
                }
                if (handled == 0) { i = i + 1; }
                #delete[handled];
            }
            #delete[c];
        }
    }
    #delete[i];
    #delete[go];
}

#define(txSemaBuild) {
    #scanp(txSemaBuild, int, 0) prog;
    #req[txAstA] txAstA;
    #req[txSemaVisitChain] txSemaVisitChain;
    #req[txDdInit] txDdInit;
    #req[txDdReset] txDdReset;
    #req[txDdWalkChain] txDdWalkChain;
    #req[txUadWalkChain] txUadWalkChain;
    #req[txSemaBuildSyms] txSemaBuildSyms;
    #req[txLeakCollectDeletes] txLeakCollectDeletes;
    #req[txLeakScan] txLeakScan;
    #req[txDanglingScan] txDanglingScan;
    #req[txDanglingStore] txDanglingStore;
    #req[txAccessWalk] txAccessWalk;
    #req[txMissingSemiScan] txMissingSemiScan;
    #req[txSelectCursorScan] txSelectCursorScan;
    #req[txMethodCheckWalk] txMethodCheckWalk;
    #req[txUnknownFuncWalk] txUnknownFuncWalk;
    #req[txUnknownVarWalk] txUnknownVarWalk;
    #req[txBlankBlockComments] txBlankBlockComments;
    #stack[int, 64] top = cssc::peek64(txAstA + prog * 8);
    #req[txAstCap] txAstCap;
    #req[txSelCursSeen] txSelCursSeen;
    if (txSelCursSeen == 0) { txSelCursSeen = cssc::alloc(txAstCap * 8); cssc::memfill32(txSelCursSeen, 0, txAstCap * 2); }
    txBlankBlockComments();       // neutralize /* … */ so text lints don't see code
    txMissingSemiScan();          // MISSING_SEMICOLON (text lint)
    txSelectCursorScan();         // SELECT_CURSOR_NO_QMARK (text lint)
    txSemaVisitChain(top);        // SELECT_WITHOUT_JUMP
    txDdInit();
    txDdWalkChain(top);           // DOUBLE_DELETE
    txDdReset();
    txUadWalkChain(top);          // USE_AFTER_DELETE
    txSemaBuildSyms(prog);        // build the symbol table
    txAccessWalk();               // NS_ACCESS_ON_OBJECT + DOT_ACCESS_ON_SECTOR
    txMethodCheckWalk();          // NO_SUCH_METHOD (typed-receiver method check)
    txUnknownFuncWalk();          // UNKNOWN_FUNCTION (gated on txHasProject: only
                                  // fires with whole-project cross-file context)
    txUnknownVarWalk();           // UNKNOWN_VARIABLE (same gate)
    txDdReset();
    txLeakCollectDeletes();       // "ever deleted" set
    txLeakScan();                 // LIFETIME_LEAK
    txDanglingScan();             // DANGLING_RETURN
    txDanglingStore();            // DANGLING_STORE (ref held past referent #delete)
    #delete[top];
}

// ===========================================================================
//  Completion — position-based. The cursor is a marker byte (0x04) the caller
//  inserts into the source; `txCompleteAt` looks at the text before it and
//  emits candidate labels (one per line). First context: `#directive` typing
//  (`#de` -> #define/#delete/#depend/#DEFINE/#debug). Parity oracle:
//  `cssc lsp complete`. More contexts (`::`, `.`, identifier) build on the
//  symbol model next.
// ===========================================================================
#stack[int, 64] txSetSrc;
#stack[int, 64] txFindMarker;
#stack[int, 64] txCompStartsWith;
#stack[int, 64] txCompDirectives;
#stack[int, 64] txScanIdentBack;
#stack[int, 64] txScanIdentFwd;
#stack[int, 64] txHoverAt;
#stack[int, 64] txHoverInit;
#stack[int, 64] txEmitSentinel;
#stack[int, 64] txResolveInit;
#stack[int, 64] txResolveTerm;
#stack[int, 64] txSymByName;
#stack[int, 64] txHoverDoc;
#stack[int, 64] txDocBefore;
#stack[int, 64] txDocBodyB;
#stack[int, 64] txHoverEmitDoc;
#stack[int, 64] txLoadedMemberHover;
#stack[int, 64] txSignatureAt;
#stack[int, 64] txSpanPrefix;
#stack[int, 64] txScopeByOwner;
#stack[int, 64] txResolveTypeScope;
#stack[int, 64] txCompMember;
#stack[int, 64] txSlotDeclType;
#stack[int, 64] txCompStringMethods;
#stack[int, 64] txCompVectorMethods;
#stack[int, 64] txCompMapMethods;
#stack[int, 64] txCompBindMethods;
#stack[int, 64] txScopeAt;
#stack[int, 64] txReqScopeAt;
#stack[int, 64] txMatchRank;
#stack[int, 64] txLitPrefixCS;
#stack[int, 64] txCompKwType;
#stack[int, 64] txVisibleEmit;
#stack[int, 64] txHasInclude;
#stack[int, 64] txEmitFiltered;
#stack[int, 64] txCompModuleNames;
#stack[int, 64] txCompModuleMethods;
#stack[int, 64] txModuleForAlias;
#stack[int, 64] txCompleteAt;

// start offset of the identifier run ending at `from` (exclusive).
#define(txScanIdentBack) {
    #scanp(txScanIdentBack, int, 0) from;
    #req[txSrc] txSrc;
    #stack[int, 64] p = from;
    #stack[int, 32] go = 1;
    while (go == 1) {
        if (p <= 0) { go = 0; }
        if (go == 1) {
            #stack[int, 64] c = cssc::peek8(txSrc + p - 1);
            #stack[int, 32] id = 0;
            if (c >= 48) { if (c <= 57) { id = 1; } }
            if (c >= 65) { if (c <= 90) { id = 1; } }
            if (c >= 97) { if (c <= 122) { id = 1; } }
            if (c == 95) { id = 1; }
            if (id == 1) { p = p - 1; }
            if (id == 0) { go = 0; }
            #delete[c];
            #delete[id];
        }
    }
    #delete[go];
    return p;
}

// end offset of the identifier run starting at `from` (inclusive).
#define(txScanIdentFwd) {
    #scanp(txScanIdentFwd, int, 0) from;
    #req[txSrc] txSrc;
    #req[txSrcLen] txSrcLen;
    #stack[int, 64] p = from;
    #stack[int, 32] go = 1;
    while (go == 1) {
        if (p >= txSrcLen) { go = 0; }
        if (go == 1) {
            #stack[int, 64] c = cssc::peek8(txSrc + p);
            #stack[int, 32] id = 0;
            if (c >= 48) { if (c <= 57) { id = 1; } }
            if (c >= 65) { if (c <= 90) { id = 1; } }
            if (c >= 97) { if (c <= 122) { id = 1; } }
            if (c == 95) { id = 1; }
            if (id == 1) { p = p + 1; }
            if (id == 0) { go = 0; }
            #delete[c];
            #delete[id];
        }
    }
    #delete[go];
    return p;
}

// Core hover: resolve the identifier at cursor offset `off` to a symbol and
// print a concise description. Not the reference's rich markdown (that needs
// read/write access-counting) — a useful `<kind> name [: <type> (<size> B)]`.
// Emit `label` if span(txSrc+off, len) == nm. Doc-lookup workhorse.
#define(txDocTry) {
    #scanp(txDocTry, int, 0) off;
    #scanp(txDocTry, int, 1) len;
    #scanp(txDocTry, string, 2) nm;
    #scanp(txDocTry, string, 3) label;
    #req[txSpanEqLit] txSpanEqLit;
    txSpanEqLit(off, len, nm) m;
    if (m == 1) { cssc::out(label); cssc::outln(); }
    #delete[m];
}

// One-line docs for the built-in container methods (string/vector/map/bind).
// Descriptions are mostly type-agnostic; the caller only invokes this for a
// receiver whose declared type is a known container. Names are exact.
#define(txDocContainer) {
    #scanp(txDocContainer, int, 0) off;
    #scanp(txDocContainer, int, 1) len;
    #req[txDocTry] txDocTry;
    txDocTry(off, len, "size", "size() - number of elements / string length");
    txDocTry(off, len, "length", "length() - number of elements / string length");
    txDocTry(off, len, "push_back", "push_back(v) - append an element to the end");
    txDocTry(off, len, "push", "push(v) - append an element to the end");
    txDocTry(off, len, "push_front", "push_front(v) - insert an element at the front");
    txDocTry(off, len, "pop_back", "pop_back() - remove and return the last element");
    txDocTry(off, len, "pop", "pop() - remove and return the last element");
    txDocTry(off, len, "pop_front", "pop_front() - remove and return the first element");
    txDocTry(off, len, "at", "at(i) - element at index i (key for maps)");
    txDocTry(off, len, "get", "get(k) - value for key/index k");
    txDocTry(off, len, "set", "set(k, v) - set the value at key/index k");
    txDocTry(off, len, "has", "has(k) - true if the key exists");
    txDocTry(off, len, "contains", "contains(v) - true if the value is present");
    txDocTry(off, len, "indexof", "indexof(v) - index of a value, or -1");
    txDocTry(off, len, "indexOf", "indexOf(v) - index of a value, or -1");
    txDocTry(off, len, "first", "first() - the first element");
    txDocTry(off, len, "last", "last() - the last element");
    txDocTry(off, len, "front", "front() - the first element");
    txDocTry(off, len, "back", "back() - the last element");
    txDocTry(off, len, "clear", "clear() - remove all elements");
    txDocTry(off, len, "empty", "empty() - true if there are no elements");
    txDocTry(off, len, "insert", "insert(i, v) - insert an element at index i");
    txDocTry(off, len, "erase", "erase(i) - remove the element at index i");
    txDocTry(off, len, "remove", "remove(x) - remove a value (or key for maps)");
    txDocTry(off, len, "slice", "slice(start, end) - a sub-range copy");
    txDocTry(off, len, "sort", "sort() - sort the elements in place");
    txDocTry(off, len, "reverse", "reverse() - reverse the order (or string) in place");
    txDocTry(off, len, "join", "join(sep) - join the elements into a string");
    txDocTry(off, len, "count", "count(v) - number of occurrences of v");
    txDocTry(off, len, "unique", "unique() - the distinct elements");
    txDocTry(off, len, "flat", "flat() - flatten one level of nesting");
    txDocTry(off, len, "keys", "keys() - the map's keys");
    txDocTry(off, len, "values", "values() - the map's values");
    txDocTry(off, len, "append", "append(x) - append an element / merge a map");
    txDocTry(off, len, "width", "width() - a bind's pair width");
    txDocTry(off, len, "pair_width", "pair_width() - a bind's pair width");
    txDocTry(off, len, "addmap", "addmap(m) - append a map's entries to the bind");
    txDocTry(off, len, "upper", "upper() - an uppercase copy of the string");
    txDocTry(off, len, "lower", "lower() - a lowercase copy of the string");
    txDocTry(off, len, "trim", "trim() - the string with surrounding whitespace removed");
    txDocTry(off, len, "split", "split(sep) - split the string into parts");
    txDocTry(off, len, "replace", "replace(old, new) - replace occurrences in the string");
    txDocTry(off, len, "substr", "substr(start, len) - a substring");
    txDocTry(off, len, "substring", "substring(start, end) - a substring");
    txDocTry(off, len, "startswith", "startswith(p) - true if the string starts with p");
    txDocTry(off, len, "endswith", "endswith(s) - true if the string ends with s");
    txDocTry(off, len, "contains", "contains(x) - true if present");
}

// ===========================================================================
//  Initializer resolution for hover — `init: <value>`.
//  A slot's declared initializer is folded to a display value:
//    * no initializer  -> the TYPE's null sentinel ("" / 0 / 0.0 / {}).
//    * a literal / a chain of literals + variables -> the folded value.
//    * a part that can't be known statically (a call, cssc::random, …) -> a
//      turquoise `?`; in a string that also drops the closing quote.
//  Variable references resolve through their own declaration (bounded depth),
//  which also covers `#req` aliases (an alias's decl carries the source type).
// ===========================================================================
#stack[int, 64] txInitS = 0;         // out: init expr start (set by txSymInitSpan)
#stack[int, 64] txInitE = 0;         // out: init expr end
#stack[int, 64] txTypeOff = 0;       // out: declared type-text span (set by the hover)
#stack[int, 64] txTypeLen = 0;       // e.g. "bool"/"char" when declType is outside 0..5
#stack[int, 64] txSymInitSpan;

// Set txInitS/txInitE to the initializer expression span of slot `sym`
// (the text between '=' and ';'/newline). Returns 1 if the slot has an
// initializer, 0 otherwise.
#define(txSymInitSpan) {
    #scanp(txSymInitSpan, int, 0) sym;
    #req[txSrc] txSrc;
    #req[txSrcLen] txSrcLen;
    #req[txSemaSymOff] txSemaSymOff;
    #req[txSemaSymLen] txSemaSymLen;
    #req[txInitS] txInitS;
    #req[txInitE] txInitE;
    #stack[int, 64] no = cssc::peek64(txSemaSymOff + sym * 8);
    #stack[int, 64] nl = cssc::peek64(txSemaSymLen + sym * 8);
    #stack[int, 64] j = no + nl;
    #stack[int, 64] eq = 0 - 1;
    #stack[int, 32] g = 1;
    while (g == 1) {
        if (j >= txSrcLen) { g = 0; }
        if (g == 1) {
            #stack[int, 64] c = cssc::peek8(txSrc + j);
            if (c == 59) { g = 0; }          // ';'
            if (c == 10) { g = 0; }          // newline
            if (c == 61) { eq = j; g = 0; }  // '='
            #delete[c];
            if (g == 1) { j = j + 1; }
        }
    }
    #delete[g];
    #delete[j];
    #delete[no];
    #delete[nl];
    #stack[int, 32] has = 0;
    if (eq >= 0) {
        has = 1;
        #stack[int, 64] s = eq + 1;
        #stack[int, 64] e = s;
        #stack[int, 32] fg = 1;
        while (fg == 1) {
            if (e >= txSrcLen) { fg = 0; }
            if (fg == 1) {
                #stack[int, 64] c = cssc::peek8(txSrc + e);
                if (c == 59) { fg = 0; }
                if (c == 10) { fg = 0; }
                #delete[c];
                if (fg == 1) { e = e + 1; }
            }
        }
        #delete[fg];
        txInitS = s;
        txInitE = e;
        #delete[s];
        #delete[e];
    }
    #delete[eq];
    return has;
}

#define(txEmitSentinel) {
    #scanp(txEmitSentinel, int, 0) dt;
    if (dt == 0) { cssc::out("0"); }
    if (dt == 1) { cssc::out("\"\""); }
    if (dt == 2) { cssc::out("0.0"); }
    if (dt >= 3) { cssc::out("{}"); }
}

// Symbol index of a SLOT / PARAM / #req-alias named [off,len], or -1.
#define(txSymByName) {
    #scanp(txSymByName, int, 0) off;
    #scanp(txSymByName, int, 1) len;
    #req[txSemaSymOff] txSemaSymOff;
    #req[txSemaSymLen] txSemaSymLen;
    #req[txSemaSymKind] txSemaSymKind;
    #req[txSemaSymCount] txSemaSymCount;
    #req[txDdSpanEq] txDdSpanEq;
    #stack[int, 64] r = 0 - 1;
    #stack[int, 64] i = 0;
    #stack[int, 32] g = 1;
    while (g == 1) {
        if (i >= txSemaSymCount) { g = 0; }
        if (g == 1) {
            #stack[int, 64] kk = cssc::peek64(txSemaSymKind + i * 8);
            #stack[int, 32] ok = 0;
            if (kk == 1) { ok = 1; }
            if (kk == 5) { ok = 1; }
            if (kk == 7) { ok = 1; }
            if (ok == 1) {
                txDdSpanEq(off, len, cssc::peek64(txSemaSymOff + i * 8),
                           cssc::peek64(txSemaSymLen + i * 8)) eq;
                if (eq == 1) { r = i; g = 0; }
                #delete[eq];
            }
            #delete[kk];
            #delete[ok];
            if (g == 1) { i = i + 1; }
        }
    }
    #delete[i];
    #delete[g];
    return r;
}

// Resolve init text [off,end) for a slot of `declType`, emitting a display
// value. Returns 1 = fully resolved, 0 = a `?` was emitted. `strCtx` (1) folds
// as string concatenation (quoted); otherwise scalar. `depth` bounds var-ref
// recursion. `?` is emitted as a bare '?' the hover renderer paints turquoise.
#define(txResolveInit) {
    #scanp(txResolveInit, int, 0) off;
    #scanp(txResolveInit, int, 1) end;
    #scanp(txResolveInit, int, 2) declType;
    #scanp(txResolveInit, int, 3) depth;
    #scanp(txResolveInit, int, 4) noQuote;
    #req[txSrc] txSrc;
    #req[txSymByName] txSymByName;
    #req[txSymInitSpan] txSymInitSpan;
    #req[txResolveInit] txResolveInit;
    #req[txSemaSymDeclType] txSemaSymDeclType;
    #req[txInitS] txInitS;
    #req[txInitE] txInitE;
    // trim
    #stack[int, 64] s = off;
    #stack[int, 32] t1 = 1;
    while (t1 == 1) {
        if (s >= end) { t1 = 0; }
        if (t1 == 1) { #stack[int, 64] c = cssc::peek8(txSrc + s);
            if (c == 32) { s = s + 1; } else { if (c == 9) { s = s + 1; } else { t1 = 0; } } #delete[c]; }
    }
    #delete[t1];
    #stack[int, 64] e = end;
    #stack[int, 32] t2 = 1;
    while (t2 == 1) {
        if (e <= s) { t2 = 0; }
        if (t2 == 1) { #stack[int, 64] c = cssc::peek8(txSrc + e - 1);
            if (c == 32) { e = e - 1; } else { if (c == 9) { e = e - 1; } else { t2 = 0; } } #delete[c]; }
    }
    #delete[t2];
    #stack[int, 32] isStr = 0;
    if (declType == 1) { isStr = 1; }
    if (s < e) { if (cssc::peek8(txSrc + s) == 34) { isStr = 1; } }
    #stack[int, 32] bad = 0;
    // A NON-string init with a top-level arithmetic operator (`+`, `*`, `/`)
    // is not a foldable literal (`2 + 3` must not become the concatenation
    // "23") — show `?`. A single literal / variable still resolves below.
    #stack[int, 32] scalarBad = 0;
    if (isStr == 0) {
        #stack[int, 64] q = s;
        #stack[int, 64] dq = 0;
        #stack[int, 32] iqq = 0;
        while (q < e) {
            #stack[int, 64] c = cssc::peek8(txSrc + q);
            if (iqq == 1) { if (c == 34) { iqq = 0; } }
            else {
                if (c == 34) { iqq = 1; }
                if (c == 40) { dq = dq + 1; }
                if (c == 41) { dq = dq - 1; }
                if (dq == 0) {
                    if (c == 43) { scalarBad = 1; }
                    if (c == 42) { scalarBad = 1; }
                    if (c == 47) { scalarBad = 1; }
                }
            }
            #delete[c];
            q = q + 1;
        }
        #delete[q];
        #delete[dq];
        #delete[iqq];
    }
    if (scalarBad == 1) { cssc::out("?"); bad = 1; }
    if (isStr == 1) { if (noQuote == 0) { cssc::out("\""); } }
    #stack[int, 64] ts = s;
    #stack[int, 32] wg = 1;
    if (scalarBad == 1) { wg = 0; }
    while (wg == 1) {
        // scan to next top-level '+'
        #stack[int, 64] p = ts;
        #stack[int, 64] te = e;
        #stack[int, 64] dp = 0;
        #stack[int, 32] iq = 0;
        #stack[int, 32] fg = 1;
        while (fg == 1) {
            if (p >= e) { te = e; fg = 0; }
            if (fg == 1) {
                #stack[int, 64] c = cssc::peek8(txSrc + p);
                if (iq == 1) { if (c == 34) { iq = 0; } }
                else {
                    if (c == 34) { iq = 1; }
                    if (c == 40) { dp = dp + 1; }
                    if (c == 41) { dp = dp - 1; }
                    if (c == 91) { dp = dp + 1; }
                    if (c == 93) { dp = dp - 1; }
                    if (c == 43) { if (dp == 0) { te = p; fg = 0; } }
                }
                #delete[c];
                if (fg == 1) { p = p + 1; }
            }
        }
        #delete[fg];
        #delete[iq];
        #delete[dp];
        // trim the term [ts, te)
        #stack[int, 64] a = ts;
        #stack[int, 32] ta = 1;
        while (ta == 1) { if (a >= te) { ta = 0; }
            if (ta == 1) { #stack[int, 64] c = cssc::peek8(txSrc + a);
                if (c == 32) { a = a + 1; } else { if (c == 9) { a = a + 1; } else { ta = 0; } } #delete[c]; } }
        #delete[ta];
        #stack[int, 64] b = te;
        #stack[int, 32] tb = 1;
        while (tb == 1) { if (b <= a) { tb = 0; }
            if (tb == 1) { #stack[int, 64] c = cssc::peek8(txSrc + b - 1);
                if (c == 32) { b = b - 1; } else { if (c == 9) { b = b - 1; } else { tb = 0; } } #delete[c]; } }
        #delete[tb];
        if (b > a) {
            #stack[int, 64] fc = cssc::peek8(txSrc + a);
            if (fc == 34) {                                  // "..." literal
                #stack[int, 64] q = a + 1;
                #stack[int, 32] sg = 1;
                while (sg == 1) {
                    if (q >= b) { sg = 0; }
                    if (sg == 1) {
                        #stack[int, 64] c = cssc::peek8(txSrc + q);
                        if (c == 34) { sg = 0; } else { cssc::printRaw(txSrc + q, 1); q = q + 1; }
                        #delete[c];
                    }
                }
                #delete[sg];
                #delete[q];
            } else {
                #stack[int, 32] dig = 0;
                if (fc >= 48) { if (fc <= 57) { dig = 1; } }
                if (fc == 45) { dig = 1; }                   // '-'
                #stack[int, 32] alp = 0;
                if (fc >= 65) { if (fc <= 90) { alp = 1; } }
                if (fc >= 97) { if (fc <= 122) { alp = 1; } }
                if (fc == 95) { alp = 1; }
                // does the term contain '(' or ':' -> a call / qualified -> dynamic
                #stack[int, 32] isCall = 0;
                #stack[int, 64] sc = a;
                while (sc < b) {
                    #stack[int, 64] c = cssc::peek8(txSrc + sc);
                    if (c == 40) { isCall = 1; }
                    if (c == 58) { isCall = 1; }
                    #delete[c];
                    sc = sc + 1;
                }
                #delete[sc];
                if (dig == 1) {                              // numeric / bool-ish literal
                    if (isCall == 0) { cssc::printRaw(txSrc + a, b - a); }
                    else { cssc::out(" ?"); bad = 1; }
                } else {
                    if (alp == 1) {
                        if (isCall == 1) { cssc::out(" ?"); bad = 1; }
                        else {
                            // bool / null keyword?
                            #stack[int, 32] kw = 0;
                            if (b - a == 4) { if (cssc::peek8(txSrc + a) == 116) { kw = 1; } }  // true
                            if (b - a == 5) { if (cssc::peek8(txSrc + a) == 102) { kw = 1; } }  // false
                            if (b - a == 4) { if (cssc::peek8(txSrc + a) == 110) { kw = 1; } }  // null
                            if (kw == 1) { cssc::printRaw(txSrc + a, b - a); }
                            else {
                                // variable reference -> resolve through its decl
                                #stack[int, 64] rsym = 0 - 1;
                                if (depth < 4) { txSymByName(a, b - a) rs; rsym = rs; #delete[rs]; }
                                #stack[int, 32] done = 0;
                                if (rsym >= 0) {
                                    txSymInitSpan(rsym) hasI;
                                    #stack[int, 64] rdt = cssc::peek64(txSemaSymDeclType + rsym * 8);
                                    if (hasI == 1) {
                                        // recurse WITHOUT the surrounding quotes
                                        #stack[int, 64] ris = txInitS;
                                        #stack[int, 64] rie = txInitE;
                                        txResolveInit(ris, rie, rdt, depth + 1, 1) rr;
                                        if (rr == 0) { bad = 1; }
                                        done = 1;
                                        #delete[ris];
                                        #delete[rie];
                                        #delete[rr];
                                    } else {
                                        // no init -> its sentinel content (unquoted here)
                                        if (rdt == 1) { done = 1; }   // "" -> empty in a concat
                                        if (rdt == 0) { cssc::out("0"); done = 1; }
                                        if (rdt == 2) { cssc::out("0.0"); done = 1; }
                                    }
                                    #delete[hasI];
                                    #delete[rdt];
                                }
                                #delete[rsym];
                                if (done == 0) { cssc::out(" ?"); bad = 1; }
                                #delete[done];
                            }
                            #delete[kw];
                        }
                    } else { cssc::out(" ?"); bad = 1; }
                }
                #delete[dig];
                #delete[alp];
                #delete[isCall];
            }
            #delete[fc];
        }
        #delete[a];
        #delete[b];
        if (te >= e) { wg = 0; }
        if (wg == 1) { ts = te + 1; }
        #delete[p];
        #delete[te];
    }
    #delete[wg];
    #delete[ts];
    if (isStr == 1) { if (bad == 0) { if (noQuote == 0) { cssc::out("\""); } } }
    #stack[int, 32] ret = 1;
    if (bad == 1) { ret = 0; }
    #delete[bad];
    #delete[scalarBad];
    #delete[isStr];
    #delete[s];
    #delete[e];
    return ret;
}

// Emit the `init: …` line for slot `sym` (declType `dt`).
#define(txHoverInit) {
    #scanp(txHoverInit, int, 0) sym;
    #scanp(txHoverInit, int, 1) dt;
    #req[txSymInitSpan] txSymInitSpan;
    #req[txEmitSentinel] txEmitSentinel;
    #req[txResolveInit] txResolveInit;
    #req[txSpanEqLit] txSpanEqLit;
    #req[txTypeOff] txTypeOff;
    #req[txTypeLen] txTypeLen;
    #req[txInitS] txInitS;
    #req[txInitE] txInitE;
    cssc::out("init: ");
    txSymInitSpan(sym) has;
    if (has == 0) {
        // bool's null sentinel is `false`; its type has no declType number so it
        // is recognised via the type-text span set by the hover's type block.
        #stack[int, 32] isBool = 0;
        if (txTypeLen == 4) {
            txSpanEqLit(txTypeOff, txTypeLen, "bool") bb;
            if (bb == 1) { isBool = 1; }
            #delete[bb];
        }
        if (isBool == 1) { cssc::out("false"); }
        else { txEmitSentinel(dt); }
        #delete[isBool];
    } else {
        #stack[int, 64] is = txInitS;
        #stack[int, 64] ie = txInitE;
        txResolveInit(is, ie, dt, 0, 0) r;
        #delete[is];
        #delete[ie];
        #delete[r];
    }
    cssc::outln();
    #delete[has];
}

#define(txHoverAt) {
    #scanp(txHoverAt, int, 0) off;
    #req[txSrc] txSrc;
    #req[txScanIdentBack] txScanIdentBack;
    #req[txScanIdentFwd] txScanIdentFwd;
    #req[txSlotDeclType] txSlotDeclType;
    #req[txDocContainer] txDocContainer;
    #req[txSemaSymOff] txSemaSymOff;
    #req[txSemaSymLen] txSemaSymLen;
    #req[txSemaSymKind] txSemaSymKind;
    #req[txSemaSymScope] txSemaSymScope;
    #req[txSemaSymDeclType] txSemaSymDeclType;
    #req[txSemaSymCount] txSemaSymCount;
    #req[txSemaSymNode] txSemaSymNode;
    #req[txHoverInit] txHoverInit;
    #req[txSymByName] txSymByName;
    #req[txAstOff] txAstOff;
    #req[txAstLen] txAstLen;
    #req[txTypeOff] txTypeOff;
    #req[txTypeLen] txTypeLen;
    #req[txSemaLineOf] txSemaLineOf;
    #req[txScopeAt] txScopeAt;
    #req[txDdSpanEq] txDdSpanEq;
    #req[txHoverEmitDoc] txHoverEmitDoc;
    #req[txSrcLen] txSrcLen;
    #req[txLoadPathAt] txLoadPathAt;
    #req[txLoadPathO] txLoadPathO;
    #req[txLoadPathL] txLoadPathL;
    #req[txLoadedMemberHover] txLoadedMemberHover;
    #req[txCompDirBuf] txCompDirBuf;
    #req[txCompDirLen] txCompDirLen;
    #req[txSpanEqLit] txSpanEqLit;
    #req[txSigCssc] txSigCssc;
    #req[txSigNoActive] txSigNoActive;
    txScanIdentBack(off) ws;
    txScanIdentFwd(off) we;
    #stack[int, 64] wlen = we - ws;
    if (wlen > 0) {
        #stack[int, 32] hdone = 0;
        // a hex color literal `0x...` -> its rgb, so the hover box shows a swatch
        if (wlen >= 5) {
            #stack[int, 32] isHexC = 0;
            if (cssc::peek8(txSrc + ws) == 48) {                  // '0'
                #stack[int, 32] xc = cssc::peek8(txSrc + ws + 1);
                if (xc == 120) { isHexC = 1; }                    // 'x'
                if (xc == 88) { isHexC = 1; }                     // 'X'
                #delete[xc];
            }
            if (isHexC == 1) {
                #stack[int, 64] hval = 0;
                #stack[int, 32] hnd = 0;
                #stack[int, 64] hq = ws + 2;
                #stack[int, 32] hgo = 1;
                while (hgo == 1) {
                    if (hq >= we) { hgo = 0; }
                    if (hgo == 1) {
                        #stack[int, 32] hc = cssc::peek8(txSrc + hq);
                        #stack[int, 32] hnv = 0 - 1;
                        if (hc >= 48) { if (hc <= 57) { hnv = hc - 48; } }
                        if (hc >= 65) { if (hc <= 70) { hnv = hc - 55; } }
                        if (hc >= 97) { if (hc <= 102) { hnv = hc - 87; } }
                        if (hnv < 0) { hgo = 0; }
                        if (hnv >= 0) { hval = hval * 16 + hnv; hnd = hnd + 1; }
                        #delete[hnv];
                        #delete[hc];
                        if (hgo == 1) { hq = hq + 1; }
                    }
                }
                #delete[hgo];
                #delete[hq];
                #stack[int, 32] hr = 0 - 1;
                #stack[int, 32] hg2 = 0;
                #stack[int, 32] hb = 0;
                if (hnd == 8) { hr = hval / 65536 % 256; hg2 = hval / 256 % 256; hb = hval % 256; }
                if (hnd == 6) { hr = hval / 65536 % 256; hg2 = hval / 256 % 256; hb = hval % 256; }
                if (hnd == 3) { hr = hval / 256 % 16 * 17; hg2 = hval / 16 % 16 * 17; hb = hval % 16 * 17; }
                if (hr >= 0) {
                    cssc::out("rgb(");
                    cssc::out(hr);
                    cssc::out(", ");
                    cssc::out(hg2);
                    cssc::out(", ");
                    cssc::out(hb);
                    cssc::out(")");
                    cssc::outln();
                    hdone = 1;
                }
                #delete[hb];
                #delete[hg2];
                #delete[hr];
                #delete[hnd];
                #delete[hval];
            }
            #delete[isHexC];
        }
        // qualified `cssc::method` -> the intrinsic's signature + one-line doc
        if (ws >= 2) {
            if (cssc::peek8(txSrc + ws - 1) == 58) {
                if (cssc::peek8(txSrc + ws - 2) == 58) {
                    txScanIdentBack(ws - 2) qs;
                    txSpanEqLit(qs, (ws - 2) - qs, "cssc") isC;
                    if (isC == 1) {
                        txSigNoActive = 1;
                        txSigCssc(ws, wlen, 0);
                        txSigNoActive = 0;
                        hdone = 1;
                    }
                    #delete[isC];
                    #delete[qs];
                }
            }
        }
        // qualified `alias::member` where alias is a #load'd module -> the member's
        // kind + //d docs, read from the loaded file's surface (no cross-file diags).
        if (hdone == 0) {
            if (ws >= 2) {
                if (cssc::peek8(txSrc + ws - 1) == 58) {
                    if (cssc::peek8(txSrc + ws - 2) == 58) {
                        txScanIdentBack(ws - 2) lqs;
                        #stack[int, 64] lqlen = (ws - 2) - lqs;
                        if (lqlen > 0) {
                            txLoadPathAt(lqs, lqlen, ws) ld;
                            if (ld == 1) {
                                #stack[int, 64] pathBuf = cssc::alloc(4096);
                                #stack[int, 64] pp = 0;
                                while (pp < txCompDirLen) { cssc::poke8(pathBuf + pp, cssc::peek8(txCompDirBuf + pp)); pp = pp + 1; }
                                if (txCompDirLen > 0) { cssc::poke8(pathBuf + pp, 47); pp = pp + 1; }
                                #stack[int, 64] pk = 0;
                                while (pk < txLoadPathL) { cssc::poke8(pathBuf + pp + pk, cssc::peek8(txSrc + txLoadPathO + pk)); pk = pk + 1; }
                                #delete[pk];
                                #stack[int, 64] fullLen = pp + txLoadPathL;
                                #stack[int, 64] fileBuf = cssc::alloc(1200000);
                                cssc::osReadFile(pathBuf, fullLen, fileBuf, 1200000) rn;
                                if (rn > 0) { txLoadedMemberHover(ws, wlen, fileBuf, rn) fh; if (fh == 1) { hdone = 1; } #delete[fh]; }
                                #delete[rn];
                                #delete[fileBuf];
                                #delete[fullLen];
                                #delete[pp];
                                #delete[pathBuf];
                            }
                            #delete[ld];
                        }
                        #delete[lqlen];
                        #delete[lqs];
                    }
                }
            }
        }
        // `<var>.method` where var is a known container -> the method's doc
        if (hdone == 0) {
            if (ws >= 1) {
                if (cssc::peek8(txSrc + ws - 1) == 46) {          // '.'
                    txScanIdentBack(ws - 1) rs;
                    txSlotDeclType(rs, (ws - 1) - rs) dt;
                    if (dt == 1) { txDocContainer(ws, wlen); hdone = 1; }
                    if (dt == 3) { txDocContainer(ws, wlen); hdone = 1; }
                    if (dt == 4) { txDocContainer(ws, wlen); hdone = 1; }
                    if (dt == 5) { txDocContainer(ws, wlen); hdone = 1; }
                    #delete[dt];
                    #delete[rs];
                }
            }
        }
        if (hdone == 0) {
        txSemaLineOf(ws) curLine;
        txScopeAt(curLine) csc;
        // resolve: prefer a callable/object/sector (the "real" definition, since
        // a function carries a forward-decl slot of the same name), then a
        // cursor-scope match, then any match.
        #stack[int, 64] best = 0 - 1;
        #stack[int, 64] anyM = 0 - 1;
        #stack[int, 64] defM = 0 - 1;
        #stack[int, 64] i = 0;
        #stack[int, 32] g = 1;
        while (g == 1) {
            if (i >= txSemaSymCount) { g = 0; }
            if (g == 1) {
                #stack[int, 64] o = i * 8;
                txDdSpanEq(ws, wlen, cssc::peek64(txSemaSymOff + o), cssc::peek64(txSemaSymLen + o)) eq;
                if (eq == 1) {
                    #stack[int, 64] mk2 = cssc::peek64(txSemaSymKind + o);
                    if (anyM < 0) { anyM = i; }
                    if (cssc::peek64(txSemaSymScope + o) == csc) { if (best < 0) { best = i; } }
                    if (defM < 0) { if (mk2 == 2) { defM = i; } if (mk2 == 3) { defM = i; } if (mk2 == 4) { defM = i; } }
                    #delete[mk2];
                }
                #delete[eq];
                #delete[o];
                i = i + 1;
            }
        }
        #delete[i];
        #delete[g];
        #stack[int, 64] sym = defM;
        if (sym < 0) { sym = best; }
        if (sym < 0) { sym = anyM; }
        #delete[defM];
        if (sym >= 0) {
            #stack[int, 64] so = sym * 8;
            #stack[int, 64] k = cssc::peek64(txSemaSymKind + so);
            if (k == 1) { cssc::out("slot "); }
            if (k == 2) { cssc::out("function "); }
            if (k == 3) { cssc::out("object "); }
            if (k == 4) { cssc::out("sector "); }
            if (k == 5) { cssc::out("param "); }
            if (k == 6) { cssc::out("label "); }
            // k==7 (`#req` alias) resolves to the imported variable — show it as
            // a slot with the inherited type, not a bare "import".
            #stack[int, 32] slotLike = 0;
            if (k == 1) { slotLike = 1; }
            if (k == 7) { slotLike = 1; }
            if (k == 7) { cssc::out("req "); }
            cssc::printRaw(txSrc + cssc::peek64(txSemaSymOff + so), cssc::peek64(txSemaSymLen + so));
            if (slotLike == 1) {                            // slot / alias: type + capacity
                #stack[int, 64] dt = cssc::peek64(txSemaSymDeclType + so);
                cssc::out(" : ");
                if (dt == 0) { cssc::out("int"); }
                if (dt == 1) { cssc::out("string"); }
                if (dt == 2) { cssc::out("float"); }
                if (dt == 3) { cssc::out("vector"); }
                if (dt == 4) { cssc::out("map"); }
                if (dt == 5) { cssc::out("bind"); }
                // A declType outside 0..5 (bool / char / byte / auto / an object
                // or sector type) has no numeric mapping — show the LITERAL type
                // text from `[TYPE, …]` and stash its span for the sentinel.
                txTypeOff = 0;
                txTypeLen = 0;
                #stack[int, 32] knownT = 0;
                if (dt >= 0) { if (dt <= 5) { knownT = 1; } }
                if (knownT == 0) {
                    #stack[int, 64] tb = cssc::peek64(txSemaSymOff + so);
                    #stack[int, 32] fb = 1;
                    while (fb == 1) {
                        if (tb <= 0) { fb = 0; }
                        if (fb == 1) {
                            #stack[int, 64] cc = cssc::peek8(txSrc + tb - 1);
                            if (cc == 91) { fb = 0; }          // '['
                            if (cc == 10) { fb = 0; tb = 0; }
                            #delete[cc];
                            if (fb == 1) { tb = tb - 1; }
                        }
                    }
                    #delete[fb];
                    if (tb > 0) {
                        #stack[int, 64] te = tb;
                        #stack[int, 32] fe = 1;
                        while (fe == 1) {
                            #stack[int, 64] cc = cssc::peek8(txSrc + te);
                            if (cc == 44) { fe = 0; }          // ','
                            if (cc == 93) { fe = 0; }          // ']'
                            if (cc == 10) { fe = 0; }
                            #delete[cc];
                            if (fe == 1) { te = te + 1; }
                        }
                        #delete[fe];
                        txTypeOff = tb;
                        txTypeLen = te - tb;
                        cssc::printRaw(txSrc + tb, te - tb);
                        #delete[te];
                    }
                    #delete[tb];
                }
                #delete[knownT];
                // declared capacity: re-scan `[type, BITS]` before the name (the
                // real size the user wrote, not a fixed runtime width).
                #stack[int, 64] nOff = cssc::peek64(txSemaSymOff + so);
                #stack[int, 64] b = nOff;
                #stack[int, 32] bg = 1;
                while (bg == 1) {
                    if (b <= 0) { bg = 0; }
                    if (bg == 1) {
                        #stack[int, 64] bc = cssc::peek8(txSrc + b - 1);
                        if (bc == 93) { bg = 0; }             // ']'
                        if (bc == 10) { bg = 0; b = 0; }      // newline first -> no [..]
                        #delete[bc];
                        if (bg == 1) { b = b - 1; }
                    }
                }
                #delete[bg];
                if (b > 0) {
                    #stack[int, 64] d2 = b - 1;               // the ']'
                    #stack[int, 32] sp = 1;
                    while (sp == 1) {
                        if (d2 <= 0) { sp = 0; }
                        if (sp == 1) {
                            #stack[int, 64] c = cssc::peek8(txSrc + d2 - 1);
                            if (c == 32) { d2 = d2 - 1; } else { sp = 0; }
                            #delete[c];
                        }
                    }
                    #delete[sp];
                    #stack[int, 64] de = d2;
                    #stack[int, 64] ds = d2;
                    #stack[int, 32] dg = 1;
                    while (dg == 1) {
                        if (ds <= 0) { dg = 0; }
                        if (dg == 1) {
                            #stack[int, 64] c = cssc::peek8(txSrc + ds - 1);
                            #stack[int, 32] isd = 0;
                            if (c >= 48) { if (c <= 57) { isd = 1; } }
                            if (isd == 1) { ds = ds - 1; } else { dg = 0; }
                            #delete[c];
                            #delete[isd];
                        }
                    }
                    #delete[dg];
                    if (de > ds) {
                        cssc::out(", ");
                        cssc::printRaw(txSrc + ds, de - ds);
                        cssc::out(" bits");
                    }
                    #delete[de];
                    #delete[ds];
                    #delete[d2];
                }
                #delete[b];
                #delete[nOff];
                #delete[dt];
            }
            cssc::outln();
            if (slotLike == 1) {                            // init: <resolved value>
                #stack[int, 64] hdt = cssc::peek64(txSemaSymDeclType + sym * 8);
                if (k == 7) {
                    // resolve the alias to its SOURCE variable and show ITS init
                    #stack[int, 64] rnode = cssc::peek64(txSemaSymNode + sym * 8);
                    #stack[int, 64] xo = cssc::peek64(txAstOff + rnode * 8);
                    #stack[int, 64] xl = cssc::peek64(txAstLen + rnode * 8);
                    txSymByName(xo, xl) srcSym;
                    if (srcSym >= 0) { txHoverInit(srcSym, hdt); }
                    else { txHoverInit(sym, hdt); }
                    #delete[srcSym];
                    #delete[xo];
                    #delete[xl];
                    #delete[rnode];
                } else {
                    txHoverInit(sym, hdt);
                }
                #delete[hdt];
            }
            #delete[slotLike];
            txHoverEmitDoc(cssc::peek64(txSemaSymOff + so));   // //d docs (preceding + in-body)
            #delete[k];
            #delete[so];
        }
        #delete[sym];
        #delete[best];
        #delete[anyM];
        #delete[curLine];
        #delete[csc];
        }
        #delete[hdone];
    }
    #delete[ws];
    #delete[we];
    #delete[wlen];
}

// Emit the `//d` docstring lines from the body that opens at/after the
// declaration byte offset `declOff` (each on its own line, raw text after the
// `//d` prefix). The hover box renders these under the symbol line. A `;` before
// any `{` means a forward decl with no body -> nothing.
#define(txHoverDoc) {
    #scanp(txHoverDoc, int, 0) declOff;
    #req[txSrc] txSrc;
    #req[txSrcLen] txSrcLen;
    #stack[int, 64] i = declOff;
    #stack[int, 64] lim = declOff + 4000;
    if (lim > txSrcLen) { lim = txSrcLen; }
    #stack[int, 64] brace = 0 - 1;
    #stack[int, 32] g = 1;
    while (g == 1) {
        if (i >= lim) { g = 0; }
        if (g == 1) {
            #stack[int, 64] c = cssc::peek8(txSrc + i);
            if (c == 123) { brace = i; g = 0; }
            if (c == 59) { g = 0; }
            #delete[c];
            if (g == 1) { i = i + 1; }
        }
    }
    #delete[g];
    #delete[i];
    #delete[lim];
    if (brace >= 0) {
        #stack[int, 64] p = brace + 1;
        #stack[int, 32] started = 0;
        #stack[int, 32] scanned = 0;
        #stack[int, 32] go = 1;
        while (go == 1) {
            if (p >= txSrcLen) { go = 0; }
            if (scanned > 200) { go = 0; }
            if (go == 1) {
                #stack[int, 64] le = p;
                #stack[int, 32] g2 = 1;
                while (g2 == 1) {
                    if (le >= txSrcLen) { g2 = 0; }
                    if (g2 == 1) {
                        if (cssc::peek8(txSrc + le) == 10) { g2 = 0; } else { le = le + 1; }
                    }
                }
                #delete[g2];
                #stack[int, 64] t = p;
                #stack[int, 32] g3 = 1;
                while (g3 == 1) {
                    if (t >= le) { g3 = 0; }
                    if (g3 == 1) {
                        #stack[int, 64] c = cssc::peek8(txSrc + t);
                        if (c == 32) { t = t + 1; }
                        if (c == 9) { t = t + 1; }
                        if (c != 32) { if (c != 9) { g3 = 0; } }
                        #delete[c];
                    }
                }
                #delete[g3];
                #stack[int, 32] isDoc = 0;
                if (t + 2 < le) {
                    if (cssc::peek8(txSrc + t) == 47) {
                        if (cssc::peek8(txSrc + t + 1) == 47) {
                            if (cssc::peek8(txSrc + t + 2) == 100) { isDoc = 1; }
                        }
                    }
                }
                if (isDoc == 1) {
                    #stack[int, 64] ds = t + 3;
                    if (ds < le) { if (cssc::peek8(txSrc + ds) == 32) { ds = ds + 1; } }
                    cssc::printRaw(txSrc + ds, le - ds);
                    cssc::outln();
                    started = 1;
                    #delete[ds];
                }
                if (isDoc == 0) {
                    if (t >= le) { if (started == 1) { go = 0; } }
                    if (t < le) { go = 0; }
                }
                #delete[isDoc];
                #delete[t];
                p = le + 1;
                #delete[le];
                scanned = scanned + 1;
            }
        }
        #delete[go];
        #delete[p];
        #delete[started];
        #delete[scanned];
    }
    #delete[brace];
}

// Emit the `//d` doc lines IMMEDIATELY PRECEDING the declaration at `declOff` in
// buffer `base` (the CSSC convention `//d text` above a member). Consecutive `//d`
// lines form one doc block. Buffer-parameterised so it serves both the current
// file (txSrc) and a harvested #load'd module buffer.
#define(txDocBefore) {
    #scanp(txDocBefore, int, 0) base;
    #scanp(txDocBefore, int, 1) srcLen;
    #scanp(txDocBefore, int, 2) declOff;
    #stack[int, 64] lineStart = declOff;
    #stack[int, 32] g = 1;
    while (g == 1) {
        if (lineStart <= 0) { g = 0; }
        if (g == 1) { if (cssc::peek8(base + lineStart - 1) == 10) { g = 0; } else { lineStart = lineStart - 1; } }
    }
    #delete[g];
    #stack[int, 64] top = lineStart;
    #stack[int, 32] wg = 1;
    #stack[int, 32] scanned = 0;
    while (wg == 1) {
        if (top <= 0) { wg = 0; }
        if (scanned > 200) { wg = 0; }
        if (wg == 1) {
            #stack[int, 64] pe = top - 1;
            #stack[int, 64] ps = pe;
            #stack[int, 32] sg = 1;
            while (sg == 1) {
                if (ps <= 0) { sg = 0; }
                if (sg == 1) { if (cssc::peek8(base + ps - 1) == 10) { sg = 0; } else { ps = ps - 1; } }
            }
            #delete[sg];
            #stack[int, 64] t = ps;
            #stack[int, 32] tg = 1;
            while (tg == 1) {
                if (t >= pe) { tg = 0; }
                if (tg == 1) { #stack[int, 64] c = cssc::peek8(base + t); if (c == 32) { t = t + 1; } else { if (c == 9) { t = t + 1; } else { tg = 0; } } #delete[c]; }
            }
            #delete[tg];
            #stack[int, 32] isDoc = 0;
            if (t + 2 < pe) {
                if (cssc::peek8(base + t) == 47) { if (cssc::peek8(base + t + 1) == 47) { if (cssc::peek8(base + t + 2) == 100) { isDoc = 1; } } }
            }
            if (isDoc == 1) { top = ps; } else { wg = 0; }
            #delete[isDoc];
            #delete[t];
            #delete[pe];
            #delete[ps];
            scanned = scanned + 1;
        }
    }
    #delete[wg];
    #delete[scanned];
    if (top < lineStart) {
        #stack[int, 64] pp = top;
        #stack[int, 32] eg = 1;
        while (eg == 1) {
            if (pp >= lineStart) { eg = 0; }
            if (eg == 1) {
                #stack[int, 64] le = pp;
                #stack[int, 32] lg = 1;
                while (lg == 1) { if (le >= srcLen) { lg = 0; } if (lg == 1) { if (cssc::peek8(base + le) == 10) { lg = 0; } else { le = le + 1; } } }
                #delete[lg];
                #stack[int, 64] t2 = pp;
                #stack[int, 32] tg2 = 1;
                while (tg2 == 1) { if (t2 >= le) { tg2 = 0; } if (tg2 == 1) { #stack[int, 64] c = cssc::peek8(base + t2); if (c == 32) { t2 = t2 + 1; } else { if (c == 9) { t2 = t2 + 1; } else { tg2 = 0; } } #delete[c]; } }
                #delete[tg2];
                #stack[int, 32] isDoc2 = 0;
                if (t2 + 2 < le) { if (cssc::peek8(base + t2) == 47) { if (cssc::peek8(base + t2 + 1) == 47) { if (cssc::peek8(base + t2 + 2) == 100) { isDoc2 = 1; } } } }
                if (isDoc2 == 1) {
                    #stack[int, 64] ds = t2 + 3;
                    if (ds < le) { if (cssc::peek8(base + ds) == 32) { ds = ds + 1; } }
                    cssc::printRaw(base + ds, le - ds);
                    cssc::outln();
                    #delete[ds];
                }
                #delete[isDoc2];
                #delete[t2];
                pp = le + 1;
                #delete[le];
            }
        }
        #delete[eg];
        #delete[pp];
    }
    #delete[top];
    #delete[lineStart];
}

// Emit the `//d` doc lines at the TOP OF THE BODY that opens at/after `declOff` in
// buffer `base` (the existing in-body convention). Buffer-parameterised twin of the
// original txHoverDoc.
#define(txDocBodyB) {
    #scanp(txDocBodyB, int, 0) base;
    #scanp(txDocBodyB, int, 1) srcLen;
    #scanp(txDocBodyB, int, 2) declOff;
    #stack[int, 64] i = declOff;
    #stack[int, 64] lim = declOff + 4000;
    if (lim > srcLen) { lim = srcLen; }
    #stack[int, 64] brace = 0 - 1;
    #stack[int, 32] g = 1;
    while (g == 1) {
        if (i >= lim) { g = 0; }
        if (g == 1) {
            #stack[int, 64] c = cssc::peek8(base + i);
            if (c == 123) { brace = i; g = 0; }
            if (c == 59) { g = 0; }
            #delete[c];
            if (g == 1) { i = i + 1; }
        }
    }
    #delete[g];
    #delete[i];
    #delete[lim];
    if (brace >= 0) {
        #stack[int, 64] pp = brace + 1;
        #stack[int, 32] started = 0;
        #stack[int, 32] scanned = 0;
        #stack[int, 32] go = 1;
        while (go == 1) {
            if (pp >= srcLen) { go = 0; }
            if (scanned > 200) { go = 0; }
            if (go == 1) {
                #stack[int, 64] le = pp;
                #stack[int, 32] g2 = 1;
                while (g2 == 1) { if (le >= srcLen) { g2 = 0; } if (g2 == 1) { if (cssc::peek8(base + le) == 10) { g2 = 0; } else { le = le + 1; } } }
                #delete[g2];
                #stack[int, 64] t = pp;
                #stack[int, 32] g3 = 1;
                while (g3 == 1) {
                    if (t >= le) { g3 = 0; }
                    if (g3 == 1) { #stack[int, 64] c = cssc::peek8(base + t); if (c == 32) { t = t + 1; } if (c == 9) { t = t + 1; } if (c != 32) { if (c != 9) { g3 = 0; } } #delete[c]; }
                }
                #delete[g3];
                #stack[int, 32] isDoc = 0;
                if (t + 2 < le) { if (cssc::peek8(base + t) == 47) { if (cssc::peek8(base + t + 1) == 47) { if (cssc::peek8(base + t + 2) == 100) { isDoc = 1; } } } }
                if (isDoc == 1) {
                    #stack[int, 64] ds = t + 3;
                    if (ds < le) { if (cssc::peek8(base + ds) == 32) { ds = ds + 1; } }
                    cssc::printRaw(base + ds, le - ds);
                    cssc::outln();
                    started = 1;
                    #delete[ds];
                }
                if (isDoc == 0) {
                    if (t >= le) { if (started == 1) { go = 0; } }
                    if (t < le) { go = 0; }
                }
                #delete[isDoc];
                #delete[t];
                pp = le + 1;
                #delete[le];
                scanned = scanned + 1;
            }
        }
        #delete[go];
        #delete[pp];
        #delete[started];
        #delete[scanned];
    }
    #delete[brace];
}

// Emit a current-file symbol's `//d` docs (preceding lines + in-body) for the
// declaration at `declOff`. A thin, low-register-pressure wrapper: called from the
// large txHoverAt scope, it keeps the txSrc/txSrcLen buffer args in a fresh frame
// (inlining both calls into txHoverAt tripped a native-codegen arg-passing quirk).
#define(txHoverEmitDoc) {
    #scanp(txHoverEmitDoc, int, 0) declOff;
    #req[txSrc] txSrc;
    #req[txSrcLen] txSrcLen;
    #req[txDocBefore] txDocBefore;
    #req[txDocBodyB] txDocBodyB;
    #stack[int, 64] b = txSrc;
    #stack[int, 64] n = txSrcLen;
    txDocBefore(b, n, declOff);
    txDocBodyB(b, n, declOff);
    #delete[b];
    #delete[n];
}

// Hover for a `#load`'d module member: search the harvested module buffer `base`
// (depth-0 members only) for a top-level member whose name == txSrc[memOff..memLen],
// then emit "<kind> <name>" and its `//d` docs (preceding + in-body). Returns 1 if
// the member was found (caller marks the hover handled). No cross-file diagnostics
// -- only the member's surface is read.
#define(txLoadedMemberHover) {
    #scanp(txLoadedMemberHover, int, 0) memOff;
    #scanp(txLoadedMemberHover, int, 1) memLen;
    #scanp(txLoadedMemberHover, int, 2) base;
    #scanp(txLoadedMemberHover, int, 3) srcLen;
    #req[txSrc] txSrc;
    #req[txLitAt] txLitAt;
    #req[txDocBefore] txDocBefore;
    #req[txDocBodyB] txDocBodyB;
    #stack[int, 32] found = 0;
    #stack[int, 64] i = 0;
    #stack[int, 64] depth = 0;
    #stack[int, 32] go = 1;
    while (go == 1) {
        if (i >= srcLen) { go = 0; }
        if (found == 1) { go = 0; }
        if (go == 1) {
            #stack[int, 64] c = cssc::peek8(base + i);
            #stack[int, 32] handled = 0;
            if (c == 34) { handled = 1; }
            if (c == 39) { handled = 1; }
            if (handled == 1) {
                #stack[int, 64] qq = c; i = i + 1;
                #stack[int, 32] sg = 1;
                while (sg == 1) { if (i >= srcLen) { sg = 0; } if (sg == 1) { #stack[int, 64] sc = cssc::peek8(base + i); if (sc == 92) { i = i + 2; } else { if (sc == qq) { sg = 0; i = i + 1; } else { i = i + 1; } } #delete[sc]; } }
                #delete[sg]; #delete[qq];
            }
            if (handled == 0) {
                if (c == 47) {
                    #stack[int, 64] c2 = 0;
                    if (i + 1 < srcLen) { c2 = cssc::peek8(base + i + 1); }
                    if (c2 == 47) { handled = 1; i = i + 2; #stack[int, 32] lg = 1; while (lg == 1) { if (i >= srcLen) { lg = 0; } if (lg == 1) { if (cssc::peek8(base + i) == 10) { lg = 0; } else { i = i + 1; } } } #delete[lg]; }
                    if (c2 == 42) { handled = 1; i = i + 2; #stack[int, 32] bg = 1; while (bg == 1) { if (i + 1 >= srcLen) { bg = 0; i = srcLen; } if (bg == 1) { if (cssc::peek8(base + i) == 42) { if (cssc::peek8(base + i + 1) == 47) { bg = 0; i = i + 2; } else { i = i + 1; } } else { i = i + 1; } } } #delete[bg]; }
                    #delete[c2];
                }
            }
            if (handled == 0) {
                if (c == 123) { depth = depth + 1; i = i + 1; handled = 1; }
                if (c == 125) { depth = depth - 1; i = i + 1; handled = 1; }
            }
            if (handled == 0) {
                if (depth == 0) {
                    #stack[int, 64] ns = 0 - 1;
                    #stack[int, 64] varSkip = 0 - 1;
                    #stack[int, 64] kind = 0;
                    if (c == 35) {
                        txLitAt(base, i, srcLen, "#define(") d1; if (d1 == 1) { ns = i + 8; kind = 2; } #delete[d1];
                        if (ns < 0) { txLitAt(base, i, srcLen, "#cdefine(") d2; if (d2 == 1) { ns = i + 9; kind = 2; } #delete[d2]; }
                        if (ns < 0) { txLitAt(base, i, srcLen, "#stack[") v1; if (v1 == 1) { varSkip = i + 6; kind = 1; } #delete[v1]; }
                        if (ns < 0) { if (varSkip < 0) { txLitAt(base, i, srcLen, "#heap[") v2; if (v2 == 1) { varSkip = i + 5; kind = 1; } #delete[v2]; } }
                        if (ns < 0) { if (varSkip < 0) { txLitAt(base, i, srcLen, "#auto[") v3; if (v3 == 1) { varSkip = i + 5; kind = 1; } #delete[v3]; } }
                    }
                    if (ns < 0) { if (varSkip < 0) {
                        #stack[int, 32] wb = 1;
                        if (i > 0) { #stack[int, 64] pc = cssc::peek8(base + i - 1); if (pc >= 65) { if (pc <= 90) { wb = 0; } } if (pc >= 97) { if (pc <= 122) { wb = 0; } } if (pc >= 48) { if (pc <= 57) { wb = 0; } } if (pc == 95) { wb = 0; } #delete[pc]; }
                        if (wb == 1) {
                            #stack[int, 64] kwlen = 0;
                            txLitAt(base, i, srcLen, "sector ") s1; if (s1 == 1) { kwlen = 7; kind = 4; } #delete[s1];
                            if (kwlen == 0) { txLitAt(base, i, srcLen, "object ") o1; if (o1 == 1) { kwlen = 7; kind = 3; } #delete[o1]; }
                            if (kwlen > 0) { #stack[int, 64] pw = i + kwlen; #stack[int, 32] fw = 1; while (fw == 1) { if (pw >= srcLen) { fw = 0; } if (fw == 1) { #stack[int, 64] wc = cssc::peek8(base + pw); if (wc == 32) { pw = pw + 1; } else { if (wc == 9) { pw = pw + 1; } else { fw = 0; } } #delete[wc]; } } #delete[fw]; ns = pw; #delete[pw]; }
                            #delete[kwlen];
                        }
                        #delete[wb];
                    } }
                    if (varSkip >= 0) {
                        #stack[int, 64] pw = varSkip;
                        #stack[int, 32] bg = 1;
                        while (bg == 1) { if (pw >= srcLen) { bg = 0; } if (bg == 1) { if (cssc::peek8(base + pw) == 93) { bg = 0; } else { pw = pw + 1; } } }
                        #delete[bg];
                        pw = pw + 1;
                        #stack[int, 32] fw = 1;
                        while (fw == 1) { if (pw >= srcLen) { fw = 0; } if (fw == 1) { #stack[int, 64] wc = cssc::peek8(base + pw); if (wc == 32) { pw = pw + 1; } else { if (wc == 9) { pw = pw + 1; } else { fw = 0; } } #delete[wc]; } }
                        #delete[fw];
                        ns = pw;
                        #delete[pw];
                    }
                    #delete[varSkip];
                    if (ns >= 0) {
                        #stack[int, 64] e = ns;
                        #stack[int, 32] rg = 1;
                        while (rg == 1) { if (e >= srcLen) { rg = 0; } if (rg == 1) { #stack[int, 64] ic = cssc::peek8(base + e); #stack[int, 32] iw = 0; if (ic >= 65) { if (ic <= 90) { iw = 1; } } if (ic >= 97) { if (ic <= 122) { iw = 1; } } if (ic >= 48) { if (ic <= 57) { iw = 1; } } if (ic == 95) { iw = 1; } if (iw == 1) { e = e + 1; } else { rg = 0; } #delete[ic]; #delete[iw]; } }
                        #delete[rg];
                        #stack[int, 64] nlen = e - ns;
                        if (nlen == memLen) {
                            #stack[int, 32] eq = 1;
                            #stack[int, 64] k = 0;
                            #stack[int, 32] mg = 1;
                            while (mg == 1) { if (k >= memLen) { mg = 0; } if (mg == 1) { if (cssc::peek8(base + ns + k) != cssc::peek8(txSrc + memOff + k)) { eq = 0; mg = 0; } if (mg == 1) { k = k + 1; } } }
                            #delete[k]; #delete[mg];
                            if (eq == 1) {
                                if (kind == 2) { cssc::out("function "); }
                                if (kind == 1) { cssc::out("slot "); }
                                if (kind == 3) { cssc::out("object "); }
                                if (kind == 4) { cssc::out("sector "); }
                                cssc::printRaw(base + ns, nlen);
                                cssc::outln();
                                txDocBefore(base, srcLen, ns);
                                txDocBodyB(base, srcLen, ns);
                                found = 1;
                            }
                            #delete[eq];
                        }
                        #delete[nlen];
                        #delete[e];
                    }
                    #delete[ns];
                    #delete[kind];
                }
                i = i + 1;
            }
            #delete[handled];
            #delete[c];
        }
    }
    #delete[go];
    #delete[i];
    #delete[depth];
    return found;
}

// Core signature help: at cursor offset `off` inside a call `fn(a, b|...)`,
// print `fn(<t> name, <t> name, ...)` then `active:<n>` (the argument index the
// cursor is in). Params come from the callee's #scanp nodes (index + str/int
// type — the AST's param surface). Prints nothing when not inside a known call.
// Emit one signature line + its active-parameter index (the sema_sig protocol:
// line 1 = the label, line 2 = "active:<n>").
#define(txSigEmit) {
    #scanp(txSigEmit, int, 0) active;
    #scanp(txSigEmit, string, 1) label;
    #req[txSigNoActive] txSigNoActive;
    cssc::out(label);
    cssc::outln();
    if (txSigNoActive == 0) {
        cssc::out("active:");
        cssc::out(active);
        cssc::outln();
    }
}

// If the call name span equals `nm`, emit `label` as its signature.
#define(txSigTry) {
    #scanp(txSigTry, int, 0) fstart;
    #scanp(txSigTry, int, 1) fLen;
    #scanp(txSigTry, int, 2) active;
    #scanp(txSigTry, string, 3) nm;
    #scanp(txSigTry, string, 4) label;
    #req[txSpanEqLit] txSpanEqLit;
    #req[txSigEmit] txSigEmit;
    txSpanEqLit(fstart, fLen, nm) m;
    if (m == 1) { txSigEmit(active, label); }
    #delete[m];
}

// Param hints for the builtin `cssc::` intrinsics. Names are exact (equality,
// not prefix), so at most one row emits. Signatures mirror cir_lower's
// `_NS_CALL_RUNTIME` arities with meaningful parameter names.
#define(txSigCssc) {
    #scanp(txSigCssc, int, 0) fstart;
    #scanp(txSigCssc, int, 1) fLen;
    #scanp(txSigCssc, int, 2) active;
    #req[txSigTry] txSigTry;
    txSigTry(fstart, fLen, active, "out", "cssc::out(value) - print a value (int/string/float/bool), no newline");
    txSigTry(fstart, fLen, active, "outln", "cssc::outln(value) - print a value then a newline (no arg = just a newline)");
    txSigTry(fstart, fLen, active, "printRaw", "cssc::printRaw(int ptr, int len) - write len raw bytes at ptr to stdout");
    txSigTry(fstart, fLen, active, "hostRead", "cssc::hostRead(int buf, int max) - read up to max bytes from stdin into buf; returns the count");
    txSigTry(fstart, fLen, active, "hostErr", "cssc::hostErr(int ptr, int len) - write len bytes at ptr to stderr");
    txSigTry(fstart, fLen, active, "osReadFile", "cssc::osReadFile(int pathPtr, int pathLen, int buf, int max) - read a file into buf; returns bytes read, -1 on error");
    txSigTry(fstart, fLen, active, "outb", "cssc::outb(int port, int value) - write a byte to an I/O port");
    txSigTry(fstart, fLen, active, "outw", "cssc::outw(int port, int value) - write a 16-bit word to an I/O port");
    txSigTry(fstart, fLen, active, "outl", "cssc::outl(int port, int value) - write a 32-bit long to an I/O port");
    txSigTry(fstart, fLen, active, "inb", "cssc::inb(int port) - read a byte from an I/O port");
    txSigTry(fstart, fLen, active, "inw", "cssc::inw(int port) - read a 16-bit word from an I/O port");
    txSigTry(fstart, fLen, active, "inl", "cssc::inl(int port) - read a 32-bit long from an I/O port");
    txSigTry(fstart, fLen, active, "poke8", "cssc::poke8(int addr, int value) - store a byte at a memory address");
    txSigTry(fstart, fLen, active, "poke16", "cssc::poke16(int addr, int value) - store a 16-bit value at a memory address");
    txSigTry(fstart, fLen, active, "poke32", "cssc::poke32(int addr, int value) - store a 32-bit value at a memory address");
    txSigTry(fstart, fLen, active, "poke64", "cssc::poke64(int addr, int value) - store a 64-bit value at a memory address");
    txSigTry(fstart, fLen, active, "peek8", "cssc::peek8(int addr) - read a byte from a memory address");
    txSigTry(fstart, fLen, active, "peek16", "cssc::peek16(int addr) - read a 16-bit value from a memory address");
    txSigTry(fstart, fLen, active, "peek32", "cssc::peek32(int addr) - read a 32-bit value from a memory address");
    txSigTry(fstart, fLen, active, "peek64", "cssc::peek64(int addr) - read a 64-bit value from a memory address");
    txSigTry(fstart, fLen, active, "memfill32", "cssc::memfill32(int ptr, int value, int count) - fill count 32-bit words at ptr with value");
    txSigTry(fstart, fLen, active, "memcopy", "cssc::memcopy(int dst, int src, int bytes) - copy bytes from src to dst");
    txSigTry(fstart, fLen, active, "alloc", "cssc::alloc(int size) - allocate size bytes; returns the address (free with cssc::free)");
    txSigTry(fstart, fLen, active, "free", "cssc::free(int ptr) - free memory previously returned by cssc::alloc");
    txSigTry(fstart, fLen, active, "makeExec", "cssc::makeExec(int ptr, int len) - mark ptr..ptr+len as executable code");
    txSigTry(fstart, fLen, active, "callAddr", "cssc::callAddr(int addr) - call machine code at addr");
    txSigTry(fstart, fLen, active, "ip", "cssc::ip() - address of the current function (same value as func[1]); pass to cssc::ipcall / cssc::ipto");
    txSigTry(fstart, fLen, active, "ipcall", "cssc::ipcall(int addr) - call the function at addr, then return here");
    txSigTry(fstart, fLen, active, "ipto", "cssc::ipto(int addr [, {ref,...}]) - jump to addr, do NOT return; optional {refs} are #deleted before the jump");
    txSigTry(fstart, fLen, active, "rtsym", "cssc::rtsym(int index) - address of runtime symbol #index");
    txSigTry(fstart, fLen, active, "outCapture", "cssc::outCapture(int ptr, int len) - redirect stdout into the buffer at ptr");
    txSigTry(fstart, fLen, active, "outCaptureLen", "cssc::outCaptureLen() - bytes captured so far by outCapture");
    txSigTry(fstart, fLen, active, "outCaptureEnd", "cssc::outCaptureEnd() - stop capturing; restore normal stdout");
    txSigTry(fstart, fLen, active, "modPath", "cssc::modPath(int buf, int max) - module-loader: record a verbatim module path");
    txSigTry(fstart, fLen, active, "modRead", "cssc::modRead(int buf, int max) - module-loader: read the recorded module into buf");
    txSigTry(fstart, fLen, active, "modPathInc", "cssc::modPathInc(int buf, int max) - module-loader: build module/<name>.cssc from a name");
    txSigTry(fstart, fLen, active, "argc", "cssc::argc() - number of command-line arguments");
    txSigTry(fstart, fLen, active, "argStr", "cssc::argStr(int index, int buf, int max) - copy argv[index] into buf; returns its length");
    txSigTry(fstart, fLen, active, "osTime", "cssc::osTime() - wall-clock time in seconds");
    txSigTry(fstart, fLen, active, "osTimestamp", "cssc::osTimestamp() - Unix time in milliseconds");
    txSigTry(fstart, fLen, active, "osClock", "cssc::osClock() - CPU clock ticks since start");
    txSigTry(fstart, fLen, active, "osDetime", "cssc::osDetime() - current date-time packed as an integer");
    txSigTry(fstart, fLen, active, "osSdetime", "cssc::osSdetime() - current short date-time packed as an integer");
    txSigTry(fstart, fLen, active, "osSleep", "cssc::osSleep(int ms) - sleep for ms milliseconds");
    txSigTry(fstart, fLen, active, "sleep", "cssc::sleep(int ms) - sleep the process for ms milliseconds");
    txSigTry(fstart, fLen, active, "osGetenv", "cssc::osGetenv(int namePtr, int nameLen, int buf, int max) - read an environment variable into buf");
    txSigTry(fstart, fLen, active, "osSystem", "cssc::osSystem(int cmdPtr, int cmdLen) - run a shell command; returns its exit code");
    txSigTry(fstart, fLen, active, "osPopen", "cssc::osPopen(int cmdPtr, int cmdLen, int buf, int max) - run a command and capture its output into buf");
    txSigTry(fstart, fLen, active, "osPid", "cssc::osPid() - current process id");
    txSigTry(fstart, fLen, active, "osBeep", "cssc::osBeep(int freq, int ms) - sound a beep at freq Hz for ms milliseconds");
    txSigTry(fstart, fLen, active, "osDiskUsage", "cssc::osDiskUsage(int pathPtr, int pathLen, int outPtr) - write free/total disk bytes for a path");
    txSigTry(fstart, fLen, active, "osKill", "cssc::osKill(int pid) - terminate the process with the given pid");
    txSigTry(fstart, fLen, active, "osReadLine", "cssc::osReadLine(int buf, int max) - read one line from stdin into buf");
    txSigTry(fstart, fLen, active, "osStrftime", "cssc::osStrftime(int fmtPtr, int fmtLen, int buf, int max) - format the current time by fmt into buf");
    txSigTry(fstart, fLen, active, "readCs", "cssc::readCs() - read the CS segment register");
    txSigTry(fstart, fLen, active, "fontRow", "cssc::fontRow(int ch, int row) - one row of the 8x8 font bitmap for a character");
    txSigTry(fstart, fLen, active, "shl", "cssc::shl(int value, int bits) - shift value left by bits");
    txSigTry(fstart, fLen, active, "shr", "cssc::shr(int value, int bits) - shift value right by bits");
    txSigTry(fstart, fLen, active, "band", "cssc::band(int a, int b) - bitwise AND of a and b");
    txSigTry(fstart, fLen, active, "bor", "cssc::bor(int a, int b) - bitwise OR of a and b");
    txSigTry(fstart, fLen, active, "bxor", "cssc::bxor(int a, int b) - bitwise XOR of a and b");
    txSigTry(fstart, fLen, active, "add", "cssc::add(a, b) - a + b (int op int -> int; a float -> float)");
    txSigTry(fstart, fLen, active, "sub", "cssc::sub(a, b) - a - b (int op int -> int; a float -> float)");
    txSigTry(fstart, fLen, active, "mul", "cssc::mul(a, b) - a * b (int op int -> int; a float -> float)");
    txSigTry(fstart, fLen, active, "div", "cssc::div(a, b) - int/int -> int (C-style trunc), else float division");
    txSigTry(fstart, fLen, active, "mod", "cssc::mod(a, b) - int%int -> int, else float remainder");
    txSigTry(fstart, fLen, active, "xor", "cssc::xor(int a, int b) - bitwise XOR of a and b");
    txSigTry(fstart, fLen, active, "xnor", "cssc::xnor(int a, int b) - bitwise XNOR ~(a ^ b)");
    txSigTry(fstart, fLen, active, "nand", "cssc::nand(int a, int b) - bitwise NAND ~(a & b)");
    txSigTry(fstart, fLen, active, "nor", "cssc::nor(int a, int b) - bitwise NOR ~(a | b)");
    txSigTry(fstart, fLen, active, "bnot", "cssc::bnot(int a) - bitwise NOT ~a");
    txSigTry(fstart, fLen, active, "fAdd", "cssc::fAdd(int a, int b) - add two bit-encoded doubles");
    txSigTry(fstart, fLen, active, "fSub", "cssc::fSub(int a, int b) - subtract two bit-encoded doubles");
    txSigTry(fstart, fLen, active, "fMul", "cssc::fMul(int a, int b) - multiply two bit-encoded doubles");
    txSigTry(fstart, fLen, active, "fDiv", "cssc::fDiv(int a, int b) - divide two bit-encoded doubles");
    txSigTry(fstart, fLen, active, "fMod", "cssc::fMod(int a, int b) - float remainder of two bit-encoded doubles");
    txSigTry(fstart, fLen, active, "fCmp", "cssc::fCmp(int a, int b) - compare two floats: -1, 0, or 1");
    txSigTry(fstart, fLen, active, "fNeg", "cssc::fNeg(int x) - negate a bit-encoded double");
    txSigTry(fstart, fLen, active, "iToF", "cssc::iToF(int value) - convert an int to float bits");
    txSigTry(fstart, fLen, active, "fToI", "cssc::fToI(int floatBits) - convert float bits to an int (truncating)");
    txSigTry(fstart, fLen, active, "fAbs", "cssc::fAbs(int x) - absolute value of a float");
    txSigTry(fstart, fLen, active, "fSqrt", "cssc::fSqrt(int x) - square root of a float");
    txSigTry(fstart, fLen, active, "fFloor", "cssc::fFloor(int x) - round a float down to an integer");
    txSigTry(fstart, fLen, active, "fCeil", "cssc::fCeil(int x) - round a float up to an integer");
    txSigTry(fstart, fLen, active, "fTrunc", "cssc::fTrunc(int x) - truncate a float toward zero");
    txSigTry(fstart, fLen, active, "fRound", "cssc::fRound(int x) - round a float to the nearest integer");
    txSigTry(fstart, fLen, active, "fToStr", "cssc::fToStr(int floatBits, int buf, int max) - format a float into buf; returns its length");
    txSigTry(fstart, fLen, active, "strToF", "cssc::strToF(int ptr, int len) - parse a float from the text at ptr..ptr+len");
    txSigTry(fstart, fLen, active, "lgdt", "cssc::lgdt(int ptr) - load the Global Descriptor Table register");
    txSigTry(fstart, fLen, active, "lidt", "cssc::lidt(int ptr) - load the Interrupt Descriptor Table register");
    txSigTry(fstart, fLen, active, "ltr", "cssc::ltr(int selector) - load the Task Register");
    txSigTry(fstart, fLen, active, "writeCr0", "cssc::writeCr0(int value) - write control register CR0");
    txSigTry(fstart, fLen, active, "writeCr3", "cssc::writeCr3(int value) - write control register CR3 (page-table base)");
    txSigTry(fstart, fLen, active, "writeCr4", "cssc::writeCr4(int value) - write control register CR4");
    txSigTry(fstart, fLen, active, "invlpg", "cssc::invlpg(int addr) - invalidate the TLB entry for addr");
    txSigTry(fstart, fLen, active, "rdmsr", "cssc::rdmsr(int msr) - read a model-specific register");
    txSigTry(fstart, fLen, active, "wrmsr", "cssc::wrmsr(int msr, int value) - write a model-specific register");
    txSigTry(fstart, fLen, active, "memmapBase", "cssc::memmapBase(int index) - base address of memory-map entry #index");
    txSigTry(fstart, fLen, active, "memmapLength", "cssc::memmapLength(int index) - length of memory-map entry #index");
    txSigTry(fstart, fLen, active, "memmapType", "cssc::memmapType(int index) - type of memory-map entry #index");
    txSigTry(fstart, fLen, active, "mapMmio", "cssc::mapMmio(int physAddr, int size) - map physical MMIO into virtual space; returns the virtual address");
}

#define(txSignatureAt) {
    #scanp(txSignatureAt, int, 0) off;
    #req[txSrc] txSrc;
    #req[txSpanEqLit] txSpanEqLit;
    #req[txSigCssc] txSigCssc;
    #req[txScanIdentBack] txScanIdentBack;
    #req[txScopeByOwner] txScopeByOwner;
    #req[txSemaSymOff] txSemaSymOff;
    #req[txSemaSymLen] txSemaSymLen;
    #req[txSemaSymKind] txSemaSymKind;
    #req[txSemaSymScope] txSemaSymScope;
    #req[txSemaSymNode] txSemaSymNode;
    #req[txSemaSymCount] txSemaSymCount;
    #req[txAstNum] txAstNum;
    #req[txAstB] txAstB;
    // scan back for the '(' that opens the enclosing call; count depth-0 commas.
    #stack[int, 64] depth = 0;
    #stack[int, 64] active = 0;
    #stack[int, 64] p = off - 1;
    #stack[int, 64] openP = 0 - 1;
    #stack[int, 32] g = 1;
    while (g == 1) {
        if (p < 0) { g = 0; }
        if (g == 1) {
            #stack[int, 64] c = cssc::peek8(txSrc + p);
            if (c == 41) { depth = depth + 1; }                       // ')'
            if (c == 40) { if (depth == 0) { openP = p; g = 0; } if (g == 1) { depth = depth - 1; } }   // '('
            if (g == 1) { if (c == 44) { if (depth == 0) { active = active + 1; } } }   // ','
            if (g == 1) { if (c == 59) { g = 0; } if (c == 123) { g = 0; } if (c == 125) { g = 0; } }   // ; { }
            #delete[c];
            if (g == 1) { p = p - 1; }
        }
    }
    #delete[g];
    #delete[depth];
    if (openP > 0) {
        txScanIdentBack(openP) fstart;               // fn name ends right before '('
        #stack[int, 64] fLen = openP - fstart;
        if (fLen > 0) {
            // builtin `cssc::<name>(` -> the intrinsic's fixed signature
            #stack[int, 32] isCssc = 0;
            if (fstart >= 6) {
                if (cssc::peek8(txSrc + fstart - 1) == 58) {          // ':'
                    if (cssc::peek8(txSrc + fstart - 2) == 58) {      // ':'
                        txSpanEqLit(fstart - 6, 4, "cssc") ic;
                        if (ic == 1) { isCssc = 1; }
                        #delete[ic];
                    }
                }
            }
            if (isCssc == 1) { txSigCssc(fstart, fLen, active); }
            if (isCssc == 0) {
            // `alias::name(` -> a module callable's signature from moddocs (a
            // type constructor like `gui::Font(scale_or_name?, size?)` or a
            // namespace method like `mouse::client(video)`).
            #stack[int, 32] mdSig = 0;
            if (fstart >= 2) {
                if (cssc::peek8(txSrc + fstart - 1) == 58) {
                    if (cssc::peek8(txSrc + fstart - 2) == 58) {
                        txScanIdentBack(fstart - 2) aStart;
                        #stack[int, 64] aLen = fstart - 2 - aStart;
                        if (aLen > 0) {
                            #req[txMdAliasCanon] txMdAliasCanon;
                            #req[txMdCanOff] txMdCanOff;
                            #req[txMdCanLen] txMdCanLen;
                            #req[txMdCallKnown] txMdCallKnown;
                            #req[txMdCallParams] txMdCallParams;
                            txMdAliasCanon(aStart, aLen) af;
                            if (af == 1) {
                                txMdCallKnown(txMdCanOff, txMdCanLen, fstart, fLen) kn;
                                if (kn == 1) {
                                    mdSig = 1;
                                    cssc::printRaw(txSrc + aStart, aLen);
                                    cssc::out("::");
                                    cssc::printRaw(txSrc + fstart, fLen);
                                    cssc::out("(");
                                    cssc::out(txMdCallParams(txMdCanOff, txMdCanLen, fstart, fLen));
                                    cssc::out(")");
                                    cssc::outln();
                                    cssc::out("active:");
                                    cssc::out(active);
                                    cssc::outln();
                                }
                                #delete[kn];
                            }
                            #delete[af];
                        }
                        #delete[aLen];
                        #delete[aStart];
                    }
                }
            }
            // `handle.method(` -> the module type method's signature from moddocs.
            if (mdSig == 0) {
                if (fstart >= 1) {
                    if (cssc::peek8(txSrc + fstart - 1) == 46) {           // '.'
                        txScanIdentBack(fstart - 1) rStart;
                        #stack[int, 64] rLen = fstart - 1 - rStart;
                        if (rLen > 0) {
                            #req[txMdResolveReceiver] txMdResolveReceiver;
                            #req[txMdCanOff] txMdCanOff;
                            #req[txMdCanLen] txMdCanLen;
                            #req[txMdRnOff] txMdRnOff;
                            #req[txMdRnLen] txMdRnLen;
                            #req[txMdMethParams] txMdMethParams;
                            txMdResolveReceiver(rStart, rLen) rr;
                            if (rr == 1) {
                                #stack[string, 8192] mp = txMdMethParams(txMdCanOff, txMdCanLen, txMdRnOff, txMdRnLen, fstart, fLen);
                                #stack[int, 64] mpa = 0;
                                #adress[mp] mpa;
                                #stack[int, 64] mph = cssc::peek64(mpa);
                                #stack[int, 64] mpl = cssc::peek32(mph + 4);
                                if (mpl > 0) {
                                    mdSig = 1;
                                    cssc::printRaw(txSrc + rStart, rLen);
                                    cssc::out(".");
                                    cssc::printRaw(txSrc + fstart, fLen);
                                    cssc::out("(");
                                    cssc::out(mp);
                                    cssc::out(")");
                                    cssc::outln();
                                    cssc::out("active:");
                                    cssc::out(active);
                                    cssc::outln();
                                }
                                #delete[mpl];
                                #delete[mph];
                                #delete[mpa];
                                #delete[mp];
                            }
                            #delete[rr];
                        }
                        #delete[rLen];
                        #delete[rStart];
                    }
                }
            }
            if (mdSig == 0) {
            txScopeByOwner(fstart, fLen, 2) fs;      // the callee's body scope
            if (fs != 0) {
                cssc::printRaw(txSrc + fstart, fLen);
                cssc::out("(");
                // emit params in ascending #scanp index order
                #stack[int, 64] idx = 0;
                #stack[int, 32] pg = 1;
                while (pg == 1) {
                    #stack[int, 64] foundSym = 0 - 1;
                    #stack[int, 64] i = 0;
                    #stack[int, 32] ig = 1;
                    while (ig == 1) {
                        if (i >= txSemaSymCount) { ig = 0; }
                        if (ig == 1) {
                            #stack[int, 64] o = i * 8;
                            if (cssc::peek64(txSemaSymKind + o) == 5) {
                                if (cssc::peek64(txSemaSymScope + o) == fs) {
                                    #stack[int, 64] nd = cssc::peek64(txSemaSymNode + o);
                                    if (cssc::peek64(txAstNum + nd * 8) == idx) { foundSym = i; ig = 0; }
                                    #delete[nd];
                                }
                            }
                            #delete[o];
                            if (ig == 1) { i = i + 1; }
                        }
                    }
                    #delete[i];
                    #delete[ig];
                    if (foundSym < 0) { pg = 0; }
                    if (pg == 1) {
                        if (idx > 0) { cssc::out(", "); }
                        #stack[int, 64] so = foundSym * 8;
                        #stack[int, 64] nd = cssc::peek64(txSemaSymNode + so);
                        if (cssc::peek64(txAstB + nd * 8) == 1) { cssc::out("string "); }
                        if (cssc::peek64(txAstB + nd * 8) != 1) { cssc::out("int "); }
                        cssc::printRaw(txSrc + cssc::peek64(txSemaSymOff + so), cssc::peek64(txSemaSymLen + so));
                        #delete[nd];
                        #delete[so];
                        idx = idx + 1;
                    }
                    #delete[foundSym];
                }
                cssc::out(")");
                cssc::outln();
                cssc::out("active:");
                cssc::out(active);
                cssc::outln();
                #delete[idx];
                #delete[pg];
            }
            #delete[fs];
            }
            #delete[mdSig];
            }
            #delete[isCssc];
        }
        #delete[fstart];
        #delete[fLen];
    }
    #delete[active];
    #delete[p];
    #delete[openP];
}

// case-sensitive: does the name span (nOff,nLen) start with the partial span
// (pOff,pLen)? Both index txSrc.
#define(txSpanPrefix) {
    #scanp(txSpanPrefix, int, 0) pOff;
    #scanp(txSpanPrefix, int, 1) pLen;
    #scanp(txSpanPrefix, int, 2) nOff;
    #scanp(txSpanPrefix, int, 3) nLen;
    #req[txSrc] txSrc;
    #stack[int, 64] r = 1;
    if (pLen > nLen) { r = 0; }
    if (r == 1) {
        #stack[int, 64] i = 0;
        #stack[int, 32] go = 1;
        while (go == 1) {
            if (i >= pLen) { go = 0; }
            if (go == 1) {
                if (cssc::peek8(txSrc + pOff + i) != cssc::peek8(txSrc + nOff + i)) {
                    r = 0;
                    go = 0;
                }
                if (go == 1) { i = i + 1; }
            }
        }
        #delete[i];
        #delete[go];
    }
    return r;
}

// `qualifier->partial` -> the object's data members (kind 1) that start with the
// partial. The object's body scope is the one whose owner name == qualifier.
// Resolve a qualifier span (qOff,qLen) to the member-scope id of an object or
// sector whose owner-kind == ownKind. Two stages:
//   1. if allowTypeName: a scope whose OWNER name == qualifier (a type name,
//      e.g. `Widget->` / `Sector::`);
//   2. always: a slot named qualifier whose recorded object-type owns such a
//      scope (an instance, e.g. `w->` where `Widget() w;`).
// Returns the scope id, or 0 if unresolved. `.` (labels) passes allowTypeName=0
// so a bare type name completes nothing (labels are called on instances only).
// scope id whose owner name span == (oOff,oLen) and owner-kind == ownKind, or 0.
#define(txScopeByOwner) {
    #scanp(txScopeByOwner, int, 0) oOff;
    #scanp(txScopeByOwner, int, 1) oLen;
    #scanp(txScopeByOwner, int, 2) ownKind;
    #req[txSemaScopeOwnerOff] txSemaScopeOwnerOff;
    #req[txSemaScopeOwnerLen] txSemaScopeOwnerLen;
    #req[txSemaScopeOwnerKind] txSemaScopeOwnerKind;
    #req[txSemaScopeNext] txSemaScopeNext;
    #req[txDdSpanEq] txDdSpanEq;
    #stack[int, 64] found = 0;
    #stack[int, 64] sid = 1;
    #stack[int, 32] g1 = 1;
    while (g1 == 1) {
        if (sid >= txSemaScopeNext) { g1 = 0; }
        if (g1 == 1) {
            #stack[int, 64] ol = cssc::peek64(txSemaScopeOwnerLen + sid * 8);
            if (ol > 0) {
                if (cssc::peek64(txSemaScopeOwnerKind + sid * 8) == ownKind) {
                    txDdSpanEq(oOff, oLen, cssc::peek64(txSemaScopeOwnerOff + sid * 8), ol) eq;
                    if (eq == 1) { found = sid; g1 = 0; }
                    #delete[eq];
                }
            }
            #delete[ol];
            if (g1 == 1) { sid = sid + 1; }
        }
    }
    #delete[g1];
    #delete[sid];
    return found;
}

#define(txResolveTypeScope) {
    #scanp(txResolveTypeScope, int, 0) qOff;
    #scanp(txResolveTypeScope, int, 1) qLen;
    #scanp(txResolveTypeScope, int, 2) allowTypeName;
    #scanp(txResolveTypeScope, int, 3) ownKind;
    #req[txSemaSymOff] txSemaSymOff;
    #req[txSemaSymLen] txSemaSymLen;
    #req[txSemaSymKind] txSemaSymKind;
    #req[txSemaSymCount] txSemaSymCount;
    #req[txSemaSymTypeOff] txSemaSymTypeOff;
    #req[txSemaSymTypeLen] txSemaSymTypeLen;
    #req[txScopeByOwner] txScopeByOwner;
    #req[txDdSpanEq] txDdSpanEq;
    #stack[int, 64] found = 0;
    if (allowTypeName == 1) {                        // stage 1: qualifier is a type name
        txScopeByOwner(qOff, qLen, ownKind) f1;
        found = f1;
        #delete[f1];
    }
    if (found == 0) {                                // stage 2: qualifier is an instance slot,
        #stack[int, 64] si = 0;                      // a #scanp param (5), or a #req import (7)
        #stack[int, 32] gs = 1;
        while (gs == 1) {
            if (si >= txSemaSymCount) { gs = 0; }
            if (gs == 1) {
                #stack[int, 64] so = si * 8;
                #stack[int, 64] sik = cssc::peek64(txSemaSymKind + so);
                #stack[int, 32] slotish = 0;
                if (sik == 1) { slotish = 1; }
                if (sik == 5) { slotish = 1; }
                if (sik == 7) { slotish = 1; }
                #delete[sik];
                if (slotish == 1) {
                    txDdSpanEq(qOff, qLen, cssc::peek64(txSemaSymOff + so), cssc::peek64(txSemaSymLen + so)) me;
                    if (me == 1) {
                        #stack[int, 64] tl = cssc::peek64(txSemaSymTypeLen + so);
                        if (tl > 0) {
                            txScopeByOwner(cssc::peek64(txSemaSymTypeOff + so), tl, ownKind) f2;
                            found = f2;
                            gs = 0;
                            #delete[f2];
                        }
                        #delete[tl];
                    }
                    #delete[me];
                }
                #delete[so];
                if (gs == 1) { si = si + 1; }
            }
        }
        #delete[si];
        #delete[gs];
    }
    return found;
}

// Emit qualified-access completions. Resolves the qualifier (qOff,qLen) to a
// member scope via txResolveTypeScope (allowTypeName controls type-name access),
// then prints each member in that scope prefix-matching the partial (pOff,pLen):
//   wantKind  > 0 -> only that symbol kind; 0 -> any declaration (kind != 5 param)
//   requirePub 1 -> only members flagged public (unused now: same-file `::` sees all)
#define(txCompMember) {
    #scanp(txCompMember, int, 0) qOff;
    #scanp(txCompMember, int, 1) qLen;
    #scanp(txCompMember, int, 2) pOff;
    #scanp(txCompMember, int, 3) pLen;
    #scanp(txCompMember, int, 4) wantKind;
    #scanp(txCompMember, int, 5) ownKind;
    #scanp(txCompMember, int, 6) requirePub;
    #scanp(txCompMember, int, 7) allowTypeName;
    #req[txSrc] txSrc;
    #req[txSemaSymOff] txSemaSymOff;
    #req[txSemaSymLen] txSemaSymLen;
    #req[txSemaSymKind] txSemaSymKind;
    #req[txSemaSymScope] txSemaSymScope;
    #req[txSemaSymPub] txSemaSymPub;
    #req[txSemaSymCount] txSemaSymCount;
    #req[txResolveTypeScope] txResolveTypeScope;
    #req[txSpanPrefix] txSpanPrefix;
    txResolveTypeScope(qOff, qLen, allowTypeName, ownKind) objScope;
    if (objScope != 0) {
        #stack[int, 64] i = 0;
        #stack[int, 32] g2 = 1;
        while (g2 == 1) {
            if (i >= txSemaSymCount) { g2 = 0; }
            if (g2 == 1) {
                #stack[int, 64] o = i * 8;
                #stack[int, 64] sk = cssc::peek64(txSemaSymKind + o);
                #stack[int, 32] kindOk = 0;
                if (wantKind == 0) { if (sk != 5) { kindOk = 1; } }
                if (wantKind > 0) { if (sk == wantKind) { kindOk = 1; } }
                #stack[int, 32] pubOk = 1;
                if (requirePub == 1) { if (cssc::peek64(txSemaSymPub + o) != 1) { pubOk = 0; } }
                if (kindOk == 1) {
                    if (pubOk == 1) {
                        if (cssc::peek64(txSemaSymScope + o) == objScope) {
                            #stack[int, 64] nOff = cssc::peek64(txSemaSymOff + o);
                            #stack[int, 64] nLen = cssc::peek64(txSemaSymLen + o);
                            txSpanPrefix(pOff, pLen, nOff, nLen) pm;
                            if (pm == 1) {
                                cssc::printRaw(txSrc + nOff, nLen);
                                cssc::outln();
                            }
                            #delete[pm];
                            #delete[nOff];
                            #delete[nLen];
                        }
                    }
                }
                #delete[sk];
                #delete[kindOk];
                #delete[pubOk];
                #delete[o];
                if (g2 == 1) { i = i + 1; }
            }
        }
        #delete[i];
        #delete[g2];
    }
    #delete[objScope];
}

// point the analyzer at a source buffer without lexing (completion contexts
// like `#directive` are pure text before the cursor).
#define(txSetSrc) {
    #scanp(txSetSrc, int, 0) b;
    #scanp(txSetSrc, int, 1) n;
    #req[txSrc] txSrc;
    #req[txSrcLen] txSrcLen;
    txSrc = b;
    txSrcLen = n;
}

// offset of the cursor marker byte (0x04) in the buffer, or 0.
#define(txFindMarker) {
    #scanp(txFindMarker, int, 0) b;
    #scanp(txFindMarker, int, 1) n;
    #stack[int, 64] mk = 0;
    #stack[int, 64] i = 0;
    #stack[int, 32] go = 1;
    while (go == 1) {
        if (i >= n) { go = 0; }
        if (go == 1) {
            if (cssc::peek8(b + i) == 4) { mk = i; go = 0; }
            if (go == 1) { i = i + 1; }
        }
    }
    #delete[i];
    #delete[go];
    return mk;
}

// case-insensitive: does the CSSC string literal `lit` start with the source
// partial at (pOff,pLen)? Uses the string-object layout (ptr@sa -> header;
// len@hdr+4; data@hdr+8), exactly like txSpanIs in lower.cssc.
#define(txCompStartsWith) {
    #scanp(txCompStartsWith, int, 0) pOff;
    #scanp(txCompStartsWith, int, 1) pLen;
    #scanp(txCompStartsWith, string, 2) lit;
    #req[txSrc] txSrc;
    #stack[int, 64] sa = 0;
    #adress[lit] sa;
    #stack[int, 64] hdr = cssc::peek64(sa);
    #stack[int, 64] llen = cssc::peek32(hdr + 4);
    #stack[int, 64] ldata = hdr + 8;
    #stack[int, 64] r = 1;
    if (pLen > llen) { r = 0; }
    if (r == 1) {
        #stack[int, 64] i = 0;
        #stack[int, 32] go = 1;
        while (go == 1) {
            if (i >= pLen) { go = 0; }
            if (go == 1) {
                #stack[int, 64] pc = cssc::peek8(txSrc + pOff + i);
                #stack[int, 64] lc = cssc::peek8(ldata + i);
                if (pc >= 65) { if (pc <= 90) { pc = pc + 32; } }
                if (lc >= 65) { if (lc <= 90) { lc = lc + 32; } }
                if (pc != lc) { r = 0; go = 0; }
                #delete[pc];
                #delete[lc];
                if (go == 1) { i = i + 1; }
            }
        }
        #delete[i];
        #delete[go];
    }
    #delete[sa];
    #delete[hdr];
    #delete[llen];
    #delete[ldata];
    return r;
}

// 1 if the source contains `#include("MOD")` / `#depend("MOD")` for the module
// name in the string literal `modLit`. Used to gate include-only directives in
// completion (don't suggest #cdefine unless `def` is included, etc.).
#define(txHasInclude) {
    #scanp(txHasInclude, string, 0) modLit;
    #req[txSrc] txSrc;
    #req[txSrcLen] txSrcLen;
    #req[txSpanEqLit] txSpanEqLit;
    #stack[int, 64] sa = 0;
    #adress[modLit] sa;
    #stack[int, 64] hdr = cssc::peek64(sa);
    #stack[int, 64] mlen = cssc::peek32(hdr + 4);
    #stack[int, 64] mdata = hdr + 8;
    #stack[int, 64] found = 0;
    #stack[int, 64] i = 0;
    while (i < txSrcLen) {
        if (found == 1) { i = txSrcLen; }
        if (found == 0) {
            #stack[int, 32] hit = 0;
            if (cssc::peek8(txSrc + i) == 35) {
                txSpanEqLit(i + 1, 7, "include") inc;
                txSpanEqLit(i + 1, 6, "depend") dep;
                if (inc == 1) { hit = 1; }
                if (dep == 1) { hit = 1; }
                #delete[inc];
                #delete[dep];
            }
            if (hit == 1) {
                #stack[int, 64] q = i;
                #stack[int, 32] qg = 1;
                while (qg == 1) {
                    if (q >= txSrcLen) { qg = 0; }
                    if (qg == 1) {
                        #stack[int, 64] qc = cssc::peek8(txSrc + q);
                        if (qc == 34) { qg = 0; }
                        if (qc == 39) { qg = 0; }
                        if (qc == 10) { qg = 0; }
                        #delete[qc];
                        if (qg == 1) { q = q + 1; }
                    }
                }
                if (q < txSrcLen) {
                    #stack[int, 64] qc2 = cssc::peek8(txSrc + q);
                    if (qc2 == 34) {
                        #stack[int, 64] mo = q + 1;
                        #stack[int, 64] e = mo;
                        #stack[int, 32] eg = 1;
                        while (eg == 1) {
                            if (e >= txSrcLen) { eg = 0; }
                            if (eg == 1) { if (cssc::peek8(txSrc + e) == 34) { eg = 0; } else { e = e + 1; } }
                        }
                        #stack[int, 64] ml = e - mo;
                        if (ml == mlen) {
                            #stack[int, 32] eq = 1;
                            #stack[int, 64] k = 0;
                            while (k < ml) {
                                if (cssc::peek8(txSrc + mo + k) != cssc::peek8(mdata + k)) { eq = 0; k = ml; }
                                if (k < ml) { k = k + 1; }
                            }
                            if (eq == 1) { found = 1; }
                            #delete[eq];
                            #delete[k];
                        }
                        #delete[ml];
                        #delete[e];
                        #delete[eg];
                        #delete[mo];
                    }
                    #delete[qc2];
                }
                #delete[q];
            }
            #delete[hit];
            if (found == 0) { i = i + 1; }
        }
    }
    #delete[i];
    #delete[sa];
    #delete[hdr];
    #delete[mlen];
    #delete[mdata];
    return found;
}

#define(txCompDirectives) {
    #scanp(txCompDirectives, int, 0) pOff;
    #scanp(txCompDirectives, int, 1) pLen;
    #req[txCompStartsWith] txCompStartsWith;
    #req[txHasInclude] txHasInclude;
    txCompStartsWith(pOff, pLen, "stack") h1;   if (h1 == 1) { cssc::out("#stack");   cssc::outln(); } #delete[h1];
    txCompStartsWith(pOff, pLen, "heap") h2;    if (h2 == 1) { cssc::out("#heap");    cssc::outln(); } #delete[h2];
    txCompStartsWith(pOff, pLen, "auto") h3;    if (h3 == 1) { cssc::out("#auto");    cssc::outln(); } #delete[h3];
    txCompStartsWith(pOff, pLen, "define") h4;  if (h4 == 1) { cssc::out("#define");  cssc::outln(); } #delete[h4];
    txCompStartsWith(pOff, pLen, "delete") h6;  if (h6 == 1) { cssc::out("#delete");  cssc::outln(); } #delete[h6];
    txCompStartsWith(pOff, pLen, "free") h7;    if (h7 == 1) { cssc::out("#free");    cssc::outln(); } #delete[h7];
    txCompStartsWith(pOff, pLen, "include") h8; if (h8 == 1) { cssc::out("#include"); cssc::outln(); } #delete[h8];
    txCompStartsWith(pOff, pLen, "load") h9;    if (h9 == 1) { cssc::out("#load");    cssc::outln(); } #delete[h9];
    txCompStartsWith(pOff, pLen, "unload") h10; if (h10 == 1) { cssc::out("#unload"); cssc::outln(); } #delete[h10];
    txCompStartsWith(pOff, pLen, "depend") h11; if (h11 == 1) { cssc::out("#depend"); cssc::outln(); } #delete[h11];
    txCompStartsWith(pOff, pLen, "scanp") h12;  if (h12 == 1) { cssc::out("#scanp");  cssc::outln(); } #delete[h12];
    txCompStartsWith(pOff, pLen, "DEFINE") h14; if (h14 == 1) { cssc::out("#DEFINE"); cssc::outln(); } #delete[h14];
    // ---- module-gated directives: only offered when their #include is present ----
    txHasInclude("def") hasDef;
    if (hasDef == 1) {
        txCompStartsWith(pOff, pLen, "cdefine") g1;   if (g1 == 1) { cssc::out("#cdefine");   cssc::outln(); } #delete[g1];
        txCompStartsWith(pOff, pLen, "param") g2;     if (g2 == 1) { cssc::out("#param");     cssc::outln(); } #delete[g2];
        txCompStartsWith(pOff, pLen, "fvar") g3;      if (g3 == 1) { cssc::out("#fvar");      cssc::outln(); } #delete[g3];
        txCompStartsWith(pOff, pLen, "qvar") g4;      if (g4 == 1) { cssc::out("#qvar");      cssc::outln(); } #delete[g4];
        txCompStartsWith(pOff, pLen, "scanp_opt") g5; if (g5 == 1) { cssc::out("#scanp_opt"); cssc::outln(); } #delete[g5];
    }
    #delete[hasDef];
    txHasInclude("sys") hasSys;
    if (hasSys == 1) {
        txCompStartsWith(pOff, pLen, "sysarg") g6; if (g6 == 1) { cssc::out("#sysarg"); cssc::outln(); } #delete[g6];
    }
    #delete[hasSys];
    txHasInclude("devdebug") hasDbg;
    if (hasDbg == 1) {
        txCompStartsWith(pOff, pLen, "debug") g7; if (g7 == 1) { cssc::out("#debug"); cssc::outln(); } #delete[g7];
        txCompStartsWith(pOff, pLen, "trace") g8; if (g8 == 1) { cssc::out("#trace"); cssc::outln(); } #delete[g8];
    }
    #delete[hasDbg];
    txHasInclude("video") hasVid;
    if (hasVid == 1) {
        txCompStartsWith(pOff, pLen, "video") gv; if (gv == 1) { cssc::out("#video"); cssc::outln(); } #delete[gv];
    }
    #delete[hasVid];
    txHasInclude("stdout") hasSo;
    if (hasSo == 1) {
        txCompStartsWith(pOff, pLen, "stdout") g9; if (g9 == 1) { cssc::out("#stdout"); cssc::outln(); } #delete[g9];
    }
    #delete[hasSo];
}

// DECL type tag (0 int/1 str/2 float/3 vec/4 map/5 bind) of the slot named
// (qOff,qLen), or -1 if no such slot exists. Latest matching slot wins.
#define(txSlotDeclType) {
    #scanp(txSlotDeclType, int, 0) qOff;
    #scanp(txSlotDeclType, int, 1) qLen;
    #req[txSemaSymOff] txSemaSymOff;
    #req[txSemaSymLen] txSemaSymLen;
    #req[txSemaSymKind] txSemaSymKind;
    #req[txSemaSymCount] txSemaSymCount;
    #req[txSemaSymDeclType] txSemaSymDeclType;
    #req[txDdSpanEq] txDdSpanEq;
    #stack[int, 64] dt = 0 - 1;
    #stack[int, 32] conflict = 0;               // same name declared at 2+ DIFFERENT types
    #stack[int, 64] i = 0;
    #stack[int, 32] go = 1;
    while (go == 1) {
        if (i >= txSemaSymCount) { go = 0; }
        if (go == 1) {
            #stack[int, 64] o = i * 8;
            // slot (1), #scanp param (5), or #req import (7) — all carry a declType
            #stack[int, 64] ok = cssc::peek64(txSemaSymKind + o);
            #stack[int, 32] slotish = 0;
            if (ok == 1) { slotish = 1; }
            if (ok == 5) { slotish = 1; }
            if (ok == 7) { slotish = 1; }
            if (slotish == 1) {
                txDdSpanEq(qOff, qLen, cssc::peek64(txSemaSymOff + o), cssc::peek64(txSemaSymLen + o)) me;
                if (me == 1) {
                    #stack[int, 64] mdt = cssc::peek64(txSemaSymDeclType + o);
                    if (dt == 0 - 1) { dt = mdt; }
                    else { if (mdt != dt) { conflict = 1; } }
                    #delete[mdt];
                }
                #delete[me];
            }
            #delete[ok];
            #delete[slotish];
            #delete[o];
            i = i + 1;
        }
    }
    #delete[i];
    #delete[go];
    // The type check (NO_SUCH_METHOD) resolves a receiver by NAME only; when the
    // same name is declared at different types in different scopes (e.g. an
    // `array<string> collector` in one block and a `string collector` in another)
    // the type is ambiguous — report unknown so the check stays silent (no FP).
    if (conflict == 1) { dt = 0 - 1; }
    return dt;
}

// Emit the built-in `string` methods prefix-matching the partial (pOff,pLen).
// Flat table (no element-type granularity) — mirrors cssc_aware's `string`
// entry in lints._CONTAINER_METHODS.
#define(txCompStringMethods) {
    #scanp(txCompStringMethods, int, 0) pOff;
    #scanp(txCompStringMethods, int, 1) pLen;
    #req[txCompStartsWith] txCompStartsWith;
    txCompStartsWith(pOff, pLen, "append") ma;     if (ma == 1) { cssc::out("append"); cssc::outln(); }     #delete[ma];
    txCompStartsWith(pOff, pLen, "declared") md;   if (md == 1) { cssc::out("declared"); cssc::outln(); }   #delete[md];
    txCompStartsWith(pOff, pLen, "char_at") m1;    if (m1 == 1) { cssc::out("char_at"); cssc::outln(); }    #delete[m1];
    txCompStartsWith(pOff, pLen, "contains") m2;   if (m2 == 1) { cssc::out("contains"); cssc::outln(); }   #delete[m2];
    txCompStartsWith(pOff, pLen, "endswith") m3;   if (m3 == 1) { cssc::out("endswith"); cssc::outln(); }   #delete[m3];
    txCompStartsWith(pOff, pLen, "indexof") m4;    if (m4 == 1) { cssc::out("indexof"); cssc::outln(); }    #delete[m4];
    txCompStartsWith(pOff, pLen, "isalpha") m5;    if (m5 == 1) { cssc::out("isalpha"); cssc::outln(); }    #delete[m5];
    txCompStartsWith(pOff, pLen, "isdigit") m6;    if (m6 == 1) { cssc::out("isdigit"); cssc::outln(); }    #delete[m6];
    txCompStartsWith(pOff, pLen, "len") m7;        if (m7 == 1) { cssc::out("len"); cssc::outln(); }        #delete[m7];
    txCompStartsWith(pOff, pLen, "lower") m8;      if (m8 == 1) { cssc::out("lower"); cssc::outln(); }      #delete[m8];
    txCompStartsWith(pOff, pLen, "replace") m9;    if (m9 == 1) { cssc::out("replace"); cssc::outln(); }    #delete[m9];
    txCompStartsWith(pOff, pLen, "reverse") m10;   if (m10 == 1) { cssc::out("reverse"); cssc::outln(); }   #delete[m10];
    txCompStartsWith(pOff, pLen, "size") m11;      if (m11 == 1) { cssc::out("size"); cssc::outln(); }      #delete[m11];
    txCompStartsWith(pOff, pLen, "split") m12;     if (m12 == 1) { cssc::out("split"); cssc::outln(); }     #delete[m12];
    txCompStartsWith(pOff, pLen, "startswith") m13; if (m13 == 1) { cssc::out("startswith"); cssc::outln(); } #delete[m13];
    txCompStartsWith(pOff, pLen, "trim") m14;      if (m14 == 1) { cssc::out("trim"); cssc::outln(); }      #delete[m14];
    txCompStartsWith(pOff, pLen, "upper") m15;     if (m15 == 1) { cssc::out("upper"); cssc::outln(); }     #delete[m15];
}

// built-in `vector<T>` methods (14) — element-independent surface, matching
// vector_int / vector_string / vector_float in lints._CONTAINER_METHODS.
#define(txCompVectorMethods) {
    #scanp(txCompVectorMethods, int, 0) pOff;
    #scanp(txCompVectorMethods, int, 1) pLen;
    #req[txCompStartsWith] txCompStartsWith;
    #req[txCompStartsWith] txCompStartsWith;
    txCompStartsWith(pOff, pLen, "at") m1;         if (m1 == 1) { cssc::out("at"); cssc::outln(); }         #delete[m1];
    txCompStartsWith(pOff, pLen, "clear") m2;      if (m2 == 1) { cssc::out("clear"); cssc::outln(); }      #delete[m2];
    txCompStartsWith(pOff, pLen, "declared") md;   if (md == 1) { cssc::out("declared"); cssc::outln(); }   #delete[md];
    txCompStartsWith(pOff, pLen, "contains") m3;   if (m3 == 1) { cssc::out("contains"); cssc::outln(); }   #delete[m3];
    txCompStartsWith(pOff, pLen, "erase") m4;      if (m4 == 1) { cssc::out("erase"); cssc::outln(); }      #delete[m4];
    txCompStartsWith(pOff, pLen, "first") m5;      if (m5 == 1) { cssc::out("first"); cssc::outln(); }      #delete[m5];
    txCompStartsWith(pOff, pLen, "indexof") m6;    if (m6 == 1) { cssc::out("indexof"); cssc::outln(); }    #delete[m6];
    txCompStartsWith(pOff, pLen, "insert") m7;     if (m7 == 1) { cssc::out("insert"); cssc::outln(); }     #delete[m7];
    txCompStartsWith(pOff, pLen, "last") m8;       if (m8 == 1) { cssc::out("last"); cssc::outln(); }       #delete[m8];
    txCompStartsWith(pOff, pLen, "pop_back") m9;   if (m9 == 1) { cssc::out("pop_back"); cssc::outln(); }   #delete[m9];
    txCompStartsWith(pOff, pLen, "push_back") m10; if (m10 == 1) { cssc::out("push_back"); cssc::outln(); } #delete[m10];
    txCompStartsWith(pOff, pLen, "reverse") m11;   if (m11 == 1) { cssc::out("reverse"); cssc::outln(); }   #delete[m11];
    txCompStartsWith(pOff, pLen, "size") m12;      if (m12 == 1) { cssc::out("size"); cssc::outln(); }      #delete[m12];
    txCompStartsWith(pOff, pLen, "slice") m13;     if (m13 == 1) { cssc::out("slice"); cssc::outln(); }     #delete[m13];
    txCompStartsWith(pOff, pLen, "sort") m14;      if (m14 == 1) { cssc::out("sort"); cssc::outln(); }      #delete[m14];
}

// built-in `bind` methods — a list subclass keyed by pair_width (size/length =
// pair count). See docs 01 §8.
#define(txCompBindMethods) {
    #scanp(txCompBindMethods, int, 0) pOff;
    #scanp(txCompBindMethods, int, 1) pLen;
    #req[txEmitFiltered] txEmitFiltered;
    txEmitFiltered(pOff, pLen, "size\nlength\naddmap\nat\npush_back\npop_back\nclear\ncontains\nindexof\nfirst\nlast\ninsert\nerase\nreverse\nslice\ndeclared");
}

// built-in `map<K,V>` methods (8) — matching map_si / map_ss.
#define(txCompMapMethods) {
    #scanp(txCompMapMethods, int, 0) pOff;
    #scanp(txCompMapMethods, int, 1) pLen;
    #req[txCompStartsWith] txCompStartsWith;
    txCompStartsWith(pOff, pLen, "clear") m1;      if (m1 == 1) { cssc::out("clear"); cssc::outln(); }      #delete[m1];
    txCompStartsWith(pOff, pLen, "declared") md;   if (md == 1) { cssc::out("declared"); cssc::outln(); }   #delete[md];
    txCompStartsWith(pOff, pLen, "get") m2;        if (m2 == 1) { cssc::out("get"); cssc::outln(); }        #delete[m2];
    txCompStartsWith(pOff, pLen, "has") m3;        if (m3 == 1) { cssc::out("has"); cssc::outln(); }        #delete[m3];
    txCompStartsWith(pOff, pLen, "keys") m4;       if (m4 == 1) { cssc::out("keys"); cssc::outln(); }       #delete[m4];
    txCompStartsWith(pOff, pLen, "remove") m5;     if (m5 == 1) { cssc::out("remove"); cssc::outln(); }     #delete[m5];
    txCompStartsWith(pOff, pLen, "set") m6;        if (m6 == 1) { cssc::out("set"); cssc::outln(); }        #delete[m6];
    txCompStartsWith(pOff, pLen, "size") m7;       if (m7 == 1) { cssc::out("size"); cssc::outln(); }       #delete[m7];
    txCompStartsWith(pOff, pLen, "values") m8;     if (m8 == 1) { cssc::out("values"); cssc::outln(); }     #delete[m8];
}

// deepest scope whose [startLine,endLine] contains `line`; 0 (document root)
// when none. "Deepest" = the containing scope that starts latest.
#define(txScopeAt) {
    #scanp(txScopeAt, int, 0) line;
    #req[txSemaScopeStartLine] txSemaScopeStartLine;
    #req[txSemaScopeEndLine] txSemaScopeEndLine;
    #req[txSemaScopeNext] txSemaScopeNext;
    #stack[int, 64] best = 0;
    #stack[int, 64] bestStart = 0;
    #stack[int, 64] sid = 1;
    #stack[int, 32] go = 1;
    while (go == 1) {
        if (sid >= txSemaScopeNext) { go = 0; }
        if (go == 1) {
            #stack[int, 64] s = cssc::peek64(txSemaScopeStartLine + sid * 8);
            if (s > 0) {
                if (line >= s) {
                    if (line <= cssc::peek64(txSemaScopeEndLine + sid * 8)) {
                        if (s > bestStart) { best = sid; bestStart = s; }
                    }
                }
            }
            #delete[s];
            sid = sid + 1;
        }
    }
    #delete[go];
    #delete[sid];
    #delete[bestStart];
    return best;
}

// Scope id of the `#define` that ENCLOSES the byte offset `off`, resolved by
// scanning the source BACKWARD for the nearest `#define(NAME` and mapping NAME
// to its body scope (owner-kind 2). Unlike txScopeAt (line-range based), this is
// immune to the completion's cursor-line blanking, which shrinks a scope's
// recorded end line below the cursor when the `#req[` line is the body's only
// statement -- the exact case that left `#req[` completion empty. For a nested
// `#define` the nearest backward header is the INNER define, so its parent chain
// (the enclosing define's locals + globals) is what becomes requirable. Falls
// back to the line-based scope when the offset is not inside any `#define`.
#define(txReqScopeAt) {
    #scanp(txReqScopeAt, int, 0) off;
    #req[txSrc] txSrc;
    #req[txSrcLen] txSrcLen;
    #req[txSpanEqLit] txSpanEqLit;
    #req[txScopeByOwner] txScopeByOwner;
    #req[txScopeAt] txScopeAt;
    #req[txSemaLineOf] txSemaLineOf;
    #stack[int, 64] i = off;
    #stack[int, 64] result = 0;
    #stack[int, 32] state = 0;                          // 0 searching, 1 done
    while (state == 0) {
        if (i <= 0) { state = 1; }
        if (state == 0) {
            i = i - 1;
            if (cssc::peek8(txSrc + i) == 35) {         // '#'
                txSpanEqLit(i + 1, 7, "define(") isdef;
                if (isdef == 1) {
                    #stack[int, 64] ns = i + 8;         // first byte of NAME
                    #stack[int, 64] ne = ns;
                    #stack[int, 32] sg = 1;
                    while (sg == 1) {
                        if (ne >= txSrcLen) { sg = 0; }
                        if (sg == 1) {
                            #stack[int, 64] c = cssc::peek8(txSrc + ne);
                            #stack[int, 32] id = 0;
                            if (c >= 48) { if (c <= 57) { id = 1; } }
                            if (c >= 65) { if (c <= 90) { id = 1; } }
                            if (c >= 97) { if (c <= 122) { id = 1; } }
                            if (c == 95) { id = 1; }
                            if (id == 1) { ne = ne + 1; }
                            if (id == 0) { sg = 0; }
                            #delete[c];
                            #delete[id];
                        }
                    }
                    #delete[sg];
                    if (ne > ns) {
                        txScopeByOwner(ns, ne - ns, 2) sc;
                        result = sc;
                        #delete[sc];
                    }
                    #delete[ns];
                    #delete[ne];
                    state = 1;
                }
                #delete[isdef];
            }
        }
    }
    #delete[i];
    #delete[state];
    if (result == 0) {                                  // not inside a #define -> line-based
        txSemaLineOf(off) ln;
        txScopeAt(ln) sc2;
        result = sc2;
        #delete[ln];
        #delete[sc2];
    }
    return result;
}

// 1 if the partial (pOff,pLen) occurs case-insensitively anywhere in the name
// span (nOff,nLen) — subsumes prefix, case-insensitive-prefix and substring
// (the reference's ranks 1-3). Empty partial matches everything.
#define(txMatchRank) {
    #scanp(txMatchRank, int, 0) pOff;
    #scanp(txMatchRank, int, 1) pLen;
    #scanp(txMatchRank, int, 2) nOff;
    #scanp(txMatchRank, int, 3) nLen;
    #req[txSrc] txSrc;
    #stack[int, 64] r = 0;
    if (pLen == 0) { r = 1; }
    if (pLen > 0) {
        if (pLen <= nLen) {
            #stack[int, 64] last = nLen - pLen;
            #stack[int, 64] j = 0;
            #stack[int, 32] go = 1;
            while (go == 1) {
                if (j > last) { go = 0; }
                if (go == 1) {
                    #stack[int, 32] ok = 1;
                    #stack[int, 64] k = 0;
                    #stack[int, 32] kg = 1;
                    while (kg == 1) {
                        if (k >= pLen) { kg = 0; }
                        if (kg == 1) {
                            #stack[int, 64] pc = cssc::peek8(txSrc + pOff + k);
                            #stack[int, 64] nc = cssc::peek8(txSrc + nOff + j + k);
                            if (pc >= 65) { if (pc <= 90) { pc = pc + 32; } }
                            if (nc >= 65) { if (nc <= 90) { nc = nc + 32; } }
                            if (pc != nc) { ok = 0; kg = 0; }
                            #delete[pc];
                            #delete[nc];
                            if (kg == 1) { k = k + 1; }
                        }
                    }
                    #delete[k];
                    #delete[kg];
                    if (ok == 1) { r = 1; go = 0; }
                    #delete[ok];
                    if (go == 1) { j = j + 1; }
                }
            }
            #delete[j];
            #delete[go];
            #delete[last];
        }
    }
    return r;
}

// 1 if the CSSC string literal `lit` starts (case-SENSITIVE) with the source
// partial (pOff,pLen) — how keywords/types are matched by the reference.
#define(txLitPrefixCS) {
    #scanp(txLitPrefixCS, int, 0) pOff;
    #scanp(txLitPrefixCS, int, 1) pLen;
    #scanp(txLitPrefixCS, string, 2) lit;
    #req[txSrc] txSrc;
    #stack[int, 64] sa = 0;
    #adress[lit] sa;
    #stack[int, 64] hdr = cssc::peek64(sa);
    #stack[int, 64] llen = cssc::peek32(hdr + 4);
    #stack[int, 64] ldata = hdr + 8;
    #stack[int, 64] r = 1;
    if (pLen > llen) { r = 0; }
    if (r == 1) {
        #stack[int, 64] i = 0;
        #stack[int, 32] go = 1;
        while (go == 1) {
            if (i >= pLen) { go = 0; }
            if (go == 1) {
                if (cssc::peek8(txSrc + pOff + i) != cssc::peek8(ldata + i)) { r = 0; go = 0; }
                if (go == 1) { i = i + 1; }
            }
        }
        #delete[i];
        #delete[go];
    }
    #delete[sa];
    #delete[hdr];
    #delete[llen];
    #delete[ldata];
    return r;
}

// emit CSSC keywords + built-in type names that case-sensitively start with the
// partial (pOff,pLen). Same tables/rule as lsp_bridge _scope_items.
#define(txCompKwType) {
    #scanp(txCompKwType, int, 0) pOff;
    #scanp(txCompKwType, int, 1) pLen;
    #req[txLitPrefixCS] txLitPrefixCS;
    txLitPrefixCS(pOff, pLen, "if") k1;         if (k1 == 1) { cssc::out("if"); cssc::outln(); }             #delete[k1];
    txLitPrefixCS(pOff, pLen, "else") k2;       if (k2 == 1) { cssc::out("else"); cssc::outln(); }           #delete[k2];
    txLitPrefixCS(pOff, pLen, "while") k3;      if (k3 == 1) { cssc::out("while"); cssc::outln(); }          #delete[k3];
    txLitPrefixCS(pOff, pLen, "for") k4;        if (k4 == 1) { cssc::out("for"); cssc::outln(); }            #delete[k4];
    txLitPrefixCS(pOff, pLen, "return") k5;     if (k5 == 1) { cssc::out("return"); cssc::outln(); }         #delete[k5];
    txLitPrefixCS(pOff, pLen, "mirror") k6;     if (k6 == 1) { cssc::out("mirror"); cssc::outln(); }         #delete[k6];
    txLitPrefixCS(pOff, pLen, "break") k7;      if (k7 == 1) { cssc::out("break"); cssc::outln(); }          #delete[k7];
    txLitPrefixCS(pOff, pLen, "continue") k8;   if (k8 == 1) { cssc::out("continue"); cssc::outln(); }       #delete[k8];
    txLitPrefixCS(pOff, pLen, "sector") k9;     if (k9 == 1) { cssc::out("sector"); cssc::outln(); }         #delete[k9];
    txLitPrefixCS(pOff, pLen, "object") k10;    if (k10 == 1) { cssc::out("object"); cssc::outln(); }        #delete[k10];
    txLitPrefixCS(pOff, pLen, "true") k11;      if (k11 == 1) { cssc::out("true"); cssc::outln(); }          #delete[k11];
    txLitPrefixCS(pOff, pLen, "false") k12;     if (k12 == 1) { cssc::out("false"); cssc::outln(); }         #delete[k12];
    txLitPrefixCS(pOff, pLen, "null") k13;      if (k13 == 1) { cssc::out("null"); cssc::outln(); }          #delete[k13];
    txLitPrefixCS(pOff, pLen, "select") k14;    if (k14 == 1) { cssc::out("select"); cssc::outln(); }        #delete[k14];
    txLitPrefixCS(pOff, pLen, "jump") k15;      if (k15 == 1) { cssc::out("jump"); cssc::outln(); }          #delete[k15];
    txLitPrefixCS(pOff, pLen, "int") t1;        if (t1 == 1) { cssc::out("int"); cssc::outln(); }            #delete[t1];
    txLitPrefixCS(pOff, pLen, "float") t2;      if (t2 == 1) { cssc::out("float"); cssc::outln(); }          #delete[t2];
    txLitPrefixCS(pOff, pLen, "bool") t3;       if (t3 == 1) { cssc::out("bool"); cssc::outln(); }           #delete[t3];
    txLitPrefixCS(pOff, pLen, "string") t4;     if (t4 == 1) { cssc::out("string"); cssc::outln(); }         #delete[t4];
    txLitPrefixCS(pOff, pLen, "void") t5;       if (t5 == 1) { cssc::out("void"); cssc::outln(); }           #delete[t5];
    txLitPrefixCS(pOff, pLen, "auto") t6;       if (t6 == 1) { cssc::out("auto"); cssc::outln(); }           #delete[t6];
    txLitPrefixCS(pOff, pLen, "var") t6b;       if (t6b == 1) { cssc::out("var"); cssc::outln(); }           #delete[t6b];
    txLitPrefixCS(pOff, pLen, "vector") t7;     if (t7 == 1) { cssc::out("vector"); cssc::outln(); }         #delete[t7];
    txLitPrefixCS(pOff, pLen, "array") t8;      if (t8 == 1) { cssc::out("array"); cssc::outln(); }          #delete[t8];
    txLitPrefixCS(pOff, pLen, "bind") t9;       if (t9 == 1) { cssc::out("bind"); cssc::outln(); }           #delete[t9];
    txLitPrefixCS(pOff, pLen, "map") t10;       if (t10 == 1) { cssc::out("map"); cssc::outln(); }           #delete[t10];
}

// emit in-scope visible names matching the partial. Walks the scope chain from
// `scope` up through parents, stopping at an isolation barrier (function /
// object / label). #req imports are stored as kind-7 symbols inside the scope,
// so they survive the barrier. Deduped by name text (inner shadows outer).
#define(txVisibleEmit) {
    #scanp(txVisibleEmit, int, 0) scope;
    #scanp(txVisibleEmit, int, 1) pOff;
    #scanp(txVisibleEmit, int, 2) pLen;
    #req[txSrc] txSrc;
    #req[txSemaSymOff] txSemaSymOff;
    #req[txSemaSymLen] txSemaSymLen;
    #req[txSemaSymKind] txSemaSymKind;
    #req[txSemaSymScope] txSemaSymScope;
    #req[txSemaSymCount] txSemaSymCount;
    #req[txSemaScopeParent] txSemaScopeParent;
    #req[txSemaScopeIsolating] txSemaScopeIsolating;
    #req[txSemaScopeOwnerKind] txSemaScopeOwnerKind;
    #req[txMatchRank] txMatchRank;
    #req[txDdSpanEq] txDdSpanEq;
    #stack[int, 64] emCap = 1024;
    #stack[int, 64] emOff = cssc::alloc(emCap * 8);
    #stack[int, 64] emLen = cssc::alloc(emCap * 8);
    #stack[int, 64] emN = 0;
    #stack[int, 64] s = scope;
    #stack[int, 32] walk = 1;
    #stack[int, 32] stopAfter = 0;          // set when we've hopped to a sector/object parent
    while (walk == 1) {
        #stack[int, 64] i = 0;
        #stack[int, 32] ig = 1;
        while (ig == 1) {
            if (i >= txSemaSymCount) { ig = 0; }
            if (ig == 1) {
                #stack[int, 64] o = i * 8;
                if (cssc::peek64(txSemaSymScope + o) == s) {
                    #stack[int, 64] nOff = cssc::peek64(txSemaSymOff + o);
                    #stack[int, 64] nLen = cssc::peek64(txSemaSymLen + o);
                    txMatchRank(pOff, pLen, nOff, nLen) m;
                    // scope-order: CSSC is declare-before-use, so only names
                    // declared BEFORE the cursor token (nOff < pOff) are visible.
                    // A later-declared var (line 30) must not appear on line 1..29.
                    #stack[int, 32] visible = 0;
                    if (m == 1) { if (nOff < pOff) { visible = 1; } }
                    if (visible == 1) {
                        #stack[int, 32] dup = 0;
                        #stack[int, 64] e = 0;
                        #stack[int, 32] eg = 1;
                        while (eg == 1) {
                            if (e >= emN) { eg = 0; }
                            if (eg == 1) {
                                txDdSpanEq(nOff, nLen, cssc::peek64(emOff + e * 8), cssc::peek64(emLen + e * 8)) se;
                                if (se == 1) { dup = 1; eg = 0; }
                                #delete[se];
                                if (eg == 1) { e = e + 1; }
                            }
                        }
                        #delete[e];
                        #delete[eg];
                        if (dup == 0) {
                            cssc::printRaw(txSrc + nOff, nLen);
                            cssc::outln();
                            if (emN < emCap) {
                                cssc::poke64(emOff + emN * 8, nOff);
                                cssc::poke64(emLen + emN * 8, nLen);
                                emN = emN + 1;
                            }
                        }
                        #delete[dup];
                    }
                    #delete[visible];
                    #delete[m];
                    #delete[nOff];
                    #delete[nLen];
                }
                #delete[o];
                if (ig == 1) { i = i + 1; }
            }
        }
        #delete[i];
        #delete[ig];
        if (stopAfter == 1) { walk = 0; }        // just emitted the sector/object members
        if (walk == 1) {
            if (cssc::peek64(txSemaScopeIsolating + s * 8) == 1) {
                // A function/label body isolates its LOCALS -- but the enclosing
                // SECTOR's (or OBJECT's) members are reachable by BARE name inside
                // its methods (`process(...)`, not `Sector::process`). Hop once into
                // a sector/object parent, emit its members, then stop.
                #stack[int, 64] par = cssc::peek64(txSemaScopeParent + s * 8);
                #stack[int, 64] pk = cssc::peek64(txSemaScopeOwnerKind + par * 8);
                if (pk == 4) { s = par; stopAfter = 1; }        // SECTOR
                if (pk == 3) { s = par; stopAfter = 1; }        // OBJECT
                if (pk != 4) { if (pk != 3) { walk = 0; } }
                #delete[pk];
                #delete[par];
            }
            if (walk == 1) {
                if (stopAfter == 0) {
                    if (s == 0) { walk = 0; }
                    if (walk == 1) { s = cssc::peek64(txSemaScopeParent + s * 8); }
                }
            }
        }
    }
    #delete[stopAfter];
    #delete[walk];
    #delete[s];
    #delete[emN];
    #delete[emOff];
    #delete[emLen];
    #delete[emCap];
}

// off = cursor offset (where the marker was). Detect the context and emit.
//   #partial -> directives;  Obj->m -> object members;  obj.m -> object labels;
//   Sector::m -> sector public members;  bare word -> in-scope names + kw/types.
// #req[ candidates: bindings declared in ENCLOSING scopes (across isolation
// barriers — that's what #req imports), prefix-matched, excluding deleted names
// and duplicates. Skips the current scope's own locals (they need no #req).
// Requirable = anything the runtime lets `#req[X]` name: a slot (kind 1), a
// callable/#define (2, `#req` a function then CALL it), a param (5) of an
// enclosing define, or an already-imported alias (7, re-#req'd through nested
// defines — e.g. `#req[REG_ALLOCATE]` inside a define nested in the one that
// itself did `#req[..] *REG_ALLOCATE`). Types (object/sector) are not #req'd.
#define(txCompImportable) {
    #scanp(txCompImportable, int, 0) scope;
    #scanp(txCompImportable, int, 1) pOff;
    #scanp(txCompImportable, int, 2) pLen;
    #req[txSrc] txSrc;
    #req[txSemaSymOff] txSemaSymOff;
    #req[txSemaSymLen] txSemaSymLen;
    #req[txSemaSymKind] txSemaSymKind;
    #req[txSemaSymScope] txSemaSymScope;
    #req[txSemaSymCount] txSemaSymCount;
    #req[txSemaScopeParent] txSemaScopeParent;
    #req[txMatchRank] txMatchRank;
    #req[txDdSpanEq] txDdSpanEq;
    #req[txDdFind] txDdFind;
    #stack[int, 64] emCap = 1024;
    #stack[int, 64] emOff = cssc::alloc(emCap * 8);
    #stack[int, 64] emLen = cssc::alloc(emCap * 8);
    #stack[int, 64] emN = 0;
    #stack[int, 64] s = 0;
    #stack[int, 32] walk = 1;
    if (scope == 0) { walk = 0; }
    if (walk == 1) { s = cssc::peek64(txSemaScopeParent + scope * 8); }
    while (walk == 1) {
        #stack[int, 64] i = 0;
        #stack[int, 32] ig = 1;
        while (ig == 1) {
            if (i >= txSemaSymCount) { ig = 0; }
            if (ig == 1) {
                #stack[int, 64] o = i * 8;
                #stack[int, 64] sk = cssc::peek64(txSemaSymKind + o);
                #stack[int, 32] reqK = 0;               // requirable kinds: slot/callable/param/import
                if (sk == 1) { reqK = 1; }
                if (sk == 2) { reqK = 1; }
                if (sk == 5) { reqK = 1; }
                if (sk == 7) { reqK = 1; }
                #delete[sk];
                if (reqK == 1) {
                    if (cssc::peek64(txSemaSymScope + o) == s) {
                        #stack[int, 64] nOff = cssc::peek64(txSemaSymOff + o);
                        #stack[int, 64] nLen = cssc::peek64(txSemaSymLen + o);
                        txMatchRank(pOff, pLen, nOff, nLen) m;
                        #stack[int, 32] okEmit = 0;
                        if (m == 1) {
                            txDdFind(nOff, nLen) del;
                            if (del < 0) { okEmit = 1; }
                            #delete[del];
                        }
                        if (okEmit == 1) {
                            #stack[int, 32] dup = 0;
                            #stack[int, 64] e = 0;
                            #stack[int, 32] eg = 1;
                            while (eg == 1) {
                                if (e >= emN) { eg = 0; }
                                if (eg == 1) {
                                    txDdSpanEq(nOff, nLen, cssc::peek64(emOff + e * 8), cssc::peek64(emLen + e * 8)) se;
                                    if (se == 1) { dup = 1; eg = 0; }
                                    #delete[se];
                                    if (eg == 1) { e = e + 1; }
                                }
                            }
                            #delete[e];
                            #delete[eg];
                            if (dup == 0) {
                                cssc::printRaw(txSrc + nOff, nLen);
                                cssc::outln();
                                if (emN < emCap) {
                                    cssc::poke64(emOff + emN * 8, nOff);
                                    cssc::poke64(emLen + emN * 8, nLen);
                                    emN = emN + 1;
                                }
                            }
                            #delete[dup];
                        }
                        #delete[okEmit];
                        #delete[m];
                        #delete[nOff];
                        #delete[nLen];
                    }
                }
                #delete[reqK];
                #delete[o];
                if (ig == 1) { i = i + 1; }
            }
        }
        #delete[i];
        #delete[ig];
        if (s == 0) { walk = 0; }
        if (walk == 1) {
            s = cssc::peek64(txSemaScopeParent + s * 8);
            if (s < 0) { walk = 0; }
        }
    }
    #delete[walk];
    #delete[s];
    #delete[emN];
    #delete[emOff];
    #delete[emLen];
    #delete[emCap];
}

// #free[ candidates: sector symbols (kind 4 — user sectors + #include'd modules),
// prefix-matched. `#free` releases sectors; `#delete` releases everything else.
#define(txCompSectors) {
    #scanp(txCompSectors, int, 0) pOff;
    #scanp(txCompSectors, int, 1) pLen;
    #req[txSrc] txSrc;
    #req[txSemaSymOff] txSemaSymOff;
    #req[txSemaSymLen] txSemaSymLen;
    #req[txSemaSymKind] txSemaSymKind;
    #req[txSemaSymDeclType] txSemaSymDeclType;
    #req[txSemaSymCount] txSemaSymCount;
    #req[txMatchRank] txMatchRank;
    #stack[int, 64] i = 0;
    #stack[int, 32] go = 1;
    while (go == 1) {
        if (i >= txSemaSymCount) { go = 0; }
        if (go == 1) {
            #stack[int, 64] o = i * 8;
            #stack[int, 32] isFreeable = 0;
            if (cssc::peek64(txSemaSymKind + o) == 4) { isFreeable = 1; }  // user sector
            if (cssc::peek64(txSemaSymKind + o) == 1) {                    // module alias
                if (cssc::peek64(txSemaSymDeclType + o) == 9) { isFreeable = 1; }
            }
            if (isFreeable == 1) {
                #stack[int, 64] nOff = cssc::peek64(txSemaSymOff + o);
                #stack[int, 64] nLen = cssc::peek64(txSemaSymLen + o);
                txMatchRank(pOff, pLen, nOff, nLen) m;
                if (m == 1) {
                    cssc::printRaw(txSrc + nOff, nLen);
                    cssc::outln();
                }
                #delete[m];
                #delete[nOff];
                #delete[nLen];
            }
            #delete[isFreeable];
            #delete[o];
            i = i + 1;
        }
    }
    #delete[i];
    #delete[go];
}

// #scanp( first-arg: the enclosing callable's name. Found by scanning the source
// BACKWARD from the cursor for the nearest `#define(NAME` — robust against the
// completion's cursor-line blanking (which can shrink a scope's recorded end
// line below the cursor), unlike a scope-owner lookup. `#scanp(fn, int, 0)`
// reads fn's params, so arg0 is always the enclosing fn.
#define(txEnclosingDefineName) {
    #scanp(txEnclosingDefineName, int, 0) off;
    #scanp(txEnclosingDefineName, int, 1) pOff;
    #scanp(txEnclosingDefineName, int, 2) pLen;
    #req[txSrc] txSrc;
    #req[txSrcLen] txSrcLen;
    #req[txSpanEqLit] txSpanEqLit;
    #req[txMatchRank] txMatchRank;
    #stack[int, 64] i = off;
    #stack[int, 32] state = 0;         // 0 searching, 1 emitted/found, 2 hit start
    while (state == 0) {
        if (i <= 0) { state = 2; }
        if (state == 0) {
            i = i - 1;
            if (cssc::peek8(txSrc + i) == 35) {              // '#'
                txSpanEqLit(i + 1, 7, "define(") isdef;
                if (isdef == 1) {
                    #stack[int, 64] ns = i + 8;
                    #stack[int, 64] ne = ns;
                    #stack[int, 32] sg = 1;
                    while (sg == 1) {
                        if (ne >= txSrcLen) { sg = 0; }
                        if (sg == 1) {
                            #stack[int, 64] c = cssc::peek8(txSrc + ne);
                            #stack[int, 32] id = 0;
                            if (c >= 48) { if (c <= 57) { id = 1; } }
                            if (c >= 65) { if (c <= 90) { id = 1; } }
                            if (c >= 97) { if (c <= 122) { id = 1; } }
                            if (c == 95) { id = 1; }
                            if (id == 1) { ne = ne + 1; }
                            if (id == 0) { sg = 0; }
                            #delete[c];
                            #delete[id];
                        }
                    }
                    #delete[sg];
                    if (ne > ns) {
                        txMatchRank(pOff, pLen, ns, ne - ns) m;
                        if (m == 1) {
                            cssc::printRaw(txSrc + ns, ne - ns);
                            cssc::outln();
                        }
                        #delete[m];
                    }
                    #delete[ns];
                    #delete[ne];
                    state = 1;
                }
                #delete[isdef];
            }
        }
    }
    #delete[i];
    #delete[state];
}

// Emit each '\n'-separated name in the string literal `lit` that case-insensitively
// prefix-matches the source partial (pOff,pLen). The workhorse for module name /
// module method completion (compact embedded tables instead of a symbol scan).
#define(txEmitFiltered) {
    #scanp(txEmitFiltered, int, 0) pOff;
    #scanp(txEmitFiltered, int, 1) pLen;
    #scanp(txEmitFiltered, string, 2) lit;
    #req[txSrc] txSrc;
    #stack[int, 64] sa = 0;
    #adress[lit] sa;
    #stack[int, 64] hdr = cssc::peek64(sa);
    #stack[int, 64] llen = cssc::peek32(hdr + 4);
    #stack[int, 64] ldata = hdr + 8;
    #stack[int, 64] i = 0;
    while (i < llen) {
        #stack[int, 64] j = i;
        #stack[int, 32] sg = 1;
        while (sg == 1) {
            if (j >= llen) { sg = 0; }
            if (sg == 1) { if (cssc::peek8(ldata + j) == 10) { sg = 0; } else { j = j + 1; } }
        }
        #delete[sg];
        #stack[int, 64] seglen = j - i;
        #stack[int, 32] ok = 1;
        if (pLen > seglen) { ok = 0; }
        if (ok == 1) {
            #stack[int, 64] k = 0;
            #stack[int, 32] mg = 1;
            while (mg == 1) {
                if (k >= pLen) { mg = 0; }
                if (mg == 1) {
                    #stack[int, 64] pc = cssc::peek8(txSrc + pOff + k);
                    #stack[int, 64] lc = cssc::peek8(ldata + i + k);
                    if (pc >= 65) { if (pc <= 90) { pc = pc + 32; } }
                    if (lc >= 65) { if (lc <= 90) { lc = lc + 32; } }
                    if (pc != lc) { ok = 0; mg = 0; }
                    #delete[pc];
                    #delete[lc];
                    if (mg == 1) { k = k + 1; }
                }
            }
            #delete[k];
            #delete[mg];
        }
        if (ok == 1) { if (seglen > 0) { cssc::printRaw(ldata + i, seglen); cssc::outln(); } }
        #delete[ok];
        #delete[seglen];
        i = j + 1;
        #delete[j];
    }
    #delete[i];
    #delete[sa];
    #delete[hdr];
    #delete[llen];
    #delete[ldata];
}

// Standard module names, offered inside `#include("…")` / `#depend("…")` /
// `#load["…"]`. (The native-only host modules the IDE ships are listed too.)
#define(txCompModuleNames) {
    #scanp(txCompModuleNames, int, 0) pOff;
    #scanp(txCompModuleNames, int, 1) pLen;
    #req[txEmitFiltered] txEmitFiltered;
    txEmitFiltered(pOff, pLen, "stdio\nsizes\ndef\nsys\nstdout\ncssl\ncssc.ini\ncssc.sys\ncssc.io\ncssc.paths\ncssc.env\ncssc.math\ncssc.fastif\ncssc.peek\ncssc.binary\ncssc.dll\npeek\ndevdebug\nstdgrace\nvideo\nmatrix\nasyncthreads\nserialcommunication\nkeyboard\nmouse\nsound\nnetwork.http\nSharedLib\nx86_64.gui\nsystem");
}

// ===========================================================================
// Module-surface glue for the generated moddocs.cssc (type ctor params +
// instance methods). These bridge sema source spans to the moddocs lookups.
// (txMdModOff/Len + txMdCanOff/Len are forward-declared near the top.)
// ===========================================================================

// Resolve `alias` (span) to its module name via the nearest `#include("MOD") alias;`
// / `#depend("MOD") alias;`. On success sets txMdModOff/txMdModLen and returns 1.
#stack[int, 64] txMdAliasToMod;
#define(txMdAliasToMod) {
    #scanp(txMdAliasToMod, int, 0) aliasOff;
    #scanp(txMdAliasToMod, int, 1) aliasLen;
    #req[txSrc] txSrc;
    #req[txSrcLen] txSrcLen;
    #req[txSpanEqLit] txSpanEqLit;
    #req[txDdSpanEq] txDdSpanEq;
    #req[txMdModOff] txMdModOff;
    #req[txMdModLen] txMdModLen;
    #stack[int, 32] found = 0;
    #stack[int, 64] i = 0;
    while (i < txSrcLen) {
        if (found == 1) { i = txSrcLen; }
        if (found == 0) {
            #stack[int, 32] hit = 0;
            if (cssc::peek8(txSrc + i) == 35) {                     // '#'
                txSpanEqLit(i + 1, 7, "include") inc;
                txSpanEqLit(i + 1, 6, "depend") dep;
                if (inc == 1) { hit = 1; }
                if (dep == 1) { hit = 1; }
                #delete[inc];
                #delete[dep];
            }
            if (hit == 1) {
                #stack[int, 64] q = i;
                #stack[int, 32] qg = 1;
                while (qg == 1) {
                    if (q >= txSrcLen) { qg = 0; }
                    if (qg == 1) {
                        #stack[int, 64] qc = cssc::peek8(txSrc + q);
                        if (qc == 34) { qg = 0; }
                        if (qc == 39) { qg = 0; }
                        if (qc == 41) { qg = 0; }
                        #delete[qc];
                        if (qg == 1) { q = q + 1; }
                    }
                }
                if (q < txSrcLen) {
                    #stack[int, 64] qc2 = cssc::peek8(txSrc + q);
                    if (qc2 == 34) {
                        #stack[int, 64] mo = q + 1;
                        #stack[int, 64] e = mo;
                        #stack[int, 32] eg = 1;
                        while (eg == 1) {
                            if (e >= txSrcLen) { eg = 0; }
                            if (eg == 1) { if (cssc::peek8(txSrc + e) == 34) { eg = 0; } else { e = e + 1; } }
                        }
                        #stack[int, 64] ml = e - mo;
                        #delete[e];
                        #delete[eg];
                        #stack[int, 64] a = mo + ml + 1;
                        #stack[int, 32] ag = 1;
                        while (ag == 1) {
                            if (a >= txSrcLen) { ag = 0; }
                            if (ag == 1) {
                                #stack[int, 64] ac = cssc::peek8(txSrc + a);
                                #stack[int, 32] skip = 0;
                                if (ac == 41) { skip = 1; }
                                if (ac == 32) { skip = 1; }
                                if (ac == 9) { skip = 1; }
                                if (ac == 13) { skip = 1; }
                                if (ac == 10) { skip = 1; }
                                if (skip == 0) { ag = 0; }
                                #delete[ac];
                                #delete[skip];
                                if (ag == 1) { a = a + 1; }
                            }
                        }
                        #delete[ag];
                        #stack[int, 64] al = 0;
                        #stack[int, 32] ig = 1;
                        while (ig == 1) {
                            #stack[int, 64] ic = cssc::peek8(txSrc + a + al);
                            #stack[int, 32] isw = 0;
                            if (ic >= 65) { if (ic <= 90) { isw = 1; } }
                            if (ic >= 97) { if (ic <= 122) { isw = 1; } }
                            if (ic >= 48) { if (ic <= 57) { isw = 1; } }
                            if (ic == 95) { isw = 1; }
                            if (isw == 0) { ig = 0; }
                            #delete[ic];
                            #delete[isw];
                            if (ig == 1) { al = al + 1; }
                        }
                        #delete[ig];
                        txDdSpanEq(aliasOff, aliasLen, a, al) me;
                        if (me == 1) { txMdModOff = mo; txMdModLen = ml; found = 1; }
                        #delete[me];
                        #delete[al];
                        #delete[a];
                        #delete[ml];
                        #delete[mo];
                    }
                    #delete[qc2];
                }
                #delete[q];
            }
            #delete[hit];
            if (found == 0) { i = i + 1; }
        }
    }
    #delete[i];
    return found;
}

// Canonicalise a module-name span to a known moddocs key: try the full name,
// then strip leading dotted segments (`x86_64.gui` -> `gui`) -- mirrors the
// reference resolve_stub. Sets txMdCanOff/txMdCanLen (unchanged if never known).
#stack[int, 64] txMdCanonMod;
#define(txMdCanonMod) {
    #scanp(txMdCanonMod, int, 0) mOff;
    #scanp(txMdCanonMod, int, 1) mLen;
    #req[txSrc] txSrc;
    #req[txMdIsKnownMod] txMdIsKnownMod;
    #req[txMdCanOff] txMdCanOff;
    #req[txMdCanLen] txMdCanLen;
    #stack[int, 64] co = mOff;
    #stack[int, 64] cl = mLen;
    #stack[int, 32] go = 1;
    while (go == 1) {
        txMdIsKnownMod(co, cl) k;
        if (k == 1) { go = 0; }
        if (k == 0) {
            #stack[int, 64] dot = 0 - 1;
            #stack[int, 64] d = 0;
            while (d < cl) {
                if (cssc::peek8(txSrc + co + d) == 46) { dot = d; d = cl; } else { d = d + 1; }
            }
            #delete[d];
            if (dot < 0) { go = 0; }
            if (dot >= 0) { co = co + dot + 1; cl = cl - dot - 1; }
            #delete[dot];
        }
        #delete[k];
    }
    #delete[go];
    txMdCanOff = co;
    txMdCanLen = cl;
    #delete[co];
    #delete[cl];
    return 0;
}

// Combined: resolve alias -> module -> canonical. On success sets
// txMdCanOff/txMdCanLen and returns 1; 0 if the alias is not a module include.
#stack[int, 64] txMdAliasCanon;
#define(txMdAliasCanon) {
    #scanp(txMdAliasCanon, int, 0) aliasOff;
    #scanp(txMdAliasCanon, int, 1) aliasLen;
    #req[txMdAliasToMod] txMdAliasToMod;
    #req[txMdCanonMod] txMdCanonMod;
    #req[txMdModOff] txMdModOff;
    #req[txMdModLen] txMdModLen;
    txMdAliasToMod(aliasOff, aliasLen) f;
    if (f == 1) { txMdCanonMod(txMdModOff, txMdModLen); }
    #stack[int, 32] r = f;
    #delete[f];
    return r;
}

// Resolve a receiver slot to its MODULE instance. `handle` was captured from
// `alias::Name(...) handle;`, so its recorded type span is the FULL callee
// `alias::Name` (namespaced names keep `::` in one span). If that span carries a
// `::`, resolves to a known module, and that callable yields an instance, this
// sets txMdCanOff/Len (canonical module) + txMdRnOff/Len (the callable name span)
// and returns 1. Otherwise returns 0.
#stack[int, 64] txMdResolveReceiver;
#define(txMdResolveReceiver) {
    #scanp(txMdResolveReceiver, int, 0) qOff;
    #scanp(txMdResolveReceiver, int, 1) qLen;
    #req[txSrc] txSrc;
    #req[txSemaSymOff] txSemaSymOff;
    #req[txSemaSymLen] txSemaSymLen;
    #req[txSemaSymKind] txSemaSymKind;
    #req[txSemaSymTypeOff] txSemaSymTypeOff;
    #req[txSemaSymTypeLen] txSemaSymTypeLen;
    #req[txSemaSymCount] txSemaSymCount;
    #req[txDdSpanEq] txDdSpanEq;
    #req[txMdAliasCanon] txMdAliasCanon;
    #req[txMdCanOff] txMdCanOff;
    #req[txMdCanLen] txMdCanLen;
    #req[txMdRnOff] txMdRnOff;
    #req[txMdRnLen] txMdRnLen;
    #req[txMdYields] txMdYields;
    #stack[int, 32] handled = 0;
    #stack[int, 64] si = 0;
    #stack[int, 32] gs = 1;
    while (gs == 1) {
        if (si >= txSemaSymCount) { gs = 0; }
        if (gs == 1) {
            #stack[int, 64] so = si * 8;
            #stack[int, 64] sik = cssc::peek64(txSemaSymKind + so);
            #stack[int, 32] slotish = 0;
            if (sik == 1) { slotish = 1; }
            if (sik == 5) { slotish = 1; }
            if (sik == 7) { slotish = 1; }
            #delete[sik];
            if (slotish == 1) {
                txDdSpanEq(qOff, qLen, cssc::peek64(txSemaSymOff + so), cssc::peek64(txSemaSymLen + so)) me;
                if (me == 1) {
                    #stack[int, 64] tOff = cssc::peek64(txSemaSymTypeOff + so);
                    #stack[int, 64] tLen = cssc::peek64(txSemaSymTypeLen + so);
                    if (tLen > 0) {
                        #stack[int, 64] cc = 0 - 1;
                        #stack[int, 64] d = 0;
                        while (d + 1 < tLen) {
                            if (cssc::peek8(txSrc + tOff + d) == 58) {
                                if (cssc::peek8(txSrc + tOff + d + 1) == 58) { cc = d; d = tLen; }
                            }
                            if (cc < 0) { d = d + 1; }
                        }
                        #delete[d];
                        if (cc >= 0) {
                            #stack[int, 64] nameOff = tOff + cc + 2;
                            #stack[int, 64] nameLen = tLen - cc - 2;
                            txMdAliasCanon(tOff, cc) af;
                            if (af == 1) {
                                txMdYields(txMdCanOff, txMdCanLen, nameOff, nameLen) y;
                                if (y == 1) { txMdRnOff = nameOff; txMdRnLen = nameLen; handled = 1; }
                                #delete[y];
                            }
                            #delete[af];
                            #delete[nameLen];
                            #delete[nameOff];
                        }
                        #delete[cc];
                        gs = 0;
                    }
                    #delete[tLen];
                    #delete[tOff];
                }
                #delete[me];
            }
            #delete[so];
            if (gs == 1) { si = si + 1; }
        }
    }
    #delete[si];
    #delete[gs];
    return handled;
}

// `handle.` dot completion for a module-typed instance -> emit the yielded
// type's methods. Returns 1 if handled (caller skips the object-label fallback).
#stack[int, 64] txMdEmitForReceiver;
#define(txMdEmitForReceiver) {
    #scanp(txMdEmitForReceiver, int, 0) qOff;
    #scanp(txMdEmitForReceiver, int, 1) qLen;
    #scanp(txMdEmitForReceiver, int, 2) pOff;
    #scanp(txMdEmitForReceiver, int, 3) pLen;
    #req[txMdResolveReceiver] txMdResolveReceiver;
    #req[txMdCanOff] txMdCanOff;
    #req[txMdCanLen] txMdCanLen;
    #req[txMdRnOff] txMdRnOff;
    #req[txMdRnLen] txMdRnLen;
    #req[txMdEmitInst] txMdEmitInst;
    txMdResolveReceiver(qOff, qLen) r;
    if (r == 1) { txMdEmitInst(txMdCanOff, txMdCanLen, txMdRnOff, txMdRnLen, pOff, pLen); }
    #stack[int, 32] h = r;
    #delete[r];
    return h;
}

// `alias::` where alias came from `#include("MOD") alias;` (or #depend): find the
// declaration by forward-scanning the source, then emit MOD's method names. Builtin
// modules have a known API; user `#load` files expose their own #defines (not here).
#define(txCompModuleMethods) {
    #scanp(txCompModuleMethods, int, 0) aliasOff;
    #scanp(txCompModuleMethods, int, 1) aliasLen;
    #scanp(txCompModuleMethods, int, 2) pOff;
    #scanp(txCompModuleMethods, int, 3) pLen;
    #req[txMdAliasCanon] txMdAliasCanon;
    #req[txMdCanOff] txMdCanOff;
    #req[txMdCanLen] txMdCanLen;
    #req[txMdEmitTypes] txMdEmitTypes;
    #req[txMdEmitFuncs] txMdEmitFuncs;
    // Resolve the alias (`#include("MOD") alias;`) to its CANONICAL module key
    // (arch-prefix stripped) and emit that module's constructor TYPES + namespace
    // FUNCTIONS from the generated moddocs surface -- the SAME cssc_aware STUBs the
    // Python reference completes from, so gui/stdio/cssc.dll/cssc.sys/... stay in
    // sync automatically (no hand-maintained per-module list to drift).
    txMdAliasCanon(aliasOff, aliasLen) f;
    if (f == 1) {
        txMdEmitTypes(txMdCanOff, txMdCanLen, pOff, pLen);
        txMdEmitFuncs(txMdCanOff, txMdCanLen, pOff, pLen);
    }
    #delete[f];
}

// The builtin `cssc::` namespace — the native intrinsics the compiler lowers:
// memory (alloc/free/peek*/poke*/memcopy/memfill32), host & port I/O, program
// args, bit ops, the float bridge (f*/iToF/strToF), OS services, self-hosting
// exec, low-level CPU/framebuffer, and the float constants. Authoritative
// surface = cir_lower `_NS_CALL_RUNTIME[('cssc', …)]` + `out`/`outln`.
#define(txCompCsscMethods) {
    #scanp(txCompCsscMethods, int, 0) pOff;
    #scanp(txCompCsscMethods, int, 1) pLen;
    #req[txEmitFiltered] txEmitFiltered;
    // Two surfaces on `cssc::`: the low-level self-hosted/native primitives
    // (peek/poke/alloc/f*/os*/kernel) AND the user-facing interpreter builtins
    // (I/O, math, type-conv, container, control-flow, random, time, CLI). Both
    // resolve at runtime, so both complete. The user-facing set mirrors the
    // Python reference's `cssc::` completion (cssl_cssc `_ns_builtins` + the cssc
    // CLI module) so the IDE offers random/to_int/typeof/sqrt/push/sort/... too.
    txEmitFiltered(pOff, pLen, "outln\nout\nip\nipcall\nipto\nrun\nalloc\nfree\npeek8\npeek16\npeek32\npeek64\npoke8\npoke16\npoke32\npoke64\nmemcopy\nmemfill32\nprintRaw\nhostRead\nhostErr\nosReadFile\nargc\nargStr\nband\nbor\nbxor\nshl\nshr\niToF\nfToI\nfAdd\nfSub\nfMul\nfDiv\nfMod\nfCmp\nfNeg\nfAbs\nfSqrt\nfFloor\nfCeil\nfTrunc\nfRound\nfToStr\nstrToF\nosTime\nosTimestamp\nosClock\nosDetime\nosSdetime\nosSleep\nsleep\nosGetenv\nosSystem\nosPopen\nosPid\nosBeep\nosDiskUsage\nosKill\nosReadLine\nosStrftime\noutb\noutw\noutl\ninb\ninw\ninl\nmakeExec\ncallAddr\nrtsym\noutCapture\noutCaptureLen\noutCaptureEnd\nmodPath\nmodRead\nmodPathInc\nreadCs\nfontRow\nhlt\ncli\nsti\npause\nlgdt\nlidt\nltr\nreadCr0\nreadCr2\nreadCr3\nreadCr4\nwriteCr0\nwriteCr3\nwriteCr4\ninvlpg\nrdmsr\nwrmsr\nrdtsc\nisrFrame\nreadRsp\nfbAddr\nfbWidth\nfbHeight\nfbPitch\nfbBpp\nhhdmOffset\nmemmapCount\nmemmapBase\nmemmapLength\nmemmapType\nmemUsable\nheapUsed\nframesFree\nframesTotal\nmapMmio\nPI\nTAU\nE\nSQRT2\nLN2\nLN10\nEPSILON\nINFINITY\nabs\nmin\nmax\nlen\npush\npop\nsort\nrange\nsqrt\ninput\nexit\ntypeof\nis_string\nto_int\nto_float\nto_string\nrandom\nrandom_int\ntime\ntimestamp\ndate\ndatetime\ndetime\nsdetime\nelapsed\nclock\nuptime\ntime_format\nset_timezone\nreboot\nshell\nargs\ncopy\nntp_sync\nwifi_connect\nanalyze\nassemble\nbuild\ninterpret\ncreate_runtime\npctrace");
}

// Resolve whether module alias (aliasOff,aliasLen) is LOADED at byte `cursorOff`
// and, if so, where its file PATH string lives in txSrc. Scans every
// `#load[path] alias` / `#unload[alias]` BEFORE the cursor, last-one-wins (mirrors
// the runtime: #unload drops the module, a later #load re-binds it). Returns 1 and
// sets txLoadPathO/txLoadPathL to the path span on success, else 0.
#define(txLoadPathAt) {
    #scanp(txLoadPathAt, int, 0) aliasOff;
    #scanp(txLoadPathAt, int, 1) aliasLen;
    #scanp(txLoadPathAt, int, 2) cursorOff;
    #req[txSrc] txSrc;
    #req[txSrcLen] txSrcLen;
    #req[txSpanEqLit] txSpanEqLit;
    #req[txDdSpanEq] txDdSpanEq;
    #req[txLoadPathO] txLoadPathO;
    #req[txLoadPathL] txLoadPathL;
    #stack[int, 64] loaded = 0;
    #stack[int, 64] lim = cursorOff;
    if (lim > txSrcLen) { lim = txSrcLen; }
    #stack[int, 64] i = 0;
    while (i < lim) {
        if (cssc::peek8(txSrc + i) == 35) {                      // '#'
            txSpanEqLit(i + 1, 4, "load") isL;
            txSpanEqLit(i + 1, 6, "unload") isU;
            if (isU == 1) {                                      // #unload[alias]
                #stack[int, 64] b = i + 7;                       // scan to '['
                #stack[int, 32] bg = 1;
                while (bg == 1) {
                    if (b >= lim) { bg = 0; }
                    if (bg == 1) { #stack[int, 64] bc = cssc::peek8(txSrc + b); if (bc == 91) { bg = 0; } else { if (bc == 10) { bg = 0; b = lim; } else { b = b + 1; } } #delete[bc]; }
                }
                #delete[bg];
                if (b < lim) {
                    #stack[int, 64] a = b + 1;
                    #stack[int, 32] ws2 = 1;
                    while (ws2 == 1) { if (a >= lim) { ws2 = 0; } if (ws2 == 1) { #stack[int, 64] wc = cssc::peek8(txSrc + a); if (wc == 32) { a = a + 1; } else { if (wc == 9) { a = a + 1; } else { ws2 = 0; } } #delete[wc]; } }
                    #delete[ws2];
                    #stack[int, 64] al = 0;
                    #stack[int, 32] ig = 1;
                    while (ig == 1) {
                        if (a + al >= lim) { ig = 0; }
                        if (ig == 1) { #stack[int, 64] ic = cssc::peek8(txSrc + a + al); #stack[int, 32] iw = 0; if (ic >= 65) { if (ic <= 90) { iw = 1; } } if (ic >= 97) { if (ic <= 122) { iw = 1; } } if (ic >= 48) { if (ic <= 57) { iw = 1; } } if (ic == 95) { iw = 1; } if (iw == 1) { al = al + 1; } else { ig = 0; } #delete[ic]; #delete[iw]; }
                    }
                    #delete[ig];
                    txDdSpanEq(aliasOff, aliasLen, a, al) mu;
                    if (mu == 1) { loaded = 0; }
                    #delete[mu];
                    #delete[al];
                    #delete[a];
                }
                #delete[b];
            }
            if (isL == 1) {                                      // #load[path] alias
                #stack[int, 64] q = i + 5;
                #stack[int, 32] qg = 1;
                while (qg == 1) {
                    if (q >= lim) { qg = 0; }
                    if (qg == 1) { #stack[int, 64] qc = cssc::peek8(txSrc + q); if (qc == 34) { qg = 0; } else { if (qc == 39) { qg = 0; } else { if (qc == 10) { qg = 0; q = lim; } else { q = q + 1; } } } #delete[qc]; }
                }
                #delete[qg];
                if (q < lim) {
                    #stack[int, 64] mo = q + 1;
                    #stack[int, 64] e = mo;
                    #stack[int, 32] eg = 1;
                    while (eg == 1) { if (e >= lim) { eg = 0; } if (eg == 1) { #stack[int, 64] ec = cssc::peek8(txSrc + e); if (ec == 34) { eg = 0; } else { if (ec == 39) { eg = 0; } else { e = e + 1; } } #delete[ec]; } }
                    #delete[eg];
                    #stack[int, 64] ml = e - mo;
                    #stack[int, 64] a = e + 1;
                    #stack[int, 32] ag = 1;
                    while (ag == 1) {
                        if (a >= lim) { ag = 0; }
                        if (ag == 1) { #stack[int, 64] ac = cssc::peek8(txSrc + a); #stack[int, 32] sk = 0; if (ac == 93) { sk = 1; } if (ac == 41) { sk = 1; } if (ac == 32) { sk = 1; } if (ac == 9) { sk = 1; } if (sk == 1) { a = a + 1; } else { ag = 0; } #delete[ac]; #delete[sk]; }
                    }
                    #delete[ag];
                    #stack[int, 64] al = 0;
                    #stack[int, 32] ig = 1;
                    while (ig == 1) {
                        if (a + al >= lim) { ig = 0; }
                        if (ig == 1) { #stack[int, 64] ic = cssc::peek8(txSrc + a + al); #stack[int, 32] iw = 0; if (ic >= 65) { if (ic <= 90) { iw = 1; } } if (ic >= 97) { if (ic <= 122) { iw = 1; } } if (ic >= 48) { if (ic <= 57) { iw = 1; } } if (ic == 95) { iw = 1; } if (iw == 1) { al = al + 1; } else { ig = 0; } #delete[ic]; #delete[iw]; }
                    }
                    #delete[ig];
                    txDdSpanEq(aliasOff, aliasLen, a, al) mm;
                    if (mm == 1) { loaded = 1; txLoadPathO = mo; txLoadPathL = ml; }
                    #delete[mm];
                    #delete[al];
                    #delete[a];
                    #delete[ml];
                    #delete[e];
                    #delete[mo];
                }
                #delete[q];
            }
            #delete[isL];
            #delete[isU];
        }
        i = i + 1;
    }
    #delete[i];
    #delete[lim];
    return loaded;
}

// `alias::` where alias is a `#load["rel/path.cssc"] alias;` binding STILL loaded at
// the cursor (respecting a later `#unload[alias]`) -> complete the LOADED file's
// top-level members (#define/#cdefine funcs, sector/object types, #stack/#heap/#auto
// vars). Resolves the path against the edited file's directory, reads + harvests the
// member surface, and emits the newly-found names that prefix-match the partial.
#define(txCompLoadDefs) {
    #scanp(txCompLoadDefs, int, 0) aliasOff;
    #scanp(txCompLoadDefs, int, 1) aliasLen;
    #scanp(txCompLoadDefs, int, 2) pOff;
    #scanp(txCompLoadDefs, int, 3) pLen;
    #scanp(txCompLoadDefs, int, 4) cursorOff;
    #req[txSrc] txSrc;
    #req[txLoadPathAt] txLoadPathAt;
    #req[txLoadPathO] txLoadPathO;
    #req[txLoadPathL] txLoadPathL;
    #req[txScanModMembers] txScanModMembers;
    #req[txExtBuf] txExtBuf;
    #req[txExtLen] txExtLen;
    #req[txExtInit] txExtInit;
    #req[txCompDirBuf] txCompDirBuf;
    #req[txCompDirLen] txCompDirLen;
    txLoadPathAt(aliasOff, aliasLen, cursorOff) ok;
    if (ok == 1) {
        #stack[int, 64] pathO = txLoadPathO;
        #stack[int, 64] pathL = txLoadPathL;
        if (txExtBuf == 0) { txExtInit(); }
        #stack[int, 64] before = txExtLen;
        #stack[int, 64] pathBuf = cssc::alloc(4096);
        #stack[int, 64] pp = 0;
        while (pp < txCompDirLen) { cssc::poke8(pathBuf + pp, cssc::peek8(txCompDirBuf + pp)); pp = pp + 1; }
        if (txCompDirLen > 0) { cssc::poke8(pathBuf + pp, 47); pp = pp + 1; }   // '/'
        #stack[int, 64] pk = 0;
        while (pk < pathL) { cssc::poke8(pathBuf + pp + pk, cssc::peek8(txSrc + pathO + pk)); pk = pk + 1; }
        #delete[pk];
        #stack[int, 64] fullLen = pp + pathL;
        #stack[int, 64] fileBuf = cssc::alloc(1200000);
        cssc::osReadFile(pathBuf, fullLen, fileBuf, 1200000) rn;
        if (rn > 0) { txScanModMembers(fileBuf, rn); }
        #stack[int, 64] ee = before;
        while (ee < txExtLen) {
            #stack[int, 64] jj = ee;
            #stack[int, 32] jg = 1;
            while (jg == 1) {
                if (jj >= txExtLen) { jg = 0; }
                if (jg == 1) { if (cssc::peek8(txExtBuf + jj) == 10) { jg = 0; } else { jj = jj + 1; } }
            }
            #delete[jg];
            #stack[int, 64] seglen = jj - ee;
            #stack[int, 32] pm = 1;
            if (pLen > seglen) { pm = 0; }
            if (pm == 1) {
                #stack[int, 64] c = 0;
                #stack[int, 32] cg = 1;
                while (cg == 1) {
                    if (c >= pLen) { cg = 0; }
                    if (cg == 1) {
                        if (cssc::peek8(txSrc + pOff + c) != cssc::peek8(txExtBuf + ee + c)) { pm = 0; cg = 0; }
                        if (cg == 1) { c = c + 1; }
                    }
                }
                #delete[c];
                #delete[cg];
            }
            if (pm == 1) {
                cssc::printRaw(txExtBuf + ee, seglen);
                cssc::outln();
            }
            #delete[pm];
            #delete[seglen];
            ee = jj + 1;
        }
        #delete[ee];
        #delete[rn];
        #delete[fileBuf];
        #delete[fullLen];
        #delete[pp];
        #delete[pathBuf];
        #delete[before];
        #delete[pathO];
        #delete[pathL];
    }
    #delete[ok];
}

#define(txCompleteAt) {
    #scanp(txCompleteAt, int, 0) off;
    #req[txSrc] txSrc;
    #req[txCompDirectives] txCompDirectives;
    #req[txScanIdentBack] txScanIdentBack;
    #req[txCompMember] txCompMember;
    #req[txSlotDeclType] txSlotDeclType;
    #req[txCompStringMethods] txCompStringMethods;
    #req[txCompVectorMethods] txCompVectorMethods;
    #req[txCompMapMethods] txCompMapMethods;
    #req[txCompBindMethods] txCompBindMethods;
    #req[txSemaLineOf] txSemaLineOf;
    #req[txScopeAt] txScopeAt;
    #req[txVisibleEmit] txVisibleEmit;
    #req[txCompKwType] txCompKwType;
    #req[txSpanEqLit] txSpanEqLit;
    #req[txCompImportable] txCompImportable;
    #req[txReqScopeAt] txReqScopeAt;
    #req[txCompSectors] txCompSectors;
    #req[txCompModuleNames] txCompModuleNames;
    #req[txCompModuleMethods] txCompModuleMethods;
    #req[txCompLoadDefs] txCompLoadDefs;
    #req[txCompCsscMethods] txCompCsscMethods;
    #req[txEmitFiltered] txEmitFiltered;
    #req[txEnclosingDefineName] txEnclosingDefineName;
    txScanIdentBack(off) p;                 // p = start of the partial word
    #stack[int, 64] pLen = off - p;
    #stack[int, 32] done = 0;               // set by a qualified/directive context
    if (p > 0) {
        #stack[int, 64] c1 = cssc::peek8(txSrc + p - 1);
        if (c1 == 35) { txCompDirectives(p, pLen); done = 1; }   // '#' -> directive
        if (c1 == 46) {                                          // '.' string methods / object labels
            done = 1;
            txScanIdentBack(p - 1) q;
            #stack[int, 64] qlen2 = (p - 1) - q;
            if (qlen2 > 0) {
                txSlotDeclType(q, qlen2) dt;
                if (dt == 1) { txCompStringMethods(p, pLen); }               // string        -> string methods
                if (dt == 3) { txCompVectorMethods(p, pLen); }               // vector/array  -> list methods
                if (dt == 4) { txCompMapMethods(p, pLen); }                  // map           -> map methods
                if (dt == 5) { txCompBindMethods(p, pLen); }                 // bind          -> bind methods
                #stack[int, 32] isCont = 0;
                if (dt == 1) { isCont = 1; }
                if (dt == 3) { isCont = 1; }
                if (dt == 4) { isCont = 1; }
                if (dt == 5) { isCont = 1; }
                if (isCont == 0) {                          // module-typed handle or object instance
                    #req[txMdEmitForReceiver] txMdEmitForReceiver;
                    txMdEmitForReceiver(q, qlen2, p, pLen) mdh;
                    if (mdh == 0) { txCompMember(q, qlen2, p, pLen, 6, 3, 0, 0); } // -> object labels
                    #delete[mdh];
                }
                #delete[isCont];
                #delete[dt];
            }
            #delete[qlen2];
            #delete[q];
        }
        if (c1 == 91) {                                      // '[' directive-arg: #req[ #delete[ #free[
            txScanIdentBack(p - 1) db;
            #stack[int, 64] dblen = (p - 1) - db;
            if (dblen > 0) {
                if (db > 0) {
                    if (cssc::peek8(txSrc + db - 1) == 35) {  // '#'
                        txSpanEqLit(db, dblen, "req") isReq;
                        txSpanEqLit(db, dblen, "delete") isDel;
                        txSpanEqLit(db, dblen, "free") isFree;
                        txSpanEqLit(db, dblen, "unload") isUnl;
                        if (isReq == 1) {
                            done = 1;
                            // Enclosing-define scope via backward scan (robust to
                            // the cursor-line blanking that shrinks a scope below
                            // the cursor and left `#req[` empty; also picks the
                            // INNER define so a nested `#req[` sees the parent
                            // define's locals + globals, not just globals).
                            txReqScopeAt(off) sc;
                            txCompImportable(sc, p, pLen);
                            #delete[sc];
                        }
                        if (isDel == 1) {
                            done = 1;
                            txSemaLineOf(off) ln;
                            txScopeAt(ln) sc;
                            txVisibleEmit(sc, p, pLen);
                            #delete[ln];
                            #delete[sc];
                        }
                        if (isFree == 1) {
                            done = 1;
                            txCompSectors(p, pLen);
                        }
                        if (isUnl == 1) {                        // #unload[alias] -> module aliases + sectors
                            done = 1;
                            txCompSectors(p, pLen);
                        }
                        // `#stack[ / #heap[ / #auto[` first arg = the TYPE
                        txSpanEqLit(db, dblen, "stack") isStk;
                        txSpanEqLit(db, dblen, "heap") isHp;
                        txSpanEqLit(db, dblen, "auto") isAu;
                        #stack[int, 32] isTyp = 0;
                        if (isStk == 1) { isTyp = 1; }
                        if (isHp == 1) { isTyp = 1; }
                        if (isAu == 1) { isTyp = 1; }
                        if (isTyp == 1) {
                            done = 1;
                            txEmitFiltered(p, pLen, "int\nfloat\nstring\nbool\nvoid\nauto\nvar\nvector\narray\nbind\nmap");
                        }
                        #delete[isStk];
                        #delete[isHp];
                        #delete[isAu];
                        #delete[isTyp];
                        #delete[isReq];
                        #delete[isDel];
                        #delete[isFree];
                        #delete[isUnl];
                    }
                }
            }
            #delete[dblen];
            #delete[db];
        }
        if (c1 == 40) {                                      // '(' #scanp( first-arg = enclosing fn
            txScanIdentBack(p - 1) sb;
            #stack[int, 64] sblen = (p - 1) - sb;
            if (sblen > 0) {
                if (sb > 0) {
                    if (cssc::peek8(txSrc + sb - 1) == 35) {  // '#'
                        txSpanEqLit(sb, sblen, "scanp") isScanp;
                        if (isScanp == 1) {
                            done = 1;
                            txEnclosingDefineName(off, p, pLen);
                        }
                        #delete[isScanp];
                        // `#include( / #depend(` (bare, before the quote) -> module names
                        txSpanEqLit(sb, sblen, "include") isInc;
                        txSpanEqLit(sb, sblen, "depend") isDep;
                        if (isInc == 1) { done = 1; txCompModuleNames(p, pLen); }
                        if (isDep == 1) { done = 1; txCompModuleNames(p, pLen); }
                        #delete[isInc];
                        #delete[isDep];
                    }
                }
            }
            #delete[sblen];
            #delete[sb];
        }
        if (c1 == 34) {                                      // inside a "…" string
            #stack[int, 64] bq = p - 2;                      // char before the opening quote
            if (bq >= 0) {
                if (cssc::peek8(txSrc + bq) == 40) {         // '(' -> #include(/#depend(
                    #stack[int, 64] ds = bq;
                    #stack[int, 32] wg = 1;
                    while (wg == 1) {
                        if (ds <= 0) { wg = 0; }
                        if (wg == 1) {
                            #stack[int, 64] wc = cssc::peek8(txSrc + ds - 1);
                            #stack[int, 32] isw = 0;
                            if (wc >= 97) { if (wc <= 122) { isw = 1; } }
                            if (wc >= 65) { if (wc <= 90) { isw = 1; } }
                            if (isw == 1) { ds = ds - 1; } else { wg = 0; }
                            #delete[wc];
                            #delete[isw];
                        }
                    }
                    #delete[wg];
                    #stack[int, 64] dlen = bq - ds;
                    if (ds > 0) {
                        if (cssc::peek8(txSrc + ds - 1) == 35) {   // '#'
                            txSpanEqLit(ds, dlen, "include") di1;
                            txSpanEqLit(ds, dlen, "depend") di2;
                            if (di1 == 1) { done = 1; txCompModuleNames(p, pLen); }
                            if (di2 == 1) { done = 1; txCompModuleNames(p, pLen); }
                            #delete[di1];
                            #delete[di2];
                        }
                    }
                    #delete[dlen];
                    #delete[ds];
                }
            }
        }
        if (p >= 2) {
            #stack[int, 64] c2 = cssc::peek8(txSrc + p - 2);
            if (c2 == 45) {                                  // '-'
                if (c1 == 62) {                              // "->" object member (type or instance)
                    done = 1;
                    txScanIdentBack(p - 2) q;
                    txCompMember(q, (p - 2) - q, p, pLen, 1, 3, 0, 1);   // data members
                    txCompMember(q, (p - 2) - q, p, pLen, 2, 3, 0, 1);   // #define(Obj->m) methods
                    #delete[q];
                }
            }
            if (c2 == 58) {                                  // ':'
                if (c1 == 58) {                              // "::" sector member OR #include module method
                    done = 1;
                    txScanIdentBack(p - 2) q;
                    txSpanEqLit(q, (p - 2) - q, "cssc") qCssc;   // builtin `cssc::` namespace
                    if (qCssc == 1) {
                        txCompCsscMethods(p, pLen);
                    }
                    if (qCssc == 0) {
                        txCompMember(q, (p - 2) - q, p, pLen, 0, 4, 0, 1);   // user sector members
                        txCompModuleMethods(q, (p - 2) - q, p, pLen);        // #include("MOD") alias -> MOD methods
                        txCompLoadDefs(q, (p - 2) - q, p, pLen, off);        // #load["file"] alias -> file defs
                    }
                    #delete[qCssc];
                    #delete[q];
                }
            }
            #delete[c2];
        }
        #delete[c1];
    }
    if (done == 0) {                                          // bare word -> in-scope names + kw/types
        txSemaLineOf(off) curLine;
        txScopeAt(curLine) sc;
        txVisibleEmit(sc, p, pLen);
        txCompKwType(p, pLen);
        txEmitFiltered(p, pLen, "cssc");                     // the builtin namespace itself
        #delete[curLine];
        #delete[sc];
    }
    #delete[done];
    #delete[p];
    #delete[pLen];
}

// ===========================================================================
//  Symbol table — the foundation for ownership lints, completion & hover.
//  Records every declaration (name span + kind + scope id + decl node).
//  Scope ids: 0 = document root; each FUNC_DEF / OBJECT / SECTOR / LABELDEF
//  body gets a fresh id (isolation barriers). if/while/for/select/block bodies
//  stay in the enclosing scope for now (refined when a lint needs the exact
//  barrier rule for bare `{}`). Kinds: 1 slot 2 callable 3 object 4 sector
//  5 param 6 label.
// ===========================================================================
// (txSemaSym* data slots declared at the top of this file.)
#stack[int, 64] txSemaSymInit;
#stack[int, 64] txSemaSymAdd;
#stack[int, 64] txSemaCollectChain;
#stack[int, 64] txSemaCollectNode;
#stack[int, 64] txSemaDumpSyms;
#stack[int, 64] txSemaDumpScopes;
#stack[int, 64] txSemaBuildSyms;

#define(txSemaSymInit) {
    #req[txSemaSymOff] txSemaSymOff;
    #req[txSemaSymLen] txSemaSymLen;
    #req[txSemaSymKind] txSemaSymKind;
    #req[txSemaSymScope] txSemaSymScope;
    #req[txSemaSymNode] txSemaSymNode;
    #req[txSemaSymCount] txSemaSymCount;
    #req[txSemaSymCap] txSemaSymCap;
    #req[txSemaScopeNext] txSemaScopeNext;
    #req[txSemaScopeOwnerOff] txSemaScopeOwnerOff;
    #req[txSemaScopeOwnerLen] txSemaScopeOwnerLen;
    #req[txSemaScopeOwnerKind] txSemaScopeOwnerKind;
    #req[txSemaScopeParent] txSemaScopeParent;
    #req[txSemaScopeStartLine] txSemaScopeStartLine;
    #req[txSemaScopeEndLine] txSemaScopeEndLine;
    #req[txSemaScopeIsolating] txSemaScopeIsolating;
    #req[txSemaSymPub] txSemaSymPub;
    #req[txSemaSymTypeOff] txSemaSymTypeOff;
    #req[txSemaSymTypeLen] txSemaSymTypeLen;
    #req[txSemaSymDeclType] txSemaSymDeclType;
    txSemaSymCap = 8192;
    txSemaSymOff = cssc::alloc(txSemaSymCap * 8);
    txSemaSymLen = cssc::alloc(txSemaSymCap * 8);
    txSemaSymKind = cssc::alloc(txSemaSymCap * 8);
    txSemaSymScope = cssc::alloc(txSemaSymCap * 8);
    txSemaSymNode = cssc::alloc(txSemaSymCap * 8);
    txSemaSymPub = cssc::alloc(txSemaSymCap * 8);
    txSemaSymTypeOff = cssc::alloc(txSemaSymCap * 8);
    txSemaSymTypeLen = cssc::alloc(txSemaSymCap * 8);
    txSemaSymDeclType = cssc::alloc(txSemaSymCap * 8);
    txSemaScopeOwnerOff = cssc::alloc(txSemaSymCap * 8);
    txSemaScopeOwnerLen = cssc::alloc(txSemaSymCap * 8);
    txSemaScopeOwnerKind = cssc::alloc(txSemaSymCap * 8);
    txSemaScopeParent = cssc::alloc(txSemaSymCap * 8);
    txSemaScopeStartLine = cssc::alloc(txSemaSymCap * 8);
    txSemaScopeEndLine = cssc::alloc(txSemaSymCap * 8);
    txSemaScopeIsolating = cssc::alloc(txSemaSymCap * 8);
    cssc::memfill32(txSemaScopeOwnerOff, 0, txSemaSymCap * 2);
    cssc::memfill32(txSemaScopeOwnerLen, 0, txSemaSymCap * 2);
    cssc::memfill32(txSemaScopeOwnerKind, 0, txSemaSymCap * 2);
    cssc::memfill32(txSemaScopeParent, 0, txSemaSymCap * 2);
    cssc::memfill32(txSemaScopeStartLine, 0, txSemaSymCap * 2);
    cssc::memfill32(txSemaScopeEndLine, 0, txSemaSymCap * 2);
    cssc::memfill32(txSemaScopeIsolating, 0, txSemaSymCap * 2);
    cssc::memfill32(txSemaSymPub, 0, txSemaSymCap * 2);
    cssc::memfill32(txSemaSymTypeOff, 0, txSemaSymCap * 2);
    cssc::memfill32(txSemaSymTypeLen, 0, txSemaSymCap * 2);
    cssc::memfill32(txSemaSymDeclType, 0, txSemaSymCap * 2);
    txSemaSymCount = 0;
    txSemaScopeNext = 1;
}

#define(txSemaSymAdd) {
    #scanp(txSemaSymAdd, int, 0) off;
    #scanp(txSemaSymAdd, int, 1) len;
    #scanp(txSemaSymAdd, int, 2) kind;
    #scanp(txSemaSymAdd, int, 3) scope;
    #scanp(txSemaSymAdd, int, 4) node;
    #req[txSemaSymOff] txSemaSymOff;
    #req[txSemaSymLen] txSemaSymLen;
    #req[txSemaSymKind] txSemaSymKind;
    #req[txSemaSymScope] txSemaSymScope;
    #req[txSemaSymNode] txSemaSymNode;
    #req[txSemaSymCount] txSemaSymCount;
    #req[txSemaSymCap] txSemaSymCap;
    #stack[int, 64] i = txSemaSymCount;
    if (i < txSemaSymCap) {
        #stack[int, 64] o = i * 8;
        cssc::poke64(txSemaSymOff + o, off);
        cssc::poke64(txSemaSymLen + o, len);
        cssc::poke64(txSemaSymKind + o, kind);
        cssc::poke64(txSemaSymScope + o, scope);
        cssc::poke64(txSemaSymNode + o, node);
        txSemaSymCount = txSemaSymCount + 1;
        #delete[o];
    }
    #delete[i];
}

#define(txSemaCollectChain) {
    #scanp(txSemaCollectChain, int, 0) first;
    #scanp(txSemaCollectChain, int, 1) scope;
    #req[txAstNext] txAstNext;
    #req[txSemaCollectNode] txSemaCollectNode;
    #stack[int, 64] s = first;
    #stack[int, 32] go = 1;
    while (go == 1) {
        if (s == 0) { go = 0; }
        if (go == 1) {
            txSemaCollectNode(s, scope);
            s = cssc::peek64(txAstNext + s * 8);
        }
    }
    #delete[go];
    #delete[s];
}

#define(txSemaCollectNode) {
    #scanp(txSemaCollectNode, int, 0) node;
    #scanp(txSemaCollectNode, int, 1) scope;
    #req[txSrc] txSrc;
    #req[txAstKind] txAstKind;
    #req[txAstA] txAstA;
    #req[txAstB] txAstB;
    #req[txAstC] txAstC;
    #req[txAstNum] txAstNum;
    #req[txAstOff] txAstOff;
    #req[txAstLen] txAstLen;
    #req[txAstNext] txAstNext;
    #req[txSemaScopeNext] txSemaScopeNext;
    #req[txSemaScopeOwnerOff] txSemaScopeOwnerOff;
    #req[txSemaScopeOwnerLen] txSemaScopeOwnerLen;
    #req[txSemaScopeOwnerKind] txSemaScopeOwnerKind;
    #req[txSemaScopeParent] txSemaScopeParent;
    #req[txSemaScopeStartLine] txSemaScopeStartLine;
    #req[txSemaScopeEndLine] txSemaScopeEndLine;
    #req[txSemaScopeIsolating] txSemaScopeIsolating;
    #req[txSemaSymPub] txSemaSymPub;
    #req[txSemaSymOff] txSemaSymOff;
    #req[txSemaSymLen] txSemaSymLen;
    #req[txSemaSymKind] txSemaSymKind;
    #req[txSemaSymTypeOff] txSemaSymTypeOff;
    #req[txSemaSymTypeLen] txSemaSymTypeLen;
    #req[txSemaSymDeclType] txSemaSymDeclType;
    #req[txSemaSymCount] txSemaSymCount;
    #req[txDdSpanEq] txDdSpanEq;
    #req[txSemaSymAdd] txSemaSymAdd;
    #req[txSemaCollectChain] txSemaCollectChain;
    #req[txSemaLineOf] txSemaLineOf;
    if (node != 0) {
        #stack[int, 64] k = cssc::peek64(txAstKind + node * 8);
        #stack[int, 64] off = cssc::peek64(txAstOff + node * 8);
        #stack[int, 64] len = cssc::peek64(txAstLen + node * 8);
        #stack[int, 64] lineOff = off;                         // accumulate scope end line
        if (lineOff == 0) {                                    // nodes without a name (return, etc.)
            #stack[int, 64] a = cssc::peek64(txAstA + node * 8);   // borrow child A's offset
            if (a != 0) { lineOff = cssc::peek64(txAstOff + a * 8); }
            #delete[a];
        }
        if (lineOff > 0) {
            txSemaLineOf(lineOff) nl;
            if (nl > cssc::peek64(txSemaScopeEndLine + scope * 8)) {
                cssc::poke64(txSemaScopeEndLine + scope * 8, nl);
            }
            #delete[nl];
        }
        #delete[lineOff];
        if (k == 7) {                                              // DECL slot
            txSemaSymAdd(off, len, 1, scope, node);
            cssc::poke64(txSemaSymDeclType + (txSemaSymCount - 1) * 8, cssc::peek64(txAstNum + node * 8));
        }
        if (k == 15) {                                              // RESULT_CAPTURE `Type() inst;`
            txSemaSymAdd(off, len, 1, scope, node);                 // inst is a slot
            #stack[int, 64] cn = cssc::peek64(txAstA + node * 8);   // the CALL
            if (cn != 0) {
                if (cssc::peek64(txAstKind + cn * 8) == 14) {       // callee name = the type
                    #stack[int, 64] si = txSemaSymCount - 1;
                    cssc::poke64(txSemaSymTypeOff + si * 8, cssc::peek64(txAstOff + cn * 8));
                    cssc::poke64(txSemaSymTypeLen + si * 8, cssc::peek64(txAstLen + cn * 8));
                    #delete[si];
                }
            }
            #delete[cn];
        }
        if (k == 18) {                                             // SCANP param
            txSemaSymAdd(off, len, 5, scope, node);
            #stack[int, 64] pSi = txSemaSymCount - 1;
            #stack[int, 64] ptag = cssc::peek64(txAstB + node * 8);
            if (ptag < 6) {                                        // builtin type tag -> declType
                cssc::poke64(txSemaSymDeclType + pSi * 8, ptag);
            }
            if (ptag == 6) {                                       // user object/sector type name
                #stack[int, 64] toff = cssc::peek64(txAstC + node * 8);
                #stack[int, 64] tl = 0;
                #stack[int, 32] sg = 1;
                while (sg == 1) {
                    #stack[int, 64] cc = cssc::peek8(txSrc + toff + tl);
                    #stack[int, 32] isw = 0;
                    if (cc >= 65) { if (cc <= 90) { isw = 1; } }
                    if (cc >= 97) { if (cc <= 122) { isw = 1; } }
                    if (cc >= 48) { if (cc <= 57) { isw = 1; } }
                    if (cc == 95) { isw = 1; }
                    if (isw == 0) { sg = 0; }
                    #delete[cc];
                    #delete[isw];
                    if (sg == 1) { tl = tl + 1; }
                }
                #delete[sg];
                cssc::poke64(txSemaSymTypeOff + pSi * 8, toff);
                cssc::poke64(txSemaSymTypeLen + pSi * 8, tl);
                #delete[tl];
                #delete[toff];
            }
            #delete[ptag];
            #delete[pSi];
        }
        if (k == 19) {                                             // REQ `#req[g] alias;` -> visible import
            #stack[int, 64] aOff = cssc::peek64(txAstB + node * 8);
            #stack[int, 64] aLen = cssc::peek64(txAstC + node * 8);
            if (aLen > 0) {
                // `#req[x] &x` copies x into this scope -> a NEW allocation that
                // needs its own #delete (kind 1). `#req[x] x` / `*x` is a borrow
                // import (kind 7). The '&' sits just before the alias identifier.
                #stack[int, 64] rk = 7;
                if (aOff > 0) {
                    if (cssc::peek8(txSrc + aOff - 1) == 38) { rk = 1; }
                }
                txSemaSymAdd(aOff, aLen, rk, scope, node);
                #delete[rk];
                // re-aliasing: the alias inherits the referenced global's type
                // (declType + object/sector type-name) so `alias.` / `alias->`
                // resolve to g's members. g (node off/len) is declared before the
                // #req (declare-before-use), so its symbol already exists.
                #stack[int, 64] aSi = txSemaSymCount - 1;
                #stack[int, 64] gi = 0;
                #stack[int, 32] gg = 1;
                while (gg == 1) {
                    if (gi >= aSi) { gg = 0; }
                    if (gg == 1) {
                        #stack[int, 64] go2 = gi * 8;
                        txDdSpanEq(off, len, cssc::peek64(txSemaSymOff + go2), cssc::peek64(txSemaSymLen + go2)) ge;
                        if (ge == 1) {
                            cssc::poke64(txSemaSymDeclType + aSi * 8, cssc::peek64(txSemaSymDeclType + go2));
                            cssc::poke64(txSemaSymTypeOff + aSi * 8, cssc::peek64(txSemaSymTypeOff + go2));
                            cssc::poke64(txSemaSymTypeLen + aSi * 8, cssc::peek64(txSemaSymTypeLen + go2));
                        }
                        #delete[ge];
                        #delete[go2];
                        if (gg == 1) { gi = gi + 1; }
                    }
                }
                #delete[aSi];
                #delete[gi];
                #delete[gg];
            }
            #delete[aOff];
            #delete[aLen];
        }
        if (k == 43) {                                             // MODALIAS `#include("M") a;` / `#load[F] a;`
            if (len > 0) {                                          // named alias = an owning slot that
                txSemaSymAdd(off, len, 1, scope, node);             // requires #free / #unload (declType 9
                cssc::poke64(txSemaSymDeclType + (txSemaSymCount - 1) * 8, 9);  // = module marker, leaks at root too)
            }
        }
        if (k == 17) {                                              // FUNC_DEF
            txSemaSymAdd(off, len, 2, scope, node);
            #stack[int, 64] fs = txSemaScopeNext;
            txSemaScopeNext = txSemaScopeNext + 1;
            cssc::poke64(txSemaScopeParent + fs * 8, scope);
            cssc::poke64(txSemaScopeOwnerOff + fs * 8, off);     // owner = fn name (for signature help)
            cssc::poke64(txSemaScopeOwnerLen + fs * 8, len);
            cssc::poke64(txSemaScopeOwnerKind + fs * 8, 2);
            txSemaLineOf(off) fsl;
            cssc::poke64(txSemaScopeStartLine + fs * 8, fsl);
            cssc::poke64(txSemaScopeEndLine + fs * 8, fsl);
            cssc::poke64(txSemaScopeIsolating + fs * 8, 1);
            #delete[fsl];
            txSemaCollectChain(cssc::peek64(txAstA + node * 8), fs);
            if (cssc::peek64(txSemaScopeEndLine + fs * 8) > cssc::peek64(txSemaScopeEndLine + scope * 8)) {
                cssc::poke64(txSemaScopeEndLine + scope * 8, cssc::peek64(txSemaScopeEndLine + fs * 8));
            }
            #delete[fs];
        }
        if (k == 34) {                                             // OBJECT
            txSemaSymAdd(off, len, 3, scope, node);
            #stack[int, 64] os = txSemaScopeNext;
            txSemaScopeNext = txSemaScopeNext + 1;
            cssc::poke64(txSemaScopeOwnerOff + os * 8, off);
            cssc::poke64(txSemaScopeOwnerLen + os * 8, len);
            cssc::poke64(txSemaScopeOwnerKind + os * 8, 3);
            cssc::poke64(txSemaScopeParent + os * 8, scope);
            txSemaLineOf(off) osl;
            cssc::poke64(txSemaScopeStartLine + os * 8, osl);
            cssc::poke64(txSemaScopeEndLine + os * 8, osl);
            cssc::poke64(txSemaScopeIsolating + os * 8, 1);
            #delete[osl];
            txSemaCollectChain(cssc::peek64(txAstB + node * 8), os);
            txSemaCollectChain(cssc::peek64(txAstC + node * 8), os);
            txSemaCollectChain(cssc::peek64(txAstNum + node * 8), os);   // free block chain
            // Cover the object's `free { ... }` for member-`#delete` completion (see
            // the sector case): extend `os` to just before the next top-level sibling.
            #stack[int, 64] objNext = cssc::peek64(txAstNext + node * 8);
            #stack[int, 64] objEnd = 1000000;
            if (objNext != 0) { txSemaLineOf(cssc::peek64(txAstOff + objNext * 8)) onl; objEnd = onl - 1; #delete[onl]; }
            if (objEnd > cssc::peek64(txSemaScopeEndLine + os * 8)) { cssc::poke64(txSemaScopeEndLine + os * 8, objEnd); }
            #delete[objEnd];
            #delete[objNext];
            if (cssc::peek64(txSemaScopeEndLine + os * 8) > cssc::peek64(txSemaScopeEndLine + scope * 8)) {
                cssc::poke64(txSemaScopeEndLine + scope * 8, cssc::peek64(txSemaScopeEndLine + os * 8));
            }
            #delete[os];
        }
        if (k == 41) {                                             // SECTOR
            txSemaSymAdd(off, len, 4, scope, node);
            #stack[int, 64] ss = txSemaScopeNext;
            txSemaScopeNext = txSemaScopeNext + 1;
            cssc::poke64(txSemaScopeOwnerOff + ss * 8, off);
            cssc::poke64(txSemaScopeOwnerLen + ss * 8, len);
            cssc::poke64(txSemaScopeOwnerKind + ss * 8, 4);
            cssc::poke64(txSemaScopeParent + ss * 8, scope);
            txSemaLineOf(off) ssl;
            cssc::poke64(txSemaScopeStartLine + ss * 8, ssl);
            cssc::poke64(txSemaScopeEndLine + ss * 8, ssl);
            #delete[ssl];
            txSemaCollectChain(cssc::peek64(txAstB + node * 8), ss);   // private
            #stack[int, 64] pubStart = txSemaSymCount;
            txSemaCollectChain(cssc::peek64(txAstC + node * 8), ss);   // public
            #stack[int, 64] pubEnd = txSemaSymCount;
            #stack[int, 64] pi = pubStart;
            while (pi < pubEnd) {
                cssc::poke64(txSemaSymPub + pi * 8, 1);
                pi = pi + 1;
            }
            #delete[pi];
            #delete[pubStart];
            #delete[pubEnd];
            txSemaCollectChain(cssc::peek64(txAstNum + node * 8), ss);  // free block chain
            // The `free { ... }` block is the LAST part of a sector. Its statements
            // collect into `ss`, but when the cursor line inside `free {}` (often a
            // lone `#delete[member]`) is blanked for completion, ss's end line falls
            // short and `#delete[` resolves to root -> no members. Extend ss to just
            // before the next top-level sibling (or EOF) so the whole `free {}` is
            // covered and its member `#delete`s complete.
            #stack[int, 64] secNext = cssc::peek64(txAstNext + node * 8);
            #stack[int, 64] secEnd = 1000000;
            if (secNext != 0) { txSemaLineOf(cssc::peek64(txAstOff + secNext * 8)) snl; secEnd = snl - 1; #delete[snl]; }
            if (secEnd > cssc::peek64(txSemaScopeEndLine + ss * 8)) { cssc::poke64(txSemaScopeEndLine + ss * 8, secEnd); }
            #delete[secEnd];
            #delete[secNext];
            if (cssc::peek64(txSemaScopeEndLine + ss * 8) > cssc::peek64(txSemaScopeEndLine + scope * 8)) {
                cssc::poke64(txSemaScopeEndLine + scope * 8, cssc::peek64(txSemaScopeEndLine + ss * 8));
            }
            #delete[ss];
        }
        if (k == 36) {                                             // LABELDEF
            txSemaSymAdd(off, len, 6, scope, node);
            #stack[int, 64] ls = txSemaScopeNext;
            txSemaScopeNext = txSemaScopeNext + 1;
            cssc::poke64(txSemaScopeParent + ls * 8, scope);
            txSemaLineOf(off) lsl;
            cssc::poke64(txSemaScopeStartLine + ls * 8, lsl);
            cssc::poke64(txSemaScopeEndLine + ls * 8, lsl);
            cssc::poke64(txSemaScopeIsolating + ls * 8, 1);
            #delete[lsl];
            txSemaCollectChain(cssc::peek64(txAstB + node * 8), ls);
            if (cssc::peek64(txSemaScopeEndLine + ls * 8) > cssc::peek64(txSemaScopeEndLine + scope * 8)) {
                cssc::poke64(txSemaScopeEndLine + scope * 8, cssc::peek64(txSemaScopeEndLine + ls * 8));
            }
            #delete[ls];
        }
        if (k == 9) {                                              // IF (non-barrier)
            txSemaCollectChain(cssc::peek64(txAstB + node * 8), scope);
            txSemaCollectChain(cssc::peek64(txAstC + node * 8), scope);
        }
        if (k == 10) { txSemaCollectChain(cssc::peek64(txAstB + node * 8), scope); }
        if (k == 11) { txSemaCollectChain(cssc::peek64(txAstC + node * 8), scope); }
        if (k == 30) {                                             // SELECT `select (it) ?cursor { .. }`
            // Register the ?cursor (node off/len = its name span) so it AND its
            // methods complete inside the body. Kind 7 = borrow (not an owning
            // slot -> never flagged as a leak). Its element type is inherited
            // from the iterable when that is a typed container identifier.
            if (len > 0) {
                txSemaSymAdd(off, len, 7, scope, node);
                #stack[int, 64] cSi = txSemaSymCount - 1;
                #stack[int, 64] itNode = cssc::peek64(txAstA + node * 8);
                if (itNode != 0) {
                    if (cssc::peek64(txAstKind + itNode * 8) == 5) {   // iterable is a bare identifier
                        #stack[int, 64] iOff = cssc::peek64(txAstOff + itNode * 8);
                        #stack[int, 64] iLen = cssc::peek64(txAstLen + itNode * 8);
                        #stack[int, 64] gi2 = 0;
                        #stack[int, 32] gg2 = 1;
                        while (gg2 == 1) {
                            if (gi2 >= cSi) { gg2 = 0; }
                            if (gg2 == 1) {
                                #stack[int, 64] go3 = gi2 * 8;
                                txDdSpanEq(iOff, iLen, cssc::peek64(txSemaSymOff + go3), cssc::peek64(txSemaSymLen + go3)) ie;
                                if (ie == 1) {
                                    cssc::poke64(txSemaSymDeclType + cSi * 8, cssc::peek64(txSemaSymDeclType + go3));
                                    cssc::poke64(txSemaSymTypeOff + cSi * 8, cssc::peek64(txSemaSymTypeOff + go3));
                                    cssc::poke64(txSemaSymTypeLen + cSi * 8, cssc::peek64(txSemaSymTypeLen + go3));
                                }
                                #delete[ie];
                                #delete[go3];
                                if (gg2 == 1) { gi2 = gi2 + 1; }
                            }
                        }
                        #delete[gi2];
                        #delete[gg2];
                        #delete[iOff];
                        #delete[iLen];
                    }
                }
                #delete[itNode];
                #delete[cSi];
            }
            txSemaCollectChain(cssc::peek64(txAstB + node * 8), scope);
        }
        if (k == 12) { txSemaCollectChain(cssc::peek64(txAstA + node * 8), scope); }
        #delete[k];
        #delete[off];
        #delete[len];
    }
}

// Debug: dump the collected symbols as `SYM kind:scope:off:len` (for harness
// verification of the collector). Not part of the LSP diagnostic output.
#define(txSemaDumpSyms) {
    #req[txSemaSymKind] txSemaSymKind;
    #req[txSemaSymScope] txSemaSymScope;
    #req[txSemaSymOff] txSemaSymOff;
    #req[txSemaSymLen] txSemaSymLen;
    #req[txSemaSymCount] txSemaSymCount;
    #stack[int, 64] i = 0;
    #stack[int, 32] go = 1;
    while (go == 1) {
        if (i >= txSemaSymCount) { go = 0; }
        if (go == 1) {
            #stack[int, 64] o = i * 8;
            cssc::out("SYM ");
            cssc::out(cssc::peek64(txSemaSymKind + o));
            cssc::out(":");
            cssc::out(cssc::peek64(txSemaSymScope + o));
            cssc::out(":");
            cssc::out(cssc::peek64(txSemaSymOff + o));
            cssc::out(":");
            cssc::out(cssc::peek64(txSemaSymLen + o));
            cssc::outln();
            #delete[o];
            i = i + 1;
        }
    }
    #delete[go];
    #delete[i];
}

// Debug: dump the scope tree as `SCOPE id:start:end:parent:isolating`.
#define(txSemaDumpScopes) {
    #req[txSemaScopeStartLine] txSemaScopeStartLine;
    #req[txSemaScopeEndLine] txSemaScopeEndLine;
    #req[txSemaScopeParent] txSemaScopeParent;
    #req[txSemaScopeIsolating] txSemaScopeIsolating;
    #req[txSemaScopeNext] txSemaScopeNext;
    #stack[int, 64] i = 0;
    #stack[int, 32] go = 1;
    while (go == 1) {
        if (i >= txSemaScopeNext) { go = 0; }
        if (go == 1) {
            #stack[int, 64] o = i * 8;
            cssc::out("SCOPE ");
            cssc::out(i);
            cssc::out(":");
            cssc::out(cssc::peek64(txSemaScopeStartLine + o));
            cssc::out(":");
            cssc::out(cssc::peek64(txSemaScopeEndLine + o));
            cssc::out(":");
            cssc::out(cssc::peek64(txSemaScopeParent + o));
            cssc::out(":");
            cssc::out(cssc::peek64(txSemaScopeIsolating + o));
            cssc::outln();
            #delete[o];
            i = i + 1;
        }
    }
    #delete[go];
    #delete[i];
}

// Debug: dump every #delete/#free node as `DEL kind:off:len`.
#stack[int, 64] txSemaDumpDeletes;
#define(txSemaDumpDeletes) {
    #req[txAstKind] txAstKind;
    #req[txAstOff] txAstOff;
    #req[txAstLen] txAstLen;
    #req[txAstCount] txAstCount;
    #stack[int, 64] i = 1;
    #stack[int, 32] go = 1;
    while (go == 1) {
        if (i >= txAstCount) { go = 0; }
        if (go == 1) {
            #stack[int, 64] k = cssc::peek64(txAstKind + i * 8);
            if (k == 21) {
                cssc::out("DEL 21:");
                cssc::out(cssc::peek64(txAstOff + i * 8));
                cssc::out(":");
                cssc::out(cssc::peek64(txAstLen + i * 8));
                cssc::outln();
            }
            if (k == 42) {
                cssc::out("DEL 42:");
                cssc::out(cssc::peek64(txAstOff + i * 8));
                cssc::out(":");
                cssc::out(cssc::peek64(txAstLen + i * 8));
                cssc::outln();
            }
            #delete[k];
            i = i + 1;
        }
    }
    #delete[go];
    #delete[i];
}

#define(txSemaBuildSyms) {
    #scanp(txSemaBuildSyms, int, 0) prog;
    #req[txAstA] txAstA;
    #req[txSemaSymInit] txSemaSymInit;
    #req[txSemaCollectChain] txSemaCollectChain;
    txSemaSymInit();
    txSemaCollectChain(cssc::peek64(txAstA + prog * 8), 0);
}

// ===========================================================================
//  OWNERSHIP MAP  --  editor-facing alloc<->dealloc + leak map. Resolves each
//  #delete/#free to its target allocation by scope (nearest enclosing decl of
//  the name, walking parents), so the same name across nested scopes never
//  cross-matches. Output (one site per line):
//    A <line> <col> <scope> <freed> <leaked>   -- an allocation
//    D <line> <col> <targetAllocLine>          -- a delete/free (-1 = unresolved)
//  The editor groups sites by the alloc line (a delete points at its alloc's
//  line) and colours an alloc magenta when freed, magenta x orange-red when
//  leaked. Reuses the symbol table + scope tree the diagnostics already build.
// ===========================================================================

// nearest enclosing kind-1 (variable) symbol whose name span == (off,len),
// searching `fromScope` then its parents; symbol index, or -1.
#define(txOwnResolve) {
    #scanp(txOwnResolve, int, 0) off;
    #scanp(txOwnResolve, int, 1) len;
    #scanp(txOwnResolve, int, 2) fromScope;
    #req[txSrc] txSrc;
    #req[txSemaSymOff] txSemaSymOff;
    #req[txSemaSymLen] txSemaSymLen;
    #req[txSemaSymKind] txSemaSymKind;
    #req[txSemaSymScope] txSemaSymScope;
    #req[txSemaSymCount] txSemaSymCount;
    #req[txSemaScopeParent] txSemaScopeParent;
    #req[txDdSpanEq] txDdSpanEq;
    #stack[int, 64] result = 0 - 1;
    #stack[int, 64] scope = fromScope;
    #stack[int, 32] walking = 1;
    while (walking == 1) {
        if (scope < 0) { walking = 0; }
        if (walking == 1) {
            #stack[int, 64] i = 0;
            #stack[int, 32] go = 1;
            while (go == 1) {
                if (i >= txSemaSymCount) { go = 0; }
                if (go == 1) {
                    #stack[int, 64] o = i * 8;
                    // a kind-1 slot OR a `#scanp(...) &param` owning COPY (kind 5
                    // with a '&' just before its name) can be the target of
                    // #delete/#free -- both are owning allocations.
                    #stack[int, 64] sk = cssc::peek64(txSemaSymKind + o);
                    #stack[int, 32] ownish = 0;
                    if (sk == 1) { ownish = 1; }
                    if (sk == 5) {
                        #stack[int, 64] po = cssc::peek64(txSemaSymOff + o);
                        if (po > 0) { if (cssc::peek8(txSrc + po - 1) == 38) { ownish = 1; } }
                        #delete[po];
                    }
                    if (ownish == 1) {
                        if (cssc::peek64(txSemaSymScope + o) == scope) {
                            txDdSpanEq(off, len, cssc::peek64(txSemaSymOff + o),
                                       cssc::peek64(txSemaSymLen + o)) eq;
                            if (eq == 1) { result = i; go = 0; }
                            #delete[eq];
                        }
                    }
                    #delete[sk];
                    #delete[ownish];
                    #delete[o];
                    if (go == 1) { i = i + 1; }
                }
            }
            #delete[i];
            #delete[go];
            if (result >= 0) { walking = 0; }
            if (walking == 1) {
                if (scope == 0) { walking = 0; }
                if (walking == 1) {
                    scope = cssc::peek64(txSemaScopeParent + scope * 8);
                }
            }
        }
    }
    #delete[scope];
    #delete[walking];
    return result;
}

// POSITION-AWARE variant of txOwnResolve: resolve name (off,len) from fromScope,
// but among several same-name slots in one scope pick the one whose declaration
// is the MOST RECENT one BEFORE `posLimit` (the source offset of the reference,
// e.g. a #delete's target). This is what pairs each delete with the right slot
// when a name is re-captured in the same scope (`f() s; #delete[s]; f() s;
// #delete[s];`) — the name-only txOwnResolve returned the first slot for BOTH
// deletes, leaving the second slot falsely flagged LIFETIME_LEAK.
#define(txOwnResolveAt) {
    #scanp(txOwnResolveAt, int, 0) off;
    #scanp(txOwnResolveAt, int, 1) len;
    #scanp(txOwnResolveAt, int, 2) fromScope;
    #scanp(txOwnResolveAt, int, 3) posLimit;
    #req[txSrc] txSrc;
    #req[txSemaSymOff] txSemaSymOff;
    #req[txSemaSymLen] txSemaSymLen;
    #req[txSemaSymKind] txSemaSymKind;
    #req[txSemaSymScope] txSemaSymScope;
    #req[txSemaSymCount] txSemaSymCount;
    #req[txSemaScopeParent] txSemaScopeParent;
    #req[txDdSpanEq] txDdSpanEq;
    #stack[int, 64] result = 0 - 1;
    #stack[int, 64] scope = fromScope;
    #stack[int, 32] walking = 1;
    while (walking == 1) {
        if (scope < 0) { walking = 0; }
        if (walking == 1) {
            #stack[int, 64] bestOff = 0 - 1;
            #stack[int, 64] i = 0;
            #stack[int, 32] go = 1;
            while (go == 1) {
                if (i >= txSemaSymCount) { go = 0; }
                if (go == 1) {
                    #stack[int, 64] o = i * 8;
                    #stack[int, 64] sk = cssc::peek64(txSemaSymKind + o);
                    #stack[int, 32] ownish = 0;
                    if (sk == 1) { ownish = 1; }
                    if (sk == 5) {
                        #stack[int, 64] po = cssc::peek64(txSemaSymOff + o);
                        if (po > 0) { if (cssc::peek8(txSrc + po - 1) == 38) { ownish = 1; } }
                        #delete[po];
                    }
                    if (ownish == 1) {
                        if (cssc::peek64(txSemaSymScope + o) == scope) {
                            #stack[int, 64] soff = cssc::peek64(txSemaSymOff + o);
                            txDdSpanEq(off, len, soff,
                                       cssc::peek64(txSemaSymLen + o)) eq;
                            if (eq == 1) {
                                if (soff < posLimit) {
                                    if (soff > bestOff) { bestOff = soff; result = i; }
                                }
                            }
                            #delete[eq];
                            #delete[soff];
                        }
                    }
                    #delete[sk];
                    #delete[ownish];
                    #delete[o];
                    i = i + 1;
                }
            }
            #delete[i];
            #delete[go];
            #delete[bestOff];
            if (result >= 0) { walking = 0; }
            if (walking == 1) {
                if (scope == 0) { walking = 0; }
                if (walking == 1) {
                    scope = cssc::peek64(txSemaScopeParent + scope * 8);
                }
            }
        }
    }
    #delete[scope];
    #delete[walking];
    return result;
}

// First RETURN's copy-flag in a subtree: 1 = `return &x` (copy/owned), 0 =
// `return x` (reference/borrow), -1 = no return. Does NOT descend into nested
// #define bodies (k==17) so it reads only THIS function's return.
#define(txScanRetCopy) {
    #scanp(txScanRetCopy, int, 0) node;
    #req[txAstKind] txAstKind;
    #req[txAstA] txAstA;
    #req[txAstB] txAstB;
    #req[txAstNum] txAstNum;
    #req[txAstNext] txAstNext;
    #req[txScanRetCopy] txScanRetCopy;
    #stack[int, 64] r = 0 - 1;
    if (node != 0) {
        #stack[int, 64] k = cssc::peek64(txAstKind + node * 8);
        if (k == 20) { r = cssc::peek64(txAstNum + node * 8); }
        if (r < 0) {
            if (k != 17) {
                txScanRetCopy(cssc::peek64(txAstA + node * 8)) ra;
                r = ra;
                #delete[ra];
            }
        }
        if (r < 0) {
            txScanRetCopy(cssc::peek64(txAstB + node * 8)) rb;
            r = rb;
            #delete[rb];
        }
        if (r < 0) {
            txScanRetCopy(cssc::peek64(txAstNext + node * 8)) rn;
            r = rn;
            #delete[rn];
        }
        #delete[k];
    }
    return r;
}

// 1 if (cOff,cLen) names a user #define whose first return is a reference
// (`return x`, no `&`): a result-capture of it is a BORROW needing no #delete.
// 0 for copy-returning / void / builtin / unknown callees (owned -> needs delete).
#define(txFuncIsRefRet) {
    #scanp(txFuncIsRefRet, int, 0) cOff;
    #scanp(txFuncIsRefRet, int, 1) cLen;
    #req[txAstKind] txAstKind;
    #req[txAstOff] txAstOff;
    #req[txAstLen] txAstLen;
    #req[txAstA] txAstA;
    #req[txAstCount] txAstCount;
    #req[txDdSpanEq] txDdSpanEq;
    #req[txScanRetCopy] txScanRetCopy;
    #stack[int, 64] r = 0;
    #stack[int, 64] i = 1;
    #stack[int, 32] go = 1;
    while (go == 1) {
        if (i >= txAstCount) { go = 0; }
        if (go == 1) {
            if (cssc::peek64(txAstKind + i * 8) == 17) {
                txDdSpanEq(cOff, cLen, cssc::peek64(txAstOff + i * 8),
                           cssc::peek64(txAstLen + i * 8)) eq;
                if (eq == 1) {
                    txScanRetCopy(cssc::peek64(txAstA + i * 8)) rc;
                    if (rc == 0) { r = 1; }
                    #delete[rc];
                    go = 0;
                }
                #delete[eq];
            }
            if (go == 1) { i = i + 1; }
        }
    }
    #delete[i];
    #delete[go];
    return r;
}

#define(txOwnershipEmit) {
    #req[txSrc] txSrc;
    #req[txAstKind] txAstKind;
    #req[txAstOff] txAstOff;
    #req[txAstLen] txAstLen;
    #req[txAstA] txAstA;
    #req[txAstNum] txAstNum;
    #req[txAstCount] txAstCount;
    #req[txSemaSymNode] txSemaSymNode;
    #req[txFuncIsRefRet] txFuncIsRefRet;
    #req[txSemaSymOff] txSemaSymOff;
    #req[txSemaSymLen] txSemaSymLen;
    #req[txSemaSymKind] txSemaSymKind;
    #req[txSemaSymScope] txSemaSymScope;
    #req[txSemaSymDeclType] txSemaSymDeclType;
    #req[txSemaSymCount] txSemaSymCount;
    #req[txSemaScopeOwnerOff] txSemaScopeOwnerOff;
    #req[txSemaScopeOwnerLen] txSemaScopeOwnerLen;
    #req[txSemaLineOf] txSemaLineOf;
    #req[txSemaColOf] txSemaColOf;
    #req[txScopeAt] txScopeAt;
    #req[txOwnResolve] txOwnResolve;
    #req[txLeakIsCallable] txLeakIsCallable;
    #req[txDdFind] txDdFind;
    #stack[int, 64] freed = cssc::alloc(txSemaSymCount * 8 + 8);
    #stack[int, 64] zi = 0;
    while (zi < txSemaSymCount) {
        cssc::poke64(freed + zi * 8, 0);
        zi = zi + 1;
    }
    #delete[zi];
    #stack[int, 64] ai = 1;
    #stack[int, 32] ago = 1;
    while (ago == 1) {
        if (ai >= txAstCount) { ago = 0; }
        if (ago == 1) {
            #stack[int, 64] k = cssc::peek64(txAstKind + ai * 8);
            #stack[int, 32] isdel = 0;
            if (k == 21) { isdel = 1; }
            if (k == 42) { isdel = 1; }
            if (isdel == 1) {
                #stack[int, 64] doff = cssc::peek64(txAstOff + ai * 8);
                #stack[int, 64] dlen = cssc::peek64(txAstLen + ai * 8);
                txSemaLineOf(doff) dline;
                txSemaColOf(doff) dcol;
                txScopeAt(dline) dscope;
                txOwnResolve(doff, dlen, dscope) gid;
                #stack[int, 64] tline = 0 - 1;
                if (gid >= 0) {
                    cssc::poke64(freed + gid * 8, 1);
                    txSemaLineOf(cssc::peek64(txSemaSymOff + gid * 8)) tl;
                    tline = tl;
                    #delete[tl];
                }
                cssc::out("D ");
                cssc::out(dline);
                cssc::out(" ");
                cssc::out(dcol);
                cssc::out(" ");
                cssc::out(tline);
                cssc::outln();
                #delete[doff];
                #delete[dlen];
                #delete[dline];
                #delete[dcol];
                #delete[dscope];
                #delete[gid];
                #delete[tline];
            }
            // A `mirror x` / `return x` (or `*x`) in REFERENCE form (Num==0) hands
            // its operand out — the caller now references it, so the local is
            // intentionally NOT #delete'd and must NOT be flagged as a leak. The
            // `&`-COPY form (Num==1) keeps the local owned, so it still needs a
            // #delete and is left to leak-check.
            #stack[int, 32] isesc = 0;
            if (k == 32) { isesc = 1; }
            if (k == 20) { isesc = 1; }
            if (isesc == 1) {
                if (cssc::peek64(txAstNum + ai * 8) == 0) {
                    #stack[int, 64] val = cssc::peek64(txAstA + ai * 8);
                    if (val != 0) {
                        if (cssc::peek64(txAstKind + val * 8) == 5) {   // bare identifier operand
                            #stack[int, 64] voff = cssc::peek64(txAstOff + val * 8);
                            #stack[int, 64] vlen = cssc::peek64(txAstLen + val * 8);
                            txSemaLineOf(voff) vln;
                            txScopeAt(vln) vsc;
                            txOwnResolve(voff, vlen, vsc) vgid;
                            if (vgid >= 0) { cssc::poke64(freed + vgid * 8, 1); }
                            #delete[vgid];
                            #delete[vsc];
                            #delete[vln];
                            #delete[voff];
                            #delete[vlen];
                        }
                    }
                    #delete[val];
                }
            }
            #delete[isesc];
            #delete[k];
            #delete[isdel];
            ai = ai + 1;
        }
    }
    #delete[ai];
    #delete[ago];
    #stack[int, 64] i = 0;
    #stack[int, 32] go = 1;
    while (go == 1) {
        if (i >= txSemaSymCount) { go = 0; }
        if (go == 1) {
            #stack[int, 64] o = i * 8;
            #stack[int, 64] aKind = cssc::peek64(txSemaSymKind + o);
            #stack[int, 32] aOwn = 0;
            if (aKind == 1) { aOwn = 1; }
            if (aKind == 5) {                                  // #scanp(...) &param = an owning COPY
                #stack[int, 64] apo = cssc::peek64(txSemaSymOff + o);
                if (apo > 0) { if (cssc::peek8(txSrc + apo - 1) == 38) { aOwn = 1; } }
                #delete[apo];
            }
            #delete[aKind];
            if (aOwn == 1) {
                #stack[int, 64] off = cssc::peek64(txSemaSymOff + o);
                #stack[int, 64] len = cssc::peek64(txSemaSymLen + o);
                #stack[int, 64] scope = cssc::peek64(txSemaSymScope + o);
                txSemaLineOf(off) line;
                txSemaColOf(off) col;
                #stack[int, 64] fr = cssc::peek64(freed + i * 8);
                #stack[int, 64] ownerLen = cssc::peek64(txSemaScopeOwnerLen + scope * 8);
                if (ownerLen > 0) {
                    if (fr == 0) {
                        txDdFind(cssc::peek64(txSemaScopeOwnerOff + scope * 8), ownerLen) od;
                        if (od >= 0) { fr = 1; }
                        #delete[od];
                    }
                }
                txLeakIsCallable(off, len, scope) callable;
                #stack[int, 64] leaked = 0;
                if (scope != 0) {
                    if (callable == 0) {
                        if (fr == 0) { leaked = 1; }
                    }
                }
                // #include / #load / #depend aliases (declType 9) own a module
                // handle -> they leak even at root scope when never #free'd /
                // #unload'd (a plain root slot is exempt; a module alias is not).
                #stack[int, 64] dtM = cssc::peek64(txSemaSymDeclType + o);
                if (dtM == 9) {
                    if (fr == 0) { leaked = 1; }
                }
                #delete[dtM];
                // A result-capture `func() c;` of a ref-returning user #define
                // is a BORROW (no #delete needed) — skip it so it never marks as
                // an alloc/leak. Owned/copy-returning/builtin captures fall through.
                #stack[int, 64] symNode = cssc::peek64(txSemaSymNode + o);
                #stack[int, 32] skip = 0;
                if (symNode != 0) {
                    if (cssc::peek64(txAstKind + symNode * 8) == 15) {
                        #stack[int, 64] cn = cssc::peek64(txAstA + symNode * 8);
                        if (cn != 0) {
                            txFuncIsRefRet(cssc::peek64(txAstOff + cn * 8),
                                           cssc::peek64(txAstLen + cn * 8)) rr;
                            if (rr == 1) { skip = 1; }
                            #delete[rr];
                        }
                        #delete[cn];
                    }
                }
                if (skip == 0) {
                    cssc::out("A ");
                    cssc::out(line);
                    cssc::out(" ");
                    cssc::out(col);
                    cssc::out(" ");
                    cssc::out(scope);
                    cssc::out(" ");
                    cssc::out(fr);
                    cssc::out(" ");
                    cssc::out(leaked);
                    cssc::outln();
                }
                #delete[symNode];
                #delete[skip];
                #delete[off];
                #delete[len];
                #delete[scope];
                #delete[line];
                #delete[col];
                #delete[fr];
                #delete[ownerLen];
                #delete[callable];
                #delete[leaked];
            }
            #delete[aOwn];
            #delete[o];
            i = i + 1;
        }
    }
    #delete[i];
    #delete[go];
    #delete[freed];
}

// ===========================================================================
//  DOUBLE_DELETE — two `#delete`/`#free` of the same name on the same path.
//  Chronological per-scope walk of a growing "deleted set" (name span ->
//  first-delete line). DECL re-declaration unshadows. Conditional bodies
//  (if/else, while, for, select, bare block) and barrier bodies (function/
//  object/sector/label) are walked with the outer set visible (so a delete of
//  an already-freed name is caught) but their own adds are TRUNCATED on exit
//  (not merged) — this catches the real double-frees without the classic
//  `if{del x}else{del x}` false positive. Full if/else branch-intersection
//  (a post-if delete after both branches free x) is deferred until the corpus
//  proves it needed. Parity oracle: `cssc lsp diagnostics` code DOUBLE_DELETE.
// ===========================================================================
// (txDdOff/Len/Line/Count/Cap declared at the top of this file.)
#stack[int, 64] txDdSpanEq;
#stack[int, 64] txDdInit;
#stack[int, 64] txDdFind;
#stack[int, 64] txDdAdd;
#stack[int, 64] txDdRemove;
#stack[int, 64] txDdKeyCol;
#stack[int, 64] txDdEmit;
#stack[int, 64] txDdWalkChain;
#stack[int, 64] txDdWalkStmt;

// span-equality of two (off,len) slices of txSrc
#define(txDdSpanEq) {
    #scanp(txDdSpanEq, int, 0) o1;
    #scanp(txDdSpanEq, int, 1) l1;
    #scanp(txDdSpanEq, int, 2) o2;
    #scanp(txDdSpanEq, int, 3) l2;
    #req[txSrc] txSrc;
    #stack[int, 64] eq = 1;
    if (l1 != l2) { eq = 0; }
    if (eq == 1) {
        #stack[int, 64] i = 0;
        #stack[int, 32] go = 1;
        while (go == 1) {
            if (i >= l1) { go = 0; }
            if (go == 1) {
                if (cssc::peek8(txSrc + o1 + i) != cssc::peek8(txSrc + o2 + i)) {
                    eq = 0;
                    go = 0;
                }
                if (go == 1) { i = i + 1; }
            }
        }
        #delete[i];
        #delete[go];
    }
    return eq;
}

#define(txDdInit) {
    #req[txDdOff] txDdOff;
    #req[txDdLen] txDdLen;
    #req[txDdLine] txDdLine;
    #req[txDdCount] txDdCount;
    #req[txDdCap] txDdCap;
    txDdCap = 4096;
    txDdOff = cssc::alloc(txDdCap * 8);
    txDdLen = cssc::alloc(txDdCap * 8);
    txDdLine = cssc::alloc(txDdCap * 8);
    txDdCount = 0;
}

// index of a matching name in the current deleted set, or -1
#define(txDdFind) {
    #scanp(txDdFind, int, 0) off;
    #scanp(txDdFind, int, 1) len;
    #req[txDdOff] txDdOff;
    #req[txDdLen] txDdLen;
    #req[txDdCount] txDdCount;
    #req[txDdSpanEq] txDdSpanEq;
    #stack[int, 64] found = 0 - 1;
    #stack[int, 64] i = 0;
    #stack[int, 32] go = 1;
    while (go == 1) {
        if (i >= txDdCount) { go = 0; }
        if (go == 1) {
            #stack[int, 64] o = i * 8;
            txDdSpanEq(off, len, cssc::peek64(txDdOff + o), cssc::peek64(txDdLen + o)) eq;
            if (eq == 1) { found = i; go = 0; }
            #delete[eq];
            #delete[o];
            if (go == 1) { i = i + 1; }
        }
    }
    #delete[i];
    #delete[go];
    return found;
}

#define(txDdAdd) {
    #scanp(txDdAdd, int, 0) off;
    #scanp(txDdAdd, int, 1) len;
    #scanp(txDdAdd, int, 2) line;
    #req[txDdOff] txDdOff;
    #req[txDdLen] txDdLen;
    #req[txDdLine] txDdLine;
    #req[txDdCount] txDdCount;
    #req[txDdCap] txDdCap;
    if (txDdCount < txDdCap) {
        #stack[int, 64] o = txDdCount * 8;
        cssc::poke64(txDdOff + o, off);
        cssc::poke64(txDdLen + o, len);
        cssc::poke64(txDdLine + o, line);
        txDdCount = txDdCount + 1;
        #delete[o];
    }
}

// unshadow on re-declaration: drop a name from the set (compact with last)
#define(txDdRemove) {
    #scanp(txDdRemove, int, 0) off;
    #scanp(txDdRemove, int, 1) len;
    #req[txDdOff] txDdOff;
    #req[txDdLen] txDdLen;
    #req[txDdLine] txDdLine;
    #req[txDdCount] txDdCount;
    #req[txDdFind] txDdFind;
    txDdFind(off, len) idx;
    if (idx >= 0) {
        #stack[int, 64] last = txDdCount - 1;
        #stack[int, 64] od = idx * 8;
        #stack[int, 64] ld = last * 8;
        cssc::poke64(txDdOff + od, cssc::peek64(txDdOff + ld));
        cssc::poke64(txDdLen + od, cssc::peek64(txDdLen + ld));
        cssc::poke64(txDdLine + od, cssc::peek64(txDdLine + ld));
        txDdCount = txDdCount - 1;
        #delete[last];
        #delete[od];
        #delete[ld];
    }
    #delete[idx];
}

// column (0-indexed) of the `#delete` / `#free` directive on the line at `off`
#define(txDdKeyCol) {
    #scanp(txDdKeyCol, int, 0) off;
    #req[txSrc] txSrc;
    #stack[int, 64] ls = off;
    #stack[int, 32] g1 = 1;
    while (g1 == 1) {
        if (ls == 0) { g1 = 0; }
        if (g1 == 1) {
            if (cssc::peek8(txSrc + ls - 1) == 10) { g1 = 0; }
            if (g1 == 1) { ls = ls - 1; }
        }
    }
    #delete[g1];
    // first non-whitespace column on the line (mirrors _span_decl): the keyword
    // column is used ONLY when `#` leads the line; otherwise (a shared line like
    // `sector X { public: #stack[…] m; }`) the declared NAME column is used.
    #stack[int, 64] fnw = ls;
    #stack[int, 32] g2 = 1;
    while (g2 == 1) {
        if (fnw >= off) { g2 = 0; }
        if (g2 == 1) {
            #stack[int, 64] c = cssc::peek8(txSrc + fnw);
            if (c != 32) { if (c != 9) { g2 = 0; } }
            if (g2 == 1) { fnw = fnw + 1; }
            #delete[c];
        }
    }
    #delete[g2];
    #stack[int, 64] col = off - ls;                            // default: name column
    if (cssc::peek8(txSrc + fnw) == 35) { col = fnw - ls; }    // '#' leads -> keyword column
    #delete[fnw];
    #delete[ls];
    return col;
}

#define(txDdEmit) {
    #scanp(txDdEmit, int, 0) node;
    #req[txAstOff] txAstOff;
    #req[txSemaLineOf] txSemaLineOf;
    #req[txDdKeyCol] txDdKeyCol;
    #stack[int, 64] off = cssc::peek64(txAstOff + node * 8);
    txSemaLineOf(off) line;
    txDdKeyCol(off) col;
    cssc::out(line);
    cssc::out(":");
    cssc::out(col);
    cssc::out(":1:DOUBLE_DELETE:value is deleted or freed more than once");
    cssc::outln();
    #delete[off];
    #delete[line];
    #delete[col];
}

#define(txDdWalkChain) {
    #scanp(txDdWalkChain, int, 0) first;
    #req[txAstNext] txAstNext;
    #req[txDdWalkStmt] txDdWalkStmt;
    #stack[int, 64] s = first;
    #stack[int, 32] go = 1;
    while (go == 1) {
        if (s == 0) { go = 0; }
        if (go == 1) {
            txDdWalkStmt(s);
            s = cssc::peek64(txAstNext + s * 8);
        }
    }
    #delete[go];
    #delete[s];
}

#define(txDdWalkStmt) {
    #scanp(txDdWalkStmt, int, 0) node;
    #req[txAstKind] txAstKind;
    #req[txAstA] txAstA;
    #req[txAstB] txAstB;
    #req[txAstC] txAstC;
    #req[txAstNum] txAstNum;
    #req[txAstOff] txAstOff;
    #req[txAstLen] txAstLen;
    #req[txDdCount] txDdCount;
    #req[txDdLine] txDdLine;
    #req[txDdFind] txDdFind;
    #req[txDdAdd] txDdAdd;
    #req[txDdRemove] txDdRemove;
    #req[txDdEmit] txDdEmit;
    #req[txSemaLineOf] txSemaLineOf;
    #req[txDdWalkChain] txDdWalkChain;
    if (node != 0) {
        #stack[int, 64] k = cssc::peek64(txAstKind + node * 8);
        #stack[int, 64] off = cssc::peek64(txAstOff + node * 8);
        #stack[int, 64] len = cssc::peek64(txAstLen + node * 8);
        if (k == 21) {                                          // DELETE
            txDdFind(off, len) idx;
            if (idx >= 0) { txDdEmit(node); }
            if (idx < 0) {
                txSemaLineOf(off) ln;
                txDdAdd(off, len, ln);
                #delete[ln];
            }
            #delete[idx];
        }
        if (k == 42) {                                          // FREE
            txDdFind(off, len) idx;
            if (idx >= 0) { txDdEmit(node); }
            if (idx < 0) {
                txSemaLineOf(off) ln;
                txDdAdd(off, len, ln);
                #delete[ln];
            }
            #delete[idx];
        }
        if (k == 7) { txDdRemove(off, len); }                   // DECL re-decl
        if (k == 15) { txDdRemove(off, len); }                  // RESULT_CAPTURE `f() s;` re-declares s -> clears any prior delete of the old s
        // conditional / barrier bodies: catch-vs-outer, adds truncated on exit
        if (k == 9) {
            #stack[int, 64] b1 = txDdCount;
            txDdWalkChain(cssc::peek64(txAstB + node * 8));
            txDdCount = b1;
            #stack[int, 64] b2 = txDdCount;
            txDdWalkChain(cssc::peek64(txAstC + node * 8));
            txDdCount = b2;
            #delete[b1];
            #delete[b2];
        }
        if (k == 10) {
            #stack[int, 64] b = txDdCount;
            txDdWalkChain(cssc::peek64(txAstB + node * 8));
            txDdCount = b;
            #delete[b];
        }
        if (k == 11) {
            #stack[int, 64] b = txDdCount;
            txDdWalkChain(cssc::peek64(txAstC + node * 8));
            txDdCount = b;
            #delete[b];
        }
        if (k == 30) {
            #stack[int, 64] b = txDdCount;
            txDdWalkChain(cssc::peek64(txAstB + node * 8));
            txDdCount = b;
            #delete[b];
        }
        if (k == 12) {
            #stack[int, 64] b = txDdCount;
            txDdWalkChain(cssc::peek64(txAstA + node * 8));
            txDdCount = b;
            #delete[b];
        }
        if (k == 17) {
            #stack[int, 64] b = txDdCount;
            txDdWalkChain(cssc::peek64(txAstA + node * 8));
            txDdCount = b;
            #delete[b];
        }
        if (k == 34) {
            #stack[int, 64] b = txDdCount;
            txDdWalkChain(cssc::peek64(txAstB + node * 8));
            txDdWalkChain(cssc::peek64(txAstC + node * 8));
            txDdWalkChain(cssc::peek64(txAstNum + node * 8));
            txDdCount = b;
            #delete[b];
        }
        if (k == 41) {
            #stack[int, 64] b = txDdCount;
            txDdWalkChain(cssc::peek64(txAstB + node * 8));
            txDdWalkChain(cssc::peek64(txAstC + node * 8));
            txDdWalkChain(cssc::peek64(txAstNum + node * 8));
            txDdCount = b;
            #delete[b];
        }
        if (k == 36) {
            #stack[int, 64] b = txDdCount;
            txDdWalkChain(cssc::peek64(txAstB + node * 8));
            txDdCount = b;
            #delete[b];
        }
        #delete[k];
        #delete[off];
        #delete[len];
    }
}
